{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LeeAttendMigrationFixture",
  "description": "Schema for Phase 3 Rust-to-Go migration parity fixtures",
  "type": "object",
  "required": [
    "schema_version",
    "metadata",
    "request",
    "identity",
    "setup",
    "expected_response",
    "expected_side_effects",
    "normalization_rules"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "metadata": {
      "type": "object",
      "required": ["id", "domain", "name", "description", "source_ref"],
      "properties": {
        "id": { "type": "string" },
        "domain": {
          "type": "string",
          "enum": [
            "auth",
            "workspaces",
            "employees",
            "attendance",
            "roster",
            "leaves",
            "payroll",
            "files",
            "system"
          ]
        },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "source_ref": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "request": {
      "type": "object",
      "required": ["method", "path"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "HEAD"]
        },
        "path": { "type": "string" },
        "path_params": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "query": {
          "type": "object"
        },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "body": {}
      }
    },
    "identity": {
      "type": "object",
      "required": ["auth_type", "permissions"],
      "properties": {
        "auth_type": {
          "type": "string",
          "enum": ["bearer", "cookie", "header_impersonation", "service_token", "anonymous"]
        },
        "auth_token": { "type": ["string", "null"] },
        "user_id": { "type": ["string", "null"] },
        "workspace_id": { "type": ["string", "null"] },
        "role": { "type": ["string", "null"] },
        "permissions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "system_roles": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "setup": {
      "type": "object",
      "properties": {
        "db_seeds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["database", "table", "rows"],
            "properties": {
              "database": { "type": "string", "enum": ["system", "tenant"] },
              "table": { "type": "string" },
              "rows": {
                "type": "array",
                "items": { "type": "object" }
              }
            }
          }
        },
        "redis_seeds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "type", "value"],
            "properties": {
              "key": { "type": "string" },
              "type": { "type": "string", "enum": ["string", "hash", "list", "zset"] },
              "value": {},
              "ttl_seconds": { "type": ["number", "null"] }
            }
          }
        },
        "external_stubs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["service", "action", "response"],
            "properties": {
              "service": { "type": "string", "enum": ["s3", "smtp", "clamav"] },
              "endpoint": { "type": "string" },
              "action": { "type": "string" },
              "response": { "type": "object" }
            }
          }
        }
      }
    },
    "expected_response": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "integer" },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "body": {},
        "body_normalizations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "kind", "reason", "source_citation"],
            "properties": {
              "path": { "type": "string" },
              "kind": { "type": "string", "enum": ["generated_uuid", "generated_time", "presigned_url", "ordered_array"] },
              "tolerance_ms": { "type": "number" },
              "reason": { "type": "string" },
              "source_citation": { "type": "string" }
            }
          }
        }
      }
    },
    "expected_side_effects": {
      "type": "object",
      "properties": {
        "db_mutations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["database", "table", "operation", "pk_filter", "columns"],
            "properties": {
              "database": { "type": "string", "enum": ["system", "tenant"] },
              "table": { "type": "string" },
              "operation": { "type": "string", "enum": ["INSERT", "UPDATE", "DELETE"] },
              "pk_filter": { "type": "object" },
              "columns": { "type": "object" }
            }
          }
        },
        "redis_mutations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["command", "key"],
            "properties": {
              "command": { "type": "string", "enum": ["SET", "DEL", "INCR", "EXPIRE", "RPUSH", "HSET"] },
              "key": { "type": "string" },
              "value": {},
              "ttl_seconds": { "type": "number" }
            }
          }
        },
        "outbox_events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["job_type", "status", "payload"],
            "properties": {
              "job_type": { "type": "string" },
              "status": { "type": "string", "enum": ["pending"] },
              "payload": { "type": "object" }
            }
          }
        },
        "audit_events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["action", "workspace_id"],
            "properties": {
              "action": { "type": "string" },
              "workspace_id": { "type": "string" },
              "actor_id": { "type": ["string", "null"] },
              "actor_type": { "type": ["string", "null"] },
              "target_resource_id": { "type": ["string", "null"] },
              "details": { "type": ["object", "null"] }
            }
          }
        }
      }
    },
    "normalization_rules": {
      "type": "object",
      "properties": {
        "tolerances": {
          "type": "object",
          "properties": {
            "timestamp_ms": { "type": "number" },
            "redis_ttl_seconds": { "type": "number" }
          }
        },
        "ignored_fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "reason", "source_citation", "verification"],
            "properties": {
              "path": { "type": "string" },
              "reason": { "type": "string" },
              "source_citation": { "type": "string" },
              "verification": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
