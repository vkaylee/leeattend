# Infrastructure (used by docker-compose via ${VAR:-fallback})
DB_NAME=leeattend
DB_USER=admin
DB_PASSWORD=your_password_here
JWT_SECRET=your_jwt_secret_here

# Override full DATABASE_URL (optional, takes priority over DB_* vars)
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# CORS allowed origins (production)
# ALLOWED_ORIGINS=https://tauri.localhost

# Agent configuration (optional)
# AGENT_ID=test-agent
# AGENT_TOKEN=test-token
# AGENT_CENTRAL_SERVER_URL=ws://apiserver:3000/api/ws
# AGENT_DATABASE_URL=sqlite:///app/data/agent.db?mode=rwc
# AGENT_RPC_TIMEOUT_SECONDS=300

# Dev server port (optional)
# DEV_PORT=8080
