# ==============================================================================
# LeeAttend — Go API and React/Vite dashboard environment variables
# ==============================================================================
# Copy this file to .env and replace placeholders with local values.
# Active runtime uses Go, PostgreSQL, Redis, MinIO, and the web dashboard.

# --- Core ---

# Application environment (development/production).
# Aliases: API_ENV
APP_ENV=development

# HTTP server port.
# Aliases: API_PORT
APP_PORT=3000

# HTTP server bind address.
# Aliases: API_HOST
APP_HOST=0.0.0.0

# File to write the actual bound port number on startup.
PORT_FILE_NAME=.api_port

# --- Database ---

# Primary PostgreSQL connection URL (for migrations and direct access). REQUIRED
# Aliases: DB_URL, DATABASE_URL
DB_PRIMARY_URL=your_connection_url_here

# Supavisor transaction pooler URL (port 6543). Required — Supavisor mode is enforced. REQUIRED
# Aliases: DATABASE_POOLER_TX_URL
DB_POOLER_TX_URL=your_connection_url_here

# Supavisor session pooler URL (port 5452). Required — Supavisor mode is enforced. REQUIRED
# Aliases: DATABASE_POOLER_SESS_URL
DB_POOLER_SESS_URL=your_connection_url_here

# Tenant transaction pooler URL. Falls back to DB_POOLER_TX_URL if unset.
# Aliases: DATABASE_TENANT_POOLER_TX_URL
# DB_TENANT_POOLER_TX_URL=your_connection_url_here

# Tenant session pooler URL. Falls back to DB_POOLER_SESS_URL if unset.
# Aliases: DATABASE_TENANT_POOLER_SESS_URL
# DB_TENANT_POOLER_SESS_URL=your_connection_url_here

# Optional read-replica database URL. Falls back to pooler TX URL if unset.
# Aliases: DATABASE_READER_URL
# DB_READER_URL=your_connection_url_here

# API database pool max connections.
DB_API_MAX_CONN=20

# API pool connection acquire timeout (seconds).
DB_API_ACQUIRE_TIMEOUT_SECS=5

# Worker pool connection acquire timeout (seconds).
DB_WORKER_ACQUIRE_TIMEOUT_SECS=30

# Tenant database pool max connections.
DB_TENANT_MAX_CONN=5

# PgBouncer/Database host (used by system tenant management UI).
# Aliases: DATABASE_HOST
PGBOUNCER_HOST=localhost

# PgBouncer/Database port (used by system tenant management UI).
# Aliases: PGPORT
PGBOUNCER_PORT=5432

# --- Redis ---

# Redis connection URL. Required for durable roster-cache invalidation and distributed jobs.
REDIS_URL=your_connection_url_here

# --- Security ---

# JWT token signing secret. Must be at least 32 bytes in production. (required in production)
JWT_SECRET=your_secret_here

# JSON-encoded encryption keys for database URL encryption. Required in production. (required in production)
ENCRYPTION_KEYS_JSON=your_secret_here

# CORS allowed origins (comma-separated). Required in production. (required in production)
ALLOWED_ORIGINS=your_value_here

# Cookie domain for cross-subdomain auth (e.g. .vlee.dev).
# COOKIE_DOMAIN=your_value_here

# Global request body size cap (bytes) enforced on every route, including Multipart. Default: 2097152 (2MB). Routes needing larger uploads override this per-route.
MAX_REQUEST_BODY_BYTES=2097152

# Per-route request body size cap (bytes) for the generic file upload/update routes (/files/upload, /files/:id PUT). Default: 20971520 (20MB). Larger files should use the presigned-URL upload flow instead.
MAX_FILE_UPLOAD_BODY_BYTES=20971520

# Per-route request body size cap (bytes) for bulk Excel/CSV upload routes (attendance, employees, leave, paper-OT). Default: 10485760 (10MB).
MAX_BULK_UPLOAD_BODY_BYTES=10485760

# --- Storage ---

# S3-compatible storage endpoint URL. (required in production)
S3_ENDPOINT_URL=http://localhost:9000

# S3 bucket name for file storage. (required in production)
S3_BUCKET_NAME=leeattend

# S3 access key. (required in production)
S3_ACCESS_KEY=minioadmin

# S3 secret key. (required in production)
S3_SECRET_KEY=minioadmin

# S3 region.
S3_REGION=us-east-1

# Use path-style S3 addressing (true/false). Default: true (MinIO compatibility).
S3_USE_PATH_STYLE=true

# Files larger than this (bytes) use presigned URLs instead of proxying. Default: 1MB.
FILE_PROXY_THRESHOLD_BYTES=1048576

# Time-to-live for presigned URLs (seconds). Default: 900 (15 min).
PRESIGNED_URL_TTL_SECS=900

# Local storage directory for temporary files.
STORAGE_DIR=storage

# --- Worker ---

# Maximum concurrent background job workers.
WORKER_MAX_CONCURRENT_JOBS=5

# Worker Redis poll timeout in seconds (max 300).
WORKER_POLL_TIMEOUT_SECS=30

# Maximum job retry attempts.
WORKER_MAX_RETRIES=3

# Job execution timeout in seconds.
WORKER_JOB_TIMEOUT_SECS=300

# Number of rows per chunk during employee import.
IMPORT_CHUNK_SIZE=500

# Pairing scheduler sweep interval in seconds.
PAIRING_SWEEP_INTERVAL_SECS=2

# --- Attendance event log pull (disabled by default) ---
LOG_PULL_ENABLED=false
LOG_PULL_BASE_URL=https://provider.example.invalid
# LOG_PULL_TOKEN=
LOG_PULL_ACCOUNT_ID=account-id
LOG_PULL_MODE=shadow
LOG_PULL_INTERVAL_SECS=60
LOG_PULL_TIMEOUT_SECS=30
LOG_PULL_PAGE_SIZE=100
LOG_PULL_MAX_CONCURRENT_REQUESTS=4

# --- Rate Limiting ---

# Maximum read requests (GET/HEAD/OPTIONS) per rate limit window.
RATE_LIMIT_MAX_READ=120

# Maximum write requests (POST/PUT/PATCH/DELETE) per rate limit window.
RATE_LIMIT_MAX_WRITE=30

# Rate limit window duration in seconds.
RATE_LIMIT_WINDOW_SECS=60

# --- Virus Scanning ---

# ClamAV daemon host. Virus scanning is disabled if unset.
# CLAMD_HOST=your_value_here

# ClamAV daemon port.
CLAMD_PORT=3310

# --- Integration ---

# Supavisor admin API URL for automatic tenant registration on boot.
# SUPAVISOR_API_URL=your_value_here

# JWT secret for Supavisor API authentication. Must match Supavisor config.
# Aliases: SUPAVISOR_API_JWT
# API_JWT_SECRET=your_secret_here

# --- Feature Flags ---

# Emergency kill-switch for the no-show timeline scrubber. DB flag is source of truth; this is an override only.
FF_NO_SHOW_TIMELINE=false

# --- Standalone deployment ---
# Enable one-company LAN/on-prem mode. Requires all STANDALONE_* and LICENSE_* keys below.
STANDALONE_ENABLED=false
ORGANIZATION_NAME=Example Company
STANDALONE_ADMIN_EMAIL=admin@example.invalid
STANDALONE_ADMIN_PASSWORD=change-me-before-start
LICENSE_PATH=/run/leeattend/license.json
# Base64url-encoded Ed25519 verification public key; private signing key stays offline.
LICENSE_PUBLIC_KEY=replace-with-base64url-public-key

✅ [Python] Command finished with exit code 0
