# ==============================================================================
# LeeAttend Environment Variables — Reference
# ==============================================================================
# Copy this file to .env and fill in the values.
# Docker Compose reads this file automatically.
# ==============================================================================

# --- Infrastructure (shared across services) ---
DB_NAME=leeattend
DB_USER=admin
DB_PASSWORD=your_password_here
REDIS_PASSWORD=your_redis_password_here

# --- Supavisor (Connection Pooler) ---
# Use `openssl rand -hex 64` to generate a 128-character hex string
SUPAVISOR_SECRET_KEY=your_128_char_hex_secret_key_base_here
# Use `openssl rand -hex 32` to generate a 64-character hex string
SUPAVISOR_VAULT_KEY=your_64_char_hex_vault_enc_key_here
# API token for Supavisor admin endpoints. Must match the value expected by Supavisor.
SUPAVISOR_API_JWT=your-super-secret-jwt-token-with-at-least-32-bytes-long
# API URL for Supavisor (used by apiserver to auto-register tenant on boot)
# SUPAVISOR_API_URL=http://supavisor:4000
# Optional: Override the default tenant name (which is derived from DB_NAME)
# SUPAVISOR_TENANT_ID=custom_tenant_name
# Optional: Override the default pool user and password (derived from DB_USER and DB_PASSWORD)
# SUPAVISOR_POOL_USER=custom_pool_user
# SUPAVISOR_POOL_PASSWORD=custom_pool_password
# Optional: Pooler network and connection configurations
# SUPAVISOR_HOST=supavisor
# SUPAVISOR_PORT=6543
# SUPAVISOR_PORT_SESSION=5452
# SUPAVISOR_API_PORT=4000
# SUPAVISOR_POOL_SIZE=20
# SUPAVISOR_MODE_TYPE=session

# --- API Server ---
JWT_SECRET=your_jwt_secret_here
# ENCRYPTION_KEYS_JSON defines a JSON string containing base64 keys for DB URL encryption.
# Example: {"keys":{"v1":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="},"active_key":"v1"}
# Note: You MUST provide this in production environments!
# ENCRYPTION_KEYS_JSON=
# API_HOST=0.0.0.0
# API_PORT=3000

# Override apiserver URLs (optional, takes priority over docker-compose DB_* vars)
# DATABASE_URL: Points directly to the native Postgres. Used ONLY for Setup & Migrations.
# DATABASE_URL=postgres://user:pass@host:5432/dbname
#
# DATABASE_POOLER_URL: Points to Supavisor (or PgBouncer). Used for Application & Worker traffic.
# DATABASE_POOLER_URL=postgres://user.tenant:pass@pooler:6543/dbname
#
# DATABASE_REQUIRE_SSL: Toggles SSL encryption requirement for the Tenant when auto-registering with Supavisor.
# - If running via local Docker/Test environments without valid SSL certificates: Set to `false` (Default).
# - If connecting to a Production database (e.g. AWS RDS, Supabase Hosted, Google Cloud SQL)
#   that MANDATES SSL/TLS: You MUST set this to `true`. Otherwise, Supavisor will reject connections
#   or the origin database will drop connections from Supavisor due to lack of encryption.
# DATABASE_REQUIRE_SSL=false
#
# --- Tenant Database Provisioning ---
# Tenant databases are BYOD (Bring Your Own Database). When creating a workspace
# or registering a tenant, you must provide the database_url of an existing
# PostgreSQL database. The system will run tenant migrations on it and register
# it with Supavisor for connection pooling.
# Future providers (Railway API, Neon, etc.) will create databases externally
# and feed their connection strings into the same BYOD flow.

# CORS allowed origins (production only, comma-separated)
# ALLOWED_ORIGINS=https://yourdomain.com

# Cookie domain for cross-subdomain auth (e.g. .vlee.dev for hrm.vlee.dev + attapi.vlee.dev)
# COOKIE_DOMAIN=.yourdomain.com

# Agent log buffer tuning (optional)
# AGENT_LOG_BUFFER_CAPACITY=5000
# AGENT_LOG_BATCH_SIZE=100
# AGENT_LOG_FLUSH_MS=1000

# Report worker tuning (optional)
# WORKER_MAX_CONCURRENT=2
# WORKER_POLL_TIMEOUT_SECS=30
# WORKER_MAX_RETRIES=3
# WORKER_JOB_TIMEOUT_SECS=300

# --- Edge Agent ---
# AGENT_ID=test-agent
# AGENT_TOKEN=test-token
# AGENT_CENTRAL_SERVER_URL=ws://apiserver:3000/api/ws
# AGENT_DATABASE_URL=sqlite:///app/data/agent.db?mode=rwc

# Agent runtime tuning (optional)
# MAX_CONCURRENT_WORKERS: server-managed via ConfigPush (not an env var)
# POLL_INTERVAL_SECONDS=300
# INFLIGHT_TIMEOUT_SECS=300
# SUCCESS_COOLDOWN_SECS=300

# Agent memory management (optional)
# SIGNATURE_TTL_DAYS=90
# SIGNATURE_CLEANUP_HOURS=24

# --- Dev Server ---
# DEV_PORT=8080
