FROM rust:1.88

# Install clang, mold, and python3 (needed for agent-zk-worker sidecar)
RUN apt-get update && apt-get install -y clang mold python3 python3-pip && rm -rf /var/lib/apt/lists/*

# Pre-install cargo-watch for hot-reloading in Docker (bacon is TUI-only, swallows logs)
RUN cargo install cargo-watch

WORKDIR /app
