# LeeAttend Agent Configuration Template

# Unique identifier for this agent
# Default: test-agent
AGENT_ID=test-agent

# Authentication token for Central Server
# Default: test-token
AGENT_TOKEN=test-token

# WebSocket URL for Central Server
# Default: ws://localhost:8080/ws
CENTRAL_SERVER_URL=ws://localhost:8080/ws

# SQLite connection string
# Default: sqlite:attendance.db (or sqlite:${AGENT_ID}.db if AGENT_ID is provided)
DATABASE_URL=sqlite:attendance.db

# Path to Python interpreter for the ZK Worker sidecar
# Default: ../agent-zk-worker/venv/bin/python3 (Linux) or ../agent-zk-worker/venv/Scripts/python.exe (Windows)
PYTHON_PATH=../agent-zk-worker/venv/bin/python3

# Log level (error, warn, info, debug, trace)
RUST_LOG=info
