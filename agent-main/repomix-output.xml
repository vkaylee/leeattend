    sqlx::query_as::<_, models::RawAttendanceLog>(
        "SELECT id, device_id, user_id, timestamp, status, punch, is_synced, created_at, updated_at
         FROM zkt_raw_attendance
         WHERE is_synced = 2
         ORDER BY id ASC
         LIMIT ?"
    )
