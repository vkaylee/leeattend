    #[tokio::test]
    async fn test_hybrid_partial_sync() {
        let hybrid = HybridDatabase::new("sqlite::memory:", 1000).await.unwrap();

        // Save 5 logs
        let mut ids = Vec::new();
        for i in 1..=5 {
            let data = make_attendance(&format!("U{:03}", i), "2026-01-29 10:00:00");
