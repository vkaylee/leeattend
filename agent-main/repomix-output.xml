        let key = &args[2];
        let value = &args[3];

        db.upsert_agent_config(key, value).await?;
        println!();
        println!("✅ Configuration updated: {} = {}", key, value);
        println!("   Note: Agent restart may be required for some settings");
        println!();
    } else {
