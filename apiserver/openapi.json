  "paths": {
    "/agents": {
      "get": {
        "tags": [
          "crate::handlers"
        ],
        "operationId": "get_agents",
        "responses": {
          "200": {
            "description": "List all agents status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AgentStatus"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/devices": {
      "get": {
        "tags": [
          "crate::handlers"
        ],
        "operationId": "get_devices",
        "responses": {
          "200": {
            "description": "List all devices",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Device"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
