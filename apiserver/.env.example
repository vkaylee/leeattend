# SERVER CONFIG
API_HOST=0.0.0.0
API_PORT=3000

# DATABASE
DATABASE_URL=postgres://user:password@localhost:5432/leeatt

# SECURITY
# Origins cần thiết:
# - http://localhost:3000   : Dành cho Standalone Web Server
# - https://tauri.localhost : Dành cho Windows App (Tauri Webview2)
# - http://localhost:3001   : Dành cho môi trường Dev
ALLOWED_ORIGINS=http://localhost:3000,https://tauri.localhost,http://localhost:3001

# LOGGING
RUST_LOG=apiserver=debug,tower_http=debug,sqlx=info

# ATTENDANCE LOG PULL (disabled by default)
LOG_PULL_ENABLED=false
LOG_PULL_BASE_URL=https://provider.example.invalid
# LOG_PULL_TOKEN=
LOG_PULL_ACCOUNT_ID=account-id
LOG_PULL_MODE=shadow
LOG_PULL_INTERVAL_SECS=60
LOG_PULL_TIMEOUT_SECS=30
LOG_PULL_PAGE_SIZE=100
LOG_PULL_MAX_CONCURRENT_REQUESTS=4
