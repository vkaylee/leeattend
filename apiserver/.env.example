# SERVER CONFIG
APP_HOST=0.0.0.0
APP_PORT=3000
APP_ENV=development

# DATABASE
DB_PRIMARY_URL=postgres://user:password@localhost:5432/leeatt_system
DB_TENANT_POOLER_TX_URL=postgres://user:password@localhost:6543/tenant_db
DB_TENANT_POOLER_SESS_URL=postgres://user:password@localhost:5452/tenant_db

# SECURITY
JWT_SECRET=replace-with-a-secret-at-least-32-bytes-long
ALLOWED_ORIGINS=http://localhost:5173

# LOG PULL (disabled by default)
LOG_PULL_ENABLED=false
LOG_PULL_BASE_URL=https://provider.example.invalid
# LOG_PULL_TOKEN=
LOG_PULL_ACCOUNT_ID=account-id
LOG_PULL_MODE=shadow
LOG_PULL_INTERVAL_SECS=60
LOG_PULL_TIMEOUT_SECS=30
LOG_PULL_PAGE_SIZE=100
LOG_PULL_MAX_CONCURRENT_REQUESTS=4

