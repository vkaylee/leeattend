# SERVER CONFIG
APP_HOST=0.0.0.0
APP_PORT=3000
APP_ENV=development

# DATABASE
# Every URL uses the local PgBouncer listener; dev/production Compose overrides the host.
DB_PRIMARY_URL=postgres://leeattend:change-me@localhost:6432/leeattend_system
DB_POOLER_TX_URL=postgres://leeattend:change-me@localhost:6432/leeattend_system
DB_POOLER_SESS_URL=postgres://leeattend:change-me@localhost:6432/leeattend_system
DB_READER_URL=postgres://leeattend:change-me@localhost:6432/leeattend_system
PGBOUNCER_HOST=localhost
PGBOUNCER_PORT=6432

# SECURITY
JWT_SECRET=replace-with-a-secret-at-least-32-bytes-long
ALLOWED_ORIGINS=http://localhost:5173
