# SERVER CONFIG
API_HOST=0.0.0.0
API_PORT=3000

# DATABASE
DATABASE_URL=postgres://user:password@localhost:5432/leeatt

# SECURITY
# Origins cần thiết:
# - http://localhost:3000   : Dành cho Standalone Web Server
# - https://tauri.localhost : Dành cho Windows App (Tauri Webview2)
