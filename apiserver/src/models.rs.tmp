use chrono::{DateTime, NaiveDate, NaiveTime, Utc};
use serde::{Deserialize, Serialize};
use uuid::Uuid;

#[derive(Debug, Serialize, Deserialize, Clone, Copy, PartialEq, Eq, sqlx::Type, strum_macros::Display)]
#[sqlx(type_name = "member_role_type", rename_all = "snake_case")]
#[serde(rename_all = "snake_case")]
pub enum MemberRole { Owner, Admin, Member }

#[derive(Debug, Serialize, Deserialize, Clone, Copy, PartialEq, Eq, sqlx::Type, strum_macros::Display)]
#[sqlx(type_name = "leave_status_type", rename_all = "snake_case")]
#[serde(rename_all = "snake_case")]
pub enum LeaveStatus { Pending, Approved, Rejected }

#[derive(Debug, Serialize, Deserialize, Clone, Copy, PartialEq, Eq, sqlx::Type, strum_macros::Display)]
#[sqlx(type_name = "adjustment_status_type", rename_all = "snake_case")]
#[serde(rename_all = "snake_case")]
pub enum AdjustmentStatus { Pending, Approved, Rejected }

#[derive(Debug, Serialize, Deserialize, Clone, Copy, PartialEq, Eq, sqlx::Type, strum_macros::Display)]
#[sqlx(type_name = "log_source_type", rename_all = "snake_case")]
#[serde(rename_all = "snake_case")]
pub enum LogSource { Device, Import, Manual }

#[derive(Debug, Serialize, Deserialize, Clone, Copy, PartialEq, Eq, sqlx::Type, strum_macros::Display)]
#[sqlx(type_name = "import_job_status_type", rename_all = "snake_case")]
#[serde(rename_all = "snake_case")]
pub enum ImportJobStatus { Pending, Processing, Completed, Failed }

#[derive(Debug, Serialize, Deserialize, Clone, Copy, PartialEq, Eq, sqlx::Type, strum_macros::Display)]
#[sqlx(type_name = "leave_transaction_type", rename_all = "snake_case")]
#[serde(rename_all = "snake_case")]
pub enum LeaveTransactionType { Accrual, Usage, Adjustment, CarryOver }

#[derive(Debug, Serialize, Deserialize, Clone, Copy, PartialEq, Eq, sqlx::Type, strum_macros::Display)]
#[sqlx(type_name = "early_arrival_strategy_type", rename_all = "snake_case")]
#[serde(rename_all = "snake_case")]
pub enum EarlyArrivalStrategy { Allow, Block, Clamp }

#[derive(Debug, Serialize, Deserialize, Clone)]
#[serde(rename_all = "snake_case")]
pub enum AccrualFrequency { Monthly, Quarterly, Yearly }

#[derive(Debug, Serialize, Deserialize, Clone)]
pub struct SeniorityBonus {
    pub months: i32,
    pub bonus_amount: f64,
}

#[derive(Debug, Serialize, Deserialize, Clone, Default)]
pub struct LeaveTypeConfig {
    #[serde(default)] pub requires_document: bool,
    #[serde(default)] pub allow_negative_balance: bool,
    #[serde(default)] pub negative_balance_limit: Option<f64>,
    #[serde(default)] pub approval_required: bool,
}

#[derive(Debug, Serialize, Deserialize, Clone)]
pub struct LeavePolicyConfig {
    pub frequency: AccrualFrequency,
    pub accrual_amount: f64,
    pub accrual_timing: String,
    #[serde(default)] pub seniority_bonus: Vec<SeniorityBonus>,
    pub carry_over_limit: i32,
    pub max_balance: Option<f64>,
    pub reset_month: Option<i32>,
    pub min_work_days_threshold: Option<f64>,
}

#[derive(Debug, Serialize, Deserialize, sqlx::FromRow, Clone)]
pub struct Workspace {
    pub id: Uuid,
    pub name: String,
    pub work_unit_minutes: i32,
    pub rounding_policy: String,
    pub date_format: String,
    pub time_format: String,
    pub timezone: String,
    pub theme_primary_color: String,
    pub default_language: String,
    pub pairing_algorithm: String,
    pub early_arrival_strategy: EarlyArrivalStrategy,
    pub created_at: DateTime<Utc>,
}

#[derive(Debug, Serialize, Deserialize, sqlx::FromRow, Clone)]
pub struct AppState {
    pub agent_manager: crate::agent_manager::AgentManager,
    pub db: sqlx::PgPool,
    pub agent_repo: std::sync::Arc<dyn crate::repositories::AgentRepository>,
    pub workspace_repo: std::sync::Arc<dyn crate::repositories::WorkspaceRepository>,
    pub agent_service: std::sync::Arc<crate::services::AgentService>,
    pub jwt_secret: String,
}

