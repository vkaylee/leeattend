  "query": "SELECT id, employee_id, base_salary, salary_type, currency, effective_date, created_at as \"created_at!\", updated_at as \"updated_at!\" \n           FROM salary_history \n           WHERE employee_id = $1 AND effective_date <= $2 \n           ORDER BY effective_date DESC, created_at DESC \n           LIMIT 1",
