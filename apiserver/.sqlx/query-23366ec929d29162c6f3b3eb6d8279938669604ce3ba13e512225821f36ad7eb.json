{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT d.id, d.workspace_id, d.name, d.description, d.leave_type_id, d.rule_config as \"rule_config: sqlx::types::Json<LeavePolicyConfig>\", d.created_at as \"created_at!\", d.updated_at as \"updated_at!\", a.id as \"assignment_id!\", lt.code as \"leave_type_code!\"\n        FROM leave_policy_assignments a\n        JOIN leave_policy_definitions d ON a.policy_id = d.id\n        JOIN leave_types lt ON d.leave_type_id = lt.id\n        WHERE a.workspace_id = $1\n          AND a.assignee_type = 'workspace'\n          AND a.effective_from <= $2\n          AND (a.effective_to IS NULL OR a.effective_to > $2)\n        LIMIT 1\n        ",
