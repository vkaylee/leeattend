{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT id, employee_id, type as \"type_\", minute_allowance, is_paid, start_date, end_date\n            FROM working_conditions\n            WHERE employee_id = ANY($1)\n              AND start_date <= $3\n              AND (end_date IS NULL OR end_date >= $2)\n            ORDER BY employee_id, start_date\n            ",
