  "query": "\n        UPDATE leave_policy_definitions\n        SET name = COALESCE($3, name),\n            description = COALESCE($4, description),\n            leave_type_id = COALESCE($5, leave_type_id),\n            rule_config = COALESCE($6, rule_config),\n            updated_at = NOW()\n        WHERE id = $1 AND workspace_id = $2\n        RETURNING id, workspace_id, name, description, leave_type_id, rule_config as \"rule_config: sqlx::types::Json<LeavePolicyConfig>\", created_at as \"created_at!\", updated_at as \"updated_at!\"\n        ",
