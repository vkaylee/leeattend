{
  "db_name": "PostgreSQL",
  "query": "SELECT p.id, p.employee_id, p.period_start, p.period_end, p.base_pay_amount, p.overtime_pay_amount, p.deductions_amount, p.net_pay_amount, p.standard_units, p.overtime_units, p.status, p.created_at as \"created_at!\", p.updated_at as \"updated_at!\" \n           FROM payslips p\n           JOIN employees e ON e.id = p.employee_id\n           WHERE e.workspace_id = $1 AND p.period_start = $2 AND p.period_end = $3\n           ORDER BY p.created_at DESC",
