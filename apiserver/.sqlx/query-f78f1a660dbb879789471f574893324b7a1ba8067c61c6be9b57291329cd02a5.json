{
  "db_name": "PostgreSQL",
  "query": "SELECT ep.id, ep.employee_id, ep.hire_date, ep.termination_date, ep.is_rehire, ep.created_at as \"created_at!\", ep.updated_at as \"updated_at!\" \n         FROM employment_periods ep\n         JOIN employees e ON e.id = ep.employee_id\n         WHERE ep.employee_id = $1 AND e.workspace_id = $2\n         ORDER BY ep.hire_date DESC",
