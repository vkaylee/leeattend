FROM rust:1.88 AS chef
RUN cargo install cargo-chef
# Install system dependencies
RUN apt-get update && apt-get install -y build-essential clang mold libssl-dev pkg-config postgresql-client curl tar && rm -rf /var/lib/apt/lists/*
RUN rustup component add clippy rustfmt
WORKDIR /workspace/apiserver

FROM chef AS planner
WORKDIR /workspace/apiserver
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS cacher
WORKDIR /workspace/apiserver
COPY --from=planner /workspace/apiserver/recipe.json recipe.json
# Build dependencies
RUN cargo chef cook --tests --recipe-path recipe.json

FROM chef AS builder
WORKDIR /workspace/apiserver
# Install extra tools only needed for the runner
RUN cargo install sqlx-cli --locked --no-default-features --features postgres
RUN curl -LsSf https://get.nexte.st/0.9.96/linux | tar zxf - -C /usr/local/bin
RUN curl -L https://github.com/mozilla/sccache/releases/download/v0.8.2/sccache-v0.8.2-x86_64-unknown-linux-musl.tar.gz | tar xz \
    && mv sccache-v0.8.2-x86_64-unknown-linux-musl/sccache /usr/local/bin/sccache \
    && chmod +x /usr/local/bin/sccache

ENV RUSTC_WRAPPER=sccache
ENV SCCACHE_DIR=/sccache
ENV SQLX_OFFLINE=true

COPY . .
# Copy pre-compiled dependencies from cacher
COPY --from=cacher /workspace/apiserver/target target
COPY --from=cacher $CARGO_HOME $CARGO_HOME

# Build actual app
RUN cargo build --tests

# Default command
CMD ["./test-runner.sh"]
