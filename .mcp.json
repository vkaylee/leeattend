{
  "mcpServers": {
    "leedevkit-task-assessor": {
      "args": [
        ".leedevkit/scripts/_task_assessor_mcp.py"
      ],
      "command": ".leedevkit/.venv/bin/python3"
    },
    "playwright": {
      "command": "scripts/playwright-mcp-role.sh",
      "args": ["employee"]
    },
    "playwright-employee": {
      "command": "scripts/playwright-mcp-role.sh",
      "args": ["employee"]
    },
    "playwright-team-lead": {
      "command": "scripts/playwright-mcp-role.sh",
      "args": ["team-lead"]
    },
    "playwright-shift-manager": {
      "command": "scripts/playwright-mcp-role.sh",
      "args": ["shift-manager"]
    },
    "playwright-hr-manager": {
      "command": "scripts/playwright-mcp-role.sh",
      "args": ["hr-manager"]
    },
    "playwright-admin": {
      "command": "scripts/playwright-mcp-role.sh",
      "args": ["admin"]
    }
  }
}
