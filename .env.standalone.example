# Release manifest supplies immutable digest references for every image.
POSTGRES_IMAGE=public.ecr.aws/docker/library/postgres:18-alpine@sha256:replace
REDIS_IMAGE=public.ecr.aws/docker/library/redis:7-alpine@sha256:replace
MINIO_IMAGE=quay.io/minio/minio:latest@sha256:replace
APISERVER_IMAGE=registry.example.invalid/leeattend/apiserver:release@sha256:replace
WEBDASHBOARD_IMAGE=registry.example.invalid/leeattend/webdashboard:release@sha256:replace

APP_ENV=production
DB_NAME=leeattend
DB_USER=leeattend
DB_PASSWORD=replace-with-random-secret
POSTGRES_TLS_DIR=/secure/postgres/tls
REDIS_PASSWORD=replace-with-random-secret
MINIO_ROOT_USER=leeattend
MINIO_ROOT_PASSWORD=replace-with-random-secret
JWT_SECRET=replace-with-at-least-32-random-bytes
ENCRYPTION_KEYS_JSON={"keys":{"v1":"replace-with-64-byte-key-material"},"active_key":"v1"}
ALLOWED_ORIGINS=https://attendance.lan
STANDALONE_WORKSPACE_ID=00000000-0000-7000-8000-000000000001
STANDALONE_WORKSPACE_NAME=Example_Company
STANDALONE_ADMIN_EMAIL=admin@example.invalid
STANDALONE_ADMIN_PASSWORD=replace-before-start
LICENSE_PUBLIC_KEY=replace-with-base64url-ed25519-public-key
LICENSE_FILE=/secure/licenses/leeattend.json
S3_BUCKET_NAME=leeattend
LOG_PULL_ENABLED=false
