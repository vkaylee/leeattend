                  </p>\n                </div>\n                <div className=\"flex gap-6 border-t border-slate-50 dark:border-slate-800 pt-2\">\n                    <button\n                        className=\"flex-1 px-8 py-4 rounded-2xl font-bold text-xs uppercase tracking-widest text-slate-500 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-all active:scale-95\"\n                        disabled={isPending}\n                        onClick={onClose}\n                    >\n                        {t(\"common.cancel\")}\n                    </button>\n                    <button\n                        className=\"flex-[1.5] bg-slate-900 hover:bg-primary-700 text-white font-bold px-8 py-4 rounded-2xl flex items-center justify-center gap-4 transition-all active:scale-95 disabled:opacity-50 shadow-2xl shadow-slate-400 dark:shadow-black/40 text-xs uppercase tracking-widest\"\n                        disabled={isPending}\n                        onClick={onConfirm}\n                    >\n                        {isPending ? (\n                            <RefreshCw className=\"w-5 h-5 animate-spin\" />\n                        ) : (\n                            <Check size={20} />\n                        )}{\" \"}\n                        {t(\"reports.reprocess.confirm\").toUpperCase()}\n                    </button>\n                </div>\n            </div>\n        </Modal>\n    );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/reports/daily-report-table-row.tsx","messages":[{"ruleId":"complexity","severity":2,"message":"Function 'DailyReportTableRow' has a complexity of 12. Maximum allowed is 10.","line":134,"column":8,"nodeType":"FunctionDeclaration","messageId":"complex","endLine":134,"endColumn":36}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { RefreshCw, Bug, CheckCircle, ThumbsUp, ThumbsDown } from \"lucide-react\";\nimport React from \"react\";\n\nimport { DailyAttendanceReport, AttendanceAdjustmentRequest } from \"@/lib/api\";\nimport { cn } from \"@/lib/utils\";\nimport { formatUnitsToHours } from \"@/lib/utils/attendance\";\n\nimport { ReportOtStatusBadge } from \"./report-ot-status-badge\";\nimport { ReportStatusBadge } from \"./report-status-badge\";\n\nfunction DailyReportTableRowExpanded({ row }: { row: DailyAttendanceReport }) {\n  return (\n    <tr className=\"bg-slate-900/5 animate-in slide-in-from-top-2 duration-500\">\n      <td className=\"px-10 py-10\" colSpan={10}>\n        <div className=\"bg-slate-900 rounded-[3rem] p-10 shadow-2xl border-2 border-amber-200/20 overflow-hidden relative\">\n          <div className=\"flex items-center gap-4 mb-8 border-b border-white/10 pb-6 relative z-10\">\n            <div className=\"w-10 h-10 rounded-xl bg-amber-50 dark:bg-amber-950/10 flex items-center justify-center text-amber-400 shadow-inner border border-amber-500/20\">\n              <Bug size={20} />\n            </div>\n            <div>\n              <h4 className=\"text-[10px] font-bold text-amber-400 uppercase tracking-[0.3em]\">\n                Audit Trail Analysis\n              </h4>\n              <p className=\"text-[9px] text-white/40 uppercase tracking-widest mt-1 font-bold\">\n                BSON Traceability Metadata — Real-time Evaluator Logs\n              </p>\n            </div>\n          </div>\n          <pre className=\"text-[11px] font-mono text-emerald-400 leading-relaxed overflow-x-auto custom-scrollbar relative z-10 p-2 selection:bg-emerald-50 dark:bg-emerald-950/20 max-h-[400px]\">\n            {JSON.stringify(\n              row.generation_metadata ?? { message: \"No metadata available\" },\n              null,\n              2\n            )}\n          </pre>\n          <Bug className=\"absolute -right-16 -bottom-16 w-64 h-64 text-amber-500 opacity-5 -rotate-12 pointer-events-none\" />\n        </div>\n      </td>\n    </tr>\n  );\n}\n\nfunction ShiftCell({ row, t }: { row: DailyAttendanceReport; t: (k: string) => string }) {\n  if (!row.scheduled_start) {\n    return (\n      <span className=\"text-[9px] font-bold text-slate-300 dark:text-slate-600 uppercase tracking-widest italic opacity-50\">\n        {t(\"reports.no_shift\")}\n      </span>\n    );\n  }\n\n  return (\n    <div className=\"flex flex-col\">\n      <span className=\"font-bold text-slate-700 dark:text-slate-200 text-xs uppercase tracking-tighter shadow-sm bg-white dark:bg-slate-900 px-2 py-0.5 rounded-lg border border-slate-100 dark:border-slate-800 w-fit\">\n        {row.scheduled_start.substring(0, 5)} — {row.scheduled_end?.substring(0, 5)}\n      </span>\n      {row.break_duration_minutes !== null ? (\n        <span className=\"text-[8px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.2em] mt-1.5 opacity-70 italic\">\n          {row.break_start\n            ? `${t(\"common.break\")}: ${row.break_start.substring(0, 5)}-${row.break_end?.substring(0, 5)}`\n            : `${t(\"common.break\")}: ${row.break_duration_minutes.toString()}m`}\n        </span>\n      ) : null}\n    </div>\n  );\n}\n\nfunction OtCell({\n  onApproveOt,\n  row,\n  t,\n  workUnitMinutes,\n}: {\n  onApproveOt?: (row: DailyAttendanceReport, action: \"approved\" | \"rejected\") => void;\n  row: DailyAttendanceReport;\n  t: (k: string) => string;\n  workUnitMinutes: number;\n}) {\n  if (row.ot_work_units <= 0) {\n    return <span className=\"text-slate-200 dark:text-slate-700 font-bold\">—</span>;\n  }\n\n  return (\n    <div className=\"flex flex-col items-end gap-1\">\n      <div>\n        <span className=\"font-mono font-bold text-orange-600 dark:text-orange-400 text-base tracking-tighter leading-none\">\n          {formatUnitsToHours(row.ot_work_units, workUnitMinutes)}h\n        </span>\n      </div>\n      <ReportOtStatusBadge status={row.ot_claim_status} t={t} />\n      {row.ot_claim_status === \"pending_manager\" && onApproveOt ? (\n        <div className=\"flex gap-1 mt-1\">\n          <button\n            className=\"flex items-center gap-0.5 px-2 py-0.5 rounded-md text-[8px] font-bold uppercase tracking-wider bg-emerald-500 text-white hover:bg-emerald-600 transition-colors shadow-sm active:scale-95\"\n            onClick={(e) => { e.stopPropagation(); onApproveOt(row, \"approved\"); }}\n            title={t(\"reports.ot_approve.approve\")}\n          >\n            <ThumbsUp size={10} />\n            {t(\"reports.ot_approve.approve\")}\n          </button>\n          <button\n            className=\"flex items-center gap-0.5 px-2 py-0.5 rounded-md text-[8px] font-bold uppercase tracking-wider bg-rose-500 text-white hover:bg-rose-600 transition-colors shadow-sm active:scale-95\"\n            onClick={(e) => { e.stopPropagation(); onApproveOt(row, \"rejected\"); }}\n            title={t(\"reports.ot_approve.reject\")}\n          >\n            <ThumbsDown size={10} />\n            {t(\"reports.ot_approve.reject\")}\n          </button>\n        </div>\n      ) : null}\n    </div>\n  );\n}\n\nexport interface DailyReportTableRowProps {\n  adjustmentMap: Partial<Record<string, AttendanceAdjustmentRequest>>;\n  confirmingRow: string | null;\n  expandedDebugRows: Set<string>;\n  formatDate: (date: string) => string;\n  formatTime: (time: string | null) => string;\n  hideEmployeeName: boolean;\n  isDebugMode: boolean;\n  onApproveOt?: (row: DailyAttendanceReport, action: \"approved\" | \"rejected\") => void;\n  onConfirmClick: (row: DailyAttendanceReport, existing?: AttendanceAdjustmentRequest) => void;\n  onReprocessClick: (row: DailyAttendanceReport) => void;\n  onResolveUnscheduled?: (row: DailyAttendanceReport) => void;\n  onToggleExpandRow: (rowKey: string) => void;\n  reprocessingRow: string | null;\n  row: DailyAttendanceReport;\n  t: (key: string) => string;\n  workUnitMinutes: number;\n}\n\nexport function DailyReportTableRow({\n  adjustmentMap,\n  confirmingRow,\n  expandedDebugRows,\n  formatDate,\n  formatTime,\n  hideEmployeeName,\n  isDebugMode,\n  onApproveOt,\n  onConfirmClick,\n  onReprocessClick,\n  onResolveUnscheduled,\n  onToggleExpandRow,\n  reprocessingRow,\n  row,\n  t,\n  workUnitMinutes,\n}: DailyReportTableRowProps) {\n  const rowKey = `${row.employee_id}-${row.date}`;\n  const isReprocessing = reprocessingRow === rowKey;\n  const isConfirming = confirmingRow === rowKey;\n  const isExpanded = expandedDebugRows.has(rowKey);\n  const existingAdjustment = adjustmentMap[rowKey];\n\n  return (\n    <React.Fragment>\n      <tr className={cn(\"transition-all group\", isExpanded ? \"bg-amber-50 dark:bg-amber-950/20\" : \"hover:bg-slate-50 dark:hover:bg-slate-800/50\")}>\n        <td className=\"px-4 py-2.5 font-mono text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase whitespace-nowrap sticky left-0 z-10 bg-white group-hover:bg-slate-50 dark:bg-slate-900 dark:group-hover:bg-slate-800/50 transition-colors\">\n          {formatDate(row.date)}\n        </td>\n        {!hideEmployeeName ? (\n          <td className=\"px-4 py-2.5 font-bold text-slate-700 dark:text-slate-200 text-sm tracking-tight uppercase leading-none whitespace-nowrap sticky left-[80px] sm:left-[100px] z-10 bg-white group-hover:bg-slate-50 dark:bg-slate-900 dark:group-hover:bg-slate-800/50 transition-colors\">\n            {row.employee_name}\n          </td>\n        ) : null}\n        <td className=\"px-4 py-2.5\"><ShiftCell row={row} t={t} /></td>\n        <td className=\"px-4 py-2.5 text-center font-mono font-bold text-xs text-slate-700 dark:text-slate-200 tracking-tighter\">\n          <div className=\"shadow-inner bg-slate-50 dark:bg-slate-800/50 rounded-md py-1 px-2 inline-block\">{formatTime(row.actual_punch_in)}</div>\n        </td>\n        <td className=\"px-4 py-2.5 text-center font-mono font-bold text-xs text-slate-700 dark:text-slate-200 tracking-tighter\">\n          <div className=\"shadow-inner bg-slate-50 dark:bg-slate-800/50 rounded-md py-1 px-2 inline-block\">{formatTime(row.actual_punch_out)}</div>\n        </td>\n        <td className=\"px-4 py-2.5 text-right\">\n          <div className=\"font-mono font-bold text-primary-600 dark:text-primary-400 text-base tracking-tighter leading-none\">{formatUnitsToHours(row.std_work_units, workUnitMinutes)}h</div>\n        </td>\n        <td className=\"px-4 py-2.5 text-right\"><OtCell onApproveOt={onApproveOt} row={row} t={t} workUnitMinutes={workUnitMinutes} /></td>\n        <td className=\"px-4 py-2.5 text-center\"><ReportStatusBadge onResolveUnscheduled={onResolveUnscheduled} row={row} status={row.status} t={t} /></td>\n        {isDebugMode ? (\n          <td className=\"px-4 py-2.5 text-center\">\n            <button\n              className={cn(\"p-1.5 rounded-lg transition-all shadow-sm border active:scale-95\", isExpanded ? \"bg-amber-100 dark:bg-amber-900 text-amber-700 dark:text-amber-300 border-amber-200\" : \"bg-white dark:bg-slate-900 text-amber-600 dark:text-amber-300 border-slate-100 dark:border-slate-800 hover:bg-amber-50 dark:bg-amber-950\")}\n              onClick={() => { onToggleExpandRow(rowKey); }}\n            ><Bug size={16} /></button>\n          </td>\n        ) : null}\n        <td className=\"px-4 py-2.5 text-right\">\n          <div className=\"flex items-center justify-end gap-1.5 opacity-0 group-hover:opacity-100 transition-opacity focus-within:opacity-100\">\n            <button\n              className={cn(\"flex items-center justify-center p-1.5 rounded-lg transition-all shadow-sm border active:scale-95\", existingAdjustment !== undefined ? \"bg-orange-50 dark:bg-orange-950 text-orange-600 dark:text-orange-300 border-orange-200 dark:border-orange-800 hover:bg-orange-100 dark:hover:bg-orange-900\" : \"bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-400 border-emerald-200 dark:border-emerald-800 hover:bg-emerald-100 dark:hover:bg-emerald-900\", isConfirming && \"opacity-70 cursor-wait\")}\n              disabled={isConfirming}\n              onClick={() => { onConfirmClick(row, existingAdjustment); }}\n              title={existingAdjustment !== undefined ? t(\"reports.confirm.pending_badge\") : t(\"common.attendance_confirm\")}\n            >{isConfirming ? <RefreshCw className=\"animate-spin\" size={14} /> : <CheckCircle size={14} />}</button>\n            <button\n              className=\"p-1.5 bg-white dark:bg-slate-900 text-blue-600 dark:text-blue-300 hover:bg-blue-50 dark:hover:bg-slate-800 rounded-lg shadow-sm border border-slate-200 dark:border-slate-700 transition-all active:scale-95 disabled:opacity-50\"\n              disabled={isReprocessing}\n              onClick={() => { onReprocessClick(row); }}\n              title={t(\"reports.reprocess.tooltip\")}\n            ><RefreshCw className={cn(isReprocessing && \"animate-spin\")} size={18} /></button>\n          </div>\n        </td>\n      </tr>\n      {isDebugMode && isExpanded ? <DailyReportTableRowExpanded row={row} /> : null}\n    </React.Fragment>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/reports/daily-report-table.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/reports/employee-daily-drawer.tsx","messages":[{"ruleId":"complexity","severity":2,"message":"Arrow function has a complexity of 13. Maximum allowed is 10.","line":152,"column":50,"nodeType":"ArrowFunctionExpression","messageId":"complex","endLine":152,"endColumn":52}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import type { TFunction } from \"i18next\";\n\nimport { CalendarCheck, FileBarChart, Clock } from \"lucide-react\";\nimport React, { useRef, useEffect } from \"react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport type { DailyAttendanceReport, AttendanceAdjustmentRequest, Shift } from \"@/lib/api\";\n\nimport Sheet from \"@/components/ui/sheet\";\nimport { useDebug } from \"@/context/debug-context\";\nimport { useDateTimeFormatter } from \"@/hooks/use-datetime\";\n\nimport ConfirmAttendanceModal from \"./confirm-attendance-modal\";\nimport ConfirmReprocessModal from \"./confirm-reprocess-modal\";\nimport DailyReportTable from \"./daily-report-table\";\nimport RawLogsTable from \"./raw-logs-table\";\nimport ResolveUnscheduledModal from \"./resolve-unscheduled-modal\";\nimport { useEmployeeDailyDrawer } from \"./use-employee-daily-drawer\";\n\ninterface EmployeeDailyDrawerProps {\n    dateRange: { start: string; end: string };\n    employeeId: string;\n    employeeName: string;\n    isOpen: boolean;\n    onClose: () => void;\n    workspaceId: string;\n    workUnitMinutes: number;\n}\n\ninterface EmployeeDailyDrawerHeaderProps {\n    isLoading: boolean;\n    reportData: DailyAttendanceReport[];\n    setViewMode: (mode: \"daily\" | \"raw\") => void;\n    t: TFunction;\n    totalOtHours: string | number;\n    totalStdHours: string | number;\n    viewMode: \"daily\" | \"raw\";\n}\n\nfunction EmployeeDailyDrawerHeader({ viewMode, setViewMode, isLoading, reportData, totalStdHours, totalOtHours, t }: EmployeeDailyDrawerHeaderProps) {\n    return (\n        <>\n            <div className=\"flex bg-slate-100 dark:bg-slate-800 rounded-lg p-1 border border-slate-200 dark:border-slate-700\">\n                <button\n                    className={`px-3 py-1.5 text-[10px] font-bold uppercase tracking-widest rounded-md transition-all ${viewMode === \"daily\"\n                        ? \"bg-white dark:bg-slate-700 text-primary-600 dark:text-primary-400 shadow-sm\"\n                        : \"text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200\"\n                        }`}\n                    onClick={() => { setViewMode(\"daily\"); }}\n                >\n                    {t(\"reports.tabs.daily\")}\n                </button>\n                <button\n                    className={`px-3 py-1.5 text-[10px] font-bold uppercase tracking-widest rounded-md transition-all ${viewMode === \"raw\"\n                        ? \"bg-white dark:bg-slate-700 text-primary-600 dark:text-primary-400 shadow-sm\"\n                        : \"text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200\"\n                        }`}\n                    onClick={() => { setViewMode(\"raw\"); }}\n                >\n                    <span className=\"flex items-center gap-1.5\"><CalendarCheck size={12} /> {t(\"reports.view_raw_logs\")}</span>\n                </button>\n            </div>\n            {viewMode === \"daily\" && !isLoading && reportData.length > 0 ? (\n                <>\n                    <div className=\"flex items-center gap-1.5 bg-slate-900 dark:bg-slate-800 px-3 py-1.5 rounded-lg border border-slate-800 dark:border-slate-700 shadow-sm\">\n                        <FileBarChart className=\"text-primary-400\" size={12} />\n                        <span className=\"text-[9px] font-bold text-slate-400 uppercase tracking-widest\">{t(\"reports.quick_stats.std_hours\")}</span>\n                        <span className=\"font-mono font-bold text-white text-xs tracking-tighter\">{totalStdHours}h</span>\n                    </div>\n                    {Number(totalOtHours) > 0 ? (\n                        <div className=\"flex items-center gap-1.5 bg-gradient-to-r from-orange-900 to-orange-950 px-3 py-1.5 rounded-lg border border-orange-800 shadow-sm\">\n                            <Clock className=\"text-orange-400\" size={12} />\n                            <span className=\"text-[9px] font-bold text-orange-400/70 uppercase tracking-widest\">{t(\"reports.quick_stats.ot_hours\")}</span>\n                            <span className=\"font-mono font-bold text-orange-100 text-xs tracking-tighter\">{totalOtHours}h</span>\n                        </div>\n                    ) : null}\n                </>\n            ) : null}\n        </>\n    );\n}\n\ninterface EmployeeDailyDrawerModalsProps {\n    confirmDialog: { show?: boolean; employeeId: string; employeeName: string; date: string } | null;\n    confirmModalData: { row: DailyAttendanceReport; existingRequest?: AttendanceAdjustmentRequest } | null;\n    confirmMutationPending: boolean;\n    handleConfirmReprocess: () => void;\n    handleConfirmSubmit: (data: { punchIn: string; punchOut: string; reason: string }) => void;\n    handleResolveSubmit: (shiftId: string) => void;\n    reprocessMutationPending: boolean;\n    resolveModalData: { row: DailyAttendanceReport } | null;\n    resolveUnscheduledMutationPending: boolean;\n    setConfirmDialog: (data: { show: boolean; employeeId: string; employeeName: string; date: string } | null) => void;\n    setConfirmModalData: (data: { row: DailyAttendanceReport; existingRequest?: AttendanceAdjustmentRequest } | null) => void;\n    setResolveModalData: (data: { row: DailyAttendanceReport } | null) => void;\n    shifts?: Shift[];\n}\n\nfunction EmployeeDailyDrawerModals({\n    confirmDialog,\n    reprocessMutationPending,\n    setConfirmDialog,\n    handleConfirmReprocess,\n    confirmModalData,\n    confirmMutationPending,\n    setConfirmModalData,\n    handleConfirmSubmit,\n    resolveModalData,\n    resolveUnscheduledMutationPending,\n    setResolveModalData,\n    handleResolveSubmit,\n    shifts\n}: EmployeeDailyDrawerModalsProps) {\n    return (\n        <>\n            <ConfirmReprocessModal\n                dialogData={confirmDialog}\n                isOpen={!!confirmDialog}\n                isPending={reprocessMutationPending}\n                key={confirmDialog ? `reprocess-${confirmDialog.employeeId}-${confirmDialog.date}` : \"reprocess-empty\"}\n                onClose={() => { setConfirmDialog(null); }}\n                onConfirm={handleConfirmReprocess}\n            />\n\n            <ConfirmAttendanceModal\n                existingRequest={confirmModalData?.existingRequest}\n                isOpen={!!confirmModalData}\n                isPending={confirmMutationPending}\n                key={confirmModalData ? `confirm-${confirmModalData.row.date}` : \"confirm-empty\"}\n                onClose={() => { setConfirmModalData(null); }}\n                onSubmit={handleConfirmSubmit}\n                row={confirmModalData?.row ?? null}\n            />\n\n            <ResolveUnscheduledModal\n                isOpen={!!resolveModalData}\n                isPending={resolveUnscheduledMutationPending}\n                key={resolveModalData ? `resolve-${resolveModalData.row.date}` : \"resolve-empty\"}\n                onClose={() => { setResolveModalData(null); }}\n                onSubmit={handleResolveSubmit}\n                row={resolveModalData?.row ?? null}\n                shifts={shifts}\n            />\n        </>\n    );\n}\n\nfunction useDrawerKeyboardNavigation(isOpen: boolean, viewMode: \"daily\" | \"raw\", setViewMode: (mode: \"daily\" | \"raw\") => void, contentRef: React.RefObject<HTMLDivElement | null>) {\n    useEffect(() => {\n        if (!isOpen) return;\n\n        const handleKeyDown = (e: KeyboardEvent) => {\n            if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) {\n                return;\n            }\n\n            if (e.key === \"ArrowRight\" && viewMode === \"daily\") {\n                setViewMode(\"raw\");\n            } else if (e.key === \"ArrowLeft\" && viewMode === \"raw\") {\n                setViewMode(\"daily\");\n            } else if (e.key === \"ArrowDown\" || e.key === \"ArrowUp\") {\n                e.preventDefault();\n                const scrollContainer = contentRef.current?.querySelector(\".overflow-auto\") ?? contentRef.current;\n                if (scrollContainer) {\n                    scrollContainer.scrollBy({ top: e.key === \"ArrowDown\" ? 100 : -100, behavior: \"smooth\" });\n                }\n            }\n        };\n\n        window.addEventListener(\"keydown\", handleKeyDown);\n        return () => { window.removeEventListener(\"keydown\", handleKeyDown); };\n    }, [isOpen, viewMode, setViewMode, contentRef]);\n}\n\nexport default function EmployeeDailyDrawer(props: EmployeeDailyDrawerProps) {\n    const { isOpen, onClose, employeeName, dateRange, workUnitMinutes } = props;\n    const { t } = useTranslation();\n    const { formatDate, formatTime } = useDateTimeFormatter();\n    const { isEnabled: isDebugMode } = useDebug();\n    const contentRef = useRef<HTMLDivElement>(null);\n\n    const data = useEmployeeDailyDrawer(props);\n\n    // Keyboard navigation for tabs + scroll\n    useDrawerKeyboardNavigation(isOpen, data.viewMode, data.setViewMode, contentRef);\n\n    return (\n        <>\n            <Sheet\n                className=\"w-[95vw] xl:w-[1200px] !max-w-[95vw]\"\n                contentClassName=\"!overflow-hidden\"\n                headerExtra={\n                    <EmployeeDailyDrawerHeader\n                        isLoading={data.isLoading}\n                        reportData={data.reportData}\n                        setViewMode={data.setViewMode}\n                        t={t}\n                        totalOtHours={data.totalOtHours}\n                        totalStdHours={data.totalStdHours}\n                        viewMode={data.viewMode}\n                    />\n                }\n                isOpen={isOpen}\n                onClose={onClose}\n                subtitle={`${formatDate(dateRange.start)} — ${formatDate(dateRange.end)}`}\n                title={employeeName}\n            >\n                <div className=\"-mx-10 -mt-4 -mb-10 h-[calc(100%+theme(spacing.14))] flex flex-col\" ref={contentRef}>\n                    {data.viewMode === \"raw\" ? (\n                        <RawLogsTable\n                            fetchNextPage={data.fetchNextPage}\n                            hasNextPage={data.hasNextPage}\n                            isFetchingNextPage={data.isFetchingNextPage}\n                            rawLogsData={data.rawLogsData}\n                            rawLogsLoading={data.rawLogsLoading}\n                        />\n                    ) : (\n                        <DailyReportTable\n                            adjustmentMap={data.adjustmentMap}\n                            confirmingRow={data.confirmingRow}\n                            data={data.reportData}\n                            expandedDebugRows={data.expandedDebugRows}\n                            formatDate={formatDate}\n                            formatTime={formatTime}\n                            hideEmployeeName\n                            isDebugMode={isDebugMode}\n                            isLoading={data.isLoading}\n                            onApproveOt={data.handleApproveOt}\n                            onConfirmClick={data.handleConfirmClick}\n                            onReprocessClick={data.handleReprocessClick}\n                            onResolveUnscheduled={data.handleResolveUnscheduled}\n                            onToggleExpandRow={data.toggleExpandRow}\n                            reprocessingRow={data.reprocessingRow}\n                            t={t}\n                            workUnitMinutes={workUnitMinutes}\n                        />\n                    )}\n                </div>\n            </Sheet>\n\n            <EmployeeDailyDrawerModals\n                confirmDialog={data.confirmDialog}\n                confirmModalData={data.confirmModalData}\n                confirmMutationPending={data.confirmMutationPending}\n                handleConfirmReprocess={data.handleConfirmReprocess}\n                handleConfirmSubmit={data.handleConfirmSubmit}\n                handleResolveSubmit={data.handleResolveSubmit}\n                reprocessMutationPending={data.reprocessMutationPending}\n                resolveModalData={data.resolveModalData}\n                resolveUnscheduledMutationPending={data.resolveUnscheduledMutationPending}\n                setConfirmDialog={data.setConfirmDialog}\n                setConfirmModalData={data.setConfirmModalData}\n                setResolveModalData={data.setResolveModalData}\n                shifts={data.shifts}\n            />\n        </>\n    );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/reports/raw-logs-table.tsx","messages":[{"ruleId":"@typescript-eslint/no-unnecessary-type-conversion","severity":2,"message":"Using !! on a boolean does not change the type or value of the boolean.","line":109,"column":22,"nodeType":null,"messageId":"unnecessaryTypeConversion","endLine":109,"endColumn":24,"suggestions":[{"messageId":"suggestRemove","fix":{"range":[7292,7305],"text":"hasNextPage"},"desc":"Remove the type conversion."},{"messageId":"suggestSatisfies","data":{"type":"boolean"},"fix":{"range":[7292,7305],"text":"(hasNextPage satisfies boolean)"},"desc":"Instead, assert that the value satisfies the boolean type."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { SearchX, Clock } from \"lucide-react\";\nimport React from \"react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport InfiniteScrollSentinel from \"@/components/common/infinite-scroll-sentinel\";\nimport { useDateTimeFormatter } from \"@/hooks/use-datetime\";\nimport { useInfiniteScroll } from \"@/hooks/use-infinite-scroll\";\nimport { RawAttendanceLog } from \"@/lib/api\";\n\ninterface RawLogsTableProps {\n    fetchNextPage: () => void;\n    hasNextPage: boolean;\n    isFetchingNextPage: boolean;\n    rawLogsData: RawAttendanceLog[];\n    rawLogsLoading: boolean;\n}\n\nexport default function RawLogsTable({\n    rawLogsData,\n    rawLogsLoading,\n    hasNextPage,\n    isFetchingNextPage,\n    fetchNextPage,\n}: RawLogsTableProps) {\n    const { t } = useTranslation();\n    const { formatDate, formatTime } = useDateTimeFormatter();\n    \n    const loadMoreRef = useInfiniteScroll<HTMLTableRowElement>({\n        hasNextPage,\n        isFetchingNextPage,\n        fetchNextPage,\n    });\n\n    return (\n        <div className=\"overflow-auto flex-1 min-h-0 relative\">\n            <table className=\"w-full text-left border-collapse\">\n                <thead>\n                    <tr className=\"bg-slate-50/95 dark:bg-slate-800/95 backdrop-blur-sm border-b border-slate-100 dark:border-slate-800 sticky top-0 z-10\">\n                        <th className=\"px-8 py-4 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">{t(\"common.time\")}</th>\n                        <th className=\"px-8 py-4 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">{t(\"common.source\")}</th>\n                        <th className=\"px-8 py-4 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest text-right\">{t(\"common.status\")}</th>\n                    </tr>\n                </thead>\n                <tbody className=\"divide-y divide-slate-50 dark:divide-slate-800\">\n                    {rawLogsLoading ? (\n                        Array.from({ length: 5 }).map((_, index) => (\n                            <tr className=\"border-b border-slate-50 dark:border-slate-800/50\" key={`skeleton-log-${index}`}>\n                                <td className=\"px-8 py-5\">\n                                    <div className=\"flex items-center gap-4\">\n                                        <div className=\"w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-800 animate-pulse\"></div>\n                                        <div className=\"space-y-1\">\n                                            <div className=\"h-4 w-20 bg-slate-200 dark:bg-slate-700 animate-pulse rounded\"></div>\n                                            <div className=\"h-3 w-16 bg-slate-100 dark:bg-slate-800 animate-pulse rounded\"></div>\n                                        </div>\n                                    </div>\n                                </td>\n                                <td className=\"px-8 py-5\">\n                                    <div className=\"h-4 w-24 bg-slate-200 dark:bg-slate-700 animate-pulse rounded\"></div>\n                                </td>\n                                <td className=\"px-8 py-5 text-right\">\n                                    <div className=\"flex justify-end\">\n                                        <div className=\"h-4 w-16 bg-emerald-100 dark:bg-emerald-900/20 animate-pulse rounded-full\"></div>\n                                    </div>\n                                </td>\n                            </tr>\n                        ))\n                    ) : rawLogsData.length === 0 ? (\n                        <tr>\n                            <td className=\"px-8 py-20\" colSpan={3}>\n                                <div className=\"flex flex-col items-center justify-center text-center animate-in fade-in zoom-in-95 duration-500 max-w-sm mx-auto\">\n                                    <div className=\"w-16 h-16 mb-4 rounded-3xl bg-slate-50 dark:bg-slate-800/80 flex items-center justify-center text-slate-300 dark:text-slate-600 shadow-inner border border-slate-100 dark:border-slate-700/50 rotate-3\">\n                                        <SearchX className=\"-rotate-3\" size={24} />\n                                    </div>\n                                    <h3 className=\"text-xs font-bold text-slate-700 dark:text-slate-200 uppercase tracking-widest mb-1\">\n                                        {t(\"attendance_logs.messages.no_data\")}\n                                    </h3>\n                                    <p className=\"text-[10px] font-medium text-slate-500 dark:text-slate-400 max-w-[200px]\">\n                                        No punches were recorded for this day.\n                                    </p>\n                                </div>\n                            </td>\n                        </tr>\n                    ) : (\n                        rawLogsData.map((log: RawAttendanceLog) => (\n                            <tr className=\"hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors group\" key={log.id}>\n                                <td className=\"px-8 py-5\">\n                                    <div className=\"flex items-center gap-4\">\n                                        <div className=\"w-10 h-10 rounded-xl bg-primary-50 dark:bg-primary-950 flex items-center justify-center text-primary-600 dark:text-primary-400 shadow-inner border border-primary-100 dark:border-primary-800/50\"><Clock size={18} /></div>\n                                        <div>\n                                            <div className=\"font-bold text-slate-700 dark:text-slate-200 text-sm tracking-tight uppercase\">{formatDate(log.punch_time)}</div>\n                                            <div className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 font-mono uppercase tracking-tighter\">{formatTime(log.punch_time)}</div>\n                                        </div>\n                                    </div>\n                                </td>\n                                <td className=\"px-8 py-5\">\n                                    <div className=\"flex flex-col gap-1\">\n                                        <div className=\"flex items-center gap-2\">\n                                            <span className=\"px-2.5 py-1 bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 rounded-lg text-[9px] font-bold uppercase tracking-widest border border-slate-200 dark:border-slate-700\">{log.source}</span>\n                                            {!!log.device_name && <span className=\"text-[10px] font-bold text-slate-700 dark:text-slate-200 uppercase\">{log.device_name}</span>}\n                                        </div>\n                                    </div>\n                                </td>\n                                <td className=\"px-8 py-5 text-right\">\n                                    <span className=\"px-3 py-1 bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-300 rounded-full text-[9px] font-bold uppercase tracking-widest border border-emerald-100 dark:border-emerald-800 shadow-sm\">{t(\"attendance_logs.status.recorded\")}</span>\n                                </td>\n                            </tr>\n                        ))\n                    )}\n                    {!!hasNextPage && <InfiniteScrollSentinel colSpan={3} isFetchingNextPage={isFetchingNextPage} sentinelRef={loadMoreRef} />}\n                </tbody>\n            </table>\n        </div>\n    );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/reports/report-export-dialog.tsx","messages":[{"ruleId":"complexity","severity":2,"message":"Function 'ExportProgressPanel' has a complexity of 21. Maximum allowed is 10.","line":68,"column":1,"nodeType":"FunctionDeclaration","messageId":"complex","endLine":68,"endColumn":29},{"ruleId":"@typescript-eslint/no-unnecessary-type-conversion","severity":2,"message":"Using !! on a boolean does not change the type or value of the boolean.","line":131,"column":8,"nodeType":null,"messageId":"unnecessaryTypeConversion","endLine":131,"endColumn":10,"suggestions":[{"messageId":"suggestRemove","fix":{"range":[5056,5076],"text":"useFallbackPolling"},"desc":"Remove the type conversion."},{"messageId":"suggestSatisfies","data":{"type":"boolean"},"fix":{"range":[5056,5076],"text":"(useFallbackPolling satisfies boolean)"},"desc":"Instead, assert that the value satisfies the boolean type."}]},{"ruleId":"max-lines-per-function","severity":1,"message":"Function 'ReportExportDialog' has too many lines (165). Maximum allowed is 100.","line":236,"column":16,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":431,"endColumn":2},{"ruleId":"complexity","severity":2,"message":"Function 'ReportExportDialog' has a complexity of 15. Maximum allowed is 10.","line":236,"column":16,"nodeType":"FunctionDeclaration","messageId":"complex","endLine":236,"endColumn":43},{"ruleId":"@typescript-eslint/prefer-nullish-coalescing","severity":2,"message":"Prefer using nullish coalescing operator (`??`) instead of a logical or (`||`), as it is a safer operator.","line":309,"column":53,"nodeType":"Punctuator","messageId":"preferNullishOverOr","endLine":309,"endColumn":55,"suggestions":[{"messageId":"suggestNullish","data":{"equals":""},"fix":{"range":[11488,11490],"text":"??"},"desc":"Fix to nullish coalescing operator (`??`)."}]}],"suppressedMessages":[{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/workspace/webdashboard/src/components/features/reports/report-export-dialog.tsx:256:7\n  254 |     if (isOpen) {\n  255 |       // eslint-disable-next-line react-hooks/set-state-in-effect -- Derived state synced from props; intentional pattern\n> 256 |       setPhase(\"idle\");\n      |       ^^^^^^^^ Avoid calling setState() directly within an effect\n  257 |       setJobId(null);\n  258 |       setError(null);\n  259 |       setTotalBatches(0);","line":256,"column":7,"nodeType":null,"endLine":256,"endColumn":15,"suppressions":[{"kind":"directive","justification":"Derived state synced from props; intentional pattern"}]},{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/workspace/webdashboard/src/components/features/reports/report-export-dialog.tsx:326:7\n  324 |     if (pollingStatusValue === \"completed\" && phaseState !== \"completed\") {\n  325 |       // eslint-disable-next-line react-hooks/set-state-in-effect -- Derived state synced from props; intentional pattern\n> 326 |       setPhase(\"completed\");\n      |       ^^^^^^^^ Avoid calling setState() directly within an effect\n  327 |     } else if (pollingStatusValue === \"failed\" && phaseState !== \"failed\") {\n  328 |       setPhase(\"failed\");\n  329 |       setError(pollingError ?? t(\"report_export.status.failed\"));","line":326,"column":7,"nodeType":null,"endLine":326,"endColumn":15,"suppressions":[{"kind":"directive","justification":"Derived state synced from props; intentional pattern"}]}],"errorCount":4,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import type { TFunction } from \"i18next\";\n\nimport { useQuery } from \"@tanstack/react-query\";\nimport { Download, Loader2, CheckCircle2, AlertCircle, FileSpreadsheet } from \"lucide-react\";\nimport { useState, useEffect } from \"react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { useReportStream } from \"../../../hooks/use-report-stream\";\nimport {\n  createReportExportJob,\n  fetchExportJobStatus,\n  downloadExportReport,\n} from \"../../../lib/api/attendance\";\nimport { cn } from \"../../../lib/utils\";\nimport Modal from \"../../ui/modal\";\n\ninterface ReportExportDialogProps {\n  employeeIds?: string[];\n  endDate: string;\n  isOpen: boolean;\n  onClose: () => void;\n  reportType: \"summary\" | \"detail\";\n  startDate: string;\n  wsId: string;\n}\n\ntype ExportPhase = \"idle\" | \"starting\" | \"polling\" | \"downloading\" | \"completed\" | \"failed\";\n\ninterface ExportInfoPanelProps {\n  employeeIds?: string[];\n  endDate: string;\n  reportType: \"summary\" | \"detail\";\n  startDate: string;\n  t: TFunction;\n}\n\nfunction ExportInfoPanel({ startDate, endDate, reportType, employeeIds, t }: ExportInfoPanelProps) {\n  return (\n    <div className=\"bg-slate-50 dark:bg-slate-800 rounded-2xl p-4 space-y-2\" data-testid=\"report-export-info\">\n      <div className=\"flex justify-between text-sm\">\n        <span className=\"text-slate-500 dark:text-slate-400\">{t(\"reports.date_range\")}:</span>\n        <span className=\"font-medium\">{startDate} ~ {endDate}</span>\n      </div>\n      <div className=\"flex justify-between text-sm\">\n        <span className=\"text-slate-500 dark:text-slate-400\">{t(\"reports.report_type\")}:</span>\n        <span className=\"font-medium capitalize\">{reportType}</span>\n      </div>\n      {!!employeeIds && employeeIds.length > 0 && (\n        <div className=\"flex justify-between text-sm\">\n          <span className=\"text-slate-500 dark:text-slate-400\">{t(\"reports.employees\")}:</span>\n          <span className=\"font-medium\">{employeeIds.length} {t(\"common.selected\")}</span>\n        </div>\n      )}\n    </div>\n  );\n}\n\ninterface ExportProgressPanelProps {\n  completedBatches: number;\n  error: string | null;\n  percentage: number;\n  phase: ExportPhase;\n  t: TFunction;\n  totalBatches: number;\n  useFallbackPolling: boolean;\n}\n\nfunction ExportProgressPanel({ phase, percentage, totalBatches, completedBatches, error, useFallbackPolling, t }: ExportProgressPanelProps) {\n  return (\n    <div className=\"space-y-4\">\n      {/* Progress Bar */}\n      <div className=\"h-4 w-full bg-slate-100 dark:bg-slate-700 rounded-full overflow-hidden shadow-inner\" data-testid=\"report-export-progress-bar\">\n        <div\n          className={cn(\n            \"h-full transition-all duration-500 ease-out\",\n            phase === \"failed\" ? \"bg-rose-50 dark:bg-rose-950\" :\n              phase === \"completed\" ? \"bg-emerald-50 dark:bg-emerald-950\" :\n                \"bg-primary-600 bg-gradient-to-r from-primary-500 to-primary-600\"\n          )}\n          data-testid=\"report-export-progress-fill\"\n          style={{ width: `${phase === \"completed\" ? 100 : percentage}%` }}\n        />\n      </div>\n\n      {/* Status */}\n      <div className=\"flex items-center justify-center gap-3\">\n        {phase === \"starting\" || phase === \"polling\" ? (\n          <Loader2 className=\"w-5 h-5 text-primary-600 dark:text-primary-400 animate-spin\" />\n        ) : phase === \"completed\" ? (\n          <CheckCircle2 className=\"w-5 h-5 text-emerald-500\" />\n        ) : phase === \"failed\" ? (\n          <AlertCircle className=\"w-5 h-5 text-rose-500\" />\n        ) : phase === \"downloading\" ? (\n          <Loader2 className=\"w-5 h-5 text-primary-600 dark:text-primary-400 animate-spin\" />\n        ) : null}\n\n        <span className={cn(\n          \"font-medium\",\n          phase === \"failed\" ? \"text-rose-600 dark:text-rose-300\" :\n            phase === \"completed\" ? \"text-emerald-600 dark:text-emerald-300\" :\n              \"text-slate-700 dark:text-slate-200\"\n        )}\n          data-testid=\"report-export-status-text\"\n        >\n          {phase === \"starting\" && t(\"report_export.status.preparing\")}\n          {phase === \"polling\" && t(\"report_export.status.processing\")}\n          {phase === \"completed\" && t(\"report_export.status.completed\")}\n          {phase === \"failed\" && t(\"report_export.status.failed\")}\n          {phase === \"downloading\" && t(\"report_export.status.downloading\")}\n        </span>\n      </div>\n\n      {/* Batch Progress */}\n      {phase === \"polling\" && totalBatches > 0 && (\n        <p className=\"text-center text-sm text-slate-500 dark:text-slate-400\" data-testid=\"report-export-batch-counter\">\n          {t(\"report_export.batches_completed\", {\n            completed: completedBatches,\n            total: totalBatches,\n          })}\n        </p>\n      )}\n\n      {/* Error Message */}\n      {!!error && (\n        <div className=\"bg-rose-50 dark:bg-rose-950 border border-rose-200 rounded-xl p-4\" data-testid=\"report-export-error\">\n          <p className=\"text-sm text-rose-700 dark:text-rose-300\">{error}</p>\n        </div>\n      )}\n\n      {/* Fallback Mode Notification */}\n      {!!useFallbackPolling && phase === \"polling\" && (\n        <div className=\"bg-amber-50 dark:bg-amber-950 border border-amber-200 rounded-xl p-3\" data-testid=\"report-export-fallback-notice\">\n          <p className=\"text-xs text-amber-700 dark:text-amber-300\">\n            {t(\"report_export.fallback_mode\")}\n          </p>\n        </div>\n      )}\n    </div>\n  );\n}\n\ninterface ExportActionsPanelProps {\n  handleDownload: () => Promise<void>;\n  handleStartExport: () => Promise<void>;\n  onClose: () => void;\n  phase: ExportPhase;\n  t: TFunction;\n}\n\nfunction ExportActionsPanel({ phase, onClose, handleStartExport, handleDownload, t }: ExportActionsPanelProps) {\n  return (\n    <div className=\"flex gap-3 pt-2\">\n      {phase === \"idle\" && (\n        <>\n          <button\n            className=\"flex-1 px-6 py-3 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors font-medium\"\n            data-testid=\"report-export-cancel-button\"\n            onClick={onClose}\n          >\n            {t(\"common.cancel\")}\n          </button>\n          <button\n            className=\"flex-1 flex items-center justify-center gap-2 px-6 py-3 bg-primary-600 text-white rounded-xl hover:bg-primary-700 transition-colors font-medium\"\n            data-testid=\"report-export-start-button\"\n            onClick={handleStartExport}\n          >\n            <Download size={18} />\n            {t(\"report_export.start_export\")}\n          </button>\n        </>\n      )}\n\n      {(phase === \"starting\" || phase === \"polling\") && (\n        <button\n          className=\"flex-1 px-6 py-3 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors font-medium\"\n          data-testid=\"report-export-background-button\"\n          onClick={onClose}\n        >\n          {t(\"report_export.run_background\")}\n        </button>\n      )}\n\n      {phase === \"completed\" && (\n        <>\n          <button\n            className=\"flex-1 px-6 py-3 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors font-medium\"\n            data-testid=\"report-export-close-button\"\n            onClick={onClose}\n          >\n            {t(\"common.close\")}\n          </button>\n          <button\n            className=\"flex-1 flex items-center justify-center gap-2 px-6 py-3 bg-emerald-600 text-white rounded-xl hover:bg-emerald-700 transition-colors font-medium\"\n            data-testid=\"report-export-download-button\"\n            onClick={handleDownload}\n          >\n            <Download size={18} />\n            {t(\"report_export.download_button\")}\n          </button>\n        </>\n      )}\n\n      {phase === \"failed\" && (\n        <>\n          <button\n            className=\"flex-1 px-6 py-3 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors font-medium\"\n            data-testid=\"report-export-close-button\"\n            onClick={onClose}\n          >\n            {t(\"common.close\")}\n          </button>\n          <button\n            className=\"flex-1 flex items-center justify-center gap-2 px-6 py-3 bg-primary-600 text-white rounded-xl hover:bg-primary-700 transition-colors font-medium\"\n            data-testid=\"report-export-retry-button\"\n            onClick={handleStartExport}\n          >\n            {t(\"common.retry\")}\n          </button>\n        </>\n      )}\n\n      {phase === \"downloading\" && (\n        <button\n          className=\"flex-1 flex items-center justify-center gap-2 px-6 py-3 bg-slate-300 text-slate-500 dark:text-slate-400 rounded-xl cursor-not-allowed font-medium\"\n          data-testid=\"report-export-downloading-button\"\n          disabled\n        >\n          <Loader2 className=\"animate-spin\" size={18} />\n          {t(\"report_export.status.downloading\")}\n        </button>\n      )}\n    </div>\n  );\n}\n\nexport default function ReportExportDialog({\n  isOpen,\n  onClose,\n  wsId,\n  startDate,\n  endDate,\n  reportType,\n  employeeIds,\n}: ReportExportDialogProps) {\n  const { t } = useTranslation();\n  const [phaseState, setPhase] = useState<ExportPhase>(\"idle\");\n  const [jobId, setJobId] = useState<string | null>(null);\n  const [error, setError] = useState<string | null>(null);\n  const [totalBatches, setTotalBatches] = useState(0);\n  const [useFallbackPolling, setUseFallbackPolling] = useState(false);\n\n  // Reset state when dialog opens\n  useEffect(() => {\n    if (isOpen) {\n      // eslint-disable-next-line react-hooks/set-state-in-effect -- Derived state synced from props; intentional pattern\n      setPhase(\"idle\");\n      setJobId(null);\n      setError(null);\n      setTotalBatches(0);\n      setUseFallbackPolling(false);\n    }\n  }, [isOpen]);\n\n  // WebSocket streaming for real-time updates\n  const {\n    status: streamStatus,\n    progress: streamProgress,\n    error: _streamError,\n  } = useReportStream({\n    jobId,\n    onComplete: () => {\n      \n      setPhase(\"completed\");\n    },\n    onError: (message) => {\n      console.error(\"[ReportExport] Stream error:\", message);\n\n      // Check if max retries exceeded - fallback to polling\n      if (\n        message.includes(\"Max retries exceeded\") ||\n        message.includes(\"Connection lost\")\n      ) {\n        console.warn(\"[ReportExport] WebSocket failed, falling back to polling\");\n        setUseFallbackPolling(true);\n        setPhase(\"polling\"); // Transition to polling phase so the query is enabled\n        setError(null); // Clear error, fallback will handle\n      } else {\n        setPhase(\"failed\");\n        setError(message);\n      }\n    },\n    maxRetries: 3,\n  });\n\n  // Calculate derived phase from stream status to avoid sync state updates\n  const phase = (() => {\n    if (jobId && !useFallbackPolling) {\n      if (streamStatus === \"connecting\") return \"starting\";\n      if (streamStatus === \"streaming\") return \"polling\";\n    }\n    return phaseState;\n  })();\n\n  console.error(`[ReportDialog] Render: phase=${phase}, phaseState=${phaseState}, jobId=${jobId}, streamStatus=${streamStatus}, useFallbackPolling=${useFallbackPolling}`);\n\n  // Fallback polling when WebSocket fails\n  const { data: pollingStatus } = useQuery({\n    queryKey: [\"export-job-fallback\", jobId],\n    queryFn: () => fetchExportJobStatus(wsId, jobId || \"\"),\n    enabled: !!jobId && useFallbackPolling && phase === \"polling\",\n    refetchInterval: (query) => {\n      const status = query.state.data?.status;\n      return status === \"processing\" || status === \"pending\" ? 2000 : false; // 2s (less aggressive)\n    },\n  });\n\n  const pollingStatusValue = pollingStatus?.status;\n  const pollingError = pollingStatus?.error;\n\n  // Handle fallback polling status\n  useEffect(() => {\n    if (!useFallbackPolling || !pollingStatus) return;\n\n    if (pollingStatusValue === \"completed\" && phaseState !== \"completed\") {\n      // eslint-disable-next-line react-hooks/set-state-in-effect -- Derived state synced from props; intentional pattern\n      setPhase(\"completed\");\n    } else if (pollingStatusValue === \"failed\" && phaseState !== \"failed\") {\n      setPhase(\"failed\");\n      setError(pollingError ?? t(\"report_export.status.failed\"));\n    }\n  }, [pollingStatusValue, pollingError, useFallbackPolling, t, phaseState, pollingStatus]);\n\n  const handleStartExport = async () => {\n    setPhase(\"starting\");\n    setError(null);\n\n    try {\n      const response = await createReportExportJob(wsId, {\n        start_date: startDate,\n        end_date: endDate,\n        report_type: reportType,\n        employee_ids: employeeIds,\n      });\n\n      setJobId(response.job_id);\n      setTotalBatches(response.total_batches);\n      // Phase will be set automatically by useEffect watching streamStatus\n    } catch (error_) {\n      setPhase(\"failed\");\n      setError(error_ instanceof Error ? error_.message : t(\"report_export.status.failed\"));\n    }\n  };\n\n  const handleDownload = async () => {\n    if (!jobId) return;\n\n    setPhase(\"downloading\");\n    try {\n      const blob = await downloadExportReport(wsId, jobId);\n      const url = window.URL.createObjectURL(blob);\n      const a = document.createElement(\"a\");\n      a.href = url;\n      a.download = `attendance-report-${startDate}-to-${endDate}.xlsx`;\n      document.body.appendChild(a);\n      a.click();\n      document.body.removeChild(a);\n      window.URL.revokeObjectURL(url);\n      onClose();\n    } catch (error_) {\n      setPhase(\"failed\");\n      setError(error_ instanceof Error ? error_.message : \"Download failed\");\n    }\n  };\n\n  // Calculate percentage from appropriate source\n  const percentage =\n    jobId && phase === \"polling\"\n      ? useFallbackPolling && pollingStatus?.progress.percentage\n        ? pollingStatus.progress.percentage\n        : streamProgress\n      : 0;\n\n  // Calculate batch count\n  const completedBatches = useFallbackPolling && pollingStatus?.progress\n    ? pollingStatus.progress.completed_batches\n    : totalBatches > 0\n      ? Math.floor((streamProgress / 100) * totalBatches)\n      : 0;\n\n  return (\n    <Modal\n      icon={<FileSpreadsheet size={24} />}\n      isOpen={isOpen}\n      maxWidth=\"md\"\n      onClose={onClose}\n      subtitle={t(\"report_export.subtitle\")}\n      testId=\"report-export-dialog\"\n      title={t(\"report_export.title\")}\n    >\n      <div className=\"p-6 space-y-6\">\n        <ExportInfoPanel\n          employeeIds={employeeIds}\n          endDate={endDate}\n          reportType={reportType}\n          startDate={startDate}\n          t={t}\n        />\n\n        {phase !== \"idle\" && (\n          <ExportProgressPanel\n            completedBatches={completedBatches}\n            error={error}\n            percentage={percentage}\n            phase={phase}\n            t={t}\n            totalBatches={totalBatches}\n            useFallbackPolling={useFallbackPolling}\n          />\n        )}\n\n        <ExportActionsPanel\n          handleDownload={handleDownload}\n          handleStartExport={handleStartExport}\n          onClose={onClose}\n          phase={phase}\n          t={t}\n        />\n      </div>\n    </Modal>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/reports/report-filters.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/reports/report-ot-status-badge.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/reports/report-stats.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/reports/report-status-badge.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/reports/resolve-unscheduled-modal.tsx","messages":[{"ruleId":"@typescript-eslint/no-confusing-void-expression","severity":2,"message":"Returning a void expression from an arrow function shorthand is forbidden. Please add braces to the arrow function.","line":37,"column":42,"nodeType":"CallExpression","messageId":"invalidVoidExprArrow","endLine":37,"endColumn":51}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { AlertTriangle, RefreshCw, CalendarCheck } from \"lucide-react\";\nimport React, { useState } from \"react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport Modal from \"@/components/ui/modal\";\nimport { useDateTimeFormatter } from \"@/hooks/use-datetime\";\nimport { DailyAttendanceReport, Shift } from \"@/lib/api\";\n\nexport interface ResolveUnscheduledModalProps {\n    isOpen: boolean;\n    isPending: boolean;\n    onClose: () => void;\n    onSubmit: (shiftId: string) => void;\n    row: DailyAttendanceReport | null;\n    shifts: Shift[] | undefined;\n}\n\nexport default function ResolveUnscheduledModal({\n    isOpen,\n    onClose,\n    row,\n    shifts,\n    isPending,\n    onSubmit,\n}: ResolveUnscheduledModalProps) {\n    const { t } = useTranslation();\n    const { formatDate, formatTime } = useDateTimeFormatter();\n\n    const [selectedShiftId, setSelectedShiftId] = useState(\"\");\n\n    if (!row) return null;\n\n    return (\n        <Modal\n            icon={<AlertTriangle size={24} />}\n            isOpen={isOpen}\n            onClose={() => !isPending && onClose()}\n            title={t(\"reports.unscheduled.resolve_title\")}\n        >\n            <div className=\"space-y-6\">\n                {/* Employee + Date info */}\n                <div className=\"flex items-center gap-4 p-4 bg-amber-50 dark:bg-amber-950 rounded-2xl border border-amber-200 dark:border-amber-800\">\n                    <div className=\"w-10 h-10 rounded-xl bg-amber-100 dark:bg-amber-900 flex items-center justify-center text-amber-600 dark:text-amber-300 shadow-inner\">\n                        <AlertTriangle size={20} />\n                    </div>\n                    <div>\n                        <p className=\"text-sm font-bold text-amber-800 dark:text-amber-200\">\n                            {row.employee_name}\n                        </p>\n                        <p className=\"text-xs font-mono font-bold text-amber-600 dark:text-amber-400 uppercase\">\n                            {formatDate(row.date)}\n                        </p>\n                    </div>\n                </div>\n\n                {/* Punch times display */}\n                {!!row.actual_punch_in && (\n                    <div className=\"grid grid-cols-2 gap-4\">\n                        <div className=\"p-3 bg-slate-50 dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700\">\n                            <p className=\"text-[9px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest mb-1\">{t(\"reports.confirm.punch_in\")}</p>\n                            <p className=\"font-mono font-bold text-sm text-slate-700 dark:text-slate-200\">{formatTime(row.actual_punch_in)}</p>\n                        </div>\n                        <div className=\"p-3 bg-slate-50 dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700\">\n                            <p className=\"text-[9px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest mb-1\">{t(\"reports.confirm.punch_out\")}</p>\n                            <p className=\"font-mono font-bold text-sm text-slate-700 dark:text-slate-200\">{formatTime(row.actual_punch_out)}</p>\n                        </div>\n                    </div>\n                  )}\n\n                {/* Shift selector */}\n                <div>\n                    <label className=\"text-[9px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest mb-2 block\">\n                        {t(\"reports.unscheduled.select_shift\")}\n                    </label>\n                    <select\n                        className=\"w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-sm font-bold text-slate-700 dark:text-slate-200 focus:ring-2 focus:ring-primary-500 focus:border-transparent\"\n                        onChange={(e) => { setSelectedShiftId(e.target.value); }}\n                        value={selectedShiftId}\n                    >\n                        <option value=\"\">-- {t(\"reports.unscheduled.select_shift\")} --</option>\n                        {(shifts ?? []).map((shift: Shift) => (\n                            <option key={shift.id} value={shift.id}>\n                                {shift.name} ({shift.start_time.substring(0, 5)} — {shift.end_time.substring(0, 5)})\n                            </option>\n                        ))}\n                    </select>\n                </div>\n\n                {/* Explanation note */}\n                <p className=\"text-[10px] text-slate-500 dark:text-slate-400 italic leading-relaxed\">\n                    {t(\"reports.unscheduled.resolve_subtitle\")}\n                </p>\n\n                {/* Buttons */}\n                <div className=\"flex gap-4 border-t border-slate-100 dark:border-slate-800 pt-4\">\n                    <button\n                        className=\"flex-1 px-6 py-3.5 rounded-2xl font-bold text-xs uppercase tracking-widest text-slate-500 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-all active:scale-95\"\n                        disabled={isPending}\n                        onClick={onClose}\n                    >\n                        {t(\"common.cancel\")}\n                    </button>\n                    <button\n                        className=\"flex-[1.5] bg-amber-600 hover:bg-amber-700 text-white font-bold px-6 py-3.5 rounded-2xl flex items-center justify-center gap-3 transition-all active:scale-95 disabled:opacity-50 shadow-xl text-xs uppercase tracking-widest\"\n                        disabled={isPending || !selectedShiftId}\n                        onClick={() => { onSubmit(selectedShiftId); }}\n                    >\n                        {isPending ? (\n                            <RefreshCw className=\"w-4 h-4 animate-spin\" />\n                        ) : (\n                            <CalendarCheck size={18} />\n                        )}\n                        {t(\"reports.unscheduled.submit\")}\n                    </button>\n                </div>\n            </div>\n        </Modal>\n    );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/reports/use-employee-daily-drawer.ts","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Function 'useEmployeeDailyDrawer' has too many lines (257). Maximum allowed is 100.","line":28,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":323,"endColumn":2}],"suppressedMessages":[{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/workspace/webdashboard/src/components/features/reports/use-employee-daily-drawer.ts:43:35\n  41 |     // Reset to daily tab whenever the drawer is (re-)opened\n  42 |     // eslint-disable-next-line react-hooks/set-state-in-effect -- intentional\n> 43 |     useEffect(() => { if (isOpen) setViewMode(\"daily\"); }, [isOpen]);\n     |                                   ^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  44 |\n  45 |     const [expandedDebugRows, setExpandedDebugRows] = useState<Set<string>>(new Set());\n  46 |     const [reprocessingRow, setReprocessingRow] = useState<string | null>(null);","line":43,"column":35,"nodeType":null,"endLine":43,"endColumn":46,"suppressions":[{"kind":"directive","justification":"intentional"}]}],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useQuery, useMutation, useQueryClient, useInfiniteQuery } from \"@tanstack/react-query\";\nimport { useState, useMemo, useEffect } from \"react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { useToast } from \"@/components/ui/toast\";\nimport {\n    fetchAttendanceReport,\n    DailyAttendanceReport,\n    reprocessAttendance,\n    fetchWorkspaceAttendanceAdjustments,\n    adminConfirmAttendance,\n    AttendanceAdjustmentRequest,\n    approveOt,\n    fetchRawAttendanceLogs,\n    fetchShifts,\n    upsertRoster,\n} from \"@/lib/api\";\nimport { formatUnitsToHours } from \"@/lib/utils/attendance\";\n\ninterface UseEmployeeDailyDrawerProps {\n    dateRange: { start: string; end: string };\n    employeeId: string;\n    isOpen: boolean;\n    workspaceId: string;\n    workUnitMinutes: number;\n}\n\nexport function useEmployeeDailyDrawer({\n    isOpen,\n    workspaceId,\n    employeeId,\n    dateRange,\n    workUnitMinutes,\n}: UseEmployeeDailyDrawerProps) {\n    const { t } = useTranslation();\n    const queryClient = useQueryClient();\n    const toast = useToast();\n\n    const [viewMode, setViewMode] = useState<\"daily\" | \"raw\">(\"daily\");\n\n    // Reset to daily tab whenever the drawer is (re-)opened\n    // eslint-disable-next-line react-hooks/set-state-in-effect -- intentional\n    useEffect(() => { if (isOpen) setViewMode(\"daily\"); }, [isOpen]);\n\n    const [expandedDebugRows, setExpandedDebugRows] = useState<Set<string>>(new Set());\n    const [reprocessingRow, setReprocessingRow] = useState<string | null>(null);\n    const [confirmingRow, setConfirmingRow] = useState<string | null>(null);\n    const [confirmDialog, setConfirmDialog] = useState<{\n        show: boolean;\n        employeeId: string;\n        employeeName: string;\n        date: string;\n    } | null>(null);\n    const [confirmModalData, setConfirmModalData] = useState<{\n        row: DailyAttendanceReport;\n        existingRequest?: AttendanceAdjustmentRequest;\n    } | null>(null);\n    const [resolveModalData, setResolveModalData] = useState<{\n        row: DailyAttendanceReport;\n    } | null>(null);\n\n    // Fetch daily data for this single employee\n    const { data: reportResponse, isLoading } = useQuery({\n        queryKey: [\"attendance-report\", workspaceId, dateRange, \"daily\", 1, 100, undefined, [employeeId]],\n        queryFn: () =>\n            fetchAttendanceReport({\n                wsId: workspaceId,\n                start: dateRange.start,\n                end: dateRange.end,\n                type: \"daily\",\n                page: 1,\n                limit: 100,\n                employeeIds: [employeeId],\n            }),\n        enabled: isOpen && !!workspaceId && !!employeeId,\n    });\n\n    const { data: pendingAdjustments } = useQuery({\n        queryKey: [\"attendance-adjustments\", workspaceId, \"pending\"],\n        queryFn: () => fetchWorkspaceAttendanceAdjustments(workspaceId, \"pending\"),\n        enabled: isOpen && !!workspaceId,\n    });\n\n    // Fetch shift types for the unscheduled resolution modal\n    const { data: shifts } = useQuery({\n        queryKey: [\"shifts\", workspaceId],\n        queryFn: () => fetchShifts(workspaceId),\n        enabled: isOpen && !!workspaceId,\n    });\n\n    // Fetch raw logs for this single employee with infinite scroll\n    const {\n        data: rawLogsResponse,\n        isLoading: rawLogsLoading,\n        fetchNextPage,\n        hasNextPage,\n        isFetchingNextPage\n    } = useInfiniteQuery({\n        queryKey: [\"raw-logs\", workspaceId, dateRange, [employeeId]],\n        queryFn: ({ pageParam }) => {\n            const from = dateRange.start ? new Date(`${dateRange.start}T00:00:00`).toISOString() : undefined;\n            const to = dateRange.end ? new Date(`${dateRange.end}T23:59:59`).toISOString() : undefined;\n            return fetchRawAttendanceLogs({ employee_id: employeeId, from, to, page: pageParam, limit: 100 });\n        },\n        getNextPageParam: (lastPage, allPages) => {\n            if (lastPage.data.length < 100) return undefined;\n            return allPages.length + 1;\n        },\n        initialPageParam: 1,\n        enabled: isOpen && !!workspaceId && !!employeeId && viewMode === \"raw\",\n    });\n\n    // Extract flat array of logs\n    const rawLogsData = useMemo(() => {\n        if (!rawLogsResponse) return [];\n        return rawLogsResponse.pages.flatMap((p) => p.data);\n    }, [rawLogsResponse]);\n\n    const adjustmentMap = useMemo(() => {\n        const map: Record<string, AttendanceAdjustmentRequest> = {};\n        pendingAdjustments?.forEach((request) => {\n            const key = `${request.employee_id}-${request.requested_date}`;\n            map[key] = request;\n        });\n        return map;\n    }, [pendingAdjustments]);\n\n    const reportData = useMemo(\n        () => (reportResponse?.data ?? (Array.isArray(reportResponse) ? reportResponse : [])) as DailyAttendanceReport[],\n        [reportResponse]\n    );\n\n    // Compute total hours for summary bar\n    const { totalStdHours, totalOtHours } = useMemo(() => {\n        const stdUnits = reportData.reduce((sum: number, r: DailyAttendanceReport) => sum + (r.std_work_units || 0), 0);\n        const otUnits = reportData.reduce((sum: number, r: DailyAttendanceReport) => sum + (r.ot_work_units || 0), 0);\n        return {\n            totalStdHours: formatUnitsToHours(stdUnits, workUnitMinutes),\n            totalOtHours: formatUnitsToHours(otUnits, workUnitMinutes),\n        };\n    }, [reportData, workUnitMinutes]);\n\n    const toggleExpandRow = (rowKey: string) => {\n        const next = new Set(expandedDebugRows);\n        if (next.has(rowKey)) next.delete(rowKey);\n        else next.add(rowKey);\n        setExpandedDebugRows(next);\n    };\n\n    // Reprocess mutation\n    const reprocessMutation = useMutation({\n        mutationFn: ({ empId, date }: { empId: string; date: string }) =>\n            reprocessAttendance(workspaceId, empId, date, date),\n        onSuccess: () => {\n            void queryClient.invalidateQueries({ queryKey: [\"attendance-report\"] });\n            setReprocessingRow(null);\n            setConfirmDialog(null);\n            toast.success(t(\"common.success\"));\n        },\n    });\n\n    // Confirm mutation\n    const confirmMutation = useMutation({\n        mutationFn: ({\n            row,\n            existingRequestId,\n            reason,\n        }: {\n            row: DailyAttendanceReport;\n            existingRequestId?: string;\n            reason?: string;\n        }) => adminConfirmAttendance(workspaceId, row, existingRequestId, reason),\n        onSuccess: () => {\n            void queryClient.invalidateQueries({ queryKey: [\"attendance-report\"] });\n            void queryClient.invalidateQueries({ queryKey: [\"attendance-adjustments\"] });\n            setConfirmingRow(null);\n            setConfirmModalData(null);\n            toast.success(t(\"reports.confirm.success\"));\n        },\n        onError: () => {\n            setConfirmingRow(null);\n            toast.error(t(\"reports.confirm.error\"));\n        },\n    });\n\n    // OT approve mutation\n    const approveOtMutation = useMutation({\n        mutationFn: ({ row, action }: { row: DailyAttendanceReport; action: \"approved\" | \"rejected\" }) =>\n            approveOt(workspaceId, row.employee_id, {\n                date: row.date,\n                approved_minutes: row.ot_work_units * (workUnitMinutes || 60),\n                status: action,\n            }),\n        onSuccess: (_data, variables) => {\n            void queryClient.invalidateQueries({ queryKey: [\"attendance-report\"] });\n            const message =\n                variables.action === \"approved\"\n                    ? t(\"reports.ot_approve.success_approved\")\n                    : t(\"reports.ot_approve.success_rejected\");\n            toast.success(message);\n        },\n        onError: () => {\n            toast.error(t(\"reports.ot_approve.error\"));\n        },\n    });\n\n    // Resolve unscheduled mutation: upsert roster + reprocess\n    const resolveUnscheduledMutation = useMutation({\n        mutationFn: async ({ row, shiftId }: { row: DailyAttendanceReport; shiftId: string }) => {\n            // Step 1: Assign the shift to this day\n            await upsertRoster(workspaceId, row.employee_id, {\n                date: row.date,\n                shift_id: shiftId,\n            });\n            // Step 2: Reprocess to recalculate attendance with the new shift\n            await reprocessAttendance(workspaceId, row.employee_id, row.date, row.date);\n        },\n        onSuccess: () => {\n            void queryClient.invalidateQueries({ queryKey: [\"attendance-report\"] });\n            setResolveModalData(null);\n            toast.success(t(\"reports.unscheduled.success\"));\n        },\n        onError: () => {\n            toast.error(t(\"reports.unscheduled.error\"));\n        },\n    });\n\n    const handleApproveOt = (row: DailyAttendanceReport, action: \"approved\" | \"rejected\") => {\n        approveOtMutation.mutate({ row, action });\n    };\n\n    const handleResolveUnscheduled = (row: DailyAttendanceReport) => {\n        setResolveModalData({ row });\n    };\n\n    const handleResolveSubmit = (shiftId: string) => {\n        if (!resolveModalData) return;\n        resolveUnscheduledMutation.mutate({\n            row: resolveModalData.row,\n            shiftId,\n        });\n    };\n\n    const handleReprocessClick = (row: DailyAttendanceReport) => {\n        setConfirmDialog({\n            show: true,\n            employeeId: row.employee_id,\n            employeeName: row.employee_name,\n            date: row.date,\n        });\n    };\n\n    const handleConfirmReprocess = () => {\n        if (!confirmDialog) return;\n        setReprocessingRow(`${confirmDialog.employeeId}-${confirmDialog.date}`);\n        reprocessMutation.mutate({ empId: confirmDialog.employeeId, date: confirmDialog.date });\n    };\n\n    const handleConfirmClick = (row: DailyAttendanceReport, existing?: AttendanceAdjustmentRequest) => {\n        setConfirmModalData({ row, existingRequest: existing });\n    };\n\n    const handleConfirmSubmit = ({ punchIn, punchOut, reason }: { punchIn: string; punchOut: string; reason: string }) => {\n        if (!confirmModalData) return;\n        const { row, existingRequest } = confirmModalData;\n        const rowKey = `${row.employee_id}-${row.date}`;\n        setConfirmingRow(rowKey);\n\n        if (existingRequest) {\n            confirmMutation.mutate({ row, existingRequestId: existingRequest.id });\n        } else {\n            const createIsoFromLocal = (dateString: string, hhmm: string): string | null => {\n                if (!hhmm) return null;\n                const [y, m, d] = dateString.split(\"-\").map(Number);\n                const [hours, mins] = hhmm.split(\":\").map(Number);\n                return new Date(y, m - 1, d, hours, mins, 0).toISOString();\n            };\n\n            const modifiedRow = {\n                ...row,\n                actual_punch_in: createIsoFromLocal(row.date, punchIn),\n                actual_punch_out: createIsoFromLocal(row.date, punchOut),\n            };\n            confirmMutation.mutate({ row: modifiedRow, reason });\n        }\n    };\n\n    return {\n        viewMode,\n        setViewMode,\n        expandedDebugRows,\n        toggleExpandRow,\n        reprocessingRow,\n        confirmingRow,\n        confirmDialog,\n        setConfirmDialog,\n        confirmModalData,\n        setConfirmModalData,\n        resolveModalData,\n        setResolveModalData,\n        reportData,\n        isLoading,\n        rawLogsData,\n        rawLogsLoading,\n        hasNextPage,\n        isFetchingNextPage,\n        fetchNextPage,\n        adjustmentMap,\n        shifts,\n        totalStdHours,\n        totalOtHours,\n        handleReprocessClick,\n        handleConfirmReprocess,\n        handleConfirmClick,\n        handleConfirmSubmit,\n        handleApproveOt,\n        handleResolveUnscheduled,\n        handleResolveSubmit,\n        reprocessMutationPending: reprocessMutation.isPending,\n        confirmMutationPending: confirmMutation.isPending,\n        resolveUnscheduledMutationPending: resolveUnscheduledMutation.isPending,\n    };\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/settings/permission-management-modal.tsx","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Function 'PermissionManagementModal' has too many lines (159). Maximum allowed is 100.","line":17,"column":16,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":183,"endColumn":2}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { KeyRound, Plus, Trash2, Clock, Search } from \"lucide-react\";\nimport { useState } from \"react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport Modal from \"@/components/ui/modal\";\nimport { useConfirm } from \"@/hooks/use-confirm\";\nimport { useDateTimeFormatter } from \"@/hooks/use-datetime\";\nimport { useMemberPermissions } from \"@/hooks/use-workspace\";\n\n\ninterface PermissionManagementModalProps {\n    isOpen: boolean;\n    onClose: () => void;\n    userId: string | null;\n}\n\nexport default function PermissionManagementModal({\n    userId,\n    isOpen,\n    onClose,\n}: PermissionManagementModalProps) {\n    const { t } = useTranslation();\n    const { formatDateTime } = useDateTimeFormatter();\n    const {\n        permissions,\n        available,\n        isLoading,\n        assignPermission,\n        revokePermission,\n    } = useMemberPermissions(userId ?? \"\", undefined);\n    const [newPermission, setNewPermission] = useState(\"\");\n    const [expiresAt, setExpiresAt] = useState(\"\");\n    const [searchTerm, setSearchTerm] = useState(\"\");\n    const { confirm, ConfirmationDialog } = useConfirm();\n\n    const filteredAvailable = available.filter(\n        (p) =>\n            p.toLowerCase().includes(searchTerm.toLowerCase()) &&\n            !permissions.some((ep) => ep.permission === p),\n    );\n\n    async function handleAssign(e: React.SyntheticEvent) {\n        e.preventDefault();\n        if (!expiresAt || !newPermission || !userId) return;\n        try {\n            const isoExpiresAt = new Date(expiresAt).toISOString();\n            await assignPermission({ permission: newPermission, expiresAt: isoExpiresAt });\n            setExpiresAt(\"\");\n            setNewPermission(\"\");\n            setSearchTerm(\"\");\n        } catch (e) {\n            console.error(e);\n        }\n    }\n\n    async function handleRevoke(permId: string) {\n        const ok = await confirm({\n            title: t(\"common.warning\", { defaultValue: \"Warning\" }),\n            message: t(\"members.permissions.confirm_revoke\", { defaultValue: \"Revoke this permission?\" }),\n            variant: \"danger\"\n        });\n        if (!ok) return;\n        try {\n            await revokePermission(permId);\n        } catch (e) {\n            console.error(e);\n        }\n    }\n\n    if (!isOpen) return null;\n\n    return (\n        <Modal\n            icon={<KeyRound size={24} />}\n            isOpen={isOpen}\n            maxWidth=\"lg\"\n            onClose={onClose}\n            subtitle={t(\"members.permissions.modal_subtitle\", { defaultValue: \"Grant or revoke individual permissions\" })}\n            title={t(\"members.permissions.modal_title\", { defaultValue: \"Manage Permissions\" })}\n        >\n            <div className=\"space-y-10\">\n                    {isLoading ? (\n                        <div className=\"py-20 text-center text-slate-500 dark:text-slate-400 font-bold italic uppercase tracking-widest text-xs opacity-50 animate-pulse\">{t(\"common.loading\")}</div>\n                    ) : (\n                        <div className=\"space-y-10 animate-in fade-in duration-700\">\n                            {/* Active permissions list */}\n                            <div className=\"space-y-5 px-1\">\n                                <label className=\"text-[10px] font-bold uppercase tracking-[0.25em] text-slate-500 dark:text-slate-400 ml-1\">\n                                    {t(\"members.permissions.active_label\", { defaultValue: \"Active Extra Permissions\" }).toUpperCase()}\n                                </label>\n\n                                <div className=\"space-y-4 max-h-[300px] overflow-y-auto\">\n                                    {permissions.map((perm) => (\n                                        <div className=\"flex items-center justify-between p-6 bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-[2rem] hover:bg-white dark:hover:bg-slate-900 hover:shadow-xl hover:shadow-amber-100/10 transition-all group relative overflow-hidden shadow-inner\" key={perm.id}>\n                                            <div className=\"space-y-2 min-w-0 flex-1\">\n                                                <p className=\"font-bold text-slate-700 dark:text-slate-200 text-sm tracking-tight leading-none font-mono\">{perm.permission}</p>\n                                                <div className=\"flex items-center gap-2 text-[10px] text-slate-500 dark:text-slate-400 font-bold uppercase tracking-widest opacity-70\">\n                                                    <Clock className=\"text-amber-400\" size={12} /> <span>{t(\"members.roles.expires_at\", { defaultValue: \"Expires\" }).toUpperCase()}: {formatDateTime(perm.expires_at)}</span>\n                                                </div>\n                                            </div>\n                                            <button className=\"p-3 bg-white dark:bg-slate-900 text-slate-300 dark:text-slate-600 hover:text-rose-600 dark:text-rose-300 rounded-xl shadow-md border border-slate-100 dark:border-slate-800 transition-all opacity-0 group-hover:opacity-100 translate-x-2 group-hover:translate-x-0 active:scale-90 flex-shrink-0 ml-4\" onClick={() => handleRevoke(perm.id)}><Trash2 size={18} /></button>\n                                        </div>\n                                    ))}\n\n                                    {permissions.length === 0 && (\n                                        <div className=\"text-center py-12 border-2 border-dashed border-slate-100 dark:border-slate-800 rounded-[2.5rem] bg-slate-50 dark:bg-slate-800/30 flex flex-col items-center\">\n                                            <KeyRound className=\"text-slate-200 dark:text-slate-700 mb-4\" size={32} />\n                                            <p className=\"text-[10px] font-bold text-slate-300 dark:text-slate-600 uppercase tracking-widest opacity-60 italic\">\n                                                {t(\"members.permissions.no_extra_permissions\", { defaultValue: \"No extra permissions\" })}\n                                            </p>\n                                        </div>\n                                    )}\n                                </div>\n                            </div>\n                        </div>\n                    )}\n\n                    {/* Assign new permission */}\n                    <div className=\"pt-10 border-t border-slate-50 dark:border-slate-800 space-y-8\">\n                        <h3 className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.3em] flex items-center gap-3 px-1\">\n                            <Plus className=\"text-amber-500\" size={16} /> {t(\"members.permissions.assign_new_title\", { defaultValue: \"Grant Permission\" }).toUpperCase()}\n                        </h3>\n                        <form className=\"space-y-6 animate-in slide-in-from-bottom-4 duration-700\" onSubmit={handleAssign}>\n                            <div className=\"space-y-3 px-1\">\n                                <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">\n                                    {t(\"members.permissions.permission_label\", { defaultValue: \"Permission\" })}\n                                </label>\n                                <div className=\"relative\">\n                                    <Search className=\"absolute left-5 top-1/2 -translate-y-1/2 text-slate-400\" size={14} />\n                                    <input\n                                        className=\"w-full bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl pl-12 pr-6 py-4 focus:ring-4 focus:ring-amber-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-bold text-sm tracking-tight shadow-sm\"\n                                        onChange={(e) => {\n                                            setSearchTerm(e.target.value);\n                                            setNewPermission(\"\");\n                                        }}\n                                        placeholder={t(\"members.permissions.search_placeholder\", { defaultValue: \"Search permissions...\" })}\n                                        type=\"text\"\n                                        value={searchTerm}\n                                    />\n                                </div>\n                                {!!searchTerm && filteredAvailable.length > 0 && (\n                                    <div className=\"max-h-48 overflow-y-auto rounded-2xl border border-slate-100 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-lg\">\n                                        {filteredAvailable.map((p) => (\n                                            <button\n                                                className={`w-full text-left px-6 py-3 text-sm font-mono hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors ${newPermission === p ? \"bg-amber-50 dark:bg-amber-950 text-amber-600 dark:text-amber-400 font-bold\" : \"text-slate-600 dark:text-slate-300\"}`}\n                                                key={p}\n                                                onClick={() => { setNewPermission(p); setSearchTerm(p); }}\n                                                type=\"button\"\n                                            >\n                                                {p}\n                                            </button>\n                                        ))}\n                                    </div>\n                                  )}\n                                {!!newPermission && (\n                                    <p className=\"text-[10px] text-amber-600 dark:text-amber-400 font-bold uppercase tracking-widest ml-1\">\n                                        ✓ {newPermission}\n                                    </p>\n                                  )}\n                            </div>\n                            <div className=\"space-y-3 px-1\">\n                                <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\" htmlFor=\"perm-expires-at-input\">\n                                    {t(\"members.permissions.expiry_label\", { defaultValue: \"Expiration\" })}\n                                </label>\n                                <input className=\"w-full bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl px-6 py-4 focus:ring-4 focus:ring-amber-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-bold text-sm tracking-tight shadow-sm\" id=\"perm-expires-at-input\" onChange={(e) => { setExpiresAt(e.target.value); }} required type=\"datetime-local\" value={expiresAt}\n                                />\n                            </div>\n                            <div className=\"pt-2\">\n                                <button\n                                    className=\"w-full bg-slate-900 text-white py-5 rounded-2xl font-bold text-xs uppercase tracking-[0.2em] hover:bg-amber-700 transition-all shadow-2xl shadow-slate-400 dark:shadow-black/40 active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed\"\n                                    disabled={!newPermission || !expiresAt}\n                                    type=\"submit\"\n                                >\n                                    {t(\"members.permissions.grant_btn\", { defaultValue: \"Grant Permission\" }).toUpperCase()}\n                                </button>\n                            </div>\n                        </form>\n                    </div>\n                </div>\n            <ConfirmationDialog />\n        </Modal>\n    );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/settings/role-form-modal.tsx","messages":[],"suppressedMessages":[{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/workspace/webdashboard/src/components/features/settings/role-form-modal.tsx:33:7\n  31 |     if (editingRole && isOpen) {\n  32 |       // eslint-disable-next-line -- Derived state synced from props; intentional pattern\n> 33 |       setName(editingRole.name);\n     |       ^^^^^^^ Avoid calling setState() directly within an effect\n  34 |       setDescription(editingRole.description || \"\");\n  35 |       setColor(editingRole.color || \"slate\");\n  36 |     } else if (isOpen) {","line":33,"column":7,"nodeType":null,"endLine":33,"endColumn":14,"suppressions":[{"kind":"directive","justification":"Derived state synced from props; intentional pattern"}]}],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/settings/role-management-modal.tsx","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Function 'RoleManagementModal' has too many lines (137). Maximum allowed is 100.","line":17,"column":16,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":168,"endColumn":2}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Shield, Plus, Trash2, Clock, UserCheck } from \"lucide-react\";\nimport { useState } from \"react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { Combobox } from \"@/components/ui/combobox\";\nimport Modal from \"@/components/ui/modal\";\nimport { useConfirm } from \"@/hooks/use-confirm\";\nimport { useDateTimeFormatter } from \"@/hooks/use-datetime\";\nimport { useMemberRoles, useWorkspaceRoles } from \"@/hooks/use-workspace\";\n\ninterface RoleManagementModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  userId: string | null;\n}\n\nexport default function RoleManagementModal({\n  userId,\n  isOpen,\n  onClose,\n}: RoleManagementModalProps) {\n  const { t } = useTranslation();\n  const { formatDateTime } = useDateTimeFormatter();\n  const { roles: memberRoles, isLoading, updatePrimaryRole, assignRole, revokeRole } = useMemberRoles(userId ?? \"\", undefined);\n  const { roles: workspaceRoles } = useWorkspaceRoles();\n  const { confirm, ConfirmationDialog } = useConfirm();\n\n  const [newRoleId, setNewRoleId] = useState(\"\");\n  const [expiresAt, setExpiresAt] = useState(\"\");\n\n  const primaryRoleId = memberRoles?.primary ?? \"\";\n  const extraRoles = memberRoles?.extra ?? [];\n\n  const getRoleName = (roleId: string) => {\n    return workspaceRoles.find(r => r.id === roleId)?.name ?? roleId;\n  };\n\n  const roleOptions = workspaceRoles.map(r => ({\n    value: r.id,\n    label: r.name.toUpperCase(),\n    description: r.description ?? undefined,\n    icon: <Shield className={`w-4 h-4 ${r.is_system ? 'text-primary-600 dark:text-primary-400' : 'text-slate-500 dark:text-slate-400'}`} />,\n  }));\n\n  const availableExtraRoleOptions = roleOptions.filter(opt =>\n    opt.value !== primaryRoleId && !extraRoles.some(er => er.role_id === opt.value)\n  );\n\n  async function handleUpdatePrimary(roleId: string) {\n    if (roleId === primaryRoleId) return;\n    const roleName = getRoleName(roleId);\n    const ok = await confirm({\n      title: t(\"common.warning\", { defaultValue: \"Warning\" }),\n      message: t(\"members.roles.confirm_change_primary\", { role: roleName.toUpperCase() }),\n      variant: \"danger\"\n    });\n    if (!ok) return;\n    try { await updatePrimaryRole(roleId); } catch (e: unknown) { console.error(e); }\n \n  }\n\n  async function handleAssign(e: React.SyntheticEvent) {\n    e.preventDefault(); if (!expiresAt || !userId || !newRoleId) return;\n    try {\n      const isoExpiresAt = new Date(expiresAt).toISOString();\n      await assignRole({ role: newRoleId, expiresAt: isoExpiresAt });\n      setExpiresAt(\"\");\n      setNewRoleId(\"\");\n    } catch (e) { console.error(e); }\n  }\n\n  async function handleRevoke(roleId: string) {\n    const ok = await confirm({\n      title: t(\"common.warning\", { defaultValue: \"Warning\" }),\n      message: t(\"members.roles.confirm_revoke\"),\n      variant: \"danger\"\n    });\n    if (!ok) return;\n    try { await revokeRole(roleId); } catch (e) { console.error(e); }\n  }\n\n  if (!isOpen) return null;\n\n  return (\n    <Modal\n      icon={<UserCheck size={24} />}\n      isOpen={isOpen}\n      maxWidth=\"lg\"\n      onClose={onClose}\n      subtitle={t(\"members.roles.modal_subtitle\")}\n      title={t(\"members.roles.modal_title\")}\n    >\n      <div className=\"space-y-10\">\n          {isLoading ? (\n            <div className=\"py-20 text-center text-slate-500 dark:text-slate-400 font-bold italic uppercase tracking-widest text-xs opacity-50 animate-pulse\">{t(\"common.loading\")}</div>\n          ) : (\n            <div className=\"space-y-10 animate-in fade-in duration-700\">\n              <div className=\"space-y-4 px-1\">\n                <label className=\"text-[10px] font-bold uppercase tracking-[0.25em] text-slate-500 dark:text-slate-400 ml-1\" htmlFor=\"primary-role-select\">\n                  {t(\"members.roles.primary_role_label\").toUpperCase()}\n                </label>\n                <Combobox\n                  className=\"bg-slate-50 dark:bg-slate-800 border-slate-100 dark:border-slate-800 h-16 rounded-[1.5rem] text-sm shadow-inner\"\n                  id=\"primary-role-select\"\n                  onChange={handleUpdatePrimary}\n                  options={roleOptions}\n                  value={primaryRoleId}\n                />\n              </div>\n\n              <div className=\"space-y-5 px-1\">\n                <label className=\"text-[10px] font-bold uppercase tracking-[0.25em] text-slate-500 dark:text-slate-400 ml-1\">\n                  {t(\"members.roles.extra_roles_label\").toUpperCase()}\n                </label>\n\n                <div className=\"space-y-4\">\n                  {extraRoles.map((extraRole) => (\n                    <div className=\"flex items-center justify-between p-6 bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-[2rem] hover:bg-white dark:hover:bg-slate-900 hover:shadow-xl hover:shadow-primary-100/10 transition-all group relative overflow-hidden shadow-inner\" key={extraRole.id}>\n                      <div className=\"space-y-2\">\n                        <p className=\"font-bold text-slate-700 dark:text-slate-200 text-base uppercase tracking-tight leading-none\">{getRoleName(extraRole.role_id)}</p>\n                        <div className=\"flex items-center gap-2 text-[10px] text-slate-500 dark:text-slate-400 font-bold uppercase tracking-widest opacity-70\">\n                          <Clock className=\"text-primary-400\" size={12} /> <span>{t(\"members.roles.expires_at\").toUpperCase()}: {formatDateTime(extraRole.expires_at)}</span>\n                        </div>\n                      </div>\n                      <button className=\"p-3 bg-white dark:bg-slate-900 text-slate-300 dark:text-slate-600 hover:text-rose-600 dark:text-rose-300 rounded-xl shadow-md border border-slate-100 dark:border-slate-800 transition-all opacity-0 group-hover:opacity-100 translate-x-2 group-hover:translate-x-0 active:scale-90\" onClick={() => handleRevoke(extraRole.id)}><Trash2 size={18} /></button>\n                    </div>\n                  ))}\n\n                  {extraRoles.length === 0 && (\n                    <div className=\"text-center py-12 border-2 border-dashed border-slate-100 dark:border-slate-800 rounded-[2.5rem] bg-slate-50 dark:bg-slate-800/30 flex flex-col items-center\">\n                      <Shield className=\"text-slate-200 dark:text-slate-700 mb-4\" size={32} />\n                      <p className=\"text-[10px] font-bold text-slate-300 dark:text-slate-600 uppercase tracking-widest opacity-60 italic\">{t(\"members.roles.no_extra_roles\")}</p>\n                    </div>\n                  )}\n                </div>\n              </div>\n            </div>\n          )}\n\n          <div className=\"pt-10 border-t border-slate-50 dark:border-slate-800 space-y-8\">\n            <h3 className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.3em] flex items-center gap-3 px-1\">\n              <Plus className=\"text-primary-500\" size={16} /> {t(\"members.roles.assign_new_title\").toUpperCase()}\n            </h3>\n            <form className=\"grid grid-cols-1 md:grid-cols-2 gap-8 animate-in slide-in-from-bottom-4 duration-700\" onSubmit={handleAssign}>\n              <div className=\"space-y-3 px-1\">\n                <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\" htmlFor=\"extra-role-select\">{t(\"members.invite.role_label\")}</label>\n                <Combobox\n                  className=\"bg-slate-50 dark:bg-slate-800 border-slate-100 dark:border-slate-800 h-14 rounded-2xl\"\n                  id=\"extra-role-select\"\n                  onChange={setNewRoleId}\n                  options={availableExtraRoleOptions}\n                  value={newRoleId}\n                />\n              </div>\n              <div className=\"space-y-3 px-1\">\n                <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\" htmlFor=\"expires-at-input\">{t(\"members.roles.expiry_date_label\")}</label>\n                <input className=\"w-full bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl px-6 py-4 focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-bold text-sm tracking-tight shadow-sm\" id=\"expires-at-input\" onChange={(e) => { setExpiresAt(e.target.value); }} required type=\"datetime-local\" value={expiresAt} />\n              </div>\n              <div className=\"md:col-span-2 pt-2\">\n                <button className=\"w-full bg-slate-900 text-white py-5 rounded-2xl font-bold text-xs uppercase tracking-[0.2em] hover:bg-primary-700 transition-all shadow-2xl shadow-slate-400 dark:shadow-black/40 active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed\" disabled={!newRoleId} type=\"submit\">{t(\"members.roles.assign_btn\").toUpperCase()}</button>\n              </div>\n            </form>\n          </div>\n      </div>\n      <ConfirmationDialog />\n    </Modal>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/workspaces/create-workspace-dialog.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/layout/__tests__/theme-toggle.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/layout/infra-layout.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/layout/main-layout.tsx","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Function 'MainLayout' has too many lines (126). Maximum allowed is 100.","line":25,"column":16,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":164,"endColumn":2},{"ruleId":"complexity","severity":2,"message":"Arrow function has a complexity of 12. Maximum allowed is 10.","line":83,"column":32,"nodeType":"ArrowFunctionExpression","messageId":"complex","endLine":83,"endColumn":34}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Outlet, useLocation } from \"@tanstack/react-router\";\nimport { Building2 } from \"lucide-react\";\nimport React, { useState, useEffect } from \"react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { useI18nSync } from \"@/hooks/use-i18n-sync\";\nimport { useTheme } from \"@/hooks/use-theme\";\nimport { useWorkspaces } from \"@/hooks/use-workspace\";\nimport { getCurrentWorkspaceId } from \"@/lib/api\";\nimport { ROUTES } from \"@/lib/routes\";\nimport { cn } from \"@/lib/utils\";\n\nimport Modal from \"../ui/modal\";\nimport Navbar from \"./navbar\";\nimport Sidebar from \"./sidebar\";\nimport WorkspaceSwitcher from \"./workspace-switcher\";\n\n\n\n// Stable module-level arrays for sidebar section matching\nconst ORG_PATHS: string[] = [ROUTES.PEOPLE, ROUTES.EMPLOYEES, ROUTES.DEPARTMENTS];\nconst TIME_PATHS: string[] = [ROUTES.ATTENDANCE_LOGS, ROUTES.LEAVE_REQUESTS, ROUTES.ATTENDANCE_ADJUSTMENTS, ROUTES.REPORTS, ROUTES.LEAVE_BALANCES, ROUTES.SHIFT_SWAPS];\nconst PAYROLL_PATHS: string[] = [ROUTES.SHIFTS, ROUTES.PAYROLL];\n\nexport default function MainLayout() {\n  const { t } = useTranslation();\n  useTheme();\n  useI18nSync();\n  const location = useLocation();\n\n  const [isSidebarOpen, setIsSidebarOpen] = useState(false);\n  const [showSwitcher, setShowSwitcher] = useState(false);\n  const [isCollapsed, setIsCollapsed] = useState(() => {\n    const saved = localStorage.getItem(\"sidebar-collapsed\");\n    return saved === \"true\";\n  });\n\n  const getInitialOpenSections = () => {\n    const path = location.pathname;\n    return {\n      org: ORG_PATHS.includes(path),\n      time: TIME_PATHS.includes(path) || path === ROUTES.HOME,\n      payroll: PAYROLL_PATHS.includes(path),\n      system: path.startsWith(ROUTES.SETTINGS.ROOT),\n      ess: path.startsWith(\"/ess/\"),\n    };\n  };\n\n  const [openSections, setOpenSections] = useState<Record<string, boolean>>(getInitialOpenSections());\n\n  const { workspaces } = useWorkspaces();\n  const currentWsId = getCurrentWorkspaceId();\n  const currentWorkspace = workspaces.find(ws => ws.id === currentWsId);\n\n  const toggleSection = (section: string) => {\n    setOpenSections(previous => ({\n      org: false,\n      time: false,\n      payroll: false,\n      system: false,\n      ess: false,\n      [section]: !previous[section]\n    }));\n  };\n\n  const toggleCollapsed = () => {\n    setIsCollapsed(previous => {\n      const newValue = !previous;\n      localStorage.setItem(\"sidebar-collapsed\", String(newValue));\n      return newValue;\n    });\n  };\n\n  useEffect(() => {\n    const path = location.pathname;\n    const isOrg = ORG_PATHS.includes(path);\n    const isTime = TIME_PATHS.includes(path);\n    const isPayroll = PAYROLL_PATHS.includes(path);\n    const isSystem = path.startsWith(ROUTES.SETTINGS.ROOT);\n    const isEss = path.startsWith(\"/ess/\");\n\n    const timer = setTimeout(() => {\n      setOpenSections(previous => {\n        const next = { ...previous };\n        let changed = false;\n        if (isOrg && !previous.org) { next.org = true; changed = true; }\n        if (isTime && !previous.time) { next.time = true; changed = true; }\n        if (isPayroll && !previous.payroll) { next.payroll = true; changed = true; }\n        if (isSystem && !previous.system) { next.system = true; changed = true; }\n        if (isEss && !previous.ess) { next.ess = true; changed = true; }\n        return changed ? next : previous;\n      });\n      setIsSidebarOpen(false);\n    }, 0);\n\n    return () => { clearTimeout(timer); };\n  }, [location.pathname]);\n\n  return (\n    <div className=\"flex min-h-screen bg-background text-foreground font-sans relative overflow-x-hidden\">\n      {isSidebarOpen ? (\n        <div\n          className=\"fixed inset-0 bg-slate-900/50 dark:bg-slate-950/60 backdrop-blur-sm z-40 lg:hidden transition-opacity duration-500\"\n          onClick={() => { setIsSidebarOpen(false); }}\n          onKeyDown={(e) => {\n            if (e.key === 'Escape' || e.key === 'Enter' || e.key === ' ') {\n              setIsSidebarOpen(false);\n            }\n          }}\n          role=\"presentation\"\n        />\n      ) : null}\n\n      <Sidebar\n        isCollapsed={isCollapsed}\n        isOpen={isSidebarOpen}\n        onClose={() => { setIsSidebarOpen(false); }}\n        onShowSwitcher={() => { setShowSwitcher(true); }}\n        openSections={openSections}\n        toggleSection={toggleSection}\n      />\n\n      <div className={cn(\n        \"flex-1 flex flex-col min-w-0 h-screen overflow-hidden relative transition-all duration-300\",\n        isCollapsed ? \"lg:ml-20\" : \"lg:ml-72\"\n      )}>\n        <Navbar\n          currentWorkspaceName={currentWorkspace?.name ?? \"Workspace\"}\n          isCollapsed={isCollapsed}\n          onOpenSidebar={() => { setIsSidebarOpen(true); }}\n          onToggleCollapsed={toggleCollapsed}\n        />\n\n        <main className=\"flex-1 overflow-y-auto p-4 md:p-8 lg:p-10 relative scroll-smooth\">\n          <div className=\"max-w-7xl mx-auto animate-in fade-in slide-in-from-bottom-4 duration-500 fill-mode-both\" key={location.pathname}>\n            <Outlet />\n          </div>\n        </main>\n      </div>\n\n      <Modal\n        icon={<Building2 className=\"w-6 h-6\" />}\n        isOpen={showSwitcher}\n        maxWidth=\"lg\"\n        onClose={() => { setShowSwitcher(false); }}\n        subtitle={t(\"common.office_branch\")}\n        title={t(\"common.switch_workspace\")}\n      >\n        <div className=\"space-y-8\">\n          <p className=\"text-sm text-slate-500 dark:text-slate-400 font-medium px-1\">{t(\"common.select_workspace_desc\")}</p>\n          <WorkspaceSwitcher />\n          <div className=\"pt-6 border-t border-slate-50 dark:border-slate-800 flex justify-end\">\n            <button\n              className=\"px-8 py-3 bg-slate-100 dark:bg-slate-800 text-foreground/70 rounded-2xl font-bold text-xs uppercase tracking-widest hover:bg-slate-200 dark:hover:bg-slate-700 transition-all\"\n              onClick={() => { setShowSwitcher(false); }}\n            >\n              {t(\"common.close\")}\n            </button>\n          </div>\n        </div>\n      </Modal>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/layout/navbar.tsx","messages":[{"ruleId":"@typescript-eslint/no-u