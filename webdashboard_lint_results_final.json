rid grid-cols-1 md:grid-cols-7 gap-4\">\n        {weekDays.map((day, index) => {\n          const dateString = format(day, 'yyyy-MM-dd');\n          const isSelected = selectedDays.includes(dateString);\n \n          const effectiveSchedule = employeeSchedule?.schedules.find((s) => s.date === dateString);\n          const isToday = day.toDateString() === new Date().toDateString();\n \n          const isHoliday = effectiveSchedule?.is_holiday === true;\n\n          return (\n            <WeeklyRosterDayCard\n              currentLocale={currentLocale}\n              dateString={dateString}\n              day={day}\n              effectiveSchedule={effectiveSchedule}\n              formatTime={formatTime}\n              isHoliday={isHoliday}\n              isSelected={isSelected}\n              isToday={isToday}\n              key={index}\n              onDeleteRoster={onDeleteRoster}\n              onToggleDaySelection={onToggleDaySelection}\n              t={t}\n            />\n          );\n        })}\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/templates/approval-list-layout.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/time-tracking/__tests__/adjustment-request-modal.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/time-tracking/__tests__/punch-card.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/time-tracking/__tests__/time-entry-row.test.tsx","messages":[],"suppressedMessages"