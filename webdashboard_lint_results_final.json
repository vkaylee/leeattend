0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/__tests__/payroll-page.test.tsx","messages":[{"ruleId":"react/jsx-no-comment-textnodes","severity":2,"message":"Comments inside children section of tag should be placed inside braces","line":89,"column":49,"nodeType":"JSXText","messageId":"putCommentInBraces","endLine":91,"endColumn":9}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { QueryClient, QueryClientProvider } from '@tanstack/react-query';\nimport { render, screen, fireEvent } from '@testing-library/react';\nimport { BrowserRouter } from 'react-router-dom';\n\nimport { describe, it, expect, vi, beforeEach } from 'vitest';\n\nimport { ToastProvider } from '../../components/ui/toast';\nimport { useWorkspace } from \"../../hooks/use-workspace\";\nimport * as api from '../../lib/api';\nimport { Payslip } from \"../../lib/api/types\";\nimport PayrollPage from '../payroll-page';\n\n// Partially mock the API library\n \nvi.mock('../../lib/api', async () => {\n  const actual = await vi.importActual('../../lib/api');\n  return {\n    ...actual,\n    fetchEmployees: vi.fn(),\n    searchEmployees: vi.fn(),\n    fetchEmployeePayslips: vi.fn(),\n    fetchWorkspacePayslips: vi.fn(),\n    calculateBatchPayslips: vi.fn(),\n    getCurrentWorkspaceId: vi.fn(() => 'test-ws-id'),\n    fetchWorkspaceAttendanceAdjustments: vi.fn(),\n    fetchWorkspace: vi.fn(),\n  };\n});\n\nvi.mock(\"../../hooks/use-workspace\", () => ({\n  useWorkspace: vi.fn(),\n}));\n\ndescribe('PayrollPage', () => {\n  let queryClient: QueryClient;\n\n  beforeEach(() => {\n    vi.clearAllMocks();\n \n    queryClient = new QueryClient({\n      defaultOptions: { queries: { retry: false, gcTime: 0, staleTime: 0 } },\n    });\n\n    // Provide default mock values\n    vi.mocked(api.fetchEmployees).mockResolvedValue({\n \n      data: [],\n      total: 0,\n      page: 1,\n      limit: 3000,\n    });\n    vi.mocked(api.searchEmployees).mockResolvedValue({\n \n      data: [],\n \n      total: 0,\n \n      page: 1,\n \n      limit: 100,\n \n    });\n    vi.mocked(useWorkspace).mockReturnValue({\n      workspace: {\n        id: \"test-ws-id\",\n \n        name: \"Test Workspace\",\n      },\n      isLoading: false,\n      isError: false,\n    } as unknown as ReturnType<typeof useWorkspace>);\n    vi.mocked(api.fetchEmployeePayslips).mockResolvedValue([]);\n    vi.mocked(api.fetchWorkspacePayslips).mockResolvedValue([]);\n    vi.mocked(api.fetchWorkspaceAttendanceAdjustments).mockResolvedValue([]);\n    vi.mocked(api.getCurrentWorkspaceId).mockReturnValue('test-ws-id');\n  });\n\n  it('renders employee list and summary table', async () => {\n    vi.mocked(api.fetchEmployees).mockResolvedValue({\n      data: [\n        { id: 'emp-1', workspace_id: 'ws-1', full_name: 'John Doe', employee_id_number: 'EMP001', hire_date: '2025-01-01', is_active: true, created_at: '2025-01-01T00:00:00Z', updated_at: '2025-01-01T00:00:00Z' }\n      ],\n      total: 1,\n      page: 1,\n      limit: 3000,\n    });\n\n    render(\n      <QueryClientProvider client={queryClient}>\n// eslint-disable-next-line @typescript-eslint/no-explicit-any\n        <ToastProvider>\n          <BrowserRouter>\n            <PayrollPage />\n          </BrowserRouter>\n        </ToastProvider>\n      </QueryClientProvider>\n    );\n\n \n    expect(await screen.findByText('John Doe')).toBeDefined();\n  });\n\n  it('shows detail drawer when an employee is clicked', async () => {\n    vi.mocked(api.fetchEmployees).mockResolvedValue({\n      data: [\n        { id: 'emp-1', workspace_id: 'ws-1', full_name: 'John Doe', employee_id_number: 'EMP001', hire_date: '2025-01-01', is_active: true, created_at: '2025-01-01T00:00:00Z', updated_at: '2025-01-01T00:00:00Z' }\n      ],\n      total: 1,\n      page: 1,\n      limit: 3000,\n    });\n    vi.mocked(useWorkspace).mockReturnValue({\n      workspace: {\n        id: \"test-ws-id\",\n        name: \"Test Workspace\",\n        timezone: \"Asia/Ho_Chi_Minh\",\n        created_at: \"2024-01-01T00:00:00Z\",\n      },\n      isLoading: false,\n      isError: false,\n    } as unknown as ReturnType<typeof useWorkspace>);\n    vi.mocked(api.fetchEmployeePayslips).mockResolvedValue([\n      { \n        id: 'ps-1', \n        employee_id: 'emp-1', \n        period_start: '2025-12-01', \n        period_end: '2025-12-31', \n        base_pay_amount: '10000000', \n        overtime_pay_amount: '400000', \n        holiday_work_premium_amount: '0',\n        deductions_amount: '0', \n        net_pay_amount: '10400000', \n        status: 'paid',\n        standard_units: 22,\n        overtime_units: 10,\n        created_at: '2025-01-01T00:00:00Z',\n        updated_at: '2025-01-01T00:00:00Z'\n      }\n    ] as unknown as Payslip[]);\n\n    render(\n      <QueryClientProvider client={queryClient}>\n        <ToastProvider>\n          <BrowserRouter>\n            <PayrollPage />\n          </BrowserRouter>\n        </ToastProvider>\n      </QueryClientProvider>\n    );\n\n    const employeeText = await screen.findByText('John Doe');\n    const employeeRow = employeeText.closest('tr');\n    fireEvent.click(employeeRow!);\n\n    expect((await screen.findAllByText(/Lịch sử phiếu lương/i))[0]).toBeDefined();\n  });\n});","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/__tests__/permission-sync.test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/__tests__/profile-page.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/__tests__/register-page.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/__tests__/reports-page.test.tsx","messages":[{"ruleId":"@typescript-eslint/no-base-to-string","severity":2,"message":"'value' will use Object's default stringification format ('[object Object]') when stringified.","line":25,"column":37,"nodeType":"Identifier","messageId":"baseToString","endLine":25,"endColumn":42}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { QueryClient, QueryClientProvider } from \"@tanstack/react-query\";\nimport { render, screen, waitFor, fireEvent } from \"@testing-library/react\";\nimport React from \"react\";\n\nimport userEvent from \"@testing-library/user-event\";\nimport { describe, it, expect, vi, beforeEach } from \"vitest\";\n\nimport { ToastProvider } from \"../../components/ui/toast\";\nimport i18n from \"../../i18n/config\";\nimport * as api from \"../../lib/api\";\nimport { PaginatedResponse, AttendanceSummary, DailyAttendanceReport } from \"../../lib/api/types\";\nimport ReportsPage from \"../reports-page\";\n\n// Mock TanStack Router\nvi.mock(\"@tanstack/react-router\", () => ({\n  useNavigate: () => vi.fn(),\n \n  useLocation: () => ({ pathname: \"/\", search: \"\", hash: \"\" }),\n  Link: ({ to, search, children, ...props }: { to: string; search?: Record<string, unknown>; children: React.ReactNode; [key: string]: unknown }) => {\n    let href = to;\n    if (search && typeof search === 'object') {\n      const params = new URLSearchParams();\n      Object.entries(search).forEach(([key, value]) => {\n        if (value !== undefined && value !== null) {\n          params.append(key, String(value));\n        }\n      });\n      const qs = params.toString();\n      if (qs) href += `?${qs}`;\n    }\n    return <a href={href} {...props}>{children}</a>;\n  },\n}));\n\n// Mock scrollIntoView and scrollTo for jsdom\nwindow.HTMLElement.prototype.scrollIntoView = vi.fn();\n\n// Mock IntersectionObserver for jsdom\nclass MockIntersectionObserver {\n  observe = vi.fn();\n  unobserve = vi.fn();\n  disconnect = vi.fn();\n}\nwindow.IntersectionObserver = MockIntersectionObserver as unknown as typeof IntersectionObserver;\n\n// Mock the API library\nvi.mock(\"../../lib/api\", () => ({\n  fetchAttendanceReport: vi.fn(),\n  getCurrentWorkspaceId: vi.fn(),\n  fetchWorkspace: vi.fn(),\n  reprocessAttendance: vi.fn(),\n  fetchEmployees: vi.fn(),\n  searchEmployees: vi.fn(),\n  fetchDepartments: vi.fn(),\n  fetchWorkspaceAttendanceAdjustments: vi.fn(),\n  adminConfirmAttendance: vi.fn(),\n}));\n\n// Mock DebugContext\nvi.mock(\"@/context/debug-context\", () => ({\n  useDebug: () => ({ isEnabled: false }),\n}));\n\ndescribe(\"ReportsPage\", () => {\n  let queryClient: QueryClient;\n\n  beforeEach(() => {\n    vi.clearAllMocks();\n    void i18n.changeLanguage(\"en\");\n    queryClient = new QueryClient({\n      defaultOptions: {\n        queries: {\n          retry: false,\n          gcTime: 0,\n          staleTime: 0,\n        },\n      },\n \n    });\n \n    vi.mocked(api.getCurrentWorkspaceId).mockReturnValue(\"test-ws-id\");\n \n    vi.mocked(api.fetchWorkspace).mockResolvedValue({\n \n      id: \"test-ws-id\",\n \n      name: \"Test Workspace\",\n \n      work_unit_minutes: 60,\n      rounding_policy: \"none\",\n      date_format: \"YYYY-MM-DD\",\n      time_format: \"HH:mm\",\n \n      timezone: \"UTC\",\n \n      theme_primary_color: \"#000000\",\n      default_language: \"en\",\n      created_at: \"2025-01-01T00:00:00Z\",\n    });\n    vi.mocked(api.fetchEmployees).mockResolvedValue({ data: [{ id: \"emp-1\", full_name: \"John Doe\", workspace_id: \"test-ws-id\", employee_id_number: \"E01\", hire_date: \"2025-01-01\", is_active: true, created_at: \"2025-01-01T00:00:00Z\", updated_at: \"2025-01-01T00:00:00Z\" }], total: 1, page: 1, limit: 50 });\n    vi.mocked(api.searchEmployees).mockResolvedValue({ data: [{ id: \"emp-1\", full_name: \"John Doe\", workspace_id: \"test-ws-id\", employee_id_number: \"E01\", hire_date: \"2025-01-01\", is_active: true, created_at: \"2025-01-01T00:00:00Z\", updated_at: \"2025-01-01T00:00:00Z\" }], total: 1, page: 1, limit: 50 });\n    vi.mocked(api.fetchDepartments).mockResolvedValue([]);\n    vi.mocked(api.fetchAttendanceReport).mockImplementation(() => Promise.resolve({\n      data: [{ employee_id: \"emp-1\", employee_name: \"John Doe\", total_std_units: 440, total_ot_units: 40, total_leave_days: 0 }],\n      total: 1,\n      page: 1,\n      limit: 50\n    } as unknown as PaginatedResponse<AttendanceSummary>));\n    vi.mocked(api.fetchWorkspaceAttendanceAdjustments).mockResolvedValue([]);\n    vi.mocked(api.adminConfirmAttendance).mockResolvedValue(undefined);\n  });\n\n  const renderWithProviders = (ui: React.ReactElement, _initialEntries = [\"/\"]) => {\n    return render(\n      <QueryClientProvider client={queryClient}>\n        <ToastProvider>\n          {ui}\n        </ToastProvider>\n      </QueryClientProvider>\n    );\n  };\n\n  it(\"renders report table and defaults to last month\", async () => {\n    renderWithProviders(<ReportsPage />);\n    expect(await screen.findByText(/John Doe/i, {}, { timeout: 30000 })).toBeDefined();\n    const lastMonthButton = await screen.findByText(/Last Month|Tháng trước/i, {}, { timeout: 30000 });\n    expect(lastMonthButton).toBeDefined();\n  });\n\n  it(\"changes date range when clicking 'Tháng trước'\", async () => {\n    const user = userEvent.setup();\n    renderWithProviders(<ReportsPage />);\n    const lastMonthButton = await screen.findByText(/Last Month|Tháng trước/i);\n    await user.click(lastMonthButton);\n \n    expect(api.fetchAttendanceReport).toHaveBeenCalled();\n  });\n\n  it(\"shows custom date inputs when clicking 'Tùy chỉnh'\", async () => {\n    const user = userEvent.setup();\n    renderWithProviders(<ReportsPage />);\n    const customButton = await screen.findByText(/Custom|Tùy chỉnh/i);\n    await user.click(customButton);\n \n    expect(await screen.findByText(/From Date|Từ ngày/i)).toBeDefined();\n  });\n\n  it(\"uses PAGE_SIZE of 50 for infinite scroll\", async () => {\n    renderWithProviders(<ReportsPage />);\n    await waitFor(() => {\n      const calls = vi.mocked(api.fetchAttendanceReport).mock.calls;\n      expect(calls.length).toBeGreaterThan(0);\n      // first argument is the params object, check limit property\n      expect(calls[0][0].limit).toBe(50);\n    });\n  });\n\n  it(\"fetches full dataset with limit=99999 for stats and renders inline stats badges\", async () => {\n    vi.mocked(api.fetchAttendanceReport).mockImplementation((...args) => {\n      const limit = args[0].limit;\n      if (limit === 99999) {\n        // Full stats query — return all employees\n        return Promise.resolve({\n          data: [\n            { employee_id: \"emp-1\", employee_name: \"John Doe\", total_std_units: 440, total_ot_units: 40, total_leave_days: 0 },\n            { employee_id: \"emp-2\", employee_name: \"Jane Smith\", total_std_units: 360, total_ot_units: 60, total_leave_days: 1 },\n          ],\n \n          total: 2,\n \n          page: 1,\n          limit: 99999\n        } as unknown as PaginatedResponse<AttendanceSummary>);\n      }\n      // Paginated query — return only page 1\n      return Promise.resolve({\n        data: [{ employee_id: \"emp-1\", employee_name: \"John Doe\", total_std_units: 440, total_ot_units: 40, total_leave_days: 0 }],\n        total: 2,\n        page: 1,\n        limit: 50\n      } as unknown as PaginatedResponse<AttendanceSummary>);\n    });\n\n    renderWithProviders(<ReportsPage />);\n\n    // Verify a call with limit=99999 was made for stats\n    await waitFor(() => {\n      const calls = vi.mocked(api.fetchAttendanceReport).mock.calls;\n      const statsCall = calls.find((c) => c[0].limit === 99999);\n      expect(statsCall).toBeDefined();\n    });\n\n    // Stats should show totals from ALL employees\n    // emp-1: std=440, ot=40 + emp-2: std=360, ot=60 = total std=800, ot=100\n    // formatUnitsToHours: 800 * 60min / 60 = 800, 100 * 60min / 60 = 100\n    // The \"h\" suffix is added by JSX: {quickStats.stdHours}h\n    await waitFor(() => {\n      expect(screen.getByText(\"800h\")).toBeInTheDocument();\n      expect(screen.getByText(\"100h\")).toBeInTheDocument();\n      expect(screen.getByText(\"2\")).toBeInTheDocument();\n    });\n  });\n\n  it(\"shows unit values in tooltips instead of visible text\", async () => {\n    renderWithProviders(<ReportsPage />);\n    await screen.findByText(/John Doe/i);\n\n    // Units should NOT be visible as text\n    expect(screen.queryByText(\"440 U\")).toBeNull();\n    expect(screen.queryByText(\"40 OT\")).toBeNull();\n\n    // Units should be in title attributes (tooltips)\n    const stdHoursCell = screen.getByTitle(\"440 units\");\n    expect(stdHoursCell).toBeInTheDocument();\n\n    const otHoursCell = screen.getByTitle(\"40 OT units\");\n    expect(otHoursCell).toBeInTheDocument();\n  });\n\n  it(\"opens slide-over drawer when clicking an employee row\", async () => {\n    const user = userEvent.setup();\n\n \n    const mockDailyRow = {\n      employee_id: \"emp-1\",\n      employee_name: \"John Doe\",\n      date: \"2026-01-15\",\n      actual_punch_in: \"2026-01-15T01:00:00Z\",\n      actual_punch_out: \"2026-01-15T10:00:00Z\",\n      scheduled_start: \"08:00:00\",\n      scheduled_end: \"17:00:00\",\n      break_duration_minutes: 60,\n      break_start: null,\n      break_end: null,\n      is_break_auto_deduct: false,\n      std_work_units: 480,\n      ot_work_units: 0,\n      status: \"present\",\n      generation_metadata: null,\n    };\n\n    vi.mocked(api.fetchAttendanceReport).mockImplementation(\n      ({ type }) => {\n        if (type === \"daily\") {\n          return Promise.resolve({ data: [mockDailyRow], total: 1, page: 1, limit: 50 } as unknown as PaginatedResponse<DailyAttendanceReport>);\n        }\n \n        return Promise.resolve({\n          data: [{ employee_id: \"emp-1\", employee_name: \"John Doe\", total_std_units: 440, total_ot_units: 40, total_leave_days: 0 }],\n          total: 1,\n          page: 1,\n          limit: 50\n        } as unknown as PaginatedResponse<AttendanceSummary>);\n      }\n    );\n\n    renderWithProviders(<ReportsPage />);\n    const employeeRow = await screen.findByText(/John Doe/i);\n    await user.click(employeeRow);\n\n    const sheetPanel = await screen.findByTestId(\"sheet-panel\");\n    expect(sheetPanel).toBeDefined();\n  });\n\n  it(\"always fetches summary data (no daily tab)\", async () => {\n    renderWithProviders(<ReportsPage />);\n    await waitFor(() => {\n      const calls = vi.mocked(api.fetchAttendanceReport).mock.calls;\n      expect(calls.length).toBeGreaterThan(0);\n      expect(calls[0][0].type).toBe(\"summary\");\n    });\n\n    const dailyTab = screen.queryByText(/Daily Details|Chi tiết hàng ngày/i);\n    expect(dailyTab).toBeNull();\n  });\n\n  it(\"renders a search input that exists and is functional\", async () => {\n    renderWithProviders(<ReportsPage />);\n    await screen.findByText(/John Doe/i);\n\n    // Search input should exist\n    const searchInput = screen.getByRole(\"textbox\");\n    expect(searchInput).toBeDefined();\n    // autoFocus removed for accessibility (jsx-a11y/no-autofocus)\n    expect(searchInput).toBeInTheDocument();\n  });\n\n  it(\"triggers searchEmployees API on search input with debounce\", async () => {\n    const user = userEvent.setup();\n    renderWithProviders(<ReportsPage />);\n    await screen.findByText(/John Doe/i);\n\n    const searchInput = screen.getByRole(\"textbox\");\n    await user.type(searchInput, \"John\");\n\n    // searchEmployees should be called after debounce (400ms)\n    await waitFor(() => {\n      expect(api.searchEmployees).toHaveBeenCalledWith({ wsId: \"test-ws-id\", query: \"John\" });\n    }, { timeout: 2000 });\n  });\n \n\n  it(\"auto-selects text on focus and refocuses on drawer close\", async () => {\n    const user = userEvent.setup();\n    const mockDailyRow = {\n      employee_id: \"emp-1\",\n      employee_name: \"John Doe\",\n      date: \"2026-01-15\",\n      actual_punch_in: \"2026-01-15T01:00:00Z\",\n      actual_punch_out: \"2026-01-15T10:00:00Z\",\n      scheduled_start: \"08:00:00\",\n      scheduled_end: \"17:00:00\",\n      break_duration_minutes: 60,\n      break_start: null,\n      break_end: null,\n      is_break_auto_deduct: false,\n      std_work_units: 480,\n      ot_work_units: 0,\n      status: \"present\",\n      generation_metadata: null,\n    };\n    vi.mocked(api.fetchAttendanceReport).mockImplementation(({ type }) => {\n      if (type === \"daily\") return Promise.resolve({ data: [mockDailyRow], total: 1, page: 1, limit: 50 } as unknown as PaginatedResponse<DailyAttendanceReport>);\n      return Promise.resolve({ data: [{ employee_id: \"emp-1\", employee_name: \"John Doe\", total_std_units: 440, total_ot_units: 40, total_leave_days: 0 }], total: 1, page: 1, limit: 50 } as unknown as PaginatedResponse<AttendanceSummary>);\n    });\n\n    renderWithProviders(<ReportsPage />);\n    const employeeRow = await screen.findByText(/John Doe/i);\n\n    // Type into search\n    const searchInput = screen.getByRole(\"textbox\");\n    await user.type(searchInput, \"Test\");\n\n    // Test auto-select on focus\n    searchInput.blur();\n    expect((searchInput as HTMLInputElement).selectionStart).toBe((searchInput as HTMLInputElement).selectionEnd);\n    await user.click(searchInput);\n    expect((searchInput as HTMLInputElement).selectionStart).toBe(0);\n    expect((searchInput as HTMLInputElement).selectionEnd).toBe(4); // length of \"Test\"\n\n    // Open drawer\n    await user.click(employeeRow);\n    const sheetPanel = await screen.findByTestId(\"sheet-panel\");\n    expect(sheetPanel).toBeInTheDocument();\n\n    // Ensure search input lost focus\n    expect(searchInput).not.toHaveFocus();\n\n    // Close drawer\n    const xIcon = sheetPanel.querySelector('svg.lucide-x');\n    const closeButton = xIcon?.closest('button');\n    await user.click(closeButton!);\n\n    // wait for the 100ms timeout in focusSearch\n    await new Promise(r => setTimeout(r, 150));\n\n    // search should be focused again\n    expect(searchInput).toHaveFocus();\n    // and its text should be auto-selected because of the onFocus handler\n    expect((searchInput as HTMLInputElement).selectionStart).toBe(0);\n    expect((searchInput as HTMLInputElement).selectionEnd).toBe(4);\n  });\n \n\n  it(\"opens the first employee's drawer when pressing Enter in search input\", async () => {\n    const user = userEvent.setup();\n    const mockDailyRow = {\n      employee_id: \"emp-1\",\n      employee_name: \"John Doe\",\n      date: \"2026-01-15\",\n      actual_punch_in: \"2026-01-15T01:00:00Z\",\n      actual_punch_out: \"2026-01-15T10:00:00Z\",\n      scheduled_start: \"08:00:00\",\n      scheduled_end: \"17:00:00\",\n      break_duration_minutes: 60,\n      break_start: null,\n      break_end: null,\n      is_break_auto_deduct: false,\n      std_work_units: 480,\n      ot_work_units: 0,\n      status: \"present\",\n      generation_metadata: null,\n    };\n    vi.mocked(api.fetchAttendanceReport).mockImplementation(({ type }) => {\n      if (type === \"daily\") return Promise.resolve({ data: [mockDailyRow], total: 1, page: 1, limit: 50 } as unknown as PaginatedResponse<DailyAttendanceReport>);\n      return Promise.resolve({ data: [{ employee_id: \"emp-1\", employee_name: \"John Doe\", total_std_units: 440, total_ot_units: 40, total_leave_days: 0 }], total: 1, page: 1, limit: 50 } as unknown as PaginatedResponse<AttendanceSummary>);\n    });\n\n    renderWithProviders(<ReportsPage />);\n    await screen.findByText(/John Doe/i);\n\n    // Get search input and focus it\n    const searchInput = screen.getByRole(\"textbox\");\n\n    // Type something and hit enter mapped directly onto the element\n    await user.type(searchInput, \"John{Enter}\");\n\n    // The Drawer should open up for John Doe (emp-1)\n    const sheetPanel = await screen.findByTestId(\"sheet-panel\");\n    expect(sheetPanel).toBeInTheDocument();\n\n    // Ensure the input has lost focus (blur) so arrow navigation works inside the drawer\n    expect(searchInput).not.toHaveFocus();\n\n    // We should see the daily report data because the drawer is open\n    const rawLogsToggle = await screen.findByRole(\"button\", { name: /Nhật ký thô|View Raw Logs|reports.view_raw_logs/i });\n    expect(rawLogsToggle).toBeInTheDocument();\n \n  });\n  it(\"allows switching tabs with arrows after opening the drawer via Enter key\", async () => {\n    const user = userEvent.setup();\n    const mockDailyRow = {\n      employee_id: \"emp-1\",\n      employee_name: \"John Doe\",\n      date: \"2026-01-15\",\n      actual_punch_in: \"2026-01-15T01:00:00Z\",\n      actual_punch_out: \"2026-01-15T10:00:00Z\",\n      scheduled_start: \"08:00:00\",\n      scheduled_end: \"17:00:00\",\n      break_duration_minutes: 60,\n      break_start: null,\n      break_end: null,\n      is_break_auto_deduct: false,\n      std_work_units: 480,\n      ot_work_units: 0,\n      status: \"present\",\n      generation_metadata: null,\n    };\n    vi.mocked(api.fetchAttendanceReport).mockImplementation(({ type }) => {\n      if (type === \"daily\") return Promise.resolve({ data: [mockDailyRow], total: 1, page: 1, limit: 50 } as unknown as PaginatedResponse<DailyAttendanceReport>);\n      return Promise.resolve({ data: [{ employee_id: \"emp-1\", employee_name: \"John Doe\", total_std_units: 440, total_ot_units: 40, total_leave_days: 0 }], total: 1, page: 1, limit: 50 } as unknown as PaginatedResponse<AttendanceSummary>);\n    });\n\n    renderWithProviders(<ReportsPage />);\n    await screen.findByText(/John Doe/i);\n\n    // Get search input and focus it\n    const searchInput = screen.getByRole(\"textbox\");\n\n    // Type something and hit enter mapped directly onto the element\n    await user.type(searchInput, \"John{Enter}\");\n\n    // The Drawer should open up for John Doe\n    const sheetPanel = await screen.findByTestId(\"sheet-panel\");\n    expect(sheetPanel).toBeInTheDocument();\n\n    // Ensure the input has lost focus\n    expect(searchInput).not.toHaveFocus();\n\n    // Check if we can switch tabs via ArrowRight (since focus is no longer on input)\n    const dailyToggle = await screen.findByRole(\"button\", { name: /Daily|Chi tiết/i });\n    const rawLogsToggle = await screen.findByRole(\"button\", { name: /View Raw Logs|Nhật ký thô/i });\n\n    expect(dailyToggle.className).toContain(\"text-primary-600\");\n\n    // Simulate ArrowRight\n    fireEvent.keyDown(window, { key: \"ArrowRight\" });\n\n    // Tab should switch\n    await waitFor(() => {\n      expect(rawLogsToggle.className).toContain(\"text-primary-600\");\n    });\n  });\n \n\n  it(\"navigates with ArrowDown and opens the second employee when pressing Enter\", async () => {\n    const user = userEvent.setup();\n    const mockDailyRow = {\n      employee_id: \"emp-2\",\n      employee_name: \"Jane Smith\",\n      date: \"2026-01-15\",\n      actual_punch_in: \"2026-01-15T01:00:00Z\",\n      actual_punch_out: \"2026-01-15T10:00:00Z\",\n      scheduled_start: \"08:00:00\",\n      scheduled_end: \"17:00:00\",\n      break_duration_minutes: 60,\n      break_start: null,\n      break_end: null,\n      is_break_auto_deduct: false,\n      std_work_units: 480,\n      ot_work_units: 0,\n      status: \"present\",\n      generation_metadata: null,\n \n    };\n    vi.mocked(api.fetchAttendanceReport).mockImplementation(({ type }) => {\n      if (type === \"daily\") return Promise.resolve({ data: [mockDailyRow], total: 1, page: 1, limit: 50 } as unknown as PaginatedResponse<DailyAttendanceReport>);\n      return Promise.resolve({\n        data: [\n          { employee_id: \"emp-1\", employee_name: \"John Doe\", total_std_units: 440, total_ot_units: 40, total_leave_days: 0 },\n          { employee_id: \"emp-2\", employee_name: \"Jane Smith\", total_std_units: 440, total_ot_units: 40, total_leave_days: 0 }\n        ],\n        total: 2,\n        page: 1,\n        limit: 50\n      } as unknown as PaginatedResponse<AttendanceSummary>);\n    });\n\n    renderWithProviders(<ReportsPage />);\n    await screen.findByText(/John Doe/i);\n    await screen.findByText(/Jane Smith/i);\n\n    // Get search input and focus it\n    const searchInput = screen.getByRole(\"textbox\");\n\n    // Clear mocks\n    const scrollSpy = vi.spyOn(window.HTMLElement.prototype, \"scrollIntoView\");\n    scrollSpy.mockClear();\n    window.HTMLElement.prototype.scrollTo = vi.fn();\n\n    // Press ArrowDown to select the second row\n    await user.type(searchInput, \"{ArrowDown}\");\n\n    // Verify scrollIntoView was called smooth/nearest for index 1\n \n    expect(scrollSpy).toHaveBeenCalledWith({ behavior: \"smooth\", block: \"nearest\" });\n\n    // Press ArrowUp to go back to the first row (index 0)\n    scrollSpy.mockClear();\n    await user.type(searchInput, \"{ArrowUp}\");\n\n    // In full-page mode, scrollIntoView is used (no .overflow-auto container)\n    expect(scrollSpy).toHaveBeenCalled();\n\n    // Put it back to index 1 and press Enter\n    await user.type(searchInput, \"{ArrowDown}{Enter}\");\n\n    // The Drawer should open up for Jane Smith (emp-2)\n    const sheetPanel = await screen.findByTestId(\"sheet-panel\");\n    expect(sheetPanel).toBeInTheDocument();\n\n    // Verify the drawer is for Jane Smith by checking the mock data return\n    const expectedName = await screen.findAllByText(/Jane Smith|John Doe/i);\n    expect(expectedName.length).toBeGreaterThan(0);\n  });\n\n  it(\"displays an empty state when no data is returned\", async () => {\n \n    vi.mocked(api.fetchAttendanceReport).mockImplementation(() => {\n      return Promise.resolve({ data: [], total: 0, page: 1, limit: 50 } as unknown as PaginatedResponse<AttendanceSummary>);\n    });\n\n    renderWithProviders(<ReportsPage />);\n\n    // The Reports.messages.no_data localized string or empty graphic should appear\n    // We could search for the text or the svg icon class\n    const emptyStateTitle = await screen.findByText(/NO DATA|Không có dữ liệu/i);\n    expect(emptyStateTitle).toBeInTheDocument();\n  });\n\n  it(\"renders cross-navigation link to raw logs with preserved date range\", async () => {\n    renderWithProviders(<ReportsPage />);\n    // Using string matching that is case-insensitive and covers both EN and VI since i18n isn't mocked the same way\n    const link = await screen.findByRole(\"link\", { name: /View Raw Logs|Xem nhật ký thô|REPORTS\\.VIEW_RAW_LOGS/i });\n \n    expect(link).toBeDefined();\n\n    const now = new Date();\n    const lastMonth = new Date(now.getFullYear(), now.getMonth() - 1, 1);\n    const lastMonthEnd = new Date(now.getFullYear(), now.getMonth(), 0);\n    const pad = (n: number) => String(n).padStart(2, '0');\n    const fromString = `${lastMonth.getFullYear()}-${pad(lastMonth.getMonth() + 1)}-01`;\n    const toString_ = `${lastMonthEnd.getFullYear()}-${pad(lastMonthEnd.getMonth() + 1)}-${pad(lastMonthEnd.getDate())}`;\n\n    expect(link.getAttribute(\"href\")).toBe(`/attendance-logs?from=${fromString}&to=${toString_}`);\n  });\n  it(\"filters the report by selected department\", async () => {\n    const user = userEvent.setup();\n    // Setup specific mock for departments\n    vi.mocked(api.fetchDepartments).mockResolvedValue([\n      { id: \"dept-1\", name: \"Engineering\", workspace_id: \"test-ws-id\", created_at: \"2025-01-01T00:00:00Z\", updated_at: \"2025-01-01T00:00:00Z\", active_employee_count: 0 },\n      { id: \"dept-2\", name: \"HR\", workspace_id: \"test-ws-id\", created_at: \"2025-01-01T00:00:00Z\", updated_at: \"2025-01-01T00:00:00Z\", active_employee_count: 0 }\n    ]);\n \n\n    renderWithProviders(<ReportsPage />);\n\n    // Wait for the department chips to render\n    const engineeringChip = await screen.findByRole(\"button\", { name: /Engineering/i });\n    expect(engineeringChip).toBeDefined();\n\n    // Click the Engineering chip\n    await user.click(engineeringChip);\n\n    // Verify fetchAttendanceReport is called with department_id=\"dept-1\" (9th arg, index 8)\n    await waitFor(() => {\n      const calls = vi.mocked(api.fetchAttendanceReport).mock.calls;\n      const latestCall = calls[calls.length - 1];\n      expect(latestCall[0].departmentId).toBe(\"dept-1\");\n    });\n\n    // Verify that clicking \"All\" clears the department filter (null is passed)\n    const allChip = await screen.findByRole(\"button\", { name: /all|tất cả/i });\n \n    await user.click(allChip);\n\n    await waitFor(() => {\n      const calls = vi.mocked(api.fetchAttendanceReport).mock.calls;\n      const latestCall = calls[calls.length - 1];\n      expect(latestCall[0].departmentId).toBeNull();\n    });\n \n  });\n\n  it(\"sorts by OT hours when clicking OT column header\", async () => {\n    const user = userEvent.setup();\n    void i18n.changeLanguage(\"en\");\n    renderWithProviders(<ReportsPage />);\n    await screen.findByText(/John Doe/i);\n\n \n    // Find the OT Hours column header — text is \"Overtime\" (en) inside a flex div with SVG icon\n \n    const otHeaderText = screen.getByText((content, element) => {\n      return element?.tagName.toLowerCase() === \"div\" && /Overtime|Tăng ca/i.test(content);\n    });\n    const otClickTarget = otHeaderText.closest(\"th\") ?? otHeaderText;\n\n    // Clear mock calls so we only see calls triggered by the click\n    vi.mocked(api.fetchAttendanceReport).mockClear();\n\n    // Click OT header — should sort desc first (default for numeric)\n    await user.click(otClickTarget);\n\n    await waitFor(() => {\n      const calls = vi.mocked(api.fetchAttendanceReport).mock.calls;\n      const sortedCall = calls.find((c) => c[0].sort === \"ot_hours_desc\");\n      expect(sortedCall).toBeDefined();\n    });\n\n    // Click again — should toggle to asc\n    await user.click(otClickTarget);\n\n \n    await waitFor(() => {\n      const calls = vi.mocked(api.fetchAttendanceReport).mock.calls;\n      const sortedCall = calls.find((c) => c[0].sort === \"ot_hours_asc\");\n      expect(sortedCall).toBeDefined();\n    });\n  });\n \n\n \n  it(\"renders total hours column and sorts by total hours\", async () => {\n    const user = userEvent.setup();\n    void i18n.changeLanguage(\"en\");\n    renderWithProviders(<ReportsPage />);\n    await screen.findByText(/John Doe/i);\n\n    // Total hours = 440 std + 40 ot = 480 units = 480h (with work_unit_minutes=60)\n    expect(screen.getByTitle(\"480 total units\")).toBeInTheDocument();\n \n\n \n    // Find the Total Hours column header\n    const totalHeader = screen.getByText((content, element) => {\n      return element?.tagName.toLowerCase() === \"div\" && /Total Hours|Tổng giờ công/i.test(content);\n    });\n    const totalClickTarget = totalHeader.closest(\"th\") ?? totalHeader;\n\n \n    vi.mocked(api.fetchAttendanceReport).mockClear();\n\n    // Click header — should sort desc first\n    await user.click(totalClickTarget);\n\n    await waitFor(() => {\n      const calls = vi.mocked(api.fetchAttendanceReport).mock.calls;\n      const sortedCall = calls.find((c) => c[0].sort === \"total_hours_desc\");\n      expect(sortedCall).toBeDefined();\n    });\n\n    // Click again — toggle to asc\n    await user.click(totalClickTarget);\n\n    await waitFor(() => {\n      const calls = vi.mocked(api.fetchAttendanceReport).mock.calls;\n      const sortedCall = calls.find((c) => c[0].sort === \"total_hours_asc\");\n      expect(sortedCall).toBeDefined();\n    });\n  });\n\n  it(\"renders department chips with wrapping layout\", async () => {\n    vi.mocked(api.fetchDepartments).mockResolvedValue([\n      { id: \"dept-1\", name: \"Engineering\", workspace_id: \"test-ws-id\", created_at: \"2025-01-01T00:00:00Z\", updated_at: \"2025-01-01T00:00:00Z\", active_employee_count: 0 },\n      { id: \"dept-2\", name: \"HR\", workspace_id: \"test-ws-id\", created_at: \"2025-01-01T00:00:00Z\", updated_at: \"2025-01-01T00:00:00Z\", active_employee_count: 0 },\n      { id: \"dept-3\", name: \"Design\", workspace_id: \"test-ws-id\", created_at: \"2025-01-01T00:00:00Z\", updated_at: \"2025-01-01T00:00:00Z\", active_employee_count: 0 }\n    ]);\n\n    renderWithProviders(<ReportsPage />);\n\n    const chipsContainer = await screen.findByTestId(\"department-chips\");\n    \n    // Verify wrap class is present\n    expect(chipsContainer.className).toContain(\"flex-wrap\");\n    \n    // Verify overflow-x-auto is removed\n    expect(chipsContainer.className).not.toContain(\"overflow-x-auto\");\n    expect(chipsContainer.className).not.toContain(\"scrollbar-thin\");\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/__tests__/shift-swaps-page.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/__tests__/shifts-page.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/__tests__/system-roles-page.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/__tests__/worker-monitor-page.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/__tests__/working-patterns-page.test.tsx","messages":[{"ruleId":"@typescript-eslint/no-unnecessary-type-conversion","severity":2,"message":"Using !! on a boolean does not change the type or value of the boolean.","line":51,"column":10,"nodeType":null,"messageId":"unnecessaryTypeConversion","endLine":51,"endColumn":12,"suggestions":[{"messageId":"suggestRemove","fix":{"range":[1679,1689],"text":"multiple"},"desc":"Remove the type conversion."},{"messageId":"suggestSatisfies","data":{"type":"boolean"},"fix":{"range":[1679,1689],"text":"(multiple satisfies boolean)"},"desc":"Instead, assert that the value satisfies the boolean type."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { QueryClient, QueryClientProvider } from \"@tanstack/react-query\";\nimport { render, screen, waitFor, within } from \"@testing-library/react\";\nimport React from \"react\";\n\nimport userEvent from \"@testing-library/user-event\";\nimport { describe, it, expect, vi, beforeEach } from \"vitest\";\n\nimport * as api from \"../../lib/api\";\nimport { WorkingPattern, Shift } from \"../../lib/api/types\";\nimport WorkingPatternsPage from \"../working-patterns-page\";\n\n\n// Mock TanStack Router\nvi.mock(\"@tanstack/react-router\", () => ({\n  useNavigate: () => vi.fn(),\n \n  useLocation: () => ({ pathname: \"/\", search: \"\", hash: \"\" }),\n  Link: ({ to, children, ...props }: { to: string; children: React.ReactNode }) => <a href={to} {...props}>{children}</a>,\n}));\n\n// Mock API\nvi.mock(\"../../lib/api\", () => ({\n  fetchWorkingPatterns: vi.fn(),\n  createWorkingPattern: vi.fn(),\n  fetchPatternDetails: vi.fn(),\n  fetchShifts: vi.fn(),\n  fetchEmployees: vi.fn(),\n  bulkAssignPattern: vi.fn(),\n  getCurrentWorkspaceId: vi.fn(),\n}));\n\n// Mock EmployeeSearch\n \nvi.mock(\"@/components/common/employee-search\", () => ({\n  EmployeeSearch: ({ value, onChange, onSelect, multiple }: { value: unknown; onChange: (_v: unknown) => void; onSelect: (_v: unknown) => void; multiple: boolean }) => {\n    const handler = onSelect || onChange || (() => { /* empty */ });\n    return (\n      <div data-testid=\"employee-search-mock\">\n        <button \n          onClick={() => {\n            if (multiple) {\n              handler([\"emp-1\", \"emp-2\"]);\n            } else {\n              handler(\"emp-1\");\n            }\n          }}\n          type=\"button\"\n        >\n          Select Employees Mock\n        </button>\n        {!!multiple && Array.isArray(value) && value.includes(\"emp-1\") && <span>Selected: John Doe</span>}\n      </div>\n    );\n  }\n}));\n\n// Mock Toast\nconst mockToastSuccess = vi.fn();\nconst mockToastError = vi.fn();\nvi.mock(\"../../components/ui/toast\", () => ({\n  useToast: () => ({\n    success: mockToastSuccess,\n    error: mockToastError,\n    warning: vi.fn(),\n  }),\n}));\n\n// Override i18n\nvi.mock('react-i18next', () => ({\n \n  useTranslation: () => ({\n    t: (key: string, options?: Record<string, unknown>) => {\n        if (key === \"patterns.messages.bulk_assign_success_count\") return `Success: ${String((options?.count as string | number) ?? \"\")}`;\n        if (key === \"patterns.messages.bulk_assign_conflict\") return `Conflict: ${String((options?.count as string | number) ?? \"\")}`;\n        return key;\n    },\n    i18n: {\n      changeLanguage: () => Promise.resolve(),\n      language: 'en',\n    },\n  }),\n}));\n\ndescribe(\"WorkingPatternsPage\", () => {\n  let queryClient: QueryClient;\n\n  beforeEach(() => {\n    vi.clearAllMocks();\n    queryClient = new QueryClient({\n      defaultOptions: {\n        queries: { retry: false, gcTime: 0, staleTime: 0 },\n      },\n \n    });\n \n    vi.mocked(api.getCurrentWorkspaceId).mockReturnValue(\"ws-1\");\n    vi.mocked(api.fetchWorkingPatterns).mockResolvedValue([\n      { id: \"pat-1\", name: \"Standard Office\", description: \"Mon-Fri\", is_active: true }\n \n    ] as unknown as WorkingPattern[]);\n    vi.mocked(api.fetchShifts).mockResolvedValue([\n      { id: \"shift-1\", name: \"Morning\", start_time: \"08:00\", end_time: \"17:00\" }\n \n    ] as unknown as Shift[]);\n    vi.mocked(api.fetchEmployees).mockResolvedValue({\n      data: [\n        { id: \"emp-1\", full_name: \"John Doe\", employee_id_number: \"EMP001\", workspace_id: \"ws-1\", is_active: true, hire_date: \"2025-01-01\", created_at: \"2025-01-01T00:00:00Z\", updated_at: \"2025-01-01T00:00:00Z\" },\n        { id: \"emp-2\", full_name: \"Jane Smith\", employee_id_number: \"EMP002\", workspace_id: \"ws-1\", is_active: true, hire_date: \"2025-01-02\", created_at: \"2025-01-02T00:00:00Z\", updated_at: \"2025-01-02T00:00:00Z\" }\n      ],\n      total: 2,\n      page: 1,\n      limit: 50,\n \n    });\n    vi.mocked(api.fetchPatternDetails).mockResolvedValue([]);\n  });\n\n  it(\"renders patterns list\", async () => {\n    render(\n      <QueryClientProvider client={queryClient}>\n        <WorkingPatternsPage />\n      </QueryClientProvider>\n    );\n\n    expect(await screen.findByText(\"Standard Office\")).toBeDefined();\n    expect(screen.getByText(\"Mon-Fri\")).toBeDefined();\n  });\n\n  it(\"opens create modal and submits new pattern\", async () => {\n \n    const user = userEvent.setup();\n    vi.mocked(api.createWorkingPattern).mockResolvedValue({ id: \"pat-new\" } as unknown as WorkingPattern);\n\n    render(\n      <QueryClientProvider client={queryClient}>\n        <WorkingPatternsPage />\n      </QueryClientProvider>\n    );\n\n    await user.click(screen.getByText(/patterns.create_btn/i));\n\n    const nameInput = await screen.findByPlaceholderText(/patterns.form.name_placeholder/i);\n    await user.type(nameInput, \"New Rotation\");\n    await user.click(screen.getByText(/patterns.form.prefill_standard/i));\n    await user.click(screen.getByText(/patterns.modal.submit_btn/i));\n\n    await waitFor(() => {\n      expect(api.createWorkingPattern).toHaveBeenCalled();\n    }, { timeout: 20000 });\n  }, 30000);\n\n  it(\"opens bulk assign modal and handles success response\", async () => {\n    const user = userEvent.setup();\n \n    // Mock Success Response\n    vi.mocked(api.bulkAssignPattern).mockResolvedValue({\n        success_count: 2,\n        failed_employees: []\n    });\n\n    render(\n      <QueryClientProvider client={queryClient}>\n        <WorkingPatternsPage />\n      </QueryClientProvider>\n    );\n\n    // Open Modal\n    await user.click(screen.getByText(/patterns.bulk_assign_btn/i));\n\n    // Select Pattern\n    const dialog = await screen.findByRole(\"dialog\");\n    const patternOption = await within(dialog).findByText(\"Standard Office\", { selector: 'span' });\n    await user.click(patternOption.closest(\"button\")!);\n\n    // Select Employees (using mock button)\n    await user.click(screen.getByText(\"Select Employees Mock\"));\n\n    // Submit\n    await user.click(screen.getByText(/patterns.modal.assign_btn/i));\n\n    await waitFor(() => {\n      expect(api.bulkAssignPattern).toHaveBeenCalledWith(\n        \"ws-1\",\n        expect.objectContaining({\n          employee_ids: [\"emp-1\", \"emp-2\"],\n          pattern_id: \"pat-1\"\n        })\n      );\n    });\n\n    // Check Toast Success Message\n    expect(mockToastSuccess).toHaveBeenCalledWith(\"Success: 2\");\n  });\n\n  it(\"opens bulk assign modal and handles conflict error\", async () => {\n    const user = userEvent.setup();\n \n    // Mock Conflict Response\n    vi.mocked(api.bulkAssignPattern).mockResolvedValue({\n        success_count: 0,\n        failed_employees: [\"emp-1\"]\n    });\n\n    render(\n      <QueryClientProvider client={queryClient}>\n        <WorkingPatternsPage />\n      </QueryClientProvider>\n    );\n\n    // Open Modal\n    await user.click(screen.getByText(/patterns.bulk_assign_btn/i));\n\n    // Select Pattern\n    const dialog = await screen.findByRole(\"dialog\");\n    const patternOption = await within(dialog).findByText(\"Standard Office\", { selector: 'span' });\n    await user.click(patternOption.closest(\"button\")!);\n\n    // Select Employees\n    await user.click(screen.getByText(\"Select Employees Mock\"));\n\n    // Submit\n    await user.click(screen.getByText(/patterns.modal.assign_btn/i));\n\n    await waitFor(() => {\n        expect(api.bulkAssignPattern).toHaveBeenCalled();\n    });\n\n    // Check Toast Error Message\n    expect(mockToastError).toHaveBeenCalledWith(\"Conflict: 1\");\n  });\n});","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/__tests__/workspace-danger-page.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/__tests__/workspace-overview-page.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/__tests__/workspace-permissions-page.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/__tests__/workspace-roles-page.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/approvals/components/ot-approvals-filters.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/approvals/components/ot-approvals-header.tsx","messages":[],"suppressedMessages":[],"errorCount"