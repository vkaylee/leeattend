50/40 text-teal-600 dark:text-teal-400 flex items-center justify-center shadow-sm border border-teal-100 dark:border-teal-800\">\n            <Shield size={16} />\n          </div>\n          <div>\n            <h3 className=\"font-bold text-sm uppercase tracking-widest text-slate-700 dark:text-slate-200 leading-none\">\n              {t(\"payroll_rules.rule_assignments\", \"Rule Assignments\")}\n            </h3>\n            <p className=\"text-[10px] text-slate-500 dark:text-slate-400 uppercase tracking-widest mt-1 opacity-70\">\n              {totalCount} active{\" \"}\n              {totalCount === 1 ? \"assignment\" : \"assignments\"} across all scopes\n            </p>\n          </div>\n        </div>\n        <button\n          className=\"flex items-center gap-2 bg-teal-600 hover:bg-teal-700 text-white px-5 py-2.5 rounded-xl font-bold text-[10px] uppercase tracking-widest transition-all shadow-lg shadow-teal-100 dark:shadow-black/30 active:scale-95\"\n          onClick={() => { setIsModalOpen(true); }}\n        >\n          <Plus size={14} /> {t(\"common.assign\", \"Assign\")}\n        </button>\n      </div>\n\n      {/* Loading state */}\n      {!!isLoading && (\n        <div className=\"p-12 flex justify-center\">\n          <div className=\"w-8 h-8 border-[3px] border-teal-600 border-t-transparent rounded-full animate-spin\" />\n        </div>\n      )}\n\n      {/* Empty state */}\n      {!isLoading && totalCount === 0 && (\n        <div className=\"p-12 bg-slate-50 dark:bg-slate-800/30 rounded-2xl border-2 border-dashed border-slate-100 dark:border-slate-800 flex flex-col items-center gap-3\">\n          <div className=\"w-14 h-14 bg-white dark:bg-slate-900 rounded-2xl flex items-center justify-center shadow-sm border border-slate-100 dark:border-slate-800\">\n            <Users className=\"text-slate-200 dark:text-slate-700\" size={24} />\n          </div>\n          <p className=\"text-[10px] font-bold text-slate-300 dark:text-slate-600 uppercase tracking-widest\">\n            {t(\n              \"payroll.no_assignments_yet\",\n              \"No assignments yet — click 'Assign' to get started\"\n            )}\n          </p>\n        </div>\n      )}\n\n      {/* Assignment cards by scope */}\n      {!isLoading && totalCount > 0 && (\n        <AssignmentList\n          deptMap={deptMap}\n          grouped={grouped}\n          isDeleting={deleteMutation.isPending}\n          onDelete={(id) => { deleteMutation.mutate(id); }}\n        />\n      )}\n\n      {/* Create Assignment Modal */}\n      <AssignmentFormModal\n        calculationMethod={calculationMethod}\n        departments={departments}\n        isOpen={isModalOpen}\n        isSubmitting={createMutation.isPending}\n        onClose={() => { setIsModalOpen(false); }}\n        onSubmit={handleCreate}\n        wsId={wsId}\n      />\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/payroll/rule-assignment/__tests__/use-rule-assignments.test.tsx","messages":[{"ruleId":"react/display-name","severity":2,"message":"Component definition is missing display name","line":41,"column":12,"nodeType":"ArrowFunctionExpression","messageId":"noDisplayName","endLine":43,"endColumn":6}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { QueryClient, QueryClientProvider } from \"@tanstack/react-query\";\nimport { renderHook, waitFor } from \"@testing-library/react\";\n\nimport { describe, it, expect, vi, beforeEach } from \"vitest\";\n\nimport * as departmentsApi from \"@/lib/api/departments\";\nimport * as payrollApi from \"@/lib/api/payroll\";\n\nimport { useRuleAssignments } from \"../use-rule-assignments\";\n\n// --- Mocks ---\nvi.mock(\"@/lib/api/payroll\");\nvi.mock(\"@/lib/api/departments\");\n\nvi.mock(\"react-i18next\", () => ({\n  useTranslation: () => ({\n    t: (key: string, fallback?: string) => fallback ?? key,\n  }),\n}));\n\nconst mockToastSuccess = vi.fn();\nconst mockToastError = vi.fn();\nvi.mock(\"@/components/ui/toast\", () => ({\n  useToast: () => ({\n    success: mockToastSuccess,\n    error: mockToastError,\n  }),\n}));\n\ndescribe(\"useRuleAssignments\", () => {\n  let queryClient: QueryClient;\n\n  beforeEach(() => {\n    queryClient = new QueryClient({\n      defaultOptions: { queries: { retry: false } },\n    });\n    vi.clearAllMocks();\n  });\n\n  const getWrapper = () => {\n    return ({ children }: { children: React.ReactNode }) => (\n      <QueryClientProvider client={queryClient}>{children}</QueryClientProvider>\n    );\n  };\n\n  it(\"fetches and groups assignments correctly\", async () => {\n    vi.mocked(payrollApi.fetchPayrollRuleAssignments).mockResolvedValueOnce([\n      {\n        id: \"a-1\",\n        workspace_id: \"ws-1\",\n        rule_definition_id: \"rule-1\",\n        assignee_type: \"workspace\",\n        assignee_id: null,\n        effective_from: \"2026-01-01\",\n        created_at: \"2026-01-01T00:00:00Z\",\n      },\n      {\n        id: \"a-2\",\n        workspace_id: \"ws-1\",\n        rule_definition_id: \"rule-1\",\n        assignee_type: \"department\",\n        assignee_id: \"dept-1\",\n        effective_from: \"2026-02-01\",\n        override_config: { rate: 10, base: \"gross\" },\n        created_at: \"2026-02-01T00:00:00Z\",\n      },\n    ]);\n\n    vi.mocked(departmentsApi.fetchDepartments).mockResolvedValueOnce([\n      {\n        id: \"dept-1\",\n        workspace_id: \"ws-1\",\n        name: \"Engineering\",\n        active_employee_count: 5,\n        created_at: \"\",\n        updated_at: \"\",\n      },\n    ]);\n\n    const { result } = renderHook(() => useRuleAssignments(\"ws-1\", \"rule-1\"), {\n      wrapper: getWrapper(),\n    });\n\n    await waitFor(() => {\n      expect(result.current.isLoading).toBe(false);\n    });\n\n    expect(result.current.assignments).toHaveLength(2);\n    expect(result.current.totalCount).toBe(