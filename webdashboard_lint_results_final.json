ame=\"w-full px-5 py-4 bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-bold text-sm tracking-tight\" onChange={(e) =>\n            { setFormData({ ...formData, date: e.target.value }); }\n          } required type=\"date\" value={formData.date}\n        />\n      </div>\n\n      <div className=\"grid grid-cols-2 gap-6\">\n        <div className=\"space-y-2\">\n          <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">\n            {t(\"common.punch_in\")}\n          </label>\n          <input\n            className=\"w-full px-5 py-4 bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-mono font-bold text-sm text-center\"\n            onChange={(e) =>\n              { setFormData({ ...formData, punchIn: e.target.value }); }\n            }\n            required\n            type=\"time\"\n            value={formData.punchIn}\n          />\n        </div>\n        <div className=\"space-y-2\">\n          <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">\n            {t(\"common.punch_out\")}\n          </label>\n          <input\n            className=\"w-full px-5 py-4 bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-mono font-bold text-sm text-center\"\n            onChange={(e) =>\n              { setFormData({ ...formData, punchOut: e.target.value }); }\n            }\n            required\n            type=\"time\"\n            value={formData.punchOut}\n          />\n        </div>\n      </div>\n\n      <div className=\"flex items-center gap-4 py-2 bg-slate-50 dark:bg-slate-800/50 p-4 rounded-[1.5rem] border border-slate-100 dark:border-slate-800 shadow-inner\">\n        <input\n          checked={formData.isBreakOvertime}\n          className=\"w-6 h-6 text-primary-600 dark:text-primary-400 rounded-xl border-slate-200 dark:border-slate-700 focus:ring-primary-500 transition-all cursor-pointer\"\n          id=\"is_break_overtime\"\n          onChange={(e) =>\n            { setFormData({ ...formData, isBreakOvertime: e.target.checked }); }\n          }\n          type=\"checkbox\"\n        />\n        <label\n          className=\"text-xs font-bold text-slate-700 dark:text-slate-200 uppercase tracking-widest cursor-pointer leading-tight\"\n          htmlFor=\"is_break_overtime\"\n        >\n          {t(\"attendance_confirm.ot_label\")}\n        </label>\n      </div>\n\n      <div className=\"space-y-2\">\n        <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">\n          {t(\"time_tracking.modal.reason_label\")}\n        </label>\n        <textarea\n          className=\"w-full px-5 py-4 bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-medium text-sm h-28 resize-none\"\n          onChange={(e) =>\n            { setFormData({ ...formData, reason: e.target.value }); }\n          }\n          placeholder={t(\"time_tracking.modal.reason_placeholder\")}\n          required\n          value={formData.reason}\n        />\n      </div>\n    </>\n  );\n}\n\nexport function AdjustmentRequestModal({\n  isOpen,\n  onClose,\n  timeEntry,\n  onSubmit,\n  timezone: _timezone\n}: AdjustmentRequestModalProps) {\n  const { t } = useTranslation();\n  const { formatTime24h } = useDateTimeFormatter();\n  const [isSubmitting, setIsSubmitting] = useState(false);\n\n  const [formData, setFormData] = useState<AdjustmentData>({\n    date: timeEntry\n      ? format(new Date(timeEntry.punch_in_time), \"yyyy-MM-dd\")\n      : format(new Date(), \"yyyy-MM-dd\"),\n    punchIn: timeEntry\n      ? formatTime24h(timeEntry.punch_in_time)\n      : \"08:00\",\n    punchOut: timeEntry?.punch_out_time\n      ? formatTime24h(timeEntry.punch_out_time)\n      : \"17:00\",\n    reason: \"\",\n    isBreakOvertime: timeEntry?.is_break_overtime ?? false,\n    timeEntryId: timeEntry?.id\n  });\n\n  const handleSubmit = async (e: React.SyntheticEvent) => {\n    e.preventDefault();\n    setIsSubmitting(true);\n    try {\n      await onSubmit(formData);\n      onClose();\n    } catch (error) {\n      console.error(\"Failed to submit adjustment:\", error);\n    } finally {\n      setIsSubmitting(false);\n    }\n  };\n\n  return (\n    <Modal\n      icon={<History size={24} />}\n      isOpen={isOpen}\n      maxWidth=\"md\"\n      onClose={onClose}\n      subtitle={t(\"time_tracking.modal.subtitle\")}\n      title={\n        formData.timeEntryId\n          ? t(\"time_tracking.modal.edit_title\")\n          : t(\"time_tracking.modal.new_title\")\n      }\n    >\n      <form className=\"space-y-8 pt-4\" onSubmit={handleSubmit}>\n        <AdjustmentFormFields formData={formData} setFormData={setFormData} t={t} />\n\n        <div className=\"pt-6 grid grid-cols-2 gap-5\">\n          <button\n            className=\"px-8 py-4 border border-slate-100 dark:border-slate-800 rounded-2xl font-bold text-xs uppercase tracking-widest text-slate-500 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-all\"\n            onClick={onClose}\n            type=\"button\"\n          >\n            {t(\"common.cancel\")}\n          </button>\n          <button\n            className=\"px-8 py-4 bg-slate-900 text-white rounded-2xl font-bold text-xs uppercase tracking-widest hover:bg-primary-700 transition-all shadow-xl shadow-slate-200 dark:shadow-black/30 active:scale-95 disabled:opacity-50\"\n            disabled={isSubmitting}\n            type=\"submit\"\n          >\n            {isSubmitting ? t(\"common.sending\").toUpperCase() : t(\"common.submit_request\")}\n          </button>\n        </div>\n      </form>\n    </Modal>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/time-tracking/punch-card.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/time-tracking/time-entry-row.tsx","messages":[{"ruleId":"@typescript-eslint/no-unnecessary-type-conversion","severity":2,"message":"Using !! on a boolean does not change the type or value of the boolean.","line":63,"column":8,"nodeType":null,"messageId":"unnecessaryTypeConversion","endLine":63,"endColumn":10,"suggestions":[{"messageId":"suggestRemove","fix":{"range":[2400,2418],"text":"showAdjustButton"},"desc":"Remove the type conversion."},{"messageId":"suggestSatisfies","data":{"type":"boolean"},"fix":{"range":[2400,2418],"text":"(showAdjustButton satisfies boolean)"},"desc":"Instead, assert that the value satisfies the boolean type."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useTranslation } from \"react-i18next\";\n\nimport { useDateTimeFormatter } from \"@/hooks/use-datetime\";\nimport { TimeEntry } from \"@/lib/api\";\nimport { cn } from \"@/lib/utils\";\n\ninterface TimeEntryRowProps {\n  entry: TimeEntry;\n  onAdjust?: (entry: TimeEntry) => void;\n  showAdjustButton?: boolean;\n}\n\nexport function TimeEntryRow({\n  entry,\n  onAdjust,\n  showAdjustButton = false\n}: TimeEntryRowProps) {\n  const { t } = useTranslation();\n  const { formatDate, formatTime } = useDateTimeFormatter();\n\n  return (\n    <tr className=\"hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-all group\">\n      <td className=\"px-8 py-5\">\n        <div className=\"flex items-center gap-3\">\n          <span className=\"text-sm font-bold text-slate-700 dark:text-slate-200\">\n            {formatDate(entry.punch_in_time)}\n          </span>\n          <span\n            className={cn(\n              \"px-2 py-0.5 rounded-lg text-[8px] font-bold uppercase tracking-tighter border\",\n              entry.entry_type === \"break\"\n                ? \"bg-amber-50 dark:bg-amber-950 text-amber-600 dark:text-amber-300 border-amber-100 dark:border-amber-800\"\n                : \"bg-primary-50 dark:bg-primary-950 text-primary-600 dark:text-primary-400 border-primary-100 dark:border-primary-800\"\n            )}\n          >\n            {entry.entry_type === \"break\" ? t(\"common.break\") : t(\"common.work\")}\n          </span>\n        </div>\n      </td>\n      <td className=\"px-8 py-5 text-xs font-bold text-slate-500 dark:text-slate-400 font-mono\">\n        {formatTime(entry.punch_in_time)}\n      </td>\n      <td className=\"px-8 py-5\">\n        {entry.punch_out_time ? (\n          <span className=\"text-xs font-bold text-slate-500 dark:text-slate-400 font-mono\">\n            {formatTime(entry.punch_out_time)}\n          </span>\n        ) : (\n          <span\n            className={cn(\n              \"font-bold px-2 py-1 rounded-lg text-[9px] uppercase tracking-tighter animate-pulse\",\n              entry.entry_type === \"break\"\n                ? \"text-amber-600 dark:text-amber-300 bg-amber-50 dark:bg-amber-950\"\n                : \"text-primary-600 dark:text-primary-400 bg-primary-50 dark:bg-primary-950\"\n            )}\n          >\n            {entry.entry_type === \"break\"\n              ? t(\"time_tracking.status.on_break\")\n              : t(\"time_tracking.status.working\")}\n          </span>\n        )}\n      </td>\n      {!!showAdjustButton && (\n        <td className=\"px-8 py-5 text-right\">\n          <button\n            className=\"text-primary-600 dark:text-primary-400 bg-white dark:bg-slate-900 shadow-sm border border-slate-100 dark:border-slate-800 hover:bg-primary-50 dark:bg-primary-950 px-4 py-1.5 rounded-xl transition-all font-bold text-[10px] uppercase tracking-widest active:scale-90 opacity-0 group-hover:opacity-100\"\n            onClick={() => onAdjust?.(entry)}\n          >\n            {t(\"common.adjust\")}\n          </button>\n        </td>\n      )}\n    </tr>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/ui/__tests__/confirm-dialog.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/ui/__tests__/language-switcher.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/ui/__tests__/sheet.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/ui/button.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/ui/button.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/ui/combobox-auto-focus.test.tsx","messages":[{"ruleId":"react/jsx-no-comment-textnodes","severity":2,"message":"Comments inside children section of tag should be placed inside braces","line":15,"column":7,"nodeType":"JSXText","messageId":"putCommentInBraces","endLine":18,"endColumn":7},{"ruleId":"react/jsx-no-comment-textnodes","severity":2,"message":"Comments inside children section of tag should be placed inside braces","line":21,"column":13,"nodeType":"JSXText","messageId":"putCommentInBraces","endLine":23,"endColumn":5}],"suppressedMessages":[{"ruleId":"jsx-a11y/click-events-have-key-events","severity":2,"message":"Visible, non-interactive elements with click handlers must have at least one keyboard listener.","line":19,"column":7,"nodeType":"JSXOpeningElement","endLine":19,"endColumn":94,"suppressions":[{"kind":"directive","justification":""}]},{"ruleId":"jsx-a11y/no-static-element-interactions","severity":2,"message":"Avoid non-native interactive elements. If using native HTML is not possible, add an appropriate role and support for tabbing, mouse, keyboard, and touch inputs to an interactive content element.","line":19,"column":7,"nodeType":"JSXOpeningElement","endLine":19,"endColumn":94,"suppressions":[{"kind":"directive","justification":""}]},{"ruleId":"jsx-a11y/no-autofocus","severity":2,"message":"The autoFocus prop should not be used, as it can reduce usability and accessibility for users.","line":65,"column":22,"nodeType":"JSXAttribute","endLine":65,"endColumn":38,"suppressions":[{"kind":"directive","justification":""}]},{"ruleId":"jsx-a11y/no-autofocus","severity":2,"message":"The autoFocus prop should not be used, as it can reduce usability and accessibility for users.","line":182,"column":9,"nodeType":"JSXAttribute","endLine":182,"endColumn":25,"suppressions":[{"kind":"directive","justification":""}]}],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { render, screen, fireEvent } from \"@testing-library/react\";\nimport React from \"react\";\n\nimport { Command } from \"cmdk\";\nimport { describe, it, expect, vi, beforeEach } from \"vitest\";\n\nvi.unmock(\"@/components/ui/combobox\");\n\nimport { Combobox } from \"./combobox\";\n \n\nvi.mock(\"@radix-ui/react-popover\", () => ({\n  Root: ({ children, open, onOpenChange }: { children: React.ReactNode, open?: boolean, onOpenChange?: (open: boolean) => void }) => (\n \n    <>\n// eslint-disable-next-line jsx-a11y/no-static-element-interactions\n// eslint-disable-next-line jsx-a11y/click-events-have-key-events\n      {/* eslint-disable-next-line jsx-a11y/click-events-have-key-events, jsx-a11y/no-static-element-interactions */}\n      <div data-open={open} data-testid=\"popover-root\" onClick={() => onOpenChange?.(!open)}>\n        {children}\n      </div>\n// eslint-disable-next-line @typescript-eslint/no-explicit-any\n    </>\n \n  ),\n \n  Trigger: ({ children }: { children: React.ReactNode }) => <div data-testid=\"popover-trigger\">{children}</div>,\n  Portal: ({ children }: { children: React.ReactNode }) => <div>{children}</div>,\n  Content: ({ children }: { children: React.ReactNode }) => <div data-testid=\"popover-content\">{children}</div>,\n}));\n\n \nvi.mock(\"cmdk\", () => ({\n  Command: Object.assign(\n    ({ children, value, _onValueChange }: { children: React.ReactNode, value?: string, _onValueChange?: (value_: string) => void }) => (\n      <div data-testid=\"cmdk-root\" data-value={value}>{children}</div>\n \n    ),\n    {\n      Input: vi.fn(({ autoFocus, placeholder }: { autoFocus?: boolean, placeholder?: string }) => (\n \n        <input data-autofocus={autoFocus} data-testid=\"cmdk-input\" placeholder={placeholder} />\n \n      )),\n \n      List: ({ children }: { children: React.ReactNode }) => <div>{children}</div>,\n \n      Empty: ({ children }: { children: React.ReactNode }) => <div>{children}</div>,\n      Group: ({ children }: { children: React.ReactNode }) => <div>{children}</div>,\n      Item: ({ children, value }: { children: React.ReactNode, value?: string }) => <div data-testid={`cmdk-item-${value}`}>{children}</div>,\n    }\n  ),\n}));\n\ndescribe(\"Combobox AutoFocus\", () => {\n  const options = [{ value: \"1\", label: \"Option 1\" }];\n\n  beforeEach(() => {\n    vi.clearAllMocks();\n  });\n \n\n  it(\"starts with popover open when autoFocus is true\", () => {\n    // eslint-disable-next-line jsx-a11y/no-autofocus\n    render(<Combobox autoFocus={true} onChange={() => { /* empty */ }} options={options} />);\n    const root = screen.getByTestId(\"popover-root\");\n    expect(root.getAttribute(\"data-open\")).toBe(\"true\");\n  });\n\n  it(\"always passes autoFocus=true to Command.Input\", () => {\n    render(<Combobox onChange={() => { /* empty */ }} options={options} />);\n    expect(Command.Input).toHaveBeenCalledWith(\n      expect.objectContaining({ autoFocus: true }),\n      undefined\n    );\n  });\n});\n\ndescribe(\"Combobox Keyboard Shortcut\", () => {\n  const options = [\n    { value: \"1\", label: \"Alpha\", description: \"D001\" },\n    { value: \"2\", label: \"Beta\", description: \"D002\" },\n  ];\n\n  beforeEach(() => {\n    vi.clearAllMocks();\n  });\n\n  it(\"opens the popover when keyboard shortcut is pressed\", () => {\n    render(\n      <Combobox\n        keyboardShortcut=\"/\"\n        onChange={() => { /* empty */ }}\n        onSearchChange={() => { /* empty */ }}\n        options={options}\n      />\n    );\n\n    // Initially closed (no autoFocus)\n    const root = screen.getByTestId(\"popover-root\");\n    expect(root.getAttribute(\"data-open\")).toBe(\"false\");\n\n    // Simulate pressing '/' on the document body\n    fireEvent.keyDown(window, { key: \"/\" });\n\n    // Should now be open\n    expect(root.getAttribute(\"data-open\")).toBe(\"true\");\n  });\n\n  it(\"calls onSearchChange with empty string when shortcut is pressed\", () => {\n    const onSearchChange = vi.fn();\n    render(\n      <Combobox\n        keyboardShortcut=\"/\"\n        onChange={() => { /* empty */ }}\n        onSearchChange={onSearchChange}\n        options={options}\n      />\n    );\n\n    fireEvent.keyDown(window, { key: \"/\" });\n    expect(onSearchChange).toHaveBeenCalledWith(\"\");\n  });\n\n  it(\"does NOT trigger shortcut when typing in an input element\", () => {\n    const onSearchChange = vi.fn();\n    render(\n      <div>\n        <input data-testid=\"other-input\" />\n        <Combobox\n          keyboardShortcut=\"/\"\n          onChange={() => { /* empty */ }}\n          onSearchChange={onSearchChange}\n          options={options}\n        />\n      </div>\n    );\n\n    const otherInput = screen.getByTestId(\"other-input\");\n    fireEvent.keyDown(otherInput, { key: \"/\" });\n\n    // Should NOT have been called because the event target is an input\n    expect(onSearchChange).not.toHaveBeenCalled();\n  });\n\n  it(\"handles multiple shortcut keys when passed as an array\", () => {\n    const onSearchChange1 = vi.fn();\n    const { unmount: unmount1 } = render(\n      <Combobox\n        keyboardShortcut={[\"/\", \"Enter\"]}\n        onChange={() => { /* empty */ }}\n        onSearchChange={onSearchChange1}\n        options={options}\n      />\n    );\n\n    // Press Enter\n    fireEvent.keyDown(window, { key: \"Enter\" });\n    expect(onSearchChange1).toHaveBeenCalledTimes(1);\n    unmount1();\n\n    const onSearchChange2 = vi.fn();\n    render(\n      <Combobox\n        keyboardShortcut={[\"/\", \"Enter\"]}\n        onChange={() => { /* empty */ }}\n        onSearchChange={onSearchChange2}\n        options={options}\n      />\n    );\n\n    // Press /\n    fireEvent.keyDown(window, { key: \"/\" });\n    expect(onSearchChange2).toHaveBeenCalledTimes(1);\n  });\n\n  it(\"ignores shortcut keys when the combobox is already open\", () => {\n    const onSearchChange = vi.fn();\n    render(\n      <Combobox\n        // eslint-disable-next-line jsx-a11y/no-autofocus\n        autoFocus={true} // Starts open\n \n        keyboardShortcut=\"Enter\"\n        onChange={() => { /* empty */ }}\n        onSearchChange={onSearchChange}\n        options={options}\n      />\n    );\n\n    const root = screen.getByTestId(\"popover-root\");\n    expect(root.getAttribute(\"data-open\")).toBe(\"true\");\n\n    // Pressing Enter when already open should NOT trigger the shortcut logic\n    // (because cmdk needs to handle the Enter key to select an item)\n    fireEvent.keyDown(window, { key: \"Enter\" });\n\n    // onSearchChange shouldn't be called by the shortcut handler\n    expect(onSearchChange).not.toHaveBeenCalled();\n  });\n\n  it(\"clears the value when clearOnEscape is true and Escape is pressed while closed\", () => {\n    const onChange = vi.fn();\n    const onSearchChange = vi.fn();\n\n    render(\n      <Combobox\n        clearOnEscape={true}\n        onChange={onChange}\n        onSearchChange={onSearchChange}\n        options={options}\n        value=\"1\"\n      />\n    );\n\n    // Initial state is closed\n    const root = screen.getByTestId(\"popover-root\");\n    expect(root.getAttribute(\"data-open\")).toBe(\"false\");\n\n    // Press Escape\n    fireEvent.keyDown(window, { key: \"Escape\" });\n\n    // Both onChange and onSearchChange should be called to reset the value\n    expect(onChange).toHaveBeenCalledWith(\"\");\n    expect(onSearchChange).toHaveBeenCalledWith(\"\");\n  });\n});\n\ndescribe(\"Combobox First Item Highlight\", () => {\n  it(\"sets Command value to first item's cmdk value\", () => {\n    const options = [\n      { value: \"emp-1\", label: \"Alice\", description: \"1541\" },\n      { value: \"emp-2\", label: \"Bob\", description: \"1656\" },\n    ];\n\n    render(<Combobox onChange={() => { /* empty */ }} options={options} />);\n\n    const cmdkRoot = screen.getByTestId(\"cmdk-root\");\n    // The cmdk value should be constructed from the first option\n    expect(cmdkRoot.getAttribute(\"data-value\")).toBe(\"Alice 1541 emp-1\");\n  });\n\n  it(\"updates highlighted value when options change\", () => {\n    const options1 = [\n      { value: \"emp-1\", label: \"Alice\", description: \"1541\" },\n    ];\n    const options2 = [\n      { value: \"emp-3\", label: \"Charlie\", description: \"9999\" },\n    ];\n\n    const { rerender } = render(<Combobox onChange={() => { /* empty */ }} options={options1} />);\n\n    let cmdkRoot = screen.getByTestId(\"cmdk-root\");\n    expect(cmdkRoot.getAttribute(\"data-value\")).toBe(\"Alice 1541 emp-1\");\n\n    // Re-render with new options (simulating server-side search returning different results)\n    rerender(<Combobox onChange={() => { /* empty */ }} options={options2} />);\n\n    cmdkRoot = screen.getByTestId(\"cmdk-root\");\n    expect(cmdkRoot.getAttribute(\"data-value\")).toBe(\"Charlie 9999 emp-3\");\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/ui/combobox.tsx","messages":[{"ruleId":"@typescript-eslint/no-unnecessary-type-conversion","severity":2,"message":"Passing a boolean to Boolean() does not change the type or value of the boolean.","line":124,"column":8,"nodeType":"Identifier","messageId":"unnecessaryTypeConversion","endLine":124,"endColumn":15,"suggestions":[{"messageId":"suggestRemove","fix":{"range":[3998,4017],"text":"isSelected"},"desc":"Remove the type conversion."},{"messageId":"suggestSatisfies","data":{"type":"boolean"},"fix":{"range":[3998,4017],"text":"(isSelected satisfies boolean)"},"desc":"Instead, assert that the value satisfies the boolean type."}]}],"suppressedMessages":[{"ruleId":"jsx-a11y/no-autofocus","severity":2,"message":"The autoFocus prop should not be used, as it can reduce usability and accessibility for users.","line":154,"column":9,"nodeType":"JSXAttribute","endLine":154,"endColumn":30,"suppressions":[{"kind":"directive","justification":""}]},{"ruleId":"jsx-a11y/no-autofocus","severity":2,"message":"The autoFocus prop should not be used, as it can reduce usability and accessibility for users.","line":229,"column":9,"nodeType":"JSXAttribute","endLine":229,"endColumn":30,"suppressions":[{"kind":"directive","justification":""}]},{"ruleId":"jsx-a11y/no-autofocus","severity":2,"message":"The autoFocus prop should not be used, as it can reduce usability and accessibility for users.","line":246,"column":30,"nodeType":"JSXAttribute","endLine":246,"endColumn":39,"suppressions":[{"kind":"directive","justification":""}]}],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import * as Popover from \"@radix-ui/react-popover\";\nimport { Search, Check, ChevronDown } from \"lucide-react\";\nimport React, { useState, useEffect } from \"react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { Command } from \"cmdk\";\n\nimport { cn } from \"@/lib/utils\";\n\ninterface ComboboxOption {\n  description?: string | React.ReactNode;\n  displayDescription?: React.ReactNode;\n  displayLabel?: React.ReactNode;\n  icon?: React.ReactNode;\n  label: string;\n  value: string;\n}\n\ninterface ComboboxProps {\n  autoFocus?: boolean;\n  className?: string;\n  clearOnEscape?: boolean;\n  \"data-testid\"?: string;\n  disabled?: boolean;\n  emptyText?: string;\n  id?: string;\n  keyboardShortcut?: string | string[];\n  onChange: (value: string) => void;\n  onSearchChange?: (value: string) => void;\n  options: ComboboxOption[];\n  placeholder?: string;\n  searchPlaceholder?: string;\n  shouldFilter?: boolean;\n  value?: string;\n}\n\ninterface KeyboardShortcutOptions {\n  clearOnEscape?: boolean;\n  keyboardShortcut?: string | string[];\n  onChange: (value: string) => void;\n  onSearchChange?: (value: string) => void;\n  open: boolean;\n  setOpen: (open: boolean) => void;\n  value?: string;\n}\n\nfunction useComboboxKeyboardShortcut({\n  clearOnEscape,\n  keyboardShortcut,\n  open,\n  value,\n  onChange,\n  onSearchChange,\n  setOpen\n}: KeyboardShortcutOptions) {\n  useEffect(() => {\n    const handleEscape = (e: KeyboardEvent) => {\n      if (!clearOnEscape || e.key !== 'Escape' || open || value === \"\") return false;\n      e.preventDefault();\n      onChange(\"\");\n      if (onSearchChange) onSearchChange(\"\");\n      return true;\n    };\n\n    const isInputTarget = (target: HTMLElement) => {\n      return ['INPUT', 'TEXTAREA'].includes(target.tagName) || target.isContentEditable;\n    };\n\n    const handleShortcut = (e: KeyboardEvent) => {\n      if (!keyboardShortcut || open) return false;\n      if (isInputTarget(e.target as HTMLElement)) return false;\n\n      const shortcuts = Array.isArray(keyboardShortcut) ? keyboardShortcut : [keyboardShortcut];\n      if (shortcuts.includes(e.key)) {\n        e.preventDefault();\n        setOpen(true);\n        if (onSearchChange) onSearchChange('');\n        return true;\n      }\n      return false;\n    };\n\n    const handleKeyDown = (e: KeyboardEvent) => {\n      if (handleEscape(e)) return;\n      handleShortcut(e);\n    };\n\n    window.addEventListener('keydown', handleKeyDown);\n    return () => { window.removeEventListener('keydown', handleKeyDown); };\n  }, [keyboardShortcut, onSearchChange, open, clearOnEscape, value, onChange, setOpen]);\n}\n\nfunction ComboboxOptionItem({\n  option,\n  isSelected,\n  onSelect,\n  testId\n}: {\n  isSelected: boolean;\n  onSelect: () => void;\n  option: ComboboxOption;\n  testId?: string;\n}) {\n  const cmdkValue = `${option.label} ${typeof option.description === 'string' ? option.description : \"\"} ${option.value}`;\n\n  return (\n    <Command.Item\n      className={cn(\n        \"relative flex cursor-pointer select-none items-center rounded-2xl px-4 py-3.5 text-sm font-bold outline-none transition-all hover:bg-primary-50 dark:hover:bg-primary-950 hover:text-primary-600 dark:hover:text-primary-300 data-[selected=true]:bg-primary-50 dark:data-[selected=true]:bg-primary-950 data-[selected=true]:text-primary-600 dark:data-[selected=true]:text-primary-300 uppercase tracking-tight\",\n        isSelected && \"bg-primary-50 dark:bg-primary-950 text-primary-600 dark:text-primary-300 shadow-inner\"\n      )}\n      data-testid={testId ? `${testId}-option-${option.value}` : `combo-option-${option.value}`}\n      key={option.value}\n      onSelect={onSelect}\n      value={cmdkValue}\n    >\n      <div className=\"flex flex-1 items-center gap-4\">\n        {option.icon}\n        <div className=\"flex flex-col\">\n          <span className=\"leading-tight\">{option.displayLabel ?? option.label}</span>\n          {Boolean(option.description) && <div className=\"mt-1 opacity-60\">{option.displayDescription ?? option.description}</div>}\n        </div>\n      </div>\n      {Boolean(isSelected) && <Check className=\"ml-auto h-4 w-4 text-primary-600 dark:text-primary-300\" />}\n    </Command.Item>\n  );\n}\n\nfunction ComboboxTrigger({\n  autoFocus,\n  className,\n  disabled,\n  id,\n  keyboardShortcut,\n  open,\n  placeholder,\n  selectedOption,\n  testId,\n}: {\n  autoFocus?: boolean;\n  className?: string;\n  disabled?: boolean;\n  id?: string;\n  keyboardShortcut?: string | string[];\n  open: boolean;\n  placeholder: string;\n  selectedOption?: ComboboxOption;\n  testId?: string;\n}) {\n  return (\n    <Popover.Trigger asChild>\n      <button\n        // eslint-disable-next-line jsx-a11y/no-autofocus\n        autoFocus={autoFocus}\n        className={cn(\"flex w-full items-center justify-between rounded-[1.25rem] border border-slate-100 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-5 py-4 text-sm font-bold text-primary-600 dark:text-primary-400 transition-all hover:border-primary-200 dark:hover:border-primary-800 hover:bg-white dark:hover:bg-slate-700 focus:outline-none focus:ring-4 focus:ring-primary-500/10 shadow-inner uppercase tracking-tight disabled:opacity-50 disabled:cursor-not-allowed\", className)}\n        data-testid={testId}\n        disabled={disabled}\n        id={id}\n        type=\"button\"\n      >\n        <span className=\"flex items-center gap-3 truncate\">\n          {selectedOption?.icon}\n          {selectedOption ? (\n            selectedOption.label\n          ) : (\n            <span className=\"text-primary-400 font-bold opacity-60 flex items-center gap-2\">\n              {placeholder}\n              {Boolean(keyboardShortcut) && (\n                <kbd className=\"hidden sm:inline-flex items-center h-5 px-1.5 text-[10px] uppercase font-mono bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded text-slate-400 dark:text-slate-500 shadow-sm ml-2\">\n                  {Array.isArray(keyboardShortcut) ? keyboardShortcut[0] : keyboardShortcut}\n                </kbd>\n              )}\n            </span>\n          )}\n        </span>\n        <ChevronDown className={cn(\"ml-2 h-4 w-4 shrink-0 text-slate-300 transition-transform duration-300\", open && \"rotate-180 text-primary-500\")} />\n      </button>\n    </Popover.Trigger>\n  );\n}\n\nexport function Combobox({\n  options,\n  value,\n  onChange,\n  onSearchChange,\n  placeholder,\n  searchPlaceholder,\n  emptyText,\n  className,\n  id,\n  \"data-testid\": testId,\n  shouldFilter,\n  autoFocus,\n  keyboardShortcut,\n  clearOnEscape,\n  disabled,\n}: ComboboxProps) {\n  const { t } = useTranslation();\n  const [open, setOpen] = useState(autoFocus ?? false);\n\n  useComboboxKeyboardShortcut({ clearOnEscape, keyboardShortcut, open, value, onChange, onSearchChange, setOpen });\n\n  const getFirstItemValue = () => {\n    if (options.length === 0) return \"\";\n    const first = options[0];\n    const desc = typeof first.description === 'string' ? first.description : \"\";\n    return `${first.label} ${desc} ${first.value}`;\n  };\n\n  const firstItemValue = getFirstItemValue();\n  const [highlightedValue, setHighlightedValue] = useState(firstItemValue);\n  const [prevFirst, setPrevFirst] = useState(firstItemValue);\n\n  if (firstItemValue !== prevFirst) {\n    setPrevFirst(firstItemValue);\n    setHighlightedValue(firstItemValue);\n  }\n\n  return (\n    <Popover.Root onOpenChange={setOpen} open={open}>\n      <select aria-hidden=\"true\" className=\"sr-only\" data-testid={testId ? `${testId}