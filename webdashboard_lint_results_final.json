ops.onError?.(error, errorInfo);\n  }\n\n  handleRetry = () => {\n    this.setState({ hasError: false, error: null });\n  };\n\n  handleHardReload = () => {\n    window.location.reload();\n  };\n\n  render() {\n    if (this.state.hasError) {\n      if (this.props.fallback) return this.props.fallback;\n\n      return (\n        <div className=\"min-h-[400px] flex items-center justify-center p-8\">\n          <div className=\"max-w-md text-center space-y-4\">\n            <div className=\"w-16 h-16 mx-auto rounded-full bg-red-100 dark:bg-red-900/30 flex items-center justify-center\">\n              <svg className=\"w-8 h-8 text-red-500\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" viewBox=\"0 0 24 24\">\n                <circle cx=\"12\" cy=\"12\" r=\"10\" />\n                <line x1=\"15\" x2=\"9\" y1=\"9\" y2=\"15\" />\n                <line x1=\"9\" x2=\"15\" y1=\"9\" y2=\"15\" />\n              </svg>\n            </div>\n            <h2 className=\"text-lg font-semibold text-slate-800 dark:text-slate-200\">\n              Something went wrong\n            </h2>\n            <p className=\"text-sm text-slate-500 dark:text-slate-400\">\n              {this.state.error?.message ?? \"An unexpected error occurred\"}\n            </p>\n            <div className=\"flex justify-center gap-3\">\n              <button\n                className=\"px-4 py-2 text-sm font-medium rounded-lg bg-blue-600 text-white hover:bg-blue-700 transition-colors\"\n                onClick={this.handleRetry}\n              >\n                Try again\n              </button>\n              <button\n                className=\"px-4 py-2 text-sm font-medium rounded-lg border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors\"\n                onClick={this.handleHardReload}\n              >\n                Reload page\n              </button>\n            </div>\n            {!!this.state.error && import.meta.env.DEV && (\n              <pre className=\"mt-4 p-4 text-left text-xs bg-slate-100 dark:bg-slate-900 rounded-lg overflow-auto max-h-[200px] text-red-600 dark:text-red-400\">\n                {this.state.error.stack}\n              </pre>\n            )}\n          </div>\n        </div>\n      );\n    }\n\n    return this.props.children ?? null;\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/common/floating-record-badge.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/common/hierarchy-legend.tsx","messages":[{"ruleId":"react/jsx-no-leaked-render","severity":2,"message":"Potential leaked value that might cause unintentionally rendered values or rendering crashes","line":47,"column":8,"nodeType":"LogicalExpression","messageId":"noPotentialLeakedRender","endLine":92,"endColumn":8,"fix":{"range":[1993,5151],"text":"!!isOpen && (\n        <div className=\"px-8 pb-10 pt-6 animate-in slide-in-from-top-4 duration-500\">\n          <div className=\"relative flex flex-col gap-0 pl-3\">\n            {/* Vertical Line */}\n            <div className=\"absolute left-[9.5px] top-4 bottom-4 w-px bg-slate-100 dark:bg-slate-700\" />\n\n            {steps.map((p, index) => (\n              <div className={`relative flex items-start gap-6 pb-6 last:pb-0 group ${p.isActive ? 'opacity-100' : 'opacity-40 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-500'}`} key={index}>\n                {/* Node */}\n                <div className=\"relative z-10 mt-1.5\">\n                  <div className={`w-3.5 h-3.5 rounded-full border-[3px] border-white shadow-md ring-4 ${p.color} transition-transform group-hover:scale-125 duration-300 ${p.isActive ? 'scale-125 ring-primary-50' : 'ring-slate-50'}`} />\n                </div>\n\n                {/* Co