 = ({\n  departments,\n  filterDeptIds,\n  selectedEmployee,\n  setFilterDeptIds,\n  sortDir,\n  sortKey,\n  toggleDeptFilter,\n  toggleSort,\n}: UseEmployeeColumnsProps) => {\n  const { t } = useTranslation();\n\n  const renderSortIcon = React.useCallback((col: SortKey) => {\n    if (sortKey !== col)\n      return <ArrowUpDown className=\"opacity-0 group-hover:opacity-50 transition-opacity ml-1\" size={10} />;\n    return sortDir === \"asc\" ? (\n      <ChevronUp className=\"text-primary-600 dark:text-primary-400 ml-1\" size={10} />\n    ) : (\n      <ChevronDown className=\"text-primary-600 dark:text-primary-400 ml-1\" size={10} />\n    );\n  }, [sortKey, sortDir]);\n\n  const columns: NavigableListColumn<Employee>[] = useMemo(() => [\n    {\n      cell: (emp) => (\n        <EmployeeNameCell employee={emp} isSelected={selectedEmployee?.id === emp.id} />\n      ),\n      cellClassName: \"py-6\",\n      header: <span className=\"inline-flex items-center\">{t(\"employees.table.name\")}{renderSortIcon(\"name\")}</span>,\n      key: \"name\",\n      onHeaderClick: () => { toggleSort(\"name\"); },\n    },\n    {\n      cell: (emp) => emp.department_name ? (\n        <span className=\"inline-flex items-center gap-1.5 px-3 py-1 bg-blue-50 dark:bg-blue-950 text-blue-600 dark:text-blue-300 rounded-xl text-[10px] font-bold uppercase tracking-widest border border-blue-100 dark:border-blue-800\">\n          <Building2 className=\"opacity-60\" size={12} />{emp.department_name}\n        </span>\n      ) : <span className=\"text-slate-300 dark:text-slate-600\">—</span>,\n      cellClassName: \"py-6\",\n      header: (\n        <span className=\"inline-flex items-center gap-2\">\n          <span className=\"inline-flex items-center\">\n            {t(\"common.department\")}{renderSortIcon(\"department\")}\n          </span>\n          <DepartmentFilterHeader \n            departments={departments}\n            filterDeptIds={filterDeptIds}\n            setFilterDeptIds={setFilterDeptIds}\n            toggleDeptFilter={toggleDeptFilter}\n          />\n        </span>\n      ),\n      key: \"department\",\n      onHeaderClick: () => { toggleSort(\"department\"); },\n    },\n    {\n      cell: (emp) => (\n        <StatusBadge variant={emp.is_active ? \"success\" : \"neutral\"}>\n          {emp.is_active ? t(\"employees.table.active\").toUpperCase() : t(\"employees.table.terminated\").toUpperCase()}\n        </StatusBadge>\n      ),\n      cellClassName: \"py-6 text-center\",\n      header: <span className=\"inline-flex items-center\">{t(\"employees.table.status\")}{renderSortIcon(\"status\")}</span>,\n      headerClassName: \"text-center\",\n      key: \"status\",\n      onHeaderClick: () => { toggleSort(\"status\"); },\n    },\n  ], [\n    renderSortIcon,\n    t,\n    sortKey, \n    sortDir, \n    filterDeptIds, \n    departments, \n    selectedEmployee, \n    toggleSort, \n    setFilterDeptIds, \n    toggleDeptFilter\n  ]);\n\n  return columns;\n};\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/employees/hooks/use-employees-data.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/employees/hooks/use-employees-modals.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/employees/hooks/use-employees-page.ts","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Function 'useEmployeesPage' has too many lines (113). Maximum allowed is 100.","line":17,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":136,"endColumn":2}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useR