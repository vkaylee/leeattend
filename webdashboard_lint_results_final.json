ialized.current = true;\n      }\n      return;\n    }\n\n    // No localStorage preference, use server preference or workspace default\n    const langToSet = user?.preferred_language ?? currentWorkspace?.default_language;\n\n    if (langToSet && i18n.language !== langToSet) {\n      void i18n.changeLanguage(langToSet);\n      localStorage.setItem('i18nextLng', langToSet);\n    }\n\n    // Mark as initialized once we have user data\n    if (user) {\n      hasInitialized.current = true;\n    }\n  }, [user?.preferred_language, currentWorkspace?.default_language, i18n, user]);\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/hooks/use-infinite-scroll.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/hooks/use-keyboard-list-nav.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/hooks/use-language.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/hooks/use-monitor-charts.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/hooks/use-monitor-stream.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/hooks/use-permissions.ts","messages":[{"ruleId":"complexity","severity":2,"message":"Function 'useMyPermissions' has a complexity of 15. Maximum allowed is 10.","line":17,"column":8,"nodeT