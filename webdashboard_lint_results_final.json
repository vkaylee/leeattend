eatures/dashboard/leave-types-chart.tsx","messages":[],"suppressedMessages":[{"ruleId":"@typescript-eslint/no-deprecated","severity":2,"message":"`Cell` is deprecated.","line":81,"column":38,"nodeType":"JSXIdentifier","messageId":"deprecated","endLine":81,"endColumn":42,"suppressions":[{"kind":"directive","justification":""}]}],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/dashboard/overtime-trend-chart.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/dashboard/peak-times-chart.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/dashboard/recruitment-source-chart.tsx","messages":[],"suppressedMessages":[{"ruleId":"@typescript-eslint/no-deprecated","severity":2,"message":"`Cell` is deprecated.","line":137,"column":38,"nodeType":"JSXIdentifier","messageId":"deprecated","endLine":137,"endColumn":42,"suppressions":[{"kind":"directive","justification":""}]}],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/dashboard/turnover-analytics-chart.tsx","messages":[],"suppressedMessages":[{"ruleId":"@typescript-eslint/no-deprecated","severity":2,"message":"`Cell` is deprecated.","line":285,"column":34,"nodeType":"JSXIdentifier","messageId":"deprecated","endLine":285,"endColumn":38,"suppressions":[{"kind":"directive","justification":""}]}],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/dashboard/unexcused-absences-chart.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/dashboard/widget-renderer.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/departments/department-card.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/departments/department-config-modal.tsx","messages":[{"ruleId":"@typescript-eslint/no-non-null-assertion","severity":2,"message":"Forbidden non-null assertion.","line":36,"column":56,"nodeType":"TSNonNullExpression","messageId":"noNonNull","endLine":36,"endColumn":68,"suggestions":[{"messageId":"suggestOptionalChain","fix":{"range":[1213,1214],"text":"?"},"desc":"Consider using the optional chain operator `?.` instead. This operator includes runtime checks, so it is safer than the compile-only non-null assertion operator."}]},{"ruleId":"@typescript-eslint/no-non-null-assertion","severity":2,"message":"Forbidden non-null assertion.","line":41,"column":137,"nodeType":"TSNonNullExpression","messageId":"noNonNull","endLine":41,"endColumn":149,"suggestions":[{"messageId":"suggestOptionalChain","fix":{"range":[1460,1461],"text":"?"},"desc":"Consider using the optional chain operator `?.` instead. This operator includes runtime checks, so it is safer than the compile-only non-null assertion operator."}]},{"ruleId":"@typescript-eslint/no-unnecessary-type-conversion","severity":2,"message":"Using !! on a boolean does not change the type or value of the boolean.","line":46,"column":52,"nodeType":null,"messageId":"unnecessaryTypeConversion","endLine":46,"endColumn":54,"suggestions":[{"messageId":"suggestRemove","fix":{"range":[1661,1669],"text":"isOpen"},"desc":"Remove the type conversion."},{"messageId":"suggestSatisfies","data":{"type":"boolean"},"fix":{"range":[1661,1669],"text":"(isOpen satisfies boolean)"},"desc":"Instead, assert that the value satisfies the boolean type."}]}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import type { TFunction } from \"i18next\";\n\nimport { useQuery, useMutation, useQueryClient } from \"@tanstack/react-query\";\nimport { Calculator } from \"lucide-react\";\nimport React from \"react\";\n\nimport type { Department } from \"@/lib/api\";\n\nimport TemporalConfigTable from \"@/components/common/temporal-config-table\";\nimport Button from \"@/components/ui/button\";\nimport Modal from \"@/components/ui/modal\";\nimport { fetchDepartmentPayrollConfigs, setDepartmentPayrollConfig } from \"@/lib/api\";\n\nexport interface DepartmentConfigModalProps {\n  editingDept: Department | null;\n  isOpen: boolean;\n  onClose: () => void;\n  t: TFunction;\n  wsId: string;\n}\n\n// Internal type matching what the component expects\ninterface TemporalConfigRecord {\n  [key: string]: unknown;\n  effective_date: string;\n  hours_per_day?: number;\n  id: string;\n  std_working_days?: number;\n}\n\nexport function DepartmentConfigModal({ editingDept, isOpen, onClose, wsId, t }: DepartmentConfigModalProps) {\n  const queryClient = useQueryClient();\n\n  const { data: deptConfigs = [], isLoading: isConfigsLoading } = useQuery({ \n    queryKey: [\"dept-payroll-configs\", editingDept?.id], \n    queryFn: () => fetchDepartmentPayrollConfigs(wsId, editingDept!.id), \n    enabled: isOpen && !!editingDept?.id \n  });\n\n  const saveConfigMutation = useMutation({\n    mutationFn: (data: { std_working_days: number; hours_per_day: number; effective_date: string }) => setDepartmentPayrollConfig(wsId, editingDept!.id, data),\n    onSuccess: () => { void queryClient.invalidateQueries({ queryKey: [\"dept-payroll-configs\", editingDept?.id] }); },\n  });\n\n  return (\n    <Modal icon={<Calculator size={24} />} isOpen={!!isOpen && Boolean(editingDept)} maxWidth=\"3xl\" onClose={onClose} subtitle={editingDept?.name.toUpperCase()} title={t(\"payroll.settings.dept_title\")}>\n      <div className=\"space-y-10 pt-4 animate-in fade-in duration-500\">\n        <TemporalConfigTable \n          isLoading={isConfigsLoading} \n          onSave={async (data) => { await saveConfigMutation.mutateAsync(data); }} \n          records={deptConfigs as TemporalConfigRecord[]} \n          title={t(\"payroll.settings.std_days_history\")} \n        />\n        <div className=\"pt-8 border-t border-slate-50 dark:border-slate-800 flex justify-end\"><Button onClick={onClose} size=\"lg\" variant=\"secondary\">{t(\"common.close\").toUpperCase()}</Button></div>\n      </div>\n    </Modal>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/departments/department-form-modal.tsx","messages":[{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/workspace/webdashboard/src/components/features/departments/department-form-modal.tsx:35:7\n  33 |   useEffect(() => {\n  34 |     if (editingDept) {\n> 35 |       setSelectedManagerId(editingDept.manager_id ?? \"\");\n     |       ^^^^^^^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  36 |       setSelectedPatternId(editingDept.default_working_pattern_id ?? \"\");\n  37 |     } else {\n  38 |       setSelectedManagerId(\"\");","line":35,"column":7,"nodeType":null,"endLine":35,"endColumn":27},{"ruleId":"@typescript-eslint/no-non-null-assertion","severity":2,"message":"Forbidden non-null assertion.","line":53,"column":75,"nodeType":"TSNonNullExpression","messageId":"noNonNull","endLine":53,"endColumn":87,"suggestions":[{"messageId":"suggestOptionalChain","fix":{"range":[1873,1874],"text":"?"},"desc":"Consider using the optional chain operator `?.` instead. This operator includes runtime checks, so it is safer than the compile-only non-null assertion operator."}]}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import type { TFunction } from \"i18next\";\n\nimport { useMutation, useQueryClient } from \"@tanstack/react-query\";\nimport { LayoutGrid, UserCircle, CalendarDays } from \"lucide-react\";\nimport React, { useState, useEffect } from \"react\";\n\nimport type { Department, User, WorkingPattern } from \"@/lib/api\";\n\nimport Button from \"@/components/ui/button\";\nimport { Combobox } from \"@/components/ui/combobox\";\nimport FormField, { LABEL_BASE } from \"@/components/ui/form-field\";\nimport Modal from \"@/components/ui/modal\";\nimport { useToast } from \"@/components/ui/toast\";\nimport { createDepartment, updateDepartment } from \"@/lib/api\";\n\nexport interface DepartmentFormModalProps {\n  editingDept: Department | null;\n  isOpen: boolean;\n  onClose: () => void;\n  patterns: WorkingPattern[];\n  t: TFunction;\n  users: User[];\n  wsId: string;\n}\n\nexport function DepartmentFormModal({ editingDept, isOpen, onClose, wsId, users, patterns, t }: DepartmentFormModalProps) {\n  const queryClient = useQueryClient();\n  const toast = useToast();\n\n  const [selectedManagerId, setSelectedManagerId] = useState<string>(\"\");\n  const [selectedPatternId, setSelectedPatternId] = useState<string>(\"\");\n\n  useEffect(() => {\n    if (editingDept) {\n      setSelectedManagerId(editingDept.manager_id ?? \"\");\n      setSelectedPatternId(editingDept.default_working_pattern_id ?? \"\");\n    } else {\n      setSelectedManagerId(\"\");\n      setSelectedPatternId(\"\");\n    }\n  }, [editingDept]);\n\n  const createMutation = useMutation({\n    mutationFn: (data: Record<string, unknown>) => createDepartment(wsId, data),\n    onSuccess: () => { \n      void queryClient.invalidateQueries({ queryKey: [\"departments\", wsId] }); \n      onClose(); \n      toast.success(t(\"common.success\")); \n    },\n  });\n\n  const updateMutation = useMutation({\n    mutationFn: (data: Record<string, unknown>) => updateDepartment(wsId, editingDept!.id, data),\n    onSuccess: () => { \n      void queryClient.invalidateQueries({ queryKey: [\"departments\", wsId] }); \n      onClose(); \n      toast.success(t(\"common.success\")); \n    },\n  });\n\n  const handleSubmit = (e: React.SyntheticEvent<HTMLFormElement>) => {\n    e.preventDefault(); \n    const formData = new FormData(e.currentTarget);\n    const data = { \n      name: formData.get(\"name\") as string, \n      description: formData.get(\"description\") as string, \n      manager_id: selectedManagerId || null, \n      default_working_pattern_id: selectedPatternId || null \n    };\n    if (editingDept) { \n      updateMutation.mutate(data); \n    } else { \n      createMutation.mutate(data); \n    }\n  };\n\n  return (\n    <Modal icon={<LayoutGrid size={24} />} isOpen={isOpen} maxWidth=\"lg\" onClose={onClose} subtitle={t(\"departments.modal.subtitle\")} title={editingDept ? t(\"departments.modal.edit_title\") : t(\"departments.modal.add_title\")}>\n      <form className=\"space-y-8 pt-4 animate-in fade-in duration-500\" onSubmit={handleSubmit}>\n        <FormField defaultValue={editingDept?.name} id=\"dept-name\" label={t(\"departments.form.name_label\")} name=\"name\" placeholder={t(\"departments.form.name_placeholder\")} required />\n        <FormField defaultValue={editingDept?.description ?? undefined} id=\"dept-desc\" label={t(\"common.description\")} name=\"description\" placeholder={t(\"departments.form.desc_placeholder\")} rows={4} type=\"textarea\" />\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n          <div className=\"space-y-3 px-1\"><label className={LABEL_BASE} htmlFor=\"dept-manager\">{t(\"departments.manager_label\")}</label><Combobox className=\"bg-slate-50 dark:bg-slate-800 border-slate-100 dark:border-slate-800 h-14\" id=\"dept-manager\" onChange={setSelectedManagerId} options={users.map(u => ({ value: u.id, label: (u.full_name ?? u.email).toUpperCase(), icon: <UserCircle size={14} /> }))} placeholder={t(\"departments.form.manager_placeholder\")} value={selectedManagerId} /></div>\n          <div className=\"space-y-3 px-1\"><label className={LABEL_BASE} htmlFor=\"dept-pattern\">{t(\"departments.default_pattern_label\")}</label><Combobox className=\"bg-slate-50 dark:bg-slate-800 border-slate-100 dark:border-slate-800 h-14\" data-testid=\"dept-pattern\" id=\"dept-pattern\" onChange={setSelectedPatternId} options={patterns.map(p => ({ value: p.id, label: p.name.toUpperCase(), icon: <CalendarDays size={14} /> }))} placeholder={t(\"departments.form.pattern_placeholder\")} value={selectedPatternId} /></div>\n        </div>\n        <div className=\"pt-6 grid grid-cols-2 gap-6 border-t border-slate-50 dark:border-slate-800\">\n          <Button onClick={onClose} size=\"lg\" variant=\"outline\">{t(\"common.cancel\").toUpperCase()}</Button>\n          <Button data-testid=\"save-dept-btn\" size=\"lg\" type=\"submit\" variant=\"secondary\">{editingDept ? t(\"common.update\").toUpperCase() : t(\"departments.modal.submit_btn\").toUpperCase()}</Button>\n        </div>\n      </form>\n    </Modal>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/employees/__tests__/employee-detail-drawer.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/employees/__tests__/employee-form-modal.test.tsx","messages":[{"ruleId":"@typescript-eslint/require-await","severity":2,"message":"Async arrow function has no 'await' expression.","line":96,"column":52,"nodeType":"ArrowFunctionExpression","messageId":"missingAwait","endLine":96,"endColumn":54,"suggestions":[{"messageId":"removeAsync","fix":{"range":[2712,2718],"text":""},"desc":"Remove 'async'."}]},{"ruleId":"@typescript-eslint/require-await","severity":2,"message":"Async arrow function has no 'await' expression.","line":104,"column":76,"nodeType":"ArrowFunctionExpression","messageId":"missingAwait","endLine":104,"endColumn":78,"suggestions":[{"messageId":"removeAsync","fix":{"range":[3192,3198],"text":""},"desc":"Remove 'async'."}]}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { QueryClient, QueryClientProvider } from \"@tanstack/react-query\";\nimport { render, screen, waitFor, fireEvent } from \"@testing-library/react\";\nimport React from \"react\";\n\nimport userEvent from \"@testing-library/user-event\";\nimport { describe, it, expect, vi, beforeEach } from \"vitest\";\n\nimport type { Employee } from \"@/lib/api\";\n\nimport { ToastProvider } from \"@/components/ui/toast\";\nimport * as api from \"@/lib/api\";\n\nimport EmployeeFormModal from \"../employee-form-modal\";\n\nvi.mock(\"react-i18next\", () => ({\n    useTranslation: () => ({\n        t: (key: string, options?: { defaultValue?: string }) => {\n            if (options && typeof options === \"object\" && options.defaultValue) return options.defaultValue;\n            return key;\n        },\n        i18n: { changeLanguage: () => Promise.resolve(), language: \"en\" },\n    }),\n}));\n\nconst mockMembers = [\n    {\n        workspace_id: \"ws-1\",\n        user_id: \"user-abc\",\n        role_id: \"role-1\",\n        email: \"user@example.com\",\n        full_name: \"Test User\",\n        avatar_url: undefined,\n        extra_role_ids: [],\n    },\n    {\n        workspace_id: \"ws-1\",\n        user_id: \"user-xyz\",\n        role_id: \"role-2\",\n        email: \"other@example.com\",\n        full_name: \"Other User\",\n        avatar_url: undefined,\n        extra_role_ids: [],\n    },\n];\n\nvi.mock(\"@/lib/api\", () => ({\n    createEmployee: vi.fn(),\n    updateEmployee: vi.fn(),\n    fetchWorkspaceMembers: vi.fn(() => Promise.resolve(mockMembers)),\n}));\n\n\nconst mockEmployee: Employee = {\n    id: \"emp-1\",\n    full_name: \"Alice Nguyen\",\n    employee_id_number: \"EMP-001\",\n    workspace_id: \"ws-1\",\n    user_id: \"user-abc\",\n    is_active: true,\n    hire_date: \"2024-06-15\",\n    created_at: \"2024-06-15T00:00:00Z\",\n    updated_at: \"2024-06-15T00:00:00Z\",\n};\n\ndescribe(\"EmployeeFormModal\", () => {\n    let queryClient: QueryClient;\n\n    const defaultProps = {\n        isOpen: true,\n        onClose: vi.fn(),\n        editingEmployee: null,\n        wsId: \"ws-1\",\n        onSuccess: vi.fn(),\n    };\n\n    beforeEach(() => {\n        vi.clearAllMocks();\n        queryClient = new QueryClient({ defaultOptions: { queries: { retry: false } } });\n    });\n\n    const renderWithClient = (ui: React.ReactElement) => {\n        return render(\n            <QueryClientProvider client={queryClient}>\n                <ToastProvider>{ui}</ToastProvider>\n            </QueryClientProvider>\n        );\n    };\n\n    it(\"renders nothing when isOpen is false\", () => {\n        renderWithClient(\n            <EmployeeFormModal {...defaultProps} isOpen={false} />\n        );\n        expect(screen.queryByTestId(\"employees-form-name-input\")).toBeNull();\n    });\n\n    it(\"renders form fields in add mode\", async () => {\n        renderWithClient(<EmployeeFormModal {...defaultProps} />);\n        expect(screen.getByTestId(\"employees-form-name-input\")).toBeDefined();\n        expect(screen.getByTestId(\"employees-form-id-input\")).toBeDefined();\n        expect(screen.getByTestId(\"employees-form-hire-date-input\")).toBeDefined();\n        expect(screen.getByTestId(\"employees-form-active-checkbox\")).toBeDefined();\n    });\n\n    it(\"renders form fields in edit mode with pre-filled values\", async () => {\n        renderWithClient(\n            <EmployeeFormModal {...defaultProps} editingEmployee={mockEmployee} />\n        );\n        const nameInput = screen.getByTestId(\"employees-form-name-input\");\n        expect((nameInput as HTMLInputElement).value).toBe(\"Alice Nguyen\");\n\n        const idInput = screen.getByTestId(\"employees-form-id-input\");\n        expect((idInput as HTMLInputElement).value).toBe(\"EMP-001\");\n\n        const hireInput = screen.getByTestId(\"employees-form-hire-date-input\");\n        expect((hireInput as HTMLInputElement).value).toBe(\"2024-06-15\");\n    });\n\n    it(\"shows user combobox with linked user in edit mode\", async () => {\n        renderWithClient(\n            <EmployeeFormModal {...defaultProps} editingEmployee={mockEmployee} />\n        );\n        await waitFor(() => {\n            expect(screen.getByText(\"Test User\")).toBeDefined();\n        });\n    });\n\n    it(\"calls createEmployee on submit in add mode\", async () => {\n        const user = userEvent.setup();\n        vi.mocked(api.createEmployee).mockResolvedValue(mockEmployee);\n        renderWithClient(<EmployeeFormModal {...defaultProps} />);\n\n        await user.type(screen.getByTestId(\"employees-form-name-input\"), \"New Emp\");\n        await user.type(screen.getByTestId(\"employees-form-id-input\"), \"EMP-100\");\n        await user.type(screen.getByTestId(\"employees-form-hire-date-input\"), \"2025-01-01\");\n        await user.click(screen.getByTestId(\"save-employee-btn\"));\n\n        await waitFor(() => {\n            expect(api.createEmployee).toHaveBeenCalledWith(\n                \"ws-1\",\n                expect.objectContaining({\n                    full_name: \"New Emp\",\n                    employee_id_number: \"EMP-100\",\n                    hire_date: \"2025-01-01\",\n                })\n            );\n        });\n    });\n\n    it(\"passes user_id to createEmployee when user is selected from combobox\", async () => {\n        const user = userEvent.setup();\n        vi.mocked(api.createEmployee).mockResolvedValue(mockEmployee);\n        renderWithClient(<EmployeeFormModal {...defaultProps} />);\n\n        await user.type(screen.getByTestId(\"employees-form-name-input\"), \"New Emp\");\n        await user.type(screen.getByTestId(\"employees-form-id-input\"), \"EMP-100\");\n        await user.type(screen.getByTestId(\"employees-form-hire-date-input\"), \"2025-01-01\");\n\n        const select = document.querySelector('select[data-testid=\"employees-form-user-combobox\"]');\n        fireEvent.change(select!, { target: { value: \"user-xyz\" } });\n\n        await user.click(screen.getByTestId(\"save-employee-btn\"));\n\n        await waitFor(() => {\n            expect(api.createEmployee).toHaveBeenCalledWith(\n                \"ws-1\",\n                expect.objectContaining({\n                    full_name: \"New Emp\",\n                    user_id: \"user-xyz\",\n                })\n            );\n        });\n    });\n\n    it(\"calls updateEmployee on submit in edit mode\", async () => {\n        const user = userEvent.setup();\n        vi.mocked(api.updateEmployee).mockResolvedValue(mockEmployee);\