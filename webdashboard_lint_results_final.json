 = () => {\n  localStorage.removeItem(\"active_user_id\");\n  localStorage.removeItem(\"active_workspace_id\");\n  localStorage.removeItem(\"access_token\");\n  localStorage.removeItem(\"refresh_token\");\n\n  // Call backend to clear HttpOnly cookies\n  fetch(`${API_BASE_URL}/auth/logout`, { \n    method: \"POST\", \n    credentials: \"include\",\n    headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify({})\n  }).catch(console.error);\n};\n\nfunction getHeaders() {\n  const headers: Record<string, string> = {\n    \"Content-Type\": \"application/json\",\n  };\n  const wsId = getCurrentWorkspaceId();\n  if (wsId) {\n    headers[\"X-Workspace-Id\"] = wsId;\n  }\n  const token = getAccessToken();\n  if (token) {\n    headers.Authorization = `Bearer ${token}`;\n  } else {\n    // Fallback for dev mode\n    const userId = getCurrentUserId();\n    if (userId) headers[\"X-User-Id\"] = userId;\n  }\n\n  // Debug Headers (only in development)\n  if (import.meta.env.DEV) {\n    const isEnabled = localStorage.getItem(\"debug_enabled\") === \"true\";\n    if (isEnabled) {\n      const impId = localStorage.getItem(\"debug_impersonate_id\");\n      if (impId) {\n        headers[\"X-Debug-Impersonate-Id\"] = impId;\n      }\n      const mockDate = localStorage.getItem(\"debug_mock_date\");\n      if (mockDate) {\n        headers[\"X-Debug-Mock-Date\"] = mockDate;\n      }\n    }\n  }\n\n  return headers;\n}\n\n/**\n * Extended RequestInit with custom timeout\n */\nexport interface ApiFetchOptions extends RequestInit {\n  /**\n   * Request timeout in milliseconds\n   * @default 10000 (10 seconds)\n   */\n  timeout?: number;\n}\n\n/**\n * Timeout constants for different operation types\n */\nexport const TIMEOUT = {\n  /** Standard API calls (10 seconds) */\n  DEFAULT: 10000,\n  /** Report generation and large file operations (3 minutes) */\n  REPORT_OPERATION: 180000,\n  /** Health checks and quick operations (5 seconds) */\n  QUICK: 5000,\n} as const;\n\n/**\n * Wrapper for fetch to handle 401 and refresh token\n *\n * @param url - API endpoint URL\n * @param options - Fetch options with optional timeout (default: 10 seconds)\n */\nexport async function apiFetch(\n  url: string,\n  options: ApiFetchOptions = {},\n): Promise<Response> {\n  const controller = new AbortController();\n  // Default timeout: 10 seconds for normal API calls\n  const timeoutMs = options.timeout ?? TIMEOUT.DEFAULT;\n  const id = setTimeout(() => { controller.abort(); }, timeoutMs);\n\n  const headers = { ...getHeaders(), ...options.headers };\n\n  // Remove timeout from options to avoid passing it to fetch\n  const { timeout: _timeout, ...fetchOptions } = options;\n\n  if (fetchOptions.body instanceof FormData) {\n \n    delete (headers as Record<string, string>)[\"Content-Type\"];\n  }\n\n  // If url already starts with http/https or the API_BASE_URL, don't prepend API_BASE_URL\n  let fullUrl = url;\n  if (!url.startsWith(\"http\") && !url.startsWith(API_BASE_URL)) {\n    const path = url.startsWith(\"/\") ? url : `/${url}`;\n    fullUrl = `${API_BASE_URL}${path}`;\n  }\n\n  try {\n    const response = await fetch(fullUrl, {\n      ...fetchOptions,\n      headers,\n      credentials: \"include\", // Send HttpOnly cookies\n      signal: controller.signal\n    });\n    clearTimeout(id);\n    \n    if (response.status === 401 && !fullUrl.includes(\"/auth/login\")) {\n      // Attempt to refresh token\n      const refreshToken = getRefreshToken();\n      if (refreshToken) {\n        try {\n          const refreshResponse = await fetch(`${API_BASE_URL}/auth/refresh`, {\n            method: \"POST\",\n            headers: { \"Content-Type\": \"application/json\" },\n            credentials: \"include\", // Send HttpOnly cookies\n            body: JSON.stringify({ refresh_token: refreshToken }),\n          });\n\n          if (refreshResponse.ok) {\n            const data = (await refreshResponse.json()) as { access_token: string; refresh_token: string };\n            setAccessToken(data.access_token);\n            setRefreshToken(data.refresh_token);\n\n            // Retry original request with new token\n            const retryHeaders = { ...headers, Authorization: `Bearer ${data.access_token}` };\n            const retryResponse = await fetch(fullUrl, {\n              ...fetchOptions,\n              headers: retryHeaders,\n              credentials: \"include\", // Send HttpOnly cookies\n              signal: controller.signal\n            });\n            clearTimeout(id);\n            return retryResponse;\n          }\n        } catch (e) {\n          console.error(\"Token refresh failed\", e);\n        }\n      }\n      \n      console.warn(\"Session expired (401). Redirecting to login...\");\n      clearAuthSession();\n      if (window.location.pathname !== ROUTES.LOGIN) {\n        window.location.href = ROUTES.LOGIN;\n      }\n      throw new Error(\"Session expired\");\n    }\n\n    return response;\n  } catch (error) {\n    clearTimeout(id);\n    throw error;\n  }\n}\n\nexport async function fetchHealth(): Promise<{ status: string }> {\n  const response = await apiFetch(`${API_BASE_URL}/health`);\n  return response.json() as Promise<{ status: string }>;\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/lib/api/holidays.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/lib/api/index.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/lib/api/leaves.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/lib/api/payroll.