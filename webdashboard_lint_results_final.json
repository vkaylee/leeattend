ifts\"), [ROUTES.PAYROLL]: t(\"payroll.title\"),\n      [ROUTES.AGENTS]: t(\"agents.title\"), [ROUTES.DEVICES]: t(\"common.devices\"), [ROUTES.SETTINGS.ROOT]: t(\"settings.title\"), [ROUTES.SETTINGS.GENERAL]: t(\"settings.categories.general\"),\n      [ROUTES.SETTINGS.ORGANIZATION]: t(\"settings.categories.organization\", { defaultValue: \"Organization\" }), [ROUTES.SETTINGS.TIME]: t(\"settings.categories.time\"),\n      [ROUTES.SETTINGS.PAYROLL]: t(\"settings.categories.payroll\"), [ROUTES.SETTINGS.CONNECTIVITY]: t(\"settings.categories.connectivity\"),\n      [ROUTES.PROFILE]: t(\"common.profile\"), [ROUTES.ESS_PROFILE]: t(\"common.my_profile\"), [ROUTES.ESS_ATTENDANCE]: t(\"ess.attendance.title\"),\n      [ROUTES.ESS_CLOCK]: t(\"ess.clock.title\"),\n    };\n    return map[path] ?? (path.split('/').pop()?.replace(/-/g, ' ') ?? \"\");\n  };\n\n  return (\n    <header className=\"h-20 border-b border-slate-100 dark:border-slate-800 bg-white/80 dark:bg-slate-900/80 backdrop-blur-xl flex items-center justify-between px-6 lg:px-10 gap-6 flex-shrink-0 z-30 sticky top-0 shadow-2xl shadow-slate-900/5 dark:shadow-black/20\">\n      <div className=\"flex items-center gap-6\">\n        <button className=\"lg:hidden p-3 bg-slate-50 dark:bg-slate-800 text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-xl active:scale-90 transition-all border border-slate-100 dark:border-slate-700 shadow-sm\" onClick={onOpenSidebar}><Menu size={20} /></button>\n\n        {/* Desktop Collapse Toggle */}\n        <button\n          className=\"hidden lg:flex p-3 bg-slate-50 dark:bg-slate-800 text-slate-500 dark:text-slate-400 hover:bg-primary-50 dark:hover:bg-primary-950 hover:text-primary-600 dark:hover:text-primary-400 rounded-xl active:scale-90 transition-all border border-slate-100 dark:border-slate-700 shadow-sm hover:shadow-md hover:border-primary-100 dark:hover:border-primary-800\"\n          onClick={onToggleCollapsed}\n          title={isCollapsed ? t(\"common.expand_sidebar\") : t(\"common.collapse_sidebar\")}\n        >\n          {isCollapsed ? <ChevronRight size={20} /> : <ChevronLeft size={20} />}\n        </button>\n\n        {/* Premium Breadcrumbs */}\n        <nav className=\"flex items-center gap-3\">\n          <span className=\"hidden sm:inline text-slate-500 dark:text-slate-400 font-bold uppercase text-[10px] tracking-[0.25em] opacity-60\">{currentWorkspaceName ?? \"Workspace\"}</span>\n          <BreadcrumbSeparator className=\"w-3 h-3 text-slate-300 dark:text-slate-600\" />\n          <span className=\"text-slate-700 dark:text-slate-200 font-bold uppercase text-[10px] tracking-[0.25em] bg-slate-100 dark:bg-slate-800 px-3 py-1 rounded-lg shadow-inner\">\n            {getPageName(location.pathname).toUpperCase()}\n          </span>\n        </nav>\n      </div>\n\n      <div className=\"flex items-center gap-6 ml-auto\">\n        {/* Theme Toggle */}\n        <ThemeToggle />\n\n        {/* Language Switcher */}\n        <LanguageSwitcher />\n\n        <button className=\"p-3 text-slate-500 dark:text-slate-400 hover:text-primary-600 dark:hover:text-primary-400 hover:bg-white dark:hover:bg-slate-800 rounded-[1.25rem] transition-all relative group border border-transparent hover:border-slate-100 dark:hover:border-slate-700 hover:shadow-xl hover:shadow-primary-900/5\">\n          <div className=\"absolute top-3 right-3 w-2.5 h-2.5 bg-rose-500 rounded-full border-2 border-white dark:border-slate-900 shadow-sm group-hover:scale-125 transition-transform animate-pulse\"></div>\n          <Bell size={20} strokeWidth={2.5} />\n        </button>\n\n        <div className=\"h-10 w-px bg-slate-100 dark:bg-slate-800 mx-1 hidden sm:block opacity-50\"></div>\n\n        <div className=\"flex items-center gap-4 pl-2 group cursor-pointer active:scale-95 transition-all\">\n          <div className=\"hidden sm:block text-right\">\n            <div className=\"flex items-center justify-end gap-2\">\n              <p className=\"text-xs font-bold text-slate-700 dark:text-slate-200 leading-none group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors uppercase tracking-tight\">\n                {roles[0] ?? t(\"common.admin\")}\n              </p>\n              {roles.includes('TeamLead') && managedDepartmentIds !== null && (\n                <span className=\"inline-flex items-center px-2 py-0.5 rounded text-[9px] font-bold bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-400 border border-amber-200 dark:border-amber-800 uppercase tracking-wider\">\n                  Department-scoped\n                </span>\n              )}\n            </div>\n            <p className=\"text-[9px] font-bold text-slate-500 dark:text-slate-400 mt-1.5 uppercase tracking-[0.2em] opacity-60 leading-none\">{t(\"common.workspace_owner\")}</p>\n          </div>\n          <div className=\"w-12 h-12 rounded-[1.25rem] bg-slate-900 text-white flex items-center justify-center font-bold text-sm shadow-2xl shadow-slate-400 dark:shadow-black border border-slate-800 group-hover:bg-primary-600 group-hover:border-primary-500 transition-all duration-500 group-hover:scale-110 group-hover:rotate-3\">\n            {roles[0]?.substring(0, 2).toUpperCase() ?? \"AD\"}\n          </div>\n        </div>\n      </div>\n    </header>\n  );\n}\n\n/** Segmented theme toggle: Light / System / Dark */\nfunction ThemeToggle() {\n  const { mode, setMode } = useDarkModeContext();\n  const { t } = useTranslation();\n\n  const options: { value: ThemeMode; icon: React.ReactNode; label: string }[] = [\n    { value: 'light', icon: <Sun size={14} />, label: t('common.theme.light', 'Light') },\n    { value: 'system', icon: <Monitor size={14} />, label: t('common.theme.system', 'System') },\n    { value: 'dark', icon: <Moon size={14} />, label: t('common.theme.dark', 'Dark') },\n  ];\n\n  return (\n    <div className=\"flex bg-slate-100 dark:bg-slate-800 p-1 rounded-xl border border-slate-200 dark:border-slate-700 shadow-inner\" data-testid=\"theme-toggle\">\n      {options.map((opt) => (\n        <button\n          className={cn(\n            \"p-2 rounded-lg transition-all flex items-center justify-center gap-1.5 min-w-[44px] min-h-[44px]\",\n            mode === opt.value\n              ? \"bg-white dark:bg-slate-900 text-primary-600 dark:text-primary-400 shadow-sm border border-slate-100 dark:border-slate-700\"\n              : \"text-slate-400 dark:text-slate-500 hover:text-slate-600 dark:hover:text-slate-300\"\n          )}\n          data-testid={`theme-toggle-${opt.value}`}\n          key={opt.value}\n          onClick={() => { setMode(opt.value); }}\n          title={opt.label}\n        >\n          {opt.icon}\n        </button>\n      ))}\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/layout/sidebar.tsx","messages":[{"ruleId":"@typescript-eslint/no-unnecessary-type-conversion","severity":2,"message":"Using !! on a boolean does not change the type or value of the boolean.","line":139,"column":8,"nodeType":null,"messageId":"unnecessaryTypeConversion","endLine":139,"endColumn":10,"suggestions":[{"messageId":"suggestRemove","fix":{"range":[3508,3553],"text":"(openSections[item.section] ?? isCollapsed)"},"desc":"Remove the type conversion."},{"messageId":"suggestSatisfies","data":{"type":"boolean"},"fix":{"range":[3508,3553],"text":"((openSections[item.section] ?? isCollapsed) satisfies boolean)"},"desc":"Instead, assert that the value satisfies the boolean type."}]},{"ruleId":"max-lines-per-function","severity":1,"message":"Function 'Sidebar' has too many lines (105). Maximum allowed is 100.","line":158,"column":16,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":266,"endColumn":2}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Link, useLocation } from \"@tanstack/react-router\";\nimport {\n  LayoutDashboard,\n  History,\n  Settings,\n  UserCircle,\n  Users,\n  Clock,\n  CheckCircle,\n  UserRound,\n  CalendarRange,\n  Building2,\n  X,\n  LogOut,\n  ChevronDown,\n  ChevronRight,\n  ShieldCheck,\n  Scale,\n  BarChart3,\n  Folder,\n  Timer,\n  Wallet,\n  Wrench,\n  User,\n  Plane,\n  CalendarCheck,\n  ClipboardCheck,\n  ArrowLeftRight,\n  DollarSign,\n  Activity\n} from \"lucide-react\";\nimport React from \"react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { useMyPermissions } from \"@/hooks/use-permissions\";\nimport { useProfile } from \"@/hooks/use-profile\";\nimport { ROUTES } from \"@/lib/routes\";\nimport { cn } from \"@/lib/utils\";\n\n\ninterface SidebarProps {\n  isCollapsed: boolean;\n  isOpen: boolean;\n  onClose: () => void;\n  onShowSwitcher: () => void;\n  openSections: Partial<Record<string, boolean>>;\n  toggleSection: (section: string) => void;\n}\n\ninterface MenuItemBase {\n  icon?: React.ElementType;\n  label: string;\n  testId: string;\n  to?: string;\n}\n\ninterface MenuSectionType extends MenuItemBase {\n  items: MenuLinkType[];\n  section: string;\n  sectionIcon: React.ElementType;\n}\n\ninterface MenuLinkType extends MenuItemBase {\n  exact?: boolean;\n  permissions?: string[];\n  systemRoles?: string[];\n  to: string;\n}\n\ntype MenuItem = MenuSectionType | MenuLinkType;\n\nfunction SidebarLink({\n  to,\n  icon: Icon,\n  label,\n  testId,\n  isCollapsed,\n  isActive\n}: {\n  isActive: boolean;\n  isCollapsed: boolean;\n  label: string;\n  testId: string;\n  to: string;\n  icon?: React.ElementType;\n}) {\n  return (\n    <Link\n      className={cn(\n        \"flex items-center gap-3 px-4 py-3 rounded-2xl transition-all duration-300 group\",\n        isActive\n          ? \"bg-primary-50 dark:bg-primary-950 text-primary-600 dark:text-primary-300 shadow-sm shadow-primary-100/50\"\n          : \"text-slate-500 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 hover:text-slate-700 dark:hover:text-slate-200\"\n      )}\n      data-testid={testId}\n      to={to as \"/\"}\n    >\n      <div className={cn(\n        \"p-2 rounded-xl transition-colors\",\n        isActive\n          ? \"bg-white dark:bg-primary-900/30 shadow-sm\"\n          : \"bg-slate-50 dark:bg-slate-800 group-hover:bg-white dark:group-hover:bg-slate-700\"\n      )}>\n        {Icon ? <Icon className=\"h-4 w-4\" /> : null}\n      </div>\n      {!isCollapsed && <span className=\"font-bold text-sm truncate\">{label}</span>}\n    </Link>\n  );\n}\n\nfunction SidebarSection({\n  item,\n  isCollapsed,\n  openSections,\n  toggleSection,\n  location,\n}: {\n  isCollapsed: boolean;\n  item: MenuSectionType;\n  location: { pathname: string };\n  openSections: Partial<Record<string, boolean>>;\n  toggleSection: (section: string) => void;\n}) {\n  return (\n    <div className=\"space-y-2\">\n      {!isCollapsed && (\n        <button\n          className=\"flex w-full items-center justify-between px-4 py-3 min-h-[44px] text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-[0.25em] hover:text-primary-600 dark:hover:text-primary-400 transition-colors group\"\n          data-testid={item.testId}\n          onClick={() => { toggleSection(item.section); }}\n        >\n          <div className=\"flex items-center gap-2\">\n            <item.sectionIcon className=\"h-3 w-3 opacity-50 group-hover:opacity-100\" />\n            <span>{item.label}</span>\n          </div>\n          {openSections[item.section] ? <ChevronDown className=\"h-3 w-3\" /> : <ChevronRight className=\"h-3 w-3\" />}\n        </button>\n      )}\n      {!!(openSections[item.section] ?? isCollapsed) && (\n        <div className=\"space-y-1\">\n          {item.items.map((subItem) => (\n            <SidebarLink\n              icon={subItem.icon}\n              isActive={location.pathname === subItem.to}\n              isCollapsed={isCollapsed}\n              key={subItem.to}\n              label={subItem.label}\n              testId={subItem.testId}\n              to={subItem.to}\n            />\n          ))}\n        </div>\n      )}\n    </div>\n  );\n}\n\nexport default function Sidebar({ isOpen, onClose, openSections, toggleSection, isCollapsed }: SidebarProps) {\n  const { t } = useTranslation();\n  const location = useLocation();\n  const { hasAnyPermission } = useMyPermissions();\n  const { user } = useProfile();\n\n  const handleLogout = () => { localStorage.clear(); window.location.href = ROUTES.LOGIN; };\n\n  const menuItems: MenuItem[] = [\n    { to: ROUTES.HOME, icon: LayoutDashboard, label: t(\"common.dashboard\"), exact: true, testId: \"sidebar-link-dashboard\" },\n    {\n      section: \"org\", sectionIcon: Folder, label: t(\"common.sections.organization\"), testId: \"sidebar-section-org\", items: [\n        { to: ROUTES.EMPLOYEES, icon: UserRound, label: t(\"common.employees\"), testId: \"sidebar-link-employees\", permissions: [\"employees:read\"] },\n        { to: ROUTES.PEOPLE, icon: Users, label: t(\"members.title\", { defaultValue: \"Directory\" }), testId: \"sidebar-link-people\", permissions: [\"members:read\"] },\n        { to: ROUTES.DEPARTMENTS, icon: Building2, label: t(\"common.departments\"), testId: \"sidebar-link-departments\", permissions: [\"departments:read\"] }\n      ]\n    },\n    {\n      section: \"time\", sectionIcon: Timer, label: t(\"common.sections.time_leave\"), testId: \"sidebar-section-time\", items: [\n        { to: ROUTES.ATTENDANCE_LOGS, icon: CalendarCheck, label: t(\"attendance_logs.title\"), testId: \"sidebar-link-attendance-logs\", permissions: [\"attendance:logs:read\"] },\n        { to: ROUTES.LEAVE_REQUESTS, icon: Plane, label: t(\"leave_requests.title\"), testId: \"sidebar-link-leave-requests\", permissions: [\"leave:requests:read\"] },\n        { to: ROUTES.LEAVE_BALANCES, icon: Scale, label: t(\"common.leave_balances\"), testId: \"sidebar-link-leave-balances\", permissions: [\"leave:balances:read\"] },\n        { to: ROUTES.ATTENDANCE_ADJUSTMENTS, icon: ClipboardCheck, label: t(\"common.attendance_confirm\"), testId: \"sidebar-link-attendance-adjustments\", permissions: [\"attendance:adjustments:approve\"] },\n        { to: ROUTES.SHIFT_SWAPS, icon: ArrowLeftRight, label: t(\"shift_swaps.title\"), testId: \"sidebar-link-shift-swaps\", permissions: [\"shift_swaps:manage\"] },\n        { to: ROUTES.REPORTS, icon: BarChart3, label: t(\"common.reports\"), testId: \"sidebar-link-reports\", permissions: [\"reports:read\"] },\n        { to: ROUTES.APPROVALS_OT, icon: CheckCircle, label: \"OT Approvals\", testId: \"sidebar-link-approvals-ot\", permissions: [\"overtime:approve\"] }\n      ]\n    },\n    {\n      section: \"payroll\", sectionIcon: Wallet, label: t(\"common.sections.payroll_shifts\"), testId: \"sidebar-section-payroll\", items: [\n        { to: ROUTES.SHIFTS, icon: CalendarRange, label: t(\"common.shifts\"), testId: \"sidebar-link-shifts\", permissions: [\"shifts:read\"] },\n        { to: ROUTES.PAYROLL, icon: DollarSign, label: t(\"payroll.title\"), testId: \"sidebar-link-payroll\", permissions: [\"payroll:read\"] }\n      ]\n    },\n    {\n      section: \"system\", sectionIcon: Wrench, label: t(\"settings.title\"), testId: \"sidebar-section-system\", items: [\n        { to: ROUTES.INFRA_MONITOR, icon: Activity, label: t(\"monitor.title\"), testId: \"sidebar-link-monitor\", systemRoles: [\"platform_admin\", \"support\"] },\n        { to: ROUTES.SYSTEM_ROLES, icon: ShieldCheck, label: \"Platform Admins\", testId: \"sidebar-link-system-roles\", systemRoles: [\"platform_admin\"] },\n        { to: ROUTES.SETTINGS.ROOT, icon: Settings, label: t(\"settings.title\"), testId: \"sidebar-link-settings-root\", permissions: [\"workspace:settings:read\", \"members:roles:manage\"] }\n      ]\n    },\n    {\n      section: \"ess\", sectionIcon: User, label: t(\"common.sections.self_service\"), testId: \"sidebar-section-ess\", items: [\n        { to: ROUTES.ESS_PROFILE, icon: UserCircle, label: t(\"ess.profile.title\"), testId: \"sidebar-link-ess-profile\", permissions: [\"ess:profile\"] },\n        { to: ROUTES.ESS_ATTENDANCE, icon: History, label: t(\"ess.attendance.title\"), testId: \"sidebar-link-ess-attendance\", permissions: [\"ess:attendance\"] },\n        { to: ROUTES.ESS_CLOCK, icon: Clock, label: t(\"ess.clock.title\"), testId: \"sidebar-link-ess-clock\", permissions: [\"ess:clock\"] }\n      ]\n    }\n  ];\n\n  const filteredMenuItems = menuItems\n    .map((item) => {\n      if (\"section\" in item) {\n        const filteredItems = item.items.filter(\n          (subItem) => {\n            if (subItem.systemRoles && subItem.systemRoles.length > 0) {\n              return subItem.systemRoles.some((role: string) => user?.system_roles?.includes(role));\n            }\n            const permissions = subItem.permissions;\n            return !permissions || permissions.length === 0 || hasAnyPermission(...permissions);\n          }\n        );\n        return { ...item, items: filteredItems };\n      }\n      return item;\n    })\n    .filter((item) => {\n      if (\"section\" in item) {\n        return item.items.length > 0;\n      }\n      return true;\n    });\n\n  return (\n    <div className={cn(\"fixed inset-y-0 left-0 z-50 flex flex-col bg-white dark:bg-slate-950 border-r border-slate-100 dark:border-slate-800 transition-all duration-300 shadow-xl shadow-slate-200/50 dark:shadow-black/30\", isCollapsed ? \"w-20\" : \"w-72\", !isOpen && \"-translate-x-full lg:translate-x-0\")}>\n      <div className=\"flex h-24 items-center justify-between px-6 border-b border-slate-50 dark:border-slate-800\">\n        {!isCollapsed && <div className=\"flex items-center gap-3\"><div className=\"h-10 w-10 rounded-2xl bg-gradient-to-tr from-primary-600 to-primary-400 shadow-lg shadow-primary-200 flex items-center justify-center text-white font-black text-xl tracking-tighter italic\">L</div><span className=\"text-xl font-black tracking-tighter text-slate-800 dark:text-slate-200 uppercase italic\">Lee<span className=\"text-primary-600 dark:text-primary-400\">Attend</span></span></div>}\n        <button className=\"lg:hidden p-3 min-w-[44px] min-h-[44px] flex items-center justify-center text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 bg-slate-50 dark:bg-slate-800 rounded-xl transition-colors\" onClick={onClose}><X className=\"h-5 w-5\" /></button>\n      </div>\n      <div className=\"flex-1 overflow-y-auto custom-scrollbar px-4 py-6 space-y-8\">\n        {filteredMenuItems.map((item) => (\n          <div key={item.label}>\n            {\"section\" in item ? (\n              <SidebarSection\n                isCollapsed={isCollapsed}\n                item={item}\n                location={location}\n                openSections={openSections}\n                toggleSection={toggleSection}\n              />\n            ) : (\n              <SidebarLink\n                icon={item.icon}\n                isActive={item.exact ? location.pathname === item.to : location.pathname.startsWith(item.to)}\n                isCollapsed={isCollapsed}\n                label={item.label}\n                testId={item.testId}\n                to={item.to}\n              />\n            )}\n          </div>\n        ))}\n      </div>\n      <div className=\"p-4 border-t border-slate-50 dark:border-slate-800\">\n        <button className=\"flex w-full items-center gap-3 px-4 py-4 text-slate-400 dark:text-slate-500 hover:text-rose-600 dark:hover:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/30 rounded-2xl transition-all duration-300 group\" onClick={handleLogout}><div className=\"p-2 rounded-xl bg-slate-50 dark:bg-slate-800 group-hover:bg-white dark:group-hover:bg-slate-700 transition-colors\"><LogOut className=\"h-4 w-4\" /></div>{!isCollapsed && <span className=\"font-bold text-sm uppercase tracking-widest\">{t(\"common.logout\")}</span>}</button>\n      </div>\n    </div>\n  );\n}\n\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/layout/workspace-switcher.tsx","messages":[],"suppressedMessages":[{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/workspace/webdashboard/src/components/layout/workspace-switcher.tsx:28:7\n  26 |       const current = workspaces.find((ws) => ws.id === currentId) ?? workspaces[0];\n  27 |       // eslint-disable-next-line react-hooks/set-state-in-effect -- Derived state synced from props; intentional pattern\n> 28 |       setActiveWorkspace(current);\n     |       ^^^^^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  29 |       if (!currentId) setCurrentWorkspaceId(current.id);\n  30 |     }\n  31 |   }, [workspaces]);","line":28,"column":7,"nodeType":null,"endLine":28,"endColumn":25,"suppressions":[{"kind":"directive","justification":"Derived state synced from props; intentional pattern"}]}],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/layout/workspace-transition-overlay.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/leave/__tests__/assign-policy-modal.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/leave/__tests__/leave-balance-detail-modal.test.tsx","messages":[{"ruleId":"react/jsx-no-comment-textnodes","severity":2,"message":"Comments inside children section of tag should be placed inside braces","line":73,"column":49,"nodeType":"JSXText","messageId":"putCommentInBraces","endLine":75,"endColumn":9},{"ruleId":"react/jsx-no-comment-textnodes","severity":2,"message":"Comments inside children section of tag should be placed inside braces","line":101,"column":49,"nodeType":"JSXText","messageId":"putCommentInBraces","endLine":103,"endColumn":9}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { QueryClient, QueryClientProvider } from '@tanstack/react-query';\nimport { render, screen, fireEvent } from '@testing-library/react';\nimport React from 'react';\n\nimport { vi, describe, it, expect, beforeEach } from 'vitest';\n\nimport * as api from '@/lib/api';\n\nimport { LeaveBalanceDetailModal } from '../leave-balance-detail-modal';\n\n\n// Mock react-dom BEFORE imports that might use it\nvi.mock('react-dom', () => ({\n  createPortal: vi.fn((node: React.ReactNode) => node),\n}));\n\nvi.mock('react-i18next', () => ({\n  useTranslation: () => ({ t: (keyPath: string, fallback?: string) => fallback ?? keyPath }),\n}));\n\nvi.mock('@/lib/api', async () => {\n  const actual = await vi.importActual('@/lib/api');\n  return {\n    ...actual,\n    fetchLeaveHistory: vi.fn(),\n    getCurrentWorkspaceId: () => 'test-ws-id',\n  };\n});\n\nconst queryClient = new QueryClient({ defaultOptions: { queries: { retry: false } } });\n\ndescribe('LeaveBalanceDetailModal', () => {\n  const mockBalance = {\n    employee_id: 'emp-1',\n    employee_name: 'John Doe',\n    leave_type_id: 'lt-1',\n    leave_type_name: 'Annual Leave',\n    entitlement: 12,\n    accrued_amount: 5,\n    carried_over: 2,\n    used: 4,\n    remaining: 15,\n    year: 2026,\n  };\n\n  const mockHistory = [\n    {\n      id: 'h-1',\n      date: '2026-02-01',\n      transaction_type: 'usage',\n      amount: -2,\n      reason: 'Sick Leave',\n      created_at: '2026-02-01T00:00:00Z',\n    },\n    {\n      id: 'h-2',\n      date: '2026-01-15',\n      transaction_type: 'accrual',\n      amount: 1,\n      reason: 'Monthly Accrual',\n      created_at: '2026-01-15T00:00:00Z',\n    }\n  ];\n\n  beforeEach(() => {\n    vi.clearAllMocks();\n \n    vi.mocked(api.fetchLeaveHistory).mockResolvedValue(mockHistory as unknown as never);\n  });\n\n  it('renders balance breakdown and history', async () => {\n    render(\n      <QueryClientProvider client={queryClient}>\n// eslint-disable-next-line @typescript-eslint/no-explicit-any\n        <LeaveBalanceDetailModal balance={mockBalance as unknown as never} isOpen={true} onClose={vi.fn()} />\n      </QueryClientProvider>\n    );\n\n    // Check header\n    expect(screen.getByText('John Doe')).toBeDefined();\n    expect(screen.getByText('Annual Leave')).toBeDefined();\n\n    // Check hero balance\n    expect(screen.getByText('15')).toBeDefined();\n\n    // Check breakdown\n    expect(screen.getByText('12')).toBeDefined();\n    expect(screen.getByText('+5')).toBeDefined();\n    expect(screen.getByText('+2')).toBeDefined();\n    expect(screen.getByText('-4')).toBeDefined();\n\n    // Check history items\n    expect(await screen.findByText('Sick Leave')).toBeDefined();\n    expect(screen.getByText('Monthly Accrual')).toBeDefined();\n    expect(screen.getByText('-2')).toBeDefined();\n    expect(screen.getByText('+1')).toBeDefined();\n  });\n\n  it('filters history by tabs', async () => {\n    render(\n      <QueryClientProvider client={queryClient}>\n// eslint-disable-next-line @typescript-eslint/no-explicit-any\n        <LeaveBalanceDetailModal balance={mockBalance as unknown as never} isOpen={true} onClose={vi.fn()} />\n      </QueryClientProvider>\n    );\n\n    // Initial state: All items visible\n    expect(await screen.findByText('Sick Leave')).toBeDefined();\n    expect(screen.getByText('Monthly Accrual')).toBeDefined();\n\n    // Click Usage tab\n    const usageTab = screen.getByText('Sử dụng');\n    fireEvent.click(usageTab);\n\n    // Only usage should be visible\n    expect(screen.getByText('Sick Leave')).toBeDefined();\n    expect(screen.queryByText('Monthly Accrual')).toBeNull();\n\n    // Click Accruals tab\n    const accrualTab = screen.getByText('Tích lũy');\n    fireEvent.click(accrualTab);\n\n    // Only accrual should be visible\n    expect(screen.queryByText('Sick Leave')).toBeNull();\n    expect(screen.getByText('Monthly Accrual')).toBeDefined();\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/leave/__tests__/leave-history-modal.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/leave/__tests__/leave-policy-manager.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/leave/__tests__/leave-type-manager.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/leave/assign-policy-modal.tsx","messages":[{"ruleId":"complexity","severity":2,"message":"Function 'AssignPolicyModal' has a complexity of 13. Maximum allowed is 10.","line":26,"column":8,"nodeType":"FunctionDeclaration","messageId":"complex","endLine":26,"endColumn":34},{"ruleId":"@typescript-eslint/no-non-null-assertion","severity":2,"message":"Forbidden non-null assertion.","line":37,"column":145,"nodeType":"TSNonNullExpression","messageId":"noNonNull","endLine":37,"endColumn":150},{"ruleId":"@typescript-eslint/no-non-null-assertion","severity":2,"message":"Forbidden non-null assertion.","line":38,"column":146,"nodeType":"TSNonNullExpression","messageId":"noNonNull","endLine":38,"endColumn":151},{"ruleId":"@typescript-eslint/no-non-null-assertion","severity":2,"message":"Forbidden non-null assertion.","line":39,"column":112,"nodeType":"TSNonNullExpression","messageId":"noNonNull","endLine":39,"endColumn":117},{"ruleId":"@typescript-eslint/no-non-null-assertion","severity":2,"message":"Forbidden non-null assertion.","line":43,"column":143,"nodeType":"TSNonNullExpression","messageId":"noNonNull","endLine":43,"endColumn":148}],"suppressedMessages":[],"errorCount":5,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useQuery, useMutation, useQueryClient } from \"@tanstack/react-query\";\nimport { UserCircle, ShieldCheck, Building2 } from \"lucide-react\";\nimport React, { useState } from \"react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { format } from \"date-fns\";\n\nimport { Combobox } from \"@/components/ui/combobox\";\nimport Modal from \"@/components/ui/modal\";\nimport { useToast } from \"@/components/ui/toast\";\nimport { useAllEmployees } from \"@/hooks/use-employees\";\nimport {\n  fetchDepartments,\n  fetchLeavePolicies,\n  fetchLeaveTypes,\n  assignLeavePolicy,\n} from \"@/lib/api\";\n\n\ninterface AssignPolicyModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  wsId: string | null;\n}\n\nexport function AssignPolicyModal({ isOpen, onClose, wsId }: AssignPolicyModalProps) {\n  const { t } = useTranslation();\n  const toast = useToast();\n  const queryClient = useQueryClient();\n\n  const [assigneeType, setAssigneeType] = useState<string>(\"employee\");\n  const [assignEmpId, setAssignEmpId] = useState<string>(\"\");\n  const [assignDeptId, setAssignDeptId] = useState<string>(\"\");\n  const [assignPolicyId, setAssignPolicyId] = useState<string>(\"\");\n\n  const { employees, isLoading: employeesLoading } = useAllEmployees(wsId, { enabled: isOpen });\n  const { data: departments = [], isLoading: departmentsLoading } = useQuery({ queryKey: [\"departments\", wsId], queryFn: () => fetchDepartments(wsId!), enabled: isOpen && !!wsId });\n    const { data: policies = [], isLoading: policiesLoading } = useQuery({ queryKey: [\"leave-policies\", wsId], queryFn: () => fetchLeavePolicies(wsId!), enabled: isOpen && !!wsId });\n  const { data: leaveTypes = [] } = useQuery({ queryKey: [\"leave-types\", wsId], queryFn: () => fetchLeaveTypes(wsId!), enabled: isOpen && !!wsId });\n\n\n  const assignMutation = useMutation({\n    mutationFn: (data: { assignee_type: string; assignee_id: string | null; policy_id: string; effective_from: string }) => assignLeavePolicy(wsId!, data),\n    onSuccess: () => {\n      void queryClient.invalidateQueries({ queryKey: [\"leave-balances\"] });\n      void queryClient.invalidateQueries({ queryKey: [\"leave-policies\"] });\n      void queryClient.invalidateQueries({ queryKey: [\"leave-assignments\"] });\n      toast.success(t(\"leave_requests.policy.messages.assign_success\"));\n      onClose();\n    },\n  });\n\n  const handleAssignPolicy = (e: React.SyntheticEvent<HTMLFormElement>) => {\n    e.preventDefault();\n    if (!assignPolicyId) return;\n    if (assigneeType === 'employee' && !assignEmpId) return;\n    if (assigneeType === 'department' && !assignDeptId) return;\n\n    const formData = new FormData(e.currentTarget);\n    const assignee_id_raw = assigneeType === 'workspace' ? null : (assigneeType === 'department' ? assignDeptId : assignEmpId);\n    const effective_from = formData.get(\"effective_from\") as string;\n    \n    assignMutation.mutate({ assignee_type: assigneeType, assignee_id: (assignee_id_raw === \"\" || assignee_id_raw === null) ? null : assignee_id_raw, policy_id: assignPolicyId, effective_from });\n  };\n\n  return (\n    <Modal icon={<ShieldCheck size={24} />} isOpen={isOpen} maxWidth=\"md\" onClose={onClose} subtitle={t(\"leave_requests.policy.assign_subtitle\")} title={t(\"leave_requests.policy.assign_title\")}>\n      <form className=\"space-y-8 pt-4 animate-in fade-in duration-500\" onSubmit={handleAssignPolicy}>\n        <div className=\"space-y-2\">\n          <label className=\"text-[10px] font-bold text-primary-400 uppercase tracking-widest ml-1\" htmlFor=\"assignee-type\">{t(\"leave_requests.policy.table.type\")}</label>\n          <Combobox className=\"bg-slate-50 dark:bg-slate-800 border-primary-100 dark:border-primary-800/50 h-14\" data-testid=\"assign-type-select\" id=\"assignee-type\" onChange={setAssigneeType} options={[{ value: \"workspace\", label: t(\"leave_requests.policy.assignee_types.workspace\"), description: t(\"leave_requests.policy.assignee_types.workspace_desc\") }, { value: \"department\", label: t(\"leave_requests.policy.assignee_types.department\"), description: t(\"leave_requests.policy.assignee_types.department_desc\") }, { value: \"employee\", label: t(\"leave_requests.policy.assignee_types.employee\"), description: t(\"leave_requests.policy.assignee_types.employee_desc\") }]} value={assigneeType} />\n        </div>\n\n        {assigneeType === 'employee' && (\n          <div className=\"space-y-2 animate-in slide-in-from-top-2\">\n            <label className=\"text-[10px] font-bold text-primary-400 uppercase tracking-widest ml-1\" htmlFor=\"assign-emp\">{t(\"common.employee\")}</label>\n            <Combobox className=\"bg-slate-50 dark:bg-slate-800 border-primary-100 dark:border-primary-800/50 h-14\" data-testid=\"assign-emp-select\" id=\"assign-emp\" onChange={setAssignEmpId} options={employees.map(e => ({ value: e.id, label: e.full_name, description: e.employee_id_number, icon: <UserCircle size={14} /> }))} placeholder={employeesLoading ? t(\"common.loading\") : t(\"common.select_employee\")} value={assignEmpId} />\n          </div>\n        )}\n\n        {assigneeType === 'department' && (\n          <div className=\"space-y-2 animate-in slide-in-from-top-2\">\n            <label className=\"text-[10px] font-bold text-primary-400 uppercase tracking-widest ml-1\" htmlFor=\"assign-dept\">{t(\"common.department\")}</label>\n            <Combobox className=\"bg-slate-50 dark:bg-slate-800 border-primary-100 dark:border-primary-800/50 h-14\" id=\"assign-dept\" onChange={setAssignDeptId} options={departments.map(d => ({ value: d.id, label: d.name, icon: <Building2 size={14} /> }))} placeholder={departmentsLoading ? t(\"common.loading\") : t(\"common.select_department\")} value={assignDeptId} />\n          </div>\n        )}\n\n        <div className=\"space-y-2\">\n          <label className=\"text-[10px] font-bold text-primary-400 uppercase tracking-widest ml-1\" htmlFor=\"assign-policy\">{t(\"leave_requests.policy.title_single\")}</label>\n          <Combobox className=\"bg-slate-50 dark:bg-slate-800 border-primary-100 dark:border-primary-800/50 h-14\" data-testid=\"assign-policy-select\" id=\"assign-policy\" onChange={setAssignPolicyId} options={policies.map(p => ({ value: p.id, label: p.name, description: leaveTypes.find(t => t.id === p.leave_type_id)?.name ?? p.leave_type_id, icon: <ShieldCheck size={14} /> }))} placeholder={policiesLoading ? t(\"common.loading\") : t(\"leave_requests.policy.select_placeholder\")} value={assignPolicyId} />\n        </div>\n\n        <div className=\"space-y-2\">\n          <label className=\"text-[10px] font-bold text-primary-400 uppercase tracking-widest ml-1\" htmlFor=\"assign-date\">{t(\"common.effective_from\")}</label>\n          <input className=\"w-full px-5 py-4 text-primary-600 dark:text-primary-400 bg-slate-50 dark:bg-slate-800 border border-primary-100 dark:border-primary-800/50 rounded-2xl focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-bold text-sm tracking-tight\" defaultValue={format(new Date(), 'yyyy-MM-dd')} id=\"assign-date\" name=\"effective_from\" required type=\"date\" />\n        </div>\n\n        <div className=\"pt-4 flex gap-4\">\n          <button className=\"flex-1 px-8 py-4 bg-white dark:bg-slate-900 border border-primary-200 dark:border-primary-800/50 rounded-2xl font-bold text-xs uppercase tracking-widest text-primary-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-all\" onClick={onClose} type=\"button\">{t(\"common.cancel\")}</button>\n          <button className=\"flex-1 bg-primary-600 text-white rounded-2xl font-bold text-xs uppercase tracking-widest hover:bg-primary-700 transition-all shadow-xl shadow-primary-200 active:scale-95 disabled:opacity-50\" data-testid=\"submit-assign-policy-btn\" disabled={assignMutation.isPending} type=\"submit\">{assignMutation.isPending ? t(\"common.processing\").toUpperCase() : t(\"leave_requests.policy.assign_now_btn\").toUpperCase()}</button>\n        </div>\n      </form>\n    </Modal>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/leave/leave-balance-detail-modal.tsx","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Function 'LeaveBalanceDetailModal' has too many lines (172). Maximum allowed is 100.","line":17,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":208,"endColumn":2},{"ruleId":"@typescript-eslint/no-non-null-assertion","severity":2,"message":"Forbidden non-null assertion.","line":24,"column":38,"nodeType":"TSNonNullExpression","messageId":"noNonNull","endLine":24,"endColumn":43}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useQuery } from \"@tanstack/react-query\";\nimport { X, TrendingUp, Calendar, Award, ArrowUpRight, ArrowDownRight, History as HistoryIcon, Clock } from \"lucide-react\";\nimport { useState } from \"react\";\nimport { createPortal } from \"react-dom\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { Tabs, TabsList, TabsTrigger, TabsContent } from \"@/components/ui/tabs\";\nimport { WorkspaceLeaveBalance, fetchLeaveHistory, getCurrentWorkspaceId, LeaveHistoryItem } from \"@/lib/api\";\nimport { cn } from \"@/lib/utils\";\n\ninterface LeaveBalanceDetailModalProps {\n  balance: WorkspaceLeaveBalance;\n  isOpen: boolean;\n  onClose: () => void;\n}\n\nexport function LeaveBalanceDetailModal({ balance, isOpen, onClose }: LeaveBalanceDetailModalProps) {\n  const { t } = useTranslation();\n  const wsId = getCurrentWorkspaceId();\n  const [activeTab, setActiveTab] = useState(\"all\");\n\n  const { data: history = [], isLoading } = useQuery({\n    queryKey: [\"leave-history\", wsId, balance.employee_id, balance.leave_type_id],\n    queryFn: () => fetchLeaveHistory(wsId!, balance.employee_id, balance.leave_type_id),\n    enabled: isOpen && !!wsId,\n  });\n\n  if (!isOpen) return null;\n\n  const totalEntitled = balance.entitlement + balance.accrued_amount + balance.carried_over;\n  const usagePercent = Math.round((balance.used / (totalEntitled || 1)) * 100);\n\n  const accruals = history.filter(h => h.transaction_type === \"accrual\" || h.transaction_type === \"adjustment\" || h.transaction_type === \"carry_over\");\n  const usage = history.filter(h => h.transaction_type === \"usage\");\n\n  return createPortal(\n \n \n    <div className=\"fixed inset-0 z-[9999] flex items-center justify-center p-4 animate-in fade-in duration-300\">\n      {/* Backdrop */}\n      <div \n        className=\"absolute inset-0 bg-slate-900/20 backdrop-blur-md\"\n        onClick={onClose}\n        onKeyDown={(e) => {\n          if (e.key === 'Escape' || e.key === 'Enter' || e.key === ' ') {\n \n \n            onClose();\n          }\n        }}\n        role=\"presentation\"\n      />\n\n      {/* Modal Content */}\n      <div className=\"relative bg-white dark:bg-slate-900 rounded-3xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto animate-in zoom-in-95 slide-in-from-bottom-8 duration-500 flex flex-col\">\n        {/* Header */}\n        <div className=\"sticky top-0 bg-white dark:bg-slate-900 border-b border-slate-100 dark:border-slate-800 px-6 md:px-8 py-5 md:py-6 rounded-t-3xl z-10 flex-shrink-0\">\n          <div className=\"flex items-start justify-between gap-4\">\n            <div className=\"flex items-center gap-4 flex-1 min-w-0\">\n              <div className=\"w-14 h-14 bg-primary-50 dark:bg-primary-950 rounded-2xl flex items-center justify-center text-primary-600 dark:text-primary-400 font-bold text-base shadow-inner border border-primary-100 dark:border-primary-800/50 uppercase flex-shrink-0\">\n                {balance.employee_name.split(' ').map(n => n[0]).join('').slice(0, 2)}\n              </div>\n              <div className=\"flex-1 min-w-0\">\n                <h2 className=\"text-xl md:text-2xl font-bold text-slate-800 dark:text-slate-100 tracking-tight uppercase leading-tight truncate\">\n                  {balance.employee_name}\n                </h2>\n                <div className=\"flex items-center gap-2 mt-2\">\n                  <span className=\"inline-block px-3 py-1.5 bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300 rounded-xl text-xs font-bold uppercase tracking-wider border border-slate-200 dark:border-slate-700 shadow-sm\">\n                    {balance.leave_type_name}\n                  </span>\n                </div>\n              </div>\n            </div>\n            <button\n              aria-label={t(\"common.close\")}\n              className=\"p-2.5 text-slate-500 dark:text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 dark:text-slate-600 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-xl transition-all active:scale-90 flex-shrink-0 min-w-[44px] min-h-[44px]\"\n              onClick={onClose}\n            >\n              <X size={24} />\n            </button>\n          </div>\n        </div>\n\n        {/* Body */}\n        <div className=\"p-6 md:p-8 space-y-8 overflow-y-auto\">\n          {/* Hero Metric: Remaining Balance */}\n          <div className=\"bg-gradient-to-br from-primary-50 via-primary-50/50 to-transparent dark:from-primary-950 dark:via-primary-950/50 dark:to-transparent rounded-3xl p-8 border border-primary-100 dark:border-primary-800/50 shadow-inner\">\n            <div className=\"flex items-center gap-3 mb-3\">\n              <Award className=\"w-6 h-6 text-primary-600 dark:text-primary-400\" />\n              <div className=\"text-xs font-bold text-primary-600 dark:text-primary-400 uppercase tracking-[0.2em]\">\n                {t(\"leave_balances.table.remaining\")}\n              </div>\n            </div>\n            <div className={cn(\n              \"text-6xl md:text-7xl font-bold font-mono tracking-tighter\",\n              balance.remaining > 0 ? \"text-emerald-600 dark:text-emerald-300\" : \"text-slate-500 dark:text-slate-400\"\n            )}>\n              {balance.remaining}\n              <span className=\"text-2xl md:text-3xl ml-2 text-slate-500 dark:text-slate-400 font-bold uppercase tracking-tight\">\n                {t(\"common.days_short\", \"days\")}\n              </span>\n            </div>\n\n            {/* Usage Bar */}\n            <div className=\"mt-6 space-y-3\">\n              <div className=\"flex items-center justify-between text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider\">\n                <span>{t(\"leave_balances.table.usage\")}</span>\n                <span className=\"font-mono\">{usagePercent}%</span>\n              </div>\n              <div className=\"w-full h-3 bg-white dark:bg-slate-900/50 rounded-full overflow-hidden shadow-inner border border-primary-100 dark:border-primary-800/30\">\n                <div\n                  className={cn(\n                    \"h-full rounded-full transition-all duration-1000 shadow-sm\",\n                    usagePercent > 80 ? \"bg-rose-500 dark:bg-rose-400 shadow-rose-200\" :\n                      usagePercent > 50 ? \"bg-amber-500 dark:bg-amber-400 shadow-amber-200\" :\n                        \"bg-primary-600 shadow-primary-200\"\n                  )}\n                  style={{ width: `${Math.min(100, usagePercent)}%` }}\n                />\n              </div>\n            </div>\n          </div>\n\n          {/* Breakdown Section */}\n          <div className=\"space-y-4\">\n            <div className=\"flex items-center gap-3 pb-3 border-b border-slate-100 dark:border-slate-800\">\n              <TrendingUp className=\"w-5 h-5 text-slate-600 dark:text-slate-300\" />\n              <h3 className=\"text-sm font-bold text-slate-600 dark:text-slate-300 uppercase tracking-[0.15em]\">\n                {t(\"leave_balances.detail.breakdown\", \"Balance Breakdown\")}\n              </h3>\n            </div>\n\n            <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4\">\n              {/* Base Entitlement */}\n              <div className=\"bg-slate-50 dark:bg-slate-800 rounded-2xl p-4 border border-slate-100 dark:border-slate-800\">\n                <div className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1\">\n                  {t(\"leave_balances.table.base\")}\n                </div>\n                <div className=\"text-2xl font-bold font-mono text-slate-600 dark:text-slate-300\">\n                  {balance.entitlement}\n                </div>\n              </div>\n\n              {/* Accrued Amount */}\n              <div className=\"bg-primary-50 dark:bg-primary-950 rounded-2xl p-4 border border-primary-100 dark:border-primary-800\">\n                <div className=\"text-[10px] font-bold text-primary-600 dark:text-primary-400 uppercase tracking-wider mb-1\">\n                  {t(\"leave_balances.table.accrued\")}\n                </div>\n                <div className=\"text-2xl font-bold font-mono text-primary-600 dark:text-primary-400\">\n                  +{balance.accrued_amount}\n                </div>\n              </div>\n\n              {/* Carried Over */}\n              <div className=\"bg-amber-50 dark:bg-amber-950 rounded-2xl p-4 border border-amber-100 dark:border-amber-800\">\n                <div className=\"text-[10px] font-bold text-amber-600 dark:text-amber-300 uppercase tracking-wider mb-1\">\n                  {t(\"leave_balances.table.carried_over\")}\n                </div>\n                <div className=\"text-2xl font-bold font-mono text-amber-600 dark:text-amber-300\">\n                  +{balance.carried_over}\n                </div>\n              </div>\n\n              {/* Used */}\n              <div className=\"bg-rose-50 dark:bg-rose-950 rounded-2xl p-4 border border-rose-100 dark:border-rose-800\">\n                <div className=\"text-[10px] font-bold text-rose-600 dark:text-rose-300 uppercase tracking-wider mb-1\">\n                  {t(\"leave_balances.table.used\")}\n                </div>\n                <div className=\"text-2xl font-bold font-mono text-rose-600 dark:text-rose-300\">\n                  -{balance.used}\n                </div>\n              </div>\n            </div>\n          </div>\n\n          {/* History Section */}\n          <div className=\"space-y-4\">\n            <div className=\"flex items-center gap-3 pb-3 border-b border-slate-100 dark:border-slate-800\">\n              <HistoryIcon className=\"w-5 h-5 text-slate-600 dark:text-slate-300\" />\n              <h3 className=\"text-sm font-bold text-slate-600 dark:text-slate-300 uppercase tracking-[0.15em]\">\n                {t(\"leave_balances.detail.history\", \"Transaction History\")}\n              </h3>\n            </div>\n\n            <Tabs onValueChange={setActiveTab} value={activeTab}>\n              <TabsList className=\"bg-slate-50 dark:bg-slate-800 p-1 rounded-xl\">\n                <TabsTrigger value=\"all\">{t(\"leave_balances.detail.tabs.all\", \"Tất cả\")}</TabsTrigger>\n                <TabsTrigger value=\"accrual\">{t(\"leave_balances.detail.tabs.accruals\", \"Tích lũy\")}</TabsTrigger>\n                <TabsTrigger value=\"usage\">{t(\"leave_balances.detail.tabs.usage\", \"Sử dụng\")}</TabsTrigger>\n              </TabsList>\n\n              <TabsContent value=\"all\">\n                <HistoryList isLoading={isLoading} items={history} />\n              </TabsContent>\n              <TabsContent value=\"accrual\">\n                <HistoryList isLoading={isLoading} items={accruals} />\n              </TabsContent>\n              <TabsContent value=\"usage\">\n                <HistoryList isLoading={isLoading} items={usage} />\n              </TabsContent>\n            </Tabs>\n          </div>\n        </div>\n      </div>\n    </div>,\n    document.body\n  );\n}\n\nfunction HistoryList({ items, isLoading }: { items: LeaveHistoryItem[], isLoading: boolean }) {\n  const { t } = useTranslation();\n\n  if (isLoading) {\n    return (\n      <div className=\"space-y-4\">\n        {[1, 2, 3].map(index => (\n          <div className=\"h-20 bg-slate-50 dark:bg-slate-800 animate-pulse rounded-2xl\" key={index} />\n        ))}\n      </div>\n    );\n  }\n\n  if (items.length === 0) {\n    return (\n      <div className=\"py-12 text-center\">\n        <Clock className=\"w-12 h-12 text-slate-200 dark:text-slate-700 mx-auto mb-3\" />\n        <p className=\"text-sm font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest italic\">\n          {t(\"common.no_data\", \"No history found\")}\n        </p>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"space-y-3\">\n      {items.map((item) => (\n        <HistoryItemRow item={item} key={item.id} />\n      ))}\n    </div>\n  );\n}\n\nfunction HistoryItemRow({ item }: { item: LeaveHistoryItem }) {\n  const { t } = useTranslation();\n  const isPositive = item.amount > 0;\n\n  return (\n    <div className=\"flex items-center gap-4 p-4 bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-2xl hover:border-primary-100 dark:border-primary-800 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-all group\">\n      <div className={cn(\n        \"w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 shadow-sm transition-transform group-hover:scale-110\",\n        isPositive ? \"bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-300\" : \"bg-rose-50 dark:bg-rose-950 text-rose-600 dark:text-rose-300\"\n      )}>\n        {isPositive ? <ArrowUpRight size={18} /> : <ArrowDownRight size={18} />}\n      </div>\n\n      <div className=\"flex-1 min-w-0\">\n        <div className=\"flex items-center justify-between mb-0.5\">\n          <span className=\"font-bold text-slate-800 dark:text-slate-100 text-sm uppercase tracking-tight truncate\">\n            {item.reason ?? t(`leave_balances.transaction_type.${item.transaction_type}`)}\n          </span>\n          <span className={cn(\n            \"font-mono font-bold text-sm\",\n            isPositive ? \"text-emerald-600 dark:text-emerald-300\" : \"text-rose-600 dark:text-rose-300\"\n          )}>\n            {isPositive ? \"+\" : \"\"}{item.amount}\n          </span>\n        </div>\n        <div className=\"flex items-center gap-2 text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider\">\n          <Calendar size={10} />\n          {new Date(item.date).toLocaleDateString()}\n          <span className=\"w-1 h-1 bg-slate-200 dark:bg-slate-600 rounded-full\" />\n          {t(`leave_balances.transaction_type.${item.transaction_type}`)}\n        </div>\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/leave/leave-history-modal.tsx","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Function 'LeaveHistoryModal' has too many lines (113). Maximum allowed is 100.","line":27,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":149,"endColumn":2},{"ruleId":"complexity","severity":2,"message":"Function 'LeaveHistoryModal' has a complexity of 13. Maximum allowed is 10.","line":27,"column":8,"nodeType":"FunctionDeclaration","messageId":"complex","endLine":27,"endColumn":34}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useMutation, useQueryClient, useQuery } from \"@tanstack/react-query\";\nimport { Loader2, Plus, Minus, History, Calendar, MessageSquare, Info } from \"lucide-react\";\nimport { useState } from \"react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { format } from \"date-fns\";\n\nimport { useDateTimeFormatter } from \"@/hooks/use-datetime\";\nimport { adjustLeaveBalance, fetchLeaveHistory, fetchLeaveTypes } from \"@/lib/api\";\nimport { cn } from \"@/lib/utils\";\n\nimport Modal from \"../ui/modal\";\nimport { useToast } from \"../ui/toast\";\n\n\n\ninterface LeaveHistoryModalProps {\n  employeeId: string;\n  employeeName: string;\n  isOpen: boolean;\n  leaveTypeId?: string;\n  leaveTypeName?: string;\n  onClose: () => void;\n  wsId: string;\n}\n\nexport function LeaveHistoryModal({ wsId, employeeId, employeeName, leaveTypeId, leaveTypeName, isOpen, onClose }: LeaveHistoryModalProps) {\n  const { t } = useTranslation();\n  const queryClient = useQueryClient();\n  const toast = useToast();\n  const { formatDate } = useDateTimeFormatter();\n  const [activeTab, setActiveTab] = useState(\"history\");\n\n  const { data: history = [], isLoading } = useQuery({ queryKey: [\"leave-history\", wsId, employeeId, leaveTypeId], queryFn: () => fetchLeaveHistory(wsId, employeeId, leaveTypeId), enabled: isOpen });\n  const { data: leaveTypes = [] } = useQuery({ queryKey: [\"leave-types\", wsId], queryFn: () => fetchLeaveTypes(wsId), enabled: isOpen });\n\n  const adjustMutation = useMutation({\n    mutationFn: (data: { leave_type_id: string; amount: number; reason: string; transaction_date: string }) => adjustLeaveBalance(wsId, employeeId, data),\n    onSuccess: () => {\n      void queryClient.invalidateQueries({ queryKey: [\"leave-history\"] });\n      void queryClient.invalidateQueries({ queryKey: [\"workspace-leave-balances\"] });\n      toast.success(t(\"leave_balances.history.messages.adjust_success\")); setActiveTab(\"history\");\n    },\n  });\n\n  const [adjustForm, setAdjustForm] = useState({ type: \"add\", leave_type_id: leaveTypeId ?? \"\", amount: \"\", reason: \"\", date: format(new Date(), 'yyyy-MM-dd') });\n\n  const handleAdjustSubmit = (e: React.SyntheticEvent) => {\n    e.preventDefault(); const amount = parseFloat(adjustForm.amount);\n    if (isNaN(amount) || amount <= 0) return;\n    const typeId = adjustForm.leave_type_id || leaveTypes.find(t => t.code === \"vacation\")?.id;\n    if (!typeId) { toast.error(\"Please select a leave type\"); return; }\n    adjustMutation.mutate({ leave_type_id: typeId, amount: adjustForm.type === \"add\" ? amount : -amount, reason: adjustForm.reason, transaction_date: adjustForm.date });\n  };\n\n  const getTransactionColor = (type: string) => {\n    switch (type) {\n      case \"accrual\": return \"bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-300 border-emerald-100 dark:border-emerald-800\";\n      case \"usage\": return \"bg-rose-50 dark:bg-rose-950 text-rose-600 dark:text-rose-300 border-rose-100 dark:border-rose-800\";\n      case \"adjustment\": return \"bg-amber-50 dark:bg-amber-950 text-amber-600 dark:text-amber-300 border-amber-100 dark:border-amber-800\";\n      case \"carry_over\": return \"bg-blue-50 dark:bg-blue-950 text-blue-600 dark:text-blue-300 border-blue-100 dark:border-blue-800\";\n      default: return \"bg-slate-50 dark:bg-slate-800 text-slate-500 dark:text-slate-400 border-slate-100 dark:border-slate-800\";\n    }\n  };\n\n  return (\n    <Modal icon={<History size={24} />} isOpen={isOpen} maxWidth=\"2xl\" onClose={onClose} subtitle={t(\"leave_balances.history.subtitle\")} title={`${t(\"leave_balances.history.title\")}: ${employeeName}${leaveTypeName ? ` — ${leaveTypeName}` : ''}`}>\n      <div className=\"space-y-8 pt-4 animate-in fade-in duration-500\">\n        <div className=\"flex bg-slate-100 dark:bg-slate-700/50 p-1.5 rounded-[22px] w-fit border border-slate-200 dark:border-slate-700/50 shadow-inner\">\n          <button className={cn(\"flex items-center gap-2 px-8 py-2.5 rounded-[18px] text-xs font-bold uppercase tracking-widest transition-all\", activeTab === 'history' ? \"bg-white dark:bg-slate-900 text-primary-600 dark:text-primary-400 shadow-sm border border-slate-100 dark:border-slate-800\" : \"text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 dark:text-slate-700\")} onClick={() => { setActiveTab(\"history\"); }}>{t(\"leave_balances.history.tab_history\")}</button>\n          <button className={cn(\"flex items-center gap-2 px-8 py-2.5 rounded-[18px] text-xs font-bold uppercase tracking-widest transition-all\", activeTab === 'adjust' ? \"bg-white dark:bg-slate-900 text-primary-600 dark:text-primary-400 shadow-sm border border-slate-100 dark:border-slate-800\" : \"text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 dark:text-slate-700\")} onClick={() => { setActiveTab(\"adjust\"); }}>{t(\"leave_balances.history.tab_adjust\")}</button>\n        </div>\n\n        {activeTab === \"history\" ? (\n          <div className=\"animate-in fade-in slide-in-from-bottom-4 duration-500\">\n            {isLoading ? (\n              <div className=\"p-20 text-center\"><Loader2 className=\"animate-spin w-10 h-10 text-primary-600 dark:text-primary-400 mx-auto\" /></div>\n            ) : history.length > 0 ? (\n              <div className=\"bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-[2rem] overflow-hidden shadow-sm\">\n                <table className=\"w-full text-left border-collapse\">\n                  <thead>\n                    <tr className=\"bg-slate-50 dark:bg-slate-800/50 border-b border-slate-100 dark:border-slate-800\">\n                      <th className=\"px-6 py-4 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">{t(\"common.date\")}</th>\n                      <th className=\"px-6 py-4 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest text-center\">{t(\"common.type\")}</th>\n                      <th className=\"px-6 py-4 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest text-right\">{t(\"common.total\")}</th>\n                      <th className=\"px-6 py-4 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">{t(\"common.reason\")}</th>\n                    </tr>\n                  </thead>\n                  <tbody className=\"divide-y divide-slate-50 dark:divide-slate-800\">\n                    {history.map((item) => (\n                      <tr className=\"hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors group\" key={item.id}>\n                        <td className=\"px-6 py-5 text-xs font-bold text-slate-500 dark:text-slate-400 font-mono uppercase\">{formatDate(item.date)}</td>\n                        <td className=\"px-6 py-5 text-center\"><span className={cn(\"px-2.5 py-1 rounded-full text-[9px] font-bold uppercase tracking-widest border\", getTransactionColor(item.transaction_type))}>{item.transaction_type}</span></td>\n                        <td className={cn(\"px-6 py-5 text-right font-bold text-sm font-mono tracking-tighter\", item.amount > 0 ? \"text-emerald-600 dark:text-emerald-300\" : \"text-rose-600 dark:text-rose-300\")}>{item.amount > 0 ? \"+\" : \"\"}{item.amount}</td>\n                        <td className=\"px-6 py-5 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-tighter max-w-[200px] truncate\" title={item.reason ?? \"\"}>{item.reason ?? \"-\"}</td>\n                      </tr>\n                    ))}\n                  </tbody>\n                </table>\n              </div>\n            ) : (\n              <div className=\"py-20 text-center border-2 border-dashed border-slate-100 dark:border-slate-800 rounded-[2.5rem] bg-slate-50 dark:bg-slate-800/30 flex flex-col items-center\"><Info className=\"text-slate-200 dark:text-slate-700 mb-4\" size={32} /><p className=\"text-[10px] font-bold text-slate-300 dark:text-slate-600 uppercase tracking-widest\">{t(\"leave_balances.history.no_history\")}</p></div>\n            )}\n          </div>\n        ) : (\n          <form className=\"space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-500 pt-2\" onSubmit={handleAdjustSubmit}>\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n              <div className=\"space-y-3\">\n                <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">{t(\"leave_balances.history.action_label\")}</label>\n                <div className=\"grid grid-cols-2 gap-3 p-1.5 bg-slate-100 dark:bg-slate-700/50 rounded-2xl border border-slate-200 dark:border-slate-700/50 shadow-inner\">\n                  <button className={cn(\"flex items-center justify-center gap-2 py-3 rounded-xl text-xs font-bold uppercase tracking-widest transition-all\", adjustForm.type === \"add\" ? \"bg-white dark:bg-slate-900 text-emerald-600 dark:text-emerald-300 shadow-sm border border-slate-100 dark:border-slate-800\" : \"text-slate-500 dark:text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 dark:text-slate-600\")} onClick={() => { setAdjustForm({ ...adjustForm, type: \"add\" }); }} type=\"button\"><Plus size={14} /> {t(\"leave_balances.history.add\")}</button>\n                  <button className={cn(\"flex items-center justify-center gap-2 py-3 rounded-xl text-xs font-bold uppercase tracking-widest transition-all\", adjustForm.type === \"deduct\" ? \"bg-white dark:bg-slate-900 text-rose-600 dark:text-rose-300 shadow-sm border border-slate-100 dark:border-slate-800\" : \"text-slate-500 dark:text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 dark:text-slate-600\")} onClick={() => { setAdjustForm({ ...adjustForm, type: \"deduct\" }); }} type=\"button\"><Minus size={14} /> {t(\"leave_balances.history.deduct\")}</button>\n                </div>\n              </div>\n              <div className=\"space-y-3\">\n                <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">{t(\"leave_requests.policy.table.type\")}</label>\n                <select className=\"w-full px-5 py-4 bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-bold text-sm uppercase tracking-tight shadow-sm\" onChange={(e) => { setAdjustForm({ ...adjustForm, leave_type_id: e.target.value }); }} value={adjustForm.leave_type_id}>\n                  <option value=\"\">{t(\"common.select\")}</option>\n                  {leaveTypes.map(lt => <option key={lt.id} value={lt.id}>{lt.name}</option>)}\n                </select>\n              </div>\n            </div>\n\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n              <div className=\"space-y-3\">\n                <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">{t(\"leave_balances.history.amount_placeholder\").split('.')[0]}</label>\n                <input className=\"w-full px-5 py-4 bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-bold text-sm font-mono\" min=\"0.5\" onChange={(e) => { setAdjustForm({ ...adjustForm, amount: e.target.value }); }} placeholder={t(\"leave_balances.history.amount_placeholder\")} required step=\"0.5\" type=\"number\" value={adjustForm.amount} />\n              </div>\n              <div className=\"space-y-3\">\n                <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">{t(\"common.date\")}</label>\n                <div className=\"relative group\"><input className=\"w-full px-5 py-4 bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-bold text-sm\" onChange={(e) => { setAdjustForm({ ...adjustForm, date: e.target.value }); }} required type=\"date\" value={adjustForm.date} /><Calendar className=\"absolute right-4 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-300 dark:text-slate-600 group-focus-within:text-primary-500 dark:group-focus-within:text-primary-400 transition-colors\" /></div>\n              </div>\n            </div>\n\n            <div className=\"space-y-3\">\n              <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">{t(\"leave_balances.history.reason_label\")}</label>\n              <div className=\"relative group\"><textarea className=\"w-full px-5 py-4 bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none font-medium text-sm transition-all resize-none shadow-sm\" onChange={(e) => { setAdjustForm({ ...adjustForm, reason: e.target.value }); }} placeholder={t(\"leave_balances.history.reason_placeholder\")} required rows={3} value={adjustForm.reason} /><MessageSquare className=\"absolute right-4 top-4 w-4 h-4 text-slate-200 dark:text-slate-700 group-focus-within:text-primary-500 dark:group-focus-within:text-primary-400 transition-colors\" /></div>\n            </div>\n\n            <div className=\"flex gap-4 pt-4 border-t border-slate-50 dark:border-slate-800\">\n              <button className=\"flex-1 px-8 py-4 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-2xl font-bold text-xs uppercase tracking-widest text-slate-500 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-all\" onClick={onClose} type=\"button\">{t(\"common.cancel\")}</button>\n              <button className=\"flex-1 bg-primary-600 text-white rounded-2xl font-bold text-xs uppercase tracking-widest hover:bg-primary-700 transition-all shadow-xl shadow-slate-200 dark:shadow-black/30 active:scale-95 disabled:opacity-50 flex items-center justify-center gap-3\" disabled={adjustMutation.isPending} type=\"submit\">{adjustMutation.isPending ? <Loader2 className=\"animate-spin w-5 h-5\" /> : <Shield size={18} />} {t(\"leave_balances.history.confirm_btn\")}</button>\n            </div>\n          </form>\n        )}\n      </div>\n    </Modal>\n  );\n}\n\nfunction Shield({ className, size = 24 }: { className?: string; size?: number }) {\n  return (\n    <svg className={className} fill=\"none\" height={size} stroke=\"currentColor\" strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" viewBox=\"0 0 24 24\" width={size} xmlns=\"http://www.w3.org/2000/svg\">\n      <path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\" />\n    </svg>\n  );\n}","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/leave/leave-policy-manager.tsx","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Function 'LeavePolicyManager' has too many lines (107). Maximum allowed is 100.","line":33,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":151,"endColumn":2},{"ruleId":"max-lines-per-function","severity":1,"message":"Function 'PolicyModal' has too many lines (121). Maximum allowed is 100.","line":163,"column":1,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":297,"endColumn":2},{"ruleId":"complexity","severity":2,"message":"Function 'PolicyModal' has a complexity of 22. Maximum allowed is 10.","line":163,"column":1,"nodeType":"FunctionDeclaration","messageId":"complex","endLine":163,"endColumn":21}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useQuery, useMutation, useQueryClient } from \"@tanstack/react-query\";\nimport { Plus, Trash2, Clock, Pencil, ShieldCheck, Milestone, LayoutGrid } from \"lucide-react\";\nimport React, { useState } from \"react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { Combobox } from \"@/components/ui/combobox\";\nimport Modal from \"@/components/ui/modal\";\nimport { useToast } from \"@/components/ui/toast\";\nimport { useConfirm } from \"@/hooks/use-confirm\";\nimport { fetchLeavePolicies, createLeavePolicy, deleteLeavePolicy, updateLeavePolicy, fetchLeaveTypes } from \"@/lib/api/leaves\";\nimport { LeavePolicy } from \"@/lib/api/types\";\nconst FormRow = ({ label, children, info }: { label: string; children: React.ReactNode; info?: string }) => (\n  <div className=\"grid grid-cols-1 md:grid-cols-12 gap-4 items-center group\">\n    <div className=\"md:col-span-4 md:text-right\">\n      <label className=\"text-[10px] font-black text-slate-400 dark:text-slate-500 uppercase tracking-[0.2em] group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors\">\n        {label}\n      </label>\n    </div>\n    <div className=\"md:col-span-8 flex flex-col\">\n      <div className=\"w-full max-w-md\">\n        {children}\n      </div>\n      {!!info && <p className=\"text-[9px] text-slate-400 dark:text-slate-500 italic font-medium ml-1 mt-1\">{info}</p>}\n    </div>\n  </div>\n);\n\n\ninterface LeavePolicyManagerProps {\n  wsId: string;\n}\n\nexport function LeavePolicyManager({ wsId }: LeavePolicyManagerProps) {\n  const { t } = useTranslation();\n  const toast = useToast();\n  const queryClient = useQueryClient();\n  const [isCreating, setIsCreating] = useState(false);\n  const [editingPolicy, setEditingPolicy] = useState<LeavePolicy | null>(null);\n  const { confirm, ConfirmationDialog } = useConfirm();\n\n  const { data: policies = [], isLoading } = useQuery({\n    queryKey: [\"leave-policies\", wsId],\n    queryFn: () => fetchLeavePolicies(wsId),\n  });\n\n  const { data: leaveTypes = [] } = useQuery({\n    queryKey: [\"leave-types\", wsId],\n    queryFn: () => fetchLeaveTypes(wsId),\n  });\n\n  const deleteMutation = useMutation({\n    mutationFn: (id: string) => deleteLeavePolicy(wsId, id),\n    onSuccess: () => {\n      void queryClient.invalidateQueries({ queryKey: [\"leave-policies\"] });\n      toast.success(\"Policy deleted successfully\");\n    },\n  });\n\n  const handleDelete = async (id: string) => {\n    const ok = await confirm({\n      title: t(\"common.warning\", { defaultValue: \"Warning\" }),\n      message: t(\"leave.policy.confirm_delete\", { defaultValue: \"Delete this policy?\" }),\n      variant: \"danger\"\n    });\n    if (ok) deleteMutation.mutate(id);\n  };\n\n  const mutation = useMutation({\n    mutationFn: (data: Partial<LeavePolicy>) => \n      editingPolicy ? updateLeavePolicy(wsId, editingPolicy.id, data) : createLeavePolicy(wsId, data),\n    onSuccess: () => {\n      void queryClient.invalidateQueries({ queryKey: [\"leave-policies\"] });\n      toast.success(editingPolicy ? \"Policy updated\" : \"Policy created\");\n      setIsCreating(false);\n      setEditingPolicy(null);\n    },\n    onError: (error: Error) => { toast.error(error.message); },\n  });\n\n  const _calculateAnnualEntitlement = (policy: LeavePolicy) => {\n    const amount = policy.rule_config.accrual_amount;\n    switch (policy.rule_config.frequency) {\n      case \"monthly\": return amount * 12;\n      case \"quarterly\": return amount * 4;\n      case \"yearly\": return amount;\n      default: return amount;\n    }\n  };\n\n  if (isLoading) return <div className=\"p-12 text-center text-slate-400 dark:text-slate-500 animate-pulse font-bold uppercase tracking-widest text-[10px]\">Loading policies...</div>;\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex justify-end px-1\">\n         <button className=\"flex items-center gap-2 rounded-xl bg-primary-600 px-6 py-2.5 text-[10px] font-bold text-white uppercase tracking-widest hover:bg-primary-700 transition-all shadow-lg shadow-primary-100\" data-testid=\"add-policy-btn\" onClick={() => { setIsCreating(true); }}><Plus size={14} /> Create Policy</button>\n      </div>\n\n      <div className=\"grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3\">\n        {policies.length === 0 ? (\n          <div className=\"col-span-full py-20 bg-slate-50 dark:bg-slate-800 border-2 border-dashed border-slate-200 dark:border-slate-700 rounded-[2.5rem] flex flex-col items-center justify-center text-slate-400 dark:text-slate-500\">\n            <ShieldCheck className=\"mb-4 opacity-20\" size={40} />\n            <p className=\"text-xs font-bold uppercase tracking-widest\">No policies defined yet</p>\n          </div>\n        ) : policies.map((policy) => {\n          const type = leaveTypes.find(t => t.id === policy.leave_type_id);\n          const bonusCount = policy.rule_config.seniority_bonus.length || 0;\n          return (\n            <div className=\"relative flex flex-col justify-between rounded-[2rem] border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-7 shadow-sm hover:shadow-md transition-all group\" key={policy.id}>\n              <div>\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"inline-flex items-center rounded-lg bg-primary-50 dark:bg-primary-950 px-2.5 py-1 text-[9px] font-bold text-primary-600 dark:text-primary-400 uppercase tracking-widest border border-primary-100 dark:border-primary-800 shadow-sm\">\n                    {type?.name ?? \"Unknown\"}\n                  </span>\n                  <div className=\"flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity\">\n                    <button className=\"p-2 text-slate-400 dark:text-slate-500 hover:text-primary-600 dark:text-primary-400 bg-slate-50 dark:bg-slate-800 rounded-xl border border-slate-100 dark:border-slate-800\" data-testid=\"edit-policy-btn\" onClick={() => { setEditingPolicy(policy); }}><Pencil size={16} /></button>\n                    <button className=\"p-2 text-slate-400 dark:text-slate-500 hover:text-rose-600 dark:text-rose-300 bg-slate-50 dark:bg-slate-800 rounded-xl border border-slate-100 dark:border-slate-800\" data-testid=\"delete-policy-btn\" onClick={() => handleDelete(policy.id)}><Trash2 size={16} /></button>\n                  </div>\n                </div>\n                <h3 className=\"mt-5 text-lg font-bold text-slate-800 dark:text-slate-100 tracking-tight leading-none uppercase\">{policy.name}</h3>\n                \n                <div className=\"mt-6 p-4 bg-slate-50 dark:bg-slate-800 rounded-2xl border border-slate-100 dark:border-slate-800 space-y-3\">\n                  <div className=\"flex items-center justify-between\">\n                    <div className=\"flex items-center gap-2 text-slate-400 dark:text-slate-500\"><Clock size={14} /><span className=\"text-[10px] font-bold uppercase tracking-widest\">Base Accrual</span></div>\n                    <span className=\"text-[10px] font-bold text-slate-600 dark:text-slate-300 uppercase tracking-widest\">{policy.rule_config.accrual_amount} / {policy.rule_config.frequency}</span>\n                  </div>\n                  <div className=\"flex items-center justify-between\">\n                    <div className=\"flex items-center gap-2 text-slate-400 dark:text-slate-500\"><Milestone size={14} /><span className=\"text-[10px] font-bold uppercase tracking-widest\">Bonus Steps</span></div>\n                    <span className=\"text-[10px] font-bold text-primary-600 dark:text-primary-400 uppercase tracking-widest\">{bonusCount} steps</span>\n                  </div>\n                </div>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n\n      {!!(isCreating || editingPolicy) && (\n        <PolicyModal\n          isOpen={true}\n          isSaving={mutation.isPending}\n          leaveTypes={leaveTypes}\n          onClose={() => { setIsCreating(false); setEditingPolicy(null); }}\n          onSave={(data: Partial<LeavePolicy>) => { mutation.mutate(data); }}\n \n          policy={editingPolicy}\n        />\n      )}\n      <ConfirmationDialog />\n    </div>\n  );\n}\n\ninterface PolicyModalProps {\n \n  isOpen: boolean;\n  isSaving: boolean;\n  leaveTypes: { id: string; name: string }[];\n  onClose: () => void;\n  onSave: (data: Partial<LeavePolicy>) => void;\n  policy: LeavePolicy | null;\n}\n\nfunction PolicyModal({ isOpen, onClose, leaveTypes, policy, onSave, isSaving }: PolicyModalProps) {\n  const [formData, setFormData] = useState({\n    name: policy?.name ?? \"\",\n    description: policy?.description ?? \"\",\n    leave_type_id: policy?.leave_type_id ?? (leaveTypes.length > 0 ? leaveTypes[0].id : \"\"),\n    accrual_amount: policy?.rule_config.accrual_amount ?? 1.0,\n    frequency: (policy?.rule_config.frequency ?? \"monthly\"),\n    carry_over_limit: policy?.rule_config.carry_over_limit ?? 5,\n    min_work_days_threshold: policy?.rule_config.min_work_days_threshold ?? 14\n  });\n\n  const [seniorityBonus, setSeniorityBonus] = useState<{ min_years: number; extra_days: number }[]>(\n    policy?.rule_config.seniority_bonus ?? []\n  );\n\n  const addBonusMilestone = () => {\n    setSeniorityBonus([...seniorityBonus, { min_years: 1, extra_days: 1.0 }]);\n  };\n\n  const removeBonusMilestone = (index: number) => {\n    setSeniorityBonus(seniorityBonus.filter((_, index_) => index_ !== index));\n  };\n\n  const updateBonusMilestone = (index: number, field: \"min_years\" | \"extra_days\", value: number) => {\n    const next = [...seniorityBonus];\n    next[index] = { ...next[index], [field]: value };\n    setSeniorityBonus(next);\n  };\n\n  const handleSubmit = (e: React.SyntheticEvent) => {\n    e.preventDefault();\n    onSave({\n      ...formData,\n      rule_config: {\n        frequency: formData.frequency,\n        accrual_amount: formData.accrual_amount,\n        accrual_timing: \"start_of_period\",\n        carry_over_limit: formData.carry_over_limit,\n        min_work_days_threshold: formData.min_work_days_threshold,\n        seniority_bonus: seniorityBonus.sort((a, b) => a.min_years - b.min_years)\n      }\n    });\n  };\n\n\n\n  return (\n    <Modal isOpen={isOpen} maxWidth=\"lg\" onClose={onClose} title={policy ? \"Edit Policy\" : \"Create Leave Policy\"}>\n      <form className=\"p-8 space-y-12 max-h-[85vh] overflow-y-auto custom-scrollbar\" onSubmit={handleSubmit}>\n        {/* IDENTITY */}\n        <div className=\"space-y-8\">\n          <div className=\"flex items-center gap-3\">\n            { }\n            <div className=\"h-8 w-8 rounded-xl bg-primary-50 dark:bg-primary-950 flex items-center justify-center text-primary-600 dark:text-primary-400\"><LayoutGrid size={18} /></div>\n            <h4 className=\"text-sm font-black text-slate-800 dark:text-slate-100 uppercase tracking-tighter\">Identity</h4>\n          </div>\n          <div className=\"space-y-6 px-2\">\n            <FormRow label=\"Policy Name\">\n              <input className=\"w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-3 text-sm font-bold outline-none focus:ring-4 focus:ring-primary-500/5 transition-all h-[54px]\" id=\"policy-name\" onChange={(e) => { setFormData({...formData, name: e.target.value}); }} placeholder=\"e.g. Standard Policy\" required type=\"text\" value={formData.name} />\n            </FormRow>\n            <FormRow label=\"Leave Type\">\n              <Combobox className=\"bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-700 h-[54px] rounded-xl\" onChange={(value) => { setFormData({...formData, leave_type_id: value}); }} options={leaveTypes.map((t) => ({ value: t.id, label: t.name }))} value={formData.leave_type_id} />\n            </FormRow>\n          </div>\n        </div>\n\n        {/* ACCRUAL RULES */}\n        <div className=\"space-y-8\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"h-8 w-8 rounded-xl bg-emerald-50 dark:bg-emerald-950 flex items-center justify-center text-emerald-600 dark:text-emerald-300\"><Clock size={18} /></div>\n            <h4 className=\"text-sm font-black text-slate-800 dark:text-slate-100 uppercase tracking-tighter\">Accrual Logic</h4>\n          </div>\n          <div className=\"bg-slate-50 dark:bg-slate-800/50 p-10 rounded-[2.5rem] border border-slate-100 dark:border-slate-800 space-y-6\">\n            <FormRow info=\"Days to grant per period\" label=\"Base Amount\">\n              <input className=\"w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-3 text-sm font-bold font-mono text-center h-[54px]\" id=\"annual-entitlement\" onChange={(e) => { setFormData({...formData, accrual_amount: parseFloat(e.target.value)}); }} required step=\"0.1\" type=\"number\" value={formData.accrual_amount} />\n            </FormRow>\n            <FormRow label=\"Frequency\">\n              <select className=\"w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-3 text-sm font-bold uppercase h-[54px]\" onChange={(e) => { setFormData({...formData, frequency: e.target.value as \"monthly\" | \"quarterly\" | \"yearly\"}); }} value={formData.frequency}>\n                <option value=\"monthly\">Monthly</option>\n                <option value=\"quarterly\">Quarterly</option>\n                <option value=\"yearly\">Yearly</option>\n              </select>\n            </FormRow>\n            <FormRow info=\"Threshold to receive accrual\" label=\"Min Days Work\">\n              <input className=\"w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-3 text-sm font-bold font-mono text-center text-amber-600 dark:text-amber-300 h-[54px]\" onChange={(e) => { setFormData({...formData, min_work_days_threshold: parseFloat(e.target.value)}); }} required step=\"0.5\" type=\"number\" value={formData.min_work_days_threshold} />\n            </FormRow>\n            <FormRow info=\"Max days to carry over next year\" label=\"Carry Limit\">\n              <input className=\"w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-3 text-sm font-bold font-mono text-center h-[54px]\" onChange={(e) => { setFormData({...formData, carry_over_limit: parseInt(e.target.value)}); }} required type=\"number\" value={formData.carry_over_limit} />\n            </FormRow>\n          </div>\n        </div>\n\n        {/* SENIORITY BONUS */}\n        <div className=\"space-y-8\">\n          <div className=\"flex justify-between items-center px-1\">\n            <div className=\"flex items-center gap-3\">\n              <div className=\"h-8 w-8 rounded-xl bg-blue-50 dark:bg-blue-950 flex items-center justify-center text-blue-600\"><Milestone size={18} /></div>\n              <h4 className=\"text-sm font-black text-slate-800 dark:text-slate-100 uppercase tracking-tighter\">Service Bonuses</h4>\n            </div>\n            <button className=\"flex items-center gap-2 rounded-xl bg-primary-600 px-4 py-2 text-[10px] font-bold text-white uppercase tracking-widest hover:bg-primary-700 transition-all shadow-lg shadow-primary-100\" onClick={addBonusMilestone} type=\"button\"><Plus size={12} /> Add Row</button>\n          </div>\n          \n          <div className=\"space-y-8 px-2\">\n            {seniorityBonus.length === 0 ? (\n              <div className=\"py-10 text-center bg-white dark:bg-slate-900 border-2 border-dashed border-slate-100 dark:border-slate-800 rounded-[2rem] text-slate-400 dark:text-slate-500 italic text-xs\">No bonus milestones defined.</div>\n            ) : seniorityBonus.map((bonus, index) => (\n              <div className=\"space-y-6 pt-8 first:pt-0 border-t first:border-0 border-slate-100 dark:border-slate-800 animate-in slide-in-from-right-2 duration-300 relative group/row\" key={index}>\n                <div className=\"absolute -left-4 top-10 font-black text-[8px] text-slate-300 dark:text-slate-600 uppercase vertical-text tracking-widest\">Row {index + 1}</div>\n                \n                <FormRow label=\"After Years\">\n                  <input className=\"w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-3 text-sm font-bold font-mono text-center h-[54px] focus:ring-4 focus:ring-primary-500/5 transition-all outline-none\" onChange={(e) => { updateBonusMilestone(index, \"min_years\", parseInt(e.target.value)); }} type=\"number\" value={bonus.min_years} />\n                </FormRow>\n                \n                <FormRow label=\"Bonus Amount\">\n                  <div className=\"flex gap-4 w-full max-w-md\">\n                    <input className=\"flex-1 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-3 text-sm font-bold font-mono text-center text-primary-600 dark:text-primary-400 h-[54px] focus:ring-4 focus:ring-primary-500/5 transition-all outline-none\" onChange={(e) => { updateBonusMilestone(index, \"extra_days\", parseFloat(e.target.value)); }} step=\"0.5\" type=\"number\" value={bonus.extra_days} />\n                    <button className=\"p-4 text-slate-300 dark:text-slate-600 hover:text-rose-600 dark:text-rose-300 hover:bg-rose-50 dark:bg-rose-950 rounded-2xl transition-all h-[54px] flex items-center justify-center border border-transparent hover:border-rose-100 dark:border-rose-800 shadow-sm hover:shadow-md\" onClick={() => { removeBonusMilestone(index); }} type=\"button\"><Trash2 size={18} /></button>\n                  </div>\n                </FormRow>\n              </div>\n            ))}\n          </div>\n        </div>\n\n        {/* FOOTER */}\n        <div className=\"flex justify-end gap-4 pt-8 border-t border-slate-100 dark:border-slate-800 sticky bottom-0 bg-white dark:bg-slate-900 pb-2\">\n          <button className=\"px-8 py-3 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-[0.2em] hover:text-slate-600 dark:hover:text-slate-300 dark:text-slate-600\" onClick={onClose} type=\"button\">Cancel</button>\n          <button className=\"rounded-2xl bg-primary-600 px-10 py-4 text-xs font-black text-white uppercase tracking-[0.2em] shadow-2xl shadow-primary-200 hover:bg-primary-700 active:scale-95 transition-all\" data-testid=\"save-policy-btn\" disabled={isSaving} type=\"submit\">\n            {isSaving ? \"Saving...\" : (policy ? \"Update Policy\" : \"Create Policy\")}\n          </button>\n        </div>\n      </form>\n    </Modal>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/leave/leave-type-manager.tsx","messages":[{"ruleId":"@typescript-eslint/no-unnecessary-type-conversion","severity":2,"message":"Using !! on a boolean does not change the type or value of the boolean.","line":93,"column":8,"nodeType":null,"messageId":"unnecessaryTypeConversion","endLine":93,"endColumn":10,"suggestions":[{"messageId":"suggestRemove","fix":{"range":[5482,5496],"text":"isAddingType"},"desc":"Remove the type conversion."},{"messageId":"suggestSatisfies","data":{"type":"boolean"},"fix":{"range":[5482,5496],"text":"(isAddingType satisfies boolean)"},"desc":"Instead, assert that the value satisfies the boolean type."}]},{"ruleId":"react/no-unescaped-entities","severity":2,"message":"`\"` can be escaped with `&quot;`, `&ldquo;`, `&#34;`, `&rdquo;`.","line":99,"column":68,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&quot;"},"fix":{"range":[6122,6155],"text":"Are you sure you want to delete &quot;"},"desc":"Replace with `&quot;`."},{"messageId":"replaceWithAlt","data":{"alt":"&ldquo;"},"fix":{"range":[6122,6155],"text":"Are you sure you want to delete &ldquo;"},"desc":"Replace with `&ldquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#34;"},"fix":{"range":[6122,6155],"text":"Are you sure you want to delete &#34;"},"desc":"Replace with `&#34;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rdquo;"},"fix":{"range":[6122,6155],"text":"Are you sure you want to delete &rdquo;"},"desc":"Replace with `&rdquo;`."}]},{"ruleId":"react/no-unescaped-entities","severity":2,"message":"`\"` can be escaped with `&quot;`, `&ldquo;`, `&#34;`, `&rdquo;`.","line":99,"column":88,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&quot;"},"fix":{"range":[6174,6176],"text":"&quot;?"},"desc":"Replace with `&quot;`."},{"messageId":"replaceWithAlt","data":{"alt":"&ldquo;"},"fix":{"range":[6174,6176],"text":"&ldquo;?"},"desc":"Replace with `&ldquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#34;"},"fix":{"range":[6174,6176],"text":"&#34;?"},"desc":"Replace with `&#34;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rdquo;"},"fix":{"range":[6174,6176],"text":"&rdquo;?"},"desc":"Replace with `&rdquo;`."}]},{"ruleId":"@typescript-eslint/prefer-nullish-coalescing","severity":2,"message":"Prefer using nullish coalescing operator (`??`) instead of a logical or (`||`), as it is a safer operator.","line":139,"column":64,"nodeType":"Punctuator","messageId":"preferNullishOverOr","endLine":139,"endColumn":66,"suggestions":[{"messageId":"suggestNullish","data":{"equals":""},"fix":{"range":[8471,8473],"text":"??"},"desc":"Fix to nullish coalescing operator (`??`)."}]}],"suppressedMessages":[],"errorCount":4,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useQuery, useMutation, useQueryClient } from \"@tanstack/react-query\";\nimport { Wallet, AlertTriangle, Pencil, Plus, Trash2 } from \"lucide-react\";\nimport React, { useState } from \"react\";\n\nimport Modal from \"@/components/ui/modal\";\nimport { useToast } from \"@/components/ui/toast\";\nimport { fetchLeaveTypes, updateLeaveTypeConfig, createLeaveType, deleteLeaveType } from \"@/lib/api/leaves\";\nimport { LeaveType, LeaveTypeConfig } from \"@/lib/api/types\";\nimport { cn } from \"@/lib/utils\";\n\ninterface LeaveTypeManagerProps {\n  wsId: string;\n}\n\nexport function LeaveTypeManager({ wsId }: LeaveTypeManagerProps) {\n  const toast = useToast();\n  const queryClient = useQueryClient();\n  \n  const [editingType, setEditingType] = useState<LeaveType | null>(null);\n  const [isAddingType, setIsAddingType] = useState(false);\n  const [deletingType, setDeletingType] = useState<LeaveType | null>(null);\n\n  const { data: leaveTypes = [], isLoading: isTypesLoading } = useQuery({\n    queryKey: [\"leave-types\", wsId],\n    queryFn: () => fetchLeaveTypes(wsId),\n  });\n\n  const createTypeMutation = useMutation({\n    mutationFn: (data: { code: string; name: string; is_paid: boolean }) => createLeaveType(wsId, data),\n    onSuccess: () => {\n      void queryClient.invalidateQueries({ queryKey: [\"leave-types\"] });\n      toast.success(\"Leave type created successfully\");\n      setIsAddingType(false);\n    },\n    onError: (error: Error) => { toast.error(error.message); },\n  });\n\n  const updateTypeMutation = useMutation({\n    mutationFn: (data: { typeId: string; config: LeaveTypeConfig }) => updateLeaveTypeConfig(wsId, data.typeId, data.config),\n    onSuccess: () => {\n      void queryClient.invalidateQueries({ queryKey: [\"leave-types\"] });\n      toast.success(\"Leave type updated successfully\");\n      setEditingType(null);\n    },\n    onError: () => { toast.error(\"Failed to update leave type\"); },\n  });\n\n  const deleteTypeMutation = useMutation({\n    mutationFn: (typeId: string) => deleteLeaveType(wsId, typeId),\n    onSuccess: () => {\n      void queryClient.invalidateQueries({ queryKey: [\"leave-types\"] });\n      toast.success(\"Leave type deleted successfully\");\n      setDeletingType(null);\n    },\n    onError: (error: Error) => {\n      toast.error(error.message);\n      setDeletingType(null);\n    },\n  });\n\n  if (isTypesLoading) return <div className=\"py-12 text-center text-slate-400 dark:text-slate-500 animate-pulse\">Loading leave types...</div>;\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex justify-between items-center px-1\">\n         <p className=\"text-xs font-medium text-slate-500 dark:text-slate-400 max-w-md italic\">Define the categories of leave available in your organization (e.g., Annual Leave, Sick Leave).</p>\n         <button className=\"flex items-center gap-2 rounded-xl bg-primary-600 px-6 py-2.5 text-[10px] font-bold text-white uppercase tracking-widest hover:bg-primary-700 transition-all shadow-lg shadow-primary-100\" onClick={() => { setIsAddingType(true); }}><Plus size={14} /> Add Leave Type</button>\n      </div>\n      \n      <div className=\"grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3\">\n        {leaveTypes.map((type) => (\n          <div className=\"relative flex flex-col justify-between rounded-[2rem] border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-7 shadow-sm hover:shadow-md transition-all group\" key={type.id}>\n            <div>\n              <div className=\"flex items-center justify-between\">\n                <div className={cn(\"flex h-12 w-12 items-center justify-center rounded-2xl shadow-inner\", type.is_paid ? \"bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-300 border border-emerald-100 dark:border-emerald-800\" : \"bg-amber-50 dark:bg-amber-950 text-amber-600 dark:text-amber-300 border border-amber-100 dark:border-amber-800\")}>\n                  {type.is_paid ? <Wallet size={20} /> : <AlertTriangle size={20} />}\n                </div>\n                <div className=\"flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity\">\n                  <button className=\"p-2 text-slate-400 dark:text-slate-500 hover:text-primary-600 dark:text-primary-400 bg-slate-50 dark:bg-slate-800 rounded-xl border border-slate-100 dark:border-slate-800\" onClick={() => { setEditingType(type); }}><Pencil size={16} /></button>\n                  <button className=\"p-2 text-slate-400 dark:text-slate-500 hover:text-rose-600 dark:text-rose-300 bg-slate-50 dark:bg-slate-800 rounded-xl border border-slate-100 dark:border-slate-800\" onClick={() => { setDeletingType(type); }}><Trash2 size={16} /></button>\n                </div>\n              </div>\n              <h3 className=\"mt-5 text-lg font-bold text-slate-800 dark:text-slate-100 tracking-tight leading-none uppercase\">{type.name}</h3>\n              <p className=\"mt-1 text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest\">Code: {type.code}</p>\n              <div className=\"mt-4 flex gap-2\">\n                 <span className={cn(\"px-2.5 py-1 rounded-lg text-[9px] font-bold uppercase tracking-widest border\", type.is_paid ? \"bg-emerald-50 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300 border-emerald-100 dark:border-emerald-800\" : \"bg-amber-50 dark:bg-amber-950 text-amber-700 dark:text-amber-300 border-amber-100 dark:border-amber-800\")}>{type.is_paid ? \"Paid\" : \"Unpaid\"}</span>\n              </div>\n            </div>\n          </div>\n        ))}\n      </div>\n\n      {!!isAddingType && <AddLeaveTypeModal isSaving={createTypeMutation.isPending} onClose={() => { setIsAddingType(false); }} onSave={(data) => { createTypeMutation.mutate(data); }} />}\n      {!!editingType && <EditLeaveTypeModal isSaving={updateTypeMutation.isPending} leaveType={editingType} onClose={() => { setEditingType(null); }} onSave={(config: LeaveTypeConfig) => { updateTypeMutation.mutate({ typeId: editingType.id, config }); }} />}\n      { }\n      {!!deletingType && (\n        <Modal isOpen={true} onClose={() => { setDeletingType(null); }} title=\"Confirm Delete\">\n          <div className=\"p-8\">\n            <p className=\"text-sm\">Are you sure you want to delete \"{deletingType.name}\"?</p>\n            <div className=\"mt-8 flex justify-end gap-3\"><button className=\"px-6 py-2 text-xs font-bold text-slate-400 dark:text-slate-500\" onClick={() => { setDeletingType(null); }}>Cancel</button><button className=\"rounded-xl bg-rose-600 px-6 py-2.5 text-[10px] font-bold text-white uppercase\" onClick={() => { deleteTypeMutation.mutate(deletingType.id); }}>Delete</button></div>\n          </div>\n        </Modal>\n      )}\n    </div>\n  );\n}\n\ninterface AddLeaveTypeModalProps {\n  isSaving: boolean;\n \n  onClose: () => void;\n  onSave: (data: { code: string; name: string; is_paid: boolean }) => void;\n}\n\nfunction AddLeaveTypeModal({ onClose, onSave, isSaving }: AddLeaveTypeModalProps) {\n  const [formData, setFormData] = useState({ code: \"\", name: \"\", is_paid: true });\n  return (\n \n    <Modal isOpen={true} onClose={onClose} title=\"Add Leave Type\">\n      <form className=\"p-8 space-y-5\" onSubmit={(e) => { e.preventDefault(); onSave(formData); }}>\n        <input className=\"w-full rounded-2xl border p-4 text-sm\" onChange={(e) => { setFormData({ ...formData, code: e.target.value.toUpperCase() }); }} placeholder=\"Code\" required type=\"text\" value={formData.code} />\n        <input className=\"w-full rounded-2xl border p-4 text-sm\" onChange={(e) => { setFormData({ ...formData, name: e.target.value }); }} placeholder=\"Name\" required type=\"text\" value={formData.name} />\n        <div className=\"flex items-center gap-3\"><input checked={formData.is_paid} id=\"paid-leave-input\" onChange={(e) => { setFormData({ ...formData, is_paid: e.target.checked }); }} type=\"checkbox\" /><label className=\"text-xs font-bold uppercase\" htmlFor=\"paid-leave-input\">Paid Leave?</label></div>\n        <div className=\"flex justify-end gap-3 pt-6\"><button onClick={onClose} type=\"button\">Cancel</button><button className=\"rounded-xl bg-primary-600 px-8 py-3 text-xs font-bold text-white uppercase\" disabled={isSaving} type=\"submit\">Create</button></div>\n      </form>\n      { }\n    </Modal>\n  );\n}\n\ninterface EditLeaveTypeModalProps {\n  isSaving: boolean;\n  leaveType: LeaveType;\n  onClose: () => void;\n  onSave: (config: LeaveTypeConfig) => void;\n}\n\nfunction EditLeaveTypeModal({ leaveType, onClose, onSave, isSaving }: EditLeaveTypeModalProps) {\n  const [config, setConfig] = useState(leaveType.policy_config || { approval_required: true, requires_document: false, allow_negative_balance: false });\n  return (\n    <Modal isOpen={true} onClose={onClose} title={`Config: ${leaveType.name}`}>\n      <form className=\"p-8 space-y-4\" onSubmit={(e) => { e.preventDefault(); onSave(config); }}>\n        <div className=\"flex items-center gap-3\"><input checked={config.approval_required} id=\"approval-req-input\" onChange={(e) => { setConfig({ ...config, approval_required: e.target.checked }); }} type=\"checkbox\" /><label className=\"text-xs font-bold uppercase\" htmlFor=\"approval-req-input\">Approval Required</label></div>\n        <div className=\"flex justify-end gap-3 pt-6\"><button onClick={onClose} type=\"button\">Cancel</button><button className=\"rounded-xl bg-primary-600 px-8 py-3 text-xs font-bold text-white uppercase\" disabled={isSaving} type=\"submit\">Save</button></div>\n      </form>\n    </Modal>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/