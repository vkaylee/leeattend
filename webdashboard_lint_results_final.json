e-600 dark:text-blue-300 border-blue-100 dark:border-blue-800\",\n  slate: \"bg-slate-50 dark:bg-slate-800 text-slate-500 dark:text-slate-400 border-slate-100 dark:border-slate-800\",\n  rose: \"bg-rose-50 dark:bg-rose-950 text-rose-600 dark:text-rose-300 border-rose-100\",\n  primary: \"bg-primary-50 dark:bg-primary-950 text-primary-600 dark:text-primary-300 border-primary-100\",\n  emerald: \"bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-300 border-emerald-100\",\n};\n\nexport default function MemberTable() {\n  const { t } = useTranslation();\n  const { confirm, ConfirmationDialog } = useConfirm();\n  const { members, isLoading: membersLoading, removeMember } = useWorkspaceMembers();\n  const { roles, isLoading: rolesLoading } = useWorkspaceRoles();\n  const isLoading = membersLoading || rolesLoading;\n  const [selectedUserId, setSelectedUserId] = useState<string | null>(null);\n  const [isRoleModalOpen, setIsRoleModalOpen] = useState(false);\n  const [isPermModalOpen, setIsPermModalOpen] = useState(false);\n\n  const handleManageRoles = (userId: string) => { setSelectedUserId(userId); setIsRoleModalOpen(true); };\n  const handleManagePermissions = (userId: string) => { setSelectedUserId(userId); setIsPermModalOpen(true); };\n  const handleRemoveMember = async (userId: string) => { \n    const isConfirmed = await confirm({ title: t('common.warning', { defaultValue: 'Warning' }), message: t(\"members.table.confirm_remove\"), variant: 'danger' });\n    if (!isConfirmed) return; \n \n    try { await removeMember(userId); } catch (e: unknown) { console.error(e); } \n  };\n\n  if (isLoading) return <div className=\"flex justify-center py-32\"><div className=\"animate-spin rounded-full h-12 w-12 border-4 border-primary-600 border-t-transparent shadow-xl\"></div></div>;\n\n  return (\n    <>\n      <div className=\"bg-white dark:bg-slate-900 rounded-[3rem] border border-slate-100 dark:border-slate-800 shadow-sm overflow-hidden animate-in fade-in duration-700\">\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left border-collapse\">\n            <thead>\n              <tr className=\"bg-slate-50 dark:bg-slate-800/50 border-b border-slate-100 dark:border-slate-800\">\n                <th className=\"px-10 py-6 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em]\">{t(\"common.user\")}</th>\n                <th className=\"px-8 py-6 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em]\">{t(\"common.role\")}</th>\n                <th className=\"px-10 py-6 border-b border-slate-100 dark:border-slate-800\"></th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-50 dark:divide-slate-800\">\n              {members.map((member) => (\n                <tr className=\"group hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-all\" key={member.user_id}>\n                  <td className=\"px-10 py-6\">\n                    <div className=\"flex items-center gap-5\">\n                      <div className=\"w-14 h-14 rounded-2xl bg-primary-50 dark:bg-primary-950 flex items-center justify-center text-primary-600 dark:text-primary-400 font-bold shadow-inner border border-primary-100 dark:border-primary-800/50 overflow-hidden group-hover:scale-110 transition-transform\">\n                        {member.avatar_url ? (\n                          <img alt=\"Member avatar\" className=\"w-full h-full object-cover\" src={member.avatar_url} />\n                        ) : (\n                          <span className=\"text-lg uppercase\">{(member.full_name ?? member.email).substring(0, 2)}</span>\n                        )}\n                      </div>\n                      <div>\n                        <div className=\"font-bold text-slate-700 dark:text-slate-200 text-sm tracking-tight uppercase leading-none mb-1.5\">{member.full_name ?? t(\"common.no_name\")}</div>\n                        <div className=\"text-[10px] text-slate-500 dark:text-slate-400 font-mono font-bold flex items-center gap-2 opacity-70\">\n                          <Mail className=\"text-primary-400\" size={12} /> {member.email}\n                        </div>\n                      </div>\n                    </div>\n                  </td>\n                  <td className=\"px-8 py-6\">\n                    <div className=\"flex flex-wrap items-center gap-2\">\n                      {(() => {\n                        const primaryRole = roles.find(r => r.id === member.role_id);\n                        if (!primaryRole) return <span className=\"text-xs text-slate-400\">Loading...</span>;\n                        \n                        const extraRoles = (member.extra_role_ids || [])\n                          .map(id => roles.find(r => r.id === id))\n                          .filter(Boolean) as WorkspaceRole[];\n\n                        return (\n                          <>\n                            <span className={cn(\n                              \"inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest border shadow-sm\",\n                              roleColorMap[primaryRole.color] || roleColorMap.slate\n                            )}>\n                              {primaryRole.is_system && primaryRole.name.toLowerCase() === \"owner\" ? <Shield size={10} /> : null}\n                              {primaryRole.name}\n                            </span>\n                            \n                            {extraRoles.length > 0 && (\n                              <div className=\"relative group/badge\">\n                                <span className=\"inline-flex items-center justify-center min-w-[28px] h-[26px] px-1.5 rounded-full text-[10px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 cursor-help transition-colors group-hover/badge:bg-primary-50 group-hover/badge:text-primary-600 group-hover/badge:border-primary-200 dark:group-hover/badge:bg-primary-900/50 dark:group-hover/badge:border-primary-800\">\n                                  +{extraRoles.length}\n                                </span>\n                                \n                                {/* Premium Popover for extra roles */}\n                                <div className=\"absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-max max-w-[200px] opacity-0 invisible group-hover/badge:opacity-100 group-hover/badge:visible transition-all duration-300 ease-out translate-y-2 group-hover/badge:translate-y-0 z-10\">\n                                  <div className=\"p-3 bg-white/90 dark:bg-slate-900/90 backdrop-blur-xl rounded-2xl shadow-xl shadow-slate-200/50 dark:shadow-black/40 border border-slate-100 dark:border-slate-800 flex flex-col gap-2\">\n                                    <span className=\"text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest pb-1 border-b border-slate-100 dark:border-slate-800\">Extra Roles</span>\n                                    {extraRoles.map(er => (\n                                      <span className={cn(\n                                        \"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[9px] font-bold uppercase tracking-widest border\",\n                                        roleColorMap[er.color] || roleColorMap.slate\n                                      )} key={er.id}>\n                                        {er.name}\n                                      </span>\n                                    ))}\n                                  </div>\n                                </div>\n                              </div>\n                            )}\n                          </>\n                        );\n                      })()}\n                    </div>\n                  </td>\n                  <td className=\"px-10 py-6 text-right\">\n                    <div className=\"flex items-center justify-end gap-3 opacity-0 group-hover:opacity-100 transition-all duration-300 translate-x-2 group-hover:translate-x-0\">\n                      <PermissionGate permission=\"members:roles:manage\">\n                        <button className=\"p-3 bg-white dark:bg-slate-900 text-slate-500 dark:text-slate-400 hover:text-primary-600 dark:text-primary-400 rounded-xl shadow-md border border-slate-100 dark:border-slate-800 transition-all active:scale-90\" onClick={() => { handleManageRoles(member.user_id); }} title={t(\"members.table.manage_roles\")}><UserCog size={20} /></button>\n                      </PermissionGate>\n                      <PermissionGate permission=\"members:roles:manage\">\n                        <button className=\"p-3 bg-white dark:bg-slate-900 text-slate-500 dark:text-slate-400 hover:text-amber-600 dark:text-amber-400 rounded-xl shadow-md border border-slate-100 dark:border-slate-800 transition-all active:scale-90\" onClick={() => { handleManagePermissions(member.user_id); }} title={t(\"members.table.manage_permissions\", { defaultValue: \"Manage Permissions\" })}><KeyRound size={20} /></button>\n                      </PermissionGate>\n                      {roles.find(r => r.id === member.role_id)?.name.toLowerCase() !== \"owner\" && (\n                        <PermissionGate permission=\"members:remove\">\n                          <button className=\"p-3 bg-white dark:bg-slate-900 text-slate-500 dark:text-slate-400 hover:text-rose-600 dark:text-rose-300 rounded-xl shadow-md border border-slate-100 dark:border-slate-800 transition-all active:scale-90\" onClick={() => handleRemoveMember(member.user_id)} title={t(\"members.table.remove_member\")}><Trash2 size={20} /></button>\n                        </PermissionGate>\n                      )}\n                    </div>\n                  </td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n\n          {members.length === 0 && (\n            <div className=\"py-32 text-center bg-slate-50 dark:bg-slate-800/30 flex flex-col items-center\">\n              <UserIcon className=\"w-20 h-20 mb-6 text-slate-200 dark:text-slate-700\" />\n              <p className=\"text-[10px] font-bold text-slate-300 dark:text-slate-600 uppercase tracking-[0.25em]\">{t(\"members.table.messages.no_members\")}</p>\n            </div>\n          )}\n        </div>\n      </div>\n\n      {!!selectedUserId && <>\n          <RoleManagementModal isOpen={isRoleModalOpen} onClose={() => { setIsRoleModalOpen(false); }} userId={selectedUserId} />\n          <PermissionManagementModal isOpen={isPermModalOpen} onClose={() => { setIsPermModalOpen(false); }} userId={selectedUserId} />\n        </>}\n      <ConfirmationDialog />\n    </>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/payroll/__tests__/adjustment-drawer.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/payroll/__tests__/bonus-policy-manager.test.tsx","messages":[{"ruleId":"@typescript-eslint/require-await","severity":2,"message":"Async arrow function has no 'await' expression.","line":49,"column":60,"nodeType":"ArrowFunctionExpression","messageId":"missingAwait","endLine":49,"endColumn":62,"suggestions":[{"messageId":"removeAsync","fix":{"range":[1194,1200],"text":""},"desc":"Remove 'async'."}]},{"ruleId":"@typescript-eslint/require-await","severity":2,"message":"Async arrow function has no 'await' expression.","line":61,"column":51,"nodeType":"ArrowFunctionExpression","messageId":"missingAwait","endLine":61,"endColumn":53,"suggestions":[{"messageId":"removeAsync","fix":{"range":[1672,1678],"text":""},"desc":"Remove 'async'."}]}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { QueryClient, QueryClientProvider } from \"@tanstack/react-query\";\nimport { render, screen, fireEvent, waitFor } from \"@testing-library/react\";\n\nimport { describe, it, expect, vi, beforeEach } from \"vitest\";\n\nimport { ToastProvider } from \"@/components/ui/toast\";\nimport * as api from \"@/lib/api/payroll\";\n\nimport BonusPolicyManager from \"../bonus-policy-manager\";\n\n\n// Mock API\nvi.mock(\"@/lib/api/payroll\", () => ({\n  fetchIncentivePolicies: vi.fn(),\n  createIncentivePolicy: vi.fn(),\n  deleteIncentivePolicy: vi.fn(),\n}));\n\n// Mock i18next\nvi.mock(\"react-i18next\", () => ({\n  useTranslation: () => ({\n    t: (key: string) => key,\n  }),\n}));\n\nconst queryClient = new QueryClient({\n  defaultOptions: { queries: { retry: false } },\n});\n\nconst renderWithProviders = (ui: React.ReactNode) => {\n  return render(\n    <QueryClientProvider client={queryClient}>\n      <ToastProvider>\n        {ui}\n      </ToastProvider>\n    </QueryClientProvider>\n  );\n};\n\ndescribe(\"BonusPolicyManager\", () => {\n  const mockWsId = \"ws-123\";\n\n  beforeEach(() => {\n    vi.clearAllMocks();\n \n    vi.mocked(api.fetchIncentivePolicies).mockResolvedValue([]);\n  });\n\n  it(\"renders correctly and opens creation form\", async () => {\n    renderWithProviders(<BonusPolicyManager wsId={mockWsId} />);\n    \n    expect(screen.getByText(/payroll.incentives.title/i)).toBeDefined();\n    \n    const addButton = screen.getByText(/payroll.incentives.add_btn/i);\n    fireEvent.click(addButton);\n    \n    expect(screen.getByPlaceholderText(/e.g. Diligence Bonus/i)).toBeDefined();\n    expect(screen.getByText(/payroll.incentives.tiers_config/i)).toBeDefined();\n  });\n\n  it(\"allows adding and removing tiers\", async () => {\n    renderWithProviders(<BonusPolicyManager wsId={mockWsId} />);\n    fireEvent.click(screen.getByText(/payroll.incentives.add_btn/i));\n    \n    // Default has 2 tiers\n    expect(screen.getAllByText(/#/i).length).toBe(2);\n    \n    // Add tier\n    const addTierButton = screen.getByText(/common.add/i);\n    fireEvent.click(addTierButton);\n    expect(screen.getAllByText(/#/i).length).toBe(3);\n  });\n\n  it(\"submits policy data correctly\", async () => {\n \n    vi.mocked(api.createIncentivePolicy).mockResolvedValue({ id: \"p1\" } as unknown as never);\n    \n    renderWithProviders(<BonusPolicyManager wsId={mockWsId} />);\n    fireEvent.click(screen.getByText(/payroll.incentives.add_btn/i));\n    \n    const nameInput = screen.getByPlaceholderText(/e.g. Diligence Bonus/i);\n    fireEvent.change(nameInput, { target: { value: \"Monthly Diligence\" } });\n    \n    const saveButton = screen.getByText(/common.save_settings/i);\n    fireEvent.click(saveButton);\n    \n    await waitFor(() => {\n      expect(api.createIncentivePolicy).toHaveBeenCalledWith(mockWsId, expect.objectContaining({\n        name: \"Monthly Diligence\",\n        base_amount: 300000,\n        tiers: expect.any(Array) as unknown as unknown[]\n      }));\n    });\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/payroll/__tests__/employee-salary-config.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/payroll/__tests__/overtime-components.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/payroll/__tests__/payroll-detail-drawer.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/payroll/__tests__/payroll-priority-legend.test.tsx","messages":[{"ruleId":"@typescript-eslint/require-await","severity":2,"message":"Async arrow function has no 'await' expression.","line":20,"column":47,"nodeType":"ArrowFunctionExpression","messageId":"missingAwait","endLine":20,"endColumn":49,"suggestions":[{"messageId":"removeAsync","fix":{"range":[561,567],"text":""},"desc":"Remove 'async'."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { render, screen, fireEvent } from '@testing-library/react';\n\nimport { describe, it, expect, vi } from 'vitest';\n\nimport { PayrollPriorityLegend } from '../payroll-priority-legend';\n\n// Mock translation\nvi.mock(\"react-i18next\", () => ({\n  useTranslation: () => ({\n    t: (key: string) => key,\n  }),\n}));\n\ndescribe('PayrollPriorityLegend', () => {\n  it('renders correctly', () => {\n    render(<PayrollPriorityLegend />);\n    expect(screen.getByText('payroll.traceability.hierarchy_title')).toBeInTheDocument();\n  });\n\n  it('highlights the active source', async () => {\n    render(<PayrollPriorityLegend activeSource=\"department\" />);\n\n    // Expand the legend\n    const toggleButton = screen.getByRole('button');\n    fireEvent.click(toggleButton);\n\n    // Check for items\n    expect(screen.getByText('payroll.traceability.individual_policy')).toBeInTheDocument();\n    expect(screen.getByText('payroll.traceability.department_policy')).toBeInTheDocument();\n    expect(screen.getByText('payroll.traceability.workspace_default')).toBeInTheDocument();\n  });\n});","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/payroll/__tests__/payroll-rules-manager.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/payroll/__tests__/payroll-setting