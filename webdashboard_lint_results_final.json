:0,"source":"import * as Sentry from \"@sentry/react\";\nimport { QueryClient, QueryClientProvider } from \"@tanstack/react-query\";\nimport { RouterProvider } from \"@tanstack/react-router\";\nimport React, { Suspense } from \"react\";\n\nimport { ErrorBoundary } from \"./components/common/error-boundary\";\nimport { NewVersionBanner } from \"./components/common/new-version-banner\";\nimport { DarkModeProvider } from \"./context/dark-mode-context\";\nimport { DebugProvider } from \"./context/debug-context\";\nimport { useVersionCheck } from \"./hooks/use-version-check\";\nimport { createAppRouter } from \"./router\";\n\n\n\nconst queryClient = new QueryClient({\n  defaultOptions: {\n    queries: {\n      retry: 1,\n      staleTime: 1000 * 60 * 5, // 5 minutes\n      gcTime: 1000 * 60 * 10,   // GC inactive cache after 10 minutes\n    },\n  },\n});\n\nconst router = createAppRouter(queryClient);\n\nfunction AppContent() {\n  const { hasNewVersion, dismiss } = useVersionCheck();\n\n  return (\n    <>\n      {hasNewVersion && (\n        <NewVersionBanner\n          onDismiss={dismiss}\n          onRefresh={() => { window.location.reload(); }}\n        />\n      )}\n      <RouterProvider router={router} />\n    </>\n  );\n}\n\nfunction App() {\n  return (\n    <QueryClientProvider client={queryClient}>\n      <DebugProvider>\n        <DarkModeProvider>\n          <Sentry.ErrorBoundary fallback={(_error: unknown) => <ErrorBoundary>{null}</ErrorBoundary>}>\n            <Suspense fallback={<div className=\"flex h-screen items-center justify-center\">Loading...</div>}>\n              <AppContent />\n            </Suspense>\n          </Sentry.ErrorBoundary>\n        </DarkModeProvider>\n      </DebugProvider>\n    </QueryClientProvider>\n  );\n}\n\nexport default App;\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/__tests__/auth-guard.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixab