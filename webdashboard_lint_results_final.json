  <label className={LABEL_BASE}>{t(\"employees.table.name\")}</label>\n                    <div className=\"relative group\">\n                      <input className=\"w-full bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl px-6 py-4 focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all pr-14 font-bold text-sm tracking-tight shadow-sm\" onChange={(e) => { setFormData({ ...formData, full_name: e.target.value }); }} required value={formData.full_name} />\n                      <UserIcon className=\"absolute right-5 top-1/2 -translate-y-1/2 text-slate-300 dark:text-slate-600 group-focus-within:text-primary-500 dark:group-focus-within:text-primary-400 transition-colors\" size={20} />\n                    </div>\n                  </div>\n\n                  <div className=\"space-y-3 px-1\">\n                    <label className={LABEL_BASE}>{t(\"profile.preferred_language\")}</label>\n                    <Combobox className=\"bg-slate-50 dark:bg-slate-800 border-slate-100 dark:border-slate-800 h-14\" onChange={(value) => { setFormData({ ...formData, preferred_language: value }); }} options={[{ value: \"\", label: t(\"profile.follow_workspace\").toUpperCase(), icon: <Globe size={14} /> }, { value: \"vi\", label: t(\"common.languages.vi\").toUpperCase(), icon: <Globe size={14} /> }, { value: \"en\", label: t(\"common.languages.en\").toUpperCase(), icon: <Globe size={14} /> }, { value: \"zh\", label: t(\"common.languages.zh\").toUpperCase(), icon: <Globe size={14} /> }]} value={formData.preferred_language} />\n                  </div>\n                </div>\n\n                <div className=\"space-y-3 px-1\">\n                  <label className={LABEL_BASE}>{t(\"profile.bio\")}</label>\n                  <textarea className=\"w-full bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl px-6 py-4 focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-medium text-sm min-h-[140px] resize-none shadow-sm\" onChange={(e) => { setFormData({ ...formData, bio: e.target.value }); }} placeholder={t(\"profile.bio_placeholder\")} rows={3} value={formData.bio} />\n                </div>\n\n                <div className=\"pt-8 border-t border-slate-50 dark:border-slate-800 flex justify-end\">\n                  <Button icon={<Save size={18} />} loading={isUpdating} size=\"lg\" type=\"submit\">{isUpdating ? t(\"common.loading\").toUpperCase() : t(\"common.save\").toUpperCase()}</Button>\n                </div>\n              </form>\n            </div>\n          </div>\n        ) : null}\n\n        {activeTab === \"personalization\" ? (\n          <div className=\"max-w-5xl bg-white dark:bg-slate-900 rounded-[3rem] border border-slate-100 dark:border-slate-800 shadow-sm p-12 space-y-12 animate-in fade-in duration-500\">\n            <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-6 px-2\">\n              <div className=\"flex items-center gap-5\">\n                <div className=\"w-14 h-14 rounded-2xl bg-pink-50 flex items-center justify-center text-pink-600 shadow-inner border border-pink-100/50\"><Palette size={28} /></div>\n                <div>\n                  <h2 className=\"text-2xl font-bold text-slate-700 dark:text-slate-200 tracking-tighter uppercase leading-none mb-1\">{t(\"profile.personalization.title\")}</h2>\n                  <p className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest opacity-70\">{t(\"profile.personalization.subtitle\")}</p>\n                </div>\n              </div>\n              {Boolean(isOverridden) && <button className=\"flex items-center gap-3 text-[10px] font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400 hover:text-primary-600 dark:text-primary-400 transition-all bg-slate-50 dark:bg-slate-800 px-6 py-2.5 rounded-xl border border-slate-100 dark:border-slate-800 shadow-sm active:scale-95\" onClick={() => { setUserTheme(null); }}><Undo2 size={14} /> {t(\"profile.personalization.use_workspace_default\").toUpperCase()}</button>}\n            </div>\n\n            <div className=\"space-y-10\">\n              <div className=\"space-y-6\">\n                <label className={LABEL_BASE}>{t(\"common.workspace_settings.primary_color\")}</label>\n                <div className=\"flex flex-wrap gap-5 items-center\">\n                  {[\n                    { name: t(\"common.colors.emerald\"), color: '#10b981' }, { name: t(\"common.colors.blue\"), color: '#2563eb' },\n                    { name: t(\"common.colors.emerald\"), color: '#059669' }, { name: t(\"common.colors.amber\"), color: '#d97706' }, { name: t(\"common.colors.rose\"), color: '#e11d48' },\n                    { name: t(\"common.colors.slate\"), color: '#475569' }, { name: t(\"common.colors.black\"), color: '#0f172a' },\n                  ].map((preset) => (\n                    <button className={cn(\"w-14 h-14 rounded-2xl transition-all border-4 flex items-center justify-center shadow-lg group active:scale-90\", primaryColor === preset.color ? 'border-slate-900 scale-110' : 'border-white hover:scale-105 hover:border-slate-100 dark:border-slate-800')} key={preset.color} onClick={() => { setUserTheme(preset.color); }} style={{ backgroundColor: preset.color }} title={preset.name}>\n                      {primaryColor === preset.color && <div className=\"w-3 h-3 bg-white dark:bg-slate-900 rounded-full shadow-2xl animate-in zoom-in duration-300\" />}\n                    </button>\n                  ))}\n                  <div className=\"h-12 w-px bg-slate-100 dark:bg-slate-700 mx-2\" />\n                  <div className=\"flex items-center gap-4 bg-slate-50 dark:bg-slate-800 p-2.5 rounded-[1.5rem] border border-slate-100 dark:border-slate-800 shadow-inner group\">\n                    <input className=\"w-12 h-12 rounded-xl cursor-pointer bg-transparent border-none p-0 overflow-hidden shadow-sm\" onChange={(e) => { setUserTheme(e.target.value); }} type=\"color\" value={primaryColor} />\n                    <input className=\"bg-transparent border-none text-sm font-mono font-bold text-slate-600 dark:text-slate-300 w-24 outline-none tracking-tighter\" onChange={(e) => { setUserTheme(e.target.value); }} type=\"text\" value={primaryColor} />\n                  </div>\n                </div>\n              </div>\n              <div className=\"p-10 bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-[2.5rem] shadow-inner\"><p className=\"text-[11px] font-bold text-slate-500 dark:text-slate-400 leading-relaxed italic uppercase tracking-tight opacity-80\">{t(\"profile.personalization.note\")}</p></div>\n            </div>\n          </div>\n        ) : null}\n\n        {activeTab === \"security\" ? (\n          <div className=\"max-w-5xl bg-white dark:bg-slate-900 rounded-[3rem] border border-slate-100 dark:border-slate-800 shadow-sm p-12 space-y-12 animate-in fade-in duration-500\">\n            <div className=\"flex items-center gap-5\">\n              <div className=\"w-14 h-14 rounded-2xl bg-orange-50 dark:bg-orange-950 flex items-center justify-center text-orange-600 dark:text-orange-300 shadow-inner border border-orange-100/50\"><ShieldCheck size={28} /></div>\n              <div>\n                <h2 className=\"text-2xl font-bold text-slate-700 dark:text-slate-200 tracking-tighter uppercase leading-none mb-1\">{t(\"profile.security.title\")}</h2>\n                <p className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest opacity-70\">{t(\"profile.security.subtitle\")}</p>\n              </div>\n            </div>\n            <div className=\"bg-slate-50 dark:bg-slate-800/50 p-10 rounded-[2.5rem] border border-slate-100 dark:border-slate-800 shadow-inner\"><ChangePasswordForm /></div>\n          </div>\n        ) : null}\n      <