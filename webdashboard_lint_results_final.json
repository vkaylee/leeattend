[]},{"filePath":"/workspace/webdashboard/src/pages/ess/components/personal-info-section.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/ess/components/profile-hero.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/ess/my-attendance-page.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/ess/my-clock-page.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/ess/my-profile-page.tsx","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Function 'MyProfilePage' has too many lines (124). Maximum allowed is 100.","line":22,"column":16,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":160,"endColumn":2}],"suppressedMessages":[{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/workspace/webdashboard/src/pages/ess/my-profile-page.tsx:52:7\n  50 |     if (profile) {\n  51 |       // eslint-disable-next-line react-hooks/set-state-in-effect -- Syncing form data with profile from API\n> 52 |       setFormData({\n     |       ^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  53 |         address: profile.address ?? \"\",\n  54 |         bank_account_number: profile.bank_account_number ?? \"\",\n  55 |         bank_branch: profile.bank_branch ?? \"\",","line":52,"column":7,"nodeType":null,"endLine":52,"endColumn":18,"suppressions":[{"kind":"directive","justification":"Syncing form data with profile from API"}]}],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { AlertCircle, CreditCard, User as UserIcon, Users } from \"lucide-react\";\nimport { useEffect, useState } from \"react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { TFunction } from \"i18next\";\n\nimport { useToast } from \"@/components/ui/toast\";\nimport { useConfirm } from \"@/hooks/use-confirm\";\nimport { useEmergencyContacts, useMyProfile } from \"@/hooks/use-ess\";\nimport { cn } from \"@/lib/utils\";\n\nimport { AddContactModal, NewContactData } from \"./components/add-contact-modal\";\nimport { BankDetailsFormData, BankDetailsSection } from \"./components/bank-details-section\";\nimport { EmergencyContactsSection } from \"./components/emergency-contacts-section\";\nimport { PersonalInfoFormData, PersonalInfoSection } from \"./components/personal-info-section\";\nimport { ProfileHero } from \"./components/profile-hero\";\n\ntype TabType = \"personal\" | \"banking\" | \"emergency\";\n\ntype FullProfileFormData = BankDetailsFormData & PersonalInfoFormData;\n\nexport default function MyProfilePage() {\n  const { t } = useTranslation();\n  const toast = useToast();\n  const { ConfirmationDialog, confirm } = useConfirm();\n  const { employee, isError, isLoading, isUpdating, profile, updateProfile } = useMyProfile();\n  const { addContact, contacts, deleteContact, isAdding, isDeleting } = useEmergencyContacts();\n\n  const [activeTab, setActiveTab] = useState<TabType>(\"personal\");\n  const [formData, setFormData] = useState<FullProfileFormData>({\n    address: \"\",\n    bank_account_number: \"\",\n    bank_branch: \"\",\n    bank_name: \"\",\n    date_of_birth: \"\",\n    gender: \"\",\n    national_id: \"\",\n    phone: \"\",\n  });\n\n  const [isContactModalOpen, setIsContactModalOpen] = useState(false);\n  const [newContact, setNewContact] = useState<NewContactData>({\n    contact_name: \"\",\n    is_primary: false,\n    phone: \"\",\n    relationship: \"\",\n  });\n\n  useEffect(() => {\n    if (profile) {\n      // eslint-disable-next-line react-hooks/set-state-in-effect -- Syncing form data with profile from API\n      setFormData({\n        address: profile.address ?? \"\",\n        bank_account_number: profile.bank_account_number ?? \"\",\n        bank_branch: profile.bank_branch ?? \"\",\n        bank_name: profile.bank_name ?? \"\",\n        date_of_birth: profile.date_of_birth ?? \"\",\n        gender: profile.gender ?? \"\",\n        national_id: profile.national_id ?? \"\",\n        phone: profile.phone ?? \"\",\n      });\n    }\n  }, [profile]);\n\n  async function handleSubmit(e: React.SyntheticEvent) {\n    e.preventDefault();\n    try {\n      await updateProfile(formData);\n      toast.success(t(\"ess.profile.update_success\"));\n    } catch (error) {\n      console.error(error);\n    }\n  }\n\n  async function handleAddContact(e: React.SyntheticEvent) {\n    e.preventDefault();\n    try {\n      await addContact(newContact);\n      setNewContact({ contact_name: \"\", is_primary: false, phone: \"\", relationship: \"\" });\n      setIsContactModalOpen(false);\n      toast.success(t(\"ess.emergency_contact.add_success\"));\n    } catch (error) {\n      console.error(error);\n    }\n  }\n\n  async function handleDeleteContact(contactId: string) {\n    const ok = await confirm({\n      message: t(\"ess.emergency_contact.confirm_delete\"),\n      title: t(\"common.confirm_delete\", \"Confirm Delete\"),\n      variant: \"danger\",\n    });\n    if (!ok) return;\n    try {\n      await deleteContact(contactId);\n      toast.success(t(\"ess.emergency_contact.delete_success\"));\n    } catch (error) {\n      console.error(error);\n    }\n  }\n\n  if (isLoading) return <LoadingState />;\n\n  if (isError || !employee) {\n    return <ErrorState t={t} />;\n  }\n\n  return (\n    <div className=\"space-y-10 animate-in fade-in duration-700 pb-20\">\n      <Header activeTab={activeTab} setActiveTab={setActiveTab} t={t} />\n\n      <div className=\"animate-in slide-in-from-bottom-8 duration-700\">\n        <ProfileHero employee={employee} />\n\n        {activeTab === \"personal\" && (\n          <PersonalInfoSection\n            formData={formData}\n            handleSubmit={handleSubmit}\n            isUpdating={isUpdating}\n            setFormData={(data) => {\n              setFormData((prev) => ({ ...prev, ...data }));\n            }}\n          />\n        )}\n\n        {activeTab === \"banking\" && (\n          <BankDetailsSection\n            formData={formData}\n            handleSubmit={handleSubmit}\n            isUpdating={isUpdating}\n            setFormData={(data) => {\n              setFormData((prev) => ({ ...prev, ...data }));\n            }}\n          />\n        )}\n\n        {activeTab === \"emergency\" && (\n          <EmergencyContactsSection\n            contacts={contacts}\n            handleDeleteContact={handleDeleteContact}\n            isDeleting={isDeleting}\n            setIsContactModalOpen={setIsContactModalOpen}\n          />\n        )}\n      </div>\n\n      <AddContactModal\n        handleAddContact={handleAddContact}\n        isAdding={isAdding}\n        isOpen={isContactModalOpen}\n        newContact={newContact}\n        onClose={() => {\n          setIsContactModalOpen(false);\n        }}\n        setNewContact={setNewContact}\n      />\n      <ConfirmationDialog />\n    </div>\n  );\n}\n\nfunction Header({\n  activeTab,\n  setActiveTab,\n  t,\n}: {\n  activeTab: TabType;\n  setActiveTab: (tab: TabType) => void;\n  t: TFunction;\n}) {\n  return (\n    <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-8 px-2\">\n      <div className=\"space-y-1\">\n        <h1 className=\"text-4xl font-bold tracking-tighter text-slate-700 dark:text-slate-200 uppercase leading-none\">\n          {t(\"ess.my_profile\")}\n        </h1>\n        <p className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em] opacity-60\">\n          {t(\"ess.profile.subtitle\")}\n        </p>\n      </div>\n\n      <div className=\"flex bg-slate-100 dark:bg-slate-700/50 p-1.5 rounded-[22px] w-fit border border-slate-200 dark:border-slate-700/50 shadow-inner\">\n        <TabButton\n          active={activeTab === \"personal\"}\n          icon={<UserIcon size={14} />}\n          label={t(\"ess.personal_info\")}\n          onClick={() => {\n            setActiveTab(\"personal\");\n          }}\n        />\n        <TabButton\n          active={activeTab === \"banking\"}\n          icon={<CreditCard size={14} />}\n          label={t(\"ess.bank_details\")}\n          onClick={() => {\n            setActiveTab(\"banking\");\n          }}\n        />\n        <TabButton\n          active={activeTab === \"emergency\"}\n          icon={<Users size={14} />}\n          label={t(\"ess.emergency_contacts\")}\n          onClick={() => {\n            setActiveTab(\"emergency\");\n          }}\n        />\n      </div>\n    </div>\n  );\n}\n\nfunction LoadingState() {\n  return (\n    <div className=\"p-20 text-center\">\n      <div className=\"w-10 h-10 border-4 border-primary-600 border-t-transparent rounded-full animate-spin mx-auto\"></div>\n    </div>\n  );\n}\n\nfunction ErrorState({ t }: { t: TFunction }) {\n  return (\n    <div className=\"p-8\">\n      <div className=\"bg-rose-50 dark:bg-rose-950 border-2 border-rose-100 dark:border-rose-800 rounded-[3rem] p-12 flex items-center gap-8 shadow-2xl shadow-rose-100/50\">\n        <div className=\"bg-white dark:bg-slate-900 p-5 rounded-[1.5rem] shadow-sm border border-rose-100 dark:border-rose-800 text-rose-500\">\n          <AlertCircle size={40} />\n        </div>\n        <div>\n          <h3 className=\"text-2xl font-bold text-rose-900 uppercase tracking-tighter leading-none mb-2\">\n            {t(\"ess.no_employee_linked\")}\n          </h3>\n          <p className=\"font-bold text-rose-600 dark:text-rose-300 uppercase tracking-tight text-sm opacity-80\">\n            {t(\"ess.contact_hr\")}\n          </p>\n        </div>\n      </div>\n    </div>\n  );\n}\n\nfunction TabButton({\n  active,\n  icon,\n  label,\n  onClick,\n}: {\n  active: boolean;\n  icon: React.ReactNode;\n  label: string;\n  onClick: () => void;\n}) {\n  return (\n    <button\n      className={cn(\n        \"flex items-center gap-2 px-8 py-2.5 rounded-[18px] text-xs font-bold uppercase tracking-widest transition-all\",\n        active\n          ? \"bg-white dark:bg-slate-900 text-primary-600 dark:text-primary-400 shadow-sm border border-slate-100 dark:border-slate-800\"\n          : \"text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200\"\n      )}\n      onClick={onClick}\n    >\n      {icon} {label}\n    </button>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/leave-balances-page.tsx","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Function 'LeaveBalancesPage' has too many lines (233). Maximum allowed is 100.","line":17,"column":16,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":274,"endColumn":2},{"ruleId":"complexity","severity":2,"message":"Function 'LeaveBalancesPage' has a complexity of 26. Maximum allowed is 10.","line":17,"column":16,"nodeType":"FunctionDeclaration","messageId":"complex","endLine":17,"endColumn":42}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useQuery, useMutation, useQueryClient } from \"@tanstack/react-query\";\nimport { Search, Filter, History, PlayCircle, Eye, ChevronLeft, ChevronRight, Calendar } from \"lucide-react\";\nimport { useState, useCallback } from \"react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { LeaveBalanceDetailModal } from \"@/components/leave/leave-balance-detail-modal\";\nimport { LeaveHistoryModal } from \"@/components/leave/leave-history-modal\";\nimport { Combobox } from \"@/components/ui/combobox\";\nimport { useToast } from \"@/components/ui/toast\";\nimport { useConfirm } from \"@/hooks/use-confirm\";\nimport { useDebounce } from \"@/hooks/use-debounce\";\nimport { fetchWorkspaceLeaveBalances, getCurrentWorkspaceId, triggerAccrualRun, fetchJobStatus } from \"@/lib/api\";\nimport { WorkspaceLeaveBalance } from \"@/lib/api/types\";\nimport { cn } from \"@/lib/utils\";\n\n\nexport default function LeaveBalancesPage() {\n  const { t } = useTranslation();\n  const toast = useToast();\n  const queryClient = useQueryClient();\n  const wsId = getCurrentWorkspaceId();\n  const [searchTerm, setSearchTerm] = useState(\"\");\n  const [page, setPage] = useState(1);\n  const [selectedYear, setSelectedYear] = useState(new Date().getFullYear());\n  const { confirm, ConfirmationDialog } = useConfirm();\n  const limit = 20;\n  const debouncedSearch = useDebounce(searchTerm, 500);\n\n  // Generate year options: current year ± 2\n  const currentYear = new Date().getFullYear();\n  const yearOptions = Array.from({ length: 5 }, (_, index) => currentYear - 2 + index);\n\n  const [selectedEmployee, setSelectedEmployee] = useState<{ id: string, name: string, leaveTypeId?: string, leaveTypeName?: string } | null>(null);\n  const [selectedBalance, setSelectedBalance] = useState<WorkspaceLeaveBalance | null>(null);\n\n  const { data: paginatedData, isLoading } = useQuery({\n    queryKey: [\"workspace-leave-balances\", wsId, page, debouncedSearch, selectedYear],\n    queryFn: () => {\n      if (!wsId) throw new Error(\"Workspace ID is required\");\n      return fetchWorkspaceLeaveBalances(wsId, { page, limit, q: debouncedSearch, year: selectedYear });\n    },\n    enabled: !!wsId,\n    placeholderData: (previousData) => previousData\n  });\n\n  const pollJobStatus = useCallback(async (jobId: string) => {\n    const POLL_INTERVAL = 2000; // 2 seconds\n    const MAX_POLLS = 60; // 2 min max\n\n    for (let index = 0; index < MAX_POLLS; index++) {\n      await new Promise(resolve => setTimeout(resolve, POLL_INTERVAL));\n      try {\n        if (!wsId) return;\n        const status = await fetchJobStatus(wsId, jobId);\n        if (status.status === 'completed') {\n          void queryClient.invalidateQueries({ queryKey: [\"workspace-leave-balances\"] });\n          toast.success(t(\"leave_balances.accrual_completed\"));\n          return;\n        }\n        if (status.status === 'failed') {\n          toast.error(status.error_message ?? t(\"common.error\"));\n          return;\n        }\n        // Still processing — continue polling\n      } catch {\n        // Network error — stop polling\n        toast.error(t(\"common.error\"));\n        return;\n      }\n    }\n    // Timed out\n    toast.error(t(\"leave_balances.accrual_timeout\"));\n  }, [wsId, queryClient, toast, t]);\n\n  const accrualMutation = useMutation({\n    mutationFn: () => {\n      if (!wsId) throw new Error(\"Workspace ID is required\");\n      return triggerAccrualRun(wsId, { date: new Date().toISOString().split('T')[0] });\n    },\n    onSuccess: (data) => {\n      if (data.status === 'queued' && data.job_id) {\n        toast.success(t(\"leave_balances.accrual_queued\"));\n        void pollJobStatus(data.job_id);\n      } else {\n        void queryClient.invalidateQueries({ queryKey: [\"workspace-leave-balances\"] });\n        toast.success(data.message || t(\"common.success\"));\n      }\n    },\n    onError: () => { toast.error(t(\"common.error\")); }\n  });\n\n  const balances = paginatedData?.data ?? [];\n  const totalItems = paginatedData?.total ?? 0;\n  const totalPages = Math.ceil(totalItems / limit);\n\n  return (\n    <div className=\"space-y-10 animate-in fade-in duration-700 pb-20\">\n      <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-6 px-2\">\n        <div className=\"space-y-1\">\n          <h1 className=\"text-3xl md:text-5xl font-bold tracking-tighter text-slate-800 dark:text-slate-100 uppercase leading-none\">{t(\"leave_balances.title\")}</h1>\n          <p className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em] opacity-60\">{t(\"leave_balances.subtitle\")}</p>\n        </div>\n        <button\n          className=\"bg-primary-600 hover:bg-primary-700 text-white font-bold px-6 md:px-8 py-3.5 md:py-3 rounded-2xl flex items-center justify-center gap-3 shadow-xl shadow-primary-100 transition-all active:scale-95 text-xs uppercase tracking-widest disabled:opacity-50 min-h-[44px] w-full md:w-auto\"\n          disabled={accrualMutation.isPending || selectedYear !== currentYear}\n          onClick={async () => {\n            const ok = await confirm({\n              title: t(\"leave_balances.run_accrual\"),\n              message: t(\"leave_balances.confirm_accrual\"),\n              variant: \"warning\"\n            });\n            if (ok) accrualMutation.mutate();\n          }}\n          title={selectedYear !== currentYear ? t(\"leave_balances.accrual_current_year_only\") : undefined}\n        >\n          <PlayCircle size={18} /> <span className=\"whitespace-nowrap\">{accrualMutation.isPending ? t(\"common.processing\").toUpperCase() : t(\"leave_balances.run_accrual\").toUpperCase()}</span>\n        </button>\n      </div>\n\n      <div className=\"bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-3xl md:rounded-[3rem] overflow-hidden shadow-sm animate-in slide-in-from-bottom-8 duration-700\">\n        <div className=\"p-5 md:p-8 border-b border-slate-50 dark:border-slate-800 flex flex-col md:flex-row md:items-center justify-between gap-5 md:gap-6 bg-slate-50 dark:bg-slate-800/30\">\n          <div className=\"flex items-center gap-3\">\n            <Filter className=\"w-5 h-5 text-primary-600 dark:text-primary-400\" />\n            <h2 className=\"text-lg md:text-xl font-bold text-slate-800 dark:text-slate-100 tracking-tight uppercase\">{t(\"leave_balances.summary_table\")}</h2>\n            {totalItems > 0 && (\n              <span className=\"px-2 py-0.5 bg-slate-200 dark:bg-slate-600 text-slate-600 dark:text-slate-300 rounded-full text-xs font-bold\">\n                {totalItems}\n              </span>\n            )}\n            {/* Year Selector */}\n            <div className=\"flex items-center gap-2 ml-2\">\n              <Calendar className=\"w-4 h-4 text-slate-400 dark:text-slate-500\" />\n              <Combobox\n                className=\"w-24 bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider focus:ring-2 focus:ring-primary-500/20 py-[5px]\"\n                onChange={(value) => {\n                  if (value) {\n                    setSelectedYear(Number(value));\n                    setPage(1);\n                  }\n                }}\n                options={yearOptions.map(y => ({ value: y.toString(), label: y.toString() }))}\n                placeholder=\"Select Year\"\n                value={selectedYear.toString()}\n              />\n            </div>\n          </div>\n\n          <div className=\"relative group w-full md:w-80\">\n            <Search className=\"absolute left-4 md:left-5 top-1/2 -translate-y-1/2 text-slate-300 dark:text-slate-600 group-focus-within:text-primary-500 dark:group-focus-within:text-primary-400 transition-colors\" size={18} />\n            <input className=\"w-full pl-12 md:pl-14 pr-5 md:pr-6 py-3.5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-2xl focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-bold text-sm tracking-tight shadow-sm min-h-[44px]\" onChange={(e) => {\n                setSearchTerm(e.target.value);\n                setPage(1); // Reset to page 1 on search\n              }} placeholder={t(\"common.search_placeholder\")} type=\"text\" value={searchTerm}\n            />\n          </div>\n        </div>\n\n        {/* Desktop Table View (≥1024px) - Simplified 5 Columns */}\n        <div className=\"hidden lg:block overflow-x-auto\">\n          <table className=\"w-full text-left border-collapse\">\n            <thead>\n              <tr className=\"bg-slate-50 dark:bg-slate-800/50 border-b border-slate-100 dark:border-slate-800\">\n                <th className=\"px-6 py-5 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.2em]\">{t(\"common.employee\")}</th>\n                <th className=\"px-5 py-5 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.2em]\">{t(\"common.type\")}</th>\n                <th className=\"px-5 py-5 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.2em] text-right\">{t(\"leave_balances.table.remaining\")}</th>\n                <th className=\"px-5 py-5 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.2em]\">{t(\"leave_balances.table.usage\")}</th>\n                <th className=\"px-6 py-5 text-right text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.2em]\">{t(\"common.actions\")}</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-50 dark:divide-slate-800\">\n              {isLoading && !balances.length ? (\n                <tr><td className=\"px-6 py-20 text-center text-slate-500 dark:text-slate-400 font-bold italic uppercase tracking-widest text-xs opacity-50 animate-pulse\" colSpan={5}>{t(\"common.loading\")}</td></tr>\n              ) : balances.length === 0 ? (\n                <tr><td className=\"px-6 py-32 text-center text-slate-500 dark:text-slate-400 font-bold italic uppercase tracking-widest text-xs opacity-50\" colSpan={5}>{t(\"attendance_logs.messages.no_data\")}</td></tr>\n              ) : (balances).map((balance, index) => (\n                <DesktopBalanceRow\n                  balance={balance}\n                  key={`${balance.employee_id}-${balance.leave_type_id}-${index}`}\n                  onViewDetails={() => { setSelectedBalance(balance); }}\n                  onViewHistory={() => { setSelectedEmployee({ id: balance.employee_id, name: balance.employee_name, leaveTypeId: balance.leave_type_id, leaveTypeName: balance.leave_type_name }); }}\n                />\n              ))}\n            </tbody>\n          </table>\n        </div>\n\n        {/* Tablet/Mobile Card View (<1024px) - Simplified */}\n        <div className=\"lg:hidden divide-y divide-slate-100 dark:divide-slate-800\">\n          {isLoading && !balances.length ? (\n            <div className=\"px-5 py-20 text-center text-slate-500 dark:text-slate-400 font-bold italic uppercase tracking-widest text-xs opacity-50 animate-pulse\">{t(\"common.loading\")}</div>\n          ) : balances.length === 0 ? (\n            <div className=\"px-5 py-32 text-center text-slate-500 dark:text-slate-400 font-bold italic uppercase tracking-widest text-xs opacity-50\">{t(\"attendance_logs.messages.no_data\")}</div>\n          ) : (balances).map((balance, index) => (\n            <MobileBalanceCard\n              balance={balance}\n              key={`${balance.employee_id}-${balance.leave_type_id}-${index}`}\n              onViewDetails={() => { setSelectedBalance(balance); }}\n              onViewHistory={() => { setSelectedEmployee({ id: balance.employee_id, name: balance.employee_name, leaveTypeId: balance.leave_type_id, leaveTypeName: balance.leave_type_name }); }}\n            />\n          ))}\n        </div>\n\n        {/* Pagination Controls */}\n        {totalItems > 0 && (\n          <div className=\"p-5 md:p-8 border-t border-slate-50 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/30 flex flex-col md:flex-row items-center justify-between gap-4\">\n            <div className=\"text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider\">\n              {t(\"common.showing\")} <span className=\"text-slate-600 dark:text-slate-300\">{(page - 1) * limit + 1}</span> - <span className=\"text-slate-600 dark:text-slate-300\">{Math.min(page * limit, totalItems)}</span> {t(\"common.of\")} <span className=\"text-slate-600 dark:text-slate-300\">{totalItems}</span>\n            </div>\n\n            <div className=\"flex items-center gap-2\">\n              <button\n                className=\"p-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 disabled:opacity-50 disabled:cursor-not-allowed transition-colors\"\n                disabled={page === 1}\n                onClick={() => { setPage(p => Math.max(1, p - 1)); }}\n              >\n                <ChevronLeft className=\"w-4 h-4 text-slate-600 dark:text-slate-300\" />\n              </button>\n\n              <div className=\"flex items-center gap-1\">\n                {Array.from({ length: Math.min(5, totalPages) }, (_, index) => {\n                  // Simple logic to show window around current page\n                  let p = index + 1;\n                  if (totalPages > 5) {\n                    if (page > 3) p = page - 2 + index;\n                    if (p > totalPages) p = totalPages - (4 - index);\n                  }\n\n                  return (\n                    <button\n                      className={cn(\n                        \"w-8 h-8 flex items-center justify-center rounded-xl text-xs font-bold transition-all\",\n                        page === p\n                          ? \"bg-primary-600 text-white shadow-md shadow-primary-100\"\n                          : \"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800\"\n                      )}\n                      key={p}\n                      onClick={() => { setPage(p); }}\n                    >\n                      {p}\n                    </button>\n                  );\n                })}\n              </div>\n\n              <button\n                className=\"p-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 disabled:opacity-50 disabled:cursor-not-allowed transition-colors\"\n                disabled={page === totalPages}\n                onClick={() => { setPage(p => Math.min(totalPages, p + 1)); }}\n              >\n                <ChevronRight className=\"w-4 h-4 text-slate-600 dark:text-slate-300\" />\n              </button>\n            </div>\n          </div>\n        )}\n      </div>\n\n      {Boolean(selectedEmployee && wsId) && (\n        <LeaveHistoryModal\n          employeeId={selectedEmployee?.id ?? \"\"}\n          employeeName={selectedEmployee?.name ?? \"\"}\n          isOpen={Boolean(selectedEmployee)}\n          leaveTypeId={selectedEmployee?.leaveTypeId}\n          leaveTypeName={selectedEmployee?.leaveTypeName}\n          onClose={() => { setSelectedEmployee(null); }}\n          wsId={wsId ?? \"\"}\n        />\n      )}\n\n      {!!selectedBalance && <LeaveBalanceDetailModal balance={selectedBalance} isOpen={!!selectedBalance} onClose={() => { setSelectedBalance(null); }} />}\n\n      <ConfirmationDialog />\n    </div>\n  );\n}\n\n// Desktop table row component (≥1024px) - Simplified to essential info only\nfunction DesktopBalanceRow({ balance, onViewDetails, onViewHistory }: {\n  balance: WorkspaceLeaveBalance;\n  onViewDetails: () => void;\n  onViewHistory: () => void;\n}) {\n  const { t } = useTranslation();\n  const totalEntitled = balance.entitlement + balance.accrued_amount + balance.carried_over;\n  const usagePercent = Math.round((balance.used / (totalEntitled || 1)) * 100);\n\n  return (\n    <tr className=\"hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-all group cursor-pointer\" onClick={onViewDetails}>\n      {/* Employee Name with Avatar */}\n      <td className=\"px-6 py-6\">\n        <div className=\"flex items-center gap-4\">\n          <div className=\"w-12 h-12 bg-primary-50 dark:bg-primary-950 rounded-xl flex items-center justify-center text-primary-600 dark:text-primary-400 font-bold text-sm shadow-inner border border-primary-100 dark:border-primary-800/50 uppercase group-hover:scale-110 transition-transform flex-shrink-0\">\n            {balance.employee_name.split(' ').map(n => n[0]).join('').slice(0, 2)}\n          </div>\n          <div className=\"font-bold text-slate-800 dark:text-slate-100 text-base tracking-tight uppercase leading-tight\">\n            {balance.employee_name}\n          </div>\n        </div>\n      </td>\n\n      {/* Leave Type Badge */}\n      <td className=\"px-5 py-6\">\n        <span className=\"px-3 py-1.5 bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300 rounded-xl text-xs font-bold uppercase tracking-wider border border-slate-200 dark:border-slate-700 shadow-sm inline-block\">\n          {balance.leave_type_name}\n        </span>\n      </td>\n\n      {/* Remaining Balance - Hero Metric */}\n      <td className=\"px-5 py-6 text-right\">\n        <div className=\"flex items-center justify-end gap-2\">\n          <span className={cn(\n            \"text-2xl font-bold px-4 py-2 rounded-xl font-mono shadow-inner border transition-all uppercase tracking-tighter\",\n            balance.remaining > 0\n              ? \"text-emerald-600 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950 border-emerald-100 dark:border-emerald-800\"\n              : \"text-slate-500 dark:text-slate-400 bg-slate-100 dark:bg-slate-700 border-slate-200 dark:border-slate-700 opacity-60\"\n          )}>\n            {balance.remaining}\n          </span>\n          <span className=\"text-xs font-bold text-slate-500 dark:text-slate-400 uppercase\">\n            {t(\"common.days_short\")}\n          </span>\n        </div>\n      </td>\n\n      {/* Usage Progress Bar */}\n      <td className=\"px-5 py-6\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"w-32 h-4 bg-slate-100 dark:bg-slate-700 rounded-full overflow-hidden shadow-inner border border-slate-200 dark:border-slate-700/50\">\n            <div\n              className={cn(\n                \"h-full rounded-full transition-all duration-1000 shadow-sm\",\n                usagePercent > 80 ? \"bg-rose-500 dark:bg-rose-400 shadow-rose-200\" :\n                  usagePercent > 50 ? \"bg-amber-500 dark:bg-amber-400 shadow-amber-200\" :\n                    \"bg-primary-600 shadow-primary-200\"\n              )}\n              style={{ width: `${Math.min(100, usagePercent)}%` }}\n            />\n          </div>\n          <span className=\"text-xs font-bold text-slate-500 dark:text-slate-400 font-mono tracking-tighter min-w-[3ch]\">\n            {usagePercent}%\n          </span>\n        </div>\n      </td>\n\n      {/* Action Buttons */}\n      <td className=\"px-6 py-6 text-right\" onClick={(e) => { e.stopPropagation(); }}>\n        <div className=\"flex items-center justify-end gap-2 opacity-60 group-hover:opacity-100 transition-all\">\n          <button\n            className=\"p-2.5 bg-primary-50 dark:bg-primary-950 text-primary-600 dark:text-primary-400 hover:bg-primary-100 dark:bg-primary-900 rounded-xl border border-primary-200 dark:border-primary-800 transition-all active:scale-90 min-w-[44px] min-h-[44px]\"\n            onClick={onViewDetails}\n            title={t(\"leave_balances.view_details\")}\n          >\n            <Eye className=\"h-5 w-5\" />\n          </button>\n          <button\n            className=\"p-2.5 bg-slate-50 dark:bg-slate-800 text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-xl border border-slate-200 dark:border-slate-700 transition-all active:scale-90 min-w-[44px] min-h-[44px]\"\n            onClick={onViewHistory}\n            title={t(\"leave_balances.table.history_tooltip\")}\n          >\n            <History className=\"h-5 w-5\" />\n          </button>\n        </div>\n      </td>\n    </tr>\n  );\n}\n\n// Mobile card component (<1024px) - Simplified, essential info only\nfunction MobileBalanceCard({ balance, onViewDetails, onViewHistory }: {\n  balance: WorkspaceLeaveBalance;\n  onViewDetails: () => void;\n  onViewHistory: () => void;\n}) {\n  const { t } = useTranslation();\n  const totalEntitled = balance.entitlement + balance.accrued_amount + balance.carried_over;\n  const usagePercent = Math.round((balance.used / (totalEntitled || 1)) * 100);\n\n  return (\n    <div className=\"p-5 space-y-5 bg-white dark:bg-slate-900 hover:bg-slate-50 dark:hover:bg-slate-800/30 transition-all\">\n      {/* Header: Employee Avatar + Name + Leave Type */}\n      <div className=\"flex items-center gap-3\">\n        <div className=\"w-14 h-14 bg-primary-50 dark:bg-primary-950 rounded-2xl flex items-center justify-center text-primary-600 dark:text-primary-400 font-bold text-base shadow-inner border border-primary-100 dark:border-primary-800/50 uppercase flex-shrink-0\">\n          {balance.employee_name.split(' ').map(n => n[0]).join('').slice(0, 2)}\n        </div>\n        <div className=\"flex-1 min-w-0\">\n          <div className=\"font-bold text-slate-800 dark:text-slate-100 text-base tracking-tight uppercase leading-tight truncate\">\n            {balance.employee_name}\n          </div>\n          <span className=\"inline-block mt-1.5 px-3 py-1.5 bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300 rounded-xl text-xs font-bold uppercase tracking-wider border border-slate-200 dark:border-slate-700 shadow-sm\">\n            {balance.leave_type_name}\n          </span>\n        </div>\n      </div>\n\n      {/* Hero Metric: Remaining Balance */}\n      <div className=\"bg-gradient-to-br from-primary-50/50 to-transparent dark:from-primary-950/50 dark:to-transparent rounded-2xl p-5 border border-primary-100 dark:border-primary-800/30\">\n        <div className=\"text-[10px] font-bold text-primary-600 dark:text-primary-400 uppercase tracking-[0.2em] mb-2\">\n          {t(\"leave_balances.table.remaining\")}\n        </div>\n        <div className=\"flex items-baseline gap-2\">\n          <span className={cn(\n            \"text-5xl font-bold font-mono tracking-tighter\",\n            balance.remaining > 0 ? \"text-emerald-600 dark:text-emerald-300\" : \"text-slate-500 dark:text-slate-400\"\n          )}>\n            {balance.remaining}\n          </span>\n          <span className=\"text-sm font-bold text-slate-500 dark:text-slate-400 uppercase\">\n            {t(\"common.days_short\")}\n          </span>\n        </div>\n      </div>\n\n      {/* Usage Progress Bar */}\n      <div className=\"space-y-2\">\n        <div className=\"flex items-center justify-between text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider\">\n          <span>{t(\"leave_balances.table.usage\")}</span>\n          <span className=\"font-mono\">{usagePercent}%</span>\n        </div>\n        <div className=\"w-full h-4 bg-slate-100 dark:bg-slate-700 rounded-full overflow-hidden shadow-inner border border-slate-200 dark:border-slate-700/50\">\n          <div\n            className={cn(\n              \"h-full rounded-full transition-all duration-1000 shadow-sm\",\n              usagePercent > 80 ? \"bg-rose-500 dark:bg-rose-400 shadow-rose-200\" :\n                usagePercent > 50 ? \"bg-amber-500 dark:bg-amber-400 shadow-amber-200\" :\n                  \"bg-primary-600 shadow-primary-200\"\n            )}\n            style={{ width: `${Math.min(100, usagePercent)}%` }}\n          />\n        </div>\n      </div>\n\n      {/* Action Buttons */}\n      <div className=\"flex items-center gap-3 pt-3 border-t border-slate-100 dark:border-slate-800\">\n        <button\n          className=\"flex-1 flex items-center justify-center gap-2 px-4 py-3.5 bg-primary-600 hover:bg-primary-700 text-white font-bold uppercase tracking-wider text-xs rounded-xl transition-all active:scale-95 shadow-lg shadow-primary-200 min-h-[44px]\"\n          onClick={onViewDetails}\n        >\n          <Eye className=\"h-5 w-5\" />\n          <span>{t(\"leave_balances.view_details\")}</span>\n        </button>\n        <button\n          className=\"p-3.5 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:bg-slate-600 text-slate-600 dark:text-slate-300 rounded-xl transition-all active:scale-95 min-w-[44px] min-h-[44px] flex-shrink-0\"\n          onClick={onViewHistory}\n          title={t(\"leave_balances.table.history_tooltip\")}\n        >\n          <History className=\"h-5 w-5\" />\n        </button>\n      </div>\n    </div>\n  );\n}","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/leave-requests-page.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/login-page.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/members-page.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/monitor/header.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/monitor/jobs-table.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/monitor/stat-cards.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/monitor/workers-table.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/onboarding-page.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/payroll-page.tsx","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Function 'PayrollPage' has too many lines (200). Maximum allowed is 100.","line":34,"column":16,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":269,"endColumn":2},{"ruleId":"complexity","severity":2,"message":"Function 'PayrollPage' has a complexity of 14. Maximum allowed is 10.","line":34,"column":16,"nodeType":"FunctionDeclaration","messageId":"complex","endLine":34,"endColumn":36}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useQuery, useQueryClient, keepPreviousData } from \"@tanstack/react-query\";\nimport { \n  Calculator, \n  ArrowLeft, \n  ArrowRight\n} from \"lucide-react\";\nimport React, { useState, useMemo, useEffect } from \"react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { MonthYearPicker } from \"@/components/common/month-year-picker\";\nimport AdjustmentDrawer from \"@/components/payroll/adjustment-drawer\";\nimport BatchCalculationModal from \"@/components/payroll/batch-calculation-modal\";\nimport PayrollDetailDrawer from \"@/components/payroll/payroll-detail-drawer\";\nimport PayrollSummaryTable from \"@/components/payroll/payroll-summary-table\";\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuLabel,\n  DropdownMenuTrigger,\n} from \"@/components/ui/dropdown-menu\";\nimport { cn } from \"@/lib/utils\";\n\nimport { useToast } from \"../components/ui/toast\";\nimport {\n  fetchEmployees,\n  searchEmployees,\n  fetchEmployeePayslips,\n  fetchWorkspacePayslips,\n  getCurrentWorkspaceId,\n  fetchWorkspaceAttendanceAdjustments,\n  Employee,\n} from \"../lib/api\";\n\nexport default function PayrollPage() {\n  const { t } = useTranslation();\n  const wsId = getCurrentWorkspaceId() ?? \"\";\n  const queryClient = useQueryClient();\n  const _toast = useToast();\n  \n  const [selectedEmployee, setSelectedEmployee] = useState<Employee | null>(null);\n  const [selectedIds, setSelectedIds] = useState<Set<string>>(new Set());\n  const [searchTerm, setSearchTerm] = useState(\"\");\n  const [isBatchCalcModalOpen, setIsBatchCalcModalOpen] = useState(false);\n  const [isAdjustmentDrawerOpen, setIsAdjustmentDrawerOpen] = useState(false);\n  const [isDetailDrawerOpen, setIsDetailDrawerOpen] = useState(false);\n\n  // Debounce search term for server-side search\n  const [debouncedSearchTerm, setDebouncedSearchTerm] = useState(\"\");\n  useEffect(() => {\n    const timer = setTimeout(() => {\n      setDebouncedSearchTerm(searchTerm);\n    }, 300);\n    return () => { clearTimeout(timer); };\n  }, [searchTerm]);\n  \n  const [calcYear, setCalcYear] = useState(() => {\n    const d = new Date();\n    d.setMonth(d.getMonth() - 1);\n    return d.getFullYear();\n  });\n  const [calcMonth, setCalcMonth] = useState(() => {\n \n    const d = new Date();\n    d.setMonth(d.getMonth() - 1);\n    return d.getMonth() + 1;\n  });\n\n  // Use server-side search when search term exists, otherwise fetch all employees\n  const { data: employeesData, isLoading: empsLoading } = useQuery({\n    queryKey: [\"employees\", wsId, debouncedSearchTerm],\n    queryFn: () => {\n      if (debouncedSearchTerm.trim()) {\n        // Server-side search with higher limit to show more results\n        return searchEmployees(wsId, debouncedSearchTerm, 1, 100);\n      }\n      // Fetch all employees (up to 3000)\n      return fetchEmployees(wsId, 1, 3000);\n    },\n    enabled: !!wsId,\n    placeholderData: keepPreviousData,\n  });\n\n  const employees = useMemo(() => employeesData?.data ?? [], [employeesData?.data]);\n\n  const { data: workspacePayslipsData = [], isLoading: workspacePayslipsLoading } = useQuery({\n    queryKey: [\"workspace-payslips\", wsId, calcYear, calcMonth],\n    queryFn: () => fetchWorkspacePayslips(wsId, calcYear, calcMonth),\n    enabled: !!wsId,\n    placeholderData: keepPreviousData,\n  });\n\n  const workspacePayslips = workspacePayslipsData;\n \n\n  const { data: employeePayslips = [], isLoading: employeePayslipsLoading } = useQuery({\n    queryKey: [\"payslips\", selectedEmployee?.id],\n    queryFn: () => {\n      if (!selectedEmployee) throw new Error(\"Employee is required\");\n      return fetchEmployeePayslips(wsId, selectedEmployee.id);\n    },\n    enabled: !!selectedEmployee && isDetailDrawerOpen,\n  });\n\n  const { data: allAdjustments = [] } = useQuery({\n    queryKey: [\"adjustments\", wsId, \"pending\"],\n    queryFn: () => fetchWorkspaceAttendanceAdjustments(wsId, \"pending\"),\n    enabled: !!wsId,\n    placeholderData: keepPreviousData,\n  });\n\n  const employeeAdjustments = selectedEmployee \n    ? allAdjustments.filter(adj => adj.employee_id === selectedEmployee.id)\n    : [];\n\n  const toggleSelectAll = (ids?: string[]) => {\n    if (ids) {\n      const next = new Set(selectedIds);\n      const allIncluded = ids.every(id => next.has(id));\n      if (allIncluded) {\n        ids.forEach(id => next.delete(id));\n      } else {\n        ids.forEach(id => next.add(id));\n      }\n      setSelectedIds(next);\n      return;\n    }\n\n    // Server-side search already filters employees, so use all visible employees\n    if (selectedIds.size === employees.length) setSelectedIds(new Set());\n    else setSelectedIds(new Set(employees.map(e => e.id)));\n  };\n\n  const toggleSelect = (id: string) => {\n    const next = new Set(selectedIds);\n    if (next.has(id)) next.delete(id);\n    else next.add(id);\n    setSelectedIds(next);\n  };\n\n  const handleViewDetail = (employee: Employee) => {\n    setSelectedEmployee(employee);\n    setIsDetailDrawerOpen(true);\n  };\n\n  const employeeNames = useMemo(() => {\n    const map: Record<string, string> = {};\n    employees.forEach(e => { map[e.id] = e.full_name; });\n    return map;\n  }, [employees]);\n\n  const handleAdjustmentResolved = () => {\n    void queryClient.invalidateQueries({ queryKey: [\"payslips\", selectedEmployee?.id] });\n    void queryClient.invalidateQueries({ queryKey: [\"workspace-payslips\"] });\n    void queryClient.invalidateQueries({ queryKey: [\"adjustments\"] });\n  };\n\n  const changeMonth = (delta: number) => {\n \n    let nextMonth = calcMonth + delta;\n    let nextYear = calcYear;\n    if (nextMonth > 12) { nextMonth = 1; nextYear++; }\n    else if (nextMonth < 1) { nextMonth = 12; nextYear--; }\n    setCalcMonth(nextMonth);\n    setCalcYear(nextYear);\n  };\n\n  if (!wsId) return <div className=\"p-8 text-center\">{t(\"common.select_workspace\")}</div>;\n\n  return (\n    <div className=\"flex flex-col h-[calc(100vh-8rem)] gap-8 overflow-hidden animate-in fade-in duration-500\">\n      {/* Header with Stats and Actions */}\n      <header className=\"flex flex-col md:flex-row md:items-center justify-between gap-6 px-2\">\n        <div>\n          <h1 className=\"text-3xl font-bold tracking-tight text-slate-700 dark:text-slate-200\" data-testid=\"payroll-title\">{t(\"payroll.title\")}</h1>\n          <p className=\"text-slate-500 dark:text-slate-400 mt-1 font-medium\">{t(\"payroll.subtitle\")}</p>\n        </div>\n\n        <div className=\"flex items-center gap-4 bg-white dark:bg-slate-900 p-2 rounded-[2rem] border border-slate-200 dark:border-slate-700 shadow-sm\">\n           <div className=\"flex items-center bg-slate-100 dark:bg-slate-700/50 rounded-2xl p-1 shadow-inner border border-slate-200 dark:border-slate-700/50\">\n              <button className=\"w-10 h-10 flex items-center justify-center text-slate-500 dark:text-slate-400 hover:text-primary-600 dark:text-primary-400 hover:bg-white dark:hover:bg-slate-900 hover:shadow-sm rounded-xl transition-all\" onClick={() => { changeMonth(-1); }}><ArrowLeft size={18} /></button>\n              \n              <DropdownMenu>\n                <DropdownMenuTrigger asChild>\n                  <button className=\"px-6 flex flex-col items-center min-w-[160px] cursor-pointer hover:bg-white dark:hover:bg-slate-900 hover:shadow-sm rounded-xl transition-all py-1.5 group outline-none border border-transparent hover:border-slate-100 dark:border-slate-800\">\n                    <span className=\"text-[9px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest leading-none mb-1 group-hover:text-primary-500 dark:group-hover:text-primary-400 transition-colors\">{t(\"payroll.table.period\")}</span>\n                    <span className=\"text-sm font-bold text-slate-700 dark:text-slate-200 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors uppercase tracking-tighter\">\n                      {calcMonth} / {calcYear}\n                    </span>\n                  </button>\n                </DropdownMenuTrigger>\n                <DropdownMenuContent align=\"center\" className=\"w-80 p-4 rounded-[2rem] shadow-2xl border-slate-100 dark:border-slate-800\" sideOffset={8}>\n                    <DropdownMenuLabel className=\"text-center text-[10px] font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400 mb-4\">{t(\"common.select_month\", { defaultValue: \"SELECT PAY PERIOD\" })}</DropdownMenuLabel>\n                    <MonthYearPicker month={calcMonth} onChange={(m, y) => { setCalcMonth(m); setCalcYear(y); }} year={calcYear} />\n                </DropdownMenuContent>\n              </DropdownMenu>\n\n              <button className=\"w-10 h-10 flex items-center justify-center text-slate-500 dark:text-slate-400 hover:text-primary-600 dark:text-primary-400 hover:bg-white dark:hover:bg-slate-900 hover:shadow-sm rounded-xl transition-all\" onClick={() => { changeMonth(1); }}><ArrowRight size={18} /></button>\n           </div>\n\n           <div className=\"h-10 w-px bg-slate-100 dark:bg-slate-700\" />\n\n           <button \n            className={cn(\n              \"flex items-center gap-3 px-8 py-3 rounded-2xl font-bold text-[10px] uppercase tracking-widest transition-all shadow-lg active:scale-95\",\n              selectedIds.size > 0 \n                ? \"bg-primary-600 text-white shadow-primary-100 hover:bg-primary-700\" \n                : \"bg-slate-100 dark:bg-slate-700 text-slate-500 dark:text-slate-400 shadow-none cursor-not-allowed\"\n            )}\n            data-testid=\"calculate-batch-btn\"\n            disabled={selectedIds.size === 0}\n            onClick={() => {\n              setIsBatchCalcModalOpen(true);\n            }}\n           >\n             <Calculator size={18} />\n             {t(\"payroll.calculate_btn\")} {selectedIds.size > 0 && <span className=\"ml-1 bg-white dark:bg-slate-900/20 px-2 py-0.5 rounded-lg text-white\">{selectedIds.size}</span>}\n           </button>\n        </div>\n      </header>\n\n      {/* Main Grid Section */}\n      <div className=\"flex-1 min-h-0\">\n        <PayrollSummaryTable \n          employees={employees}\n          isLoading={empsLoading || workspacePayslipsLoading}\n          onSearchChange={setSearchTerm}\n          onToggleSelect={toggleSelect}\n          onToggleSelectAll={toggleSelectAll}\n          onViewDetail={handleViewDetail}\n          payslips={workspacePayslips}\n          searchTerm={searchTerm}\n          selectedIds={selectedIds}\n        />\n      </div>\n\n      {/* Detail Drawer */}\n      <PayrollDetailDrawer \n        adjustments={employeeAdjustments}\n        employee={selectedEmployee}\n        isLoadingPayslips={employeePayslipsLoading}\n        isOpen={isDetailDrawerOpen}\n        onClose={() => { setIsDetailDrawerOpen(false); }}\n        onResolveAdjustments={() => { setIsAdjustmentDrawerOpen(true); }}\n        payslips={employeePayslips}\n        workspaceId={wsId}\n      />\n\n      {/* Adjustment Drawer */}\n      {!!selectedEmployee && (\n        <AdjustmentDrawer\n          employeeId={selectedEmployee.id}\n          employeeName={selectedEmployee.full_name}\n          isOpen={isAdjustmentDrawerOpen}\n          onAdjustmentResolved={handleAdjustmentResolved}\n          onClose={() => { setIsAdjustmentDrawerOpen(false); }}\n        />\n      )}\n\n      {/* Batch Calculate Modal */}\n      <BatchCalculationModal\n        employeeIds={Array.from(selectedIds)}\n        employeeNames={employeeNames}\n        isOpen={isBatchCalcModalOpen}\n        onClose={() => { setIsBatchCalcModalOpen(false); }}\n        workspaceId={wsId}\n      />\n    </div>\n  );\n}","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/profile-page.tsx","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Function 'ProfilePage' has too many lines (139). Maxi