Identifier","messageId":"useUnknown","endLine":9,"endColumn":33,"suggestions":[{"messageId":"addUnknownTypeAnnotationSuggestion","fix":{"range":[214,214],"text":": unknown"},"desc":"Add an explicit `: unknown` type annotation to the rejection callback variable."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"const MAX_RETRIES = 3;\nconst RETRY_DELAY_MS = 1000;\n\nexport function retryImport<T>(\n  importer: () => Promise<T>,\n  retries = MAX_RETRIES,\n  delay = RETRY_DELAY_MS,\n): Promise<T> {\n  return importer().catch((error) => {\n    if (retries <= 0) throw error;\n    return new Promise<T>((resolve) =>\n      setTimeout(\n        () => { resolve(retryImport(importer, retries - 1, delay * 2)); },\n        delay,\n      ),\n    );\n  });\n}\n\nexport function lazyRetry<T>(\n  importer: () => Promise<{ default: T }>,\n  retries = MAX_RETRIES,\n): () => Promise<{ default: T }> {\n  return () => retryImport(importer, retries);\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/lib/datetime.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/lib/excel-builder.ts","messages":[{"ruleId":"complexity","severity":2,"message":"Async function 'generateExcel' has a complexity of 17. Maximum allowed is 10.","line":61,"column":8,"nodeType":"FunctionDeclaration","messageId":"complex","endLine":61,"endColumn":36}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * Client-side Excel generation using ExcelJS\n * Matches backend excel_writer.rs column structure for consistency\n */\n\nimport type { SummaryRow, DetailRow, AttendanceRow } from \"@/types/report-stream\";\n\n// Dynamic imports to reduce initial bundle size\nasync function loadExcelJS() {\n  const module = await import(\"exceljs\");\n  // Handle both ESM default and CommonJS exports\n  return \"default\" in module ? module.default : module;\n}\n\nasync function loadFileSaver() {\n  const { saveAs } = await import(\"file-saver\");\n  return saveAs;\n}\n\nexport interface ExcelColumn {\n  header: string;\n  key: string;\n  width: number;\n}\n\n// Column definitions matching backend excel_writer.rs\nconst SUMMARY_COLUMNS: ExcelColumn[] = [\n  { header: \"Employee Name\", key: \"employee_name\", width: 35 },\n  { header: \"Std Units\", key: \"total_std_units\", width: 15 },\n  { header: \"OT Units\", key: \"total_ot_units\", width: 15 },\n  { header: \"Total Leave Days\", key: \"total_leave_days\", width: 18 },\n];\n\nconst DETAIL_COLUMNS: ExcelColumn[] = [\n  { header: \"Date\", key: \"date\", width: 12 },\n  { header: \"Employee Name\", key: \"employee_name\", width: 30 },\n  { header: \"Scheduled Start\", key: \"scheduled_start\", width: 15 },\n  { header: \"Scheduled End\", key: \"scheduled_end\", width: 15 },\n  { header: \"Actual In\", key: \"actual_in\", width: 12 },\n  { header: \"Actual Out\", key: \"actual_out\", width: 12 },\n  { header: \"Std Units\", key: \"std_work_units\", width: 12 },\n  { header: \"OT Units\", key: \"ot_work_units\", width: 12 },\n  { header: \"OT Status\", key: \"ot_claim_status\", width: 12 },\n  { header: \"Status\", key: \"status\", width: 12 },\n];\n\nexport type ReportType = \"summary\" | \"detail\";\n\nexport interface GenerateOptions {\n  dateRange?: { start: string; end: string };\n  filename?: string;\n  onProgress?: (percent: number) => void;\n  reportType: ReportType;\n  workspaceName?: string;\n}\n\n/**\n * Generate Excel file from attendance data\n * Uses chunked processing with progress callbacks for large datasets\n */\nexport async function generateExcel(\n  rows: AttendanceRow[],\n  options: GenerateOptions\n): Promise<void> {\n  const { reportType, workspaceName, dateRange, filename, onProgress } = options;\n  const ExcelJS = await loadExcelJS();\n  const saveAs = await loadFileSaver();\n\n  onProgress?.(0);\n\n  const workbook = new ExcelJS.Workbook();\n  workbook.creator = \"LeeAttend\";\n  workbook.created = new Date();\n\n  const sheetName = reportType === \"summary\" ? \"Summary\" : \"Detail\";\n  const worksheet = workbook.addWorksheet(sheetName);\n\n  const columns = reportType === \"summary\" ? SUMMARY_COLUMNS : DETAIL_COLUMNS;\n  worksheet.columns = columns;\n\n  // Title row (row 1)\n  const titleText = reportType === \"summary\"\n    ? `Attendance Summary Report${workspaceName ? ` - ${workspaceName}` : \"\"}`\n    : `Attendance Detail Report${workspaceName ? ` - ${workspaceName}` : \"\"}`;\n\n  const titleCell = worksheet.getCell(\"A1\");\n  titleCell.value = titleText;\n  titleCell.font = { bold: true, size: 14, color: { argb: \"FF1F4E79\" } };\n  worksheet.mergeCells(1, 1, 1, columns.length);\n\n  // Date range row (row 2)\n  if (dateRange) {\n    const rangeCell = worksheet.getCell(\"A2\");\n    rangeCell.value = `Period: ${dateRange.start} to ${dateRange.end}`;\n    rangeCell.font = { italic: true, color: { argb: \"FF5B5B5B\" } };\n    worksheet.mergeCells(2, 1, 2, columns.length);\n  }\n\n  onProgress?.(10);\n\n  // Header row (row 4)\n  const headerRowNumber = 4;\n  const headerRow = worksheet.getRow(headerRowNumber);\n  columns.forEach((col, index) => {\n    const cell = headerRow.getCell(index + 1);\n    cell.value = col.header;\n    cell.font = { bold: true, color: { argb: \"FFFFFFFF\" } };\n    cell.fill = {\n      type: \"pattern\",\n      pattern: \"solid\",\n      fgColor: { argb: \"FF4472C4\" },\n    };\n    cell.alignment = { horizontal: \"center\", vertical: \"middle\" };\n  });\n  headerRow.commit();\n\n  onProgress?.(20);\n\n  // Data rows - process in chunks for progress and UI responsiveness\n  const chunkSize = 1000;\n  const dataStartRow = headerRowNumber + 1;\n\n  for (let index = 0; index < rows.length; index += chunkSize) {\n    const chunk = rows.slice(index, index + chunkSize);\n\n    chunk.forEach((row, chunkIndex) => {\n      const rowNumber = dataStartRow + index + chunkIndex;\n      const excelRow = worksheet.getRow(rowNumber);\n\n      columns.forEach((col, colIndex) => {\n        const value = row[col.key as keyof AttendanceRow];\n        const cell = excelRow.getCell(colIndex + 1);\n        cell.value = value;\n\n        // Status column styling (detail report)\n        if (col.key === \"status\" && reportType === \"detail\") {\n          const statusColors: Record<string, string> = {\n            present: \"FF2E7D32\",\n            late: \"FFF57C00\",\n            absent: \"FFD32F2F\",\n            off: \"FF757575\",\n          };\n          const color = statusColors[value.toLowerCase()];\n          if (color) {\n            cell.font = { color: { argb: color } };\n          }\n          cell.alignment = { horizontal: \"center\" };\n        }\n      });\n\n      excelRow.commit();\n    });\n\n    // Update progress (20% to 80% for data rows)\n    const progress = 20 + Math.floor((Math.min(index + chunkSize, rows.length) / rows.length) * 60);\n    onProgress?.(progress);\n\n    // Yield to UI thread\n    await new Promise((resolve) => setTimeout(resolve, 0));\n  }\n\n  onProgress?.(85);\n\n  // Auto-filter on data range\n  if (rows.length > 0) {\n    worksheet.autoFilter = {\n      from: { row: headerRowNumber, column: 1 },\n      to: { row: dataStartRow + rows.length - 1, column: columns.length },\n    };\n  }\n\n  // Freeze header rows\n  worksheet.views = [{ state: \"frozen\", ySplit: headerRowNumber }];\n\n  onProgress?.(90);\n\n  // Generate and download\n  const buffer = await workbook.xlsx.writeBuffer();\n  const blob = new Blob([buffer], {\n    type: \"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet\",\n  });\n\n  const timestamp = new Date().toISOString().slice(0, 10);\n  const defaultFilename = `attendance-${reportType}-${timestamp}.xlsx`;\n  saveAs(blob, filename ?? defaultFilename);\n\n  onProgress?.(100);\n}\n\n/**\n * Type guard to check if row is SummaryRow\n */\nexport function isSummaryRow(row: AttendanceRow): row is SummaryRow {\n  return \"total_std_units\" in row;\n}\n\n/**\n * Type guard to check if row is DetailRow\n */\nexport function isDetailRow(row: AttendanceRow): row is DetailRow {\n  return \"date\" in row && \"status\" in row;\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/lib/permission-groups.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/lib/routes.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/lib/sentry.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/lib/utils.test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/lib/utils.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/lib/utils/__tests__/attendance.test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/lib/utils/attendance.test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/lib/utils/attendance.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/lib/web-vitals.ts","messages":[{"ruleId":"no-console","severity":1,"message":"Unexpected console statement. Only these console methods are allowed: warn, error.","line":25,"column":5,"nodeType":"MemberExpression","messageId":"limited","endLine":25,"endColumn":18,"suggestions":[{"fix":{"range":[672,753],"text":""},"messageId":"removeConsole","data":{"propertyName":"debug"},"desc":"Remove the console.debug()."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { onCLS, onFCP, onINP, onLCP, onTTFB } from \"web-vitals\";\n\ninterface VitalMetric {\n  name: string;\n  rating: \"good\" | \"needs-improvement\" | \"poor\";\n  value: number;\n}\n\nfunction getRating(name: string, value: number): VitalMetric[\"rating\"] {\n  const thresholds: Partial<Record<string, [number, number]>> = {\n    LCP: [2500, 4000],\n    FCP: [1800, 3000],\n    CLS: [0.1, 0.25],\n    INP: [200, 500],\n    TTFB: [800, 1800],\n  };\n  const [good, poor] = thresholds[name] ?? [0, Infinity];\n  if (value <= good) return \"good\";\n  if (value <= poor) return \"needs-improvement\";\n  return \"poor\";\n}\n\nfunction reportMetric(metric: VitalMetric) {\n  if (import.meta.env.DEV) {\n    console.debug(`[Web Vitals] ${metric.name}: ${metric.value} (${metric.rating})`);\n  }\n}\n\nexport function trackWebVitals() {\n  const report = (name: string, value: number) => {\n    reportMetric({ name, value, rating: getRating(name, value) });\n  };\n\n  onCLS((m) => { report(\"CLS\", m.value); });\n  onFCP((m) => { report(\"FCP\", m.value); });\n  onINP((m) => { report(\"INP\", m.value); });\n  onLCP((m) => { report(\"LCP\", m.value); });\n  onTTFB((m) => { report(\"TTFB\", m.value); });\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/main.tsx","messages":[{"ruleId":"complexity","severity":2,"message":"Arrow function has a complexity of 12. Maximum allowed is 10.","line":16,"column":55,"nodeType":"ArrowFunctionExpression","messageId":"complex","endLine":16,"endColumn":57},{"ruleId":"import-x/no-named-as-default-member","severity":1,"message":"Caution: `ReactDOM` also has a named export `createRoot`. Check if you meant to write `import {createRoot} from 'react-dom/client'` instead.","line":31,"column":3,"nodeType":"MemberExpression","messageId":"member","endLine":31,"endColumn":22}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from \"react\";\nimport ReactDOM from \"react-dom/client\";\n\nimport App from \"./app\";\nimport { ToastProvider } from \"./components/ui/toast\";\nimport \"./index.css\";\nimport \"@fontsource/inter\";\n\nimport \"./i18n/config\";\nimport { initSentry } from \"./lib/sentry\";\nimport { trackWebVitals } from \"./lib/web-vitals\";\n\ninitSentry();\ntrackWebVitals();\n\nwindow.addEventListener(\"unhandledrejection\", (event) => {\n  const reason = event.reason as Error | undefined;\n  const url = (reason?.message ?? \"\") + \" \" + (reason?.stack ?? \"\");\n  if (url.includes(\"chunk\") || url.includes(\".js\") || /loading.*chunk/i.test(reason?.message ?? \"\")) {\n    event.preventDefault();\n    const retryCount = Number(sessionStorage.getItem(\"chunkRetry\") ?? \"0\");\n    if (retryCount < 3) {\n      sessionStorage.setItem(\"chunkRetry\", String(retryCount + 1));\n      window.location.reload();\n    }\n  }\n});\n\nconst rootElement = document.getElementById(\"root\");\nif (rootElement) {\n  ReactDOM.createRoot(rootElement).render(\n    <React.StrictMode>\n      <ToastProvider>\n        <App />\n      </ToastProvider>\n    </React.StrictMode>,\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/__tests__/assignment-rules-page.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/__tests__/attendance-adjustments-page.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/__tests__/attendance-logs-page.test.tsx","messages":[{"ruleId":"@typescript-eslint/no-base-to-string","severity":2,"message":"'value' will use Object's default stringification format ('[object Object]') when stringified.","line":26,"column":37,"nodeType":"Identifier","messageId":"baseToString","endLine":26,"endColumn":42}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { QueryClient, QueryClientProvider } from \"@tanstack/react-query\";\nimport { render, screen, waitFor } from \"@testing-library/react\";\nimport React from \"react\";\n\nimport userEvent from \"@testing-library/user-event\";\nimport { describe, it, expect, vi, beforeEach } from \"vitest\";\n\nimport { ToastProvider } from \"../../components/ui/toast\";\nimport * as api from \"../../lib/api\";\nimport { StagingLogsResponse } from \"../../lib/api/attendance\";\nimport { PaginatedResponse, RawAttendanceLog, Workspace } from \"../../lib/api/types\";\nimport AttendanceLogsPage from \"../attendance-logs-page\";\n\n\n// Mock TanStack Router\nvi.mock(\"@tanstack/react-router\", () => ({\n \n  useNavigate: () => vi.fn(),\n  useLocation: () => ({ pathname: \"/\", search: \"\", hash: \"\" }),\n  Link: ({ to, search, children, ...props }: { to: string; search?: Record<string, unknown>; children: React.ReactNode }) => {\n    let href = to;\n    if (search && typeof search === 'object') {\n      const params = new URLSearchParams();\n      Object.entries(search).forEach(([key, value]) => {\n        if (value !== undefined && value !== null) {\n          params.append(key, String(value));\n        }\n      });\n      const qs = params.toString();\n      if (qs) href += `?${qs}`;\n    }\n    return <a href={href} {...props}>{children}</a>;\n  },\n}));\n\n// Mock IntersectionObserver for jsdom\nclass MockIntersectionObserver {\n  observe() { /* empty */ }\n  unobserve() { /* empty */ }\n \n  disconnect() { /* empty */ }\n}\nwindow.IntersectionObserver = MockIntersectionObserver as unknown as typeof IntersectionObserver;\n\n// Mock the API library\nvi.mock(\"../../lib/api\", () => ({\n  fetchRawAttendanceLogs: vi.fn(),\n  fetchEmployees: vi.fn(),\n  fetchWorkspace: vi.fn(),\n  getCurrentWorkspaceId: vi.fn(),\n  fetchDevices: vi.fn(),\n  fetchStagingLogs: vi.fn(),\n  resolveStagingLog: vi.fn(),\n  dismissStagingLog: vi.fn(),\n  fetchMyPermissions: vi.fn(),\n}));\n\n// Override i18n\nvi.mock('react-i18next', () => ({\n  useTranslation: () => ({\n    t: (key: string) => key,\n    i18n: {\n      changeLanguage: () => Promise.resolve(),\n      language: 'en',\n    },\n  }),\n}));\n\ndescribe(\"AttendanceLogsPage\", () => {\n  let queryClient: QueryClient;\n\n  beforeEach(() => {\n    vi.clearAllMocks();\n    queryClient = new QueryClient({\n      defaultOptions: {\n        queries: {\n          retry: false,\n          gcTime: 0,\n          staleTime: 0,\n        },\n \n      },\n \n    });\n \n    vi.mocked(api.getCurrentWorkspaceId).mockReturnValue(\"test-ws-id\");\n    vi.mocked(api.fetchWorkspace).mockResolvedValue({ id: \"test-ws-id\", name: \"Test Workspace\" } as unknown as Workspace);\n    vi.mocked(api.fetchEmployees).mockResolvedValue({\n      data: [\n        { id: \"emp-1\", full_name: \"John Doe\", employee_id_number: \"EMP001\", workspace_id: \"ws-1\", is_active: true, hire_date: \"2025-01-01\", created_at: \"2025-01-01T00:00:00Z\", updated_at: \"2025-01-01T00:00:00Z\" }\n      ],\n      total: 1,\n      page: 1,\n \n      limit: 50,\n    });\n    vi.mocked(api.fetchRawAttendanceLogs).mockResolvedValue({\n      data: [\n        { id: \"log-1\", employee_id: \"emp-1\", employee_name: \"John Doe\", punch_time: new Date().toISOString(), source: \"DEVICE\", device_id: \"dev-1\" }\n      ],\n      total: 1,\n      page: 1,\n \n      page_size: 50\n \n    } as unknown as PaginatedResponse<RawAttendanceLog>);\n \n    vi.mocked(api.fetchDevices).mockResolvedValue([]);\n    vi.mocked(api.fetchStagingLogs).mockResolvedValue({ data: [], total: 0, page: 1, limit: 20 });\n    vi.mocked(api.fetchMyPermissions).mockResolvedValue({ permissions: [\"attendance_staging:manage\"], roles: [\"admin\"], managed_department_ids: null });\n  });\n\n  const renderWithProviders = (ui: React.ReactElement, initialEntries = [\"/\"]) => {\n    window.history.pushState({}, \"Test page\", initialEntries[0]);\n    return render(\n      <QueryClientProvider client={queryClient}>\n        <ToastProvider>\n          {ui}\n        </ToastProvider>\n      </QueryClientProvider>\n    );\n  };\n\n  it(\"renders the page and logs\", async () => {\n    renderWithProviders(<AttendanceLogsPage />);\n    expect(await screen.findByText(/John Doe/i)).toBeDefined();\n  });\n\n  it(\"renders cross-navigation link with preserved date range\", async () => {\n    renderWithProviders(<AttendanceLogsPage />, [\"/attendance-logs?from=2026-01-01&to=2026-01-31\"]);\n    const link = await screen.findByRole(\"link\", { name: /View Summary Report|attendance_logs.view_reports/i });\n    expect(link).toBeDefined();\n    expect(link.getAttribute(\"href\")).toBe(\"/reports?from=2026-01-01&to=2026-01-31\");\n  });\n\n \n  it(\"shows skeleton loading state when fetching data\", () => {\n    // Override the mock to simulate loading state (slow promise)\n    vi.mocked(api.fetchRawAttendanceLogs).mockImplementation(() => new Promise(() => { /* empty */ }));\n\n    renderWithProviders(<AttendanceLogsPage />);\n\n    // Check if skeleton rows are rendered (we used animate-pulse class)\n    const skeletons = document.querySelectorAll('.animate-pulse');\n    expect(skeletons.length).toBeGreaterThan(0);\n  });\n\n \n  it(\"shows beautiful empty state when no data is returned\", async () => {\n    // Override the mock to return empty data\n    vi.mocked(api.fetchRawAttendanceLogs).mockResolvedValue({\n      data: [],\n      total: 0,\n      page: 1,\n      page_size: 50\n    } as unknown as PaginatedResponse<RawAttendanceLog>);\n\n    renderWithProviders(<AttendanceLogsPage />);\n\n    // Check for the new empty state text\n    const emptyStateTitle = await screen.findByText(\"attendance_logs.messages.no_data\");\n    expect(emptyStateTitle).toBeDefined();\n\n    // Check for the helpful subtext we added\n    const emptyStateText = await screen.findByText(\"attendance_logs.messages.no_data_hint\");\n    expect(emptyStateText).toBeDefined();\n  });\n\n  it(\"uses PAGE_SIZE of 20 for infinite scroll\", async () => {\n \n    renderWithProviders(<AttendanceLogsPage />);\n    await waitFor(() => {\n      const calls = vi.mocked(api.fetchRawAttendanceLogs).mock.calls;\n      expect(calls.length).toBeGreaterThan(0);\n      // limit param should be 20\n      expect(calls[0][0].limit).toBe(20);\n      // first page param should be 1\n      expect(calls[0][0].page).toBe(1);\n    });\n  });\n\n  it(\"does not render pagination prev/next buttons\", async () => {\n    renderWithProviders(<AttendanceLogsPage />);\n    await screen.findByText(/John Doe/i);\n\n    // Old pagination buttons should NOT exist\n    expect(screen.queryByText(/common.pagination.prev/i)).toBeNull();\n    expect(screen.queryByText(/common.pagination.next/i)).toBeNull();\n    // No \"Page X / Y\" text\n    expect(screen.queryByText(/Page \\d+ \\//i)).toBeNull();\n  });\n \n\n  it(\"displays floating record count badge with loaded/total counts\", async () => {\n    vi.mocked(api.fetchRawAttendanceLogs).mockResolvedValue({\n      data: [\n        { id: \"log-1\", employee_id: \"emp-1\", employee_name: \"John Doe\", punch_time: new Date().toISOString(), source: \"DEVICE\", device_id: \"dev-1\" },\n        { id: \"log-2\", employee_id: \"emp-1\", employee_name: \"John Doe\", punch_time: new Date().toISOString(), source: \"DEVICE\", device_id: \"dev-1\" },\n      ],\n      total: 5,\n      page: 1,\n      page_size: 20\n    } as unknown as PaginatedResponse<RawAttendanceLog>);\n\n    renderWithProviders(<AttendanceLogsPage />);\n    // Wait for data to render (2 rows with same name)\n    await waitFor(() => {\n      const rows = screen.getAllByText(/John Doe/i);\n      expect(rows.length).toBeGreaterThanOrEqual(2);\n    });\n\n    // Floating badge should show loaded count (2) and total (5)\n    const badge = document.querySelector('.fixed.bottom-6');\n    expect(badge).toBeDefined();\n    expect(badge?.textContent).toContain(\"2\");\n    expect(badge?.textContent).toContain(\"5\");\n  });\n\n \n  it(\"shows loading spinner when fetching next page\", () => {\n    // Simulate infinite loading\n    vi.mocked(api.fetchRawAttendanceLogs).mockImplementation(() => new Promise(() => { /* empty */ }));\n\n    renderWithProviders(<AttendanceLogsPage />);\n\n    // Check animate-spin exists (Loader2 spinner in sentinel row)\n    const _spinners = document.querySelectorAll('.animate-spin');\n    // While first page is loading, skeleton rows show instead of spinner\n    // The spinner only appears during fetchNextPage, so we just verify no crash\n    expect(document.querySelectorAll('.animate-pulse').length).toBeGreaterThan(0);\n  });\n\n  it(\"renders unknown tab with staging data and floating amber badge\", async () => {\n \n    const user = userEvent.setup();\n\n    vi.mocked(api.fetchStagingLogs).mockResolvedValue({\n      data: [\n        { id: \"stg-1\", raw_user_id: \"UNKNOWN-42\", punch_time: new Date().toISOString(), device_id: \"dev-1\" },\n      ],\n      total: 3,\n      page: 1,\n      limit: 20,\n    } as unknown as StagingLogsResponse);\n\n    renderWithProviders(<AttendanceLogsPage />);\n    await screen.findByText(/John Doe/i);\n\n    // Switch to unknown tab\n    const unknownTab = screen.getByText(/attendance_logs.tabs.unknown/i);\n    await user.click(unknownTab);\n\n    // Should show the staging log\n    expect(await screen.findByText(\"UNKNOWN-42\")).toBeDefined();\n\n    // Floating badge should now show amber variant with staging counts\n    const badge = document.querySelector('.fixed.bottom-6');\n    expect(badge).toBeDefined();\n    expect(badge?.textContent).toContain(\"1\");\n    expect(badge?.textContent).toContain(\"3\");\n  });\n\n  it(\"shows empty state for unknown tab when no staging logs exist\", async () => {\n    const user = userEvent.setup();\n\n    renderWithProviders(<AttendanceLogsPage />);\n    await screen.findByText(/John Doe/i);\n\n    // Switch to unknown tab\n    const unknownTab = screen.getByText(/attendance_logs.tabs.unknown/i);\n    await user.click(unknownTab);\n\n    // Should show empty state message\n    expect(await screen.findByText(/No unidentified logs|attendance_logs.messages.no_unknown_logs/i)).toBeDefined();\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/__tests__/code-splitting.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/__tests__/dashboard-page.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/__tests__/date-format-integration.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/__tests__/departments-page.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/__tests__/employees-page.test.tsx","messages":[{"ruleId":"@typescript-eslint/no-unsafe-call","severity":2,"message":"Unsafe call of a type that could not be resolved.","line":479,"column":73,"nodeType":"MemberExpression","messageId":"errorCall","endLine":479,"endColumn":86},{"ruleId":"@typescript-eslint/no-unsafe-call","severity":2,"message":"Unsafe call of a type that could not be resolved.","line":505,"column":40,"nodeType":"MemberExpression","messageId":"errorCall","endLine":505,"endColumn":53},{"ruleId":"@typescript-eslint/no-unsafe-call","severity":2,"message":"Unsafe call of a type that could not be resolved.","line":505,"column":67,"nodeType":"MemberExpression","messageId":"errorCall","endLine":505,"endColumn":80}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { QueryClient, QueryClientProvider } from \"@tanstack/react-query\";\nimport { render, screen, waitFor, fireEvent } from \"@testing-library/react\";\nimport React from \"react\";\n\nimport userEvent from \"@testing-library/user-event\";\nimport { describe, it, expect, vi, beforeEach } from \"vitest\";\n\nimport { ToastProvider } from \"../../components/ui/toast\";\nimport * as api from \"../../lib/api\";\nimport { Employee, Department } from \"../../lib/api/types\";\nimport EmployeesPage from \"../employees-page\";\n\n\n// Mock TanStack Router to avoid needing full route tree in unit tests\nvi.mock(\"@tanstack/react-router\", () => ({\n  useNavigate: () => vi.fn(),\n \n  useLocation: () => ({ pathname: \"/\", search: \"\", hash: \"\" }),\n  Link: ({ to, children, ...props }: { to: string; children: React.ReactNode; [key: string]: unknown }) => <a href={to} {...props}>{children}</a>,\n}));\n\n// Mock IntersectionObserver for jsdom\nclass MockIntersectionObserver {\n    observe() { /* empty */ }\n    unobserve() { /* empty */ }\n    disconnect() { /* empty */ }\n \n}\nwindow.IntersectionObserver = MockIntersectionObserver as unknown as typeof IntersectionObserver;\n\n// Mock the API library\nvi.mock(\"../../lib/api\", () => ({\n    fetchEmployees: vi.fn(),\n    searchEmployees: vi.fn(),\n    createEmployee: vi.fn(),\n    updateEmployee: vi.fn(),\n    deleteEmployee: vi.fn(),\n    getCurrentWorkspaceId: vi.fn(),\n    fetchDepartments: vi.fn(),\n    fetchEmployeeDepartmentHistory: vi.fn(),\n    transferEmployee: vi.fn(),\n    fetchEmploymentHistory: vi.fn(),\n    rehireEmployee: vi.fn(),\n    fetchMyPermissions: vi.fn(),\n    fetchWorkspaceMembers: vi.fn().mockResolvedValue([]),\n}));\n\n// Override i18n\nvi.mock(\"react-i18next\", () => ({\n \n    useTranslation: () => ({\n        t: (key: string, options?: string | { defaultValue?: string }) => {\n            if (typeof options === \"string\") return options;\n            if (options && typeof options === \"object\" && options.defaultValue) return options.defaultValue;\n            return key;\n        },\n        i18n: {\n            changeLanguage: () => Promise.resolve(),\n            language: \"en\",\n        },\n    }),\n}));\n\n// Mock child components that aren't relevant to these tests\nvi.mock(\"@/components/payroll/employee-salary-config\", () => ({\n    default: () => <div data-testid=\"salary-config\">SalaryConfig</div>,\n}));\nvi.mock(\"@/components/employees/working-condition-config\", () => ({\n    default: () => <div data-testid=\"working-condition\">WorkingCondition</div>,\n}));\n\nconst mockEmployee = (id: string, name: string, active = true, department?: string): Employee => ({\n    id,\n    full_name: name,\n    employee_id_number: `EMP-${id}`,\n    workspace_id: \"test-ws-id\",\n    is_active: active,\n    hire_date: \"2025-01-01\",\n    created_at: \"2025-01-01T00:00:00Z\",\n    updated_at: \"2025-01-01T00:00:00Z\",\n    ...(department ? { department_name: department } : {}),\n});\n\ndescribe(\"EmployeesPage\", () => {\n    let queryClient: QueryClient;\n\n    beforeEach(() => {\n        vi.clearAllMocks();\n        queryClient = new QueryClient({\n            defaultOptions: {\n                queries: { retry: false, gcTime: 0, staleTime: 0 },\n            },\n        });\n \n        vi.mocked(api.getCurrentWorkspaceId).mockReturnValue(\"test-ws-id\");\n \n        vi.mocked(api.searchEmployees).mockResolvedValue({\n            data: [mockEmployee(\"1\", \"Alice Nguyen\"), mockEmployee(\"2\", \"Bob Tran\")],\n            total: 2,\n            page: 1,\n            limit: 20,\n        });\n \n        vi.mocked(api.fetchDepartments).mockResolvedValue([]);\n \n        vi.mocked(api.fetchEmployeeDepartmentHistory).mockResolvedValue([]);\n \n        vi.mocked(api.fetchEmploymentHistory).mockResolvedValue([]);\n \n        vi.mocked(api.fetchMyPermissions).mockResolvedValue({ permissions: [\"employees:create\", \"employees:update\", \"employees:delete\"], roles: [\"admin\"], managed_department_ids: [] });\n    });\n\n    const renderPage = (_initialEntries = [\"/\"]) =>\n        render(\n            <QueryClientProvider client={queryClient}>\n                <ToastProvider>\n                    <EmployeesPage />\n                </ToastProvider>\n            </QueryClientProvider>\n        );\n\n    // ────────────────────────────────────────────────────────────\n    // Basic rendering\n    // ────────────────────────────────────────────────────────────\n\n    it(\"renders employee list\", async () => {\n        renderPage();\n        expect(await screen.findByText(\"Alice Nguyen\")).toBeDefined();\n        expect(screen.getByText(\"Bob Tran\")).toBeDefined();\n    });\n\n    it(\"shows empty state when no employees exist\", async () => {\n \n        vi.mocked(api.searchEmployees).mockResolvedValue({\n            data: [],\n            total: 0,\n            page: 1,\n            limit: 20,\n        });\n        renderPage();\n        expect(await screen.findByText(/employees.table.no_data/i)).toBeDefined();\n    });\n\n    // ────────────────────────────────────────────────────────────\n    // Department column\n    // ────────────────────────────────────────────────────────────\n\n    it(\"renders department column header\", async () => {\n        renderPage();\n        await screen.findByText(\"Alice Nguyen\");\n        expect(screen.getByText(\"common.department\")).toBeDefined();\n    });\n\n    it(\"displays department name when employee has a department\", async () => {\n \n        vi.mocked(api.searchEmployees).mockResolvedValue({\n            data: [mockEmployee(\"1\", \"Alice Nguyen\", true, \"Engineering\"), mockEmployee(\"2\", \"Bob Tran\", true, \"Sales\")],\n            total: 2,\n            page: 1,\n            limit: 20,\n        });\n        renderPage();\n        expect(await screen.findByText(\"Engineering\")).toBeDefined();\n        expect(screen.getByText(\"Sales\")).toBeDefined();\n    });\n\n    it(\"displays dash when employee has no department\", async () => {\n \n        vi.mocked(api.searchEmployees).mockResolvedValue({\n            data: [mockEmployee(\"1\", \"Alice Nguyen\")],\n            total: 1,\n            page: 1,\n            limit: 20,\n        });\n        renderPage();\n        await screen.findByText(\"Alice Nguyen\");\n        expect(screen.getByText(\"—\")).toBeDefined();\n    });\n\n    it(\"handles mixed employees with and without departments\", async () => {\n \n        vi.mocked(api.searchEmployees).mockResolvedValue({\n            data: [mockEmployee(\"1\", \"Alice Nguyen\", true, \"HR\"), mockEmployee(\"2\", \"Bob Tran\")],\n            total: 2,\n            page: 1,\n            limit: 20,\n        });\n        renderPage();\n        expect(await screen.findByText(\"HR\")).toBeDefined();\n        expect(screen.getByText(\"—\")).toBeDefined();\n    });\n\n    // ────────────────────────────────────────────────────────────\n    // Lazy load / infinite scroll\n    // ────────────────────────────────────────────────────────────\n\n    it(\"uses PAGE_SIZE of 20 for infinite scroll\", async () => {\n        renderPage();\n        await waitFor(() => {\n \n            const calls = vi.mocked(api.searchEmployees).mock.calls;\n            expect(calls.length).toBeGreaterThan(0);\n            // args: wsId, query, page, limit\n            expect(calls[0][2]).toBe(1);  // page = 1\n            expect(calls[0][3]).toBe(20); // limit = 20\n        });\n    });\n\n    it(\"does not render pagination controls\", async () => {\n        renderPage();\n        await screen.findByText(\"Alice Nguyen\");\n\n        // PaginationControls should be gone\n        expect(screen.queryByText(/common.pagination.prev/i)).toBeNull();\n        expect(screen.queryByText(/common.pagination.next/i)).toBeNull();\n        expect(screen.queryByText(/Page \\d+ \\//i)).toBeNull();\n    });\n\n    it(\"displays floating record count badge with loaded/total\", async () => {\n \n        vi.mocked(api.searchEmployees).mockResolvedValue({\n            data: [mockEmployee(\"1\", \"Alice Nguyen\")],\n            total: 10,\n            page: 1,\n            limit: 20,\n        });\n\n        renderPage();\n        await screen.findByText(\"Alice Nguyen\");\n\n        const badge = document.querySelector(\".fixed.bottom-6\");\n        expect(badge).toBeDefined();\n        expect(badge?.textContent).toContain(\"1\");\n        expect(badge?.textContent).toContain(\"10\");\n    });\n\n    // ────────────────────────────────────────────────────────────\n    // Search\n    // ────────────────────────────────────────────────────────────\n\n    it(\"triggers searchEmployees API on search input with debounce\", async () => {\n        const user = userEvent.setup();\n        renderPage();\n        await screen.findByText(\"Alice Nguyen\");\n\n        const searchInput = screen.getByTestId(\"employee-search\");\n        await user.type(searchInput, \"Bob\");\n\n        await waitFor(\n            () => {\n \n                const calls = vi.mocked(api.searchEmployees).mock.calls;\n \n                const searchCall = calls.find((c) => c[1] === \"Bob\");\n                expect(searchCall).toBeDefined();\n            },\n            { timeout: 3000 }\n        );\n    });\n\n    // ────────────────────────────────────────────────────────────\n    // Detail panel\n    // ────────────────────────────────────────────────────────────\n\n    it(\"opens detail panel when clicking an employee row\", async () => {\n        const user = userEvent.setup();\n        renderPage();\n        const row = await screen.findByText(\"Alice Nguyen\");\n        await user.click(row);\n\n        // Detail header should appear with employee name (large heading)\n        const headings = await screen.findAllByText(\"Alice Nguyen\");\n        // At least 2: one in the list, one in the detail panel\n        expect(headings.length).toBeGreaterThanOrEqual(2);\n    });\n\n    // ────────────────────────────────────────────────────────────\n    // Employee CRUD\n    // ────────────────────────────────────────────────────────────\n\n    it(\"opens add-employee modal when clicking the add button\", async () => {\n        const user = userEvent.setup();\n        renderPage();\n        await screen.findByText(\"Alice Nguyen\");\n\n        const addButton = await screen.findByTestId(\"add-employee-btn\");\n        await user.click(addButton);\n\n        // Form inputs should be visible\n        expect(screen.getByTestId(\"employees-form-name-input\")).toBeDefined();\n        expect(screen.getByTestId(\"employees-form-id-input\")).toBeDefined();\n    });\n\n    it(\"handles terminating an employee with useConfirm\", async () => {\n        const user = userEvent.setup();\n        renderPage();\n        \n        // click row to open drawer\n        const row = await screen.findByText(\"Alice Nguyen\");\n        await user.click(row);\n\n        // find terminate button in drawer\n        const terminateButton = await screen.findByTestId(\"employees-btn-terminate\");\n        await user.click(terminateButton);\n\n        // confirm modal appears, we can use fireEvent to bypass pointer-events: none\n        const confirmModalButton = await screen.findByRole(\"button\", { name: \"Confirm\" });\n        fireEvent.click(confirmModalButton);\n\n        await waitFor(() => {\n            expect(api.updateEmployee).toHaveBeenCalledWith(\n                \"test-ws-id\", \n                \"1\", \n                expect.objectContaining({ is_active: false })\n            );\n        });\n    });\n\n    // ────────────────────────────────────────────────────────────\n    // Column sorting\n    // ────────────────────────────────────────────────────────────\n\n    const findHeaderByText = (text: string) => {\n        const ths = document.querySelectorAll(\"th\");\n        for (const th of ths) {\n            if (th.textContent.includes(text)) return th;\n        }\n        throw new Error(`Header containing \"${text}\" not found`);\n    };\n\n    it(\"sends sort_by=name and sort_dir=asc when clicking Name header\", async () => {\n        const user = userEvent.setup();\n        renderPage();\n        await screen.findByText(\"Alice Nguyen\");\n\n \n        vi.mocked(api.searchEmployees).mockClear();\n        const nameHeader = findHeaderByText(\"employees.table.name\");\n        await user.click(nameHeader);\n\n        await waitFor(() => {\n \n            const calls = vi.mocked(api.searchEmployees).mock.calls;\n \n            const sortCall = calls.find((c) => c[4] === \"name\");\n            expect(sortCall).toBeDefined();\n            expect(sortCall![5]).toBe(\"asc\");\n        });\n    });\n\n    it(\"toggles sort_dir to desc when clicking the same header twice\", async () => {\n        const user = userEvent.setup();\n        renderPage();\n        await screen.findByText(\"Alice Nguyen\");\n\n        await user.click(findHeaderByText(\"employees.table.name\"));\n\n        await waitFor(() => {\n \n            const calls = vi.mocked(api.searchEmployees).mock.calls;\n \n            expect(calls.some((c) => c[4] === \"name\" && c[5] === \"asc\")).toBe(true);\n        }, { timeout: 3000 });\n\n \n        vi.mocked(api.searchEmployees).mockClear();\n        // Re-query header since DOM is re-rendered after first click\n        await user.click(findHeaderByText(\"employees.table.name\"));\n\n        await waitFor(() => {\n \n            const calls = vi.mocked(api.searchEmployees).mock.calls;\n \n            const descCall = calls.find((c) => c[4] === \"name\" && c[5] === \"desc\");\n            expect(descCall).toBeDefined();\n        }, { timeout: 3000 });\n    });\n\n    it(\"sends sort_by=status when clicking Status header\", async () => {\n        const user = userEvent.setup();\n        renderPage();\n        await screen.findByText(\"Alice Nguyen\");\n\n \n        vi.mocked(api.searchEmployees).mockClear();\n        const statusHeader = findHeaderByText(\"employees.table.status\");\n        await user.click(statusHeader);\n\n        await waitFor(() => {\n \n            const calls = vi.mocked(api.searchEmployees).mock.calls;\n \n            const sortCall = calls.find((c) => c[4] === \"status\");\n            expect(sortCall).toBeDefined();\n            expect(sortCall![5]).toBe(\"asc\");\n        });\n    });\n\n\n    it(\"sends sort_by=department when clicking Department header\", async () => {\n        const user = userEvent.setup();\n        renderPage();\n        await screen.findByText(\"Alice Nguyen\");\n\n \n        vi.mocked(api.searchEmployees).mockClear();\n        const deptHeader = findHeaderByText(\"common.department\");\n        await user.click(deptHeader);\n\n        await waitFor(() => {\n \n            const calls = vi.mocked(api.searchEmployees).mock.calls;\n \n            const sortCall = calls.find((c) => c[4] === \"department\");\n            expect(sortCall).toBeDefined();\n            expect(sortCall![5]).toBe(\"asc\");\n        });\n    });\n\n    // ────────────────────────────────────────────────────────────\n    // Department filter (checkbox popover)\n    // ────────────────────────────────────────────────────────────\n\n    const mockDepartments: Department[] = [\n        { id: \"dept-1\", name: \"Engineering\", workspace_id: \"test-ws-id\", created_at: \"2025-01-01T00:00:00Z\", updated_at: \"2025-01-01T00:00:00Z\", active_employee_count: 0 },\n        { id: \"dept-2\", name: \"Sales\", workspace_id: \"test-ws-id\", created_at: \"2025-01-01T00:00:00Z\", updated_at: \"2025-01-01T00:00:00Z\", active_employee_count: 0 },\n        { id: \"dept-3\", name: \"HR\", workspace_id: \"test-ws-id\", created_at: \"2025-01-01T00:00:00Z\", updated_at: \"2025-01-01T00:00:00Z\", active_employee_count: 0 },\n    ];\n\n    it(\"renders department filter button in header\", async () => {\n \n        vi.mocked(api.fetchDepartments).mockResolvedValue(mockDepartments);\n        renderPage();\n        await screen.findByText(\"Alice Nguyen\");\n\n        const filterButton = screen.getByTestId(\"dept-filter-btn\");\n        expect(filterButton).toBeDefined();\n    });\n\n    it(\"opens filter popover and shows department checkboxes\", async () => {\n        const user = userEvent.setup();\n \n        vi.mocked(api.fetchDepartments).mockResolvedValue(mockDepartments);\n        renderPage();\n        await screen.findByText(\"Alice Nguyen\");\n\n        const filterButton = screen.getByTestId(\"dept-filter-btn\");\n        await user.click(filterButton);\n\n        // All departments should be visible as options\n        await waitFor(() => {\n            expect(screen.getByText(\"Engineering\")).toBeDefined();\n            expect(screen.getByText(\"Sales\")).toBeDefined();\n            expect(screen.getByText(\"HR\")).toBeDefined();\n        });\n    });\n\n    it(\"sends department_id filter when selecting a department\", async () => {\n        const user = userEvent.setup();\n \n        vi.mocked(api.fetchDepartments).mockResolvedValue(mockDepartments);\n        renderPage();\n        await screen.findByText(\"Alice Nguyen\");\n\n        // Open filter popover\n        const filterButton = screen.getByTestId(\"dept-filter-btn\");\n        await user.click(filterButton);\n\n        // Click \"Engineering\" checkbox\n \n        vi.mocked(api.searchEmployees).mockClear();\n        const engOption = await screen.findByTestId(\"dept-filter-option-dept-1\");\n        await user.click(engOption);\n\n        await waitFor(() => {\n \n            const calls = vi.mocked(api.searchEmployees).mock.calls;\n \n            const filterCall = calls.find((c) => Array.isArray(c[6]) && c[6].includes(\"dept-1\"));\n            expect(filterCall).toBeDefined();\n        });\n    });\n\n    it(\"sends multiple department_ids when selecting multiple departments\", async () => {\n        const user = userEvent.setup();\n \n        vi.mocked(api.fetchDepartments).mockResolvedValue(mockDepartments);\n        renderPage();\n        await screen.findByText(\"Alice Nguyen\");\n\n        // Open filter popover\n        await user.click(screen.getByTestId(\"dept-filter-btn\"));\n\n        // Select Engineering and Sales in one popover session\n \n        vi.mocked(api.searchEmployees).mockClear();\n        await user.click(await screen.findByTestId(\"dept-filter-option-dept-1\"));\n        await user.click(await screen.findByTestId(\"dept-filter-option-dept-2\"));\n\n        await waitFor(() => {\n \n            const calls = vi.mocked(api.searchEmployees).mock.calls;\n \n            const multiCall = calls.find((c) =>\n                Array.isArray(c[6]) && c[6].includes(\"dept-1\") && c[6].includes(\"dept-2\")\n            );\n            expect(multiCall).toBeDefined();\n        });\n    });\n\n    it(\"clears filter when clicking the chip X button\", async () => {\n        const user = userEvent.setup();\n \n        vi.mocked(api.fetchDepartments).mockResolvedValue(mockDepartments);\n        renderPage();\n        await screen.findByText(\"Alice Nguyen\");\n\n        // Select one department via popover\n        await user.click(screen.getByTestId(\"dept-filter-btn\"));\n        await user.click(await screen.findByTestId(\"dept-filter-option-dept-1\"));\n\n        // Wait for filter chip to appear\n        await waitFor(() => {\n            expect(screen.getByTestId(\"active-filter-chips\")).toBeDefined();\n        });\n\n        // Click the filter chip to remove it\n \n        vi.mocked(api.searchEmployees).mockClear();\n        await user.click(screen.getByTestId(\"dept-chip-dept-1\"));\n\n        await waitFor(() => {\n \n            const calls = vi.mocked(api.searchEmployees).mock.calls;\n            // Should send undefined (no filter) when empty\n \n            const clearCall = calls.find((c) => c[6] === undefined);\n            expect(clearCall).toBeDefined();\n        });\n    });\n\n    // ────────────────────────────────────────────────────────────\n    // UX improvements\n    // ────────────────────────────────────────────────────────────\n\n    it(\"shows filter chips with department names when filter is active\", async () => {\n        const user = userEvent.setup();\n \n        vi.mocked(api.fetchDepartments).mockResolvedValue(mockDepartments);\n        renderPage();\n        await screen.findByText(\"Alice Nguyen\");\n\n        // Select two departments\n        await user.click(screen.getByTestId(\"dept-filter-btn\"));\n        await user.click(await screen.findByTestId(\"dept-filter-option-dept-1\"));\n        await user.click(await screen.findByTestId(\"dept-filter-option-dept-3\"));\n\n        // Chips area should appear with both department names\n        await waitFor(() => {\n            const chipsArea = screen.getByTestId(\"active-filter-chips\");\n            expect(chipsArea).toBeDefined();\n            expect(screen.getByTestId(\"dept-chip-dept-1\")).toBeDefined();\n            expect(screen.getByTestId(\"dept-chip-dept-3\")).toBeDefined();\n        });\n    });\n\n    it(\"does not show filter chips when no filter is active\", async () => {\n \n        vi.mocked(api.fetchDepartments).mockResolvedValue(mockDepartments);\n        renderPage();\n        await screen.findByText(\"Alice Nguyen\");\n\n        expect(screen.queryByTestId(\"active-filter-chips\")).toBeNull();\n    });\n\n    it(\"shows badge count on filter icon matching selected count\", async () => {\n        const user = userEvent.setup();\n \n        vi.mocked(api.fetchDepartments).mockResolvedValue(mockDepartments);\n        renderPage();\n        await screen.findByText(\"Alice Nguyen\");\n\n        // Select two departments\n        await user.click(screen.getByTestId(\"dept-filter-btn\"));\n        await user.click(await screen.findByTestId(\"dept-filter-option-dept-1\"));\n        await user.click(await screen.findByTestId(\"dept-filter-option-dept-2\"));\n\n        // Badge should show \"2\"\n        await waitFor(() => {\n            const filterButton = screen.getByTestId(\"dept-filter-btn\");\n            const badge = filterButton.querySelector(\"span\");\n            expect(badge?.textContent).toBe(\"2\");\n        });\n    });\n\n    it(\"clears all filters when clicking 'Xóa tất cả' in chips area\", async () => {\n        const user = userEvent.setup();\n \n        vi.mocked(api.fetchDepartments).mockResolvedValue(mockDepartments);\n        renderPage();\n        await screen.findByText(\"Alice Nguyen\");\n\n        // Select a department\n        await user.click(screen.getByTestId(\"dept-filter-btn\"));\n        await user.click(await screen.findByTestId(\"dept-filter-option-dept-1\"));\n\n        // Wait for chips to appear\n        await waitFor(() => {\n            expect(screen.getByTestId(\"active-filter-chips\")).toBeDefined();\n        });\n\n        // Click \"Xóa tất cả\" button\n \n        vi.mocked(api.searchEmployees).mockClear();\n        const clearAllButton = screen.getByText(\"Xóa tất cả\");\n        await user.click(clearAllButton);\n\n        // Filter should be cleared\n        await waitFor(() => {\n \n            const calls = vi.mocked(api.searchEmployees).mock.calls;\n \n            expect(calls.some((c) => c[6] === undefined)).toBe(true);\n        });\n        // Chips should disappear\n        expect(screen.queryByTestId(\"active-filter-chips\")).toBeNull();\n    });\n\n    it(\"does not show 'Xóa bộ lọc' button in popover when no filter is active\", async () => {\n        const user = userEvent.setup();\n \n        vi.mocked(api.fetchDepartments).mockResolvedValue(mockDepartments);\n        renderPage();\n        await screen.findByText(\"Alice Nguyen\");\n\n        // Open popover without any active filter\n        await user.click(screen.getByTestId(\"dept-filter-btn\"));\n        await waitFor(() => {\n            expect(screen.getByText(\"Engineering\")).toBeDefined();\n        });\n        // \"Xóa bộ lọc\" should NOT be visible when no filter active\n        expect(screen.queryByText(\"Xóa bộ lọc\")).toBeNull();\n    });\n\n    it(\"shows empty state in popover when no departments exist\", async () => {\n        const user = userEvent.setup();\n \n        vi.mocked(api.fetchDepartments).mockResolvedValue([]);\n        renderPage();\n        await screen.findByText(\"Alice Nguyen\");\n\n        await user.click(screen.getByTestId(\"dept-filter-btn\"));\n\n        await waitFor(() => {\n            expect(screen.getByText(\"Chưa có phòng ban\")).toBeDefined();\n        });\n    });\n\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/__tests__/lazy-route-loading.test.tsx","messages":[],"suppressedMessages":[],"