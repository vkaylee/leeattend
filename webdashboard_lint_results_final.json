    );\n\n        await user.type(screen.getByTestId(\"employees-form-name-input\"), \"New Emp\");\n        await user.type(screen.getByTestId(\"employees-form-id-input\"), \"EMP-100\");\n        await user.type(screen.getByTestId(\"employees-form-hire-date-input\"), \"2025-01-01\");\n        await user.click(screen.getByTestId(\"save-employee-btn\"));\n\n        await waitFor(() => {\n            expect(onSuccess).toHaveBeenCalledTimes(1);\n        });\n    });\n\n    it(\"shows loading state on submit button while mutation is pending\", async () => {\n        const user = userEvent.setup();\n        vi.mocked(api.createEmployee).mockImplementation(() => new Promise(() => { /* empty */ }));\n        renderWithClient(<EmployeeFormModal {...defaultProps} />);\n\n        await user.type(screen.getByTestId(\"employees-form-name-input\"), \"New Emp\");\n        await user.type(screen.getByTestId(\"employees-form-id-input\"), \"EMP-100\");\n        await user.type(screen.getByTestId(\"employees-form-hire-date-input\"), \"2025-01-01\");\n        await user.click(screen.getByTestId(\"save-employee-btn\"));\n\n        const saveButton = screen.getByTestId(\"save-employee-btn\");\n        expect(saveButton).toBeDisabled();\n    });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/employees/employee-detail-drawer.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/employees/employee-form-modal.tsx","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Function 'EmployeeFormModal' has too many lines (122). Maximum allowed is 100.","line":54,"column":16,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":181,"endColumn":2},{"ruleId":"complexity","severity":2,"message":"Function 'EmployeeFormModal' has a complexity of 12. Maximum allowed is 10.","line":54,"column":16,"nodeType":"FunctionDeclaration","messageId":"complex","endLine":54,"endColumn":42}],"suppressedMessages":[{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/workspace/webdashboard/src/components/features/employees/employee-form-modal.tsx:70:5\n  68 |   useEffect(() => {\n  69 |     // eslint-disable-next-line react-hooks/set-state-in-effect -- Derived state synced from props; intentional pattern\n> 70 |     setSelectedUserId(editingEmployee?.user_id ?? \"\");\n     |     ^^^^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  71 |   }, [editingEmployee]);\n  72 |\n  73 |   useEffect(() => {","line":70,"column":5,"nodeType":null,"endLine":70,"endColumn":22,"suppressions":[{"kind":"directive","justification":"Derived state synced from props; intentional pattern"}]}],"errorCount":1,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useMutation, useQueryClient } from \"@tanstack/react-query\";\nimport { UserCircle } from \"lucide-react\";\nimport React, { useState, useEffect } from \"react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport type { WorkspaceMember } from \"@/lib/api\";\n\nimport Button from \"@/components/ui/button\";\nimport { Combobox } from \"@/components/ui/combobox\";\nimport FormField from \"@/components/ui/form-field\";\nimport Modal from \"@/components/ui/modal\";\nimport { useToast } from \"@/components/ui/toast\";\nimport { createEmployee, updateEmployee, fetchWorkspaceMembers, Employee } from \"@/lib/api\";\n\ninterface EmployeeFormModalProps {\n  editingEmployee: Employee | null;\n  isOpen: boolean;\n  onClose: () => void;\n  onSuccess?: () => void;\n  prefillEnrollmentId?: string;\n  wsId: string;\n}\n\nfunction useEmployeeMutations(wsId: string, onClose: () => void, onSuccess?: () => void) {\n  const { t } = useTranslation();\n  const queryClient = useQueryClient();\n  const toast = useToast();\n\n  const createMutation = useMutation({\n    mutationFn: (data: Partial<Employee>) => createEmployee(wsId, data),\n    onSuccess: () => {\n      void queryClient.invalidateQueries({ queryKey: [\"employees\", wsId] });\n      onClose();\n      toast.success(t(\"common.success\"));\n      onSuccess?.();\n    },\n  });\n\n  const updateMutation = useMutation({\n    mutationFn: (data: { id: string; employee: Partial<Employee> }) =>\n      updateEmployee(wsId, data.id, data.employee),\n    onSuccess: () => {\n      void queryClient.invalidateQueries({ queryKey: [\"employees\", wsId] });\n      onClose();\n      toast.success(t(\"common.success\"));\n      onSuccess?.();\n    },\n  });\n\n  return { createMutation, updateMutation };\n}\n\n\nexport default function EmployeeFormModal({\n  isOpen,\n  onClose,\n  editingEmployee,\n  wsId,\n  prefillEnrollmentId = \"\",\n  onSuccess,\n}: EmployeeFormModalProps) {\n  const { t } = useTranslation();\n  const { createMutation, updateMutation } = useEmployeeMutations(wsId, onClose, onSuccess);\n\n  const [members, setMembers] = useState<WorkspaceMember[]>([]);\n  const [selectedUserId, setSelectedUserId] = useState(editingEmployee?.user_id ?? \"\");\n\n  useEffect(() => {\n    // eslint-disable-next-line react-hooks/set-state-in-effect -- Derived state synced from props; intentional pattern\n    setSelectedUserId(editingEmployee?.user_id ?? \"\");\n  }, [editingEmployee]);\n\n  useEffect(() => {\n    if (isOpen && wsId) {\n      void fetchWorkspaceMembers(wsId).then(setMembers).catch(() => { /* empty */ });\n    }\n  }, [isOpen, wsId]);\n\n  const handleSubmit = (e: React.SyntheticEvent<HTMLFormElement>) => {\n    e.preventDefault();\n    const formData = new FormData(e.currentTarget);\n    const data: Partial<Employee> = {\n      full_name: formData.get(\"full_name\") as string,\n      employee_id_number: formData.get(\"employee_id_number\") as string,\n      hire_date: formData.get(\"hire_date\") as string,\n      is_active: formData.get(\"is_active\") === \"on\",\n    };\n    if (selectedUserId) {\n      data.user_id = selectedUserId;\n    }\n    if (editingEmployee) {\n      updateMutation.mutate({ id: editingEmployee.id, employee: data });\n    } else {\n      createMutation.mutate(data);\n    }\n  };\n\n  return (\n    <Modal\n      icon={<UserCircle size={24} />}\n      isOpen={isOpen}\n      maxWidth=\"lg\"\n      onClose={onClose}\n      subtitle={t(\"employees.form.subtitle\")}\n      title={editingEmployee ? t(\"employees.form.edit_title\") : t(\"employees.form.add_title\")}\n    >\n      <form className=\"space-y-8 pt-4 animate-in fade-in duration-500\" onSubmit={handleSubmit}>\n        <FormField\n          data-testid=\"employees-form-name-input\"\n          defaultValue={editingEmployee?.full_name}\n          label={t(\"employees.form.full_name\")}\n          name=\"full_name\"\n          required\n        />\n        <FormField\n          data-testid=\"employees-form-id-input\"\n          defaultValue={editingEmployee?.employee_id_number ?? prefillEnrollmentId}\n          inputClassName=\"font-mono tracking-widest\"\n          label={t(\"employees.form.employee_id\")}\n          name=\"employee_id_number\"\n          required\n        />\n        <FormField\n          data-testid=\"employees-form-hire-date-input\"\n          defaultValue={editingEmployee?.hire_date}\n          label={t(\"employees.form.hire_date\")}\n          name=\"hire_date\"\n          required\n          type=\"date\"\n        />\n        <div className=\"space-y-3 px-1\">\n          <label className=\"text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.2em]\">\n            {t(\"employees.form.link_user\")}\n          </label>\n          <Combobox\n            clearOnEscape\n            data-testid=\"employees-form-user-combobox\"\n            onChange={setSelectedUserId}\n            options={members.map(m => ({\n              value: m.user_id,\n              label: m.full_name ?? m.email,\n              description: m.email,\n            }))}\n            placeholder={t(\"employees.form.select_user\")}\n            value={selectedUserId}\n          />\n        </div>\n        <div className=\"flex items-center gap-4 py-2 px-2 group cursor-pointer\">\n          <input\n            className=\"w-7 h-7 text-primary-600 dark:text-primary-400 rounded-xl border-slate-200 dark:border-slate-700 focus:ring-primary-500 transition-all cursor-pointer shadow-inner\"\n            data-testid=\"employees-form-active-checkbox\"\n            defaultChecked={editingEmployee ? editingEmployee.is_active : true}\n            id=\"is_active\"\n            name=\"is_active\"\n            type=\"checkbox\"\n          />\n          <label\n            className=\"text-sm font-bold text-slate-700 dark:text-slate-200 uppercase tracking-widest cursor-pointer group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors\"\n            htmlFor=\"is_active\"\n          >\n            {t(\"employees.form.is_active\")}\n          </label>\n        </div>\n        <div className=\"pt-6 grid grid-cols-2 gap-6 border-t border-slate-50 dark:border-slate-800\">\n          <Button onClick={onClose} size=\"lg\" type=\"button\" variant=\"outline\">\n            {t(\"employees.form.cancel\").toUpperCase()}\n          </Button>\n          <Button\n            data-testid=\"save-employee-btn\"\n            loading={createMutation.isPending || updateMutation.isPending}\n            size=\"lg\"\n            type=\"submit\"\n            variant=\"secondary\"\n          >\n            {editingEmployee ? t(\"employees.form.update\").toUpperCase() : t(\"employees.form.save\").toUpperCase()}\n          </Button>\n        </div>\n      </form>\n    </Modal>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/employees/employment-history-modal.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/employees/rehire-employee-modal.tsx","messages":[{"ruleId":"react/no-unescaped-entities","severity":2,"message":"`\"` can be escaped with `&quot;`, `&ldquo;`, `&#34;`, `&rdquo;`.","line":65,"column":13,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&quot;"},"fix":{"range":[2197,2211],"text":"\n            &quot;"},"desc":"Replace with `&quot;`."},{"messageId":"replaceWithAlt","data":{"alt":"&ldquo;"},"fix":{"range":[2197,2211],"text":"\n            &ldquo;"},"desc":"Replace with `&ldquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#34;"},"fix":{"range":[2197,2211],"text":"\n            &#34;"},"desc":"Replace with `&#34;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rdquo;"},"fix":{"range":[2197,2211],"text":"\n            &rdquo;"},"desc":"Replace with `&rdquo;`."}]},{"ruleId":"react/no-unescaped-entities","severity":2,"message":"`\"` can be escaped with `&quot;`, `&ldquo;`, `&#34;`, `&rdquo;`.","line":65,"column":49,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&quot;"},"fix":{"range":[2246,2258],"text":"&quot;\n          "},"desc":"Replace with `&quot;`."},{"messageId":"replaceWithAlt","data":{"alt":"&ldquo;"},"fix":{"range":[2246,2258],"text":"&ldquo;\n          "},"desc":"Replace with `&ldquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#34;"},"fix":{"range":[2246,2258],"text":"&#34;\n          "},"desc":"Replace with `&#34;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rdquo;"},"fix":{"range":[2246,2258],"text":"&rdquo;\n          "},"desc":"Replace with `&rdquo;`."}]}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useMutation, useQueryClient } from \"@tanstack/react-query\";\nimport { UserPlus } from \"lucide-react\";\nimport React from \"react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { format } from \"date-fns\";\n\nimport Button from \"@/components/ui/button\";\nimport FormField from \"@/components/ui/form-field\";\nimport Modal from \"@/components/ui/modal\";\nimport { useToast } from \"@/components/ui/toast\";\nimport { rehireEmployee, Employee } from \"@/lib/api\";\n\ninterface RehireEmployeeModalProps {\n  employeeId: string | null;\n  isOpen: boolean;\n  onClose: () => void;\n  onSuccess?: (employee: Employee) => void;\n  wsId: string;\n}\n\nexport default function RehireEmployeeModal({\n  isOpen,\n  onClose,\n  employeeId,\n  wsId,\n  onSuccess,\n}: RehireEmployeeModalProps) {\n  const { t } = useTranslation();\n  const queryClient = useQueryClient();\n  const toast = useToast();\n\n  const rehireMutation = useMutation({\n    mutationFn: (data: { hire_date: string }) => {\n      if (!employeeId) throw new Error(\"No employee selected\");\n      return rehireEmployee(wsId, employeeId, data);\n    },\n    onSuccess: (updatedEmp) => {\n      void queryClient.invalidateQueries({ queryKey: [\"employees\", wsId] });\n      void queryClient.invalidateQueries({ queryKey: [\"employmentHistory\", employeeId] });\n      onClose();\n      toast.success(t(\"common.success\"));\n      onSuccess?.(updatedEmp);\n    },\n  });\n\n  const handleRehireSubmit = (e: React.SyntheticEvent<HTMLFormElement>) => {\n    e.preventDefault();\n    const formData = new FormData(e.currentTarget);\n    rehireMutation.mutate({ hire_date: formData.get(\"hire_date\") as string });\n  };\n\n  return (\n    <Modal\n      icon={<UserPlus size={24} />}\n      isOpen={isOpen}\n      maxWidth=\"md\"\n      onClose={onClose}\n      subtitle={t(\"employees.rehire.subtitle\")}\n      title={t(\"employees.rehire.title\")}\n    >\n      <div className=\"space-y-10 pt-4 animate-in fade-in duration-500\">\n        <div className=\"p-8 bg-slate-50 dark:bg-slate-800 rounded-[2.5rem] border border-slate-100 dark:border-slate-800 shadow-inner text-center italic\">\n          <p className=\"text-sm font-bold text-slate-600 dark:text-slate-300 uppercase tracking-tight leading-relaxed\">\n            \"{t(\"employees.rehire.confirm_msg\")}\"\n          </p>\n        </div>\n        <form className=\"space-y-8\" onSubmit={handleRehireSubmit}>\n          <FormField\n            defaultValue={format(new Date(), \"yyyy-MM-dd\")}\n            label={t(\"employees.rehire.rehire_date\")}\n            name=\"hire_date\"\n            required\n            type=\"date\"\n          />\n          <div className=\"pt-6 grid grid-cols-2 gap-6 border-t border-slate-50 dark:border-slate-800\">\n            <Button onClick={onClose} size=\"lg\" type=\"button\" variant=\"outline\">\n              {t(\"common.cancel\").toUpperCase()}\n            </Button>\n            <Button\n              data-testid=\"confirm-rehire-btn\"\n              loading={rehireMutation.isPending}\n              size=\"lg\"\n              type=\"submit\"\n            >\n              {rehireMutation.isPending\n                ? t(\"employees.rehire.processing\").toUpperCase()\n                : t(\"employees.rehire.confirm\").toUpperCase()}\n            </Button>\n          </div>\n        </form>\n      </div>\n    </Modal>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/employees/transfer-employee-modal.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/leave/__tests__/leave-import-dialog.test.tsx","messages":[{"ruleId":"@typescript-eslint/require-await","severity":2,"message":"Async arrow function has no 'await' expression.","line":252,"column":61,"nodeType":"ArrowFunctionExpression","messageId":"missingAwait","endLine":252,"endColumn":63,"suggestions":[{"messageId":"removeAsync","fix":{"range":[9470,9476],"text":""},"desc":"Remove 'async'."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { render, screen, fireEvent, waitFor } from \"@testing-library/react\";\n\nimport userEvent from \"@testing-library/user-event\";\nimport { describe, it, expect, vi, beforeEach, afterEach } from \"vitest\";\n\nimport * as api from \"@/lib/api\";\n\nimport LeaveImportDialog from \"../leave-import-dialog\";\n\n// Mock API\nvi.mock(\"@/lib/api\", () => ({\n  uploadLeaveExcel: vi.fn(),\n  fetchLatestLeaveImport: vi.fn().mockResolvedValue(null),\n  downloadLeaveImportTemplate: vi.fn().mockResolvedValue(undefined),\n  downloadLeaveImportErrors: vi.fn().mockResolvedValue(undefined),\n  getCurrentWorkspaceId: vi.fn().mockReturnValue(\"ws-test\"),\n}));\n\n// Mock i18n — return key as text for testability\nvi.mock(\"react-i18next\", () => ({\n  useTranslation: () => ({\n    t: (key: string, fallback?: string) => fallback ?? key,\n    i18n: { language: \"vi\" },\n  }),\n}));\n\nconst createFile = (name = \"test.xlsx\", size = 1024) => {\n  const content = new ArrayBuffer(size);\n  return new File([content], name, {\n    type: \"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet\",\n  });\n};\n\ndescribe(\"LeaveImportDialog\", () => {\n  let onClose: () => void;\n  let onImportComplete: () => void;\n\n  beforeEach(() => {\n    vi.clearAllMocks();\n    vi.useFakeTimers({ shouldAdvanceTime: true });\n    onClose = vi.fn();\n    onImportComplete = vi.fn();\n \n    (api.getCurrentWorkspaceId as import(\"vitest\").Mock).mockReturnValue(\"ws-test\");\n \n    (api.fetchLatestLeaveImport as import(\"vitest\").Mock).mockResolvedValue(null);\n  });\n\n  afterEach(() => {\n    vi.useRealTimers();\n  });\n\n  const renderDialog = (props: Partial<Parameters<typeof LeaveImportDialog>[0]> = {}) =>\n    render(\n      <LeaveImportDialog\n        isOpen={true}\n        onClose={onClose}\n        onImportComplete={onImportComplete}\n        {...props}\n      />\n    );\n\n  // ═══════════════════════════════════════════════════════════════════\n  // Rendering\n  // ═══════════════════════════════════════════════════════════════════\n\n  describe(\"Rendering\", () => {\n    it(\"renders nothing when isOpen is false\", () => {\n      renderDialog({ isOpen: false });\n      expect(screen.queryByTestId(\"leave-import-dialog\")).toBeNull();\n    });\n\n    it(\"renders modal with title and subtitle when isOpen\", () => {\n      renderDialog();\n      expect(screen.getByText(/Import đơn nghỉ phép/i)).toBeDefined();\n      expect(screen.getByText(/Upload file Excel/i)).toBeDefined();\n    });\n\n    it(\"renders instructions panel with all 6 column requirements\", () => {\n      renderDialog();\n      expect(screen.getByText(/Yêu cầu file/i)).toBeDefined();\n      expect(screen.getByText(/Cột A: Mã nhân viên/i)).toBeDefined();\n      expect(screen.getByText(/Cột B: Mã loại nghỉ/i)).toBeDefined();\n      expect(screen.getByText(/Cột C-D/i)).toBeDefined();\n      expect(screen.getByText(/Cột E: Lý do/i)).toBeDefined();\n      expect(screen.getByText(/Cột F: Loại thời gian/i)).toBeDefined();\n      expect(screen.getAllByText(/\\.xlsx, \\.xls, \\.csv/i).length).toBeGreaterThanOrEqual(1);\n    });\n\n    it(\"renders download template button\", () => {\n      renderDialog();\n      expect(screen.getByText(/Tải file mẫu Excel/i)).toBeDefined();\n    });\n\n    it(\"renders file drop zone with prompt\", () => {\n      renderDialog();\n      expect(screen.getByText(/Nhấn để chọn file Excel/i)).toBeDefined();\n      expect(screen.getByText(/Hỗ trợ .xlsx, .xls, .csv/i)).toBeDefined();\n    });\n\n    it(\"renders cancel and import buttons\", () => {\n      renderDialog();\n      expect(screen.getByText(\"Hủy\")).toBeDefined();\n      expect(screen.getByText(/BẮT ĐẦU IMPORT/i)).toBeDefined();\n    });\n\n    it(\"disables import button when no file selected\", () => {\n      renderDialog();\n      const importButton = screen.getByText(/BẮT ĐẦU IMPORT/i).closest(\"button\");\n      expect(importButton).toBeDisabled();\n    });\n  });\n\n  // ═══════════════════════════════════════════════════════════════════\n  // File Selection\n  // ═══════════════════════════════════════════════════════════════════\n\n  describe(\"File Selection\", () => {\n    it(\"shows file info when a file is selected\", async () => {\n      renderDialog();\n      const fileInput = document.getElementById(\"leave-import-file-input\") as HTMLInputElement;\n      expect(fileInput).toBeDefined();\n\n      const file = createFile(\"leave_data.xlsx\", 2048);\n      fireEvent.change(fileInput, { target: { files: [file] } });\n\n      expect(await screen.findByText(\"leave_data.xlsx\")).toBeDefined();\n      expect(screen.getByText(/2\\.0 KB/i)).toBeDefined();\n      expect(screen.getByText(/SẴN SÀNG UPLOAD/i)).toBeDefined();\n    });\n\n    it(\"enables import button after file selection\", () => {\n      renderDialog();\n      const fileInput = document.getElementById(\"leave-import-file-input\") as HTMLInputElement;\n      const file = createFile();\n      fireEvent.change(fileInput, { target: { files: [file] } });\n\n      const importButton = screen.getByText(/BẮT ĐẦU IMPORT/i).closest(\"button\");\n      expect(importButton).not.toBeDisabled();\n    });\n\n    it(\"shows 'select another file' button and allows file removal\", async () => {\n      const user = userEvent.setup({ advanceTimers: vi.advanceTimersByTime });\n      renderDialog();\n      const fileInput = document.getElementById(\"leave-import-file-input\") as HTMLInputElement;\n      fireEvent.change(fileInput, { target: { files: [createFile()] } });\n\n      const removeButton = await screen.findByText(/Chọn file khác/i);\n      expect(removeButton).toBeDefined();\n\n      await user.click(removeButton);\n      // Drop zone prompt should reappear\n      expect(screen.getByText(/Nhấn để chọn file Excel/i)).toBeDefined();\n    });\n  });\n\n  // ═══════════════════════════════════════════════════════════════════\n  // Template Download\n  // ═══════════════════════════════════════════════════════════════════\n\n  describe(\"Template Download\", () => {\n    it(\"calls downloadLeaveImportTemplate when button is clicked\", async () => {\n      const user = userEvent.setup({ advanceTimers: vi.advanceTimersByTime });\n \n      (api.downloadLeaveImportTemplate as import(\"vitest\").Mock).mockResolvedValue(undefined);\n      renderDialog();\n\n      const downloadButton = screen.getByText(/Tải file mẫu Excel/i).closest(\"button\")!;\n      await user.click(downloadButton);\n\n      await waitFor(() => {\n        expect(api.downloadLeaveImportTemplate).toHaveBeenCalledWith(\"ws-test\", \"vi\");\n      });\n    });\n\n    it(\"handles template download error gracefully\", async () => {\n      const user = userEvent.setup({ advanceTimers: vi.advanceTimersByTime });\n \n      (api.downloadLeaveImportTemplate as import(\"vitest\").Mock).mockRejectedValue(new Error(\"Network error\"));\n      renderDialog();\n\n      const downloadButton = screen.getByText(/Tải file mẫu Excel/i).closest(\"button\")!;\n      // Should not throw\n      await user.click(downloadButton);\n      \n      // Button should still be clickable after error\n      await waitFor(() => {\n        expect(downloadButton).not.toBeDisabled();\n      });\n    });\n  });\n\n  // ═══════════════════════════════════════════════════════════════════\n  // Upload Flow\n  // ═══════════════════════════════════════════════════════════════════\n\n  describe(\"Upload Flow\", () => {\n    it(\"calls uploadLeaveExcel with correct args when import is clicked\", async () => {\n      const user = userEvent.setup({ advanceTimers: vi.advanceTimersByTime });\n \n      (api.uploadLeaveExcel as import(\"vitest\").Mock).mockResolvedValue({ job_id: \"job-123\" });\n      renderDialog();\n\n      const fileInput = document.getElementById(\"leave-import-file-input\") as HTMLInputElement;\n      const file = createFile(\"data.xlsx\");\n      fireEvent.change(fileInput, { target: { files: [file] } });\n\n      const importButton = screen.getByText(/BẮT ĐẦU IMPORT/i).closest(\"button\")!;\n      await user.click(importButton);\n\n      await waitFor(() => {\n        expect(api.uploadLeaveExcel).toHaveBeenCalledWith(\"ws-test\", file);\n      });\n    });\n\n    it(\"transitions to progress view after successful upload\", async () => {\n      const user = userEvent.setup({ advanceTimers: vi.advanceTimersByTime });\n \n      (api.uploadLeaveExcel as import(\"vitest\").Mock).mockResolvedValue({ job_id: \"job-456\" });\n      renderDialog();\n\n      const fileInput = document.getElementById(\"leave-import-file-input\") as HTMLInputElement;\n      fireEvent.change(fileInput, { target: { files: [createFile()] } });\n\n      await user.click(screen.getByText(/BẮT ĐẦU IMPORT/i).closest(\"button\")!);\n\n      // Should switch to progress view\n      await waitFor(() => {\n        expect(screen.getByText(/Đang xử lý.../i)).toBeDefined();\n      });\n      // Upload view elements should be gone\n      expect(screen.queryByText(/Nhấn để chọn file Excel/i)).toBeNull();\n    });\n\n    it(\"handles upload error gracefully (stays on upload view)\", async () => {\n      const user = userEvent.setup({ advanceTimers: vi.advanceTimersByTime });\n \n      (api.uploadLeaveExcel as import(\"vitest\").Mock).mockRejectedValue(new Error(\"Upload failed\"));\n      renderDialog();\n\n      const fileInput = document.getElementById(\"leave-import-file-input\") as HTMLInputElement;\n      fireEvent.change(fileInput, { target: { files: [createFile()] } });\n\n      await user.click(screen.getByText(/BẮT ĐẦU IMPORT/i).closest(\"button\")!);\n\n      // Should stay on upload view after error\n      await waitFor(() => {\n        expect(screen.getByText(/BẮT ĐẦU IMPORT/i)).toBeDefined();\n      });\n    });\n\n    it(\"does not upload when no file is selected\", async () => {\n      renderDialog();\n      const importButton = screen.getByText(/BẮT ĐẦU IMPORT/i).closest(\"button\")!;\n      expect(importButton).toBeDisabled();\n      expect(api.uploadLeaveExcel).not.toHaveBeenCalled();\n    });\n\n    it(\"does not upload when workspace ID is null\", () => {\n \n      (api.getCurrentWorkspaceId as import(\"vitest\").Mock).mockReturnValue(null);\n      renderDialog();\n      // Template download button should be disabled\n      const downloadButton = screen.getByText(/Tải file mẫu Excel/i).closest(\"button\");\n      expect(downloadButton).toBeDisabled();\n    });\n  });\n\n  // ═══════════════════════════════════════════════════════════════════\n  // Progress / Status Views\n  // ═══════════════════════════════════════════════════════════════════\n\n  describe(\"Progress View\", () => {\n    it(\"shows processing status with progress rows\", async () => {\n \n      (api.fetchLatestLeaveImport as import(\"vitest\").Mock).mockResolvedValue({\n        id: \"job-1\",\n        status: \"processing\",\n        total_rows: 100,\n        processed_rows: 45,\n        error_log: null,\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString(),\n      });\n\n      renderDialog();\n\n      await waitFor(() => {\n        expect(screen.getByText(/Đang xử lý.../i)).toBeDefined();\n      });\n      expect(screen.getByText(/45 \\/ 100/i)).toBeDefined();\n      expect(screen.getByText(\"45%\")).toBeDefined();\n    });\n\n    it(\"shows completed status without errors\", async () => {\n \n      (api.fetchLatestLeaveImport as import(\"vitest\").Mock).mockResolvedValue({\n        id: \"job-2\",\n        status: \"completed\",\n        total_rows: 50,\n        processed_rows: 50,\n        error_log: null,\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString(),\n      });\n\n      renderDialog();\n\n      await waitFor(() => {\n        expect(screen.getByText(/Import thành công/i)).toBeDefined();\n      });\n      expect(screen.getByText(\"100%\")).toBeDefined();\n    });\n\n    it(\"shows partial success status with error details and download\", async () => {\n      const errorLog = JSON.stringify({\n        success_count: 40,\n        error_count: 10,\n        error_file_path: \"/tmp/errors.xlsx\",\n      });\n\n \n      (api.fetchLatestLeaveImport as import(\"vitest\").Mock).mockResolvedValue({\n        id: \"job-3\",\n        status: \"completed\",\n        total_rows: 50,\n        processed_rows: 40,\n        error_log: errorLog,\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString(),\n      });\n\n      renderDialog();\n\n      await waitFor(() => {\n        expect(screen.getByText(/Import có lỗi/i)).toBeDefined();\n      });\n      // Partial detail text\n      expect(screen.getByText(/40.*10/)).toBeDefined();\n      // Error file download button\n      expect(screen.getByText(/Tải file lỗi/i)).toBeDefined();\n    });\n\n    it(\"calls downloadLeaveImportErrors when clicking download errors button\", async () => {\n      const user = userEvent.setup({ advanceTimers: vi.advanceTimersByTime });\n      const errorLog = JSON.stringify({\n        success_count: 40,\n        error_count: 10,\n        error_file_path: \"/tmp/errors.xlsx\",\n      });\n\n \n      (api.fetchLatestLeaveImport as import(\"vitest\").Mock).mockResolvedValue({\n        id: \"job-err\",\n        status: \"completed\",\n        total_rows: 50,\n        processed_rows: 40,\n        error_log: errorLog,\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString(),\n      });\n\n      renderDialog();\n\n      const errorButton = await screen.findByText(/Tải file lỗi/i);\n      await user.click(errorButton);\n\n      expect(api.downloadLeaveImportErrors).toHaveBeenCalledWith(\"ws-test\", \"job-err\");\n    });\n\n    it(\"shows failed status with error detail\", async () => {\n \n      (api.fetchLatestLeaveImport as import(\"vitest\").Mock).mockResolvedValue({\n        id: \"job-4\",\n        status: \"failed\",\n        total_rows: 0,\n        processed_rows: 0,\n        error_log: \"Connection timeout to database\",\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString(),\n      });\n\n      renderDialog();\n\n      await waitFor(() => {\n        expect(screen.getByText(/Import thất bại/i)).toBeDefined();\n      });\n      expect(screen.getByText(/Chi tiết lỗi/i)).toBeDefined();\n      expect(screen.getByText(/Connection timeout/i)).toBeDefined();\n    });\n\n    it(\"shows footer buttons (upload another + close) when finished\", async () => {\n \n      (api.fetchLatestLeaveImport as import(\"vitest\").Mock).mockResolvedValue({\n        id: \"job-5\",\n        status: \"completed\",\n        total_rows: 50,\n        processed_rows: 50,\n        error_log: null,\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString(),\n      });\n\n      renderDialog();\n\n      await waitFor(() => {\n        expect(screen.getByText(/Upload file khác/i)).toBeDefined();\n      });\n      expect(screen.getByText(/ĐÓNG/i)).toBeDefined();\n    });\n\n    it(\"hides footer buttons while processing\", async () => {\n \n      (api.fetchLatestLeaveImport as import(\"vitest\").Mock).mockResolvedValue({\n        id: \"job-6\",\n        status: \"processing\",\n        total_rows: 100,\n        processed_rows: 10,\n        error_log: null,\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString(),\n      });\n\n      renderDialog();\n\n      await waitFor(() => {\n        expect(screen.getByText(/Đang xử lý.../i)).toBeDefined();\n      });\n      expect(screen.queryByText(/Upload file khác/i)).toBeNull();\n      expect(screen.queryByText(/ĐÓNG/i)).toBeNull();\n    });\n\n    it(\"resets to upload view when 'upload another' is clicked\", async () => {\n      const user = userEvent.setup({ advanceTimers: vi.advanceTimersByTime });\n \n      (api.fetchLatestLeaveImport as import(\"vitest\").Mock).mockResolvedValue({\n        id: \"job-7\",\n        status: \"completed\",\n        total_rows: 10,\n        processed_rows: 10,\n        error_log: null,\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString(),\n      });\n\n      renderDialog();\n\n      const uploadAnotherButton = await screen.findByText(/Upload file khác/i);\n      await user.click(uploadAnotherButton);\n\n      // Should show upload view again\n      await waitFor(() => {\n        expect(screen.getByText(/Nhấn để chọn file Excel/i)).toBeDefined();\n      });\n    });\n  });\n\n  // ═══════════════════════════════════════════════════════════════════\n  // Callbacks\n  // ═══════════════════════════════════════════════════════════════════\n\n  describe(\"Callbacks\", () => {\n    it(\"calls onClose when cancel button is clicked\", async () => {\n      const user = userEvent.setup({ advanceTimers: vi.advanceTimersByTime });\n      renderDialog();\n\n      await user.click(screen.getByText(\"Hủy\"));\n      expect(onClose).toHaveBeenCalled();\n    });\n\n    it(\"calls onClose when close button is clicked after completion\", async () => {\n      const user = userEvent.setup({ advanceTimers: vi.advanceTimersByTime });\n \n      (api.fetchLatestLeaveImport as import(\"vitest\").Mock).mockResolvedValue({\n        id: \"job-done\",\n        status: \"completed\",\n        total_rows: 10,\n        processed_rows: 10,\n        error_log: null,\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString(),\n      });\n\n      renderDialog();\n      const closeButton = await screen.findByText(/ĐÓNG/i);\n      await user.click(closeButton);\n      expect(onClose).toHaveBeenCalled();\n    });\n  });\n\n  // ═══════════════════════════════════════════════════════════════════\n  // Latest Job Recovery (offline resilience)\n  // ═══════════════════════════════════════════════════════════════════\n\n  describe(\"Job Recovery\", () => {\n    it(\"fetches latest import job on mount when open\", async () => {\n      renderDialog();\n      await waitFor(() => {\n        expect(api.fetchLatestLeaveImport).toHaveBeenCalledWith(\"ws-test\");\n      });\n    });\n\n    it(\"does NOT fetch latest job when isOpen is false\", () => {\n      renderDialog({ isOpen: false });\n      expect(api.fetchLatestLeaveImport).not.toHaveBeenCalled();\n    });\n\n    it(\"ignores jobs older than 24 hours\", async () => {\n      const oldDate = new Date(Date.now() - 25 * 60 * 60 * 1000).toISOString();\n \n      (api.fetchLatestLeaveImport as import(\"vitest\").Mock).mockResolvedValue({\n        id: \"job-old\",\n        status: \"completed\",\n        total_rows: 10,\n        processed_rows: 10,\n        error_log: null,\n        created_at: oldDate,\n        updated_at: oldDate,\n      });\n\n      renderDialog();\n\n      // Should show upload view, not progress view\n      await waitFor(() => {\n        expect(screen.getByText(/Nhấn để chọn file Excel/i)).toBeDefined();\n      });\n    });\n\n    it(\"shows existing processing job when dialog opens\", async () => {\n \n      (api.fetchLatestLeaveImport as import(\"vitest\").Mock).mockResolvedValue({\n        id: \"job-active\",\n        status: \"processing\",\n        total_rows: 200,\n        processed_rows: 80,\n        error_log: null,\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString(),\n      });\n\n      renderDialog();\n\n      await waitFor(() => {\n        expect(screen.getByText(/Đang xử lý.../i)).toBeDefined();\n      });\n      expect(screen.getByText(/80 \\/ 200/i)).toBeDefined();\n    });\n\n    it(\"handles API error when fetching latest job\", async () => {\n \n      (api.fetchLatestLeaveImport as import(\"vitest\").Mock).mockRejectedValue(new Error(\"Server error\"));\n      renderDialog();\n      // Should fall back to upload view\n      await waitFor(() => {\n        expect(screen.getByText(/Nhấn để chọn file Excel/i)).toBeDefined();\n      });\n    });\n  });\n\n  // ═══════════════════════════════════════════════════════════════════\n  // Edge Cases\n  // ═══════════════════════════════════════════════════════════════════\n\n  describe(\"Edge Cases\", () => {\n    it(\"resets file state when dialog closes and reopens\", () => {\n      const { rerender } = render(\n        <LeaveImportDialog isOpen={true} onClose={onClose} />\n      );\n\n      // Select a file\n      const fileInput = document.getElementById(\"leave-import-file-input\") as HTMLInputElement;\n      fireEvent.change(fileInput, { target: { files: [createFile()] } });\n      expect(screen.getByText(\"test.xlsx\")).toBeDefined();\n\n      // Close dialog\n      rerender(<LeaveImportDialog isOpen={false} onClose={onClose} />);\n      // Reopen\n      rerender(<LeaveImportDialog isOpen={true} onClose={onClose} />);\n\n      // Should be reset\n      expect(screen.getByText(/Nhấn để chọn file Excel/i)).toBeDefined();\n    });\n\n    it(\"handles completed job with unparseable error_log\", async () => {\n \n      (api.fetchLatestLeaveImport as import(\"vitest\").Mock).mockResolvedValue({\n        id: \"job-bad-log\",\n        status: \"completed\",\n        total_rows: 20,\n        processed_rows: 15,\n        error_log: \"not-json-just-text\",\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString(),\n      });\n\n      renderDialog();\n\n      await waitFor(() => {\n        expect(screen.getByText(/Import có lỗi/i)).toBeDefined();\n      });\n      // Should show partial detail with fallback values\n      expect(screen.getAllByText(/15/).length).toBeGreaterThanOrEqual(1);\n    });\n\n    it(\"handles pending job with zero total_rows\", async () => {\n \n      (api.fetchLatestLeaveImport as import(\"vitest\").Mock).mockResolvedValue({\n        id: \"job-pending\",\n        status: \"pending\",\n        total_rows: 0,\n        processed_rows: 0,\n        error_log: null,\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString(),\n      });\n\n      renderDialog();\n\n      await waitFor(() => {\n        expect(screen.getByText(/Đang xử lý.../i)).toBeDefined();\n      });\n      // Should show \"0 / ?\" for rows\n      expect(screen.getByText(/0 \\/ \\?/)).toBeDefined();\n    });\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/leave/create-leave-request-modal.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/leave/leave-import-banner.tsx","messages":[{"ruleId":"complexity","severity":2,"message":"Function 'LeaveImportBanner' has a complexity of 21. Maximum allowed is 10.","line":26,"column":8,"nodeType":"FunctionDeclaration","messageId":"complex","endLine":26,"endColumn":34},{"ruleId":"complexity","severity":2,"message":"Arrow function has a complexity of 11. Maximum allowed is 10.","line":67,"column":75,"nodeType":"ArrowFunctionExpression","messageId":"complex","endLine":67,"endColumn":77}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import type { TFunction } from \"i18next\";\n\nimport { CheckCircle2, XCircle, AlertTriangle, Download, Loader2, X } from \"lucide-react\";\nimport React from \"react\";\n\nimport type { LeaveImportJob } from \"@/lib/api/leaves\";\n\nimport { downloadLeaveImportErrors } from \"@/lib/api\";\nimport { cn } from \"@/lib/utils\";\n\nfunction getImportErrorInfo(job: LeaveImportJob) {\n  if (!job.error_log) return null;\n  try {\n    return JSON.parse(job.error_log) as { success_count?: number; error_count?: number; error_file_path?: string };\n  } catch { return null; }\n}\n\nexport interface LeaveImportBannerProps {\n  importBannerDismissed: boolean;\n  importJob: LeaveImportJob | null;\n  setImportBannerDismissed: (val: boolean) => void;\n  t: TFunction;\n  wsId: string;\n}\n\nexport function LeaveImportBanner({ importJob, importBannerDismissed, setImportBannerDismissed, t, wsId }: LeaveImportBannerProps) {\n  if (!importJob || importBannerDismissed) return null;\n\n  return (\n    <div className={cn(\n      \"rounded-2xl px-6 py-4 flex items-center justify-between gap-4 animate-in slide-in-from-top-4 duration-500 border\",\n      importJob.status === 'processing' || importJob.status === 'pending'\n        ? \"bg-blue-50 dark:bg-blue-950/30 border-blue-200 dark:border-blue-800/50\"\n        : importJob.status === 'completed' && !importJob.error_log\n          ? \"bg-emerald-50 dark:bg-emerald-950/30 border-emerald-200 dark:border-emerald-800/50\"\n          : importJob.status === 'completed' && importJob.error_log\n            ? \"bg-amber-50 dark:bg-amber-950/30 border-amber-200 dark:border-amber-800/50\"\n            : \"bg-red-50 dark:bg-red-950/30 border-red-200 dark:border-red-800/50\"\n    )}>\n      <div className=\"flex items-center gap-3 flex-1 min-w-0\">\n        {(importJob.status === 'processing' || importJob.status === 'pending') && (\n          <>\n            <Loader2 className=\"animate-spin text-blue-500 flex-shrink-0\" size={20} />\n            <div>\n              <p className=\"text-sm font-semibold text-blue-700 dark:text-blue-300\">\n                {t(\"leave_requests.upload_processing\", \"Đang xử lý {{processed}}/{{total}} dòng...\").replace('{{processed}}', String(importJob.processed_rows)).replace('{{total}}', String(importJob.total_rows || '?'))}\n              </p>\n              {importJob.total_rows > 0 && (\n                <div className=\"mt-2 h-2 rounded-full bg-blue-100 dark:bg-blue-900 overflow-hidden w-48\">\n                  <div\n                    className=\"h-full rounded-full bg-blue-500 transition-all duration-500\"\n                    style={{ width: `${Math.min(100, (importJob.processed_rows / importJob.total_rows) * 100).toString()}%` }}\n                  />\n                </div>\n              )}\n            </div>\n          </>\n        )}\n        {importJob.status === 'completed' && !importJob.error_log && (\n          <>\n            <CheckCircle2 className=\"text-emerald-500 flex-shrink-0\" size={20} />\n            <p className=\"text-sm font-semibold text-emerald-700 dark:text-emerald-300\">\n              {t(\"leave_requests.upload_success\", \"Import thành công {{success}} đơn nghỉ\").replace('{{success}}', String(importJob.processed_rows))}\n            </p>\n          </>\n        )}\n        {importJob.status === 'completed' && !!importJob.error_log && (() => {\n          const info = getImportErrorInfo(importJob);\n          return (\n            <>\n              <AlertTriangle className=\"text-amber-500 flex-shrink-0\" size={20} />\n              <p className=\"text-sm font-semibold text-amber-700 dark:text-amber-300\">\n                {t(\"leave_requests.upload_partial\", \"Thành công {{success}}/{{total}}. {{errors}} dòng lỗi.\")\n                  .replace('{{success}}', String(info?.success_count ?? importJob.processed_rows))\n                  .replace('{{total}}', String((info?.success_count ?? 0) + (info?.error_count ?? 0)))\n                  .replace('{{errors}}', String(info?.error_count ?? 0))}\n              </p>\n              {info?.error_file_path ? (\n                <button\n                  className=\"ml-2 flex items-center gap-1.5 text-xs font-bold text-amber-600 hover:text-amber-800 dark:text-amber-400 dark:hover:text-amber-200 underline underline-offset-2\"\n                  onClick={() => { void downloadLeaveImportErrors(wsId, importJob.id).catch(() => { /* empty */ }); }}\n                >\n                  <Download size={14} /> {t(\"leave_requests.download_errors\", \"Tải file lỗi\")}\n                </button>\n              ) : null}\n            </>\n          );\n        })()}\n        {importJob.status === 'failed' && (\n          <>\n            <XCircle className=\"text-red-500 flex-shrink-0\" size={20} />\n            <p className=\"text-sm font-semibold text-red-700 dark:text-red-300\">\n              {t(\"leave_requests.upload_failed\", \"Import thất bại\")}\n              {importJob.error_log ? <span className=\"font-normal ml-2 text-xs opacity-75\">— {importJob.error_log.substring(0, 100)}</span> : null}\n            </p>\n          </>\n        )}\n      </div>\n      {importJob.status !== 'processing' && importJob.status !== 'pending' && (\n        <button className=\"text-primary-400 hover:text-primary-600 transition-colors flex-shrink-0\" onClick={() => { setImportBannerDismissed(true); }}>\n          <X size={18} />\n        </button>\n      )}\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/leave/leave-import-dialog.tsx","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Function 'LeaveImportDialog' has too many lines (123). Maximum allowed is 100.","line":19,"column":16,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":154,"endColumn":2},{"ruleId":"complexity","severity":2,"message":"Function 'LeaveImportDialog' has a complexity of 13. Maximum allowed is 10.","line":19,"column":16,"nodeType":"FunctionDeclaration","messageId":"complex","endLine":19,"endColumn":42}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Upload } from \"lucide-react\";\nimport { useState, useEffect, useCallback, useRef } from \"react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport type { LeaveImportJob } from \"@/lib/api/leaves\";\n\nimport Modal from \"@/components/ui/modal\";\nimport { uploadLeaveExcel, fetchLatestLeaveImport, getCurrentWorkspaceId } from \"@/lib/api\";\n\nimport { LeaveImportProgressView } from \"./leave-import-progress-view\";\nimport { LeaveImportUploadView } from \"./leave-import-upload-view\";\n\ninterface LeaveImportDialogProps {\n  isOpen: boolean;\n  onClose: () => void;\n  onImportComplete?: () => void;\n}\n\nexport default function LeaveImportDialog({\n  isOpen,\n  onClose,\n  onImportComplete,\n}: LeaveImportDialogProps) {\n  const { t, i18n } = useTranslation();\n  const wsId = getCurrentWorkspaceId();\n  const [file, setFile] = useState<File | null>(null);\n  const [uploading, setUploading] = useState(false);\n  const [downloadingTemplate, setDownloadingTemplate] = useState(false);\n  const [importJob, setImportJob] = useState<LeaveImportJob | null>(null);\n  const pollingRef = useRef<ReturnType<typeof setInterval> | null>(null);\n\n  // Check for latest import when dialog opens\n  useEffect(() => {\n    if (!isOpen || !wsId) return;\n    void fetchLatestLeaveImport(wsId).then((job) => {\n      if (job) {\n        const created = new Date(job.created_at);\n        const now = new Date();\n        if (now.getTime() - created.getTime() < 24 * 60 * 60 * 1000) {\n          setImportJob(job);\n        }\n      }\n    }).catch(() => { /* empty */ });\n  }, [isOpen, wsId]);\n\n  // Polling for job status\n  const startPolling = useCallback((wsIdValue: string) => {\n    if (pollingRef.current) clearInterval(pollingRef.current);\n    pollingRef.current = setInterval(() => {\n      void (async () => {\n        try {\n          const job = await fetchLatestLeaveImport(wsIdValue);\n          if (job) {\n            setImportJob(job);\n            if (job.status !== \"processing\" && job.status !== \"pending\") {\n              if (pollingRef.current) clearInterval(pollingRef.current);\n              pollingRef.current = null;\n              onImportComplete?.();\n            }\n          }\n        } catch {\n          // Network error — keep polling\n        }\n      })();\n    }, 2000);\n  }, [onImportComplete]);\n\n  useEffect(() => {\n    if (importJob?.status === \"processing\" || importJob?.status === \"pending\") {\n      if (wsId) startPolling(wsId);\n    }\n    return () => {\n      if (pollingRef.current) clearInterval(pollingRef.current);\n    };\n  }, [importJob?.status, wsId, startPolling]);\n\n  // Reset state when dialog closes\n  const [previousIsOpen, setPreviousIsOpen] = useState(isOpen);\n  if (isOpen !== previousIsOpen) {\n    setPreviousIsOpen(isOpen);\n    if (!isOpen) setFile(null);\n  }\n\n  const handleUpload = async () => {\n    if (!file || !wsId) return;\n    setUploading(true);\n    try {\n      const result = await uploadLeaveExcel(wsId, file);\n      setImportJob({\n        id: result.job_id,\n        status: \"pending\",\n        total_rows: 0,\n        processed_rows: 0,\n        error_log: null,\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString(),\n      });\n      setFile(null);\n      startPolling(wsId);\n    } catch {\n      // Error handled by toast in parent or here\n    } finally {\n      setUploading(false);\n    }\n  };\n\n  const getErrorInfo = (job: LeaveImportJob) => {\n    if (!job.error_log) return null;\n    try {\n      return JSON.parse(job.error_log) as { success_count?: number; error_count?: number; error_file_path?: string };\n    } catch { return null; }\n  };\n\n  const isProcessing = importJob?.status === \"processing\" || importJob?.status === \"pending\";\n  const isFinished = importJob?.status === \"completed\" || importJob?.status === \"failed\";\n\n  return (\n    <Modal\n      icon={<Upload size={24} />}\n      isOpen={isOpen}\n      maxWidth=\"lg\"\n      onClose={onClose}\n      subtitle={t(\"leave_import.subtitle\", \"Upload file Excel để tạo đơn nghỉ phép hàng loạt\")}\n      testId=\"leave-import-dialog\"\n      title={t(\"leave_import.title\", \"Import đơn nghỉ phép\")}\n    >\n      {importJob && (isProcessing || isFinished) ? (\n        <LeaveImportProgressView\n          getErrorInfo={getErrorInfo}\n          importJob={importJob}\n          isFinished={isFinished}\n          isProcessing={isProcessing}\n          onClose={onClose}\n          setImportJob={setImportJob}\n          t={t}\n          wsId={wsId}\n        />\n      ) : (\n        <LeaveImportUploadView\n          downloadingTemplate={downloadingTemplate}\n          file={file}\n          handleUpload={handleUpload}\n          i18n={i18n}\n          onClose={onClose}\n          setDownloadingTemplate={setDownloadingTemplate}\n          setFile={setFile}\n          t={t}\n          uploading={uploading}\n          wsId={wsId}\n        />\n      )}\n    </Modal>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/leave/leave-import-progress-view.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/leave/leave-import-upload-view.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/leave/leave-request-row.tsx","messages":[{"ruleId":"complexity","severity":2,"message":"Function 'LeaveRequestRow' has a complexity of 26. Maximum allowed is 10.","line":22,"column":8,"nodeType":"FunctionDeclaration","messageId":"complex","endLine":22,"endColumn":32},{"ruleId":"react/no-unescaped-entities","severity":2,"message":"`\"` can be escaped with `&quot;`, `&ldquo;`, `&#34;`, `&rdquo;`.","line":53,"column":214,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&quot;"},"fix":{"range":[3782,3784],"text":" &quot;"},"desc":"Replace with `&quot;`."},{"messageId":"replaceWithAlt","data":{"alt":"&ldquo;"},"fix":{"range":[3782,3784],"text":" &ldquo;"},"desc":"Replace with `&ldquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#34;"},"fix":{"range":[3782,3784],"text":" &#34;"},"desc":"Replace with `&#34;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rdquo;"},"fix":{"range":[3782,3784],"text":" &rdquo;"},"desc":"Replace with `&rdquo;`."}]},{"ruleId":"react/no-unescaped-entities","severity":2,"message":"`\"` can be escaped with `&quot;`, `&ldquo;`, `&#34;`, `&rdquo;`.","line":53,"column":261,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&quot;"},"fix":{"range":[3830,3831],"text":"&quot;"},"desc":"Replace with `&quot;`."},{"messageId":"replaceWithAlt","data":{"alt":"&ldquo;"},"fix":{"range":[3830,3831],"text":"&ldquo;"},"desc":"Replace with `&ldquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#34;"},"fix":{"range":[3830,3831],"text":"&#34;"},"desc":"Replace with `&#34;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rdquo;"},"fix":{"range":[3830,3831],"text":"&rdquo;"},"desc":"Replace with `&rdquo;`."}]}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import type { TFunction } from \"i18next\";\n\nimport { CheckCircle2, XCircle, ShieldCheck, MessageSquare, Sun, Moon, Timer } from \"lucide-react\";\nimport React from \"react\";\n\nimport type { fetchWorkspaceLeaveRequests } from \"@/lib/api\";\nimport type { Employee, LeaveType } from \"@/lib/api/types\";\n\nimport { cn } from \"@/lib/utils\";\n\ntype LeaveRequestItem = Awaited<ReturnType<typeof fetchWorkspaceLeaveRequests>>[0];\n\nexport interface LeaveRequestRowProps {\n  emp?: Employee;\n  formatDate: (d: string) => string;\n  leaveTypes: LeaveType[];\n  onApprove: (id: string, status: string) => void;\n  request: LeaveRequestItem;\n  t: TFunction;\n}\n\nexport function LeaveRequestRow({ request, emp, leaveTypes, formatDate, t, onApprove }: LeaveRequestRowProps) {\n  return (\n    <tr className=\"hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-all group\">\n      <td className=\"px-10 py-6\">\n        <div className=\"flex items-center gap-5\">\n          <div className=\"w-14 h-14 bg-primary-50 dark:bg-primary-950 rounded-2xl flex items-center justify-center text-primary-600 dark:text-primary-400 font-bold text-xl shadow-inner border border-primary-100 dark:border-primary-800/50 uppercase group-hover:scale-110 transition-transform\">\n            {emp?.full_name[0] ?? \"?\"}\n          </div>\n          <div>\n            <div className=\"font-bold text-primary-700 dark:text-primary-300 text-sm tracking-tight uppercase leading-none mb-1.5\">{emp?.full_name ?? \"N/A\"}</div>\n            <div className=\"text-[10px] text-primary-400 font-mono font-bold uppercase tracking-widest opacity-70\">{emp?.employee_id_number}</div>\n          </div>\n        </div>\n      </td>\n      <td className=\"px-8 py-6\"><span className=\"px-3 py-1 bg-slate-100 dark:bg-slate-700 text-primary-700 dark:text-primary-300 rounded-lg text-[9px] font-bold uppercase tracking-widest border border-primary-200 dark:border-primary-800/50 shadow-sm\">{(leaveTypes.find(tOption => tOption.id === request.leave_type_id)?.name ?? \"Unknown\").toUpperCase()}</span></td>\n      <td className=\"px-8 py-6\">\n        <div className=\"text-xs font-bold text-primary-700 dark:text-primary-300 uppercase tracking-tight mb-1.5\">\n          {formatDate(request.start_date)} — {formatDate(request.end_date)}\n          {request.duration_type !== \"full_day\" ? (\n            <span className={cn(\"ml-2 px-2 py-0.5 rounded-md text-[8px] font-bold uppercase tracking-wider inline-flex items-center gap-1 border\",\n              request.duration_type === \"first_half\" ? \"bg-amber-50 dark:bg-amber-950 text-amber-600 dark:text-amber-300 border-amber-200 dark:border-amber-800\" :\n              request.duration_type === \"second_half\" ? \"bg-blue-50 dark:bg-blue-950 text-blue-600 dark:text-blue-300 border-blue-200 dark:border-blue-800\" :\n              \"bg-cyan-50 dark:bg-cyan-950 text-cyan-600 dark:text-cyan-300 border-cyan-200 dark:border-cyan-800\"\n            )}>\n              {request.duration_type === \"first_half\" ? <><Sun size={8} /> {t(\"leave_requests.duration.first_half\")}</> : null}\n              {request.duration_type === \"second_half\" ? <><Moon size={8} /> {t(\"leave_requests.duration.second_half\")}</> : null}\n              {request.duration_type === \"custom_hours\" ? <><Timer size={8} /> {request.start_time?.slice(0,5) ?? \"\"}–{request.end_time?.slice(0,5) ?? \"\"}</> : null}\n            </span>\n          ) : null}\n        </div>\n        <div className=\"bg-slate-50 dark:bg-slate-800/50 p-3 rounded-xl border border-primary-100 dark:border-primary-800/50 shadow-inner group-hover:bg-white dark:hover:bg-slate-900 transition-colors\">\n          <p className=\"text-[10px] text-primary-400 font-bold leading-relaxed line-clamp-1 italic opacity-80 flex gap-2\"><MessageSquare className=\"text-slate-300 dark:text-slate-600 mt-0.5 shrink-0\" size={12} /> \"{request.reason ?? t(\"common.no_description\")}\"</p>\n        </div>\n      </td>\n      <td className=\"px-8 py-6 text-center\">\n        <span className={cn(\"px-4 py-1.5 rounded-full text-[9px] font-bold uppercase tracking-widest border shadow-sm inline-block\", \n          request.status === \"pending\" ? \"bg-amber-50 dark:bg-amber-950 text-amber-600 dark:text-amber-300 border-amber-100 dark:border-amber-800\" : \n          request.status === \"approved\" ? \"bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-300 border-emerald-100 dark:border-emerald-800\" :\n          request.status === \"pre_approved\" ? \"bg-teal-50 dark:bg-teal-950 text-teal-600 dark:text-teal-300 border-teal-100 dark:border-teal-800\" :\n          \"bg-rose-50 dark:bg-rose-950 text-rose-600 dark:text-rose-300 border-rose-100 dark:border-rose-800\"\n        )}>\n          {request.status === \"pending\" ? t(\"common.status_pending\").toUpperCase() : request.status === \"approved\" ? t(\"common.status_approved\").toUpperCase() : request.status === \"pre_approved\" ? <span className=\"flex items-center gap-1\"><ShieldCheck size={10} />{t(\"common.status_pre_approved\").toUpperCase()}</span> : t(\"common.status_rejected\").toUpperCase()}\n        </span>\n      </td>\n      <td className=\"px-10 py-6 text-right\">\n        {request.status === \"pending\" ? (\n          <div className=\"flex justify-end gap-3 opacity-0 group-hover:opacity-100 transition-all duration-300 translate-x-2 group-hover:translate-x-0\">\n            <button className=\"p-3 bg-white dark:bg-slate-900 text-emerald-400 hover:text-emerald-600 dark:text-emerald-300 rounded-xl shadow-md border border-primary-100 dark:border-primary-800/50 transition-all active:scale-90\" onClick={() => { onApprove(request.id, \"approved\"); }} title={t(\"common.approve\")}><CheckCircle2 size={20} /></button>\n            <button className=\"p-3 bg-white dark:bg-slate-900 text-rose-400 hover:text-rose-600 dark:text-rose-300 rounded-xl shadow-md border border-primary-100 dark:border-primary-800/50 transition-all active:scale-90\" onClick={() => { onApprove(request.id, \"rejected\"); }} title={t(\"common.reject\")}><XCircle size={20} /></button>\n          </div>\n        ) : null}\n      </td>\n    </tr>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/leave/use-leave-requests.ts","messages":[{"ruleId":"@typescript-eslint/no-non-null-assertion","severity":2,"message":"Forbidden non-null assertion.","line":28,"column":164,"nodeType":"TSNonNullExpression","messageId":"noNonNull","endLine":28,"endColumn":169},{"ruleId":"@typescript-eslint/no-non-null-assertion","severity":2,"message":"Forbidden non-null assertion.","line":29,"column":112,"nodeType":"TSNonNullExpression","messageId":"noNonNull","endLine":29,"endColumn":117},{"ruleId":"@typescript-eslint/no-non-null-assertion","severity":2,"message":"Forbidden non-null assertion.","line":32,"column":79,"nodeType":"TSNonNullExpression","messageId":"noNonNull","endLine":32,"endColumn":84}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useQuery, useMutation, useQueryClient } from \"@tanstack/react-query\";\nimport { useState, useCallback, useRef, useEffect } from \"react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport type { LeaveImportJob } from \"@/lib/api/leaves\";\n\nimport { useToast } from \"@/components/ui/toast\";\nimport { useAllEmployees } from \"@/hooks/use-employees\";\nimport {\n  fetchWorkspaceLeaveRequests,\n  approveLeaveRequest,\n  fetchLeaveTypes,\n  fetchLatestLeaveImport,\n} from \"@/lib/api\";\n\ntype TabType = \"pending\" | \"approved\" | \"rejected\";\n\nexport function useLeaveRequests(wsId: string | null) {\n  const { t } = useTranslation();\n  const toast = useToast();\n  const queryClient = useQueryClient();\n  \n  const [isModalOpen, setIsModalOpen] = useState(false);\n  const [isImportModalOpen, setIsImportModalOpen] = useState(false);\n  const [activeTab, setActiveTab] = useState<TabType>(\"pending\");\n\n  const { employees } = useAllEmployees(wsId);\n  const { data: requests = [], isLoading: requestsLoading } = useQuery({ queryKey: [\"leave-requests\", wsId, activeTab], queryFn: () => fetchWorkspaceLeaveRequests(wsId!, activeTab), enabled: !!wsId });\n  const { data: leaveTypes = [] } = useQuery({ queryKey: [\"leave-types\", wsId], queryFn: () => fetchLeaveTypes(wsId!), enabled: !!wsId });\n\n  const approveMutation = useMutation({\n    mutationFn: (data: { id: string; status: string }) => approveLeaveRequest(wsId!, data.id, { status: data.status }),\n    onSuccess: () => { void queryClient.invalidateQueries({ queryKey: [\"leave-requests\"] }); toast.success(t(\"common.success\")); },\n  });\n\n  const [importJob, setImportJob] = useState<LeaveImportJob | null>(null);\n  const [importBannerDismissed, setImportBannerDismissed] = useState(false);\n  const pollingRef = useRef<ReturnType<typeof setInterval> | null>(null);\n\n  useEffect(() => {\n    if (!wsId) return;\n    void fetchLatestLeaveImport(wsId).then((job) => {\n      if (job) {\n        const created = new Date(job.created_at);\n        const now = new Date();\n        if (now.getTime() - created.getTime() < 24 * 60 * 60 * 1000) {\n          setImportJob(job);\n          setImportBannerDismissed(false);\n        }\n      }\n    }).catch(() => { /* empty */ });\n  }, [wsId]);\n\n  const startPolling = useCallback((wsIdValue: string) => {\n    if (pollingRef.current) clearInterval(pollingRef.current);\n    pollingRef.current = setInterval(() => {\n      void (async () => {\n        try {\n          const job = await fetchLatestLeaveImport(wsIdValue);\n          if (job) {\n            setImportJob(job);\n            if (job.status !== \"processing\" && job.status !== \"pending\") {\n              if (pollingRef.current) clearInterval(pollingRef.current);\n              pollingRef.current = null;\n              void queryClient.invalidateQueries({ queryKey: [\"leave-requests\"] });\n            }\n          }\n        } catch {\n          // Network error — keep polling\n        }\n      })();\n    }, 3000);\n  }, [queryClient]);\n\n  useEffect(() => {\n    if (importJob?.status === \"processing\" || importJob?.status === \"pending\") {\n      if (wsId) startPolling(wsId);\n    }\n    return () => {\n      if (pollingRef.current) clearInterval(pollingRef.current);\n    };\n  }, [importJob?.status, wsId, startPolling]);\n\n  const handleImportComplete = useCallback(() => {\n    if (wsId) {\n      void fetchLatestLeaveImport(wsId).then((job) => {\n        if (job) {\n          setImportJob(job);\n          setImportBannerDismissed(false);\n        }\n      }).catch(() => { /* empty */ });\n      void queryClient.invalidateQueries({ queryKey: [\"leave-requests\"] });\n    }\n  }, [wsId, queryClient]);\n\n  return {\n    isModalOpen, setIsModalOpen,\n    isImportModalOpen, setIsImportModalOpen,\n    activeTab, setActiveTab,\n    employees, requests, requestsLoading, leaveTypes,\n    approveMutation,\n    importJob, setImportJob,\n    importBannerDismissed, setImportBannerDismissed,\n    handleImportComplete,\n    t\n  };\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/monitor/__tests__/monitor-charts.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/monitor/job-status-distribution-chart.tsx","messages":[{"ruleId":"@typescript-eslint/no-deprecated","severity":2,"message":"`Cell` is deprecated.","line":56,"column":16,"nodeType":"JSXIdentifier","messageId":"deprecated","endLine":56,"endColumn":20}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useTranslation } from \"react-i18next\";\n\nimport { PieChart, Pie, Cell, Tooltip } from \"recharts\";\n\nimport type { JobStatusCount } from \"@/hooks/use-monitor-charts\";\n\nimport { cn } from \"@/lib/utils\";\n\ninterface Props {\n  data: JobStatusCount[];\n  isLoading: boolean;\n}\n\nexport default function JobStatusDistributionChart({ data, isLoading }: Props) {\n  const { t } = useTranslation();\n\n  return (\n    <div className=\"bg-white/70 dark:bg-slate-900/70 backdrop-blur-xl border border-slate-200/60 dark:border-slate-700/60 rounded-[2rem] p-6 shadow-lg dark:shadow-black/20 flex flex-col items-center gap-4 relative overflow-hidden group\">\n      {/* Hover glow */}\n      <div className=\"absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none\">\n        <div className=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-40 h-40 rounded-full bg-gradient-to-br from-blue-400/15 to-blue-400/10 blur-2xl\" />\n      </div>\n\n      <h5 className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em] w-full text-center\">\n        {t(\"monitor.job_distribution\")}\n      </h5>\n\n      {isLoading ? (\n        <div className=\"w-[160px] h-[160px] flex items-center justify-center\">\n          <div className=\"w-20 h-20 rounded-full border-4 border-slate-100 dark:border-slate-700 border-t-blue-400 animate-spin\" />\n        </div>\n      ) : data.length === 0 ? (\n        <div className=\"h-[160px] flex flex-col items-center justify-center gap-2\">\n          <div className=\"w-12 h-12 rounded-2xl bg-slate-50 dark:bg-slate-800/50 flex items-center justify-center\">\n            <span className=\"text-xl\">📊</span>\n          </div>\n          <p className=\"text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest\">\n            {t(\"monitor.no_data\", { defaultValue: \"No data\" })}\n          </p>\n        </div>\n      ) : (\n        <PieChart height={160} width={160}>\n          <Pie\n            cornerRadius={4}\n            cx=\"50%\"\n            cy=\"50%\"\n            data={data}\n            dataKey=\"count\"\n            innerRadius={45}\n            nameKey=\"status\"\n            outerRadius={70}\n            paddingAngle={3}\n            strokeWidth={0}\n          >\n            {data.map((entry, index) => (\n              <Cell fill={entry.color} key={index} />\n            ))}\n          </Pie>\n          <Tooltip\n            contentStyle={{\n              borderRadius: \"1rem\",\n              border: \"1px solid rgba(148,163,184,0.2)\",\n              background: \"rgba(255,255,255,0.95)\",\n              backdropFilter: \"blur(8px)\",\n              fontSize: \"12px\",\n              fontWeight: 600,\n            }}\n          />\n        </PieChart>\n      )}\n\n      {/* Percentage legend pills */}\n      <div className=\"flex flex-wrap items-center justify-center gap-2\">\n        {data.map((entry) => (\n          <span\n            className={cn(\n              \"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider\",\n              \"bg-slate-50 dark:bg-slate-800/60 text-slate-600 dark:text-slate-300 border border-slate-100 dark:border-slate-700/50\",\n              \"hover:scale-105 transition-transform duration-200 cursor-default\"\n            )}\n            data-testid={`legend-${entry.status}`}\n            key={entry.status}\n          >\n            <span\n              className=\"w-2 h-2 rounded-full flex-shrink-0\"\n              style={{ backgroundColor: entry.color }}\n            />\n            {entry.status} {entry.percent}%\n          </span>\n        ))}\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/monitor/queue-pressure-chart.tsx","messages":[{"ruleId":"@typescript-eslint/no-deprecated","severity":2,"message":"`Cell` is deprecated.","line":117,"column":18,"nodeType":"JSXIdentifier","messageId":"deprecated","endLine":117,"endColumn":22}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useTranslation } from \"react-i18next\";\n\nimport { BarChart, Bar, XAxis, YAxis, CartesianGrid, Tooltip, ResponsiveContainer, Cell } from \"recharts\";\n\nimport type { QueuePressureData, PressureLevel } from \"@/hooks/use-monitor-charts\";\n\nimport { cn } from \"@/lib/utils\";\n\ninterface Props {\n  data: QueuePressureData;\n  isLoading: boolean;\n}\n\nconst PRESSURE_CONFIG: Record<PressureLevel, { label: string; color: string; bg: string; border: string }> = {\n  low: {\n    label: \"Low\",\n    color: \"text-emerald-600 dark:text-emerald-300\",\n    bg: \"bg-emerald-50 dark:bg-emerald-950/60\",\n    border: \"border-emerald-100 dark:border-emerald-800/50\",\n  },\n  medium: {\n    label: \"Medium\",\n    color: \"text-amber-600 dark:text-amber-300\",\n    bg: \"bg-amber-50 dark:bg-amber-950/60\",\n    border: \"border-amber-100 dark:border-amber-800/50\",\n  },\n  high: {\n    label: \"High\",\n    color: \"text-orange-600 dark:text-orange-300\",\n    bg: \"bg-orange-50 dark:bg-orange-950/60\",\n    border: \"border-orange-100 dark:border-orange-800/50\",\n  },\n  critical: {\n    label: \"Critical\",\n    color: \"text-rose-600 dark:text-rose-300\",\n    bg: \"bg-rose-50 dark:bg-rose-950/60\",\n    border: \"border-rose-100 dark:border-rose-800/50\",\n  },\n};\n\nexport default function QueuePressureChart({ data, isLoading }: Props) {\n  const { t } = useTranslation();\n  const pressure = PRESSURE_CONFIG[data.pressureLevel];\n\n  const chartData = [\n    { name: t(\"monitor.pending_high\"), value: data.high, fill: \"#f97316\" },\n    { name: t(\"monitor.pending_low\"), value: data.low, fill: \"#fbbf24\" },\n  ];\n\n  return (\n    <div className=\"bg-white/70 dark:bg-slate-900/70 backdrop-blur-xl border border-slate-200/60 dark:border-slate-700/60 rounded-[2rem] p-6 shadow-lg dark:shadow-black/20 flex flex-col gap-4 relative overflow-hidden group\">\n      {/* Hover glow */}\n      <div className=\"absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none\">\n        <div className=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-40 h-40 rounded-full bg-gradient-to-br from-orange-400/15 to-amber-400/10 blur-2xl\" />\n      </div>\n\n      <div className=\"flex items-center justify-between\">\n        <h5 className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em]\">\n          {t(\"monitor.queue_pressure\")}\n        </h5>\n        {/* Pressure level badge */}\n        <span\n          className={cn(\n            \"inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider border\",\n            pressure.color,\n            pressure.bg,\n            pressure.border\n          )}\n          data-testid=\"pressure-badge\"\n        >\n          {pressure.label}\n        </span>\n      </div>\n\n      {isLoading ? (\n        <div className=\"h-[160px] flex items-center justify-center\">\n          <div className=\"w-20 h-20 rounded-full border-4 border-slate-100 dark:border-slate-700 border-t-orange-400 animate-spin\" />\n        </div>\n      ) : data.total === 0 ? (\n        <div className=\"h-[160px] flex flex-col items-center justify-center gap-2\">\n          <div className=\"w-12 h-12 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 flex items-center justify-center\">\n            <span className=\"text-xl\">✓</span>\n          </div>\n          <p className=\"text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest\">\n            {t(\"monitor.queue_empty\", { defaultValue: \"Queue clear\" })}\n          </p>\n        </div>\n      ) : (\n        <ResponsiveContainer height={160} width=\"100%\">\n          <BarChart barCategoryGap=\"30%\" data={chartData} layout=\"vertical\">\n            <CartesianGrid\n              horizontal={false}\n              stroke=\"rgba(148,163,184,0.15)\"\n              strokeDasharray=\"3 3\"\n            />\n            <XAxis hide type=\"number\" />\n            <YAxis\n              axisLine={false}\n              dataKey=\"name\"\n              tick={{ fontSize: 10, fontWeight: 700, fill: \"#94a3b8\" }}\n              tickLine={false}\n              type=\"category\"\n              width={80}\n            />\n            <Tooltip\n              contentStyle={{\n                borderRadius: \"1rem\",\n                border: \"1px solid rgba(148,163,184,0.2)\",\n                background: \"rgba(255,255,255,0.95)\",\n                backdropFilter: \"blur(8px)\",\n                fontSize: \"12px\",\n                fontWeight: 600,\n              }}\n            />\n            <Bar barSize={20} dataKey=\"value\" radius={[0, 8, 8, 0]}>\n              {chartData.map((entry, index) => (\n                <Cell fill={entry.fill} key={index} />\n              ))}\n            </Bar>\n          </BarChart>\n        </ResponsiveContainer>\n      )}\n\n      {/* Total count */}\n      <div className=\"text-center\">\n        <span className=\"text-2xl font-black text-slate-700 dark:text-slate-200 tracking-tighter tabular-nums\">\n          {data.total}\n        </span>\n        <span className=\"text-[9px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest ml-1.5\">\n          {t(\"monitor.total_pending\", { defaultValue: \"total\" })}\n        </span>\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/monitor/worker-utilization-gauge.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/reports/__tests__/daily-rep