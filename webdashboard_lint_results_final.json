pace.\n *\n * Usage:\n *   const { hasPermission, permissions, roles, isLoading } = useMyPermissions();\n *   if (hasPermission(\"employees:create\")) { ... }\n */\nexport function useMyPermissions() {\n    const wsId = getCurrentWorkspaceId() ?? \"\";\n\n    const query = useQuery({\n        queryKey: myPermissionsKey(wsId),\n        queryFn: fetchMyPermissions,\n        enabled: !!wsId,\n        staleTime: 5 * 60 * 1000, // cache for 5 minutes — permissions don't change often\n        gcTime: 10 * 60 * 1000,\n    });\n\n    const permissionSet = new Set(query.data?.permissions ?? []);\n\n    const hasPermission = useCallback(\n        (permission: string): boolean => permissionSet.has(permission),\n        // eslint-disable-next-line react-hooks/exhaustive-deps\n        [query.data?.permissions],\n    );\n\n    const hasAnyPermission = useCallback(\n        (...permissions: string[]): boolean =>\n            permissions.some((p) => permissionSet.has(p)),\n        // eslint-disable-next-line react-hooks/exhaustive-deps\n        [query.data?.permissions],\n    );\n\n    const hasRole = useCallback(\n        (role: string): boolean =>\n            (query.data?.roles ?? []).some(\n                (r: string) => r.toLowerCase() === role.toLowerCase(),\n            ),\n        [query.data?.roles],\n    );\n\n    const hasScopedPermission = useCallback(\n        (permission: string, targetDepartmentId?: string): boolean => {\n            if (!permissionSet.has(permission)) return false;\n\n            const allowedDepts = query.data?.managed_department_ids;\n\n            // null or undefined means global scope\n            if (allowedDepts === null || allowedDepts === undefined) {\n                return true;\n            }\n\n            // Must match one of the allowed departments\n            if (targetDepartmentId && Array.isArray(allowedDepts)) {\n                return allowedDepts.includes(targetDepartmentId);\n            }\n\n            return false;\n        },\n        // eslint-disable-next-line react-hooks/exhaustive-deps\n        [query.data?.permissions, query.data?.managed_department_ids],\n    );\n\n    return {\n        permissions: query.data?.permissions ?? [],\n        roles: query.data?.roles ?? [],\n        managedDepartmentIds: query.data?.managed_department_ids ?? null,\n        isLoading: query.isLoading,\n        hasPermission,\n        hasAnyPermission,\n        hasRole,\n        hasScopedPermission,\n    };\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/hooks/use-profile.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/hooks/use-report-stream.ts","messages":[{"ruleId":"max-lines-per-function","severity":1,"message":"Function 'useReportStream' has too many lines (152). Maximum allowed is 100.","line":89,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":264,"endColumn":2},{"ruleId":"@typescript-eslint/no-empty-function","severity":2,"message":"Unexpected empty arrow function.","line":156,"column":47,"nodeType":"ArrowFunctionExpression","messageId":"unexpected","endLine":156,"endColumn":49,"suggestions":[{"messageId":"suggestComment","data":{"name":"arrow function"},"fix":{"range":[4593,4593],"text":" /* empty */ "},"desc":"Add comment inside empty arrow function."}]},{"ruleId":"complexity","severity":2,"message":"Arrow function has a complexity of 11. Maximum allowed is 10.","line":179,"column":32,"nodeType":"ArrowFunctionExpression","messageId":"complex","endLine":179,"endColumn":34},{"ruleId":"unused-imports/no-unused-vars","severity":2,"message":"'err' is defined but never used.","line":199,"column":14,"nodeType":"Identifier","messageId":"unusedVar","endLine":199,"endColumn":17},{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/workspace/webdashboard/src/hooks/use-report-stream.ts:241:5\n  239 |     if (!jobId) return;\n  240 |\n> 241 |     connect();\n      |     ^^^^^^^ Avoid calling setState() directly within an effect\n  242 |\n  243 |     // Cleanup on unmount or jobId change\n  244 |     return () => {","line":241,"column":5,"nodeType":null,"endLine":241,"endColumn":12}],"suppressedMessages":[],"errorCount":4,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\"use client\";\n\nimport { useEffect, useRef, useState, useCallback } from \"react\";\n\nimport type {\n  StreamMessage,\n  StreamStatus,\n} from \"@/types/report-stream\";\n\nimport { API_BASE_URL } from \"@/lib/api/config\";\nimport {\n  getAccessToken,\n  getRefreshToken,\n  setAccessToken,\n  setRefreshToken,\n  clearAuthSession,\n} from \"@/lib/api/helpers\";\nimport { ROUTES } from \"@/lib/routes\";\n\ninterface UseReportStreamOptions {\n  jobId: string | null;\n  maxRetries?: number;\n  onComplete?: (data: unknown[]) => void;\n  onError?: (message: string) => void;\n}\n\nexport interface UseReportStreamResult {\n  chunks: unknown[];\n  error: string | null;\n  progress: number; // 0-100\n  reconnect: () => void;\n  status: StreamStatus;\n}\n\n/**\n * Build WebSocket URL for report streaming\n * Uses wss: for HTTPS, ws: for HTTP\n * Includes JWT token as query param (required by ws_auth_middleware)\n */\nfunction buildWebSocketUrl(jobId: string): string {\n  const protocol = window.location.protocol === \"https:\" ? \"wss:\" : \"ws:\";\n  const host = window.location.host;\n  const token = getAccessToken();\n  const params = token ? `?token=${encodeURIComponent(token)}` : \"\";\n  return `${protocol}//${host}/api/ws/reports/${jobId}${params}`;\n}\n\n/**\n * Calculate exponential backoff delay\n * Returns delays: 1s, 2s, 4s for retries 0, 1, 2\n */\nfunction getBackoffDelay(retryCount: number): number {\n  return Math.pow(2, retryCount) * 1000;\n}\n\n/**\n * Attempt to refresh JWT token (same logic as apiFetch 401 handler)\n * Returns true if refresh succeeded, false otherwise\n */\nasync function tryRefreshToken(): Promise<boolean> {\n  const refreshToken = getRefreshToken();\n  if (!refreshToken) return false;\n\n  try {\n    const response = await fetch(`${API_BASE_URL}/auth/refresh`, {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ refresh_token: refreshToken }),\n    });\n\n    if (response.ok) {\n      const data = await response.json() as { access_token: string; refresh_token: string };\n      setAccessToken(data.access_token);\n      setRefreshToken(data.refresh_token);\n      \n      return true;\n    }\n  } catch (e) {\n    console.error(\"[ReportStream] Token refresh failed\", e);\n  }\n\n  return false;\n}\n\n/**\n * Hook for WebSocket-based report streaming\n * Connects to the report WebSocket endpoint and accumulates chunks\n */\nexport function useReportStream({\n  jobId,\n  onComplete,\n  onError,\n  maxRetries = 3,\n}: UseReportStreamOptions): UseReportStreamResult {\n  const [status, setStatus] = useState<StreamStatus>(\"idle\");\n  const [progress, setProgress] = useState(0);\n  const [error, setError] = useState<string | null>(null);\n  // Expose chunks via state for consumers that need reactivity\n  const [chunks, setChunks] = useState<unknown[]>([]);\n\n  // Use refs to avoid re-renders on each chunk and prevent stale closures\n  const socketRef = useRef<WebSocket | null>(null);\n  const pingIntervalRef = useRef<NodeJS.Timeout | null>(null);\n  const chunksRef = useRef<unknown[]>([]);\n  const retryCountRef = useRef(0);\n  const shouldReconnectRef = useRef(true);\n  const totalBatchesRef = useRef(0);\n  const statusRef = useRef<StreamStatus>(\"idle\");\n\n  const onCompleteRef = useRef(onComplete);\n  const onErrorRef = useRef(onError);\n  \n  useEffect(() => {\n    onCompleteRef.current = onComplete;\n    onErrorRef.current = onError;\n    statusRef.current = status;\n  });\n\n  const handleMessage = useCallback((event: MessageEvent) => {\n    try {\n      const message = JSON.parse(event.data as string) as StreamMessage;\n      switch (message.type) {\n        case \"CHUNK\": {\n          totalBatchesRef.current = message.total_batches;\n          const newProgress = ((message.batch_index + 1) / message.total_batches) * 100;\n          setProgress(Math.min(newProgress, 100));\n          setStatus(\"streaming\");\n          break;\n        }\n        case \"DONE\": {\n          setStatus(\"completed\");\n          setProgress(100);\n          shouldReconnectRef.current = false;\n          const finalChunks = [...chunksRef.current];\n          chunksRef.current = [];\n          setChunks(finalChunks);\n          onCompleteRef.current?.(finalChunks);\n          break;\n        }\n        case \"ERROR\": {\n          setStatus(\"error\");\n          setError(message.message);\n          shouldReconnectRef.current = false;\n          onErrorRef.current?.(message.message);\n          break;\n        }\n      }\n    } catch (error_) {\n      console.error(\"[ReportStream] Failed to parse message:\", error_);\n    }\n  }, []);\n\n  /**\n   * Connect to WebSocket\n   */\n  const connectRef = useRef<() => void>(() => {});\n\n  const connect = useCallback(() => {\n    if (!jobId) return;\n    if (socketRef.current) { socketRef.current.close(); socketRef.current = null; }\n    const url = buildWebSocketUrl(jobId);\n    setStatus(\"connecting\");\n    setError(null);\n    try {\n      const socket = new WebSocket(url);\n      socketRef.current = socket;\n      const connectionTimeoutId = setTimeout(() => {\n        if (socket.readyState === WebSocket.CONNECTING) socket.close();\n      }, 3000);\n      socket.onopen = () => {\n        clearTimeout(connectionTimeoutId);\n        setStatus(\"streaming\");\n        retryCountRef.current = 0;\n        pingIntervalRef.current = setInterval(() => {\n          if (socket.readyState === WebSocket.OPEN) socket.send(JSON.stringify({ type: \"ping\" }));\n        }, 30000);\n      };\n      socket.onmessage = handleMessage;\n      socket.onclose = (event) => {\n        clearTimeout(connectionTimeoutId);\n        if (event.code === 1006 && retryCountRef.current === 0 && statusRef.current === \"connecting\") {\n          retryCountRef.current++;\n          void tryRefreshToken().then((ref) => {\n            if (ref && shouldReconnectRef.current) connectRef.current();\n            else { clearAuthSession(); if (window.location.pathname !== ROUTES.LOGIN) window.location.href = ROUTES.LOGIN; }\n          });\n          return;\n        }\n        if (shouldReconnectRef.current && retryCountRef.current < maxRetries && statusRef.current !== \"completed\" && statusRef.current !== \"error\") {\n          const delay = getBackoffDelay(retryCountRef.current);\n          retryCountRef.current++;\n          setTimeout(() => { if (shouldReconnectRef.current) connectRef.current(); }, delay);\n        } else if (retryCountRef.current >= maxRetries && statusRef.current !== \"completed\") {\n          setStatus(\"error\");\n          setError(\"Connection lost. Max retries exceeded.\");\n          onErrorRef.current?.(\"Connection lost. Max retries exceeded.\");\n        }\n      };\n    } catch (err) { setStatus(\"error\"); set