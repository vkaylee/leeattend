Props {\n  children: React.ReactNode;\n  className?: string;\n  contentClassName?: string;\n  headerExtra?: React.ReactNode;\n  /** If true, the built-in header (icon + title + X button) is hidden — use when providing a fully custom header in children */\n  hideHeader?: boolean;\n  isOpen: boolean;\n  onClose: () => void;\n  side?: \"left\" | \"right\";\n  subtitle?: string;\n  title?: string;\n}\n\nfunction useSheetState(isOpen: boolean, onClose: () => void) {\n  const [isVisible, setIsVisible] = useState(false);\n\n  useEffect(() => {\n    if (isOpen) {\n      // eslint-disable-next-line react-hooks/set-state-in-effect -- Derived state synced from props; intentional pattern\n      setIsVisible(true);\n      document.body.style.overflow = \"hidden\";\n\n      const handleKeyDown = (e: KeyboardEvent) => {\n        if (e.key === \"Escape\") onClose();\n      };\n\n      window.addEventListener(\"keydown\", handleKeyDown);\n      return () => { window.removeEventListener(\"keydown\", handleKeyDown); };\n    } \n\n    const timer = setTimeout(() => { setIsVisible(false); }, 500); // Sync with duration-500\n    document.body.style.overflow = \"unset\";\n    return () => { clearTimeout(timer); };\n  }, [isOpen, onClose]);\n\n  return isVisible;\n}\n\nfunction SheetHeader({\n  title,\n  subtitle,\n  headerExtra,\n  onClose\n}: {\n  headerExtra?: React.ReactNode;\n  onClose: () => void;\n  subtitle?: string;\n  title?: string;\n}) {\n  return (\n    <div className=\"flex items-center justify-between p-10 border-b border-slate-50 dark:border-slate-800 bg-slate-50/30 dark:bg-slate-800/30\">\n      <div className=\"flex items-center gap-4\">\n        <div className=\"w-12 h-12 rounded-2xl bg-primary-50 dark:bg-primary-950 flex items-center justify-center text-primary-600 dark:text-primary-400 shadow-inner border border-primary-100/50 dark:border-primary-800/50\">\n          <Menu size={24} />\n        </div>\n        <div>\n          {!!title && (\n            <h2 className=\"text-xl font-bold text-slate-700 dark:text-slate-200 tracking-tight uppercase\">\n              {title}\n            </h2>\n          )}\n          {!!subtitle && (\n            <p className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest mt-1 opacity-70\">\n              {subtitle}\n            </p>\n          )}\n        </div>\n      </div>\n      {!!headerExtra && (\n        <div className=\"flex items-center gap-2\">\n          {headerExtra}\n        </div>\n      )}\n      <button\n        className=\"p-3 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 rounded-xl transition-all shadow-md border border-slate-100 dark:border-slate-700 text-slate-500 dark:text-slate-400 hover:text-rose-600 dark:hover:text-rose-400 active:scale-90\"\n        onClick={onClose}\n      >\n        <X className=\"w-5 h-5\" />\n      </button>\n    </div>\n  );\n}\n\nexport default function Sheet({\n  isOpen,\n  onClose,\n  title,\n  subtitle,\n  children,\n  side = \"right\",\n  className,\n  contentClassName,\n  headerExtra,\n  hideHeader = false,\n}: SheetProps) {\n  const isVisible = useSheetState(isOpen, onClose);\n\n  if (!isVisible && !isOpen) return null;\n\n  return createPortal(\n    <div className=\"fixed inset-0 z-[1000] flex overflow-hidden\">\n      {/* Backdrop */}\n      {/* eslint-disable-next-line jsx-a11y/no-static-element-interactions, jsx-a11y/click-events-have-key-events -- Custom interactive element (click-away/backdrop/dropzone); keyboard interaction not applicable */}\n      <div\n        className={cn(\n          \"fixed inset-0 bg-slate-900/20 backdrop-blur-lg transition-opacity duration-500\",\n          isOpen ? \"opacity-100\" : \"opacity-0\"\n        )}\n        onClick={onClose}\n      />\n\n      {/* Panel */}\n      <div className={cn(\n        \"absolute inset-y-0 flex max-w-full pointer-events-none\",\n        side === \"right\" ? \"right-0\" : \"left-0\"\n \n \n      )}>\n        {/* eslint-disable-next-line jsx-a11y/click-events-have-key-events, jsx-a11y/no-static-element-interactions -- Custom interactive element (click-away/backdrop/dropzone); keyboard interaction not applicable */}\n        <div\n          className={cn(\n            \"pointer-events-auto w-screen max-w-md transform transition duration-500 ease-in-out bg-white dark:bg-slate-900 shadow-premium-2xl flex flex-col h-full\",\n            side === \"right\"\n              ? (isOpen ? \"translate-x-0 rounded-l-[3rem]\" : \"translate-x-full rounded-l-[3rem]\")\n              : (isOpen ? \"translate-x-0 rounded-r-[3rem]\" : \"-translate-x-full rounded-r-[3rem]\"),\n            className\n          )}\n          data-testid=\"sheet-panel\"\n          onClick={(e) => { e.stopPropagation(); }}\n        >\n          {/* Header */}\n          {!hideHeader && <SheetHeader headerExtra={headerExtra} onClose={onClose} subtitle={subtitle} title={title} />}\n\n          {/* Content */}\n          <div className={cn(\"flex-1 overflow-y-auto p-10 relative scroll-smooth\", contentClassName)}>\n            <div className=\"animate-in fade-in slide-in-from-bottom-4 duration-700 h-full\">\n              {children}\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>,\n    document.body\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/ui/stat-card.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/ui/status-badge.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/ui/status-badge.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarnin