ly within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/workspace/webdashboard/src/pages/profile-page.tsx:45:7\n  43 |     if (user) {\n  44 |       // eslint-disable-next-line react-hooks/set-state-in-effect -- Derived state synced from props; intentional pattern\n> 45 |       setFormData({\n     |       ^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  46 |         full_name: user.full_name ?? \"\", avatar_url: user.avatar_url ?? \"\",\n  47 |         bio: user.bio ?? \"\", preferred_language: user.preferred_language ?? \"\",\n  48 |       });","line":45,"column":7,"nodeType":null,"endLine":45,"endColumn":18,"suppressions":[{"kind":"directive","justification":"Derived state synced from props; intentional pattern"}]}],"errorCount":3,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useNavigate } from \"@tanstack/react-router\";\nimport {\n  User as UserIcon,\n  Mail,\n  UserCircle,\n  Save,\n  Lock,\n  ShieldCheck,\n  Palette,\n  Undo2,\n  Globe,\n} from \"lucide-react\";\nimport { useState, useEffect } from \"react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport Button from \"@/components/ui/button\";\nimport { Combobox } from \"@/components/ui/combobox\";\nimport { LABEL_BASE } from \"@/components/ui/form-field\";\nimport { useDateTimeFormatter } from \"@/hooks/use-datetime\";\nimport { useProfile } from \"@/hooks/use-profile\";\nimport { useTheme } from \"@/hooks/use-theme\";\nimport { changePassword, clearAuthSession } from \"@/lib/api\";\nimport { ROUTES } from \"@/lib/routes\";\nimport { cn } from \"@/lib/utils\";\n\nimport { useToast } from \"../components/ui/toast\";\n\ntype TabType = \"profile\" | \"personalization\" | \"security\";\n\nexport default function ProfilePage() {\n  const { t } = useTranslation();\n  const { user, isLoading, updateProfile, isUpdating } = useProfile();\n  const { formatDate } = useDateTimeFormatter();\n  const { primaryColor, isOverridden, setUserTheme } = useTheme();\n  const toast = useToast();\n  const [activeTab, setActiveTab] = useState<TabType>(\"profile\");\n\n  const [formData, setFormData] = useState({\n    full_name: \"\", avatar_url: \"\", bio: \"\", preferred_language: \"\",\n  });\n\n  useEffect(() => {\n    if (user) {\n      // eslint-disable-next-line react-hooks/set-state-in-effect -- Derived state synced from props; intentional pattern\n      setFormData({\n        full_name: user.full_name ?? \"\", avatar_url: user.avatar_url ?? \"\",\n        bio: user.bio ?? \"\", preferred_language: user.preferred_language ?? \"\",\n      });\n    }\n  }, [user]);\n\n  async function handleSubmit(e: React.SyntheticEvent) {\n    e.preventDefault();\n    try {\n      await updateProfile(formData);\n      toast.success(t(\"common.success\"));\n    } catch (e) { console.error(e); }\n  }\n\n  if (isLoading) return <div className=\"p-20 text-center\"><div className=\"w-10 h-10 border-4 border-primary-600 border-t-transparent rounded-full animate-spin mx-auto\"></div></div>;\n\n  return (\n    <div className=\"space-y-10 animate-in fade-in duration-700 pb-20\">\n      <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-8 px-2\">\n        <div className=\"space-y-1\">\n          <h1 className=\"text-4xl font-bold tracking-tighter text-slate-700 dark:text-slate-200 uppercase leading-none\">{t(\"common.profile\")}</h1>\n          <p className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em] opacity-60\">{t(\"profile.subtitle\")}</p>\n        </div>\n\n        <div className=\"flex bg-slate-100 dark:bg-slate-700/50 p-1.5 rounded-[22px] w-fit border border-slate-200 dark:border-slate-700/50 shadow-inner\">\n          <button className={cn(\"flex items-center gap-2 px-8 py-2.5 rounded-[18px] text-xs font-bold uppercase tracking-widest transition-all\", activeTab === 'profile' ? \"bg-white dark:bg-slate-900 text-primary-600 dark:text-primary-400 shadow-sm border border-slate-100 dark:border-slate-800\" : \"text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 dark:text-slate-700\")} onClick={() => { setActiveTab(\"profile\"); }}><UserCircle size={14} /> {t(\"common.profile\")}</button>\n          <button className={cn(\"flex items-center gap-2 px-8 py-2.5 rounded-[18px] text-xs font-bold uppercase tracking-widest transition-all\", activeTab === 'personalization' ? \"bg-white dark:bg-slate-900 text-primary-600 dark:text-primary-400 shadow-sm border border-slate-100 dark:border-slate-800\" : \"text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 dark:text-slate-700\")} onClick={() => { setActiveTab(\"personalization\"); }}><Palette size={14} /> {t(\"profile.personalization.title\")}</button>\n          <button className={cn(\"flex items-center gap-2 px-8 py-2.5 rounded-[18px] text-xs font-bold uppercase tracking-widest transition-all\", activeTab === 'security' ? \"bg-white dark:bg-slate-900 text-primary-600 dark:text-primary-400 shadow-sm border border-slate-100 dark:border-slate-800\" : \"text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 dark:text-slate-700\")} onClick={() => { setActiveTab(\"security\"); }}><ShieldCheck size={14} /> {t(\"profile.security.title\")}</button>\n        </div>\n      </div>\n\n      <div className=\"animate-in slide-in-from-bottom-8 duration-700\">\n        {activeTab === \"profile\" ? (\n          <div className=\"max-w-5xl bg-white dark:bg-slate-900 rounded-[3rem] border border-slate-100 dark:border-slate-800 shadow-sm overflow-hidden group/hero\">\n            <div className=\"h-40 bg-slate-900 relative overflow-hidden\">\n               <div className=\"absolute inset-0 bg-gradient-to-br from-primary-600/40 via-blue-600/20 to-transparent\" />\n               <div className=\"absolute top-0