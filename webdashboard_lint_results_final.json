onth}\n          setIsAdding={setIsAdding}\n          setNewDays={setNewDays}\n          setNewEffectiveDate={setNewEffectiveDate}\n          setNewHours={setNewHours}\n          setNewMaxOtDay={setNewMaxOtDay}\n          setNewMaxOtMonth={setNewMaxOtMonth}\n          t={t}\n        />\n      )"}}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":1,"fixableWarningCount":0,"source":"import { Plus, Calendar, History, Save, Calculator, AlertCircle, CheckCircle2 } from \"lucide-react\";\nimport React, { useState } from \"react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { useDateTimeFormatter } from \"@/hooks/use-datetime\";\nimport { ConfigRecord } from \"@/lib/api/types\";\nimport { cn } from \"@/lib/utils\";\n\n\ninterface Props {\n  isLoading?: boolean;\n  onSave: (data: { std_working_days: number; hours_per_day: number; max_ot_hours_per_day: number | null; max_ot_hours_per_month: number | null; effective_date: string }) => Promise<void>;\n  records: ConfigRecord[];\n  title: string;\n}\n\nimport type { TFunction } from \"i18next\";\n\ninterface TemporalConfigAddFormProps {\n  handleSave: () => Promise<void>;\n  newDays: number;\n  newEffectiveDate: string;\n  newHours: number;\n  newMaxOtDay: string;\n  newMaxOtMonth: string;\n  setIsAdding: (val: boolean) => void;\n  setNewDays: (val: number) => void;\n  setNewEffectiveDate: (val: string) => void;\n  setNewHours: (val: number) => void;\n  setNewMaxOtDay: (val: string) => void;\n  setNewMaxOtMonth: (val: string) => void;\n  t: TFunction;\n}\n\nfunction TemporalConfigAddForm({\n  newEffectiveDate,\n  setNewEffectiveDate,\n  newDays,\n  setNewDays,\n  newHours,\n  setNewHours,\n  newMaxOtDay,\n  setNewMaxOtDay,\n  newMaxOtMonth,\n  setNewMaxOtMonth,\n  setIsAdding,\n  handleSave,\n  t\n}: TemporalConfigAddFormProps) {\n  return (\n    <div className=\"bg-white dark:bg-slate-900 border-2 border-primary-100 dark:border-primary-800 rounded-[2.5rem] p-8 shadow-xl shadow-primary-50/50 animate-in slide-in-from-top-4 duration-500\">\n      <div className=\"flex items-center gap-3 mb-8 text-primary-700 dark:text-primary-300\">\n        <div className=\"w-8 h-8 rounded-xl bg-primary-50 dark:bg-primary-950 flex items-center justify-center shadow-inner\"><Plus size={16} /></div>\n        <h4 className=\"text-[10px] font-bold uppercase tracking-[0.2em]\">{t(\"payroll.settings.add_version\")}</h4>\n      </div>\n\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-8 mb-8\">\n        <div className=\"space-y-3\">\n          <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">{t(\"payroll.settings.effective_date\")}</label>\n          <input className=\"w-full bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl px-5 py-4 text-sm font-bold focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all\" onChange={e => { setNewEffectiveDate(e.target.value); }} type=\"date\" value={newEffectiveDate} />\n        </div>\n        <div className=\"space-y-3\">\n          <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">{t(\"payroll.settings.std_days\")}</label>\n          <input className=\"w-full bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl px-5 py-4 text-sm font-bold focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-mono\" onChange={e => { setNewDays(parseFloat(e.target.value)); }} type=\"number\" value={newDays} />\n        </div>\n        <div className=\"space-y-3\">\n          <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">{t(\"payroll.settings.hours_per_day\")}</label>\n          <input className=\"w-full bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl px-5 py-4 text-sm font-bold focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-mono\" onChange={e => { setNewHours(parseFloat(e.target.value)); }} type=\"number\" value={newHours} />\n        </div>\n      </div>\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8 mb-8\">\n        <div className=\"space-y-3\">\n          <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">{t(\"payroll.settings.max_ot_hours_per_day\")}</label>\n          <input className=\"w-full bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl px-5 py-4 text-sm font-bold focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-mono\" onChange={e => { setNewMaxOtDay(e.target.value); }} placeholder={t(\"payroll.settings.no_limit\") || \"\"} step=\"0.5\" type=\"number\" value={newMaxOtDay} />\n          <p className=\"text-[9px] text-slate-400 ml-1\">{t(\"payroll.settings.ot_empty_hint\")}</p>\n        </div>\n        <div className=\"space-y-3\">\n          <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">{t(\"payroll.settings.max_ot_hours_per_month\")}</label>\n          <input className=\"w-full bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl px-5 py-4 text-sm font-bold focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-mono\" onChange={e => { setNewMaxOtMonth(e.target.value); }} placeholder={t(\"payroll.settings.no_limit\") || \"\"} step=\"0.5\" type=\"number\" value={newMaxOtMonth} />\n          <p className=\"text-[9px] text-slate-400 ml-1\">{t(\"payroll.settings.ot_empty_hint\")}</p>\n        </div>\n      </div>\n\n      <div className=\"p-6 bg-amber-50 dark:bg-amber-950/50 border border-amber-100 dark:border-amber-800 rounded-[1.5rem] flex gap-4 mb-8 shadow-inner\">\n        <AlertCircle className=\"w-6 h-6 text-amber-500 shrink-0\" />\n        <p className=\"text-[10px] text-amber-800 leading-relaxed font-bold uppercase tracking-tight opacity-80\">{t(\"payroll.settings.date_warning\")}</p>\n      </div>\n\n      <div className=\"flex justify-end gap-4\">\n        <button className=\"px-8 py-4 rounded-2xl font-bold text-[10px] uppercase tracking-widest text-slate-500 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-all\" onClick={() => { setIsAdding(false); }}>{t(\"common.cancel\")}</button>\n        <button className=\"flex items-center gap-3 bg-primary-600 text-white px-10 py-4 rounded-2xl font-bold text-[10px] uppercase tracking-widest hover:bg-primary-700 transition-all shadow-xl shadow-primary-100 dark:shadow-black/30 active:scale-95\" onClick={handleSave}><Save size={16} /> {t(\"common.save\").toUpperCase()}</button>\n      </div>\n    </div>\n  );\n}\n\ninterface TemporalConfigTableContentProps {\n  activeIndex: number;\n  formatDate: (date: string) => string;\n  now: Date;\n  sortedRecords: ConfigRecord[];\n  t: TFunction;\n}\n\nfunction TemporalConfigTableContent({ sortedRecords, activeIndex, now, t, formatDate }: TemporalConfigTableContentProps) {\n  return (\n    <table className=\"w-full text-left border-collapse\">\n      <thead>\n        <tr className=\"bg-slate-50 dark:bg-slate-800/50 border-b border-slate-100 dark:border-slate-800\">\n          <th className=\"px-8 py-5 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">{t(\"payroll.settings.status\")}</th>\n          <th className=\"px-8 py-5 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">{t(\"payroll.settings.effective_date\")}</th>\n          <th className=\"px-8 py-5 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest text-right\">{t(\"payroll.settings.std_days\")}</th>\n          <th className=\"px-8 py-5 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest text-right\">{t(\"payroll.settings.hours_per_day\")}</th>\n          <th className=\"px-8 py-5 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest text-right\">{t(\"payroll.settings.max_ot_day_short\")}</th>\n          <th className=\"px-8 py-5 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest text-right\">{t(\"payroll.settings.max_ot_month_short\")}</th>\n        </tr>\n      </thead>\n      <tbody className=\"divide-y divide-slate-50 dark:divide-slate-800\">\n        {sortedRecords.map((record, index: number) => (\n          <TemporalConfigRow\n            activeIndex={activeIndex}\n            formatDate={formatDate}\n            index={index}\n            key={index}\n            now={now}\n            record={record}\n            t={t}\n          />\n        ))}\n      </tbody>\n    </table>\n  );\n}\n\nfunction TemporalConfigRow({\n  record,\n  index,\n  activeIndex,\n  now,\n  t,\n  formatDate,\n}: {\n  activeIndex: number;\n  formatDate: (date: string) => string;\n  index: number;\n  now: Date;\n  record: ConfigRecord;\n  t: TFunction;\n}) {\n  const isActive = index === activeIndex;\n  const isFuture = new Date(record.effective_date) > now;\n\n  return (\n    <tr className={cn(\"group transition-all hover:bg-slate-50 dark:hover:bg-slate-800/50\", isActive && \"bg-emerald-50 dark:bg-emerald-950/30\")}>\n      <td className=\"px-8 py-6\">\n        {record.is_virtual ? (\n          <span className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[9px] font-bold uppercase tracking-widest border bg-amber-50 dark:bg-amber-950 text-amber-600 dark:text-amber-300 border-amber-100 dark:border-amber-800 shadow-sm\"><AlertCircle size={12} /> {t(\"payroll.settings.virtual\")}</span>\n        ) : isActive ? (\n          <span className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[9px] font-bold uppercase tracking-widest border bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-300 border-emerald-100 dark:border-emerald-800 shadow-sm\"><CheckCircle2 size={12} /> {t(\"common.active\")}</span>\n        ) : isFuture ? (\n          <span className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[9px] font-bold uppercase tracking-widest border bg-blue-50 dark:bg-blue-950 text-blue-600 dark:text-blue-300 border-blue-100 dark:border-blue-800 shadow-sm\"><Calendar size={12} /> {t(\"common.upcoming\")}</span>\n        ) : (\n          <span className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[9px] font-bold uppercase tracking-widest border bg-slate-50 dark:bg-slate-800 text-slate-500 dark:text-slate-400 border-slate-100 dark:border-slate-800 opacity-60\"><History size={12} /> {t(\"common.expired\")}</span>\n        )}\n      </td>\n      <td className=\"px-8 py-6\"><div className={cn(\"text-sm font-bold uppercase tracking-tight\", isActive ? \"text-slate-700 dark:text-slate-200\" : \"text-slate-500 dark:text-slate-400\")}>{record.is_virtual ? t(\"common.from_start\") : formatDate(record.effective_date)}</div></td>\n      <td className=\"px-8 py-6 text-right font-mono font-bold\"><span className={cn(\"text-sm\", isActive ? \"text-primary-600 dark:text-primary-400\" : \"text-slate-500 dark:text-slate-400\")}>{record.std_working_days} {t(\"common.days_short\")}</span></td>\n      <td className=\"px-8 py-6 text-right font-mono font-bold\"><span className={cn(\"text-sm\", isActive ? \"text-slate-700 dark:text-slate-200\" : \"text-slate-300 dark:text-slate-600\")}>{record.hours_per_day}h / {t(\"common.day_short\")}</span></td>\n      <td className=\"px-8 py-6 text-right font-mono font-bold\"><span className={cn(\"text-sm\", isActive ? \"text-amber-600 dark:text-amber-400\" : \"text-slate-300 dark:text-slate-600\")}>{record.max_ot_hours_per_day != null ? `${record.max_ot_hours_per_day}h` : '∞'}</span></td>\n      <td className=\"px-8 py-6 text-right font-mono font-bold\"><span className={cn(\"text-sm\", isActive ? \"text-amber-600 dark:text-amber-400\" : \"text-slate-300 dark:text-slate-600\")}>{record.max_ot_hours_per_month != null ? `${record.max_ot_hours_per_month}h` : '∞'}</span></td>\n    </tr>\n  );\n}\n\nfunction TemporalConfigHeader({ title, t, isAdding, setIsAdding }: { isAdding: boolean; setIsAdding: (val: boolean) => void; t: TFunction; title: string }) {\n  return (\n    <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-6 px-2\">\n      <div className=\"flex items-center gap-4\">\n        <div className=\"w-10 h-10 rounded-2xl bg-primary-50 dark:bg-primary-950 flex items-center justify-center text-primary-600 dark:text-primary-400 shadow-sm border border-primary-100 dark:border-primary-800/50\"><Calculator size={20} /></div>\n        <div>\n          <h3 className=\"text-lg font-bold text-slate-800 dark:text-slate-100 tracking-tight uppercase\">{title}</h3>\n          <p className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest mt-0.5\">{t(\"payroll.settings.policy_desc\")}</p>\n        </div>\n      </div>\n      {!isAdding && (\n        <button className=\"flex items-center justify-center gap-2 bg-primary-600 text-white px-6 py-2.5 rounded-2xl font-bold text-[10px] uppercase tracking-widest hover:bg-primary-700 transition-all shadow-lg shadow-primary-100 active:scale-95\" onClick={() => { setIsAdding(true); }}><Plus size={14} /> {t(\"common.add_new\").toUpperCase()}</button>\n      )}\n    </div>\n  );\n}\n\nexport default function TemporalConfigTable({ title, records, onSave, isLoading }: Props) {\n  const { t } = useTranslation();\n  const { formatDate } = useDateTimeFormatter();\n  const [isAdding, setIsAdding] = useState(false);\n  const [newDays, setNewDays] = useState<number>(26);\n  const [newHours, setNewHours] = useState<number>(8);\n  const [newMaxOtDay, setNewMaxOtDay] = useState<string>(\"4\");\n  const [newMaxOtMonth, setNewMaxOtMonth] = useState<string>(\"40\");\n\n  const firstOfMonth = new Date(); firstOfMonth.setDate(1);\n  const [newEffectiveDate, setNewEffectiveDate] = useState(firstOfMonth.toISOString().split('T')[0]);\n\n  const handleSave = async () => {\n    await onSave({\n      std_working_days: newDays,\n      hours_per_day: newHours,\n      max_ot_hours_per_day: newMaxOtDay === '' ? null : parseFloat(newMaxOtDay),\n      max_ot_hours_per_month: newMaxOtMonth === '' ? null : parseFloat(newMaxOtMonth),\n      effective_date: newEffectiveDate,\n    });\n    setIsAdding(false);\n  };\n\n  const displayRecords = [...records];\n  if (displayRecords.length === 0 && !isLoading) {\n    displayRecords.push({ std_working_days: 26, hours_per_day: 8, effective_date: \"1970-01-01\", is_virtual: true });\n  }\n\n  const sortedRecords = displayRecords.sort((a, b) => new Date(b.effective_date).getTime() - new Date(a.effective_date).getTime());\n  const now = new Date();\n  const activeIndex = sortedRecords.findIndex(r => new Date(r.effective_date) <= now);\n\n  return (\n    <div className=\"space-y-8 animate-in fade-in duration-500\">\n      <TemporalConfigHeader\n        isAdding={isAdding}\n        setIsAdding={setIsAdding}\n        t={t}\n        title={title}\n      />\n\n      {isAdding && (\n        <TemporalConfigAddForm\n          handleSave={handleSave}\n          newDays={newDays}\n          newEffectiveDate={newEffectiveDate}\n          newHours={newHours}\n          newMaxOtDay={newMaxOtDay}\n          newMaxOtMonth={newMaxOtMonth}\n          setIsAdding={setIsAdding}\n          setNewDays={setNewDays}\n          setNewEffectiveDate={setNewEffectiveDate}\n          setNewHours={setNewHours}\n          setNewMaxOtDay={setNewMaxOtDay}\n          setNewMaxOtMonth={setNewMaxOtMonth}\n          t={t}\n        />\n      )}\n\n      <div className=\"bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-[2.5rem] overflow-hidden shadow-sm\">\n        {isLoading ? (\n          <div className=\"p-20 text-center\"><div className=\"w-10 h-10 border-4 border-primary-600 border-t-transparent rounded-full animate-spin mx-auto\"></div></div>\n        ) : (\n          <TemporalConfigTableContent\n            activeIndex={activeIndex}\n            formatDate={formatDate}\n            now={now}\n            sortedRecords={sortedRecords}\n            t={t}\n          />\n        )}\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/common/workspace-guard.tsx","messages":[],"suppressedMessages":[{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/workspace/webdashboard/src/components/common/workspace-guard.tsx:27:7\n  25 |       setCurrentWorkspaceId(workspaces[0].id);\n  26 |       // eslint-disable-next-line react-hooks/set-state-in-effect -- Derived state synced from props; intentional pattern\n> 27 |       setActiveWsId(workspaces[0].id);\n     |       ^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  28 |     }\n  29 |   }, [workspaces, activeWsId, isLoading]);\n  30 |","line":27,"column":7,"nodeType":null,"endLine":27,"endColumn":20,"suppressions":[{"kind":"directive","justification":"Derived state synced from props; intentional pattern"}]}],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/debug/debug-toolbar.tsx","messages":[{"ruleId":"@typescript-eslint/no-unnecessary-type-conversion","severity":2,"message":"Using !! on a boolean does not change the type or value of the boolean.","line":271,"column":8,"nodeType":null,"messageId":"unnecessaryTypeConversion","endLine":271,"endColumn":10,"suggestions":[{"messageId":"suggestRemove","fix":{"range":[11334,11345],"text":"isEnabled"},"desc":"Remove the type conversion."},{"messageId":"suggestSatisfies","data":{"type":"boolean"},"fix":{"range":[11334,11345],"text":"(isEnabled satisfies boolean)"},"desc":"Instead, assert that the value satisfies the boolean type."}]},{"ruleId":"@typescript-eslint/use-unknown-in-catch-callback-variable","severity":2,"message":"Prefer the safe `: unknown` for a `catch` callback variable.","line":307,"column":16,"nodeType":"Identifier","messageId":"useUnknown","endLine":307,"endColumn":21,"suggestions":[{"messageId":"addUnknownTypeAnnotationSuggestion","fix":{"range":[12682,12687],"text":"(error: unknown)"},"desc":"Add an explicit `: unknown` type annotation to the rejection callback variable."}]}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useQueryClient } from \"@tanstack/react-query\";\nimport { Terminal, User, Calendar, X, RefreshCcw, Power, Database, Trash2, UserPlus, UserMinus } from \"lucide-react\";\nimport React, { useState, useEffect } from \"react\";\n\nimport { useToast } from \"../../components/ui/toast\";\nimport { useDebug } from \"../../context/debug-context\";\nimport { useConfirm } from \"../../hooks/use-confirm\";\nimport { debugApi, ClearDbGroup as ClearDatabaseGroup } from \"../../lib/api/debug\";\nimport { getCurrentWorkspaceId } from \"../../lib/api/helpers\";\n\ntype DebugTab = \"identity\" | \"time\" | \"database\";\n\nexport interface DebugUser {\n  id: string;\n  name: string;\n  role: string;\n}\n\ninterface DebugIdentityTabProps {\n  debugUsers: DebugUser[];\n  setImpersonateId: (id: string) => void;\n  setTemporaryId: (id: string) => void;\n  temporaryId: string;\n}\n\nfunction DebugIdentityTab({ debugUsers, temporaryId, setTemporaryId, setImpersonateId }: DebugIdentityTabProps) {\n  return (\n    <div className=\"space-y-3 animate-in fade-in duration-300\">\n      <div className=\"space-y-1.5\">\n        <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase flex items-center gap-1\" htmlFor=\"debug-user-select\">\n          Select User\n        </label>\n        <select \n          className=\"w-full bg-slate-800 border border-slate-700 rounded px-2 py-1.5 text-[11px] mb-2 focus:outline-none focus:border-blue-500\"\n          id=\"debug-user-select\"\n          onChange={(e) => { setTemporaryId(e.target.value); }}\n          value={temporaryId}\n        >\n          <option value=\"\">-- All Workspace Users --</option>\n          {Array.isArray(debugUsers) && debugUsers.map((u) => (\n            <option key={u.id} value={u.id}>{u.name} ({u.role})</option>\n          ))}\n        </select>\n        <div className=\"flex gap-2\">\n          <input\n            className=\"flex-1 bg-slate-800 border border-slate-700 rounded px-2 py-1.5 text-[11px] font-mono focus:outline-none focus:border-blue-500\"\n            onChange={(e) => { setTemporaryId(e.target.value); }}\n            placeholder=\"Paste UUID...\"\n            type=\"text\"\n            value={temporaryId}\n          />\n          <button\n            className=\"bg-blue-600 hover:bg-blue-50 dark:bg-blue-950 px-3 py-1.5 rounded text-[10px] font-bold\"\n            onClick={() => { setImpersonateId(temporaryId); }}\n          >\n            Apply\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n}\n\ninterface DebugTimeTabProps {\n  setMockDate: (date: string) => void;\n  setTemporaryDate: (date: string) => void;\n  temporaryDate: string;\n}\n\nfunction DebugTimeTab({ temporaryDate, setTemporaryDate, setMockDate }: DebugTimeTabProps) {\n  return (\n    <div className=\"space-y-3 animate-in fade-in duration-300\">\n      <div className=\"space-y-1.5\">\n        <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase flex items-center gap-1\" htmlFor=\"debug-date-input\">\n          Travel to Date\n        </label>\n        <div className=\"flex gap-2\">\n          <input\n            className=\"flex-1 bg-slate-800 border border-slate-700 rounded px-2 py-1.5 text-[11px] focus:outline-none focus:border-teal-500 [color-scheme:dark]\"\n            id=\"debug-date-input\"\n            onChange={(e) => { setTemporaryDate(e.target.value); }}\n            type=\"date\"\n            value={temporaryDate}\n          />\n          <button\n            className=\"bg-teal-600 hover:bg-teal-50 dark:bg-teal-950 px-3 py-1.5 rounded text-[10px] font-bold\"\n            onClick={() => { setMockDate(temporaryDate); }}\n          >\n            Apply\n          </button>\n        </div>\n        <p className=\"text-[9px] text-slate-500 dark:text-slate-400 italic mt-2\">\n          Note: Mock date affects payroll segments and policy resolution.\n        </p>\n      </div>\n    </div>\n  );\n}\n\ninterface DebugDatabaseTabProps {\n  handleClearDatabase: (group: ClearDatabaseGroup) => Promise<void>;\n  isWiping: boolean;\n}\n\nfunction DebugDatabaseTab({ isWiping, handleClearDatabase }: DebugDatabaseTabProps) {\n  return (\n    <div className=\"space-y-3 animate-in fade-in duration-300\">\n      <div className=\"grid grid-cols-3 gap-2\">\n        <button\n          className=\"flex flex-col items-center gap-1 bg-slate-800 hover:bg-slate-700 border border-slate-700 p-2 rounded transition-colors group\"\n          disabled={isWiping}\n          onClick={() => handleClearDatabase(\"attendance\")}\n          title=\"Clear attendance logs and time entries\"\n        >\n          <Trash2 className=\"text-slate-500 dark:text-slate-400 group-hover:text-amber-400\" size={12} />\n          <span className=\"text-[8px] font-bold uppercase\">Logs</span>\n        </button>\n        <button\n          className=\"flex flex-col items-center gap-1 bg-slate-800 hover:bg-slate-700 border border-slate-700 p-2 rounded transition-colors group\"\n          disabled={isWiping}\n          onClick={() => handleClearDatabase(\"payroll\")}\n          title=\"Clear payroll history\"\n        >\n          <Trash2 className=\"text-slate-500 dark:text-slate-400 group-hover:text-amber-400\" size={12} />\n          <span className=\"text-[8px] font-bold uppercase\">Payroll</span>\n        </button>\n        <button\n          className=\"flex flex-col items-center gap-1 bg-slate-800 hover:bg-slate-700 border border-slate-700 p-2 rounded transition-colors group\"\n          disabled={isWiping}\n          onClick={() => handleClearDatabase(\"rosters\")}\n          title=\"Clear schedules and rosters\"\n        >\n          <Trash2 className=\"text-slate-500 dark:text-slate-400 group-hover:text-amber-400\" size={12} />\n          <span className=\"text-[8px] font-bold uppercase\">Rosters</span>\n        </button>\n      </div>\n\n      <div className=\"grid grid-cols-2 gap-2 pt-2 border-t border-slate-800\">\n        <button\n          className=\"flex flex-col items-center gap-1 bg-red-900/10 hover:bg-red-900/30 border border-red-900/30 p-2 rounded transition-colors group\"\n          disabled={isWiping}\n          onClick={() => handleClearDatabase(\"employees\")}\n          title=\"Delete all employees and their data (keeps settings)\"\n        >\n          <UserMinus className=\"text-red-400\" size={14} />\n          <span className=\"text-[9px] font-bold uppercase text-red-200\">Wipe Staff</span>\n        </button>\n        <button\n          className=\"flex flex-col items-center gap-1 bg-red-900/20 hover:bg-red-900/40 border border-red-900/50 p-2 rounded transition-colors group\"\n          disabled={isWiping}\n          onClick={() => handleClearDatabase(\"full_reset\")}\n          title=\"Delete EVERYTHING (Factory Reset)\"\n        >\n          <Trash2 className=\"text-red-400\" size={14} />\n          <span className=\"text-[9px] font-bold uppercase text-red-200\">Factory Reset</span>\n        </button>\n      </div>\n      \n      <div className=\"pt-2 border-t border-slate-800\">\n        <button\n          className=\"w-full flex items-center justify-center gap-2 bg-green-900/20 hover:bg-green-900/40 border border-green-900/50 p-2 rounded text-[10px] font-bold text-green-200 transition-colors\"\n          disabled={isWiping}\n          onClick={() => handleClearDatabase(\"seed\")}\n          title=\"Create default departments, shifts, and employees\"\n        >\n          <UserPlus size={14} /> Quick Seed Demo Team\n        </button>\n      </div>\n    </div>\n  );\n}\n\ninterface DebugToolbarTabsProps {\n  activeTab: DebugTab;\n  setActiveTab: (tab: DebugTab) => void;\n}\n\nfunction DebugToolbarTabs({ activeTab, setActiveTab }: DebugToolbarTabsProps) {\n  return (\n    <div className=\"flex border-b border-slate-800 mt-2\">\n      <button \n        className={`flex-1 py-2 text-[10px] font-bold uppercase tracking-tight flex items-center justify-center gap-1.5 transition-colors ${\n          activeTab === \"identity\" ? \"bg-slate-800 text-blue-400 border-b-2 border-blue-400\" : \"text-slate-500 dark:text-slate-400 hover:text-slate-300 dark:text-slate-600\"\n        }`}\n        onClick={() => { setActiveTab(\"identity\"); }}\n      >\n        <User size={12} /> Identity\n      </button>\n      <button \n        className={`flex-1 py-2 text-[10px] font-bold uppercase tracking-tight flex items-center justify-center gap-1.5 transition-colors ${\n          activeTab === \"time\" ? \"bg-slate-800 text-teal-400 border-b-2 border-teal-400\" : \"text-slate-500 dark:text-slate-400 hover:text-slate-300 dark:text-slate-600\"\n        }`}\n        onClick={() => { setActiveTab(\"time\"); }}\n      >\n        <Calendar size={12} /> Time\n      </button>\n      <button \n        className={`flex-1 py-2 text-[10px] font-bold uppercase tracking-tight flex items-center justify-center gap-1.5 transition-colors ${\n          activeTab === \"database\" ? \"bg-slate-800 text-red-400 border-b-2 border-red-400\" : \"text-slate-500 dark:text-slate-400 hover:text-slate-300 dark:text-slate-600\"\n        }`}\n        onClick={() => { setActiveTab(\"database\"); }}\n      >\n        <Database size={12} /> Database\n      </button>\n    </div>\n  );\n}\n\ninterface DebugToolbarHeaderProps {\n  isEnabled: boolean;\n  setIsEnabled: (enabled: boolean) => void;\n  setIsOpen: (open: boolean) => void;\n}\n\nfunction DebugToolbarHeader({ isEnabled, setIsEnabled, setIsOpen }: DebugToolbarHeaderProps) {\n  return (\n    <>\n      <div className=\"flex items-center justify-between p-3 border-b border-slate-800 bg-slate-950\">\n        <div className=\"flex items-center gap-2\">\n          <Terminal className=\"text-blue-400\" size={16} />\n          <span className=\"text-xs font-bold tracking-wider uppercase\">Debug Suite v2.0</span>\n        </div>\n        <button className=\"hover:text-slate-500 dark:text-slate-400\" onClick={() => { setIsOpen(false); }}>\n          <X size={16} />\n        </button>\n      </div>\n\n      <div className=\"px-4 pt-4\">\n        <div className=\"flex items-center justify-between p-2 bg-slate-800/50 rounded-lg\">\n          <div className=\"flex items-center gap-2\">\n            <Power className={isEnabled ? \"text-green-400\" : \"text-slate-500 dark:text-slate-400\"} size={14} />\n            <span className=\"text-xs font-medium\">Global Debug Mode</span>\n          </div>\n          <button\n            className={`w-10 h-5 rounded-full relative transition-colors ${\n              isEnabled ? \"bg-green-600\" : \"bg-slate-600\"\n            }`}\n            onClick={() => { setIsEnabled(!isEnabled); }}\n          >\n            <div className={`absolute top-1 w-3 h-3 bg-white dark:bg-slate-900 rounded-full transition-all ${\n              isEnabled ? \"left-6\" : \"left-1\"\n            }`} />\n          </button>\n        </div>\n      </div>\n    </>\n  );\n}\n\ninterface DebugToolbarFooterProps {\n  isEnabled: boolean;\n  reset: () => void;\n  setTemporaryDate: (date: string) => void;\n  setTemporaryId: (id: string) => void;\n}\n\nfunction DebugToolbarFooter({ isEnabled, reset, setTemporaryId, setTemporaryDate }: DebugToolbarFooterProps) {\n  return (\n    <div className=\"p-3 bg-slate-950 border-t border-slate-800 flex justify-between gap-2\">\n      <button\n        className=\"flex-1 flex items-center justify-center gap-1.5 bg-slate-800 hover:bg-slate-700 py-2 rounded text-[10px] font-bold text-slate-300 dark:text-slate-600\"\n        onClick={() => {\n          reset();\n          setTemporaryId(\"\");\n          setTemporaryDate(\"\");\n          window.location.reload();\n        }}\n      >\n        <RefreshCcw size={12} /> Clear Settings\n      </button>\n      {!!isEnabled && (\n        <button\n          className=\"flex-1 flex items-center justify-center gap-1.5 bg-blue-600 hover:bg-blue-50 dark:bg-blue-950 py-2 rounded text-[10px] font-bold\"\n          onClick={() => { window.location.reload(); }}\n        >\n          Reload UI\n        </button>\n      )}\n    </div>\n  );\n}\n\nexport const DebugToolbar: React.FC = () => {\n  const queryClient = useQueryClient();\n  const toast = useToast();\n  const { isEnabled, impersonateId, mockDate, setIsEnabled, setImpersonateId, setMockDate, reset } = useDebug();\n  const { confirm, ConfirmationDialog } = useConfirm();\n  const [isOpen, setIsOpen] = useState(false);\n  const [activeTab, setActiveTab] = useState<DebugTab>(\"identity\");\n  const [temporaryId, setTemporaryId] = useState(impersonateId ?? \"\");\n  const [temporaryDate, setTemporaryDate] = useState(mockDate ?? \"\");\n \n  const [debugUsers, setDebugUsers] = useState<DebugUser[]>([]);\n  const [isWiping, setIsWiping] = useState(false);\n\n  useEffect(() => {\n    if (isOpen && isEnabled && activeTab === \"identity\") {\n      debugApi.getUsers()\n        .then(res => {\n          if (Array.isArray(res)) {\n            setDebugUsers(res as DebugUser[]);\n          } else {\n            console.warn(\"Debug users API did not return an array:\", res);\n            setDebugUsers([]);\n          }\n        })\n        .catch(error => {\n          console.error(\"Failed to fetch debug users:\", error);\n          setDebugUsers([]);\n        });\n    }\n  }, [isOpen, isEnabled, activeTab]);\n\n  if (!import.meta.env.DEV) return null;\n\n  const currentWorkspaceId = getCurrentWorkspaceId();\n\n  const handleClearDatabase = async (group: ClearDatabaseGroup) => {\n    if (!currentWorkspaceId) { toast.error(\"No workspace selected\"); return; }\n    \n    const actionVerb = group === \"seed\" ? \"seed demo\" : \"wipe\";\n    const warning = group === \"full_reset\" ? \" This will delete EVERYTHING.\" : group === \"employees\" ? \" This will delete all employees and their history.\" : \"\";\n    \n    const ok = await confirm({\n      title: \"Confirm \" + actionVerb,\n      message: `Are you sure you want to ${actionVerb} ${group === \"seed\" ? \"data\" : group + \" data\"}?${warning}`,\n      variant: group === \"seed\" ? \"warning\" : \"danger\"\n    });\n    if (!ok) return;\n    \n    setIsWiping(true);\n    try {\n      await debugApi.clearDb(currentWorkspaceId, group);\n      void queryClient.invalidateQueries();\n      toast.success(`${group === \"seed\" ? \"Demo data seeded\" : group + \" data wiped\"} successfully.`);\n    } catch (error) {\n      toast.error(\"Operation failed: \" + (error as Error).message);\n    } finally {\n      setIsWiping(false);\n    }\n  };\n\n  if (!isOpen) {\n    return (\n      <button\n        className=\"fixed bottom-4 right-4 bg-slate-900 text-white p-3 rounded-full shadow-2xl z-[9999] hover:bg-slate-800 transition-colors border border-slate-700\"\n        onClick={() => { setIsOpen(true); }}\n        title=\"Open Debug Tools\"\n      >\n        <Terminal className={isEnabled ? \"text-green-400\" : \"text-white\"} size={20} />\n      </button>\n    );\n  }\n\n  return (\n    <div className=\"fixed bottom-4 right-4 bg-slate-900 text-white rounded-xl shadow-2xl z-[9999] border border-slate-700 w-80 overflow-hidden animate-in slide-in-from-bottom-4 duration-200\">\n      <DebugToolbarHeader isEnabled={isEnabled} setIsEnabled={setIsEnabled} setIsOpen={setIsOpen} />\n      <DebugToolbarTabs activeTab={activeTab} setActiveTab={setActiveTab} />\n\n      <div className={`p-4 min-h-[160px] ${!isEnabled ? \"opacity-40 pointer-events-none\" : \"\"}`}>\n        {activeTab === \"identity\" && (\n          <DebugIdentityTab debugUsers={debugUsers} setImpersonateId={setImpersonateId} setTemporaryId={setTemporaryId} temporaryId={temporaryId} />\n        )}\n\n        {activeTab === \"time\" && (\n          <DebugTimeTab setMockDate={setMockDate} setTemporaryDate={setTemporaryDate} temporaryDate={temporaryDate} />\n        )}\n\n        {activeTab === \"database\" && (\n          <DebugDatabaseTab handleClearDatabase={handleClearDatabase} isWiping={isWiping} />\n        )}\n      </div>\n\n      <DebugToolbarFooter isEnabled={isEnabled} reset={reset} setTemporaryDate={setTemporaryDate} setTemporaryId={setTemporaryId} />\n      <ConfirmationDialog />\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/employees/__tests__/working-condition-config.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecated