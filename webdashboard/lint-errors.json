({ children, ...props }: any) => (\n        <div data-testid=\"pie\" {...props}>{children}</div>\n    ),\n}));\n\nimport JobStatusDistributionChart from \"../JobStatusDistributionChart\";\nimport QueuePressureChart from \"../QueuePressureChart\";\nimport WorkerUtilizationGauge from \"../WorkerUtilizationGauge\";\n\nconst renderWithProviders = (component: React.ReactElement) => {\n    const queryClient = new QueryClient({\n        defaultOptions: { queries: { retry: false } },\n    });\n    return render(\n        <QueryClientProvider client={queryClient}>\n            {component}\n        </QueryClientProvider>\n    );\n};\n\n// =============================================================================\n// WorkerUtilizationGauge\n// =============================================================================\ndescribe(\"WorkerUtilizationGauge\", () => {\n    it(\"renders gauge with correct percentage\", () => {\n        renderWithProviders(\n            <WorkerUtilizationGauge data={{ active: 3, idle: 2, total: 5, percent: 60 }} isLoading={false} />\n        );\n        expect(screen.getByText(\"60%\")).toBeInTheDocument();\n    });\n\n    it(\"shows loading state\", () => {\n        renderWithProviders(\n            <WorkerUtilizationGauge data={{ active: 0, idle: 0, total: 0, percent: 0 }} isLoading={true} />\n        );\n        expect(screen.queryByText(\"0%\")).not.toBeInTheDocument();\n        expect(screen.queryByTestId(\"radial-chart\")).not.toBeInTheDocument();\n    });\n\n    it(\"shows scale-up warning when utilization > 80%\", () => {\n        renderWithProviders(\n            <WorkerUtilizationGauge data={{ active: 9, idle: 1, total: 10, percent: 90 }} isLoading={false} />\n        );\n        expect(screen.getByText(/monitor.charts.scale_up_warning/)).toBeInTheDocument();\n    });\n\n    it(\"shows scale-down hint when utilization < 30%\", () => {\n        renderWithProviders(\n            <WorkerUtilizationGauge data={{ active: 1, idle: 9, total: 10, percent: 10 }} isLoading={false} />\n        );\n        expect(screen.getByText(/monitor.charts.scale_down_hint/)).toBeInTheDocument();\n    });\n\n    it(\"does not show scaling hints for normal utilization\", () => {\n        renderWithProviders(\n            <WorkerUtilizationGauge data={{ active: 3, idle: 2, total: 5, percent: 60 }} isLoading={false} />\n        );\n        expect(screen.queryByText(/scale_up_warning/)).not.toBeInTheDocument();\n        expect(screen.queryByText(/scale_down_hint/)).not.toBeInTheDocument();\n    });\n\n    it(\"renders chart title\", () => {\n        renderWithProviders(\n            <WorkerUtilizationGauge data={{ active: 0, idle: 0, total: 0, percent: 0 }} isLoading={false} />\n        );\n        expect(screen.getAllByText(\"monitor.charts.utilization\").length).toBeGreaterThanOrEqual(1);\n    });\n\n    it(\"renders active and idle pills\", () => {\n        renderWithProviders(\n            <WorkerUtilizationGauge data={{ active: 3, idle: 2, total: 5, percent: 60 }} isLoading={false} />\n        );\n        // Active pill\n        expect(screen.getByText(/3/)).toBeInTheDocument();\n        // Idle pill\n        expect(screen.getByText(/2/)).toBeInTheDocument();\n    });\n});\n\n// =============================================================================\n// QueuePressureChart\n// =============================================================================\ndescribe(\"QueuePressureChart\", () => {\n    it(\"renders bars with correct total\", () => {\n        renderWithProviders(\n            <QueuePressureChart data={{ high: 10, low: 5, total: 15, pressureLevel: \"medium\" }} isLoading={false} />\n        );\n        expect(screen.getByText(\"15\")).toBeInTheDocument();\n        expect(screen.getByTestId(\"bar-chart\")).toBeInTheDocument();\n    });\n\n    it(\"shows loading state\", () => {\n        renderWithProviders(\n            <QueuePressureChart data={{ high: 0, low: 0, total: 0, pressureLevel: \"low\" }} isLoading={true} />\n        );\n        expect(screen.queryByTestId(\"bar-chart\")).not.toBeInTheDocument();\n    });\n\n    it(\"shows empty state when queue is empty\", () => {\n        renderWithProviders(\n            <QueuePressureChart data={{ high: 0, low: 0, total: 0, pressureLevel: \"low\" }} isLoading={false} />\n        );\n        expect(screen.getByText(\"Queue clear\")).toBeInTheDocument();\n    });\n\n    it(\"renders pressure level badge\", () => {\n        renderWithProviders(\n            <QueuePressureChart data={{ high: 20, low: 5, total: 25, pressureLevel: \"critical\" }} isLoading={false} />\n        );\n        const badge = screen.getByTestId(\"pressure-badge\");\n        expect(badge).toBeInTheDocument();\n        expect(badge).toHaveTextContent(\"Critical\");\n    });\n\n    it(\"renders chart title\", () => {\n        renderWithProviders(\n            <QueuePressureChart data={{ high: 0, low: 0, total: 0, pressureLevel: \"low\" }} isLoading={false} />\n        );\n        expect(screen.getByText(\"monitor.queue_pressure\")).toBeInTheDocument();\n    });\n});\n\n// =============================================================================\n// JobStatusDistributionChart\n// =============================================================================\ndescribe(\"JobStatusDistributionChart\", () => {\n    const mockDistribution = [\n        { status: \"completed\", count: 8, color: \"#10b981\", percent: 72.7 },\n        { status: \"failed\", count: 2, color: \"#ef4444\", percent: 18.2 },\n        { status: \"processing\", count: 1, color: \"#f59e0b\", percent: 9.1 },\n    ];\n\n    it(\"renders donut chart\", () => {\n        renderWithProviders(\n            <JobStatusDistributionChart data={mockDistribution} isLoading={false} />\n        );\n        expect(screen.getByTestId(\"pie-chart\")).toBeInTheDocument();\n    });\n\n    it(\"renders legend entries with percentages\", () => {\n        renderWithProviders(\n            <JobStatusDistributionChart data={mockDistribution} isLoading={false} />\n        );\n        expect(screen.getByTestId(\"legend-completed\")).toHaveTextContent(\"completed 72.7%\");\n        expect(screen.getByTestId(\"legend-failed\")).toHaveTextContent(\"failed 18.2%\");\n        expect(screen.getByTestId(\"legend-processing\")).toHaveTextContent(\"processing 9.1%\");\n    });\n\n    it(\"shows loading state\", () => {\n        renderWithProviders(\n            <JobStatusDistributionChart data={[]} isLoading={true} />\n        );\n        expect(screen.queryByTestId(\"pie-chart\")).not.toBeInTheDocument();\n    });\n\n    it(\"shows empty state when no jobs\", () => {\n        renderWithProviders(\n            <JobStatusDistributionChart data={[]} isLoading={false} />\n        );\n        expect(screen.getByText(\"No data\")).toBeInTheDocument();\n    });\n\n    it(\"renders chart title\", () => {\n        renderWithProviders(\n            <JobStatusDistributionChart data={mockDistribution} isLoading={false} />\n        );\n        expect(screen.getByText(\"monitor.job_distribution\")).toBeInTheDocument();\n    });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/reports/DailyReportTable.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'OtStatus' is defined but never used. Allowed unused vars must match /^_/u.","line":9,"column":15,"nodeType":"Identifier","messageId":"unusedVar","endLine":9,"endColumn":23,"suggestions":[{"messageId":"removeUnusedImportDeclaration","data":{"varName":"OtStatus"},"fix":{"range":[302,345],"text":""},"desc":"Remove unused import declaration."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from \"react\";\n\nimport { RefreshCw, Bug, CheckCircle, ThumbsUp, ThumbsDown, AlertTriangle } from \"lucide-react\";\n\nimport { DailyAttendanceReport, AttendanceAdjustmentRequest } from \"@/lib/api\";\nimport { cn } from \"@/lib/utils\";\nimport { formatUnitsToHours } from \"@/lib/utils/attendance\";\n\nimport type { OtStatus } from \"@/lib/api\";\n\ninterface DailyReportTableProps {\n  data: DailyAttendanceReport[];\n  isLoading: boolean;\n  workUnitMinutes: number;\n  isDebugMode: boolean;\n  expandedDebugRows: Set<string>;\n  reprocessingRow: string | null;\n  confirmingRow: string | null;\n  adjustmentMap: Record<string, AttendanceAdjustmentRequest>;\n  t: (key: string) => string;\n  formatDate: (date: string) => string;\n  formatTime: (time: string | null) => string;\n  onToggleExpandRow: (rowKey: string) => void;\n  onReprocessClick: (row: DailyAttendanceReport) => void;\n  onConfirmClick: (row: DailyAttendanceReport, existing?: AttendanceAdjustmentRequest) => void;\n  onApproveOt?: (row: DailyAttendanceReport, action: \"approved\" | \"rejected\") => void;\n  onResolveUnscheduled?: (row: DailyAttendanceReport) => void;\n  hideEmployeeName?: boolean;\n}\n\nexport default function DailyReportTable({\n  data,\n  isLoading,\n  workUnitMinutes,\n  isDebugMode,\n  expandedDebugRows,\n  reprocessingRow,\n  confirmingRow,\n  adjustmentMap,\n  t,\n  formatDate,\n  formatTime,\n  onToggleExpandRow,\n  onReprocessClick,\n  onConfirmClick,\n  onApproveOt,\n  onResolveUnscheduled,\n  hideEmployeeName = false,\n}: DailyReportTableProps) {\n  const getStatusBadge = (status: string, row: DailyAttendanceReport) => {\n    const styles: Record<string, string> = {\n      present: \"bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-300 border-emerald-100 dark:border-emerald-800\",\n      late: \"bg-amber-50 dark:bg-amber-950 text-amber-600 dark:text-amber-300 border-amber-100 dark:border-amber-800\",\n      absent: \"bg-rose-50 dark:bg-rose-950 text-rose-600 dark:text-rose-300 border-rose-100 dark:border-rose-800\",\n      off: \"bg-slate-50 dark:bg-slate-800 text-slate-500 dark:text-slate-400 border-slate-100 dark:border-slate-800\",\n      unscheduled: \"bg-amber-50 dark:bg-amber-950 text-amber-600 dark:text-amber-300 border-amber-200 dark:border-amber-800\",\n      holiday: \"bg-green-50 dark:bg-green-950 text-green-700 dark:text-green-300 border-green-200 dark:border-green-800\",\n      holiday_paid: \"bg-green-50 dark:bg-green-950 text-green-700 dark:text-green-300 border-green-200 dark:border-green-800\",\n      holiday_leave: \"bg-amber-50 dark:bg-amber-950 text-amber-700 dark:text-amber-300 border-amber-200 dark:border-amber-800\",\n      holiday_unpaid: \"bg-rose-50 dark:bg-rose-950 text-rose-700 dark:text-rose-300 border-rose-200 dark:border-rose-800\",\n      holiday_work: \"bg-orange-50 dark:bg-orange-950 text-orange-700 dark:text-orange-300 border-orange-200 dark:border-orange-800\",\n    };\n\n    const labels: Record<string, string> = {\n      present: t(\"reports.status.present\"),\n      late: t(\"reports.status.late\"),\n      absent: t(\"reports.status.absent\"),\n      off: t(\"reports.status.off\"),\n      unscheduled: t(\"reports.status.unscheduled\"),\n      holiday: \"🏖️ Holiday\",\n      holiday_paid: \"🏖️ Holiday (Paid)\",\n      holiday_leave: \"⚡ Holiday (Leave)\",\n      holiday_unpaid: \"🔴 Holiday (Unpaid)\",\n      holiday_work: \"🔶 Holiday Work\",\n    };\n\n    // Unscheduled: render a clickable button that opens the resolve modal\n    if (status === \"unscheduled\") {\n      return (\n        <button\n          onClick={(e) => { e.stopPropagation(); onResolveUnscheduled?.(row); }}\n          className={cn(\n            \"inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wide border shadow-sm cursor-pointer hover:bg-amber-100 dark:hover:bg-amber-900 hover:border-amber-300 dark:hover:border-amber-700 transition-colors active:scale-95\",\n            styles.unscheduled\n          )}\n          title={t(\"reports.status.unscheduled_tooltip\")}\n        >\n          <AlertTriangle size={10} /> {labels.unscheduled}\n        </button>\n      );\n    }\n\n    return (\n      <span\n        className={cn(\n          \"px-1.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wide border shadow-sm\",\n          styles[status] || styles.off\n        )}\n        title={row.holiday_name || undefined}\n      >\n        {labels[status] || status}\n      </span>\n    );\n  };\n\n  const getOtStatusBadge = (status?: string | null) => {\n    if (!status || status === \"none\") return null;\n\n    const styles: Record<string, string> = {\n      pending_employee: \"bg-yellow-50 dark:bg-yellow-950 text-yellow-600 dark:text-yellow-300 border-yellow-200 dark:border-yellow-800\",\n      pending_manager: \"bg-orange-50 dark:bg-orange-950 text-orange-600 dark:text-orange-300 border-orange-200 dark:border-orange-800\",\n      approved: \"bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-300 border-emerald-200 dark:border-emerald-800\",\n      rejected: \"bg-rose-50 dark:bg-rose-950 text-rose-600 dark:text-rose-300 border-rose-200 dark:border-rose-800\",\n    };\n\n    const labels: Record<string, string> = {\n      pending_employee: t(\"reports.ot_status.pending_employee\"),\n      pending_manager: t(\"reports.ot_status.pending_manager\"),\n      approved: t(\"reports.ot_status.approved\"),\n      rejected: t(\"reports.ot_status.rejected\"),\n    };\n\n    return (\n      <span className={cn(\"px-1.5 py-0.5 rounded border text-[9px] font-bold uppercase tracking-wide\", styles[status] || \"\")}>\n        {labels[status] || status}\n      </span>\n    );\n  };\n\n  return (\n    <div className=\"overflow-auto flex-1 min-h-0\">\n      <table className=\"w-full text-left min-w-[1200px] border-collapse relative\">\n        <thead>\n          <tr className=\"bg-slate-50/95 dark:bg-slate-800/95 backdrop-blur-sm border-b border-slate-100 dark:border-slate-800 sticky top-0 z-20\">\n            <th className=\"px-4 py-2.5 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest sticky left-0 z-20 bg-slate-50/95 dark:bg-slate-800/95 backdrop-blur-sm\">\n              {t(\"common.date\")}\n            </th>\n            {!hideEmployeeName && (\n              <th className=\"px-4 py-2.5 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest sticky left-[80px] sm:left-[100px] z-20 bg-slate-50/95 dark:bg-slate-800/95 backdrop-blur-sm\">\n                {t(\"common.employee\")}\n              </th>\n            )}\n            <th className=\"px-4 py-2.5 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">\n              {t(\"common.shift\")}\n            </th>\n            <th className=\"px-4 py-2.5 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest text-center\">\n              {t(\"common.in\")}\n            </th>\n            <th className=\"px-4 py-2.5 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest text-center\">\n              {t(\"common.out\")}\n            </th>\n            <th className=\"px-4 py-2.5 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest text-right\">\n              {t(\"reports.table.std_hours\")}\n            </th>\n            <th className=\"px-4 py-2.5 text-[10px] font-bold text-orange-500 dark:text-orange-400 uppercase tracking-widest text-right\">\n              {t(\"reports.table.ot_hours\")}\n            </th>\n            <th className=\"px-4 py-2.5 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest text-center\">\n              {t(\"common.status\")}\n            </th>\n            {isDebugMode && (\n              <th className=\"px-4 py-2.5 text-[10px] font-bold text-amber-600 dark:text-amber-300 uppercase tracking-widest text-center\">\n                DEBUG\n              </th>\n            )}\n            <th className=\"px-4 py-2.5\"></th>\n          </tr>\n        </thead>\n\n        <tbody className=\"divide-y divide-slate-50 dark:divide-slate-800\">\n          {isLoading ? (\n            <tr>\n              <td\n                colSpan={isDebugMode ? (hideEmployeeName ? 9 : 10) : (hideEmployeeName ? 8 : 9)}\n                className=\"px-10 py-20 text-center text-slate-500 dark:text-slate-400 font-bold italic uppercase tracking-widest text-xs opacity-50 animate-pulse\"\n              >\n                {t(\"common.loading\")}\n              </td>\n            </tr>\n          ) : data.length === 0 ? (\n            <tr>\n              <td\n                colSpan={isDebugMode ? (hideEmployeeName ? 9 : 10) : (hideEmployeeName ? 8 : 9)}\n                className=\"px-10 py-32 text-center text-slate-500 dark:text-slate-400 font-bold italic uppercase tracking-widest text-xs opacity-50\"\n              >\n                {t(\"reports.messages.no_data\")}\n              </td>\n            </tr>\n          ) : (\n            data.map((row: DailyAttendanceReport, idx: number) => {\n              const rowKey = `${row.employee_id}-${row.date}`;\n              const isReprocessing = reprocessingRow === rowKey;\n              const isConfirming = confirmingRow === rowKey;\n              const isExpanded = expandedDebugRows.has(rowKey);\n              const existingAdjustment = adjustmentMap[rowKey];\n\n              return (\n                <React.Fragment key={`${rowKey}-${idx}`}>\n                  <tr\n                    className={cn(\n                      \"transition-all group\",\n                      isExpanded ? \"bg-amber-50 dark:bg-amber-950/20\" : \"hover:bg-slate-50 dark:hover:bg-slate-800/50\"\n                    )}\n                  >\n                    <td className=\"px-4 py-2.5 font-mono text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase whitespace-nowrap sticky left-0 z-10 bg-white group-hover:bg-slate-50 dark:bg-slate-900 dark:group-hover:bg-slate-800/50 transition-colors\">\n                      {formatDate(row.date)}\n                    </td>\n\n                    {!hideEmployeeName && (\n                      <td className=\"px-4 py-2.5 font-bold text-slate-700 dark:text-slate-200 text-sm tracking-tight uppercase leading-none whitespace-nowrap sticky left-[80px] sm:left-[100px] z-10 bg-white group-hover:bg-slate-50 dark:bg-slate-900 dark:group-hover:bg-slate-800/50 transition-colors\">\n                        {row.employee_name}\n                      </td>\n                    )}\n\n                    <td className=\"px-4 py-2.5\">\n                      {row.scheduled_start ? (\n                        <div className=\"flex flex-col\">\n                          <span className=\"font-bold text-slate-700 dark:text-slate-200 text-xs uppercase tracking-tighter shadow-sm bg-white dark:bg-slate-900 px-2 py-0.5 rounded-lg border border-slate-100 dark:border-slate-800 w-fit\">\n                            {row.scheduled_start.substring(0, 5)} — {row.scheduled_end?.substring(0, 5)}\n                          </span>\n                          {row.break_duration_minutes !== null && (\n                            <span className=\"text-[8px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.2em] mt-1.5 opacity-70 italic\">\n                              {row.break_start\n                                ? `${t(\"common.break\")}: ${row.break_start.substring(0, 5)}-${row.break_end?.substring(0, 5)}`\n                                : `${t(\"common.break\")}: ${row.break_duration_minutes}m`}\n                            </span>\n                          )}\n                        </div>\n                      ) : (\n                        <span className=\"text-[9px] font-bold text-slate-300 dark:text-slate-600 uppercase tracking-widest italic opacity-50\">\n                          {t(\"reports.no_shift\")}\n                        </span>\n                      )}\n                    </td>\n\n                    <td className=\"px-4 py-2.5 text-center font-mono font-bold text-xs text-slate-700 dark:text-slate-200 tracking-tighter\">\n                      <div className=\"shadow-inner bg-slate-50 dark:bg-slate-800/50 rounded-md py-1 px-2 inline-block\">\n                        {formatTime(row.actual_punch_in)}\n                      </div>\n                    </td>\n\n                    <td className=\"px-4 py-2.5 text-center font-mono font-bold text-xs text-slate-700 dark:text-slate-200 tracking-tighter\">\n                      <div className=\"shadow-inner bg-slate-50 dark:bg-slate-800/50 rounded-md py-1 px-2 inline-block\">\n                        {formatTime(row.actual_punch_out)}\n                      </div>\n                    </td>\n\n                    <td className=\"px-4 py-2.5 text-right\" title={`${row.std_work_units} units`}>\n                      <div className=\"font-mono font-bold text-primary-600 dark:text-primary-400 text-base tracking-tighter leading-none\">\n                        {formatUnitsToHours(row.std_work_units, workUnitMinutes)}h\n                      </div>\n                    </td>\n\n                    <td className=\"px-4 py-2.5 text-right\" title={row.ot_work_units > 0 ? `${row.ot_work_units} units` : undefined}>\n                      {row.ot_work_units > 0 ? (\n                        <div className=\"flex flex-col items-end gap-1\">\n                          <div>\n                            <span className=\"font-mono font-bold text-orange-600 dark:text-orange-400 text-base tracking-tighter leading-none\">\n                              {formatUnitsToHours(row.ot_work_units, workUnitMinutes)}h\n                            </span>\n                          </div>\n                          {getOtStatusBadge(row.ot_claim_status)}\n                          {row.ot_claim_status === \"pending_manager\" && onApproveOt && (\n                            <div className=\"flex gap-1 mt-1\">\n                              <button\n                                onClick={(e) => { e.stopPropagation(); onApproveOt(row, \"approved\"); }}\n                                className=\"flex items-center gap-0.5 px-2 py-0.5 rounded-md text-[8px] font-bold uppercase tracking-wider bg-emerald-500 text-white hover:bg-emerald-600 transition-colors shadow-sm active:scale-95\"\n                                title={t(\"reports.ot_approve.approve\")}\n                              >\n                                <ThumbsUp size={10} />\n                                {t(\"reports.ot_approve.approve\")}\n                              </button>\n                              <button\n                                onClick={(e) => { e.stopPropagation(); onApproveOt(row, \"rejected\"); }}\n                                className=\"flex items-center gap-0.5 px-2 py-0.5 rounded-md text-[8px] font-bold uppercase tracking-wider bg-rose-500 text-white hover:bg-rose-600 transition-colors shadow-sm active:scale-95\"\n                                title={t(\"reports.ot_approve.reject\")}\n                              >\n                                <ThumbsDown size={10} />\n                                {t(\"reports.ot_approve.reject\")}\n                              </button>\n                            </div>\n                          )}\n                        </div>\n                      ) : (\n                        <span className=\"text-slate-200 dark:text-slate-700 font-bold\">—</span>\n                      )}\n                    </td>\n\n                    <td className=\"px-4 py-2.5 text-center\">\n                      {getStatusBadge(row.status, row)}\n                    </td>\n\n                    {isDebugMode && (\n                      <td className=\"px-4 py-2.5 text-center\">\n                        <button\n                          onClick={() => onToggleExpandRow(rowKey)}\n                          className={cn(\n                            \"p-1.5 rounded-lg transition-all shadow-sm border active:scale-95\",\n                            isExpanded\n                              ? \"bg-amber-100 dark:bg-amber-900 text-amber-700 dark:text-amber-300 border-amber-200\"\n                              : \"bg-white dark:bg-slate-900 text-amber-600 dark:text-amber-300 border-slate-100 dark:border-slate-800 hover:bg-amber-50 dark:bg-amber-950\"\n                          )}\n                        >\n                          <Bug size={16} />\n                        </button>\n                      </td>\n                    )}\n\n                    <td className=\"px-4 py-2.5 text-right\">\n                      <div className=\"flex items-center justify-end gap-1.5 opacity-0 group-hover:opacity-100 transition-opacity focus-within:opacity-100\">\n                        {/* \n                          Confirm attendance button.\n                          - Always visible and enabled for every row (even empty/absent ones)\n                          - Opens a Confirm Modal for admins to review/edit before submitting\n                          - Color changes based on whether there's a pending adjustment request\n                        */}\n                        <button\n                          onClick={() => onConfirmClick(row, existingAdjustment)}\n                          disabled={isConfirming}\n                          className={cn(\n                            \"flex items-center justify-center p-1.5 rounded-lg transition-all shadow-sm border active:scale-95\",\n                            existingAdjustment\n                              ? \"bg-orange-50 dark:bg-orange-950 text-orange-600 dark:text-orange-300 border-orange-200 dark:border-orange-800 hover:bg-orange-100 dark:hover:bg-orange-900\"\n                              : \"bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-400 border-emerald-200 dark:border-emerald-800 hover:bg-emerald-100 dark:hover:bg-emerald-900\",\n                            isConfirming && \"opacity-70 cursor-wait\"\n                          )}\n                          title={existingAdjustment ? t(\"reports.confirm.pending_badge\") : t(\"common.attendance_confirm\")}\n                        >\n                          {isConfirming\n                            ? <RefreshCw size={14} className=\"animate-spin\" />\n                            : <CheckCircle size={14} />\n                          }\n                        </button>\n\n                        {/* Reprocess button */}\n                        <button\n                          onClick={() => onReprocessClick(row)}\n                          disabled={isReprocessing}\n                          className=\"p-1.5 bg-white dark:bg-slate-900 text-blue-600 dark:text-blue-300 hover:bg-blue-50 dark:hover:bg-slate-800 rounded-lg shadow-sm border border-slate-200 dark:border-slate-700 transition-all active:scale-95 disabled:opacity-50\"\n                          title={t(\"reports.reprocess.tooltip\")}\n                        >\n                          <RefreshCw size={18} className={cn(isReprocessing && \"animate-spin\")} />\n                        </button>\n                      </div>\n                    </td>\n                  </tr>\n\n                  {isDebugMode && isExpanded && (\n                    <tr className=\"bg-slate-900/5 animate-in slide-in-from-top-2 duration-500\">\n                      <td colSpan={10} className=\"px-10 py-10\">\n                        <div className=\"bg-slate-900 rounded-[3rem] p-10 shadow-2xl border-2 border-amber-200/20 overflow-hidden relative\">\n                          <div className=\"flex items-center gap-4 mb-8 border-b border-white/10 pb-6 relative z-10\">\n                            <div className=\"w-10 h-10 rounded-xl bg-amber-50 dark:bg-amber-950/10 flex items-center justify-center text-amber-400 shadow-inner border border-amber-500/20\">\n                              <Bug size={20} />\n                            </div>\n                            <div>\n                              <h4 className=\"text-[10px] font-bold text-amber-400 uppercase tracking-[0.3em]\">\n                                Audit Trail Analysis\n                              </h4>\n                              <p className=\"text-[9px] text-white/40 uppercase tracking-widest mt-1 font-bold\">\n                                BSON Traceability Metadata — Real-time Evaluator Logs\n                              </p>\n                            </div>\n                          </div>\n                          <pre className=\"text-[11px] font-mono text-emerald-400 leading-relaxed overflow-x-auto custom-scrollbar relative z-10 p-2 selection:bg-emerald-50 dark:bg-emerald-950/20 max-h-[400px]\">\n                            {JSON.stringify(\n                              row.generation_metadata || { message: \"No metadata available\" },\n                              null,\n                              2\n                            )}\n                          </pre>\n                          <Bug className=\"absolute -right-16 -bottom-16 w-64 h-64 text-amber-500 opacity-5 -rotate-12 pointer-events-none\" />\n                        </div>\n                      </td>\n                    </tr>\n                  )}\n                </React.Fragment>\n              );\n            })\n          )}\n        </tbody>\n      </table>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/reports/EmployeeDailyDrawer.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Link' is defined but never used. Allowed unused vars must match /^_/u.","line":4,"column":10,"nodeType":"Identifier","messageId":"unusedVar","endLine":4,"endColumn":14,"suggestions":[{"messageId":"removeUnusedImportDeclaration","data":{"varName":"Link"},"fix":{"range":[167,214],"text":""},"desc":"Remove unused import declaration."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'User' is defined but never used. Allowed unused vars must match /^_/u.","line":5,"column":41,"nodeType":"Identifier","messageId":"unusedVar","endLine":5,"endColumn":45,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"User"},"fix":{"range":[252,258],"text":""},"desc":"Remove unused variable \"User\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Loader2' is defined but never used. Allowed unused vars must match /^_/u.","line":5,"column":71,"nodeType":"Identifier","messageId":"unusedVar","endLine":5,"endColumn":78,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Loader2"},"fix":{"range":[282,291],"text":""},"desc":"Remove unused variable \"Loader2\"."}]},{"ruleId":"import-x/order","severity":2,"message":"`@/components/ui/Modal` import should occur before import of `@/components/ui/Sheet`","line":31,"column":1,"nodeType":"ImportDeclaration","messageId":"order","endLine":31,"endColumn":43,"fix":{"range":[482,1179],"text":"import Modal from \"@/components/ui/Modal\";\nimport Sheet from \"@/components/ui/Sheet\";\nimport { useToast } from \"@/components/ui/Toast\";\n\nimport { useDebug } from \"@/context/DebugContext\";\nimport { useDateTimeFormatter } from \"@/hooks/use-datetime\";\nimport { useInfiniteScroll } from \"@/hooks/use-infinite-scroll\";\nimport {\n    fetchAttendanceReport,\n    DailyAttendanceReport,\n    reprocessAttendance,\n    fetchWorkspaceAttendanceAdjustments,\n    adminConfirmAttendance,\n    AttendanceAdjustmentRequest,\n    approveOt,\n    fetchRawAttendanceLogs,\n    RawAttendanceLog,\n    fetchShifts,\n    upsertRoster,\n    Shift,\n} from \"@/lib/api\";\nimport { formatUnitsToHours } from \"@/lib/utils/attendance\";\n\n"}}],"suppressedMessages":[{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/workspace/webdashboard/src/components/features/reports/EmployeeDailyDrawer.tsx:65:35\n  63 |     // Reset to daily tab whenever the drawer is (re-)opened\n  64 |     // eslint-disable-next-line react-hooks/set-state-in-effect -- intentional: reset derived state on prop change\n> 65 |     useEffect(() => { if (isOpen) setViewMode(\"daily\"); }, [isOpen]);\n     |                                   ^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  66 |\n  67 |     // Keyboard navigation for tabs + scroll\n  68 |     useEffect(() => {","line":65,"column":35,"nodeType":null,"endLine":65,"endColumn":46,"suppressions":[{"kind":"directive","justification":"intentional: reset derived state on prop change"}]}],"errorCount":4,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":1,"fixableWarningCount":0,"source":"import React, { useState, useMemo, useEffect, useRef } from \"react\";\n\nimport { useQuery, useMutation, useQueryClient, useInfiniteQuery } from \"@tanstack/react-query\";\nimport { Link } from \"@tanstack/react-router\";\nimport { RefreshCw, Check, CheckCircle, User, CalendarCheck, SearchX, Loader2, FileBarChart, AlertTriangle, Clock  } from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport InfiniteScrollSentinel from \"@/components/common/InfiniteScrollSentinel\";\nimport Sheet from \"@/components/ui/Sheet\";\nimport { useToast } from \"@/components/ui/Toast\";\n\nimport { useDebug } from \"@/context/DebugContext\";\nimport { useDateTimeFormatter } from \"@/hooks/use-datetime\";\nimport { useInfiniteScroll } from \"@/hooks/use-infinite-scroll\";\nimport {\n    fetchAttendanceReport,\n    DailyAttendanceReport,\n    reprocessAttendance,\n    fetchWorkspaceAttendanceAdjustments,\n    adminConfirmAttendance,\n    AttendanceAdjustmentRequest,\n    approveOt,\n    fetchRawAttendanceLogs,\n    RawAttendanceLog,\n    fetchShifts,\n    upsertRoster,\n    Shift,\n} from \"@/lib/api\";\nimport { formatUnitsToHours } from \"@/lib/utils/attendance\";\n\nimport Modal from \"@/components/ui/Modal\";\n\nimport DailyReportTable from \"./DailyReportTable\";\n\ninterface EmployeeDailyDrawerProps {\n    isOpen: boolean;\n    onClose: () => void;\n    workspaceId: string;\n    employeeId: string;\n    employeeName: string;\n    dateRange: { start: string; end: string };\n    workUnitMinutes: number;\n}\n\nexport default function EmployeeDailyDrawer({\n    isOpen,\n    onClose,\n    workspaceId,\n    employeeId,\n    employeeName,\n    dateRange,\n    workUnitMinutes,\n}: EmployeeDailyDrawerProps) {\n    const { t } = useTranslation();\n    const { formatDate, formatTime } = useDateTimeFormatter();\n    const queryClient = useQueryClient();\n    const { isEnabled: isDebugMode } = useDebug();\n    const toast = useToast();\n\n    const [viewMode, setViewMode] = useState<\"daily\" | \"raw\">(\"daily\");\n    const contentRef = useRef<HTMLDivElement>(null);\n\n    // Reset to daily tab whenever the drawer is (re-)opened\n    // eslint-disable-next-line react-hooks/set-state-in-effect -- intentional: reset derived state on prop change\n    useEffect(() => { if (isOpen) setViewMode(\"daily\"); }, [isOpen]);\n\n    // Keyboard navigation for tabs + scroll\n    useEffect(() => {\n        if (!isOpen) return;\n\n        const handleKeyDown = (e: KeyboardEvent) => {\n            // Do not handle if typing in an input\n            if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) {\n                return;\n            }\n\n            if (e.key === \"ArrowRight\" && viewMode === \"daily\") {\n                setViewMode(\"raw\");\n            } else if (e.key === \"ArrowLeft\" && viewMode === \"raw\") {\n                setViewMode(\"daily\");\n            } else if (e.key === \"ArrowDown\" || e.key === \"ArrowUp\") {\n                e.preventDefault();\n                const scrollContainer = contentRef.current?.querySelector(\".overflow-auto\") || contentRef.current;\n                if (scrollContainer) {\n                    scrollContainer.scrollBy({ top: e.key === \"ArrowDown\" ? 100 : -100, behavior: \"smooth\" });\n                }\n            }\n        };\n\n        window.addEventListener(\"keydown\", handleKeyDown);\n        return () => window.removeEventListener(\"keydown\", handleKeyDown);\n    }, [isOpen, viewMode]);\n\n    const [expandedDebugRows, setExpandedDebugRows] = useState<Set<string>>(new Set());\n    const [reprocessingRow, setReprocessingRow] = useState<string | null>(null);\n    const [confirmingRow, setConfirmingRow] = useState<string | null>(null);\n    const [confirmDialog, setConfirmDialog] = useState<{\n        show: boolean;\n        employeeId: string;\n        employeeName: string;\n        date: string;\n    } | null>(null);\n    const [confirmModal, setConfirmModal] = useState<{\n        row: DailyAttendanceReport;\n        existingRequest?: AttendanceAdjustmentRequest;\n        punchIn: string;\n        punchOut: string;\n        reason: string;\n    } | null>(null);\n    const [resolveModal, setResolveModal] = useState<{\n        row: DailyAttendanceReport;\n        selectedShiftId: string;\n    } | null>(null);\n\n    // Fetch daily data for this single employee\n    const { data: reportResponse, isLoading } = useQuery({\n        queryKey: [\"attendance-report\", workspaceId, dateRange, \"daily\", 1, 100, undefined, [employeeId]],\n        queryFn: () =>\n            fetchAttendanceReport(workspaceId, dateRange.start, dateRange.end, \"daily\", 1, 100, undefined, [employeeId]),\n        enabled: isOpen && !!workspaceId && !!employeeId,\n    });\n\n    const { data: pendingAdjustments } = useQuery({\n        queryKey: [\"attendance-adjustments\", workspaceId, \"pending\"],\n        queryFn: () => fetchWorkspaceAttendanceAdjustments(workspaceId, \"pending\"),\n        enabled: isOpen && !!workspaceId,\n    });\n\n    // Fetch shift types for the unscheduled resolution modal\n    const { data: shifts } = useQuery({\n        queryKey: [\"shifts\", workspaceId],\n        queryFn: () => fetchShifts(workspaceId),\n        enabled: isOpen && !!workspaceId,\n    });\n\n    // Fetch raw logs for this single employee with infinite scroll\n    const {\n        data: rawLogsResponse,\n        isLoading: rawLogsLoading,\n        fetchNextPage,\n        hasNextPage,\n        isFetchingNextPage\n    } = useInfiniteQuery({\n        queryKey: [\"raw-logs\", workspaceId, dateRange, [employeeId]],\n        queryFn: ({ pageParam }) => {\n            const from = dateRange.start ? new Date(`${dateRange.start}T00:00:00`).toISOString() : undefined;\n            const to = dateRange.end ? new Date(`${dateRange.end}T23:59:59`).toISOString() : undefined;\n            return fetchRawAttendanceLogs({ employee_id: employeeId, from, to, page: pageParam as number, limit: 100 });\n        },\n        getNextPageParam: (lastPage, allPages) => {\n            if (!lastPage.data || lastPage.data.length < 100) return undefined;\n            return allPages.length + 1;\n        },\n        initialPageParam: 1,\n        enabled: isOpen && !!workspaceId && !!employeeId && viewMode === \"raw\",\n    });\n\n    // Extract flat array of logs\n    const rawLogsData = useMemo(() => {\n        if (!rawLogsResponse) return [];\n        return rawLogsResponse.pages.flatMap((p) => p.data || []);\n    }, [rawLogsResponse]);\n\n    const loadMoreRef = useInfiniteScroll<HTMLTableRowElement>({\n        hasNextPage,\n        isFetchingNextPage,\n        fetchNextPage,\n    });\n\n    const adjustmentMap = useMemo(() => {\n        const map: Record<string, AttendanceAdjustmentRequest> = {};\n        pendingAdjustments?.forEach((req) => {\n            const key = `${req.employee_id}-${req.requested_date}`;\n            map[key] = req;\n        });\n        return map;\n    }, [pendingAdjustments]);\n\n    const reportData = useMemo(\n        () => reportResponse?.data || (Array.isArray(reportResponse) ? reportResponse : []),\n        [reportResponse]\n    );\n\n    // Compute total hours for summary bar\n    const { totalStdHours, totalOtHours } = useMemo(() => {\n        const stdUnits = reportData.reduce((sum: number, r: DailyAttendanceReport) => sum + (r.std_work_units || 0), 0);\n        const otUnits = reportData.reduce((sum: number, r: DailyAttendanceReport) => sum + (r.ot_work_units || 0), 0);\n        return {\n            totalStdHours: formatUnitsToHours(stdUnits, workUnitMinutes),\n            totalOtHours: formatUnitsToHours(otUnits, workUnitMinutes),\n        };\n    }, [reportData, workUnitMinutes]);\n\n    const toggleExpandRow = (rowKey: string) => {\n        const next = new Set(expandedDebugRows);\n        if (next.has(rowKey)) next.delete(rowKey);\n        else next.add(rowKey);\n        setExpandedDebugRows(next);\n    };\n\n    // Reprocess mutation\n    const reprocessMutation = useMutation({\n        mutationFn: ({ empId, date }: { empId: string; date: string }) =>\n            reprocessAttendance(workspaceId, empId, date, date),\n        onSuccess: () => {\n            queryClient.invalidateQueries({ queryKey: [\"attendance-report\"] });\n            setReprocessingRow(null);\n            setConfirmDialog(null);\n            toast.success(t(\"common.success\"));\n        },\n    });\n\n    // Confirm mutation\n    const confirmMutation = useMutation({\n        mutationFn: ({\n            row,\n            existingRequestId,\n            reason,\n        }: {\n            row: DailyAttendanceReport;\n            existingRequestId?: string;\n            reason?: string;\n        }) => adminConfirmAttendance(workspaceId, row, existingRequestId, reason),\n        onSuccess: () => {\n            queryClient.invalidateQueries({ queryKey: [\"attendance-report\"] });\n            queryClient.invalidateQueries({ queryKey: [\"attendance-adjustments\"] });\n            setConfirmingRow(null);\n            setConfirmModal(null);\n            toast.success(t(\"reports.confirm.success\"));\n        },\n        onError: () => {\n            setConfirmingRow(null);\n            toast.error(t(\"reports.confirm.error\"));\n        },\n    });\n\n    // OT approve mutation\n    const approveOtMutation = useMutation({\n        mutationFn: ({ row, action }: { row: DailyAttendanceReport; action: \"approved\" | \"rejected\" }) =>\n            approveOt(workspaceId, row.employee_id, {\n                date: row.date,\n                approved_minutes: row.ot_work_units * (workUnitMinutes || 60),\n                status: action,\n            }),\n        onSuccess: (_data, variables) => {\n            queryClient.invalidateQueries({ queryKey: [\"attendance-report\"] });\n            const msg =\n                variables.action === \"approved\"\n                    ? t(\"reports.ot_approve.success_approved\")\n                    : t(\"reports.ot_approve.success_rejected\");\n            toast.success(msg);\n        },\n        onError: () => {\n            toast.error(t(\"reports.ot_approve.error\"));\n        },\n    });\n\n    // Resolve unscheduled mutation: upsert roster + reprocess\n    const resolveUnscheduledMutation = useMutation({\n        mutationFn: async ({ row, shiftId }: { row: DailyAttendanceReport; shiftId: string }) => {\n            // Step 1: Assign the shift to this day\n            await upsertRoster(workspaceId, row.employee_id, {\n                date: row.date,\n                shift_id: shiftId,\n            });\n            // Step 2: Reprocess to recalculate attendance with the new shift\n            await reprocessAttendance(workspaceId, row.employee_id, row.date, row.date);\n        },\n        onSuccess: () => {\n            queryClient.invalidateQueries({ queryKey: [\"attendance-report\"] });\n            setResolveModal(null);\n            toast.success(t(\"reports.unscheduled.success\"));\n        },\n        onError: () => {\n            toast.error(t(\"reports.unscheduled.error\"));\n        },\n    });\n\n    const handleApproveOt = (row: DailyAttendanceReport, action: \"approved\" | \"rejected\") => {\n        approveOtMutation.mutate({ row, action });\n    };\n\n    const handleResolveUnscheduled = (row: DailyAttendanceReport) => {\n        setResolveModal({ row, selectedShiftId: \"\" });\n    };\n\n    const handleResolveSubmit = () => {\n        if (!resolveModal || !resolveModal.selectedShiftId) return;\n        resolveUnscheduledMutation.mutate({\n            row: resolveModal.row,\n            shiftId: resolveModal.selectedShiftId,\n        });\n    };\n\n    const handleReprocessClick = (row: DailyAttendanceReport) => {\n        setConfirmDialog({\n            show: true,\n            employeeId: row.employee_id,\n            employeeName: row.employee_name,\n            date: row.date,\n        });\n    };\n\n    const handleConfirmReprocess = () => {\n        if (!confirmDialog) return;\n        setReprocessingRow(`${confirmDialog.employeeId}-${confirmDialog.date}`);\n        reprocessMutation.mutate({ empId: confirmDialog.employeeId, date: confirmDialog.date });\n    };\n\n    const handleConfirmClick = (row: DailyAttendanceReport, existing?: AttendanceAdjustmentRequest) => {\n        const utcToLocalHHmm = (iso: string | null | undefined): string => {\n            if (!iso) return \"\";\n            const d = new Date(iso);\n            if (isNaN(d.getTime())) {\n                return iso.substring(0, 5);\n            }\n            return `${String(d.getHours()).padStart(2, \"0\")}:${String(d.getMinutes()).padStart(2, \"0\")}`;\n        };\n\n        const punchIn =\n            utcToLocalHHmm(existing?.requested_punch_in_time) ||\n            utcToLocalHHmm(row.actual_punch_in) ||\n            row.scheduled_start?.substring(0, 5) ||\n            \"\";\n        const punchOut =\n            utcToLocalHHmm(existing?.requested_punch_out_time) ||\n            utcToLocalHHmm(row.actual_punch_out) ||\n            row.scheduled_end?.substring(0, 5) ||\n            \"\";\n        const reason = existing?.reason || \"\";\n        setConfirmModal({ row, existingRequest: existing, punchIn, punchOut, reason });\n    };\n\n    const handleConfirmSubmit = () => {\n        if (!confirmModal) return;\n        const { row, existingRequest } = confirmModal;\n        const rowKey = `${row.employee_id}-${row.date}`;\n        setConfirmingRow(rowKey);\n\n        if (existingRequest) {\n            confirmMutation.mutate({ row, existingRequestId: existingRequest.id });\n        } else {\n            const createIsoFromLocal = (dateStr: string, hhmm: string): string | null => {\n                if (!hhmm) return null;\n                const [y, m, d] = dateStr.split(\"-\").map(Number);\n                const [hours, mins] = hhmm.split(\":\").map(Number);\n                return new Date(y, m - 1, d, hours, mins, 0).toISOString();\n            };\n\n            const modifiedRow = {\n                ...row,\n                actual_punch_in: createIsoFromLocal(row.date, confirmModal.punchIn),\n                actual_punch_out: createIsoFromLocal(row.date, confirmModal.punchOut),\n            };\n            confirmMutation.mutate({ row: modifiedRow as DailyAttendanceReport, reason: confirmModal.reason });\n        }\n    };\n\n    return (\n        <>\n            <Sheet\n                isOpen={isOpen}\n                onClose={onClose}\n                title={employeeName}\n                subtitle={`${formatDate(dateRange.start)} — ${formatDate(dateRange.end)}`}\n                className=\"w-[95vw] xl:w-[1200px] !max-w-[95vw]\"\n                contentClassName=\"!overflow-hidden\"\n                headerExtra={\n                    <>\n                        <div className=\"flex bg-slate-100 dark:bg-slate-800 rounded-lg p-1 border border-slate-200 dark:border-slate-700\">\n                            <button\n                                onClick={() => setViewMode(\"daily\")}\n                                className={`px-3 py-1.5 text-[10px] font-bold uppercase tracking-widest rounded-md transition-all ${viewMode === \"daily\"\n                                    ? \"bg-white dark:bg-slate-700 text-primary-600 dark:text-primary-400 shadow-sm\"\n                                    : \"text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200\"\n                                    }`}\n                            >\n                                {t(\"reports.tabs.daily\")}\n                            </button>\n                            <button\n                                onClick={() => setViewMode(\"raw\")}\n                                className={`px-3 py-1.5 text-[10px] font-bold uppercase tracking-widest rounded-md transition-all ${viewMode === \"raw\"\n                                    ? \"bg-white dark:bg-slate-700 text-primary-600 dark:text-primary-400 shadow-sm\"\n                                    : \"text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200\"\n                                    }`}\n                            >\n                                <span className=\"flex items-center gap-1.5\"><CalendarCheck size={12} /> {t(\"reports.view_raw_logs\")}</span>\n                            </button>\n                        </div>\n                        {viewMode === \"daily\" && !isLoading && reportData.length > 0 && (\n                            <>\n                                <div className=\"flex items-center gap-1.5 bg-slate-900 dark:bg-slate-800 px-3 py-1.5 rounded-lg border border-slate-800 dark:border-slate-700 shadow-sm\">\n                                    <FileBarChart size={12} className=\"text-primary-400\" />\n                                    <span className=\"text-[9px] font-bold text-slate-400 uppercase tracking-widest\">{t(\"reports.quick_stats.std_hours\")}</span>\n                                    <span className=\"font-mono font-bold text-white text-xs tracking-tighter\">{totalStdHours}h</span>\n                                </div>\n                                {Number(totalOtHours) > 0 && (\n                                    <div className=\"flex items-center gap-1.5 bg-gradient-to-r from-orange-900 to-orange-950 px-3 py-1.5 rounded-lg border border-orange-800 shadow-sm\">\n                                        <Clock size={12} className=\"text-orange-400\" />\n                                        <span className=\"text-[9px] font-bold text-orange-400/70 uppercase tracking-widest\">{t(\"reports.quick_stats.ot_hours\")}</span>\n                                        <span className=\"font-mono font-bold text-orange-100 text-xs tracking-tighter\">{totalOtHours}h</span>\n                                    </div>\n                                )}\n                            </>\n                        )}\n                    </>\n                }\n            >\n                <div ref={contentRef} className=\"-mx-10 -mt-4 -mb-10 h-[calc(100%+theme(spacing.14))] flex flex-col\">\n                    {viewMode === \"raw\" ? (\n                        <div className=\"overflow-auto flex-1 min-h-0 relative\">\n                            <table className=\"w-full text-left border-collapse\">\n                                <thead>\n                                    <tr className=\"bg-slate-50/95 dark:bg-slate-800/95 backdrop-blur-sm border-b border-slate-100 dark:border-slate-800 sticky top-0 z-10\">\n                                        <th className=\"px-8 py-4 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">{t(\"common.time\")}</th>\n                                        <th className=\"px-8 py-4 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">{t(\"common.source\")}</th>\n                                        <th className=\"px-8 py-4 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest text-right\">{t(\"common.status\")}</th>\n                                    </tr>\n                                </thead>\n                                <tbody className=\"divide-y divide-slate-50 dark:divide-slate-800\">\n                                    {rawLogsLoading ? (\n                                        Array.from({ length: 5 }).map((_, i) => (\n                                            <tr key={`skeleton-log-${i}`} className=\"border-b border-slate-50 dark:border-slate-800/50\">\n                                                <td className=\"px-8 py-5\">\n                                                    <div className=\"flex items-center gap-4\">\n                                                        <div className=\"w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-800 animate-pulse\"></div>\n                                                        <div className=\"space-y-1\">\n                                                            <div className=\"h-4 w-20 bg-slate-200 dark:bg-slate-700 animate-pulse rounded\"></div>\n                                                            <div className=\"h-3 w-16 bg-slate-100 dark:bg-slate-800 animate-pulse rounded\"></div>\n                                                        </div>\n                                                    </div>\n                                                </td>\n                                                <td className=\"px-8 py-5\">\n                                                    <div className=\"h-4 w-24 bg-slate-200 dark:bg-slate-700 animate-pulse rounded\"></div>\n                                                </td>\n                                                <td className=\"px-8 py-5 text-right\">\n                                                    <div className=\"flex justify-end\">\n                                                        <div className=\"h-4 w-16 bg-emerald-100 dark:bg-emerald-900/20 animate-pulse rounded-full\"></div>\n                                                    </div>\n                                                </td>\n                                            </tr>\n                                        ))\n                                    ) : rawLogsData.length === 0 ? (\n                                        <tr>\n                                            <td colSpan={3} className=\"px-8 py-20\">\n                                                <div className=\"flex flex-col items-center justify-center text-center animate-in fade-in zoom-in-95 duration-500 max-w-sm mx-auto\">\n                                                    <div className=\"w-16 h-16 mb-4 rounded-3xl bg-slate-50 dark:bg-slate-800/80 flex items-center justify-center text-slate-300 dark:text-slate-600 shadow-inner border border-slate-100 dark:border-slate-700/50 rotate-3\">\n                                                        <SearchX size={24} className=\"-rotate-3\" />\n                                                    </div>\n                                                    <h3 className=\"text-xs font-bold text-slate-700 dark:text-slate-200 uppercase tracking-widest mb-1\">\n                                                        {t(\"attendance_logs.messages.no_data\")}\n                                                    </h3>\n                                                    <p className=\"text-[10px] font-medium text-slate-500 dark:text-slate-400 max-w-[200px]\">\n                                                        No punches were recorded for this day.\n                                                    </p>\n                                                </div>\n                                            </td>\n                                        </tr>\n                                    ) : (\n                                        rawLogsData.map((log: RawAttendanceLog) => (\n                                            <tr key={log.id} className=\"hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors group\">\n                                                <td className=\"px-8 py-5\">\n                                                    <div className=\"flex items-center gap-4\">\n                                                        <div className=\"w-10 h-10 rounded-xl bg-primary-50 dark:bg-primary-950 flex items-center justify-center text-primary-600 dark:text-primary-400 shadow-inner border border-primary-100 dark:border-primary-800/50\"><Clock size={18} /></div>\n                                                        <div>\n                                                            <div className=\"font-bold text-slate-700 dark:text-slate-200 text-sm tracking-tight uppercase\">{formatDate(log.punch_time)}</div>\n                                                            <div className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 font-mono uppercase tracking-tighter\">{formatTime(log.punch_time)}</div>\n                                                        </div>\n                                                    </div>\n                                                </td>\n                                                <td className=\"px-8 py-5\">\n                                                    <div className=\"flex flex-col gap-1\">\n                                                        <div className=\"flex items-center gap-2\">\n                                                            <span className=\"px-2.5 py-1 bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 rounded-lg text-[9px] font-bold uppercase tracking-widest border border-slate-200 dark:border-slate-700\">{log.source}</span>\n                                                            {log.device_name && (\n                                                                <span className=\"text-[10px] font-bold text-slate-700 dark:text-slate-200 uppercase\">{log.device_name}</span>\n                                                            )}\n                                                        </div>\n                                                    </div>\n                                                </td>\n                                                <td className=\"px-8 py-5 text-right\">\n                                                    <span className=\"px-3 py-1 bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-300 rounded-full text-[9px] font-bold uppercase tracking-widest border border-emerald-100 dark:border-emerald-800 shadow-sm\">{t(\"attendance_logs.status.recorded\")}</span>\n                                                </td>\n                                            </tr>\n                                        ))\n                                    )}\n                                    {hasNextPage && (\n                                        <InfiniteScrollSentinel sentinelRef={loadMoreRef} isFetchingNextPage={isFetchingNextPage} colSpan={3} />\n                                    )}\n                                </tbody>\n                            </table>\n                        </div>\n                    ) : (\n                        <DailyReportTable\n                            data={reportData}\n                            isLoading={isLoading}\n                            workUnitMinutes={workUnitMinutes}\n                            isDebugMode={isDebugMode}\n                            expandedDebugRows={expandedDebugRows}\n                            reprocessingRow={reprocessingRow}\n                            confirmingRow={confirmingRow}\n                            adjustmentMap={adjustmentMap}\n                            t={t}\n                            formatDate={formatDate}\n                            formatTime={formatTime}\n                            onToggleExpandRow={toggleExpandRow}\n                            onReprocessClick={handleReprocessClick}\n                            onConfirmClick={handleConfirmClick}\n                            onApproveOt={handleApproveOt}\n                            onResolveUnscheduled={handleResolveUnscheduled}\n                            hideEmployeeName\n                        />\n                    )}\n                </div>\n            </Sheet>\n\n            {/* Reprocess Confirmation Modal */}\n            <Modal\n                isOpen={!!confirmDialog}\n                onClose={() => !reprocessMutation.isPending && setConfirmDialog(null)}\n                title={t(\"reports.reprocess.confirm_title\")}\n                icon={<RefreshCw size={24} />}\n                maxWidth=\"md\"\n            >\n                <div className=\"space-y-10 pt-4 animate-in fade-in duration-500\">\n                    <div className=\"p-8 bg-slate-50 dark:bg-slate-800 rounded-[2.5rem] border border-slate-100 dark:border-slate-800 shadow-inner\">\n                        <p className=\"text-base font-bold text-slate-700 dark:text-slate-200 uppercase tracking-tight leading-relaxed text-center italic opacity-80\">\n                            \"\n                            {confirmDialog &&\n                                t(\"reports.reprocess.confirm_message\", {\n                                    employee: confirmDialog.employeeName,\n                                    date: formatDate(confirmDialog.date),\n                                })}\n                            \"\n                        </p>\n                    </div>\n                    <div className=\"flex gap-6 border-t border-slate-50 dark:border-slate-800 pt-2\">\n                        <button\n                            onClick={() => setConfirmDialog(null)}\n                            className=\"flex-1 px-8 py-4 rounded-2xl font-bold text-xs uppercase tracking-widest text-slate-500 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-all active:scale-95\"\n                            disabled={reprocessMutation.isPending}\n                        >\n                            {t(\"common.cancel\")}\n                        </button>\n                        <button\n                            onClick={handleConfirmReprocess}\n                            disabled={reprocessMutation.isPending}\n                            className=\"flex-[1.5] bg-slate-900 hover:bg-primary-700 text-white font-bold px-8 py-4 rounded-2xl flex items-center justify-center gap-4 transition-all active:scale-95 disabled:opacity-50 shadow-2xl shadow-slate-400 dark:shadow-black/40 text-xs uppercase tracking-widest\"\n                        >\n                            {reprocessMutation.isPending ? (\n                                <RefreshCw className=\"w-5 h-5 animate-spin\" />\n                            ) : (\n                                <Check size={20} />\n                            )}{\" \"}\n                            {t(\"reports.reprocess.confirm\").toUpperCase()}\n                        </button>\n                    </div>\n                </div>\n            </Modal>\n\n            {/* Confirm Attendance Modal */}\n            <Modal\n                isOpen={!!confirmModal}\n                onClose={() => !confirmMutation.isPending && setConfirmModal(null)}\n                title={t(\"reports.confirm.modal_title\")}\n                subtitle={t(\"reports.confirm.modal_subtitle\")}\n                icon={<CheckCircle size={24} />}\n                maxWidth=\"md\"\n            >\n                {confirmModal && (\n                    <div className=\"space-y-6 pt-2 animate-in fade-in duration-500\">\n                        {/* Employee & Date info */}\n                        <div className=\"grid grid-cols-2 gap-4 p-5 bg-slate-50 dark:bg-slate-800 rounded-2xl border border-slate-100 dark:border-slate-800\">\n                            <div>\n                                <label className=\"text-[9px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">\n                                    {t(\"reports.confirm.employee\")}\n                                </label>\n                                <p className=\"text-sm font-bold text-slate-700 dark:text-slate-200 mt-1\">\n                                    {confirmModal.row.employee_name}\n                                </p>\n                            </div>\n                            <div>\n                                <label className=\"text-[9px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">\n                                    {t(\"reports.confirm.date\")}\n                                </label>\n                                <p className=\"text-sm font-bold text-slate-700 dark:text-slate-200 mt-1\">\n                                    {formatDate(confirmModal.row.date)}\n                                </p>\n                            </div>\n                        </div>\n\n                        {/* Existing request banner */}\n                        {confirmModal.existingRequest && (\n                            <div className=\"p-4 bg-orange-50 dark:bg-orange-950 rounded-2xl border border-orange-200 dark:border-orange-800\">\n                                <p className=\"text-xs font-bold text-orange-600 dark:text-orange-300 uppercase tracking-wider\">\n                                    {t(\"reports.confirm.existing_request\")}\n                                </p>\n                                {confirmModal.existingRequest.reason && (\n                                    <p className=\"text-sm text-orange-700 dark:text-orange-200 mt-2 italic\">\n                                        &ldquo;{confirmModal.existingRequest.reason}&rdquo;\n                                    </p>\n                                )}\n                            </div>\n                        )}\n\n                        {/* Punch In / Out */}\n                        <div className=\"grid grid-cols-2 gap-4\">\n                            <div>\n                                <label className=\"text-[9px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest mb-2 block\">\n                                    {t(\"reports.confirm.punch_in\")}\n                                </label>\n                                <input\n                                    type=\"time\"\n                                    value={confirmModal.punchIn}\n                                    onChange={(e) => setConfirmModal({ ...confirmModal, punchIn: e.target.value })}\n                                    disabled={!!confirmModal.existingRequest}\n                                    className=\"w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-sm font-mono font-bold text-slate-700 dark:text-slate-200 focus:ring-2 focus:ring-primary-500 focus:border-transparent disabled:opacity-50 disabled:cursor-not-allowed\"\n                                />\n                            </div>\n                            <div>\n                                <label className=\"text-[9px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest mb-2 block\">\n                                    {t(\"reports.confirm.punch_out\")}\n                                </label>\n                                <input\n                                    type=\"time\"\n                                    value={confirmModal.punchOut}\n                                    onChange={(e) => setConfirmModal({ ...confirmModal, punchOut: e.target.value })}\n                                    disabled={!!confirmModal.existingRequest}\n                                    className=\"w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-sm font-mono font-bold text-slate-700 dark:text-slate-200 focus:ring-2 focus:ring-primary-500 focus:border-transparent disabled:opacity-50 disabled:cursor-not-allowed\"\n                                />\n                            </div>\n                        </div>\n\n                        {/* Reason */}\n                        {!confirmModal.existingRequest && (\n                            <div>\n                                <label className=\"text-[9px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest mb-2 block\">\n                                    {t(\"reports.confirm.reason\")}\n                                </label>\n                                <input\n                                    type=\"text\"\n                                    value={confirmModal.reason}\n                                    onChange={(e) => setConfirmModal({ ...confirmModal, reason: e.target.value })}\n                                    placeholder={t(\"reports.confirm.reason_placeholder\")}\n                                    className=\"w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-sm text-slate-700 dark:text-slate-200 focus:ring-2 focus:ring-primary-500 focus:border-transparent\"\n                                />\n                            </div>\n                        )}\n\n                        {/* Buttons */}\n                        <div className=\"flex gap-4 border-t border-slate-100 dark:border-slate-800 pt-4\">\n                            <button\n                                onClick={() => setConfirmModal(null)}\n                                className=\"flex-1 px-6 py-3.5 rounded-2xl font-bold text-xs uppercase tracking-widest text-slate-500 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-all active:scale-95\"\n                                disabled={confirmMutation.isPending}\n                            >\n                                {t(\"common.cancel\")}\n                            </button>\n                            <button\n                                onClick={handleConfirmSubmit}\n                                disabled={confirmMutation.isPending || (!confirmModal.existingRequest && !confirmModal.punchIn)}\n                                className=\"flex-[1.5] bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-6 py-3.5 rounded-2xl flex items-center justify-center gap-3 transition-all active:scale-95 disabled:opacity-50 shadow-xl text-xs uppercase tracking-widest\"\n                            >\n                                {confirmMutation.isPending ? (\n                                    <RefreshCw className=\"w-4 h-4 animate-spin\" />\n                                ) : (\n                                    <CheckCircle size={18} />\n                                )}\n                                {confirmModal.existingRequest ? t(\"reports.confirm.approve\") : t(\"reports.confirm.submit\")}\n                            </button>\n                        </div>\n                    </div>\n                )}\n            </Modal>\n\n            {/* Unscheduled Work Resolution Modal */}\n            <Modal\n                isOpen={!!resolveModal}\n                onClose={() => !resolveUnscheduledMutation.isPending && setResolveModal(null)}\n                title={t(\"reports.unscheduled.resolve_title\")}\n                icon={<AlertTriangle size={24} />}\n            >\n                {resolveModal && (\n                    <div className=\"space-y-6\">\n                        {/* Employee + Date info */}\n                        <div className=\"flex items-center gap-4 p-4 bg-amber-50 dark:bg-amber-950 rounded-2xl border border-amber-200 dark:border-amber-800\">\n                            <div className=\"w-10 h-10 rounded-xl bg-amber-100 dark:bg-amber-900 flex items-center justify-center text-amber-600 dark:text-amber-300 shadow-inner\">\n                                <AlertTriangle size={20} />\n                            </div>\n                            <div>\n                                <p className=\"text-sm font-bold text-amber-800 dark:text-amber-200\">\n                                    {resolveModal.row.employee_name}\n                                </p>\n                                <p className=\"text-xs font-mono font-bold text-amber-600 dark:text-amber-400 uppercase\">\n                                    {formatDate(resolveModal.row.date)}\n                                </p>\n                            </div>\n                        </div>\n\n                        {/* Punch times display */}\n                        {resolveModal.row.actual_punch_in && (\n                            <div className=\"grid grid-cols-2 gap-4\">\n                                <div className=\"p-3 bg-slate-50 dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700\">\n                                    <p className=\"text-[9px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest mb-1\">{t(\"reports.confirm.punch_in\")}</p>\n                                    <p className=\"font-mono font-bold text-sm text-slate-700 dark:text-slate-200\">{formatTime(resolveModal.row.actual_punch_in)}</p>\n                                </div>\n                                <div className=\"p-3 bg-slate-50 dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700\">\n                                    <p className=\"text-[9px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest mb-1\">{t(\"reports.confirm.punch_out\")}</p>\n                                    <p className=\"font-mono font-bold text-sm text-slate-700 dark:text-slate-200\">{formatTime(resolveModal.row.actual_punch_out)}</p>\n                                </div>\n                            </div>\n                        )}\n\n                        {/* Shift selector */}\n                        <div>\n                            <label className=\"text-[9px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest mb-2 block\">\n                                {t(\"reports.unscheduled.select_shift\")}\n                            </label>\n                            <select\n                                value={resolveModal.selectedShiftId}\n                                onChange={(e) => setResolveModal({ ...resolveModal, selectedShiftId: e.target.value })}\n                                className=\"w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-sm font-bold text-slate-700 dark:text-slate-200 focus:ring-2 focus:ring-primary-500 focus:border-transparent\"\n                            >\n                                <option value=\"\">-- {t(\"reports.unscheduled.select_shift\")} --</option>\n                                {(shifts || []).map((shift: Shift) => (\n                                    <option key={shift.id} value={shift.id}>\n                                        {shift.name} ({shift.start_time?.substring(0, 5)} — {shift.end_time?.substring(0, 5)})\n                                    </option>\n                                ))}\n                            </select>\n                        </div>\n\n                        {/* Explanation note */}\n                        <p className=\"text-[10px] text-slate-500 dark:text-slate-400 italic leading-relaxed\">\n                            {t(\"reports.unscheduled.resolve_subtitle\")}\n                        </p>\n\n                        {/* Buttons */}\n                        <div className=\"flex gap-4 border-t border-slate-100 dark:border-slate-800 pt-4\">\n                            <button\n                                onClick={() => setResolveModal(null)}\n                                className=\"flex-1 px-6 py-3.5 rounded-2xl font-bold text-xs uppercase tracking-widest text-slate-500 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-all active:scale-95\"\n                                disabled={resolveUnscheduledMutation.isPending}\n                            >\n                                {t(\"common.cancel\")}\n                            </button>\n                            <button\n                                onClick={handleResolveSubmit}\n                                disabled={resolveUnscheduledMutation.isPending || !resolveModal.selectedShiftId}\n                                className=\"flex-[1.5] bg-amber-600 hover:bg-amber-700 text-white font-bold px-6 py-3.5 rounded-2xl flex items-center justify-center gap-3 transition-all active:scale-95 disabled:opacity-50 shadow-xl text-xs uppercase tracking-widest\"\n                            >\n                                {resolveUnscheduledMutation.isPending ? (\n                                    <RefreshCw className=\"w-4 h-4 animate-spin\" />\n                                ) : (\n                                    <CalendarCheck size={18} />\n                                )}\n                                {t(\"reports.unscheduled.submit\")}\n                            </button>\n                        </div>\n                    </div>\n                )}\n            </Modal>\n        </>\n    );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/reports/ReportExportDialog.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'X' is defined but never used. Allowed unused vars must match /^_/u.","line":4,"column":73,"nodeType":"Identifier","messageId":"unusedVar","endLine":4,"endColumn":74,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"X"},"fix":{"range":[166,169],"text":""},"desc":"Remove unused variable \"X\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'streamError' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":60,"column":12,"nodeType":"Identifier","messageId":"unusedVar","endLine":60,"endColumn":23}],"suppressedMessages":[{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/workspace/webdashboard/src/components/features/reports/ReportExportDialog.tsx:48:7\n  46 |     if (isOpen) {\n  47 |       // eslint-disable-next-line react-hooks/set-state-in-effect\n> 48 |       setPhase(\"idle\");\n     |       ^^^^^^^^ Avoid calling setState() directly within an effect\n  49 |       setJobId(null);\n  50 |       setError(null);\n  51 |       setTotalBatches(0);","line":48,"column":7,"nodeType":null,"endLine":48,"endColumn":15,"suppressions":[{"kind":"directive","justification":""}]},{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/workspace/webdashboard/src/components/features/reports/ReportExportDialog.tsx:115:7\n  113 |     if (pollingStatusValue === \"completed\" && phaseState !== \"completed\") {\n  114 |       // eslint-disable-next-line react-hooks/set-state-in-effect\n> 115 |       setPhase(\"completed\");\n      |       ^^^^^^^^ Avoid calling setState() directly within an effect\n  116 |     } else if (pollingStatusValue === \"failed\" && phaseState !== \"failed\") {\n  117 |       setPhase(\"failed\");\n  118 |       setError(pollingError || t(\"report_export.status.failed\"));","line":115,"column":7,"nodeType":null,"endLine":115,"endColumn":15,"suppressions":[{"kind":"directive","justification":""}]}],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState, useEffect } from \"react\";\n\nimport { useQuery } from \"@tanstack/react-query\";\nimport { Download, Loader2, CheckCircle2, AlertCircle, FileSpreadsheet, X } from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { useReportStream } from \"../../../hooks/use-report-stream\";\nimport {\n  createReportExportJob,\n  fetchExportJobStatus,\n  downloadExportReport,\n} from \"../../../lib/api/attendance\";\nimport { cn } from \"../../../lib/utils\";\nimport Modal from \"../../ui/Modal\";\n\ninterface ReportExportDialogProps {\n  isOpen: boolean;\n  onClose: () => void;\n  wsId: string;\n  startDate: string;\n  endDate: string;\n  reportType: \"summary\" | \"detail\";\n  employeeIds?: string[];\n}\n\ntype ExportPhase = \"idle\" | \"starting\" | \"polling\" | \"downloading\" | \"completed\" | \"failed\";\n\nexport default function ReportExportDialog({\n  isOpen,\n  onClose,\n  wsId,\n  startDate,\n  endDate,\n  reportType,\n  employeeIds,\n}: ReportExportDialogProps) {\n  const { t } = useTranslation();\n  const [phaseState, setPhase] = useState<ExportPhase>(\"idle\");\n  const [jobId, setJobId] = useState<string | null>(null);\n  const [error, setError] = useState<string | null>(null);\n  const [totalBatches, setTotalBatches] = useState(0);\n  const [useFallbackPolling, setUseFallbackPolling] = useState(false);\n\n  // Reset state when dialog opens\n  useEffect(() => {\n    if (isOpen) {\n      // eslint-disable-next-line react-hooks/set-state-in-effect\n      setPhase(\"idle\");\n      setJobId(null);\n      setError(null);\n      setTotalBatches(0);\n      setUseFallbackPolling(false);\n    }\n  }, [isOpen]);\n\n  // WebSocket streaming for real-time updates\n  const {\n    status: streamStatus,\n    progress: streamProgress,\n    error: streamError,\n  } = useReportStream({\n    jobId,\n    onComplete: () => {\n      console.debug(\"[ReportExport] Stream completed\");\n      setPhase(\"completed\");\n    },\n    onError: (message) => {\n      console.error(\"[ReportExport] Stream error:\", message);\n\n      // Check if max retries exceeded - fallback to polling\n      if (\n        message.includes(\"Max retries exceeded\") ||\n        message.includes(\"Connection lost\")\n      ) {\n        console.warn(\"[ReportExport] WebSocket failed, falling back to polling\");\n        setUseFallbackPolling(true);\n        setError(null); // Clear error, fallback will handle\n      } else {\n        setPhase(\"failed\");\n        setError(message);\n      }\n    },\n    maxRetries: 3,\n  });\n\n  // Calculate derived phase from stream status to avoid sync state updates\n  const phase = (() => {\n    if (jobId && !useFallbackPolling) {\n      if (streamStatus === \"connecting\") return \"starting\";\n      if (streamStatus === \"streaming\") return \"polling\";\n    }\n    return phaseState;\n  })();\n\n  // Fallback polling when WebSocket fails\n  const { data: pollingStatus } = useQuery({\n    queryKey: [\"export-job-fallback\", jobId],\n    queryFn: () => fetchExportJobStatus(wsId, jobId!),\n    enabled: !!jobId && useFallbackPolling && phase === \"polling\",\n    refetchInterval: (query) => {\n      const status = query.state.data?.status;\n      return status === \"processing\" || status === \"pending\" ? 2000 : false; // 2s (less aggressive)\n    },\n  });\n\n  const pollingStatusValue = pollingStatus?.status;\n  const pollingError = pollingStatus?.error;\n\n  // Handle fallback polling status\n  useEffect(() => {\n    if (!useFallbackPolling || !pollingStatus) return;\n\n    if (pollingStatusValue === \"completed\" && phaseState !== \"completed\") {\n      // eslint-disable-next-line react-hooks/set-state-in-effect\n      setPhase(\"completed\");\n    } else if (pollingStatusValue === \"failed\" && phaseState !== \"failed\") {\n      setPhase(\"failed\");\n      setError(pollingError || t(\"report_export.status.failed\"));\n    }\n  }, [pollingStatusValue, pollingError, useFallbackPolling, t, phaseState, pollingStatus]);\n\n  const handleStartExport = async () => {\n    setPhase(\"starting\");\n    setError(null);\n\n    try {\n      const response = await createReportExportJob(wsId, {\n        start_date: startDate,\n        end_date: endDate,\n        report_type: reportType,\n        employee_ids: employeeIds,\n      });\n\n      setJobId(response.job_id);\n      setTotalBatches(response.total_batches);\n      // Phase will be set automatically by useEffect watching streamStatus\n    } catch (err) {\n      setPhase(\"failed\");\n      setError(err instanceof Error ? err.message : t(\"report_export.status.failed\"));\n    }\n  };\n\n  const handleDownload = async () => {\n    if (!jobId) return;\n\n    setPhase(\"downloading\");\n    try {\n      const blob = await downloadExportReport(wsId, jobId);\n      const url = window.URL.createObjectURL(blob);\n      const a = document.createElement(\"a\");\n      a.href = url;\n      a.download = `attendance-report-${startDate}-to-${endDate}.xlsx`;\n      document.body.appendChild(a);\n      a.click();\n      document.body.removeChild(a);\n      window.URL.revokeObjectURL(url);\n      onClose();\n    } catch (err) {\n      setPhase(\"failed\");\n      setError(err instanceof Error ? err.message : \"Download failed\");\n    }\n  };\n\n  // Calculate percentage from appropriate source\n  const percentage =\n    jobId && phase === \"polling\"\n      ? useFallbackPolling && pollingStatus?.progress?.percentage\n        ? pollingStatus.progress.percentage\n        : streamProgress\n      : 0;\n\n  // Calculate batch count\n  const completedBatches = useFallbackPolling && pollingStatus?.progress\n    ? pollingStatus.progress.completed_batches\n    : totalBatches > 0\n      ? Math.floor((streamProgress / 100) * totalBatches)\n      : 0;\n\n  return (\n    <Modal\n      isOpen={isOpen}\n      onClose={onClose}\n      title={t(\"report_export.title\")}\n      subtitle={t(\"report_export.subtitle\")}\n      icon={<FileSpreadsheet size={24} />}\n      maxWidth=\"md\"\n      data-testid=\"report-export-dialog\"\n    >\n      <div className=\"p-6 space-y-6\">\n        {/* Export Info */}\n        <div className=\"bg-slate-50 dark:bg-slate-800 rounded-2xl p-4 space-y-2\" data-testid=\"report-export-info\">\n          <div className=\"flex justify-between text-sm\">\n            <span className=\"text-slate-500 dark:text-slate-400\">{t(\"reports.date_range\")}:</span>\n            <span className=\"font-medium\">{startDate} ~ {endDate}</span>\n          </div>\n          <div className=\"flex justify-between text-sm\">\n            <span className=\"text-slate-500 dark:text-slate-400\">{t(\"reports.report_type\")}:</span>\n            <span className=\"font-medium capitalize\">{reportType}</span>\n          </div>\n          {employeeIds && employeeIds.length > 0 && (\n            <div className=\"flex justify-between text-sm\">\n              <span className=\"text-slate-500 dark:text-slate-400\">{t(\"reports.employees\")}:</span>\n              <span className=\"font-medium\">{employeeIds.length} {t(\"common.selected\")}</span>\n            </div>\n          )}\n        </div>\n\n        {/* Progress Section */}\n        {phase !== \"idle\" && (\n          <div className=\"space-y-4\">\n            {/* Progress Bar */}\n            <div className=\"h-4 w-full bg-slate-100 dark:bg-slate-700 rounded-full overflow-hidden shadow-inner\" data-testid=\"report-export-progress-bar\">\n              <div\n                className={cn(\n                  \"h-full transition-all duration-500 ease-out\",\n                  phase === \"failed\" ? \"bg-rose-50 dark:bg-rose-950\" :\n                    phase === \"completed\" ? \"bg-emerald-50 dark:bg-emerald-950\" :\n                      \"bg-primary-600 bg-gradient-to-r from-primary-500 to-primary-600\"\n                )}\n                style={{ width: `${phase === \"completed\" ? 100 : percentage}%` }}\n                data-testid=\"report-export-progress-fill\"\n              />\n            </div>\n\n            {/* Status */}\n            <div className=\"flex items-center justify-center gap-3\">\n              {phase === \"starting\" || phase === \"polling\" ? (\n                <Loader2 className=\"w-5 h-5 text-primary-600 dark:text-primary-400 animate-spin\" />\n              ) : phase === \"completed\" ? (\n                <CheckCircle2 className=\"w-5 h-5 text-emerald-500\" />\n              ) : phase === \"failed\" ? (\n                <AlertCircle className=\"w-5 h-5 text-rose-500\" />\n              ) : phase === \"downloading\" ? (\n                <Loader2 className=\"w-5 h-5 text-primary-600 dark:text-primary-400 animate-spin\" />\n              ) : null}\n\n              <span className={cn(\n                \"font-medium\",\n                phase === \"failed\" ? \"text-rose-600 dark:text-rose-300\" :\n                  phase === \"completed\" ? \"text-emerald-600 dark:text-emerald-300\" :\n                    \"text-slate-700 dark:text-slate-200\"\n              )}\n                data-testid=\"report-export-status-text\"\n              >\n                {phase === \"starting\" && t(\"report_export.status.preparing\")}\n                {phase === \"polling\" && t(\"report_export.status.processing\")}\n                {phase === \"completed\" && t(\"report_export.status.completed\")}\n                {phase === \"failed\" && t(\"report_export.status.failed\")}\n                {phase === \"downloading\" && t(\"report_export.status.downloading\")}\n              </span>\n            </div>\n\n            {/* Batch Progress */}\n            {phase === \"polling\" && totalBatches > 0 && (\n              <p className=\"text-center text-sm text-slate-500 dark:text-slate-400\" data-testid=\"report-export-batch-counter\">\n                {t(\"report_export.batches_completed\", {\n                  completed: completedBatches,\n                  total: totalBatches,\n                })}\n              </p>\n            )}\n\n            {/* Error Message */}\n            {error && (\n              <div className=\"bg-rose-50 dark:bg-rose-950 border border-rose-200 rounded-xl p-4\" data-testid=\"report-export-error\">\n                <p className=\"text-sm text-rose-700 dark:text-rose-300\">{error}</p>\n              </div>\n            )}\n\n            {/* Fallback Mode Notification */}\n            {useFallbackPolling && phase === \"polling\" && (\n              <div className=\"bg-amber-50 dark:bg-amber-950 border border-amber-200 rounded-xl p-3\" data-testid=\"report-export-fallback-notice\">\n                <p className=\"text-xs text-amber-700 dark:text-amber-300\">\n                  {t(\"report_export.fallback_mode\")}\n                </p>\n              </div>\n            )}\n          </div>\n        )}\n\n        {/* Actions */}\n        <div className=\"flex gap-3 pt-2\">\n          {phase === \"idle\" && (\n            <>\n              <button\n                onClick={onClose}\n                className=\"flex-1 px-6 py-3 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors font-medium\"\n                data-testid=\"report-export-cancel-button\"\n              >\n                {t(\"common.cancel\")}\n              </button>\n              <button\n                onClick={handleStartExport}\n                className=\"flex-1 flex items-center justify-center gap-2 px-6 py-3 bg-primary-600 text-white rounded-xl hover:bg-primary-700 transition-colors font-medium\"\n                data-testid=\"report-export-start-button\"\n              >\n                <Download size={18} />\n                {t(\"report_export.start_export\")}\n              </button>\n            </>\n          )}\n\n          {(phase === \"starting\" || phase === \"polling\") && (\n            <button\n              onClick={onClose}\n              className=\"flex-1 px-6 py-3 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors font-medium\"\n              data-testid=\"report-export-background-button\"\n            >\n              {t(\"report_export.run_background\")}\n            </button>\n          )}\n\n          {phase === \"completed\" && (\n            <>\n              <button\n                onClick={onClose}\n                className=\"flex-1 px-6 py-3 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors font-medium\"\n                data-testid=\"report-export-close-button\"\n              >\n                {t(\"common.close\")}\n              </button>\n              <button\n                onClick={handleDownload}\n                className=\"flex-1 flex items-center justify-center gap-2 px-6 py-3 bg-emerald-600 text-white rounded-xl hover:bg-emerald-700 transition-colors font-medium\"\n                data-testid=\"report-export-download-button\"\n              >\n                <Download size={18} />\n                {t(\"report_export.download_button\")}\n              </button>\n            </>\n          )}\n\n          {phase === \"failed\" && (\n            <>\n              <button\n                onClick={onClose}\n                className=\"flex-1 px-6 py-3 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors font-medium\"\n                data-testid=\"report-export-close-button\"\n              >\n                {t(\"common.close\")}\n              </button>\n              <button\n                onClick={handleStartExport}\n                className=\"flex-1 flex items-center justify-center gap-2 px-6 py-3 bg-primary-600 text-white rounded-xl hover:bg-primary-700 transition-colors font-medium\"\n                data-testid=\"report-export-retry-button\"\n              >\n                {t(\"common.retry\")}\n              </button>\n            </>\n          )}\n\n          {phase === \"downloading\" && (\n            <button\n              disabled\n              className=\"flex-1 flex items-center justify-center gap-2 px-6 py-3 bg-slate-300 text-slate-500 dark:text-slate-400 rounded-xl cursor-not-allowed font-medium\"\n              data-testid=\"report-export-downloading-button\"\n            >\n              <Loader2 size={18} className=\"animate-spin\" />\n              {t(\"report_export.status.downloading\")}\n            </button>\n          )}\n        </div>\n      </div>\n    </Modal>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/reports/ReportFilters.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'SearchBox' is defined but never used. Allowed unused vars must match /^_/u.","line":6,"column":8,"nodeType":"Identifier","messageId":"unusedVar","endLine":6,"endColumn":17,"suggestions":[{"messageId":"removeUnusedImportDeclaration","data":{"varName":"SearchBox"},"fix":{"range":[167,222],"text":""},"desc":"Remove unused import declaration."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'searchQuery' is defined but never used. Allowed unused args must match /^_/u.","line":39,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":39,"endColumn":14},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'searchInputRef' is defined but never used. Allowed unused args must match /^_/u.","line":40,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":40,"endColumn":17},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'onSearchQueryChange' is defined but never used. Allowed unused args must match /^_/u.","line":45,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":45,"endColumn":22},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'onSearchKeyDown' is defined but never used. Allowed unused args must match /^_/u.","line":46,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":46,"endColumn":18},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":61,"column":59,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":61,"endColumn":62,"suggestions":[{"messageId":"suggestUnkno