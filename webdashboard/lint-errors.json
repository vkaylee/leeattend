rs","severity":2,"message":"'calculate_payroll' is defined but never used. Allowed unused vars must match /^_/u.","line":46,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":46,"endColumn":20,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"calculate_payroll"},"fix":{"range":[1423,1444],"text":""},"desc":"Remove unused variable \"calculate_payroll\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'toast' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":56,"column":9,"nodeType":"Identifier","messageId":"unusedVar","endLine":56,"endColumn":14},{"ruleId":"import-x/no-named-as-default-member","severity":1,"message":"Caution: `React` also has a named export `useEffect`. Check if you meant to write `import {useEffect} from 'react'` instead.","line":67,"column":3,"nodeType":"MemberExpression","messageId":"member","endLine":67,"endColumn":18},{"ruleId":"import-x/no-named-as-default-member","severity":1,"message":"Caution: `React` also has a named export `useMemo`. Check if you meant to write `import {useMemo} from 'react'` instead.","line":100,"column":21,"nodeType":"MemberExpression","messageId":"member","endLine":100,"endColumn":34},{"ruleId":"import-x/no-named-as-default-member","severity":1,"message":"Caution: `React` also has a named export `useMemo`. Check if you meant to write `import {useMemo} from 'react'` instead.","line":161,"column":25,"nodeType":"MemberExpression","messageId":"member","endLine":161,"endColumn":38}],"suppressedMessages":[],"errorCount":20,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":1,"fixableWarningCount":0,"source":"import React, { useState, useMemo } from \"react\";\n\nimport { useQuery, useMutation, useQueryClient, keepPreviousData } from \"@tanstack/react-query\";\nimport { \n  Calculator, \n  ArrowLeft, \n  ArrowRight, \n  Search, \n  User as UserIcon,\n  ChevronRight,\n  Info,\n  Banknote,\n  Calendar,\n  Filter,\n  MoreVertical\n} from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { EmployeeSearch } from \"@/components/common/EmployeeSearch\";\nimport { MonthYearPicker } from \"@/components/common/MonthYearPicker\";\nimport AdjustmentDrawer from \"@/components/payroll/AdjustmentDrawer\";\nimport BatchCalculationModal from \"@/components/payroll/BatchCalculationModal\";\nimport EmployeeSalaryConfig from \"@/components/payroll/EmployeeSalaryConfig\";\nimport PayrollSummaryTable from \"@/components/payroll/PayrollSummaryTable\";\nimport PayrollTable from \"@/components/payroll/PayrollTable\";\nimport PayrollDetailDrawer from \"@/components/payroll/PayrollDetailDrawer\";\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuLabel,\n  DropdownMenuSeparator,\n  DropdownMenuTrigger,\n} from \"@/components/ui/dropdown-menu\";\nimport Modal from \"@/components/ui/Modal\";\n\nimport { useDateTimeFormatter } from \"@/hooks/use-datetime\";\nimport { cn } from \"@/lib/utils\";\n\nimport { useToast } from \"../components/ui/Toast\";\nimport {\n  fetchEmployees,\n  searchEmployees,\n  fetchEmployeePayslips,\n  fetchWorkspacePayslips,\n  calculate_payroll,\n  getCurrentWorkspaceId,\n  fetchWorkspaceAttendanceAdjustments,\n  Employee,\n} from \"../lib/api\";\n\nexport default function PayrollPage() {\n  const { t } = useTranslation();\n  const wsId = getCurrentWorkspaceId() || \"\";\n  const queryClient = useQueryClient();\n  const toast = useToast();\n  \n  const [selectedEmployee, setSelectedEmployee] = useState<Employee | null>(null);\n  const [selectedIds, setSelectedIds] = useState<Set<string>>(new Set());\n  const [searchTerm, setSearchTerm] = useState(\"\");\n  const [isBatchCalcModalOpen, setIsBatchCalcModalOpen] = useState(false);\n  const [isAdjustmentDrawerOpen, setIsAdjustmentDrawerOpen] = useState(false);\n  const [isDetailDrawerOpen, setIsDetailDrawerOpen] = useState(false);\n\n  // Debounce search term for server-side search\n  const [debouncedSearchTerm, setDebouncedSearchTerm] = useState(\"\");\n  React.useEffect(() => {\n    const timer = setTimeout(() => {\n      setDebouncedSearchTerm(searchTerm);\n    }, 300);\n    return () => clearTimeout(timer);\n  }, [searchTerm]);\n  \n  const [calcYear, setCalcYear] = useState(() => {\n    const d = new Date();\n    d.setMonth(d.getMonth() - 1);\n    return d.getFullYear();\n  });\n  const [calcMonth, setCalcMonth] = useState(() => {\n    const d = new Date();\n    d.setMonth(d.getMonth() - 1);\n    return d.getMonth() + 1;\n  });\n\n  // Use server-side search when search term exists, otherwise fetch all employees\n  const { data: employeesData, isLoading: empsLoading } = useQuery({\n    queryKey: [\"employees\", wsId, debouncedSearchTerm],\n    queryFn: () => {\n      if (debouncedSearchTerm.trim()) {\n        // Server-side search with higher limit to show more results\n        return searchEmployees(wsId, debouncedSearchTerm, 1, 100);\n      }\n      // Fetch all employees (up to 3000)\n      return fetchEmployees(wsId, 1, 3000);\n    },\n    enabled: !!wsId,\n    placeholderData: keepPreviousData,\n  });\n\n  const employees = React.useMemo(() => employeesData?.data ?? [], [employeesData?.data]);\n\n  const { data: workspacePayslipsData = [], isLoading: workspacePayslipsLoading } = useQuery({\n    queryKey: [\"workspace-payslips\", wsId, calcYear, calcMonth],\n    queryFn: () => fetchWorkspacePayslips(wsId, calcYear, calcMonth),\n    enabled: !!wsId,\n    placeholderData: keepPreviousData,\n  });\n\n  // Handle both paginated and direct array responses for backwards compatibility\n  const workspacePayslips = Array.isArray(workspacePayslipsData)\n    ? workspacePayslipsData\n    : workspacePayslipsData?.data ?? [];\n\n  const { data: employeePayslips = [], isLoading: employeePayslipsLoading } = useQuery({\n    queryKey: [\"payslips\", selectedEmployee?.id],\n    queryFn: () => fetchEmployeePayslips(wsId, selectedEmployee!.id),\n    enabled: !!selectedEmployee && isDetailDrawerOpen,\n  });\n\n  const { data: allAdjustments = [] } = useQuery({\n    queryKey: [\"adjustments\", wsId, \"pending\"],\n    queryFn: () => fetchWorkspaceAttendanceAdjustments(wsId, \"pending\"),\n    enabled: !!wsId,\n    placeholderData: keepPreviousData,\n  });\n\n  const employeeAdjustments = selectedEmployee \n    ? allAdjustments.filter(adj => adj.employee_id === selectedEmployee.id)\n    : [];\n\n  const toggleSelectAll = (ids?: string[]) => {\n    if (ids) {\n      const next = new Set(selectedIds);\n      const allIncluded = ids.every(id => next.has(id));\n      if (allIncluded) {\n        ids.forEach(id => next.delete(id));\n      } else {\n        ids.forEach(id => next.add(id));\n      }\n      setSelectedIds(next);\n      return;\n    }\n\n    // Server-side search already filters employees, so use all visible employees\n    if (selectedIds.size === employees.length) setSelectedIds(new Set());\n    else setSelectedIds(new Set(employees.map(e => e.id)));\n  };\n\n  const toggleSelect = (id: string) => {\n    const next = new Set(selectedIds);\n    if (next.has(id)) next.delete(id);\n    else next.add(id);\n    setSelectedIds(next);\n  };\n\n  const handleViewDetail = (employee: Employee) => {\n    setSelectedEmployee(employee);\n    setIsDetailDrawerOpen(true);\n  };\n\n  const employeeNames = React.useMemo(() => {\n    const map: Record<string, string> = {};\n    employees.forEach(e => { map[e.id] = e.full_name; });\n    return map;\n  }, [employees]);\n\n  const handleAdjustmentResolved = () => {\n    queryClient.invalidateQueries({ queryKey: [\"payslips\", selectedEmployee?.id] });\n    queryClient.invalidateQueries({ queryKey: [\"workspace-payslips\"] });\n    queryClient.invalidateQueries({ queryKey: [\"adjustments\"] });\n  };\n\n  const changeMonth = (delta: number) => {\n    let nextMonth = calcMonth + delta;\n    let nextYear = calcYear;\n    if (nextMonth > 12) { nextMonth = 1; nextYear++; }\n    else if (nextMonth < 1) { nextMonth = 12; nextYear--; }\n    setCalcMonth(nextMonth);\n    setCalcYear(nextYear);\n  };\n\n  if (!wsId) return <div className=\"p-8 text-center\">{t(\"common.select_workspace\")}</div>;\n\n  return (\n    <div className=\"flex flex-col h-[calc(100vh-8rem)] gap-8 overflow-hidden animate-in fade-in duration-500\">\n      {/* Header with Stats and Actions */}\n      <header className=\"flex flex-col md:flex-row md:items-center justify-between gap-6 px-2\">\n        <div>\n          <h1 data-testid=\"payroll-title\" className=\"text-3xl font-bold tracking-tight text-slate-700 dark:text-slate-200\">{t(\"payroll.title\")}</h1>\n          <p className=\"text-slate-500 dark:text-slate-400 mt-1 font-medium\">{t(\"payroll.subtitle\")}</p>\n        </div>\n\n        <div className=\"flex items-center gap-4 bg-white dark:bg-slate-900 p-2 rounded-[2rem] border border-slate-200 dark:border-slate-700 shadow-sm\">\n           <div className=\"flex items-center bg-slate-100 dark:bg-slate-700/50 rounded-2xl p-1 shadow-inner border border-slate-200 dark:border-slate-700/50\">\n              <button onClick={() => changeMonth(-1)} className=\"w-10 h-10 flex items-center justify-center text-slate-500 dark:text-slate-400 hover:text-primary-600 dark:text-primary-400 hover:bg-white dark:hover:bg-slate-900 hover:shadow-sm rounded-xl transition-all\"><ArrowLeft size={18} /></button>\n              \n              <DropdownMenu>\n                <DropdownMenuTrigger asChild>\n                  <button className=\"px-6 flex flex-col items-center min-w-[160px] cursor-pointer hover:bg-white dark:hover:bg-slate-900 hover:shadow-sm rounded-xl transition-all py-1.5 group outline-none border border-transparent hover:border-slate-100 dark:border-slate-800\">\n                    <span className=\"text-[9px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest leading-none mb-1 group-hover:text-primary-500 dark:group-hover:text-primary-400 transition-colors\">{t(\"payroll.table.period\")}</span>\n                    <span className=\"text-sm font-bold text-slate-700 dark:text-slate-200 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors uppercase tracking-tighter\">\n                      {calcMonth} / {calcYear}\n                    </span>\n                  </button>\n                </DropdownMenuTrigger>\n                <DropdownMenuContent className=\"w-80 p-4 rounded-[2rem] shadow-2xl border-slate-100 dark:border-slate-800\" align=\"center\" sideOffset={8}>\n                    <DropdownMenuLabel className=\"text-center text-[10px] font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400 mb-4\">{t(\"common.select_month\", { defaultValue: \"SELECT PAY PERIOD\" })}</DropdownMenuLabel>\n                    <MonthYearPicker month={calcMonth} year={calcYear} onChange={(m, y) => { setCalcMonth(m); setCalcYear(y); }} />\n                </DropdownMenuContent>\n              </DropdownMenu>\n\n              <button onClick={() => changeMonth(1)} className=\"w-10 h-10 flex items-center justify-center text-slate-500 dark:text-slate-400 hover:text-primary-600 dark:text-primary-400 hover:bg-white dark:hover:bg-slate-900 hover:shadow-sm rounded-xl transition-all\"><ArrowRight size={18} /></button>\n           </div>\n\n           <div className=\"h-10 w-px bg-slate-100 dark:bg-slate-700\" />\n\n           <button \n            data-testid=\"calculate-batch-btn\"\n            onClick={() => {\n              setIsBatchCalcModalOpen(true);\n            }}\n            disabled={selectedIds.size === 0}\n            className={cn(\n              \"flex items-center gap-3 px-8 py-3 rounded-2xl font-bold text-[10px] uppercase tracking-widest transition-all shadow-lg active:scale-95\",\n              selectedIds.size > 0 \n                ? \"bg-primary-600 text-white shadow-primary-100 hover:bg-primary-700\" \n                : \"bg-slate-100 dark:bg-slate-700 text-slate-500 dark:text-slate-400 shadow-none cursor-not-allowed\"\n            )}\n           >\n             <Calculator size={18} />\n             {t(\"payroll.calculate_btn\")} {selectedIds.size > 0 && <span className=\"ml-1 bg-white dark:bg-slate-900/20 px-2 py-0.5 rounded-lg text-white\">{selectedIds.size}</span>}\n           </button>\n        </div>\n      </header>\n\n      {/* Main Grid Section */}\n      <div className=\"flex-1 min-h-0\">\n        <PayrollSummaryTable \n          employees={employees}\n          payslips={workspacePayslips}\n          isLoading={empsLoading || workspacePayslipsLoading}\n          selectedIds={selectedIds}\n          onToggleSelect={toggleSelect}\n          onToggleSelectAll={toggleSelectAll}\n          onViewDetail={handleViewDetail}\n          searchTerm={searchTerm}\n          onSearchChange={setSearchTerm}\n        />\n      </div>\n\n      {/* Detail Drawer */}\n      <PayrollDetailDrawer \n        isOpen={isDetailDrawerOpen}\n        onClose={() => setIsDetailDrawerOpen(false)}\n        employee={selectedEmployee}\n        workspaceId={wsId}\n        payslips={employeePayslips}\n        isLoadingPayslips={employeePayslipsLoading}\n        adjustments={employeeAdjustments}\n        onResolveAdjustments={() => setIsAdjustmentDrawerOpen(true)}\n      />\n\n      {/* Adjustment Drawer */}\n      {selectedEmployee && (\n        <AdjustmentDrawer\n          isOpen={isAdjustmentDrawerOpen}\n          onClose={() => setIsAdjustmentDrawerOpen(false)}\n          employeeId={selectedEmployee.id}\n          employeeName={selectedEmployee.full_name}\n          onAdjustmentResolved={handleAdjustmentResolved}\n        />\n      )}\n\n      {/* Batch Calculate Modal */}\n      <BatchCalculationModal\n        isOpen={isBatchCalcModalOpen}\n        onClose={() => setIsBatchCalcModalOpen(false)}\n        workspaceId={wsId}\n        employeeIds={Array.from(selectedIds)}\n        employeeNames={employeeNames}\n      />\n    </div>\n  );\n}","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/ProfilePage.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'RefreshCw' is defined but never used. Allowed unused vars must match /^_/u.","line":14,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":14,"endColumn":12,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"RefreshCw"},"fix":{"range":[209,222],"text":""},"desc":"Remove unused variable \"RefreshCw\"."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":208,"column":77,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":208,"endColumn":80,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[15393,15396],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[15393,15396],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":209,"column":17,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":209,"endColumn":20,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[15427,15430],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[15427,15430],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":224,"column":361,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":224,"endColumn":364,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[16443,16446],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[16443,16446],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/workspace/webdashboard/src/pages/ProfilePage.tsx:49:7\n  47 |     if (user) {\n  48 |       // eslint-disable-next-line react-hooks/set-state-in-effect\n> 49 |       setFormData({\n     |       ^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  50 |         full_name: user.full_name || \"\", avatar_url: user.avatar_url || \"\",\n  51 |         bio: user.bio || \"\", preferred_language: user.preferred_language || \"\",\n  52 |       });","line":49,"column":7,"nodeType":null,"endLine":49,"endColumn":18,"suppressions":[{"kind":"directive","justification":""}]}],"errorCount":4,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState, useEffect } from \"react\";\n\nimport { useNavigate } from \"@tanstack/react-router\";\nimport {\n  User as UserIcon,\n  Mail,\n  UserCircle,\n  Save,\n  Lock,\n  ShieldCheck,\n  Palette,\n  Undo2,\n  Globe,\n  RefreshCw,\n} from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport Button from \"@/components/ui/Button\";\nimport { Combobox } from \"@/components/ui/Combobox\";\nimport { LABEL_BASE } from \"@/components/ui/FormField\";\n\nimport { useDateTimeFormatter } from \"@/hooks/use-datetime\";\nimport { useProfile } from \"@/hooks/use-profile\";\nimport { useTheme } from \"@/hooks/use-theme\";\nimport { changePassword, clearAuthSession } from \"@/lib/api\";\nimport { ROUTES } from \"@/lib/routes\";\nimport { cn } from \"@/lib/utils\";\n\n\nimport { useToast } from \"../components/ui/Toast\";\n\ntype TabType = \"profile\" | \"personalization\" | \"security\";\n\nexport default function ProfilePage() {\n  const { t } = useTranslation();\n  const { user, isLoading, updateProfile, isUpdating } = useProfile();\n  const { formatDate } = useDateTimeFormatter();\n  const { primaryColor, isOverridden, setUserTheme } = useTheme();\n  const toast = useToast();\n  const [activeTab, setActiveTab] = useState<TabType>(\"profile\");\n\n  const [formData, setFormData] = useState({\n    full_name: \"\", avatar_url: \"\", bio: \"\", preferred_language: \"\",\n  });\n\n  useEffect(() => {\n    if (user) {\n      // eslint-disable-next-line react-hooks/set-state-in-effect\n      setFormData({\n        full_name: user.full_name || \"\", avatar_url: user.avatar_url || \"\",\n        bio: user.bio || \"\", preferred_language: user.preferred_language || \"\",\n      });\n    }\n  }, [user]);\n\n  async function handleSubmit(e: React.FormEvent) {\n    e.preventDefault();\n    try {\n      await updateProfile(formData);\n      toast.success(t(\"common.success\"));\n    } catch (e) { console.error(e); }\n  }\n\n  if (isLoading) return <div className=\"p-20 text-center\"><div className=\"w-10 h-10 border-4 border-primary-600 border-t-transparent rounded-full animate-spin mx-auto\"></div></div>;\n\n  return (\n    <div className=\"space-y-10 animate-in fade-in duration-700 pb-20\">\n      <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-8 px-2\">\n        <div className=\"space-y-1\">\n          <h1 className=\"text-4xl font-bold tracking-tighter text-slate-700 dark:text-slate-200 uppercase leading-none\">{t(\"common.profile\")}</h1>\n          <p className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em] opacity-60\">{t(\"profile.subtitle\")}</p>\n        </div>\n\n        <div className=\"flex bg-slate-100 dark:bg-slate-700/50 p-1.5 rounded-[22px] w-fit border border-slate-200 dark:border-slate-700/50 shadow-inner\">\n          <button onClick={() => setActiveTab(\"profile\")} className={cn(\"flex items-center gap-2 px-8 py-2.5 rounded-[18px] text-xs font-bold uppercase tracking-widest transition-all\", activeTab === 'profile' ? \"bg-white dark:bg-slate-900 text-primary-600 dark:text-primary-400 shadow-sm border border-slate-100 dark:border-slate-800\" : \"text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 dark:text-slate-700\")}><UserCircle size={14} /> {t(\"common.profile\")}</button>\n          <button onClick={() => setActiveTab(\"personalization\")} className={cn(\"flex items-center gap-2 px-8 py-2.5 rounded-[18px] text-xs font-bold uppercase tracking-widest transition-all\", activeTab === 'personalization' ? \"bg-white dark:bg-slate-900 text-primary-600 dark:text-primary-400 shadow-sm border border-slate-100 dark:border-slate-800\" : \"text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 dark:text-slate-700\")}><Palette size={14} /> {t(\"profile.personalization.title\")}</button>\n          <button onClick={() => setActiveTab(\"security\")} className={cn(\"flex items-center gap-2 px-8 py-2.5 rounded-[18px] text-xs font-bold uppercase tracking-widest transition-all\", activeTab === 'security' ? \"bg-white dark:bg-slate-900 text-primary-600 dark:text-primary-400 shadow-sm border border-slate-100 dark:border-slate-800\" : \"text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 dark:text-slate-700\")}><ShieldCheck size={14} /> {t(\"profile.security.title\")}</button>\n        </div>\n      </div>\n\n      <div className=\"animate-in slide-in-from-bottom-8 duration-700\">\n        {activeTab === \"profile\" && (\n          <div className=\"max-w-5xl bg-white dark:bg-slate-900 rounded-[3rem] border border-slate-100 dark:border-slate-800 shadow-sm overflow-hidden group/hero\">\n            <div className=\"h-40 bg-slate-900 relative overflow-hidden\">\n               <div className=\"absolute inset-0 bg-gradient-to-br from-primary-600/40 via-indigo-600/20 to-transparent\" />\n               <div className=\"absolute top-0 left-0 w-full h-full opacity-10 pointer-events-none bg-[radial-gradient(circle_at_50%_50%,rgba(255,255,255,0.1)_0,transparent_50%)]\" />\n            </div>\n            <div className=\"px-12 pb-10\">\n              <div className=\"relative -mt-16 mb-8 flex items-end gap-8\">\n                <div className=\"w-32 h-32 rounded-[2.5rem] border-[10px] border-white shadow-2xl bg-slate-100 dark:bg-slate-700 flex items-center justify-center text-slate-300 dark:text-slate-600 overflow-hidden rotate-3 group-hover/hero:rotate-0 transition-transform duration-700\">\n                  {formData.avatar_url ? <img src={formData.avatar_url} className=\"w-full h-full object-cover\" alt=\"avatar\" /> : <UserCircle size={64} />}\n                </div>\n                <div className=\"mb-2\">\n                  <h2 className=\"text-3xl font-bold text-slate-700 dark:text-slate-200 tracking-tighter uppercase leading-none mb-2\">{user?.full_name || user?.email}</h2>\n                  <p className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest opacity-70\">{t(\"profile.join_date\")}: {formatDate(user?.created_at || \"\")}</p>\n                </div>\n              </div>\n\n              <form onSubmit={handleSubmit} className=\"space-y-10 pt-4\">\n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-10\">\n                  <div className=\"space-y-3 px-1\">\n                    <label className={LABEL_BASE}>{t(\"common.email\")}</label>\n                    <div className=\"flex items-center gap-4 px-6 py-4 bg-slate-100 dark:bg-slate-700/50 border border-slate-200 dark:border-slate-700 rounded-2xl text-slate-500 dark:text-slate-400 font-bold text-sm shadow-inner uppercase tracking-tight opacity-70 cursor-not-allowed\">\n                      <Mail size={18} className=\"opacity-50\" /> {user?.email}\n                    </div>\n                  </div>\n\n                  <div className=\"space-y-3 px-1\">\n                    <label className={LABEL_BASE}>{t(\"employees.table.name\")}</label>\n                    <div className=\"relative group\">\n                      <input required className=\"w-full bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl px-6 py-4 focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all pr-14 font-bold text-sm tracking-tight shadow-sm\" value={formData.full_name} onChange={(e) => setFormData({ ...formData, full_name: e.target.value })} />\n                      <UserIcon className=\"absolute right-5 top-1/2 -translate-y-1/2 text-slate-300 dark:text-slate-600 group-focus-within:text-primary-500 dark:group-focus-within:text-primary-400 transition-colors\" size={20} />\n                    </div>\n                  </div>\n\n                  <div className=\"space-y-3 px-1\">\n                    <label className={LABEL_BASE}>{t(\"profile.preferred_language\")}</label>\n                    <Combobox options={[{ value: \"\", label: t(\"profile.follow_workspace\").toUpperCase(), icon: <Globe size={14} /> }, { value: \"vi\", label: t(\"common.languages.vi\").toUpperCase(), icon: <Globe size={14} /> }, { value: \"en\", label: t(\"common.languages.en\").toUpperCase(), icon: <Globe size={14} /> }, { value: \"zh\", label: t(\"common.languages.zh\").toUpperCase(), icon: <Globe size={14} /> }]} value={formData.preferred_language} onChange={(val) => setFormData({ ...formData, preferred_language: val })} className=\"bg-slate-50 dark:bg-slate-800 border-slate-100 dark:border-slate-800 h-14\" />\n                  </div>\n                </div>\n\n                <div className=\"space-y-3 px-1\">\n                  <label className={LABEL_BASE}>{t(\"profile.bio\")}</label>\n                  <textarea className=\"w-full bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl px-6 py-4 focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-medium text-sm min-h-[140px] resize-none shadow-sm\" rows={3} value={formData.bio} onChange={(e) => setFormData({ ...formData, bio: e.target.value })} placeholder={t(\"profile.bio_placeholder\")} />\n                </div>\n\n                <div className=\"pt-8 border-t border-slate-50 dark:border-slate-800 flex justify-end\">\n                  <Button size=\"lg\" type=\"submit\" loading={isUpdating} icon={<Save size={18} />}>{isUpdating ? t(\"common.loading\").toUpperCase() : t(\"common.save\").toUpperCase()}</Button>\n                </div>\n              </form>\n            </div>\n          </div>\n        )}\n\n        {activeTab === \"personalization\" && (\n          <div className=\"max-w-5xl bg-white dark:bg-slate-900 rounded-[3rem] border border-slate-100 dark:border-slate-800 shadow-sm p-12 space-y-12 animate-in fade-in duration-500\">\n            <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-6 px-2\">\n              <div className=\"flex items-center gap-5\">\n                <div className=\"w-14 h-14 rounded-2xl bg-pink-50 flex items-center justify-center text-pink-600 shadow-inner border border-pink-100/50\"><Palette size={28} /></div>\n                <div>\n                  <h2 className=\"text-2xl font-bold text-slate-700 dark:text-slate-200 tracking-tighter uppercase leading-none mb-1\">{t(\"profile.personalization.title\")}</h2>\n                  <p className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest opacity-70\">{t(\"profile.personalization.subtitle\")}</p>\n                </div>\n              </div>\n              {isOverridden && (\n                <button onClick={() => setUserTheme(null)} className=\"flex items-center gap-3 text-[10px] font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400 hover:text-primary-600 dark:text-primary-400 transition-all bg-slate-50 dark:bg-slate-800 px-6 py-2.5 rounded-xl border border-slate-100 dark:border-slate-800 shadow-sm active:scale-95\"><Undo2 size={14} /> {t(\"profile.personalization.use_workspace_default\").toUpperCase()}</button>\n              )}\n            </div>\n\n            <div className=\"space-y-10\">\n              <div className=\"space-y-6\">\n                <label className={LABEL_BASE}>{t(\"common.workspace_settings.primary_color\")}</label>\n                <div className=\"flex flex-wrap gap-5 items-center\">\n                  {[\n                    { name: t(\"common.colors.emerald\"), color: '#10b981' }, { name: t(\"common.colors.indigo\"), color: '#4f46e5' }, { name: t(\"common.colors.blue\"), color: '#2563eb' },\n                    { name: t(\"common.colors.emerald\"), color: '#059669' }, { name: t(\"common.colors.amber\"), color: '#d97706' }, { name: t(\"common.colors.rose\"), color: '#e11d48' },\n                    { name: t(\"common.colors.slate\"), color: '#475569' }, { name: t(\"common.colors.black\"), color: '#0f172a' },\n                  ].map((preset) => (\n                    <button key={preset.color} onClick={() => setUserTheme(preset.color)} className={cn(\"w-14 h-14 rounded-