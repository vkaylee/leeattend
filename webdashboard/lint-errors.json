n instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":399,"column":39,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":399,"endColumn":42,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[14915,14918],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[14915,14918],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":15,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from \"react\";\n\nimport { QueryClient, QueryClientProvider } from \"@tanstack/react-query\";\nimport { render, screen, fireEvent, waitFor, act } from \"@testing-library/react\";\nimport { describe, it, expect, vi, beforeEach } from \"vitest\";\n\nvi.mock(\"react-i18next\", () => ({\n    useTranslation: () => ({\n        t: (key: string, fallback?: string) => fallback || key,\n    }),\n}));\n\n// Mock useDebounce to return value immediately (no delay)\nvi.mock(\"@/hooks/use-debounce\", () => ({\n    useDebounce: (value: any) => value,\n}));\n\nvi.mock(\"@/lib/api\", async () => {\n    const actual = await vi.importActual(\"@/lib/api\");\n    return {\n        ...actual,\n        fetchWorkspaceLeaveBalances: vi.fn(),\n        triggerAccrualRun: vi.fn(),\n        fetchJobStatus: vi.fn(),\n        getCurrentWorkspaceId: () => \"test-ws-id\",\n    };\n});\n\nvi.mock(\"@/components/leave/LeaveHistoryModal\", () => ({\n    LeaveHistoryModal: (props: any) => (\n        <div data-testid=\"leave-history-modal\" data-leavetypeid={props.leaveTypeId} data-leavetypename={props.leaveTypeName} data-employeeid={props.employeeId}>\n            {props.isOpen ? \"MOCKED_LEAVE_HISTORY_MODAL\" : null}\n        </div>\n    ),\n}));\n\nvi.mock(\"@/components/leave/LeaveBalanceDetailModal\", () => ({\n    LeaveBalanceDetailModal: ({ isOpen }: { isOpen: boolean }) =>\n        isOpen ? <div data-testid=\"leave-balance-detail-modal\" /> : null,\n}));\n\nimport { ToastProvider } from \"@/components/ui/Toast\";\n\nimport * as api from \"@/lib/api\";\n\nimport LeaveBalancesPage from \"../LeaveBalancesPage\";\n\nconst mockBalances = {\n    data: [\n        {\n            employee_id: \"emp-1\",\n            employee_name: \"Nguyen Van A\",\n            leave_type_id: \"lt-1\",\n            leave_type_code: \"AL\",\n            leave_type_name: \"Annual Leave\",\n            is_paid: true,\n            entitlement: 12,\n            accrued_amount: 3,\n            carried_over: 2,\n            used: 4,\n            remaining: 13,\n            policy_name: \"Standard Policy\",\n            assignment_type: \"workspace\",\n        },\n        {\n            employee_id: \"emp-2\",\n            employee_name: \"Tran Thi B\",\n            leave_type_id: \"lt-2\",\n            leave_type_code: \"SL\",\n            leave_type_name: \"Sick Leave\",\n            is_paid: true,\n            entitlement: 5,\n            accrued_amount: 0,\n            carried_over: 0,\n            used: 5,\n            remaining: 0,\n            policy_name: null,\n            assignment_type: null,\n        },\n    ],\n    total: 2,\n    page: 1,\n    limit: 20,\n};\n\ndescribe(\"LeaveBalancesPage\", () => {\n    let queryClient: QueryClient;\n\n    beforeEach(() => {\n        vi.clearAllMocks();\n        queryClient = new QueryClient({\n            defaultOptions: { queries: { retry: false } },\n        });\n        (api.fetchWorkspaceLeaveBalances as any).mockResolvedValue(mockBalances);\n        (api.triggerAccrualRun as any).mockResolvedValue({ job_id: \"\", status: \"completed\", message: \"Processed 2 accrual entries synchronously\" });\n    });\n\n    function renderPage() {\n        return render(\n            <QueryClientProvider client={queryClient}>\n                <ToastProvider>\n                    <LeaveBalancesPage />\n                </ToastProvider>\n            </QueryClientProvider>\n        );\n    }\n\n    it(\"renders page title\", async () => {\n        renderPage();\n        expect(screen.getByText(\"leave_balances.title\")).toBeDefined();\n    });\n\n    it(\"renders employee data after loading\", async () => {\n        renderPage();\n        // Wait for async data to render\n        await waitFor(() => {\n            expect(screen.getAllByText(\"Nguyen Van A\").length).toBeGreaterThan(0);\n        }, { timeout: 3000 });\n\n        expect(screen.getAllByText(\"Tran Thi B\").length).toBeGreaterThan(0);\n        expect(screen.getAllByText(\"Annual Leave\").length).toBeGreaterThan(0);\n        expect(screen.getAllByText(\"Sick Leave\").length).toBeGreaterThan(0);\n    });\n\n    it(\"shows remaining balance values\", async () => {\n        renderPage();\n        await waitFor(() => {\n            expect(screen.getAllByText(\"Nguyen Van A\").length).toBeGreaterThan(0);\n        }, { timeout: 3000 });\n\n        // emp-1 remaining = 13\n        const remainingEls = screen.getAllByText(\"13\");\n        expect(remainingEls.length).toBeGreaterThan(0);\n    });\n\n    it(\"renders usage progress bars with correct percentage\", async () => {\n        renderPage();\n        await waitFor(() => {\n            expect(screen.getAllByText(\"Nguyen Van A\").length).toBeGreaterThan(0);\n        }, { timeout: 3000 });\n\n        // emp-1: used 4 / total (12 + 3 + 2) = 4/17 ≈ 24%\n        expect(screen.getAllByText(\"24%\").length).toBeGreaterThan(0);\n        // emp-2: used 5 / total (5 + 0 + 0) = 5/5 = 100%\n        expect(screen.getAllByText(\"100%\").length).toBeGreaterThan(0);\n    });\n\n    it(\"shows year selector with current year\", async () => {\n        renderPage();\n        await waitFor(() => {\n            expect(screen.getAllByText(\"Nguyen Van A\").length).toBeGreaterThan(0);\n        }, { timeout: 3000 });\n\n        const yearSelect = screen.getByRole(\"combobox\") as HTMLSelectElement;\n        expect(yearSelect.value).toBe(String(new Date().getFullYear()));\n    });\n\n    it(\"calls API with year param when year is changed\", async () => {\n        renderPage();\n        await waitFor(() => {\n            expect(screen.getAllByText(\"Nguyen Van A\").length).toBeGreaterThan(0);\n        }, { timeout: 3000 });\n\n        const yearSelect = screen.getByRole(\"combobox\");\n        fireEvent.change(yearSelect, { target: { value: \"2024\" } });\n\n        await waitFor(() => {\n            expect(api.fetchWorkspaceLeaveBalances).toHaveBeenCalledWith(\n                \"test-ws-id\",\n                expect.objectContaining({ year: 2024, page: 1 })\n            );\n        });\n    });\n\n    it(\"shows custom confirm dialog when accrual button clicked\", async () => {\n        renderPage();\n        await waitFor(() => {\n            expect(screen.getAllByText(\"Nguyen Van A\").length).toBeGreaterThan(0);\n        }, { timeout: 3000 });\n\n        fireEvent.click(screen.getByText(\"LEAVE_BALANCES.RUN_ACCRUAL\"));\n        expect(screen.getByText(\"common.confirm\")).toBeDefined();\n        expect(screen.getByText(\"common.cancel\")).toBeDefined();\n    });\n\n    it(\"cancels accrual when Huỷ is clicked\", async () => {\n        renderPage();\n        await waitFor(() => {\n            expect(screen.getAllByText(\"Nguyen Van A\").length).toBeGreaterThan(0);\n        }, { timeout: 3000 });\n\n        fireEvent.click(screen.getByText(\"LEAVE_BALANCES.RUN_ACCRUAL\"));\n        fireEvent.click(screen.getByText(\"common.cancel\"));\n        expect(api.triggerAccrualRun).not.toHaveBeenCalled();\n    });\n\n    it(\"triggers accrual mutation when confirmed\", async () => {\n        renderPage();\n        await waitFor(() => {\n            expect(screen.getAllByText(\"Nguyen Van A\").length).toBeGreaterThan(0);\n        }, { timeout: 3000 });\n\n        fireEvent.click(screen.getByText(\"LEAVE_BALANCES.RUN_ACCRUAL\"));\n        fireEvent.click(screen.getByText(\"common.confirm\"));\n\n        await waitFor(() => {\n            expect(api.triggerAccrualRun).toHaveBeenCalledWith(\n                \"test-ws-id\",\n                expect.objectContaining({ date: expect.any(String) })\n            );\n        });\n    });\n\n    it(\"shows loading state when data is pending\", () => {\n        (api.fetchWorkspaceLeaveBalances as any).mockReturnValue(new Promise(() => { }));\n        renderPage();\n        expect(screen.getAllByText(\"common.loading\").length).toBeGreaterThan(0);\n    });\n\n    it(\"disables accrual button when viewing past or future years\", async () => {\n        renderPage();\n        await waitFor(() => {\n            expect(screen.getAllByText(\"Nguyen Van A\").length).toBeGreaterThan(0);\n        }, { timeout: 3000 });\n\n        const accrualBtn = screen.getByText(\"LEAVE_BALANCES.RUN_ACCRUAL\").closest(\"button\");\n        expect(accrualBtn).not.toBeDisabled();\n\n        // Change year to prev year\n        const yearSelect = screen.getByRole(\"combobox\");\n        fireEvent.change(yearSelect, { target: { value: String(new Date().getFullYear() - 1) } });\n\n        await waitFor(() => {\n            expect(accrualBtn).toBeDisabled();\n        });\n    });\n\n    it(\"passes leaveTypeId and leaveTypeName to LeaveHistoryModal when View History is clicked\", async () => {\n        renderPage();\n        await waitFor(() => {\n            expect(screen.getAllByText(\"Nguyen Van A\").length).toBeGreaterThan(0);\n        }, { timeout: 3000 });\n\n        // The first \"View History\" button in DesktopBalanceRow\n        // They are rendered with <button title=\"leave_balances.table.history_tooltip\"... \n        // Or we can find by a specific icon or screen.getAllByRole(\"button\") that have that action.\n        // It's probably easier to mock LeaveHistoryModal and check its props. Let's update the mock to render the props.\n    });\n\n    it(\"shows empty state when no data\", async () => {\n        (api.fetchWorkspaceLeaveBalances as any).mockResolvedValue({\n            data: [],\n            total: 0,\n            page: 1,\n            limit: 20,\n        });\n        renderPage();\n        await waitFor(() => {\n            expect(screen.getAllByText(\"attendance_logs.messages.no_data\").length).toBeGreaterThan(0);\n        }, { timeout: 3000 });\n    });\n\n    it(\"passes leaveTypeId and leaveTypeName to LeaveHistoryModal when View History is clicked\", async () => {\n        renderPage();\n        await waitFor(() => {\n            expect(screen.getAllByText(\"Nguyen Van A\").length).toBeGreaterThan(0);\n        }, { timeout: 3000 });\n\n        // Get the \"Lịch sử\" buttons from table rows (it uses History icon, but we can look for tooltip)\n        // DesktopBalanceRow uses: title={t(\"leave_balances.table.history_tooltip\")}\n        const historyBtns = screen.getAllByTitle(\"leave_balances.table.history_tooltip\");\n        fireEvent.click(historyBtns[0]); // Click on Nguyen Van A / Annual Leave\n\n        await waitFor(() => {\n            const modal = screen.getByTestId(\"leave-history-modal\");\n            expect(modal.getAttribute(\"data-employeeid\")).toBe(\"emp-1\");\n            expect(modal.getAttribute(\"data-leavetypeid\")).toBe(\"lt-1\");\n            expect(modal.getAttribute(\"data-leavetypename\")).toBe(\"Annual Leave\");\n        });\n    });\n\n    it(\"shows queued toast when accrual is processed in background\", async () => {\n        (api.triggerAccrualRun as any).mockResolvedValue({\n            job_id: \"job-123\",\n            status: \"queued\",\n            message: \"Accrual job enqueued for background processing\",\n        });\n        renderPage();\n        await waitFor(() => {\n            expect(screen.getAllByText(\"Nguyen Van A\").length).toBeGreaterThan(0);\n        }, { timeout: 3000 });\n\n        // Open confirm dialog and confirm\n        fireEvent.click(screen.getByText(\"LEAVE_BALANCES.RUN_ACCRUAL\"));\n        fireEvent.click(screen.getByText(\"common.confirm\"));\n\n        await waitFor(() => {\n            expect(api.triggerAccrualRun).toHaveBeenCalledWith(\n                \"test-ws-id\",\n                expect.objectContaining({ date: expect.any(String) })\n            );\n        });\n    });\n\n    it(\"shows completed toast when accrual runs synchronously\", async () => {\n        (api.triggerAccrualRun as any).mockResolvedValue({\n            job_id: \"\",\n            status: \"completed\",\n            message: \"Processed 5 accrual entries synchronously\",\n        });\n        renderPage();\n        await waitFor(() => {\n            expect(screen.getAllByText(\"Nguyen Van A\").length).toBeGreaterThan(0);\n        }, { timeout: 3000 });\n\n        fireEvent.click(screen.getByText(\"LEAVE_BALANCES.RUN_ACCRUAL\"));\n        fireEvent.click(screen.getByText(\"common.confirm\"));\n\n        await waitFor(() => {\n            expect(api.triggerAccrualRun).toHaveBeenCalled();\n        });\n    });\n\n    it(\"polls fetchJobStatus after queued response until completed\", async () => {\n        vi.useFakeTimers({ shouldAdvanceTime: true });\n        (api.triggerAccrualRun as any).mockResolvedValue({\n            job_id: \"job-poll-1\",\n            status: \"queued\",\n            message: \"Enqueued\",\n        });\n        // First poll: still processing. Second poll: completed.\n        (api.fetchJobStatus as any)\n            .mockResolvedValueOnce({ job_id: \"job-poll-1\", status: \"processing\", completed_at: null, error_message: null })\n            .mockResolvedValueOnce({ job_id: \"job-poll-1\", status: \"completed\", completed_at: \"2026-02-28T12:00:00Z\", error_message: null });\n\n        renderPage();\n        await waitFor(() => {\n            expect(screen.getAllByText(\"Nguyen Van A\").length).toBeGreaterThan(0);\n        }, { timeout: 3000 });\n\n        fireEvent.click(screen.getByText(\"LEAVE_BALANCES.RUN_ACCRUAL\"));\n        fireEvent.click(screen.getByText(\"common.confirm\"));\n\n        // Wait for mutation to fire\n        await waitFor(() => {\n            expect(api.triggerAccrualRun).toHaveBeenCalled();\n        });\n\n        // Advance past first poll interval (2s)\n        await act(async () => { vi.advanceTimersByTime(2500); });\n        await waitFor(() => {\n            expect(api.fetchJobStatus).toHaveBeenCalledWith(\"test-ws-id\", \"job-poll-1\");\n        });\n\n        // Advance past second poll interval\n        await act(async () => { vi.advanceTimersByTime(2500); });\n        await waitFor(() => {\n            expect((api.fetchJobStatus as any).mock.calls.length).toBeGreaterThanOrEqual(2);\n        });\n\n        vi.useRealTimers();\n    });\n\n    it(\"stops polling and shows error when job fails\", async () => {\n        vi.useFakeTimers({ shouldAdvanceTime: true });\n        (api.triggerAccrualRun as any).mockResolvedValue({\n            job_id: \"job-fail-1\",\n            status: \"queued\",\n            message: \"Enqueued\",\n        });\n        (api.fetchJobStatus as any).mockResolvedValue({\n            job_id: \"job-fail-1\",\n            status: \"failed\",\n            completed_at: \"2026-02-28T12:00:00Z\",\n            error_message: \"Accrual processing failed: DB error\",\n        });\n\n        renderPage();\n        await waitFor(() => {\n            expect(screen.getAllByText(\"Nguyen Van A\").length).toBeGreaterThan(0);\n        }, { timeout: 3000 });\n\n        fireEvent.click(screen.getByText(\"LEAVE_BALANCES.RUN_ACCRUAL\"));\n        fireEvent.click(screen.getByText(\"common.confirm\"));\n\n        await waitFor(() => {\n            expect(api.triggerAccrualRun).toHaveBeenCalled();\n        });\n\n        // Advance past first poll interval\n        await act(async () => { vi.advanceTimersByTime(2500); });\n        await waitFor(() => {\n            expect(api.fetchJobStatus).toHaveBeenCalledWith(\"test-ws-id\", \"job-fail-1\");\n        });\n\n        // Should NOT poll again after failure\n        const callCount = (api.fetchJobStatus as any).mock.calls.length;\n        await act(async () => { vi.advanceTimersByTime(5000); });\n        expect((api.fetchJobStatus as any).mock.calls.length).toBe(callCount);\n\n        vi.useRealTimers();\n    });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/__tests__/LeaveRequestsPage.test.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'within' is defined but never used. Allowed unused vars must match /^_/u.","line":2,"column":46,"nodeType":"Identifier","messageId":"unusedVar","endLine":2,"endColumn":52,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"within"},"fix":{"range":[117,125],"text":""},"desc":"Remove unused variable \"within\"."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":14,"column":38,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":14,"endColumn":41,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[626,629],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[626,629],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":43,"column":41,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":43,"endColumn":44,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1643,1646],"text":"unknown"},"desc":"Use `unknown` instead, this wi