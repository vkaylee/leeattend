\";\n\nimport { QueryClient, QueryClientProvider } from \"@tanstack/react-query\";\nimport { render, screen } from \"@testing-library/react\";\nimport userEvent from \"@testing-library/user-event\";\nimport { MemoryRouter } from \"react-router-dom\";\nimport { describe, it, expect, vi, beforeEach } from \"vitest\";\n\nimport { useMyPermissions } from \"../../hooks/use-permissions\";\nimport { useWorkspaceRoles } from \"../../hooks/use-workspace\";\nimport WorkspaceRolesPage from \"../workspace/WorkspaceRolesPage\";\n\n\n\nvi.mock(\"react-i18next\", () => ({\n    useTranslation: () => ({\n        t: (key: string, options?: any) => {\n            if (typeof options === 'string') return options;\n            if (options && typeof options === 'object' && options.defaultValue) return options.defaultValue;\n            return key;\n        },\n    }),\n}));\n\nvi.mock(\"../../hooks/use-workspace\", () => ({\n    useWorkspaceRoles: vi.fn(),\n}));\n\nvi.mock(\"../../hooks/use-permissions\", () => ({\n    useMyPermissions: vi.fn(),\n}));\n\nvi.mock(\"@tanstack/react-router\", () => ({\n    Link: ({ children, to, className }: any) => <a href={to} className={className}>{children}</a>,\n}));\n\nvi.mock(\"@/components/features/settings/RoleFormModal\", () => ({\n    default: ({ isOpen, editingRole }: any) => {\n        if (!isOpen) return null;\n        return <div data-testid=\"role-form-modal\">Modal: {editingRole ? editingRole.name : 'Create'}</div>;\n    }\n}));\n\ndescribe(\"WorkspaceRolesPage\", () => {\n    let queryClient: QueryClient;\n\n    const mockRoles = [\n        { id: \"role-1\", name: \"Owner\", is_system: true, description: \"Workspace Owner\", color: \"rose\" },\n        { id: \"role-2\", name: \"Manager\", is_system: false, description: \"Custom Manager\", color: \"indigo\" },\n    ];\n\n    beforeEach(() => {\n        vi.clearAllMocks();\n        queryClient = new QueryClient({\n            defaultOptions: { queries: { retry: false } },\n        });\n\n        (useWorkspaceRoles as any).mockReturnValue({\n            roles: mockRoles,\n            isLoading: false,\n            deleteRole: vi.fn(),\n        });\n\n        (useMyPermissions as any).mockReturnValue({\n            hasPermission: () => true,\n            hasAnyPermission: () => true,\n            hasScopedPermission: () => true,\n            isLoading: false,\n        });\n        \n        window.confirm = vi.fn().mockReturnValue(true);\n    });\n\n    const renderWithProviders = (ui: React.ReactElement) => {\n        return render(\n            <QueryClientProvider client={queryClient}>\n                <MemoryRouter>\n                    {ui}\n                </MemoryRouter>\n            </QueryClientProvider>\n        );\n    };\n\n    it(\"renders roles list correctly\", () => {\n        renderWithProviders(<WorkspaceRolesPage />);\n        expect(screen.getByText(\"Owner\")).toBeDefined();\n        expect(screen.getByText(\"Manager\")).toBeDefined();\n        expect(screen.getByText(\"Workspace Owner\")).toBeDefined();\n    });\n\n    it(\"hides action buttons if user lacks manage permission\", () => {\n        (useMyPermissions as any).mockReturnValue({\n            hasPermission: () => false,\n            hasAnyPermission: () => false,\n            hasScopedPermission: () => false,\n            isLoading: false,\n        });\n\n        renderWithProviders(<WorkspaceRolesPage />);\n        \n        expect(screen.queryByText(\"Create Role\")).toBeNull();\n        expect(screen.queryByText(\"Manage Access\")).toBeNull();\n    });\n\n    it(\"shows action buttons if user has manage permission\", () => {\n        (useMyPermissions as any).mockReturnValue({\n            hasPermission: () => true,\n            hasAnyPermission: () => true,\n            hasScopedPermission: () => true,\n            isLoading: false,\n        });\n\n        renderWithProviders(<WorkspaceRolesPage />);\n        \n        expect(screen.getByText(\"Create Role\")).toBeDefined();\n        // Menu toggle buttons should exist\n        const moreButtons = screen.queryAllByRole(\"button\");\n        expect(moreButtons.length).toBeGreaterThan(0);\n    });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/__tests__/pagination-integration.test.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'fireEvent' is defined but never used. Allowed unused vars must match /^_/u.","line":2,"column":26,"nodeType":"Identifier","messageId":"unusedVar","endLine":2,"endColumn":35,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"fireEvent"},"fix":{"range":[97,108],"text":""},"desc":"Remove unused variable \"fireEvent\"."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":30,"column":38,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":30,"endColumn":41,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1207,1210],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1207,1210],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":77,"column":32,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":77,"endColumn":35,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[2742,2745],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[2742,2745],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-a