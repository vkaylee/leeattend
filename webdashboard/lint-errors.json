 Specify a different type.","line":204,"column":40,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":204,"endColumn":43,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[7541,7544],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[7541,7544],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"import-x/no-named-as-default-member","severity":1,"message":"Caution: `React` also has a named export `lazy`. Check if you meant to write `import {lazy} from 'react'` instead.","line":208,"column":31,"nodeType":"MemberExpression","messageId":"member","endLine":208,"endColumn":41},{"ruleId":"import-x/no-named-as-default-member","severity":1,"message":"Caution: `React` also has a named export `lazy`. Check if you meant to write `import {lazy} from 'react'` instead.","line":229,"column":31,"nodeType":"MemberExpression","messageId":"member","endLine":229,"endColumn":41},{"ruleId":"import-x/no-named-as-default-member","severity":1,"message":"Caution: `React` also has a named export `lazy`. Check if you meant to write `import {lazy} from 'react'` instead.","line":244,"column":31,"nodeType":"MemberExpression","messageId":"member","endLine":244,"endColumn":41}],"suppressedMessages":[],"errorCount":5,"fatalErrorCount":0,"warningCount":6,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { Suspense } from \"react\";\n\nimport { QueryClient, QueryClientProvider } from \"@tanstack/react-query\";\nimport { render, screen, waitFor } from \"@testing-library/react\";\nimport { MemoryRouter } from \"react-router-dom\";\nimport { describe, it, expect, vi, beforeEach } from \"vitest\";\n\nimport { ToastProvider } from \"../../components/ui/Toast\";\nimport i18n from \"../../i18n/config\";\n\n// Mock all hooks needed by pages\nvi.mock(\"@/hooks/use-permissions\", () => ({\n    useMyPermissions: () => ({\n        roles: [\"Admin\"],\n        permissions: [\"employees:read\", \"employees:create\", \"employees:update\", \"employees:delete\"],\n        managedDepartmentIds: null,\n        isLoading: false,\n        hasPermission: () => true,\n        hasAnyPermission: () => true,\n        hasRole: () => true,\n        hasScopedPermission: () => true,\n    }),\n}));\n\nvi.mock(\"@/hooks/use-profile\", () => ({\n    useProfile: () => ({\n        user: { id: \"test-user\", email: \"test@example.com\", full_name: \"Test User\", preferred_language: \"en\" },\n        isLoading: false,\n        isError: false,\n    }),\n}));\n\nvi.mock(\"@/hooks/use-workspace\", () => ({\n    useWorkspaces: () => ({\n        workspaces: [{ id: \"test-ws-id\", name: \"Test Workspace\", default_language: \"en\" }],\n        isLoading: false,\n        isError: false,\n    }),\n    useWorkspace: () => ({\n        workspace: { id: \"test-ws-id\", name: \"Test Workspace\", date_format: \"DD/MM/YYYY\", default_language: \"en\" },\n        isLoading: false,\n        isError: false,\n    }),\n}));\n\nvi.mock(\"@/hooks/use-theme\", () => ({\n    useTheme: () => ({\n        primaryColor: \"#10b981\",\n        setPreviewTheme: vi.fn(),\n        setUserTheme: vi.fn(),\n    }),\n}));\n\nvi.mock(\"@/hooks/use-i18n-sync\", () => ({\n    useI18nSync: vi.fn(),\n}));\n\nvi.mock(\"@/hooks/use-agents\", () => ({\n    useAgentsStatus: () => ({ agents: [], isLoading: false, error: null }),\n}));\n\nvi.mock(\"@/hooks/use-devices\", () => ({\n    useDevices: () => ({ devices: [], isLoading: false, error: null }),\n}));\n\nvi.mock(\"@/hooks/use-dashboard\", () => ({\n    useDashboardStats: () => ({\n        data: { total_employees: 10, present_today: 8, pending_leave_requests: 2, estimated_monthly_payroll: \"50000\", late_today: 1, absent_today: 1, on_leave_today: 1, early_departure_today: 0, avg_work_hours_today: 7.5 },\n        isLoading: false, error: null,\n    }),\n    useAttendanceTrend: () => ({ data: [], isLoading: false, error: null }),\n    useDepartmentAttendance: () => ({ data: [], isLoading: false, error: null }),\n    useOvertimeTrend: () => ({ data: [], isLoading: false, error: null }),\n    usePeakTimes: () => ({ data: [], isLoading: false, error: null }),\n    useLeaveTypesBreakdown: () => ({ data: [], isLoading: false, error: null }),\n    useLatenessByDay: () => ({ data: [], isLoading: false, error: null }),\n    useUnexcusedAbsences: () => ({ data: [], isLoading: false, error: null }),\n    useRecruitmentSourceBreakdown: () => ({ data: [], isLoading: false, error: null }),\n    useTurnoverAnalytics: () => ({ data: null, isLoading: false, error: null }),\n}));\n\nvi.mock(\"@/hooks/use-dashboard-layout\", () => ({\n    useDashboardLayout: () => ({\n        activeView: \"hr\",\n        visibleWidgets: {},\n        widgetOrder: [],\n        collapsedSections: {},\n        isSaving: false,\n        setActiveView: vi.fn(),\n        toggleWidget: vi.fn(),\n        setWidgetOrder: vi.fn(),\n        toggleSection: vi.fn(),\n        resetToDefault: vi.fn(),\n        allWidgets: [],\n    }),\n}));\n\nvi.mock(\"@/lib/api\", async (importOriginal) => {\n    const actual = await importOriginal<any>();\n    return {\n        ...actual,\n        getCurrentUserId: vi.fn(() => \"test-user\"),\n        getCurrentWorkspaceId: vi.fn(() => \"test-ws-id\"),\n        fetchWorkspaceLeaveBalances: vi.fn(() => Promise.resolve([])),\n        fetchEmployees: vi.fn(() => Promise.resolve([])),\n        fetchWorkspace: vi.fn(() => Promise.resolve({ date_format: \"DD/MM/YYYY\", timezone: \"UTC\", default_language: \"en\" })),\n        fetchDepartments: vi.fn(() => Promise.resolve([])),\n        fetchRawAttendanceLogs: vi.fn(() => Promise.resolve({ data: [], total: 0 })),\n        fetchMyEmployeeProfile: vi.fn(() => Promise.resolve({ id: \"emp-1\", full_name: \"Test User\" })),\n    };\n});\n\n// Mock IntersectionObserver for jsdom\nclass MockIntersectionObserver {\n    observe() { }\n    unobserve() { }\n    disconnect() { }\n}\nwindow.IntersectionObserver = MockIntersectionObserver as any;\nvi.stubGlobal('IntersectionObserver', MockIntersectionObserver);\n\nvi.mock(\"recharts\", () => ({\n    ResponsiveContainer: ({ children }: any) => <div>{children}</div>,\n    BarChart: () => <div />, Bar: () => <div />, XAxis: () => <div />, YAxis: () => <div />,\n    CartesianGrid: () => <div />, Tooltip: () => <div />, Legend: () => <div />,\n    LineChart: () => <div />, Line: () => <div />, AreaChart: () => <div />, Area: () => <div />,\n    PieChart: () => <div />, Pie: () => <div />, Cell: () => <div />,\n    ComposedChart: () => <div />,\n}));\n\ndescribe(\"Lazy Route Loading\", () => {\n    let queryClient: QueryClient;\n\n    beforeEach(() => {\n        vi.clearAllMocks();\n        i18n.changeLanguage(\"en\");\n        queryClient = new QueryClient({\n            defaultOptions: { queries: { retry: false, gcTime: 0, staleTime: 0 } },\n        });\n    });\n\n    const renderWithProviders = (ui: React.ReactElement) => {\n        return render(\n            <QueryClientProvider client={queryClient}>\n                <ToastProvider>\n                    <MemoryRouter>\n                        {ui}\n                    </MemoryRouter>\n                </ToastProvider>\n            </QueryClientProvider>\n        );\n    };\n\n    it(\"should lazy load DashboardPage with Suspense\", async () => {\n        const LazyDashboard = React.lazy(() => import(\"../DashboardPage\"));\n\n        renderWithProviders(\n            <Suspense fallback={<div data-testid=\"loading\">Loading...</div>}>\n                <LazyDashboard />\n            </Suspense>\n        );\n\n        // Should eventually render the dashboard (may briefly show fallback)\n        await waitFor(() => {\n            expect(screen.getByTestId(\"dashboard-title\")).toBeInTheDocument();\n        }, { timeout: 5000 });\n    });\n\n    it(\"should lazy load LoginPage with Suspense\", async () => {\n        const LazyLogin = React.lazy(() => import(\"../LoginPage\"));\n\n        renderWithProviders(\n            <Suspense fallback={<div data-testid=\"loading\">Loading...</div>}>\n                <LazyLogin />\n            </Suspense>\n        );\n\n        await waitFor(() => {\n            // LoginPage should render some form or heading\n            expect(document.querySelector(\"form, h1, h2, [data-testid]\")).toBeTruthy();\n        }, { timeout: 5000 });\n    });\n\n    it(\"should lazy load EmployeesPage with Suspense\", async () => {\n        const LazyEmployees = React.lazy(() => import(\"../EmployeesPage\"));\n\n        renderWithProviders(\n            <Suspense fallback={<div data-testid=\"loading\">Loading...</div>}>\n                <LazyEmployees />\n            </Suspense>\n        );\n\n        await waitFor(() => {\n            const headings = screen.getAllByRole(\"heading\");\n            expect(headings.some(h =>\n                /Employees/i.test(h.textContent!) || /Nhân viên/i.test(h.textContent!)\n            )).toBe(true);\n        }, { timeout: 5000 });\n    });\n\n    it(\"should show fallback while page is loading\", async () => {\n        // Create a lazy component that simulates a slow import\n        let resolveImport: (value: any) => void;\n        const slowImport = new Promise<any>((resolve) => {\n            resolveImport = resolve;\n        });\n\n        const LazyComponent = React.lazy(() => slowImport);\n\n        renderWithProviders(\n            <Suspense fallback={<div data-testid=\"suspense-fallback\">Loading...</div>}>\n                <LazyComponent />\n            </Suspense>\n        );\n\n        // Fallback should be shown immediately while component is loading\n        expect(screen.getByTestId(\"suspense-fallback\")).toBeInTheDocument();\n\n        // Resolve the import with a simple component\n        resolveImport!({ default: () => <div data-testid=\"loaded-component\">Loaded</div> });\n\n        // After resolving, the component should render\n        await waitFor(() => {\n            expect(screen.getByTestId(\"loaded-component\")).toBeInTheDocument();\n        });\n    });\n\n    it(\"should handle multiple lazy pages without interference\", async () => {\n        const LazyDashboard = React.lazy(() => import(\"../DashboardPage\"));\n\n        const { unmount } = renderWithProviders(\n            <Suspense fallback={<div>Loading...</div>}>\n                <LazyDashboard />\n            </Suspense>\n        );\n\n        await waitFor(() => {\n            expect(screen.getByTestId(\"dashboard-title\")).toBeInTheDocument();\n        }, { timeout: 5000 });\n\n        unmount();\n\n        // Render a different lazy page after unmounting the first\n        const LazyEmployees = React.lazy(() => import(\"../EmployeesPage\"));\n\n        renderWithProviders(\n            <Suspense fallback={<div>Loading...</div>}>\n                <LazyEmployees />\n            </Suspense>\n        );\n\n        await waitFor(() => {\n            const headings = screen.getAllByRole(\"heading\");\n            expect(headings.length).toBeGreaterThan(0);\n        }, { timeout: 5000 });\n    });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/__tests__/LeaveBalancesPage.test.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":15,"column":26,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":15,"endColumn":29,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[514,517],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[514,517],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}