":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[12568,12571],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":372,"column":38,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":372,"endColumn":41,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[12644,12647],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[12644,12647],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":375,"column":51,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":375,"endColumn":54,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[12763,12766],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[12763,12766],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":406,"column":51,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":406,"endColumn":54,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[13983,13986],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[13983,13986],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":42,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { QueryClient, QueryClientProvider } from \"@tanstack/react-query\";\nimport { render, screen, fireEvent, waitFor } from \"@testing-library/react\";\nimport { describe, it, expect, vi, beforeEach } from \"vitest\";\n\nimport { ToastProvider } from \"../../components/ui/Toast\";\nimport * as api from \"../../lib/api\";\nimport AttendanceLogsPage from \"../AttendanceLogsPage\";\nimport LeaveRequestsPage from \"../LeaveRequestsPage\";\nimport PayrollPage from \"../PayrollPage\";\n\nimport type { PaginatedResponse, Employee } from \"../../lib/api/types\";\n\n/**\n * Integration tests for components using paginated API responses.\n *\n * These tests ensure that components properly handle PaginatedResponse<T> structure:\n * { data: T[], total: number, page: number, limit: number }\n *\n * Tests verify:\n * - Components correctly extract .data from paginated responses\n * - Array methods work correctly on extracted data\n * - Components gracefully handle undefined/null responses\n * - Components handle empty paginated responses\n */\n\n// Mock TanStack Router\nvi.mock(\"@tanstack/react-router\", () => ({\n  useNavigate: () => vi.fn(),\n  useLocation: () => ({ pathname: \"/\", search: \"\", hash: \"\" }),\n  Link: ({ to, children, ...props }: any) => <a href={to} {...props}>{children}</a>,\n}));\n\nvi.mock(\"../../lib/api\", () => ({\n  fetchEmployees: vi.fn(),\n  searchEmployees: vi.fn(),\n  fetchEmployeePayslips: vi.fn(),\n  fetchWorkspacePayslips: vi.fn(),\n  fetchWorkspaceAttendanceAdjustments: vi.fn(),\n  getCurrentWorkspaceId: vi.fn(() => \"test-ws-id\"),\n  fetchRawAttendanceLogs: vi.fn(),\n  fetchWorkspace: vi.fn(),\n  fetchWorkspaceLeaveRequests: vi.fn(),\n  fetchEmployeeLeaveBalances: vi.fn(),\n  fetchLeavePolicies: vi.fn(),\n  fetchMyPermissions: vi.fn(),\n  fetchLeaveTypes: vi.fn().mockResolvedValue([]),\n  // LeaveImportDialog mocks\n  uploadLeaveExcel: vi.fn(),\n  fetchLatestLeaveImport: vi.fn().mockResolvedValue(null),\n  getLeaveImportErrorsUrl: vi.fn().mockReturnValue(\"#\"),\n  getLeaveImportTemplateUrl: vi.fn().mockReturnValue(\"#\"),\n  downloadLeaveImportTemplate: vi.fn().mockResolvedValue(undefined),\n  downloadLeaveImportErrors: vi.fn().mockResolvedValue(undefined),\n}));\n\n// Helper to create mock paginated response\nconst createPaginatedResponse = <T,>(\n  data: T[],\n  options: { total?: number; page?: number; limit?: number } = {}\n): PaginatedResponse<T> => ({\n  data,\n  total: options.total ?? data.length,\n  page: options.page ?? 1,\n  limit: options.limit ?? 50,\n});\n\ndescribe(\"Pagination Integration Tests\", () => {\n  let queryClient: QueryClient;\n\n  beforeEach(() => {\n    vi.clearAllMocks();\n    queryClient = new QueryClient({\n      defaultOptions: {\n        queries: { retry: false, gcTime: 0, staleTime: 0 },\n      },\n    });\n    (api.fetchMyPermissions as any).mockResolvedValue({ permissions: [], roles: [] });\n  });\n\n  const renderWithProviders = (component: React.ReactElement) => {\n    return render(\n      <QueryClientProvider client={queryClient}>\n        <ToastProvider>\n          {component}\n        </ToastProvider>\n      </QueryClientProvider>\n    );\n  };\n\n  describe(\"PayrollPage Pagination\", () => {\n    it(\"should handle paginated employees response correctly\", async () => {\n      const mockEmployees: PaginatedResponse<Employee> = createPaginatedResponse(\n        [\n          {\n            id: \"emp-1\",\n            full_name: \"John Doe\",\n            employee_id_number: \"EMP001\",\n            workspace_id: \"ws-1\",\n            is_active: true,\n            hire_date: \"2025-01-01\",\n            created_at: \"2025-01-01T00:00:00Z\",\n            updated_at: \"2025-01-01T00:00:00Z\",\n          },\n        ],\n        { total: 1 }\n      );\n\n      (api.fetchEmployees as any).mockResolvedValue(mockEmployees);\n      (api.fetchWorkspacePayslips as any).mockResolvedValue(\n        createPaginatedResponse([])\n      );\n      (api.fetchWorkspaceAttendanceAdjustments as any).mockResolvedValue([]);\n\n      renderWithProviders(<PayrollPage />);\n\n      // Component should extract .data and work with array methods\n      expect(await screen.findByText(\"John Doe\")).toBeInTheDocument();\n    });\n\n    it(\"should handle empty paginated response in PayrollPage\", async () => {\n      (api.fetchEmployees as any).mockResolvedValue(\n        createPaginatedResponse([], { total: 0 })\n      );\n      (api.fetchWorkspacePayslips as any).mockResolvedValue(\n        createPaginatedResponse([])\n      );\n      (api.fetchWorkspaceAttendanceAdjustments as any).mockResolvedValue([]);\n\n      renderWithProviders(<PayrollPage />);\n\n      // Should not crash when rendering with empty paginated response\n      expect(() => {\n        renderWithProviders(<PayrollPage />);\n      }).not.toThrow();\n    });\n\n    it(\"should handle undefined paginated response in PayrollPage\", async () => {\n      (api.fetchEmployees as any).mockResolvedValue(undefined);\n      (api.fetchWorkspacePayslips as any).mockResolvedValue(undefined);\n      (api.fetchWorkspaceAttendanceAdjustments as any).mockResolvedValue([]);\n\n      // Should not crash when rendering with undefined paginated response\n      expect(() => {\n        renderWithProviders(<PayrollPage />);\n      }).not.toThrow();\n    });\n\n    it(\"should NOT crash when trying array methods on extracted data\", async () => {\n      const mockEmployees = createPaginatedResponse<Employee>(\n        [\n          {\n            id: \"emp-1\",\n            full_name: \"Alice\",\n            employee_id_number: \"EMP001\",\n            workspace_id: \"ws-1\",\n            is_active: true,\n            hire_date: \"2025-01-01\",\n            created_at: \"2025-01-01T00:00:00Z\",\n            updated_at: \"2025-01-01T00:00:00Z\",\n          },\n          {\n            id: \"emp-2\",\n            full_name: \"Bob\",\n            employee_id_number: \"EMP002\",\n            workspace_id: \"ws-1\",\n            is_active: true,\n            hire_date: \"2025-01-02\",\n            created_at: \"2025-01-02T00:00:00Z\",\n            updated_at: \"2025-01-02T00:00:00Z\",\n          },\n        ],\n        { total: 2 }\n      );\n\n      (api.fetchEmployees as any).mockResolvedValue(mockEmployees);\n      (api.fetchWorkspacePayslips as any).mockResolvedValue(\n        createPaginatedResponse([])\n      );\n      (api.fetchWorkspaceAttendanceAdjustments as any).mockResolvedValue([]);\n\n      // This should NOT throw \"TypeError: employees.forEach is not a function\"\n      expect(() => {\n        renderWithProviders(<PayrollPage />);\n      }).not.toThrow();\n\n      // Both employees should be rendered\n      expect(await screen.findByText(\"Alice\")).toBeInTheDocument();\n      expect(await screen.findByText(\"Bob\")).toBeInTheDocument();\n    });\n\n    it(\"should handle paginated response with pagination metadata\", async () => {\n      const mockEmployees = createPaginatedResponse<Employee>(\n        Array.from({ length: 50 }, (_, i) => ({\n          id: `emp-${i}`,\n          full_name: `Employee ${i}`,\n          employee_id_number: `EMP${String(i).padStart(3, \"0\")}`,\n          workspace_id: \"ws-1\",\n          is_active: true,\n          hire_date: \"2025-01-01\",\n          created_at: \"2025-01-01T00:00:00Z\",\n          updated_at: \"2025-01-01T00:00:00Z\",\n        })),\n        { total: 250, page: 1, limit: 50 }\n      );\n\n      (api.fetchEmployees as any).mockResolvedValue(mockEmployees);\n      (api.fetchWorkspacePayslips as any).mockResolvedValue(\n        createPaginatedResponse([])\n      );\n      (api.fetchWorkspaceAttendanceAdjustments as any).mockResolvedValue([]);\n\n      renderWithProviders(<PayrollPage />);\n\n      // Should handle all 50 items from first page\n      await waitFor(() => {\n        expect(screen.getByText(\"Employee 0\")).toBeInTheDocument();\n      });\n    });\n  });\n\n  describe(\"AttendanceLogsPage Pagination\", () => {\n    it(\"should handle paginated employees response in AttendanceLogsPage\", async () => {\n      const mockEmployees = createPaginatedResponse<Employee>(\n        [\n          {\n            id: \"emp-1\",\n            full_name: \"John Doe\",\n            employee_id_number: \"EMP001\",\n            workspace_id: \"ws-1\",\n            is_active: true,\n            hire_date: \"2025-01-01\",\n            created_at: \"2025-01-01T00:00:00Z\",\n            updated_at: \"2025-01-01T00:00:00Z\",\n          },\n        ]\n      );\n\n      (api.fetchEmployees as any).mockResolvedValue(mockEmployees);\n      (api.fetchWorkspace as any).mockResolvedValue({\n        id: \"ws-1\",\n        name: \"Test Workspace\",\n      });\n      (api.fetchRawAttendanceLogs as any).mockResolvedValue(\n        createPaginatedResponse([])\n      );\n\n      // Should not crash when rendering with paginated response\n      expect(() => {\n        renderWithProviders(<AttendanceLogsPage />);\n      }).not.toThrow();\n    });\n\n    it(\"should handle empty paginated response in AttendanceLogsPage\", async () => {\n      (api.fetchEmployees as any).mockResolvedValue(\n        createPaginatedResponse([], { total: 0 })\n      );\n      (api.fetchWorkspace as any).mockResolvedValue({\n        id: \"ws-1\",\n        name: \"Test Workspace\",\n      });\n      (api.fetchRawAttendanceLogs as any).mockResolvedValue(\n        createPaginatedResponse([])\n      );\n\n      // Should not crash when rendering with empty paginated response\n      expect(() => {\n        renderWithProviders(<AttendanceLogsPage />);\n      }).not.toThrow();\n    });\n  });\n\n  describe(\"LeaveRequestsPage Pagination\", () => {\n    it(\"should handle paginated employees response in LeaveRequestsPage\", async () => {\n      const mockEmployees = createPaginatedResponse<Employee>(\n        [\n          {\n            id: \"emp-1\",\n            full_name: \"John Doe\",\n            employee_id_number: \"EMP001\",\n            workspace_id: \"ws-1\",\n            is_active: true,\n            hire_date: \"2025-01-01\",\n            created_at: \"2025-01-01T00:00:00Z\",\n            updated_at: \"2025-01-01T00:00:00Z\",\n          },\n        ]\n      );\n\n      (api.fetchEmployees as any).mockResolvedValue(mockEmployees);\n      (api.fetchWorkspaceLeaveRequests as any).mockResolvedValue([]);\n      (api.fetchLeavePolicies as any).mockResolvedValue([]);\n\n      // Should not crash when rendering with paginated response\n      expect(() => {\n        renderWithProviders(<LeaveRequestsPage />);\n      }).not.toThrow();\n    });\n\n    it(\"should handle empty paginated response in LeaveRequestsPage\", async () => {\n      (api.fetchEmployees as any).mockResolvedValue(\n        createPaginatedResponse([], { total: 0 })\n      );\n      (api.fetchWorkspaceLeaveRequests as any).mockResolvedValue([]);\n      (api.fetchLeavePolicies as any).mockResolvedValue([]);\n\n      // Should not crash when rendering with paginated response\n      expect(() => {\n        renderWithProviders(<LeaveRequestsPage />);\n      }).not.toThrow();\n    });\n  });\n\n  describe(\"PaginatedResponse Edge Cases\", () => {\n    it(\"should handle response with null data array\", async () => {\n      const malformedResponse = {\n        data: null,\n        total: 0,\n        page: 1,\n        limit: 50,\n      } as any;\n\n      (api.fetchEmployees as any).mockResolvedValue(malformedResponse);\n      (api.fetchWorkspacePayslips as any).mockResolvedValue(\n        createPaginatedResponse([])\n      );\n      (api.fetchWorkspaceAttendanceAdjustments as any).mockResolvedValue([]);\n\n      // Component should handle gracefully with optional chaining and nullish coalescing\n      expect(() => {\n        renderWithProviders(<PayrollPage />);\n      }).not.toThrow();\n    });\n\n    it(\"should handle response missing data property\", async () => {\n      const malformedResponse = {\n        total: 0,\n        page: 1,\n        limit: 50,\n        // data property missing\n      } as any;\n\n      (api.fetchEmployees as any).mockResolvedValue(malformedResponse);\n      (api.fetchWorkspacePayslips as any).mockResolvedValue(\n        createPaginatedResponse([])\n      );\n      (api.fetchWorkspaceAttendanceAdjustments as any).mockResolvedValue([]);\n\n      expect(() => {\n        renderWithProviders(<PayrollPage />);\n      }).not.toThrow();\n    });\n\n    it(\"should handle very large paginated response\", async () => {\n      const largeEmployeeList = Array.from({ length: 500 }, (_, i) => ({\n        id: `emp-${i}`,\n        full_name: `Employee ${i}`,\n        employee_id_number: `EMP${String(i).padStart(3, \"0\")}`,\n        workspace_id: \"ws-1\",\n        is_active: true,\n        hire_date: \"2025-01-01\",\n        created_at: \"2025-01-01T00:00:00Z\",\n        updated_at: \"2025-01-01T00:00:00Z\",\n      }));\n\n      const mockEmployees = createPaginatedResponse(largeEmployeeList, {\n        total: 500,\n        page: 1,\n        limit: 50,\n      });\n\n      (api.fetchEmployees as any).mockResolvedValue(mockEmployees);\n      (api.fetchWorkspacePayslips as any).mockResolvedValue(\n        createPaginatedResponse([])\n      );\n      (api.fetchWorkspaceAttendanceAdjustments as any).mockResolvedValue([]);\n\n      // Should handle large response without performance issues\n      expect(() => {\n        renderWithProviders(<PayrollPage />);\n      }).not.toThrow();\n    });\n  });\n\n  describe(\"Correct vs Incorrect Usage Patterns\", () => {\n    it(\"should document correct pattern for accessing paginated response data\", () => {\n      const paginatedResponse: PaginatedResponse<{ id: string }> =\n        createPaginatedResponse([{ id: \"1\" }, { id: \"2\" }]);\n\n      // CORRECT PATTERN\n      const correctData = paginatedResponse?.data ?? [];\n      expect(Array.isArray(correctData)).toBe(true);\n      expect(() => correctData.forEach(() => { })).not.toThrow();\n\n      // This pattern ensures:\n      // 1. Optional chaining prevents null reference errors\n      // 2. Nullish coalescing provides empty array fallback\n      // 3. Array methods work correctly\n    });\n\n    it(\"should show why incorrect pattern caused the bug\", () => {\n      const paginatedResponse: PaginatedResponse<{ id: string }> =\n        createPaginatedResponse([{ id: \"1\" }]);\n\n      // INCORRECT PATTERN (what was happening before)\n      // Treating response object as array directly\n      const incorrectUsage = paginatedResponse as any;\n\n      // This would throw: TypeError: incorrectUsage.forEach is not a function\n      // because paginatedResponse is an object, not an array\n      expect(() => {\n        incorrectUsage.forEach(() => { });\n      }).toThrow();\n\n      // But the correct pattern works:\n      const correctData = paginatedResponse.data;\n      expect(() => {\n        correctData.forEach(() => { });\n      }).not.toThrow();\n    });\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/approvals/OtApprovalsPage.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Calendar' is defined but never used. Allowed unused vars must match /^_/u.","line":10,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":10,"endColumn":11,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Calendar"},"fix":{"range":[234,246],"text":""},"desc":"Remove unused variable \"Calendar\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'AlertCircle' is defined but never used. Allowed unused vars must match /^_/u.","line":11,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":11,"endColumn":14,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"AlertCircle"},"fix":{"range":[246,261],"text":""},"desc":"Remove unused variable \"AlertCircle\"."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":47,"column":41,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":47,"endColumn":44,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1661,1664],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1661,1664],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState } from \"react\";\n\nimport * as Popover from \"@radix-ui/react-popover\";\nimport { startOfMonth, endOfMonth, format, subMonths, addMonths } from \"date-fns\";\nimport {\n  CheckCircle,\n  XCircle,\n  ChevronLeft,\n  ChevronRight,\n  Calendar,\n  AlertCircle,\n  FileText,\n  Filter,\n  Upload\n} from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { BulkUploadOtDialog } from \"@/components/approvals/BulkUploadOtDialog\";\nimport { EnterPaperOtDialog } from \"@/components/approvals/EnterPaperOtDialog\";\nimport { MonthYearPicker } from \"@/components/common/MonthYearPicker\";\n\nimport { useAttendanceSummaries, useApproveOt } from \"@/hooks/use-attendance\";\nimport { cn } from \"@/lib/utils\";\n\ntype SourceFilter = \"all\" | \"paper_form\" | \"self_service\";\n\nexport default function OtApprovalsPage() {\n  const { t } = useTranslation();\n  const [currentMonth, setCurrentMonth] = useState(new Date());\n  const [paperOtDialogOpen, setPaperOtDialogOpen] = useState(false);\n  const [bulkUploadDialogOpen, setBulkUploadDialogOpen] = useState(false);\n  const [sourceFilter, setSourceFilter] = useState<SourceFilter>(\"all\");\n\n  const startDate = format(startOfMonth(currentMonth), \"yyyy-MM-dd\");\n  const endDate = format(endOfMonth(currentMonth), \"yyyy-MM-dd\");\n\n  const { summaries, isLoading, refetch } = useAttendanceSummaries(startDate, endDate);\n  const { approveOt, isProcessing } = useApproveOt();\n\n  const pendingSummaries = summaries\n    .filter(s => s.ot_status === \"pending_manager\")\n    .filter(s => {\n      if (sourceFilter === \"all\") return true;\n      return s.entered_via === sourceFilter;\n    });\n\n  const handleApprove = async (summary: any, approved: boolean) => {\n    try {\n        await approveOt({\n            employeeId: summary.employee_id,\n            date: summary.date,\n            approved_minutes: approved ? summary.claimed_ot_minutes : 0,\n            status: approved ? \"approved\" : \"rejected\",\n            manager_note: approved ? \"Approved via Manager Portal\" : \"Rejected via Manager Portal\"\n        });\n        refetch();\n    } catch (e) {\n        console.error(e);\n        alert(\"Action failed\");\n    }\n  };\n\n  const handleMonthYearChange = (month: number, year: number) => { setCurrentMonth(new Date(year, month - 1, 1)); };\n  const handlePrevMonth = () => setCurrentMonth(subMonths(currentMonth, 1));\n  const handleNextMonth = () => setCurrentMonth(addMonths(currentMonth, 1));\n\n  return (\n    <div className=\"space-y-10 animate-in fade-in duration-700 pb-20 p-8\">\n      <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-8\">\n        <div className=\"space-y-1\">\n          <h1 className=\"text-4xl font-bold tracking-tighter text-slate-700 dark:text-slate-200 uppercase leading-none\">{t(\"ot_approvals.title\")}</h1>\n          <p className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em] opacity-60\">{t(\"ot_approvals.subtitle\")}</p>\n        </div>\n\n        <div className=\"flex items-center gap-4\">\n          <button\n            onClick={() => setPaperOtDialogOpen(true)}\n            className=\"px-6 py-3 rounded-[1.5rem] bg-amber-50 dark:bg-amber-950 text-white text-xs font-bold uppercase tracking-wider shadow-lg hover:bg-amber-600 transition-all flex items-center gap-2\"\n          >\n            <FileText className=\"w-4 h-4\" />\n            {t(\"approvals.paper_ot.btn_enter\") || \"Enter Paper Form\"}\n          </button>\n\n          <button\n            onClick={() => setBulkUploadDialogOpen(true)}\n            className=\"px-6 py-3 rounded-[1.5rem] bg-blue-50 dark:bg-blue-950 text-white text-xs font-bold uppercase tracking-wider shadow-lg hover:bg-blue-600 transition-all flex items-center gap-2\"\n          >\n            <Upload className=\"w-4 h-4\" />\n            {t(\"approvals.bulk_upload.btn\") || \"Bulk Upload\"}\n          </button>\n\n          <div className=\"flex items-center gap-4 bg-white dark:bg-slate-900 p-2.5 rounded-[2.5rem] border border-slate-100 dark:border-slate-800 shadow-xl shadow-slate-900/5\">\n            <div className=\"flex items-center bg-slate-100 dark:bg-slate-700/50 rounded-[1.5rem] p-1.5 shadow-inner border border-slate-200 dark:border-slate-700/50\">\n              <button onClick={handlePrevMonth} className=\"w-12 h-12 flex items-center justify-center text-slate-500 dark:text-slate-400 hover:text-primary-600 dark:text-primary-400 hover:bg-white dark:hover:bg-slate-900 hover:shadow-md rounded-xl transition-all active:scale-90\"><ChevronLeft size={24} /></button>\n\n              <Popover.Root>\n                <Popover.Trigger asChild>\n                  <button className=\"px-10 flex flex-col items-center min-w-[200px] cursor-pointer hover:bg-white dark:hover:bg-slate-900 hover:shadow-md rounded-xl transition-all py-2 group outline-none border border-transparent hover:border-slate-100 dark:border-slate-800\">\n                    <span className=\"text-[8px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.3em] leading-none mb-1.5 group-hover:text-primary-500 dark:group-hover:text-primary-400 transition-colors\">{t(\"payroll.table.period\").toUpperCase()}</span>\n                    <span className=\"text-sm font-bold text-slate-700 dark:text-slate-200 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors uppercase tracking-tight\">\n                      {format(currentMonth, \"MMMM yyyy\")}\n                    </span>\n                  </button>\n                </Popover.Trigger>\n                <Popover.Portal>\n                  <Popover.Content className=\"z-50 w-80 p-4 rounded-[2.5rem] shadow-premium-2xl border border-slate-100 dark:border-slate-800 bg-white dark:bg-slate-900 animate-in zoom-in-95 slide-in-from-top-4 origin-top\" sideOffset={12} align=\"center\">\n                    <MonthYearPicker month={currentMonth.getMonth() + 1} year={currentMonth.getFullYear()} onChange={handleMonthYearChange} />\n                  </Popover.Content>\n                </Popover.Portal>\n              </Popover.Root>\n\n              <button onClick={handleNextMonth} className=\"w-12 h-12 flex items-center justify-center text-slate-500 dark:text-slate-400 hover:text-primary-600 dark:text-primary-400 hover:bg-white dark:hover:bg-slate-900 hover:shadow-md rounded-xl transition-all active:scale-90\"><ChevronRight size={24} /></button>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div className=\"flex items-center gap-4\">\n        <Filter size={16} className=\"text-slate-400 dark:text-slate-500\" />\n        <div className=\"flex gap-2\">\n          {([\"all\", \"paper_form\", \"self_service\"] as SourceFilter[]).map((filter) => (\n            <button\n              key={filter}\n              onClick={() => setSourceFilter(filter)}\n              className={cn(\n                \"px-4 py-2 rounded-xl text-[10px] font-bold uppercase tracking-wider transition-all\",\n                sourceFilter === filter\n                  ? \"bg-primary-600 text-white shadow-lg\"\n                  : \"bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:bg-slate-600\"\n              )}\n            >\n              {filter === \"all\" ? t(\"common.all\") : filter === \"paper_form\" ? t(\"approvals.filter.paper_forms\") : t(\"approvals.filter.self_service\")}\n            </button>\n          ))}\n        </div>\n      </div>\n\n      <EnterPaperOtDialog\n        open={paperOtDialogOpen}\n        onOpenChange={setPaperOtDialogOpen}\n        onSuccess={() => refetch()}\n      />\n\n      <BulkUploadOtDialog\n        open={bulkUploadDialogOpen}\n        onOpenChange={setBulkUploadDialogOpen}\n        onSuccess={() => refetch()}\n      />\n\n      <div className=\"bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-[3rem] overflow-hidden shadow-sm animate-in slide-in-from-bottom-8 duration-700\">\n        {isLoading ? (\n          <div className=\"p-32 flex flex-col items-center gap-6 animate-pulse\">\n            <div className=\"w-12 h-12 border-4 border-primary-600 border-t-transparent rounded-full animate-spin\"></div>\n            <span className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.3em]\">{t(\"common.loading\")}</span>\n          </div>\n        ) : pendingSummaries.length === 0 ? (\n          <div className=\"py-40 text-center flex flex-col items-center border-4 border-dashed border-slate-50 dark:border-slate-800 m-8 rounded-[3rem] bg-slate-50 dark:bg-slate-800/30\">\n            <div className=\"w-24 h-24 bg-white dark:bg-slate-900 rounded-full flex items-center justify-center shadow-xl border border-slate-100 dark:border-slate-800 mb-8\"><CheckCircle size={40} className=\"text-emerald-200\" /></div>\n            <h3 className=\"text-xl font-bold text-slate-700 dark:text-slate-200 uppercase tracking-tight\">{t(\"ot_approvals.empty_state.title\")}</h3>\n            <p className=\"text-slate-500 dark:text-slate-400 text-[10px] font-bold uppercase tracking-widest mt-2 opacity-50 italic\">{t(\"ot_approvals.empty_state.description\")}</p>\n          </div>\n        ) : (\n          <div className=\"overflow-x-auto\">\n            <table className=\"w-full text-left border-collapse\">\n              <thead>\n                <tr className=\"bg-slate-50 dark:bg-slate-800/50 border-b border-slate-100 dark:border-slate-800\">\n                  <th className=\"px-8 py-6 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em]\">{t(\"ot_approvals.table.date\")}</th>\n                  <th className=\"px-8 py-6 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em]\">{t(\"ot_approvals.table.employee\")}</th>\n                  <th className=\"px-8 py-6 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em]\">{t(\"ot_approvals.table.source\")}</th>\n                  <th className=\"px-8 py-6 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em] text-center\">{t(\"ot_approvals.table.system\")}</th>\n                  <th className=\"px-8 py-6 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em] text-center\">{t(\"ot_approvals.table.claimed\")}</th>\n                  <th className=\"px-8 py-6 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em]\">{t(\"ot_approvals.table.reason\")}</th>\n                  <th className=\"px-8 py-6 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em] text-right\">{t(\"ot_approvals.table.actions\")}</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-slate-50 dark:divide-slate-800\">\n                {pendingSummaries.map((summary) => (\n                  <tr key={summary.id} className=\"hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-all group\">\n                    <td className=\"px-8 py-6 font-bold text-slate-700 dark:text-slate-200\">{summary.date}</td>\n                    <td className=\"px-8 py-6 text-sm text-slate-600 dark:text-slate-300\">{summary.employee_id}</td>\n                    <td className=\"px-8 py-6\">\n                      <SourceBadge enteredVia={summary.entered_via} />\n                    </td>\n                    <td className=\"px-8 py-6 text-center text-sm font-mono text-slate-500 dark:text-slate-400\">{summary.system_detected_ot_minutes}m</td>\n                    <td className=\"px-8 py-6 text-center text-sm font-bold font-mono text-amber-600 dark:text-amber-300\">{summary.claimed_ot_minutes}m</td>\n                    <td className=\"px-8 py-6 text-sm text-slate-600 dark:text-slate-300 italic\">\"{summary.ot_reason}\"</td>\n                    <td className=\"px-8 py-6 text-right\">\n                      <div className=\"flex items-center justify-end gap-2\">\n                        <button\n                          onClick={() => handleApprove(summary, true)}\n                          disabled={isProcessing}\n                          className=\"p-2 rounded-full hover:bg-emerald-50 dark:bg-emerald-950 text-slate-400 dark:text-slate-500 hover:text-emerald-600 dark:text-emerald-300 transition-all disabled:opacity-50\"\n                          title={t(\"ot_approvals.actions.approve\")}\n                        >\n                          <CheckCircle className=\"w-5 h-5\" />\n                        </button>\n                        <button\n                          onClick={() => handleApprove(summary, false)}\n                          disabled={isProcessing}\n                          className=\"p-2 rounded-full hover:bg-rose-50 dark:bg-rose-950 text-slate-400 dark:text-slate-500 hover:text-rose-600 dark:text-rose-300 transition-all disabled:opacity-50\"\n                          title={t(\"ot_approvals.actions.reject\")}\n                        >\n                          <XCircle className=\"w-5 h-5\" />\n                        </button>\n                      </div>\n                    </td>\n                  </tr>\n                ))}\n              </tbody>\n            </table>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n}\n\nfunction SourceBadge({ enteredVia }: { enteredVia?: string }) {\n  const { t } = useTranslation();\n  if (enteredVia === \"paper_form\") {\n    return (\n      <span className=\"inline-flex items-center px-2.5 py-0.5 rounded-full text-[9px] font-bold uppercase tracking-wider bg-amber-100 dark:bg-amber-900 text-amber-700 dark:text-amber-300 border border-amber-200\">\n        {t(\"ot_approvals.badges.paper\")}\n      </span>\n    );\n  }\n  return (\n    <span className=\"inline-flex items-center px-2.5 py-0.5 rounded-full text-[9px] font-bold uppercase tracking-wider bg-slate-100 dark:bg-slate-700 text-slate-500 dark:text-slate-400 border border-slate-200 dark:border-slate-700\">\n      {t(\"ot_approvals.badges.self\")}\n    </span>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/ess/MyAttendancePage.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'CalendarDays' is defined but never used. Allowed unused vars must match /^_/u.","line":6,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":6,"endColumn":15,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"CalendarDays"},"fix":{"range":[181,194],"text":""},"desc":"Remove unused variable \"CalendarDays\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Clock' is defined but never used. Allowed unused vars must match /^_/u.","line":7,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":7,"endColumn":8