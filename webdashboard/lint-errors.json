over\";\nimport { startOfMonth, endOfMonth, format, subMonths, addMonths } from \"date-fns\";\nimport {\n  CalendarDays,\n  Clock,\n  MapPin,\n  ChevronLeft,\n  ChevronRight,\n  Info,\n  Calendar,\n  Activity,\n  History,\n  AlertCircle,\n  CheckCircle\n} from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { MonthYearPicker } from \"@/components/common/MonthYearPicker\";\nimport { ClaimOtDialog } from \"@/components/ess/ClaimOtDialog\";\n\nimport { useDateTimeFormatter } from \"@/hooks/use-datetime\";\nimport { useMyAttendance, useMyAttendanceSummaries  } from \"@/hooks/use-ess\";\nimport { AttendanceDailySummary } from \"@/lib/api/types\";\nimport { cn } from \"@/lib/utils\";\n\nexport default function MyAttendancePage() {\n\n  const { t } = useTranslation();\n\n  const { formatTime, formatDate } = useDateTimeFormatter();\n\n  const [currentMonth, setCurrentMonth] = useState(new Date());\n\n\n\n  const startDate = format(startOfMonth(currentMonth), \"yyyy-MM-dd\");\n  const endDate = format(endOfMonth(currentMonth), \"yyyy-MM-dd\");\n\n  const { entries, isLoading } = useMyAttendance({\n    start_date: startDate,\n    end_date: endDate,\n  });\n\n  const { summaries } = useMyAttendanceSummaries(startDate, endDate);\n  \n  const [selectedSummary, setSelectedSummary] = useState<AttendanceDailySummary | null>(null);\n  const [claimOpen, setClaimOpen] = useState(false);\n\n  const getSummary = (date: string) => summaries.find(s => s.date === date);\n\n\n\n  const handleMonthYearChange = (month: number, year: number) => { setCurrentMonth(new Date(year, month - 1, 1)); };\n\n  const handlePrevMonth = () => setCurrentMonth(subMonths(currentMonth, 1));\n\n  const handleNextMonth = () => setCurrentMonth(addMonths(currentMonth, 1));\n\n\n\n  return (\n\n    <div className=\"space-y-10 animate-in fade-in duration-700 pb-20\">\n\n      <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-8 px-2\">\n\n        <div className=\"space-y-1\">\n\n          <h1 className=\"text-4xl font-bold tracking-tighter text-slate-700 dark:text-slate-200 uppercase leading-none\">{t(\"ess.attendance.title\")}</h1>\n\n          <p className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em] opacity-60\">{t(\"ess.attendance.subtitle\")}</p>\n\n        </div>\n\n\n\n        <div className=\"flex items-center gap-4 bg-white dark:bg-slate-900 p-2.5 rounded-[2.5rem] border border-slate-100 dark:border-slate-800 shadow-xl shadow-slate-900/5\">\n\n          <div className=\"flex items-center bg-slate-100 dark:bg-slate-700/50 rounded-[1.5rem] p-1.5 shadow-inner border border-slate-200 dark:border-slate-700/50\">\n\n            <button onClick={handlePrevMonth} className=\"w-12 h-12 flex items-center justify-center text-slate-500 dark:text-slate-400 hover:text-primary-600 dark:text-primary-400 hover:bg-white dark:hover:bg-slate-900 hover:shadow-md rounded-xl transition-all active:scale-90\"><ChevronLeft size={24} /></button>\n\n            \n\n            <Popover.Root>\n\n              <Popover.Trigger asChild>\n\n                <button className=\"px-10 flex flex-col items-center min-w-[200px] cursor-pointer hover:bg-white dark:hover:bg-slate-900 hover:shadow-md rounded-xl transition-all py-2 group outline-none border border-transparent hover:border-slate-100 dark:border-slate-800\">\n\n                  <span className=\"text-[8px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.3em] leading-none mb-1.5 group-hover:text-primary-500 dark:group-hover:text-primary-400 transition-colors\">{t(\"payroll.table.period\").toUpperCase()}</span>\n\n                  <span className=\"text-sm font-bold text-slate-700 dark:text-slate-200 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors uppercase tracking-tight\">\n\n                    {format(currentMonth, \"MMMM yyyy\")}\n\n                  </span>\n\n                </button>\n\n              </Popover.Trigger>\n\n              <Popover.Portal>\n\n                <Popover.Content className=\"z-50 w-80 p-4 rounded-[2.5rem] shadow-premium-2xl border border-slate-100 dark:border-slate-800 bg-white dark:bg-slate-900 animate-in zoom-in-95 slide-in-from-top-4 origin-top\" sideOffset={12} align=\"center\">\n\n                  <MonthYearPicker month={currentMonth.getMonth() + 1} year={currentMonth.getFullYear()} onChange={handleMonthYearChange} />\n\n                </Popover.Content>\n\n              </Popover.Portal>\n\n            </Popover.Root>\n\n\n\n            <button onClick={handleNextMonth} className=\"w-12 h-12 flex items-center justify-center text-slate-500 dark:text-slate-400 hover:text-primary-600 dark:text-primary-400 hover:bg-white dark:hover:bg-slate-900 hover:shadow-md rounded-xl transition-all active:scale-90\"><ChevronRight size={24} /></button>\n\n          </div>\n\n        </div>\n\n      </div>\n\n\n\n      <div className=\"bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-[3rem] overflow-hidden shadow-sm animate-in slide-in-from-bottom-8 duration-700\">\n\n        {isLoading ? (\n\n          <div className=\"p-32 flex flex-col items-center gap-6 animate-pulse\">\n\n            <div className=\"w-12 h-12 border-4 border-primary-600 border-t-transparent rounded-full animate-spin\"></div>\n\n            <span className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.3em]\">{t(\"common.loading\")}</span>\n\n          </div>\n\n        ) : entries.length === 0 ? (\n\n          <div className=\"py-40 text-center flex flex-col items-center border-4 border-dashed border-slate-50 dark:border-slate-800 m-8 rounded-[3rem] bg-slate-50 dark:bg-slate-800/30\">\n\n            <div className=\"w-24 h-24 bg-white dark:bg-slate-900 rounded-full flex items-center justify-center shadow-xl border border-slate-100 dark:border-slate-800 mb-8\"><Calendar size={40} className=\"text-slate-200 dark:text-slate-700\" /></div>\n\n            <h3 className=\"text-xl font-bold text-slate-700 dark:text-slate-200 uppercase tracking-tight\">{t(\"ess.attendance.no_data\")}</h3>\n\n            <p className=\"text-slate-500 dark:text-slate-400 text-[10px] font-bold uppercase tracking-widest mt-2 opacity-50 italic\">{t(\"common.no_records_found\")}</p>\n\n          </div>\n\n        ) : (\n\n          <div className=\"overflow-x-auto\">\n\n            <table className=\"w-full text-left border-collapse\">\n\n              <thead>\n\n                <tr className=\"bg-slate-50 dark:bg-slate-800/50 border-b border-slate-100 dark:border-slate-800\">\n\n                  <th className=\"px-10 py-6 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em]\">{t(\"ess.attendance.date\")}</th>\n\n                  <th className=\"px-8 py-6 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em] text-center\">{t(\"common.in\")}</th>\n\n                  <th className=\"px-8 py-6 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em] text-center\">{t(\"common.out\")}</th>\n\n                  <th className=\"px-8 py-6 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em] text-center\">{t(\"ess.attendance.duration\")}</th>\n                  <th className=\"px-8 py-6 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em] text-center\">{t(\"ess.attendance.ot_status\")}</th>\n                  <th className=\"px-10 py-6 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em] text-right\">{t(\"common.status\")}</th>\n\n                </tr>\n\n              </thead>\n\n              <tbody className=\"divide-y divide-slate-50 dark:divide-slate-800\">\n\n                {entries.map((entry) => {\n                  const dateStr = format(new Date(entry.punch_in_time), \"yyyy-MM-dd\");\n                  const summary = getSummary(dateStr);\n                  \n                  return (\n                  <tr key={entry.id} className=\"hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-all group\">\n\n                    <td className=\"px-10 py-6\">\n\n                      <div className=\"flex items-center gap-6\">\n\n                        <div className=\"w-14 h-14 rounded-2xl bg-primary-50 dark:bg-primary-950 text-primary-600 dark:text-primary-400 flex items-center justify-center font-bold text-2xl shadow-inner border border-primary-100 dark:border-primary-800/50 group-hover:scale-110 transition-transform\">{format(new Date(entry.punch_in_time), \"dd\")}</div>\n\n                        <div>\n\n                          <div className=\"font-bold text-slate-700 dark:text-slate-200 text-sm tracking-tight uppercase leading-none mb-1.5\">{format(new Date(entry.punch_in_time), \"EEEE\")}</div>\n\n                          <div className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.2em] opacity-70 leading-none\">{formatDate(entry.punch_in_time)}</div>\n\n                        </div>\n\n                      </div>\n\n                    </td>\n\n                    <td className=\"px-8 py-6 text-center\">\n\n                      <div className=\"flex flex-col items-center gap-2\">\n\n                        <span className=\"text-sm font-bold font-mono text-slate-700 dark:text-slate-200 tracking-tighter\">{formatTime(entry.punch_in_time)}</span>\n\n                        <div className=\"w-1.5 h-1.5 bg-emerald-50 dark:bg-emerald-950 rounded-full shadow-sm shadow-emerald-500/50 animate-pulse\"></div>\n\n                      </div>\n\n                    </td>\n\n                    <td className=\"px-8 py-6 text-center\">\n\n                      {entry.punch_out_time ? (\n\n                        <div className=\"flex flex-col items-center gap-2\">\n\n                          <span className=\"text-sm font-bold font-mono text-slate-700 dark:text-slate-200 tracking-tighter\">{formatTime(entry.punch_out_time)}</span>\n\n                          <div className=\"w-1.5 h-1.5 bg-rose-50 dark:bg-rose-950 rounded-full shadow-sm shadow-rose-500/50\"></div>\n\n                        </div>\n\n                      ) : <span className=\"text-slate-300 dark:text-slate-600 font-bold tracking-widest italic text-[10px] uppercase opacity-50\">{t(\"ess.attendance.active_status\")}</span>}\n\n                    </td>\n\n                    <td className=\"px-8 py-6 text-center\">\n\n                      {entry.duration_minutes ? (\n\n                        <span className=\"inline-flex items-center px-3 py-1 rounded-xl bg-slate-100 dark:bg-slate-700/50 text-slate-600 dark:text-slate-300 text-[10px] font-bold uppercase tracking-widest border border-slate-200 dark:border-slate-700/50 shadow-inner\">{Math.floor(entry.duration_minutes / 60)}h {entry.duration_minutes % 60}m</span>\n\n                      ) : <span className=\"text-slate-300 dark:text-slate-600 font-bold\">-</span>}\n\n                    </td>\n\n\n                    <td className=\"px-8 py-6 text-center\">\n                        {summary && summary.system_detected_ot_minutes > 0 ? (\n                            <div className=\"flex flex-col items-center gap-1\">\n                                <span className=\"text-xs font-bold text-amber-600 dark:text-amber-300\">{t(\"ess.attendance.system_ot_suffix\", { minutes: summary.system_detected_ot_minutes })}</span>\n                                {summary.ot_status === \"pending_employee\" || (summary.ot_status === \"none\" && summary.system_detected_ot_minutes > 0) ? (\n                                    <button \n                                        onClick={() => { setSelectedSummary(summary); setClaimOpen(true); }}\n                                        className=\"text-[10px] font-bold uppercase tracking-wider bg-amber-100 dark:bg-amber-900 text-amber-700 dark:text-amber-300 px-2 py-1 rounded-lg hover:bg-amber-200 transition-colors\"\n                                    >\n                                        {t(\"ess.attendance.claim_btn\")}\n                                    </button>\n                                ) : (\n                                    <span className={cn(\n                                        \"text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full\",\n                                        summary.ot_status === \"approved\" ? \"bg-emerald-100 dark:bg-emerald-900 text-emerald-700 dark:text-emerald-300\" :\n                                        summary.ot_status === \"rejected\" ? \"bg-rose-100 dark:bg-rose-900 text-rose-700 dark:text-rose-300\" :\n                                        \"bg-slate-100 dark:bg-slate-700 text-slate-500 dark:text-slate-400\"\n                                    )}>\n                                        {summary.ot_status === \"pending_manager\" ? t(\"common.status_pending\") : summary.ot_status}\n                                    </span>\n                                )}\n                            </div>\n                        ) : (\n                            <span className=\"text-slate-300 dark:text-slate-600\">-</span>\n                        )}\n                    </td>\n                    <td className=\"px-10 py-6 text-right\">\n\n                      <div className=\"flex items-center justify-end gap-4\">\n\n                        <span className={cn(\"px-4 py-1.5 rounded-full text-[9px] font-bold uppercase tracking-widest border shadow-sm\", entry.punch_out_time ? \"bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-300 border-emerald-100 dark:border-emerald-800\" : \"bg-amber-50 dark:bg-amber-950 text-amber-600 dark:text-amber-300 border-amber-100 dark:border-amber-800 animate-pulse\")}>{entry.punch_out_time ? t(\"common.completed\").toUpperCase() : t(\"common.pending\").toUpperCase()}</span>\n\n                        {entry.generation_metadata && (\n\n                          <Popover.Root>\n\n                            <Popover.Trigger asChild>\n\n                              <button className=\"p-2.5 bg-white dark:bg-slate-900 text-slate-300 dark:text-slate-600 hover:text-primary-600 dark:text-primary-400 rounded-xl shadow-md border border-slate-100 dark:border-slate-800 transition-all active:scale-90 opacity-0 group-hover:opacity-100\"><Info size={18} /></button>\n\n                            </Popover.Trigger>\n\n                            <Popover.Portal>\n\n                              <Popover.Content className=\"z-50 w-96 bg-slate-900 rounded-[2.5rem] shadow-premium-2xl border border-white/10 p-8 animate-in fade-in zoom-in-95 duration-500\" side=\"left\" align=\"center\" sideOffset={16}>\n\n                                <div className=\"space-y-6\">\n\n                                  <div className=\"flex items-center gap-4 border-b border-white/10 pb-6\">\n\n                                    <div className=\"w-10 h-10 rounded-xl bg-primary-50 dark:bg-primary-950/10 flex items-center justify-center text-primary-400 shadow-inner border border-primary-500/20\"><Activity size={20} /></div>\n\n                                    <span className=\"text-[10px] font-bold uppercase tracking-[0.3em] text-white opacity-80\">{t(\"ess.attendance.generation_info\").toUpperCase()}</span>\n\n                                  </div>\n\n                                  <div className=\"bg-black/40 p-6 rounded-[1.5rem] border border-white/5 shadow-inner\">\n\n                                    <pre className=\"text-[11px] text-emerald-400 overflow-x-auto whitespace-pre-wrap font-mono leading-relaxed selection:bg-emerald-50 dark:bg-emerald-950/20\">{JSON.stringify(entry.generation_metadata, null, 2)}</pre>\n\n                                  </div>\n\n                                </div>\n\n                                <Popover.Arrow className=\"fill-slate-900\" width={20} height={10} />\n\n                              </Popover.Content>\n\n                            </Popover.Portal>\n\n                          </Popover.Root>\n\n                        )}\n\n                      </div>\n\n                    </td>\n\n                  </tr>\n\n                )\n                })}\n\n              </tbody>\n\n            </table>\n\n          </div>\n\n        )}\n\n      </div>\n      \n      <ClaimOtDialog open={claimOpen} onOpenChange={setClaimOpen} summary={selectedSummary} />\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/ess/MyClockPage.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'error' is defined but never used.","line":52,"column":14,"nodeType":"Identifier","messageId":"unusedVar","endLine":52,"endColumn":19},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'error' is defined but never used.","line":61,"column":14,"nodeType":"Identifier","messageId":"unusedVar","endLine":61,"endColumn":19},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'error' is defined but never used.","line":85,"column":14,"nodeType":"Identifier","messageId":"unusedVar","endLine":85,"endColumn":19}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState } from \"react\";\n\nimport { useQuery } from \"@tanstack/react-query\";\nimport { History } from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport {\n  AdjustmentRequestModal,\n  AdjustmentData,\n} from \"@/components/time-tracking/AdjustmentRequestModal\";\nimport { PunchCard } from \"@/components/time-tracking/PunchCard\";\nimport { TimeEntryRow } from \"@/components/time-tracking/TimeEntryRow\";\nimport { useToast } from \"@/components/ui/Toast\";\n\nimport { useMyProfile, useMyClock } from \"@/hooks/use-ess\";\nimport { fetchWorkspace, getCurrentWorkspaceId, submitAttendanceAdjustment } from \"@/lib/api\";\nimport { toUTCISO } from \"@/lib/datetime\";\n\n\nexport default function MyClockPage() {\n  const { t } = useTranslation();\n  const toast = useToast();\n  const wsId = getCurrentWorkspaceId();\n\n  const { employee, isLoading: isLoadingProfile } = useMyProfile();\n  const {\n    entries,\n    activeEntry,\n    isOnBreak,\n    isLoading: isLoadingClock,\n    punchIn,\n    punchOut,\n    isPunching,\n  } = useMyClock();\n\n  const { data: workspace } = useQuery({\n    queryKey: [\"workspace\", wsId],\n    queryFn: () => fetchWorkspace(wsId!),\n    enabled: !!wsId,\n  });\n\n  const [isAdjustmentModalOpen, setIsAdjustmentModalOpen] = useState(false);\n\n  const handlePunchIn = async (type: \"work\" | \"break\") => {\n    try {\n      await punchIn({ entry_type: type });\n      toast.success(\n        type === \"work\"\n          ? t(\"ess.clock.punch_in_success\")\n          : t(\"ess.clock.break_start_success\")\n      );\n    } catch (error) {\n      toast.error(t(\"common.error\"));\n    }\n  };\n\n  const handlePunchOut = async () => {\n    try {\n      await punchOut({});\n      toast.success(t(\"ess.clock.punch_out_success\"));\n    } catch (error) {\n      toast.error(t(\"common.error\"));\n    }\n  };\n\n  const handleAdjustmentSubmit = async (data: AdjustmentData) => {\n    if (!wsId || !employee) {\n      toast.error(t(\"common.error\"));\n      return;\n    }\n\n    try {\n      const tz = workspace?.timezone || \"UTC\";\n      const punchInTime = toUTCISO(data.date, data.punchIn, tz);\n      const punchOutTime = toUTCISO(data.date, data.punchOut, tz);\n\n      await submitAttendanceAdjustment(wsId, {\n        employee_id: employee.id,\n        time_entry_id: data.timeEntryId,\n        requested_punch_in_time: punchInTime,\n        requested_punch_out_time: punchOutTime,\n        reason: data.reason,\n      });\n      toast.success(t(\"ess.clock.adjustment_requested\"));\n    } catch (error) {\n      toast.error(t(\"common.error\"));\n    }\n  };\n\n  if (isLoadingProfile || isLoadingClock) {\n    return (\n      <div className=\"flex items-center justify-center min-h-[400px]\">\n        <div className=\"animate-spin rounded-full h-8 w-8 border-b-2 border-primary-600\"></div>\n      </div>\n    );\n  }\n\n  if (!employee) {\n    return (\n      <div className=\"p-8 text-center text-slate-500 dark:text-slate-400 font-bold italic\">\n        {t(\"common.no_profile\")}\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"space-y-10 animate-in fade-in duration-700 pb-20\">\n      {/* Header */}\n      <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-8 px-2\">\n        <div>\n          <h1 className=\"text-4xl font-bold tracking-tighter text-slate-700 dark:text-slate-200 uppercase leading-none\">\n            {t(\"ess.clock.title\")}\n          </h1>\n          <p className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em] opacity-60 mt-1.5\">\n            {t(\"ess.clock.subtitle\")}\n          </p>\n        </div>\n      </div>\n\n      {/* Main Content: 2 Columns on Desktop, Stack on Mobile */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8\">\n        {/* Left: Punch Card */}\n        <div className=\"lg:col-span-5\">\n          <PunchCard\n            activeEntry={activeEntry}\n            isOnBreak={isOnBreak}\n            userName={employee.full_name}\n            onPunchIn={handlePunchIn}\n            onPunchOut={handlePunchOut}\n            onRequestAdjustment={() => setIsAdjustmentModalOpen(true)}\n            isPunching={isPunching}\n          />\n        </div>\n\n        {/* Right: Quick History */}\n        <div className=\"lg:col-span-7 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-[40px] overflow-hidden shadow-sm flex flex-col\">\n          <div className=\"px-8 py-6 border-b border-slate-50 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/30 flex items-center justify-between\">\n            <div className=\"flex items-center gap-3\">\n              <History className=\"w-5 h-5 text-primary-500\" />\n              <h3 className=\"font-bold text-slate-800 dark:text-slate-100 uppercase tracking-widest text-xs\">\n                {t(\"ess.clock.recent_history\")}\n              </h3>\n            </div>\n          </div>\n          <div className=\"flex-1 overflow-y-auto max-h-[600px]\">\n            <table className=\"w-full text-left border-collapse\">\n              <thead className=\"sticky top-0 bg-white dark:bg-slate-900/80 backdrop-blur-md z-10 border-b border-slate-100 dark:border-slate-800\">\n                <tr>\n                  <th className=\"px-8 py-4 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">\n                    {t(\"common.date\")}\n                  </th>\n                  <th className=\"px-8 py-4 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">\n                    {t(\"common.in\")}\n                  </th>\n                  <th className=\"px-8 py-4 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">\n                    {t(\"common.out\")}\n                  </th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-slate-50 dark:divide-slate-800\">\n                {entries.length === 0 ? (\n                  <tr>\n                    <td\n                      colSpan={3}\n                      className=\"px-10 py-20 text-center text-slate-500 dark:text-slate-400 font-bold italic uppercase tracking-widest text-xs opacity-50\"\n                    >\n                      {t(\"ess.clock.no_entries\")}\n                    </td>\n                  </tr>\n                ) : (\n                  entries.map((entry) => (\n                    <TimeEntryRow\n                      key={entry.id}\n                      entry={entry}\n                      showAdjustButton={false}\n                    />\n                  ))\n                )}\n              </tbody>\n            </table>\n          </div>\n        </div>\n      </div>\n\n      {/* Adjustment Request Modal */}\n      <AdjustmentRequestModal\n        isOpen={isAdjustmentModalOpen}\n        onClose={() => setIsAdjustmentModalOpen(false)}\n        onSubmit={handleAdjustmentSubmit}\n        timezone={workspace?.timezone || \"UTC\"}\n      />\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/ess/MyProfilePage.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":144,"column":64,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":144,"endColumn":67,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[9014,9017],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[9014,9017],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":177,"column":58,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":177,"endColumn":61,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[12356,12359],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[12356,12359],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/workspace/webdashboard/src/pages/ess/MyProfilePage.tsx:51:7\n  49 |     if (profile) {\n  50 |       // eslint-disable-next-line react-hooks/set-state-in-effect\n> 51 |       setFormData({\n     |       ^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  52 |         phone: profile.phone || \"\", address: profile.address || \"\", date_of_birth: profile.date_of_birth || \"\",\n  53 |         gender: profile.gender || \"\", national_id: profile.national_id || \"\", bank_name: profile.bank_name || \"\",\n  54 |         bank_account_number: profile.bank_account_number || \"\", bank_branch: profile.bank_branch || \"\",","line":51,"column":7,"nodeType":null,"endLine":51,"endColumn":18,"suppressions":[{"kind":"directive","justification":""}]}],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState, useEffect } from \"react\";\n\nimport {\n  User as UserIcon,\n  Phone,\n  MapPin,\n  Calendar,\n  CreditCard,\n  Building2,\n  Users,\n  Plus,\n  Trash2,\n  Save,\n  AlertCircle,\n  ShieldCheck,\n} from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport Button from \"@/components/ui/Button\";\nimport { LABEL_BASE } from \"@/components/ui/FormField\";\nimport Modal from \"@/components/ui/Modal\";\nimport StatusBadge from \"@/components/ui/StatusBadge\";\nimport { useToast } from \"@/components/ui/Toast\";\n\nimport { useDateTimeFormatter } from \"@/hooks/use-datetime\";\nimport { useMyProfile, useEmergencyContacts } from \"@/hooks/use-ess\";\nimport { cn } from \"@/lib/utils\";\n\n\ntype TabType = \"personal\" | \"banking\" | \"emergency\";\n\nexport default function MyProfilePage() {\n  const { t } = useTranslation();\n  const toast = useToast();\n  const { formatDate } = useDateTimeFormatter();\n  const { employee, profile, isLoading, isError, updateProfile, isUpdating } = useMyProfile();\n  const { contacts, addContact, deleteContact, isAdding, isDeleting } = useEmergencyContacts();\n\n  const [activeTab, setActiveTab] = useState<TabType>(\"personal\");\n  const [formData, setFormData] = useState({\n    phone: \"\", address: \"\", date_of_birth: \"\", gender: \"\", national_id: \"\",\n    bank_name: \"\", bank_account_number: \"\", bank_branch: \"\",\n  });\n\n  const [isContactModalOpen, setIsContactModalOpen] = useState(false);\n  const [newContact, setNewContact] = useState({ contact_name: \"\", relationship: \"\", phone: \"\", is_primary: false });\n\n  useEffect(() => {\n    if (profile) {\n      // eslint-disable-next-line react-hooks/set-state-in-effect\n      setFormData({\n        phone: profile.phone || \"\", address: profile.address || \"\", date_of_birth: profile.date_of_birth || \"\",\n        gender: profile.gender || \"\", national_id: profile.national_id || \"\", bank_name: profile.bank_name || \"\",\n        bank_account_number: profile.bank_account_number || \"\", bank_branch: profile.bank_branch || \"\",\n      });\n    }\n  }, [profile]);\n\n  async function handleSubmit(e: React.FormEvent) {\n    e.preventDefault();\n    try {\n      await updateProfile(formData);\n      toast.success(t(\"ess.profile.update_success\"));\n    } catch (err) { console.error(err); }\n  }\n\n  async function handleAddContact(e: React.FormEvent) {\n    e.preventDefault();\n    try {\n      await addContact(newContact);\n      setNewContact({ contact_name: \"\", relationship: \"\", phone: \"\", is_primary: false });\n      setIsContactModalOpen(false);\n      toast.success(t(\"ess.emergency_contact.add_success\"));\n    } catch (err) { console.error(err); }\n  }\n\n  async function handleDeleteContact(contactId: string) {\n    if (!confirm(t(\"ess.emergency_contact.confirm_delete\"))) return;\n    try {\n      await deleteContact(contactId);\n      toast.success(t(\"ess.emergency_contact.delete_success\"));\n    } catch (err) { console.error(err); }\n  }\n\n  if (isLoading) return <div className=\"p-20 text-center\"><div className=\"w-10 h-10 border-4 border-primary-600 border-t-transparent rounded-full animate-spin mx-auto\"></div></div>;\n\n  if (isError || !employee) {\n    return (\n      <div className=\"p-8\"><div className=\"bg-rose-50 dark:bg-rose-950 border-2 border-rose-100 dark:border-rose-800 rounded-[3rem] p-12 flex items-center gap-8 shadow-2xl shadow-rose-100/50\">\n        <div className=\"bg-white dark:bg-slate-900 p-5 rounded-[1.5rem] shadow-sm border border-rose-100 dark:border-rose-800 text-rose-500\"><AlertCircle size={40} /></div>\n        <div><h3 className=\"text-2xl font-bold text-rose-900 uppercase tracking-tighter leading-none mb-2\">{t(\"ess.no_employee_linked\")}</h3><p className=\"font-bold text-rose-600 dark:text-rose-300 uppercase tracking-tight text-sm opacity-80\">{t(\"ess.contact_hr\")}</p></div>\n      </div></div>\n    );\n  }\n\n  return (\n    <div className=\"space-y-10 animate-in fade-in duration-700 pb-20\">\n      <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-8 px-2\">\n        <div className=\"space-y-1\">\n          <h1 className=\"text-4xl font-bold tracking-tighter text-slate-700 dark:text-slate-200 uppercase leading-none\">{t(\"ess.my_profile\")}</h1>\n          <p className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em] opacity-60\">{t(\"ess.profile.subtitle\")}</p>\n        </div>\n\n        <div className=\"flex bg-slate-100 dark:bg-slate-700/50 p-1.5 rounded-[22px] w-fit border border-slate-200 dark:border-slate-700/50 shadow-inner\">\n          <button onClick={() => setActiveTab(\"personal\")} className={cn(\"flex items-center gap-2 px-8 py-2.5 rounded-[18px] text-xs font-bold uppercase tracking-widest transition-all\", activeTab === 'personal' ? \"bg-white dark:bg-slate-900 text-primary-600 dark:text-primary-400 shadow-sm border border-slate-100 dark:border-slate-800\" : \"text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 dark:text-slate-700\")}><UserIcon size={14} /> {t(\"ess.personal_info\")}</button>\n          <button onClick={() => setActiveTab(\"banking\")} className={cn(\"flex items-center gap-2 px-8 py-2.5 rounded-[18px] text-xs font-bold uppercase tracking-widest transition-all\", activeTab === 'banking' ? \"bg-white dark:bg-slate-900 text-primary-600 dark:text-primary-400 shadow-sm border border-slate-100 dark:border-slate-800\" : \"text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 dark:text-slate-700\")}><CreditCard size={14} /> {t(\"ess.bank_details\")}</button>\n          <button onClick={() => setActiveTab(\"emergency\")} className={cn(\"flex items-center gap-2 px-8 py-2.5 rounded-[18px] text-xs font-bold uppercase tracking-widest transition-all\", activeTab === 'emergency' ? \"bg-white dark:bg-slate-900 text-primary-600 dark:text-primary-400 shadow-sm border border-slate-100 dark:border-slate-800\" : \"text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 dark:text-slate-700\")}><Users size={14} /> {t(\"ess.emergency_contacts\")}</button>\n        </div>\n      </div>\n\n      <div className=\"animate-in slide-in-from-bottom-8 duration-700\">\n        <div className=\"max-w-5xl bg-white dark:bg-slate-900 rounded-[3rem] border border-slate-100 dark:border-slate-800 shadow-sm overflow-hidden mb-10 group/hero\">\n          <div className=\"h-40 bg-slate-900 relative overflow-hidden\">\n             <div className=\"absolute inset-0 bg-gradient-to-br from-primary-600/40 via-indigo-600/20 to-transparent\" />\n             <div className=\"absolute top-0 left-0 w-full h-full opacity-10 pointer-events-none bg-[radial-gradient(circle_at_50%_50%,rgba(255,255,255,0.1)_0,transparent_50%)]\" />\n          </div>\n          <div className=\"px-12 pb-10\">\n            <div className=\"relative -mt-16 mb-8 flex items-end gap-8\">\n              <div className=\"w-32 h-32 rounded-[2.5rem] border-[10px] border-white shadow-2xl bg-primary-50 dark:bg-primary-950 flex items-center justify-center text-primary-600 dark:text-primary-400 font-bold text-3xl uppercase shadow-inner rotate-3 group-hover/hero:rotate-0 transition-transform duration-700\">\n                {employee.full_name[0]}\n              </div>\n              <div className=\"mb-2\">\n                <h2 className=\"text-3xl font-bold text-slate-700 dark:text-slate-200 tracking-tighter uppercase leading-none mb-2\">{employee.full_name}</h2>\n                <div className=\"flex flex-wrap gap-4 items-center\">\n                  <span className=\"text-[10px] font-bold text-primary-600 dark:text-primary-400 bg-primary-50 dark:bg-primary-950 px-3 py-1 rounded-full border border-primary-100 dark:border-primary-800 shadow-sm uppercase tracking-widest\">{t(\"common.employee_id\")}: {employee.employee_id_number}</span>\n                  <div className=\"w-1.5 h-1.5 bg-slate-200 dark:bg-slate-600 rounded-full\" />\n                  <span className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest opacity-70\">{t(\"common.hire_date\")}: {formatDate(employee.hire_date)}</span>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {activeTab === \"personal\" && (\n          <form onSubmit={handleSubmit} className=\"max-w-5xl bg-white dark:bg-slate-900 rounded-[3rem] border border-slate-100 dark:border-slate-800 shadow-sm p-12 space-y-12 animate-in fade-in duration-500\">\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-10\">\n              {[\n                { label: \"phone\", key: \"phone\", icon: Phone, type: \"tel\", placeholder: \"+84 xxx xxx xxx\" },\n                { label: \"date_of_birth\", key: \"date_of_birth\", icon: Calendar, type: \"date\" },\n                { label: \"national_id\", key: \"national_id\", icon: ShieldCheck, placeholder: \"xxx xxx xxx xxx\" }\n              ].map(field => (\n                <div key={field.key} className=\"space-y-3 px-1\">\n                  <label className={LABEL_BASE}><field.icon size={12} className=\"inline mr-2\" /> {t(`ess.${field.label}`)}</label>\n                  <input type={field.type} value={(formData as any)[field.key]} onChange={(e) => setFormData({ ...formData, [field.key]: e.target.value })} className=\"w-full px-6 py-4 bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-bold text-sm uppercase tracking-tight shadow-sm\" placeholder={field.placeholder} />\n                </div>\n              ))}\n              <div className=\"space-y-3 px-1\">\n                <label className={LABEL_BASE}>{t(\"ess.gender\")}</label>\n                <select value={formData.gender} onChange={(e) => setFormData({ ...formData, gender: e.target.value })} className=\"w-full px-6 py-4 bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-bold text-sm uppercase tracking-tight shadow-sm appearance-none cursor-pointer\">\n                  <option value=\"\">{t(\"common.select\").toUpperCase()}</option>\n                  <option value=\"male\">{t(\"ess.gender_male\").toUpperCase()}</option>\n                  <option value=\"female\">{t(\"ess.gender_female\").toUpperCase()}</option>\n                  <option value=\"other\">{t(\"ess.gender_other\").toUpperCase()}</option>\n                </select>\n              </div>\n              <div className=\"space-y-3 md:col-span-2 px-1\">\n                <label className={LABEL_BASE}><MapPin size={12} className=\"inline mr-2\" /> {t(\"ess.address\")}</label>\n                <textarea value={formData.address} onChange={(e) => setFormData({ ...formData, address: e.target.value })} rows={2} className=\"w-full px-6 py-4 bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-medium text-sm resize-none shadow-sm\" placeholder={t(\"ess.address_placeholder\")} />\n              </div>\n            </div>\n            <div className=\"pt-8 border-t border-slate-50 dark:border-slate-800 flex justify-end\">\n              <Button type=\"submit\" disabled={isUpdating} loading={isUpdating} icon={<Save size={18} />}>{isUpdating ? t(\"common.saving\").toUpperCase() : t(\"common.save\").toUpperCase()}</Button>\n            </div>\n          </form>\n        )}\n\n        {activeTab === \"banking\" && (\n          <form onSubmit={handleSubmit} className=\"max-w-5xl bg-white dark:bg-slate-900 rounded-[3rem] border border-slate-100 dark:border-slate-800 shadow-sm p-12 space-y-12 animate-in fade-in duration-500\">\n            <div className=\"grid grid-cols-1 md:grid-cols-3 gap-10\">\n              {[\n                { label: \"bank_name\", key: \"bank_name\", icon: Building2, placeholder: \"Vietcombank\" },\n                { label: \"account_number\", key: \"bank_account_number\", icon: CreditCard, placeholder: \"xxxx xxxx xxxx\" },\n                { label: \"bank_branch\", key: \"bank_branch\", icon: MapPin, placeholder: t(\"ess.branch_placeholder\") }\n              ].map(field => (\n                <div key={field.key} className=\"space-y-3 px-1\">\n                  <label className={LABEL_BASE}><field.icon size={12} className=\"inline mr-2\" /> {t(`ess.${field.label}`)}</label>\n                  <input type=\"text\" value={(formData as any)[field.key]} onChange={(e) => setFormData({ ...formData, [field.key]: e.target.value })} className=\"w-full px-6 py-4 bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-bold text-sm uppercase tracking-tight shadow-sm font-mono\" placeholder={field.placeholder} />\n                </div>\n              ))}\n            </div>\n            <div className=\"pt-8 border-t border-slate-50 dark:border-slate-800 flex justify-end\">\n              <Button type=\"submit\" disabled={isUpdating} loading={isUpdating} icon={<Save size={18} />}>{isUpdating ? t(\"common.saving\").toUpperCase() : t(\"common.save\").toUpperCase()}</Button>\n            </div>\n          </form>\n        )}\n\n        {activeTab === \"emergency\" && (\n          <div className=\"max-w-5xl bg-white dark:bg-slate-900 rounded-[3rem] border border-slate-100 dark:border-slate-800 shadow-sm p-12 space-y-10 animate-in fade-in duration-500\">\n            <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-6 px-2\">\n              <div className=\"flex items-center gap-5\">\n                <div className=\"w-14 h-14 rounded-2xl bg-rose-50 dark:bg-rose-950 flex items-center justify-center text-rose-600 dark:text-rose-300 shadow-inner border border-rose-100 dark:border-rose-800/50\"><Users size={28} /></div>\n                <div>\n                  <h3 className=\"text-2xl font-bold text-slate-700 dark:text-slate-200 tracking-tighter uppercase leading-none mb-1\">{t(\"ess.emergency_contacts\")}</h3>\n                  <p className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em] opacity-70\">{t(\"ess.emergency_contact.subtitle\")}</p>\n                </div>\n              </div>\n              <Button onClick={() => setIsContactModalOpen(true)} icon={<Plus size={18} />}>{t(\"ess.add_contact\").toUpperCase()}</Button>\n            </div>\n\n            {contacts.length === 0 ? (\n              <div className=\"py-32 text-center border-2 border-dashed border-slate-100 dark:border-slate-800 rounded-[3rem] bg-slate-50 dark:bg-slate-800/30 flex flex-col items-center\">\n                <div className=\"w-20 h-20 bg-white dark:bg-slate-900 rounded-full flex items-center justify-center shadow-sm mb-6 border border-slate-100 dark:border-slate-800\"><Users size={32} className=\"text-slate-200 dark:text-slate-700\" /></div>\n                <p className=\"text-[10px] font-bold text-slate-300 dark:text-slate-600 uppercase tracking-widest italic\">{t(\"ess.no_emergency_contacts\")}</p>\n              </div>\n            ) : (\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n                {contacts.map((contact) => (\n                  <div key={contact.id} className=\"flex items-center justify-between p-8 bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-[2.5rem] hover:bg-white dark:hover:bg-slate-900 hover:shadow-2xl hover:shadow-primary-100/10 transition-all group relative overflow-hidden shadow-inner\">\n                    <div className=\"flex items-center gap-6\">\n                      <div className=\"w-12 h-12 rounded-2xl bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 flex items-center justify-center text-slate-500 dark:text-slate-400 font-bold text-lg shadow-sm group-hover:bg-primary-50 dark:group-hover:bg-primary-950 group-hover:text-primary-600 dark:group-hover:text-primary-400 group-hover:border-primary-100 dark:border-primary-800 transition-all uppercase\">{contact.contact_name[0]}</div>\n                      <div>\n                        <div className=\"font-bold text-slate-700 dark:text-slate-200 text-sm tracking-tight flex items-center gap-3 uppercase leading-none mb-2\">\n                          {contact.contact_name}\n                          {contact.is_primary && <StatusBadge variant=\"primary\">{t(\"ess.primary\")}</StatusBadge>}\n                        </div>\n                        <div className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.2em] opacity-70\">{contact.relationship} • <span className=\"font-mono text-slate-500 dark:text-slate-400 font-bold\">{contact.phone}</span></div>\n                      </div>\n                    </div>\n                    <button type=\"button\" onClick={() => handleDeleteContact(contact.id)} disabled={isDeleting} className=\"p-3 bg-white dark:bg-slate-900 text-slate-300 dark:text-slate-600 hover:text-rose-600 dark:text-rose-300 rounded-xl shadow-md border border-slate-100 dark:border-slate-800 transition-all opacity-0 group-hover:opacity-100 active:scale-90\"><Trash2 size={18} /></button>\n                  </div>\n                ))}\n              </div>\n            )}\n          </div>\n        )}\n      </div>\n\n      <Modal isOpen={isContactModalOpen} onClose={() => setIsContactModalOpen(false)} title={t(\"ess.add_emergency_contact\")} icon={<Users size={24} />} maxWidth=\"md\">\n        <form onSubmit={handleAddContact} className=\"space-y-8 pt-4 animate-in fade-in duration-500\">\n          <div className=\"space-y-3 px-1\">\n            <label className={LABEL_BASE}>{t(\"ess.contact_name\")}</label>\n            <input type=\"text\" required value={newContact.contact_name} onChange={(e) => setNewContact({ ...newContact, contact_name: e.target.value })} className=\"w-full px-6 py-4 bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-bold text-sm uppercase tracking-tight shadow-sm\" />\n          </div>\n          <div className=\"grid grid-cols-2 gap-8\">\n            <div className=\"space-y-3 px-1\">\n              <label className={LABEL_BASE}>{t(\"ess.relationship\")}</label>\n              <select required value={newContact.relationship} onChange={(e) => setNewContact({ ...newContact, relationship: e.target.value })} className=\"w-full px-6 py-4 bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-bold text-sm uppercase tracking-tight shadow-sm appearance-none cursor-pointer\">\n                <option value=\"\">{t(\"common.select\").toUpperCase()}</option>\n                <option value=\"spouse\">{t(\"ess.relationship_spouse\").toUpperCase()}</option>\n                <option value=\"parent\">{t(\"ess.relationship_parent\").toUpperCase()}</option>\n                <option value=\"sibling\">{t(\"ess.relationship_sibling\").toUpperCase()}</option>\n                <option value=\"child\">{t(\"ess.relationship_child\").toUpperCase()}</option>\n                <option value=\"friend\">{t(\"ess.relationship_friend\").toUpperCase()}</option>\n                <option value=\"other\">{t(\"ess.relationship_other\").toUpperCase()}</option>\n              </select>\n            </div>\n            <div className=\"space-y-3 px-1\">\n              <label className={LABEL_BASE}>{t(\"ess.phone\")}</label>\n              <input type=\"tel\" required value={newContact.phone} onChange={(e) => setNewContact({ ...newContact, phone: e.target.value })} className=\"w-full px-6 py-4 bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-mono font-bold text-sm tracking-tighter shadow-sm\" />\n            </div>\n          </div>\n          <div className=\"flex items-center gap-4 py-2 px-2 group cursor-pointer\">\n            <input type=\"checkbox\" id=\"is_primary\" checked={newContact.is_primary} onChange={(e) => setNewContact({ ...newContact, is_primary: e.target.checked })} className=\"w-7 h-7 text-primary-600 dark:text-primary-400 rounded-xl border-slate-200 dark:border-slate-700 focus:ring-primary-500 transition-all cursor-pointer shadow-inner\" />\n            <label htmlFor=\"is_primary\" className=\"text-sm font-bold text-slate-700 dark:text-slate-200 uppercase tracking-widest cursor-pointer group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors\">{t(\"ess.set_as_primary\")}</label>\n          </div>\n          <div className=\"pt-6 grid grid-cols-2 gap-6 border-t border-slate-50 dark:border-slate-800\">\n            <Button variant=\"outline\" size=\"lg\" onClick={() => setIsContactModalOpen(false)}>{t(\"common.cancel\").toUpperCase()}</Button>\n            <Button variant=\"secondary\" size=\"lg\" type=\"submit\" disabled={isAdding} loading={isAdding}>{isAdding ? t(\"common.adding\").toUpperCase() : t(\"common.add\").toUpperCase()}</Button>\n          </div>\n        </form>\n      </Modal>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/ess/__tests__/MyAttendancePage.test.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":37,"column":25,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":37,"endColumn":28,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[929,932],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[929,932],"text":"ne