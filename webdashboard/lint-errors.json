 useTranslation } from \"react-i18next\";\n\nimport PaginationControls from \"@/components/common/PaginationControls\";\n\nimport { useMyPermissions } from \"@/hooks/use-permissions\";\nimport { Employee, Payslip } from \"@/lib/api/types\";\nimport { cn } from \"@/lib/utils\";\n\n\n\ninterface PayrollSummaryTableProps {\n  employees: Employee[];\n  payslips: Payslip[];\n  isLoading: boolean;\n  selectedIds: Set<string>;\n  onToggleSelect: (id: string) => void;\n  onToggleSelectAll: (ids?: string[]) => void;\n  onViewDetail: (employee: Employee) => void;\n  searchTerm: string;\n  onSearchChange: (val: string) => void;\n}\n\nexport default function PayrollSummaryTable({\n  employees,\n  payslips,\n  isLoading,\n  selectedIds,\n  onToggleSelect,\n  onToggleSelectAll,\n  onViewDetail,\n  searchTerm,\n  onSearchChange\n}: PayrollSummaryTableProps) {\n  const { t } = useTranslation();\n  const { hasPermission } = useMyPermissions();\n  const canReadSensitive = hasPermission(\"payroll:sensitive:read\");\n  \n  const [currentPage, setCurrentPage] = useState(1);\n  const [pageSize, setPageSize] = useState(20);\n\n  const payslipMap = React.useMemo(() => {\n    const map: Record<string, Payslip> = {};\n    payslips.forEach(p => { map[p.employee_id] = p; });\n    return map;\n  }, [payslips]);\n\n  const filteredEmployees = React.useMemo(() => {\n    return employees.filter(emp => \n      emp.full_name.toLowerCase().includes(searchTerm.toLowerCase()) ||\n      emp.employee_id_number.toLowerCase().includes(searchTerm.toLowerCase())\n    );\n  }, [employees, searchTerm]);\n\n  useEffect(() => {\n    // eslint-disable-next-line react-hooks/set-state-in-effect\n    setCurrentPage(1);\n  }, [searchTerm]);\n\n  const totalPages = Math.ceil(filteredEmployees.length / pageSize);\n  const paginatedEmployees = filteredEmployees.slice(\n    (currentPage - 1) * pageSize,\n    currentPage * pageSize\n  );\n\n  const currentPageIds = paginatedEmployees.map(e => e.id);\n  const isPageSelected = currentPageIds.length > 0 && currentPageIds.every(id => selectedIds.has(id));\n  const isAllFilteredSelected = filteredEmployees.length > 0 && filteredEmployees.every(e => selectedIds.has(e.id));\n\n  const handleSelectPage = () => {\n    if (isPageSelected) {\n      // Unselect only the current page items\n      currentPageIds.forEach(id => {\n        if (selectedIds.has(id)) onToggleSelect(id);\n      });\n    } else {\n      // Select only the current page items\n      currentPageIds.forEach(id => {\n        if (!selectedIds.has(id)) onToggleSelect(id);\n      });\n    }\n  };\n\n  const selectAllFiltered = () => {\n    onToggleSelectAll();\n  };\n\n\n  return (\n    <div className=\"bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-[2.5rem] overflow-hidden shadow-sm flex flex-col h-full animate-in fade-in duration-700\">\n      <div className=\"p-6 border-b border-slate-100 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/30 flex flex-col xl:flex-row xl:items-center justify-between gap-6 px-8\">\n        <div className=\"flex flex-col md:flex-row md:items-center gap-6 flex-1\">\n          <div className=\"relative group flex-1 max-w-lg\">\n            <Search className=\"absolute left-5 top-1/2 -translate-y-1/2 text-slate-500 dark:text-slate-400 w-4.5 h-4.5 group-focus-within:text-primary-500 dark:group-focus-within:text-primary-400 transition-colors\" />\n            <input type=\"text\" autoFocus aria-label={t(\"common.search\")} placeholder={t(\"payroll.search_placeholder\")} className=\"w-full pl-14 pr-6 py-3.5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-[1.5rem] outline-none focus:ring-4 focus:ring-primary-500/10 focus:border-primary-300 transition-all font-bold text-sm shadow-sm\" value={searchTerm} onChange={(e) => onSearchChange(e.target.value)} />\n          </div>\n          <div className=\"flex items-center gap-3\"><span className=\"text-[9px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.2em] bg-white dark:bg-slate-900 px-4 py-2 rounded-xl border border-slate-100 dark:border-slate-800 shadow-sm\">{filteredEmployees.length} {t(\"common.employees\")}</span></div>\n        </div>\n\n\n      </div>\n      {isLoading ? (\n        <div className=\"p-24 text-center text-slate-500 dark:text-slate-400 font-bold italic uppercase tracking-widest text-xs opacity-50\">{t(\"common.loading\")}</div>\n      ) : (\n        <>\n\n      {selectedIds.size > 0 && (\n        <div className=\"bg-primary-50 dark:bg-primary-950 px-8 py-3 border-b border-primary-100 dark:border-primary-800 flex items-center justify-between animate-in slide-in-from-top-2\">\n          <div className=\"flex items-center gap-3\">\n             <Info size={16} className=\"text-primary-600 dark:text-primary-400\" />\n             <p className=\"text-xs font-bold text-primary-900\">\n               {selectedIds.size === filteredEmployees.length \n                 ? t(\"payroll.selection.all_filtered_selected\", { count: selectedIds.size, defaultValue: `All ${selectedIds.size} employees in this list are selected.` })\n                 : t(\"payroll.selection.count_selected\", { count: selectedIds.size, defaultValue: `${selectedIds.size} employees selected.` })\n               }\n             </p>\n          </div>\n          {!isAllFilteredSelected && filteredEmployees.length > pageSize && (\n            <button \n              onClick={selectAllFiltered}\n              className=\"text-xs font-bold text-primary-600 dark:text-primary-400 uppercase tracking-widest hover:underline decoration-2 underline-offset-4\"\n            >\n              {t(\"payroll.selection.select_all_filtered\", { count: filteredEmployees.length, defaultValue: `Select all ${filteredEmployees.length} employees` })}\n            </button>\n          )}\n        </div>\n      )}\n\n      <div className=\"flex-1 overflow-auto scroll-smooth\">\n        <table className=\"w-full text-left border-collapse\">\n          <thead className=\"bg-slate-50 dark:bg-slate-800/50 sticky top-0 backdrop-blur-md z-10 border-b border-slate-100 dark:border-slate-800\">\n            <tr>\n              <th className=\"px-10 py-5 w-16\">\n                <button onClick={handleSelectPage} className={cn(\"w-6 h-6 rounded-xl border-2 flex items-center justify-center transition-all\", isPageSelected ? \"bg-primary-600 border-primary-600 text-white shadow-lg shadow-primary-100\" : \"border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 hover:border-primary-300\")}>\n                  {isPageSelected && <Check size={14} strokeWidth={4} />}\n                </button>\n              </th>\n              <th className=\"px-4 py-5 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">{t(\"employees.table.name\")}</th>\n              <th className=\"px-4 py-5 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest text-right\">{t(\"common.payroll.table.base_pay\")}</th>\n              <th className=\"px-4 py-5 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest text-right\">{t(\"common.payroll.table.overtime\")}</th>\n              <th className=\"px-4 py-5 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest text-right\">{t(\"common.payroll.table.bonus\")}</th>\n              <th className=\"px-4 py-5 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest text-right\">{t(\"common.payroll.table.net_pay\")}</th>\n              <th className=\"px-8 py-5 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest text-center\">{t(\"common.payroll.table.status\")}</th>\n              <th className=\"px-4 py-5 w-12 text-right pr-8\"></th>\n            </tr>\n          </thead>\n          <tbody className=\"divide-y divide-slate-50 dark:divide-slate-800\">\n            {paginatedEmployees.map(emp => {\n              const slip = payslipMap[emp.id];\n              const isSelected = selectedIds.has(emp.id);\n              return (\n                <tr key={emp.id} className={cn(\"group transition-all hover:bg-slate-50 dark:hover:bg-slate-800/50 cursor-pointer\", isSelected ? \"bg-primary-50 dark:bg-primary-950/30\" : \"\")} onClick={() => onViewDetail(emp)}>\n                  <td className=\"px-10 py-6\" onClick={(e) => e.stopPropagation()}>\n                    <button \n                      data-testid={`select-employee-${emp.id}`}\n                      onClick={() => onToggleSelect(emp.id)} \n                      className={cn(\"w-6 h-6 rounded-xl border-2 flex items-center justify-center transition-all\", isSelected ? \"bg-primary-600 border-primary-600 text-white shadow-lg shadow-primary-100\" : \"border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 group-hover:border-primary-300\")}\n                    >\n                      {isSelected && <Check size={14} strokeWidth={4} />}\n                    </button>\n                  </td>\n                  <td className=\"px-4 py-6\">\n                    <div className=\"flex items-center gap-4\">\n                      <div className=\"w-12 h-12 rounded-2xl bg-slate-100 dark:bg-slate-700 border border-slate-100 dark:border-slate-800 flex items-center justify-center font-bold text-slate-500 dark:text-slate-400 group-hover:bg-primary-50 dark:group-hover:bg-primary-950 group-hover:text-primary-600 dark:group-hover:text-primary-400 group-hover:border-primary-100 dark:border-primary-800 group-hover:shadow-md transition-all shadow-inner uppercase\">{emp.full_name[0]}</div>\n                      <div>\n                        <p className=\"font-bold text-slate-700 dark:text-slate-200 text-sm tracking-tight uppercase leading-tight\">{emp.full_name}</p>\n                        <p className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest mt-1 opacity-70 tracking-tighter font-mono leading-none\">{emp.employee_id_number}</p>\n                      </div>\n                    </div>\n                  </td>\n                  <td className=\"px-4 py-6 text-right font-mono text-sm font-bold text-slate-500 dark:text-slate-400\">\n                    {!canReadSensitive ? \"***\" : (slip ? new Intl.NumberFormat('vi-VN').format(parseFloat(slip.base_pay_amount)) : \"—\")}\n                  </td>\n                  <td className=\"px-4 py-6 text-right font-mono text-sm text-emerald-600 dark:text-emerald-300 font-bold\">\n                    {!canReadSensitive ? \"***\" : (slip && parseFloat(slip.overtime_pay_amount) > 0 ? `+${new Intl.NumberFormat('vi-VN').format(parseFloat(slip.overtime_pay_amount))}` : \"—\")}\n                  </td>\n                  <td className=\"px-4 py-6 text-right font-mono text-sm text-blue-600 dark:text-blue-300 font-bold\">\n                    {!canReadSensitive ? \"***\" : (slip && slip.incentives && slip.incentives.length > 0 \n                      ? `+${new Intl.NumberFormat('vi-VN').format(slip.incentives.reduce((acc, i) => acc + parseFloat(i.amount), 0))}` \n                      : \"—\")}\n                  </td>\n                  <td className=\"px-4 py-6 text-right\">\n                    <div className=\"font-bold text-primary-600 dark:text-primary-400 text-base tracking-tighter font-mono\">\n                      {!canReadSensitive ? \"***\" : (slip ? new Intl.NumberFormat('vi-VN').format(parseFloat(slip.net_pay_amount)) : \"—\")}\n                    </div>\n                  </td>\n                  <td className=\"px-8 py-6 text-center\">\n                    {slip ? (\n                      <span className={cn(\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[9px] font-bold uppercase tracking-widest border shadow-sm\", slip.status === 'paid' ? \"bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-300 border-emerald-100 dark:border-emerald-800\" : \"bg-blue-50 dark:bg-blue-950 text-blue-600 dark:text-blue-300 border-blue-100 dark:border-blue-800\")}>\n                        {slip.status === 'paid' ? <CheckCircle2 size={12} /> : <AlertCircle size={12} />}\n                        {slip.status === 'paid' ? t(\"common.payroll.status.paid\") : t(\"common.payroll.status.finalized\")}\n                      </span>\n                    ) : (\n                      <span className=\"inline-flex items-center gap-1.5 px-3 py-1 bg-slate-100 dark:bg-slate-700 text-slate-500 dark:text-slate-400 rounded-full text-[9px] font-bold uppercase tracking-widest border border-slate-200 dark:border-slate-700 opacity-60\"><Calculator size={12} /> {t(\"common.pending\")}</span>\n                    )}\n                  </td>\n                  <td className=\"px-4 py-6 text-right pr-8\"><ChevronRight size={18} className=\"ml-auto text-slate-200 dark:text-slate-700 transition-all group-hover:text-primary-500 dark:group-hover:text-primary-400 group-hover:translate-x-1\" /></td>\n                </tr>\n              );\n            })}\n          </tbody>\n        </table>\n        {filteredEmployees.length === 0 && (\n          <div className=\"py-32 text-center border-2 border-dashed border-slate-100 dark:border-slate-800 m-8 rounded-[3rem] bg-slate-50 dark:bg-slate-800/30 flex flex-col items-center\">\n            <div className=\"w-20 h-20 bg-white dark:bg-slate-900 rounded-full flex items-center justify-center shadow-sm mb-4 border border-slate-100 dark:border-slate-800\"><User size={32} className=\"text-slate-200 dark:text-slate-700\" /></div>\n            <h3 className=\"text-lg font-bold text-slate-700 dark:text-slate-200\">{t(\"employees.search.no_results\")}</h3>\n            <p className=\"text-slate-500 dark:text-slate-400 text-sm mt-1 uppercase font-bold tracking-widest opacity-50\">{t(\"common.no_records_found\")}</p>\n          </div>\n        )}\n      </div>\n\n      <div className=\"p-4 border-t border-slate-100 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/30 flex justify-center\">\n        <PaginationControls \n          currentPage={currentPage}\n          totalPages={totalPages}\n          onPageChange={setCurrentPage}\n          pageSize={pageSize}\n          totalItems={filteredEmployees.length}\n          onPageSizeChange={setPageSize}\n        />\n      </div>\n        </>\n      )}\n    </div>\n  );\n}\n\nfunction Check({ size, strokeWidth }: { size: number, strokeWidth: number }) {\n  return (\n    <svg \n      width={size} \n      height={size} \n      viewBox=\"0 0 24 24\" \n      fill=\"none\" \n      stroke=\"currentColor\" \n      strokeWidth={strokeWidth} \n      strokeLinecap=\"round\" \n      strokeLinejoin=\"round\"\n    >\n      <polyline points=\"20 6 9 17 4 12\" />\n    </svg>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/payroll/PayrollTable.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'CheckCircle2' is defined but never used. Allowed unused vars must match /^_/u.","line":5,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":5,"endColumn":15,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"CheckCircle2"},"fix":{"range":[106,119],"text":""},"desc":"Remove unused variable \"CheckCircle2\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'AlertCircle' is defined but never used. Allowed unused vars must match /^_/u.","line":6,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":6,"endColumn":14,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"AlertCircle"},"fix":{"range":[118,134],"text":""},"desc":"Remove unused variable \"AlertCircle\"."}]},{"ruleId":"jsx-a11y/click-events-have-key-events","severity":2,"message":"Visible, non-interactive elements with click handlers must have at least one keyboard listener.","line":80,"column":13,"nodeType":"JSXOpeningElement","endLine":80,"endColumn":357},{"ruleId":"jsx-a11y/no-static-element-interactions","severity":2,"message":"Avoid non-native interactive elements. If using native HTML is not possible, add an appropriate role and support for tabbing, mouse, keyboard, and touch inputs to an interactive content element.","line":80,"column":13,"nodeType":"JSXOpeningElement","endLine":80,"endColumn":357}],"suppressedMessages":[],"errorCount":4,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from \"react\";\n\nimport * as Popover from '@radix-ui/react-popover';\nimport { \n  CheckCircle2, \n  AlertCircle, \n  ChevronDown, \n  History,\n  Info,\n  Banknote,\n  Target,\n  Clock,\n  Briefcase,\n  Calculator,\n  ArrowDownRight,\n  Calendar,\n  AlertTriangle,\n  Sparkles, FileText \n} from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { useDateTimeFormatter } from \"@/hooks/use-datetime\";\nimport { useMyPermissions } from \"@/hooks/use-permissions\";\nimport { Employee, Workspace, Payslip, AttendanceAdjustmentRequest, PayrollSegment  } from \"@/lib/api/types\";\nimport { cn } from \"@/lib/utils\";\n\nimport { PayrollPriorityLegend } from \"./PayrollPriorityLegend\";\nimport PayslipModal from \"./PayslipModal\";\n\ninterface PayrollTableProps {\n  employee: Employee | null;\n  workspace: Workspace | null;\n  payslips: Payslip[];\n  isLoading: boolean;\n  adjustments: AttendanceAdjustmentRequest[];\n  onResolveAdjustments: () => void;\n}\n\nexport default function PayrollTable({\n  employee,\n  workspace, \n  payslips, \n  isLoading, \n  adjustments,\n  onResolveAdjustments\n}: PayrollTableProps) {\n  const [selectedPayslip, setSelectedPayslip] = useState<Payslip | null>(null);\n  const [isModalOpen, setIsModalOpen] = useState(false);\n  const { t } = useTranslation();\n  const { formatMonthYear } = useDateTimeFormatter();\n  const [expandedId, setExpandedId] = useState<string | null>(null);\n  const { hasPermission } = useMyPermissions();\n  const canReadSensitive = hasPermission(\"payroll:sensitive:read\");\n\n  if (isLoading) return <div className=\"p-20 text-center text-slate-500 dark:text-slate-400 font-bold italic animate-pulse uppercase tracking-widest text-xs opacity-50\">{t(\"common.loading\")}</div>;\n\n  if (payslips.length === 0) {\n    return (\n      <div className=\"py-24 text-center border-2 border-dashed border-slate-100 dark:border-slate-800 rounded-[2.5rem] bg-slate-50 dark:bg-slate-800/30 dark:bg-slate-800/30 flex flex-col items-center\">\n        <div className=\"w-20 h-20 bg-white dark:bg-slate-900 rounded-full flex items-center justify-center shadow-sm dark:shadow-black/10 mb-6 border border-slate-100 dark:border-slate-800\">\n          <History size={32} className=\"text-slate-200 dark:text-slate-600\" />\n        </div>\n        <p className=\"text-[10px] font-bold text-slate-300 dark:text-slate-600 uppercase tracking-widest\">{t(\"common.payroll.table.no_payslips\")}</p>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"flex flex-col gap-6 animate-in fade-in duration-700\">\n      {payslips.map((slip) => {\n        const isExpanded = expandedId === slip.id;\n        const slipAdjustments = adjustments.filter(adj => \n          adj.employee_id === slip.employee_id && \n          new Date(adj.requested_date) >= new Date(slip.period_start) &&\n          new Date(adj.requested_date) <= new Date(slip.period_end)\n        );\n\n        return (\n          <div key={slip.id} data-testid={`payslip-card-${slip.id}`} className={cn(\"group bg-white dark:bg-slate-900 border transition-all duration-500 overflow-hidden\", isExpanded ? \"border-primary-200 dark:border-primary-800 rounded-[2.5rem] shadow-2xl shadow-primary-100/20 dark:shadow-black/20\" : \"border-slate-100 dark:border-slate-800 hover:border-primary-100 dark:border-primary-800 rounded-[2rem] shadow-sm dark:shadow-black/10 hover:shadow-lg hover:shadow-primary-100/10\")}>\n            <div data-testid={`toggle-card-${slip.id}`} className={cn(\"p-8 flex items-center justify-between cursor-pointer transition-colors\", isExpanded ? \"bg-primary-50 dark:bg-primary-950/30 dark:bg-primary-950/30\" : \"hover:bg-slate-50 dark:hover:bg-slate-800/50 dark:hover:bg-slate-800/50\")} onClick={() => setExpandedId(isExpanded ? null : slip.id)}>\n              <div className=\"flex items-center gap-8\">\n                <div className={cn(\"w-14 h-14 rounded-2xl flex items-center justify-center transition-all shadow-inner border\", isExpanded ? \"bg-primary-600 text-white border-primary-500\" : \"bg-slate-50 dark:bg-slate-800 text-slate-500 dark:text-slate-400 border-slate-100 dark:border-slate-800 group-hover:bg-white dark:group-hover:bg-slate-900 group-hover:text-primary-600 dark:group-hover:text-primary-400 group-hover:border-primary-100 dark:border-primary-800\")}>\n                  <Calendar size={24} />\n                </div>\n                <div>\n                  <p className=\"text-lg font-bold text-slate-700 dark:text-slate-200 tracking-tight leading-none mb-2 uppercase\">{t(\"common.month\")} {formatMonthYear(slip.period_start)}</p>\n                  <div className=\"flex items-center gap-3\">\n                    <span className={cn(\"text-[9px] font-bold uppercase tracking-widest px-2.5 py-1 rounded-full border shadow-sm\", slip.status === 'paid' ? \"bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-300 border-emerald-100 dark:border-emerald-800\" : \"bg-blue-50 dark:bg-blue-950 text-blue-600 dark:text-blue-300 border-blue-100 dark:border-blue-800\")}>{slip.status === 'paid' ? t(\"common.payroll.status.paid\") : t(\"common.payroll.status.finalized\")}</span>\n                    <div className=\"w-1 h-1 bg-slate-200 dark:bg-slate-600 rounded-full\" />\n                    <span className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest opacity-70\">{slip.standard_units} Units • {slip.overtime_units} OT</span>\n                  </div>\n                </div>\n              </div>\n\n              <button \n                onClick={(e) => { \n                  e.stopPropagation(); \n                  setSelectedPayslip(slip); \n                  setIsModalOpen(true); \n                }} \n                className=\"hidden md:flex items-center gap-2 px-4 py-2 bg-slate-50 dark:bg-slate-800 text-slate-500 dark:text-slate-400 rounded-xl border border-slate-100 dark:border-slate-800 hover:bg-white dark:hover:bg-slate-900 hover:text-primary-600 dark:text-primary-400 hover:border-primary-200 dark:border-primary-800 hover:shadow-md transition-all active:scale-95 group/btn\"\n              >\n                <FileText size={14} className=\"text-slate-300 dark:text-slate-600 group-hover/btn:text-primary-500 transition-colors\" />\n                <span className=\"text-[9px] font-bold uppercase tracking-widest\">Official Payslip</span>\n              </button>\n              <div className=\"flex items-center gap-10 pr-2\">\n                <div className=\"text-right\">\n                  <p className=\"text-[9px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest leading-none mb-1.5 opacity-60\">{t(\"common.payroll.table.net_pay\")}</p>\n                  <p className=\"text-2xl font-bold text-primary-600 dark:text-primary-400 tracking-tighter font-mono\">{!canReadSensitive ? \"***\" : new Intl.NumberFormat('vi-VN').format(parseFloat(slip.net_pay_amount))}</p>\n                </div>\n                <div className={cn(\"w-10 h-10 rounded-xl flex items-center justify-center border transition-all shadow-sm\", isExpanded ? \"bg-white dark:bg-slate-900 border-primary-200 dark:border-primary-800 text-primary-600 dark:text-primary-400 rotate-180\" : \"bg-white dark:bg-slate-900 border-slate-100 dark:border-slate-800 text-slate-300 dark:text-slate-600 group-hover:text-primary-400\")}>\n                  <ChevronDown size={20} />\n                </div>\n              </div>\n            </div>\n\n            {isExpanded && (\n              <div className=\"px-8 pb-10 animate-in fade-in slide-in-from-top-4 duration-500\">\n                <div className=\"h-px bg-gradient-to-r from-transparent via-slate-100 to-transparent mb-10\" />\n                \n                {slipAdjustments.length > 0 && (\n                  <div data-testid={`pending-adj-banner-${slip.id}`} className=\"px-10 py-6 bg-amber-50 dark:bg-amber-950 border-y border-amber-100 dark:border-amber-800/50 flex items-center justify-between animate-in slide-in-from-top-4 duration-500 mb-8 rounded-2xl\">\n                    <div className=\"flex items-center gap-4\">\n                      <div className=\"w-12 h-12 bg-white dark:bg-slate-900 rounded-2xl flex items-center justify-center text-amber-500 shadow-sm border border-amber-100 dark:border-amber-800\"><AlertTriangle size={24} /></div>\n                      <div>\n                        <p className=\"text-sm font-bold text-amber-900 uppercase tracking-tight\">{t(\"payroll.traceability.pending_adjustments\")}</p>\n                        <p className=\"text-[10px] text-amber-700 dark:text-amber-300 font-bold uppercase tracking-widest opacity-70 mt-0.5\">{t(\"payroll.traceability.recalc_needed\")}</p>\n                      </div>\n                    </div>\n                    <button onClick={onResolveAdjustments} className=\"px-6 py-2.5 bg-amber-50 dark:bg-amber-950 text-white rounded-xl text-[10px] font-bold uppercase tracking-widest hover:bg-amber-600 transition-all shadow-lg shadow-amber-200 active:scale-95\">{t(\"payroll.traceability.view_adjustments\")}</button>\n                  </div>\n                )}\n\n                <div className=\"space-y-8 relative\">\n                  <div className=\"absolute left-[27px] top-6 bottom-6 w-0.5 bg-slate-100 dark:bg-slate-700\" />\n                  {slip.segments?.map((seg, idx) => (\n                    <SegmentCard \n                      key={idx} \n                      segment={seg} \n                      index={idx} \n                      isLast={idx === (slip.segments?.length || 0) - 1} \n                      canReadSensitive={canReadSensitive}\n                    />\n                  ))}\n                </div>\n\n                {slip.incentives && slip.incentives.length > 0 && (\n                  <div className=\"mt-12 space-y-6\">\n                    <div className=\"flex items-center gap-3 px-2\">\n                      <div className=\"w-1.5 h-6 bg-blue-600 rounded-full\" />\n                      <span className=\"text-xs font-bold text-slate-800 dark:text-slate-100 uppercase tracking-[0.25em]\">{t(\"common.payroll.table.bonus\")} Detail</span>\n                    </div>\n                    <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                      {slip.incentives.map((inc, i) => (\n                        <div key={i} className=\"flex items-center justify-between p-6 bg-blue-50 dark:bg-blue-950/30 border border-blue-100 dark:border-blue-800/50 rounded-2xl\">\n                          <div className=\"flex items-center gap-4\">\n                            <div className=\"w-10 h-10 rounded-xl bg-white dark:bg-slate-900 flex items-center justify-center text-blue-600 dark:text-blue-300 shadow-sm border border-blue-100 dark:border-blue-800\">\n                              <Sparkles size={18} />\n                            </div>\n                            <span className=\"text-xs font-bold text-slate-700 dark:text-slate-200 uppercase tracking-tight\">{inc.policy_name}</span>\n                          </div>\n                          <span className=\"text-sm font-bold text-blue-600 dark:text-blue-300 font-mono tracking-tighter\">{!canReadSensitive ? \"***\" : `+${new Intl.NumberFormat('vi-VN').format(parseFloat(inc.amount))}`}</span>\n                        </div>\n                      ))}\n                    </div>\n                  </div>\n                )}\n\n                <div className=\"mt-12 grid grid-cols-1 md:grid-cols-4 gap-6 pt-10 border-t border-slate-50 dark:border-slate-800\">\n                  {[\n                    { label: t(\"common.payroll.table.base_pay\"), value: slip.base_pay_amount, color: \"text-slate-700 dark:text-slate-200\" },\n                    { label: t(\"common.payroll.table.overtime\"), value: slip.overtime_pay_amount, color: \"text-emerald-600 dark:text-emerald-300\", prefix: \"+\" },\n                    { \n                      label: t(\"common.payroll.table.bonus\"), \n                      value: slip.incentives?.reduce((acc, i) => acc + parseFloat(i.amount), 0).toString() || \"0\", \n                      color: \"text-blue-600 dark:text-blue-300\", \n                      prefix: \"+\" \n                    },\n                    { label: \"Deductions\", value: slip.deductions_amount, color: \"text-rose-600 dark:text-rose-300\", prefix: \"-\" }\n                  ].map((stat, i) => (\n                    <div key={i} className=\"p-6 bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-[2rem] shadow-inner flex flex-col gap-1\">\n                       <p className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.2em]\">{stat.label}</p>\n                       <p className={cn(\"text-xl font-bold font-mono tracking-tighter\", stat.color)}>{!canReadSensitive ? \"***\" : `${stat.prefix || ''}${new Intl.NumberFormat('vi-VN').format(parseFloat(stat.value))}`}</p>\n                    </div>\n                  ))}\n                </div>\n              </div>\n            )}\n          </div>\n        );\n      })}\n\n      {/* Payslip Modal */}\n      {employee && selectedPayslip && (\n        <PayslipModal\n          isOpen={isModalOpen}\n          onClose={() => {\n            setIsModalOpen(false);\n            setSelectedPayslip(null);\n          }}\n          employee={employee}\n          payslip={selectedPayslip}\n          workspace={workspace}\n        />\n      )}\n    </div>\n  );\n}\n\nfunction SegmentCard({ segment, index, canReadSensitive }: { segment: PayrollSegment, index: number, isLast: boolean, canReadSensitive: boolean }) {\n  const { t } = useTranslation();\n  const { formatDate } = useDateTimeFormatter();\n\n  return (\n    <div className=\"relative pl-16\">\n      <div className={cn(\"absolute left-5 top-2 w-4 h-4 rounded-full border-[3px] border-white z-10 shadow-md ring-4\", index === 0 ? \"bg-primary-600 ring-primary-50\" : \"bg-slate-200 dark:bg-slate-600 ring-slate-50\")} />\n\n      <div className=\"bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-[2rem] p-8 hover:shadow-2xl hover:shadow-primary-100/10 transition-all group/card relative\">\n        <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-6 mb-8\">\n          <div className=\"flex items-center gap-4\">\n             <div className=\"w-10 h-10 bg-slate-50 dark:bg-slate-800 rounded-xl flex items-center justify-center text-slate-300 dark:text-slate-600 group-hover/card:text-primary-600 dark:text-primary-400 group-hover/card:bg-primary-50 dark:bg-primary-950 transition-all border border-slate-100 dark:border-slate-800 shadow-inner\">\n               <ArrowDownRight size={18} />\n             </div>\n             <div>\n               <p className=\"text-[9px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em] leading-none mb-1.5\">{t(\"common.segment\")} {index + 1}</p>\n               <p className=\"text-sm font-bold text-slate-700 dark:text-slate-200 uppercase tracking-tight\">{formatDate(segment.start_date)} — {formatDate(segment.end_date)}</p>\n             </div>\n          </div>\n          <span className={cn(\"text-[9px] font-bold uppercase tracking-[0.2em] px-3 py-1 rounded-lg border shadow-sm\", segment.reason === 'Standard' ? \"bg-white dark:bg-slate-900 text-slate-500 dark:text-slate-400 border-slate-100 dark:border-slate-800\" : \"bg-primary-50 dark:bg-primary-950 text-primary-600 dark:text-primary-400 border-primary-100 dark:border-primary-800\")}>{segment.reason || \"Proration\"}</span>\n        </div>\n\n        <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-10\">\n          <div className=\"space-y-6\">\n            <div className=\"flex items-center gap-3 mb-2 px-1 opacity-60\"><Target size={14} className=\"text-slate-500 dark:text-slate-400\" /><span className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em]\">Configuration Applied</span></div>\n            <div className=\"grid grid-cols-2 gap-6\">\n              <div className=\"bg-slate-50 dark:bg-slate-800/50 p-5 rounded-[1.5rem] border border-slate-100 dark:border-slate-800 shadow-inner\">\n                <p className=\"text-[9px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest mb-2 opacity-70\">Base Salary</p>\n                <div className=\"flex items-center gap-2 text-slate-700 dark:text-slate-200 font-bold font-mono text-sm tracking-tighter\">\n                  <Banknote size={14} className=\"text-primary-500 opacity-50\" /> {!canReadSensitive ? \"***\" : new Intl.NumberFormat('vi-VN').format(segment.applied_base_salary)}\n                </div>\n              </div>\n              <div className=\"bg-slate-50 dark:bg-slate-800/50 p-5 rounded-[1.5rem] border border-slate-100 dark:border-slate-800 shadow-inner\">\n                <p className=\"text-[9px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest mb-2 opacity-70\">Std. Period</p>\n                <div className=\"flex items-center gap-3\">\n                  <span className=\"text-sm font-bold text-slate-700 dark:text-slate-200 uppercase tracking-tighter\">{segment.applied_std_days} Days</span>\n                  {segment.std_days_source && (\n                    <Popover.Root>\n                      <Popover.Trigger asChild><button className=\"p-1.5 rounded-lg bg-white dark:bg-slate-900 shadow-sm border border-slate-100 dark:border-slate-800 text-slate-300 dark:text-slate-600 hover:text-primary-600 dark:text-primary-400 transition-all\"><Info size={12} /></button></Popover.Trigger>\n                      <Popover.Portal><Popover.Content className=\"z-50 w-80 bg-transparent animate-in zoom-in-95 duration-300 origin-bottom\" side=\"top\" sideOffset={12} align=\"center\"><PayrollPriorityLegend activeSource={segment.std_days_source} /></Popover.Content></Popover.Portal>\n                    </Popover.Root>\n                  )}\n                </div>\n              </div>\n            </div>\n            <div className=\"flex items-center gap-4 px-2\">\n              <div className=\"flex items-center gap-2\"><Clock size={12} className=\"text-slate-300 dark:text-slate-600\" /><span className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">{segment.applied_hours_per_day}h / day</span></div>\n              <div className=\"w-1 h-1 bg-slate-200 dark:bg-slate-600 rounded-full\" />\n              <div className=\"flex items-center gap-2\"><Briefcase size={12} className=\"text-slate-300 dark:text-slate-600\" /><span className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest italic opacity-60\">Dept: Global</span></div>\n            </div>\n          </div>\n\n          <div className=\"space-y-6\">\n            <div className=\"flex items-center gap-3 mb-2 px-1 opacity-60\"><Calculator size={14} className=\"text-slate-500 dark:text-slate-400\" /><span className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em]\">Calculation Outcome</span></div>\n            <div className=\"bg-primary-600 rounded-[1.5rem] p-6 text-white shadow-xl shadow-primary-100 dark:shadow-black/30 relative overflow-hidden group/out\">\n              <div className=\"flex items-center justify-between relative z-10\">\n                <div>\n                  <p className=\"text-[9px] font-bold text-primary-200 uppercase tracking-widest mb-1 opacity-80\">Paid Days</p>\n                  <p className=\"text-xl font-bold tracking-tighter\">{segment.paid_work_days} <span className=\"text-xs text-primary-300 font-bold\">/ {segment.actual_work_days}</span></p>\n                </div>\n                <div className=\"h-10 w-px bg-white dark:bg-slate-900/10\" />\n                <div className=\"text-right\">\n                  <p className=\"text-[9px] font-bold text-primary-200 uppercase tracking-widest mb-1 opacity-80\">Segment Net</p>\n                  <p className=\"text-xl font-bold font-mono tracking-tighter\">{!canReadSensitive ? \"***\" : new Intl.NumberFormat('vi-VN').format(segment.amount)}</p>\n                </div>\n              </div>\n              <Calculator className=\"absolute -right-4 -bottom-4 w-20 h-20 text-white opacity-5 -rotate-12 transition-transform group-hover/out:rotate-0 duration-700\" />\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/payroll/PayslipDocument.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/payroll/PayslipModal.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Download' is defined but never used. Allowed unused vars must match /^_/u.","line":4,"column":22,"nodeType":"Identifier","messageId":"unusedVar","endLine":4,"endColumn":30,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Download"},"fix":{"range":[122,132],"text":""},"desc":"Remove unused variable \"Download\"."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useRef, useCallback } from 'react';\n\nimport * as Dialog from '@radix-ui/react-dialog';\nimport { X, Printer, Download } from 'lucide-react';\nimport { useTranslation } from 'react-i18next';\n\nimport { useDateTimeFormatter } from '@/hooks/use-datetime';\nimport { Employee, Payslip, Workspace } from '@/lib/api/types';\n\nimport PayslipDocument from './PayslipDocument';\n\ninterface PayslipModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  employee: Employee;\n  payslip: Payslip;\n  workspace: Workspace | null;\n}\n\nexport default function PayslipModal({\n  isOpen,\n  onClose,\n  employee,\n  payslip,\n  workspace\n}: PayslipModalProps) {\n  const { t } = useTranslation();\n  const { formatMonthYear } = useDateTimeFormatter();\n  const printRef = useRef<HTMLDivElement>(null);\n\n  const handlePrint = useCallback(() => {\n    if (!printRef.current) return;\n\n    // Create a new window for printing\n    const printWindow = window.open('', '_blank', 'width=600,height=800');\n    if (!printWindow) {\n      alert('Please allow pop-ups to print the payslip.');\n      return;\n    }\n\n    // Get the payslip content\n    const content = printRef.current.innerHTML;\n\n    // Write the print document with A5 page size\n    printWindow.document.write(`\n      <!DOCTYPE html>\n      <html>\n        <head>\n          <title>Payslip - ${employee.full_name}</title>\n          <style>\n            @page {\n              size: A5 portrait;\n              margin: 5mm;\n            }\n\n            * {\n              margin: 0;\n              padding: 0;\n              box-sizing: border-box;\n            }\n\n            body {\n              font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n              font-size: 7px;\n              line-height: 1.3;\n              color: #0f172a;\n              background: white;\n              -webkit-print-color-adjust: exact;\n              print-color-adjust: exact;\n            }\n\n            /* A5 container - fit content on single page */\n            .payslip-container {\n              width: 138mm;\n              max-height: 200mm;\n              padding: 3mm;\n              background: white;\n              overflow: hidden;\n            }\n\n            /* Override PayslipDocument padding */\n            #payslip-document {\n              padding: 4mm !important;\n              max-width: 100% !important;\n            }\n\n            /* Typography */\n            .font-bold { font-weight: 600; }\n            .font-bold { font-weight: 500; }\n            .uppercase { text-transform: uppercase; }\n            .italic { font-style: italic; }\n            .text-center { text-align: center; }\n            .text-right { text-align: right; }\n            .text-left { text-align: left; }\n\n            /* Text sizes - compact for A5 single page */\n            .text-5xl { font-size: 16px; }\n            .text-4xl { font-size: 12px; }\n            .text-2xl { font-size: 10px; }\n            .text-xl { font-size: 9px; }\n            .text-sm { font-size: 7px; }\n            [class*=\"text-[10px]\"] { font-size: 6px; }\n            [class*=\"text-[9px]\"] { font-size: 5px; }\n            [class*=\"text-[8px]\"] { font-size: 4px; }\n\n            /* Colors */\n            .text-slate-700 dark:text-slate-200 { color: #0f172a; }\n            .text-slate-500 dark:text-slate-400 { color: #64748b; }\n            .text-slate-500 dark:text-slate-400 { color: #94a3b8; }\n            .text-slate-300 dark:text-slate-600 { color: #cbd5e1; }\n            .text-emerald-700 dark:text-emerald-300 { color: #047857; }\n            .text-emerald-600 dark:text-emerald-300 { color: #059669; }\n            .text-rose-600 dark:text-rose-300 { color: #e11d48; }\n            .text-amber-700 dark:text-amber-300 { color: #b45309; }\n\n            .bg-white dark:bg-slate-900 { background: white; }\n            .bg-slate-900 { background: #0f172a; }\n            .bg-slate-50 dark:bg-slate-800 { background: #f8fafc; }\n            .bg-emerald-50 dark:bg-emerald-950 { background: #ecfdf5; }\n            .bg-amber-50 dark:bg-amber-950 { background: #fffbeb; }\n\n            /* Layout */\n            .flex { display: flex; }\n            .grid { display: grid; }\n            .items-center { align-items: center; }\n            .items-start { align-items: start; }\n            .justify-between { justify-content: space-between; }\n            .justify-end { justify-content: flex-end; }\n            .gap-2 { gap: 2px; }\n            .gap-3 { gap: 3px; }\n            .gap-4 { gap: 4px; }\n            .gap-6 { gap: 6px; }\n            .gap-12 { gap: 10px; }\n            .space-y-1 > * + * { margin-top: 1px; }\n            .space-y-2 > * + * { margin-top: 2px; }\n            .space-y-3 > * + * { margin-top: 3px; }\n            .space-y-4 > * + * { margin-top: 4px; }\n            .space-y-6 > * + * { margin-top: 6px; }\n            .space-y-8 > * + * { margin-top: 8px; }\n\n            .grid-cols-2 { grid-template-columns: repeat(2, 1fr); }\n            [class*=\"grid-cols-[100px\"] { grid-template-columns: 45px 1fr; }\n            [class*=\"grid-cols-[1fr_250px]\"] { grid-template-columns: 1fr 80px; }\n\n            /* Compact spacing for single page */\n            .p-3 { padding: 3px; }\n            .p-4 { padding: 4px; }\n            .p-8 { padding: 6px; }\n            .p-16 { padding: 8px; }\n            .px-3 { padding-left: 3px; padding-right: 3px; }\n            .py-1 { padding-top: 1px; padding-bottom: 1px; }\n            .py-4 { padding-top: 3px; padding-bottom: 3px; }\n            .pb-2 { padding-bottom: 2px; }\n            .pb-4 { padding-bottom: 4px; }\n            .pb-10 { padding-bottom: 8px; }\n            .pt-2 { padding-top: 2px; }\n            .pt-4 { padding-top: 4px; }\n            .pt-8 { padding-top: 6px; }\n            .pt-10 { padding-top: 8px; }\n            .mb-1 { margin-bottom: 1px; }\n            .mb-4 { margin-bottom: 4px; }\n            .mb-6 { margin-bottom: 6px; }\n            .mb-10 { margin-bottom: 8px; }\n            .mb-12 { margin-bottom: 10px; }\n            .mt-2 { margin-top: 2px; }\n            .mt-20 { margin-top: 12px; }\n\n            /* Borders */\n            .border { border: 1px solid #e2e8f0; }\n            .border-t { border-top: 1px solid #e2e8f0; }\n            .border-b { border-bottom: 1px solid #e2e8f0; }\n            .border-b-2 { border-bottom: 1px solid; }\n            .border-t-2 { border-top: 1px solid; }\n            .border-slate-900 { border-color: #0f172a; }\n            .border-slate-100 dark:border-slate-800 { border-color: #f1f5f9; }\n            .border-slate-200 dark:border-slate-700 { border-color: #e2e8f0; }\n            .border-slate-50 dark:border-slate-800 { border-color: #f8fafc; }\n            .border-emerald-100 dark:border-emerald-800 { border-color: #d1fae5; }\n            .border-amber-100 dark:border-amber-800 { border-color: #fef3c7; }\n\n            /* Border radius - smaller for compact */\n            .rounded-full { border-radius: 9999px; }\n            .rounded-xl { border-radius: 4px; }\n            .rounded-3xl { border-radius: 8px; }\n\n            /* Icons - smaller */\n            .w-12 { width: 16px; }\n            .h-12 { height: 16px; }\n            [class*=\"w-1.5\"] { width: 2px; }\n            [class*=\"h-1.5\"] { height: 2px; }\n\n            /* Table */\n            table { width: 100%; border-collapse: collapse; }\n            .divide-y > * + * { border-top: 1px solid #f8fafc; }\n\n            /* Tracking - reduced */\n            .tracking-tight { letter-spacing: -0.01em; }\n            .tracking-tighter { letter-spacing: -0.02em; }\n            .tracking-widest { letter-spacing: 0.05em; }\n            [class*=\"tracking-[0.2em]\"] { letter-spacing: 0.1em; }\n            [class*=\"tracking-[0.3em]\"] { letter-spacing: 0.12em; }\n            [class*=\"tracking-[0.5em]\"] { letter-spacing: 0.15em; }\n\n            .leading-none { line-height: 1; }\n\n            /* Hide SVG icons for print */\n            svg { display: none; }\n\n            /* Opacity */\n            .opacity-50 { opacity: 1; }\n\n            /* Hide footer for compact fit */\n            footer { margin-top: 6px !important; padding-top: 4px !important; }\n          </style>\n        </head>\n        <body>\n          <div class=\"payslip-container\">\n            ${content}\n          </div>\n        </body>\n      </html>\n    `);\n\n    printWindow.document.close();\n\n    // Wait for content to load, then print\n    printWindow.onload = () => {\n      printWindow.focus();\n      printWindow.print();\n      printWindow.close();\n    };\n\n    // Fallback for browsers that don't fire onload\n    setTimeout(() => {\n      if (!printWindow.closed) {\n        printWindow.focus();\n        printWindow.print();\n        printWindow.close();\n      }\n    }, 500);\n  }, [employee.full_name]);\n\n  return (\n    <Dialog.Root open={isOpen} onOpenChange={onClose}>\n      <Dialog.Portal>\n        <Dialog.Overlay className='fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[100] animate-in fade-in duration-300 print:hidden' />\n        <Dialog.Content data-testid=\"payslip-modal\" className='fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-[900px] max-h-[90vh] bg-slate-100 dark:bg-slate-700 rounded-[2rem] shadow-2xl z-[101] overflow-hidden flex flex-col animate-in zoom-in-95 duration-300 print:static print:translate-x-0 print:translate-y-0 print:max-h-none print:w-auto print:bg-white dark:bg-slate-900 print:shadow-none print:rounded-none'>\n          \n          <Dialog.Title className=\"sr-only\">Official Payslip Preview</Dialog.Title>\n          <Dialog.Description className=\"sr-only\">\n            Preview of the payslip for {employee.full_name} for the period starting {formatMonthYear(payslip.period_start)}\n          </Dialog.Description>\n\n          {/* Action Bar */}\n          <div className='p-6 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-700 flex items-center justify-between print:hidden'>\n            <div className='flex items-center gap-4'>\n              <div>\n                <h2 className='text-sm font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400'>Official Payslip Preview</h2>\n                <p className='text-xs font-bold text-slate-600 dark:text-slate-300 mt-1'>\n                  {t('common.month')} {formatMonthYear(payslip.period_start)}\n                </p>\n              </div>\n            </div>\n            <div className='flex items-center gap-3'>\n              <button\n                onClick={handlePrint}\n                data-testid=\"payslip-print-btn\"\n                className='flex items-center gap-2 px-6 py-2.5 bg-slate-900 text-white rounded-xl text-[10px] font-bold uppercase tracking-widest hover:bg-slate-800 transition-all shadow-lg active:scale-95'\n              >\n                <Printer size={14} /> Print Payslip\n              </button>\n              <Dialog.Close asChild>\n                <button data-testid=\"payslip-close-btn\" className='w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-700 flex items-center justify-center text-slate-500 dark:text-slate-400 hover:text-rose-600 dark:text-rose-300 transition-all'>\n                  <X size={20} />\n                </button>\n              </Dialog.Close>\n            </div>\n          </div>\n\n          {/* Scrollable Document Area */}\n          <div className='flex-1 overflow-y-auto p-4 md:p-12 print:p-0 print:overflow-visible'>\n             <div ref={printRef} className='bg-white dark:bg-slate-900 rounded-2xl shadow-sm overflow-hidden print:shadow-none print:rounded-none'>\n                <PayslipDocument\n                  employee={employee}\n                  payslip={payslip}\n                  workspace={workspace}\n                />\n             </div>\n          </div>\n          \n          {/* Footer Warning */}\n          <div className='p-4 bg-amber-50 dark:bg-amber-950 border-t border-amber-100 dark:border-amber-800 text-center print:hidden'>\n            <p className='text-[9px] font-bold text-amber-700 dark:text-amber-300 uppercase tracking-widest'>\n              Use the print button above to save as PDF or print a physical copy.\n            </p>\n          </div>\n        </Dialog.Content>\n      </Dialog.Portal>\n    </Dialog.Root>\n  );\n}","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/payroll/RuleAssignmentManager.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Building2' is defined but never used. Allowed unused vars must match /^_/u.","line":5,"column":20,"nodeType":"Identifier","messageId":"unusedVar","endLine":5,"endColumn":29,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Building2"},"fix":{"range":[147,158],"text":""},"desc":"Remove unused variable \"Building2\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'ChevronDown' is defined but never used. Allowed unused vars must match /^_/u.","line":6,"column":10,"nodeType":"Identifier","messageId":"unusedVar","endLine":6,"endColumn":21,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"ChevronDown"},"fix":{"range":[191,204],"text":""},"desc":"Remove unused variable \"ChevronDown\"."}]},{"ruleId":"import-x/no-named-as-default-member","severity":1,"message":"Caution: `React` also has a named export `useMemo`. Check if you meant to write `import {useMemo} from 'react'` instead.","line":78,"column":19,"nodeType":"MemberExpression","messageId":"member","endLine":78,"endColumn":32},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":120,"column":40,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":120,"endColumn":43,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[4637,4640],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[4637,4640],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":134,"column":10,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":134,"endColumn":13,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[5251,5254],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[5251,5254],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"import-x/no-named-as-default-member","severity":1,"message":"Caution: `React` also has a named export `useMemo`. Check if you meant to write `import {useMemo} from 'react'` instead.","line":143,"column":19,"nodeType":"MemberExpression","messageId":"member","endLine":143,"endColumn":32},{"ruleId":"jsx-a11y/label-has-associated-control","severity":2,"message":"A form label must be associated with a control.","line":291,"column":13,"nodeType":"JSXOpeningElement","endLine":291,"endColumn":120},{"ruleId":"jsx-a11y/label-has-associated-control","severity":2,"message":"A form label must be associated with a control.","line":324,"column":15,"nodeType":"JSXOpeningElement","endLine":324,"endColumn":122},{"ruleId":"jsx-a11y/label-has-associated-control","severity":2,"message":"A form label must be associated with a control.","line":338,"column":15,"nodeType":"JSXOpeningElement","endLine":338,"endColumn":122},{"ruleId":"jsx-a11y/label-has-associated-control","severity":2,"message":"A form label must have accessible text.","line":397,"column":15,"nodeType":"JSXOpeningElement","endLine":404,"endColumn":16},{"ruleId":"jsx-a11y/label-has-associated-control","severity":2,"message":"A form label must be associated with a control.","line":426,"column":25,"nodeType":"JSXOpeningElement","endLine":426,"endColumn":129},{"ruleId":"jsx-a11y/label-has-associated-control","severity":2,"message":"A form label must be associated with a control.","line":437,"column":25,"nodeType":"JSXOpeningElement","endLine":437,"endColumn":129},{"ruleId":"jsx-a11y/label-has-associated-control","severity":2,"message":"A form label must be associated with a control.","line":452,"column":23,"nodeType":"JSXOpeningElement","endLine":452,"endColumn":127}],"suppressedMessages":[],"errorCount":11,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from \"react\";\n\nimport { useQuery, useMutation, useQueryClient } from \"@tanstack/react-query\";\nimport {\n  Users, Building, Building2, Plus, Trash2, Calendar,\n  Globe, ChevronDown, Shield, Clock, Sliders,\n} from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { EmployeeSearch } from \"@/components/common/EmployeeSearch\";\nimport Modal from \"@/components/ui/Modal\";\nimport { useToast } from \"@/components/ui/Toast\";\n\nimport { fetchDepartments } from \"@/lib/api/departments\";\nimport {\n  fetchPayrollRuleAssignments,\n  createPayrollRuleAssignment,\n  deletePayrollRuleAssignment,\n} from \"@/lib/api/payroll\";\nimport { PayrollRuleAssignment, Department } from \"@/lib/api/types\";\nimport { cn } from \"@/lib/utils\";\n\n\ninterface Props {\n  wsId: string;\n  ruleId: string;\n  /** calculation_method of parent rule — drives override config form */\n  calculationMethod?: \"percentage\" | \"fixed\" | \"tiered\";\n}\n\nconst SCOPE_ICONS = {\n  workspace: Globe,\n  department: Building,\n  employee: Users,\n} as const;\n\nconst SCOPE_COLORS = {\n  workspace: { bg: \"bg-amber-50 dark:bg-amber-950/40\", text: \"text-amber-600 dark:text-amber-400\", border: \"border-amber-100 dark:border-amber-800\", badge: \"bg-amber-100 dark:bg-amber-900/50 text-amber-700 dark:text-amber-300\" },\n  department: { bg: \"bg-sky-50 dark:bg-sky-950/40\", text: \"text-sky-600 dark:text-sky-400\", border: \"border-sky-100 dark:border-sky-800\", badge: \"bg-sky-100 dark:bg-sky-900/50 text-sky-700 dark:text-sky-300\" },\n  employee: { bg: \"bg-teal-50 dark:bg-teal-950/40\", text: \"text-teal-600 dark:text-teal-400\", border: \"border-teal-100 dark:border-teal-800\", badge: \"bg-teal-100 dark:bg-teal-900/50 text-teal-700 dark:text-teal-300\" },\n} as const;\n\nfunction formatDate(d: string) {\n  return new Date(d).toLocaleDateString(\"vi-VN\", { day: \"2-digit\", month: \"short\", year: \"numeric\" });\n}\n\nexport default function RuleAssignmentManager({ wsId, ruleId, calculationMethod }: Props) {\n  const { t } = useTranslation();\n  const queryClient = useQueryClient();\n  const toast = useToast();\n\n  const [isModalOpen, setIsModalOpen] = useState(false);\n  const [deletingId, setDeletingId] = useState<string | null>(null);\n\n  // --- Form state ---\n  const [assigneeType, setAssigneeType] = useState<\"workspace\" | \"department\" | \"employee\">(\"employee\");\n  const [assigneeId, setAssigneeId] = useState<string>(\"\");\n  const [effectiveFrom, setEffectiveFrom] = useState(() => new Date().toISOString().split(\"T\")[0]);\n  const [effectiveTo, setEffectiveTo] = useState<string>(\"\");\n  const [hasOverride, setHasOverride] = useState(false);\n  const [overrideRate, setOverrideRate] = useState<string>(\"\");\n  const [overrideAmount, setOverrideAmount] = useState<string>(\"\");\n  const [overrideBase, setOverrideBase] = useState<string>(\"gross\");\n\n  // --- Data ---\n  const { data: assignments, isLoading } = useQuery({\n    queryKey: [\"payroll-rule-assignments\", ruleId],\n    queryFn: () => fetchPayrollRuleAssignments(wsId, ruleId),\n    enabled: !!ruleId,\n  });\n\n  const { data: departments } = useQuery({\n    queryKey: [\"departments\", wsId],\n    queryFn: () => fetchDepartments(wsId),\n    enabled: !!wsId,\n  });\n\n  const deptMap = React.useMemo(() => {\n    const m: Record<string, Department> = {};\n    departments?.forEach((d) => { m[d.id] = d; });\n    return m;\n  }, [departments]);\n\n  // --- Mutations ---\n  const createMutation = useMutation({\n    mutationFn: (data: Partial<PayrollRuleAssignment>) => createPayrollRuleAssignment(wsId, ruleId, data),\n    onSuccess: () => {\n      toast.success(t(\"common.success\"));\n      queryClient.invalidateQueries({ queryKey: [\"payroll-rule-assignments\", ruleId] });\n      closeModal();\n    },\n    onError: (err: Error) => toast.error(err.message || t(\"common.error\")),\n  });\n\n  const deleteMutation = useMutation({\n    mutationFn: (assignmentId: string) => deletePayrollRuleAssignment(wsId, ruleId, assignmentId),\n    onSuccess: () => {\n      toast.success(t(\"common.success\"));\n      queryClient.invalidateQueries({ queryKey: [\"payroll-rule-assignments\", ruleId] });\n      setDeletingId(null);\n    },\n    onError: (err: Error) => toast.error(err.message || t(\"common.error\")),\n  });\n\n  // --- Handlers ---\n  const closeModal = () => {\n    setIsModalOpen(false);\n    setAssigneeType(\"employee\");\n    setAssigneeId(\"\");\n    setEffectiveFrom(new Date().toISOString().split(\"T\")[0]);\n    setEffectiveTo(\"\");\n    setHasOverride(false);\n    setOverrideRate(\"\");\n    setOverrideAmount(\"\");\n    setOverrideBase(\"gross\");\n  };\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    let overrideConfig: Record<string, any> | undefined;\n    if (hasOverride) {\n      if (calculationMethod === \"percentage\" && overrideRate) {\n        overrideConfig = { rate: parseFloat(overrideRate), base: overrideBase };\n      } else if (calculationMethod === \"fixed\" && overrideAmount) {\n        overrideConfig = { amount: parseFloat(overrideAmount) };\n      }\n    }\n    createMutation.mutate({\n      assignee_type: assigneeType,\n      assignee_id: assigneeType === \"workspace\" ? undefined : assigneeId || undefined,\n      effective_from: effectiveFrom,\n      effective_to: effectiveTo || undefined,\n      override_config: overrideConfig,\n    } as any);\n  };\n\n  const getAssigneeName = (a: PayrollRuleAssignment) => {\n    if (a.assignee_type === \"workspace\") return t(\"payroll_rules.scope_workspace\", \"Entire Workspace\");\n    if (a.assignee_type === \"department\") return deptMap[a.assignee_id!]?.name || a.assignee_id?.slice(0, 8) + \"…\";\n    return a.assignee_id?.slice(0, 8) + \"…\";\n  };\n\n  const grouped = React.useMemo(() => {\n    const g = { workspace: [] as PayrollRuleAssignment[], department: [] as PayrollRuleAssignment[], employee: [] as PayrollRuleAssignment[] };\n    assignments?.forEach((a) => g[a.assignee_type]?.push(a));\n    return g;\n  }, [assignments]);\n\n  const totalCount = assignments?.length ?? 0;\n\n  return (\n    <div className=\"space-y-5 mt-4\">\n      {/* Header */}\n      <div className=\"flex items-center justify-between\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"w-9 h-9 rounded-xl bg-teal-50 dark:bg-teal-950/40 text-teal-600 dark:text-teal-400 flex items-center justify-center shadow-sm border border-teal-100 dark:border-teal-800\">\n            <Shield size={16} />\n          </div>\n          <div>\n            <h3 className=\"font-bold text-sm uppercase tracking-widest text-slate-700 dark:text-slate-200 leading-none\">\n              Rule Assignments\n            </h3>\n            <p className=\"text-[10px] text-slate-500 dark:text-slate-400 uppercase tracking-widest mt-1 opacity-70\">\n              {totalCount} active {totalCount === 1 ? \"assignment\" : \"assignments\"} across all scopes\n            </p>\n          </div>\n        </div>\n        <button\n          onClick={() => setIsModalOpen(true)}\n          className=\"flex items-center gap-2 bg-teal-600 hover:bg-teal-700 text-white px-5 py-2.5 rounded-xl font-bold text-[10px] uppercase tracking-widest transition-all shadow-lg shadow-teal-100 dark:shadow-black/30 active:scale-95\"\n        >\n          <Plus size={14} /> Assign\n        </button>\n      </div>\n\n      {/* Loading state */}\n      {isLoading && (\n        <div className=\"p-12 flex justify-center\">\n          <div className=\"w-8 h-8 border-[3px] border-teal-600 border-t-transparent rounded-full animate-spin\" />\n        </div>\n      )}\n\n      {/* Empty state */}\n      {!isLoading && totalCount === 0 && (\n        <div className=\"p-12 bg-slate-50 dark:bg-slate-800/30 rounded-2xl border-2 border-dashed border-slate-100 dark:border-slate-800 flex flex-col items-center gap-3\">\n          <div className=\"w-14 h-14 bg-white dark:bg-slate-900 rounded-2xl flex items-center justify-center shadow-sm border border-slate-100 dark:border-slate-800\">\n            <Users size={24} className=\"text-slate-200 dark:text-slate-700\" />\n          </div>\n          <p className=\"text-[10px] font-bold text-slate-300 dark:text-slate-600 uppercase tracking-widest\">\n            No assignments yet — click \"Assign\" to get started\n          </p>\n        </div>\n      )}\n\n      {/* Assignment cards by scope */}\n      {!isLoading && totalCount > 0 && (\n        <div className=\"space-y-3\">\n          {([\"workspace\", \"department\", \"employee\"] as const).map((scope) => {\n            const items = grouped[scope];\n            if (items.length === 0) return null;\n            const colors = SCOPE_COLORS[scope];\n            const Icon = SCOPE_ICONS[scope];\n            return (\n              <div key={scope} className=\"space-y-2\">\n                <div className=\"flex items-center gap-2 px-1\">\n                  <Icon size={12} className={colors.text + \" opacity-60\"} />\n                  <span className=\"text-[9px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.2em]\">\n                    {scope} level ({items.length})\n                  </span>\n                </div>\n                {items.map((a) => (\n                  <div\n                    key={a.id}\n                    className={cn(\n                      \"flex items-center justify-between p-4 rounded-xl border shadow-sm transition-all group hover:shadow-md\",\n                      colors.bg, colors.border,\n                      deletingId === a.id && \"ring-2 ring-rose-300 dark:ring-rose-700\"\n                    )}\n                  >\n                    <div className=\"flex items-center gap-4 min-w-0\">\n                      <div className={cn(\"w-10 h-10 rounded-xl flex items-center justify-center shrink-0\", colors.badge)}>\n                        <Icon size={18} />\n                      </div>\n                      <div className=\"min-w-0\">\n                        <p className=\"font-bold text-sm text-slate-700 dark:text-slate-200 uppercase tracking-tight truncate leading-none\">\n                          {getAssigneeName(a)}\n                        </p>\n                        <div className=\"flex items-center gap-3 mt-1.5 flex-wrap\">\n                          <span className=\"flex items-center gap-1 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">\n                            <Calendar size={10} className=\"opacity-50\" />\n                            {formatDate(a.effective_from)}\n                            {a.effective_to ? ` → ${formatDate(a.effective_to)}` : \" → ∞\"}\n                          </span>\n                          {a.override_config && (\n                            <span className=\"flex items-center gap-1 text-[9px] font-bold bg-orange-100 dark:bg-orange-900/40 text-orange-700 dark:text-orange-300 px-2 py-0.5 rounded-md border border-orange-200 dark:border-orange-800\">\n                              <Sliders size={9} /> OVERRIDE\n                              {a.override_config.rate != null && ` ${a.override_config.rate}%`}\n                              {a.override_config.amount != null && ` ₫${Number(a.override_config.amount).toLocaleString()}`}\n                            </span>\n                          )}\n                        </div>\n                      </div>\n                    </div>\n\n                    {/* Delete button */}\n                    {deletingId === a.id ? (\n                      <div className=\"flex items-center gap-2 animate-in fade-in duration-200\">\n                        <button\n                          onClick={() => deleteMutation.mutate(a.id)}\n                          disabled={deleteMutation.isPending}\n                          className=\"px-3 py-1.5 bg-rose-600 text-white rounded-lg text-[10px] font-bold uppercase tracking-widest hover:bg-rose-700 transition-all disabled:opacity-50\"\n                        >\n                          {deleteMutation.isPending ? \"…\" : \"Confirm\"}\n                        </button>\n                        <button\n                          onClick={() => setDeletingId(null)}\n                          className=\"px-3 py-1.5 bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-300 rounded-lg text-[10px] font-bold uppercase tracking-widest hover:bg-slate-300 dark:hover:bg-slate-600 transition-all\"\n                        >\n                          Cancel\n                        </button>\n                      </div>\n                    ) : (\n                      <button\n                        onClick={() => setDeletingId(a.id)}\n                        className=\"p-2.5 text-slate-300 dark:text-slate-600 hover:text-rose-500 dark:hover:text-rose-400 rounded-xl hover:bg-white dark:hover:bg-slate-900 transition-all opacity-0 group-hover:opacity-100 active:scale-90 shadow-none hover:shadow-md border border-transparent hover:border-slate-100 dark:hover:border-slate-800\"\n                        aria-label=\"Delete assignment\"\n                      >\n                        <Trash2 size={16} />\n                      </button>\n                    )}\n                  </div>\n                ))}\n              </div>\n            );\n          })}\n        </div>\n      )}\n\n      {/* Create Assignment Modal */}\n      <Modal\n        isOpen={isModalOpen}\n        onClose={closeModal}\n        title=\"Assign Rule\"\n        subtitle=\"Define who this rule applies to and when\"\n        icon={<Shield size={24} />}\n        maxWidth=\"lg\"\n      >\n        <form onSubmit={handleSubmit} className=\"space-y-8 pt-2 animate-in fade-in duration-300\">\n          {/* Scope selector */}\n          <div className=\"space-y-3\">\n            <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">\n              Assignment Scope\n            </label>\n            <div className=\"grid grid-cols-3 gap-3\">\n              {([\"employee\", \"department\", \"workspace\"] as const).map((scope) => {\n                const Icon = SCOPE_ICONS[scope];\n                const colors = SCOPE_COLORS[scope];\n                const isActive = assigneeType === scope;\n                return (\n                  <button\n                    key={scope}\n                    type=\"button\"\n                    onClick={() => { setAssigneeType(scope); setAssigneeId(\"\"); }}\n                    className={cn(\n                      \"flex flex-col items-center gap-2.5 p-5 rounded-2xl border-2 transition-all active:scale-[0.97]\",\n                      isActive\n                        ? `${colors.bg} ${colors.border} shadow-lg`\n                        : \"bg-slate-50 dark:bg-slate-800/50 border-transparent hover:border-slate-200 dark:hover:border-slate-700 hover:bg-white dark:hover:bg-slate-900\"\n                    )}\n                  >\n                    <Icon size={22} className={isActive ? colors.text : \"text-slate-400 dark:text-slate-500\"} />\n                    <span className={cn(\"text-[10px] font-bold uppercase tracking-widest\", isActive ? \"text-slate-700 dark:text-slate-200\" : \"text-slate-500 dark:text-slate-400\")}>\n                      {scope}\n                    </span>\n                  </button>\n                );\n              })}\n            </div>\n          </div>\n\n          {/* Assignee picker (employee or department) */}\n          {assigneeType === \"employee\" && (\n            <div className=\"space-y-3\">\n              <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">\n                Select Employee\n              </label>\n              <EmployeeSearch\n                workspaceId={wsId}\n                value={assigneeId}\n                onChange={(val: string) => setAssigneeId(val)}\n                placeholder=\"Search employees…\"\n              />\n            </div>\n          )}\n\n          {assigneeType === \"department\" && (\n            <div className=\"space-y-3\">\n              <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">\n                Select Department\n              </label>\n              <select\n                required\n                value={assigneeId}\n                onChange={(e) => setAssigneeId(e.target.value)}\n                className=\"w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-2xl px-5 py-3.5 font-bold text-sm text-slate-700 dark:text-slate-200 focus:ring-4 focus:ring-sky-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all uppercase tracking-tight shadow-sm\"\n              >\n                <option value=\"\">— Select department —</option>\n                {departments?.map((d) => (\n                  <option key={d.id} value={d.id}>{d.name}</option>\n                ))}\n              </select>\n            </div>\n          )}\n\n          {assigneeType === \"workspace\" && (\n            <div className=\"bg-amber-50 dark:bg-amber-950/30 border border-amber-100 dark:border-amber-800 rounded-2xl p-5 flex items-center gap-4\">\n              <Globe size={20} className=\"text-amber-600 dark:text-amber-400 shrink-0\" />\n              <p className=\"text-xs font-bold text-amber-800 dark:text-amber-200 uppercase tracking-tight\">\n                This rule will apply to all employees in the workspace\n              </p>\n            </div>\n          )}\n\n          {/* Date range */}\n          <div className=\"grid grid-cols-2 gap-4\">\n            <div className=\"space-y-3\">\n              <label htmlFor=\"effective-from\" className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1 flex items-center gap-1.5\">\n                <Clock size={10} /> Effective From\n              </label>\n              <input\n                id=\"effective-from\"\n                type=\"date\"\n                required\n                value={effectiveFrom}\n                onChange={(e) => setEffectiveFrom(e.target.value)}\n                className=\"w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-2xl px-5 py-3.5 font-bold text-sm text-slate-700 dark:text-slate-200 focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all shadow-sm\"\n              />\n            </div>\n            <div className=\"space-y-3\">\n              <label htmlFor=\"effective-to\" className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1 flex items-center gap-1.5\">\n                <Clock size={10} /> Effective To\n                <span className=\"opacity-40 normal-case tracking-normal\">(optional)</span>\n              </label>\n              <input\n                id=\"effective-to\"\n                type=\"date\"\n                value={effectiveTo}\n                onChange={(e) => setEffectiveTo(e.target.value)}\n                className=\"w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-2xl px-5 py-3.5 font-bold text-sm text-slate-700 dark:text-slate-200 focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all shadow-sm\"\n              />\n            </div>\n          </div>\n\n          {/* Override config toggle */}\n          {(calculationMethod === \"percentage\" || calculationMethod === \"fixed\") && (\n            <div className=\"space-y-4\">\n              <label\n                className={cn(\n                  \"flex items-center gap-4 p-5 rounded-2xl cursor-pointer transition-all border-2 active:scale-[0.98]\",\n                  hasOverride\n                    ? \"bg-orange-50 dark:bg-orange-950/30 border-orange-100 dark:border-orange-800 shadow-lg\"\n                    : \"bg-slate-50 dark:bg-slate-800/50 border-transparent hover:border-slate-200 dark:hover:border-slate-700\"\n                )}\n              >\n                <input\n                  type=\"checkbox\"\n                  checked={hasOverride}\n                  onChange={(e) => setHasOverride(e.target.checked)}\n                  className=\"w-5 h-5 rounded-lg text-orange-600 focus:ring-orange-500 border-slate-300 dark:border-slate-600 cursor-pointer\"\n                />\n                <div>\n                  <p className=\"font-bold text-sm text-slate-700 dark:text-slate-200 uppercase tracking-tight flex items-center gap-2\">\n                    <Sliders size={14} className=\"opacity-50\" /> Override Default Config\n                  </p>\n                  <p className=\"text-[10px] text-slate-500 dark:text-slate-400 uppercase tracking-widest mt-1 opacity-70\">\n                    Apply a different rate or amount for this specific assignment\n                  </p>\n                </div>\n              </label>\n\n              {hasOverride && (\n                <div className=\"bg-orange-50 dark:bg-orange-950/20 rounded-2xl p-5 border border-orange-100 dark:border-orange-800 space-y-4 animate-in slide-in-from-top-2 duration-200\">\n                  {calculationMethod === \"percentage\" && (\n                    <div className=\"grid grid-cols-2 gap-4\">\n                      <div className=\"space-y-2\">\n                        <label className=\"text-[10px] font-bold text-orange-700 dark:text-orange-300 uppercase tracking-widest\">Override Rate (%)</label>\n                        <input\n                          type=\"number\"\n                          step=\"0.01\"\n                          value={overrideRate}\n                          onChange={(e) => setOverrideRate(e.target.value)}\n                          placeholder=\"e.g. 10.5\"\n                          className=\"w-full bg-white dark:bg-slate-900 border border-orange-200 dark:border-orange-800 rounded-xl px-4 py-3 font-bold text-sm text-slate-700 dark:text-slate-200 focus:ring-2 focus:ring-orange-500/20 outline-none\"\n                        />\n                      </div>\n                      <div className=\"space-y-2\">\n                        <label className=\"text-[10px] font-bold text-orange-700 dark:text-orange-300 uppercase tracking-widest\">Override Base</label>\n                        <select\n                          value={overrideBase}\n                          onChange={(e) => setOverrideBase(e.target.value)}\n                          className=\"w-full bg-white dark:bg-slate-900 border border-orange-200 dark:border-orange-800 rounded-xl px-4 py-3 font-bold text-sm text-slate-700 dark:text-slate-200 focus:ring-2 focus:ring-orange-500/20 outline-none uppercase tracking-tight\"\n                        >\n                          <option value=\"gross\">Gross Salary</option>\n                          <option value=\"gross_salary\">Gross Salary (alt)</option>\n                          <option value=\"taxable_income\">Taxable Income</option>\n                        </select>\n                      </div>\n                    </div>\n                  )}\n                  {calculationMethod === \"fixed\" && (\n                    <div className=\"space-y-2\">\n                      <label className=\"text-[10px] font-bold text-orange-700 dark:text-orange-300 uppercase tracking-widest\">Override Amount (₫)</label>\n                      <input\n                        type=\"number\"\n                        value={overrideAmount}\n                        onChange={(e) => setOverrideAmount(e.target.value)}\n                        placeholder=\"e.g. 500000\"\n                        className=\"w-full bg-white dark:bg-slate-900 border border-orange-200 dark:border-orange-800 rounded-xl px-4 py-3 font-bold text-sm text-slate-700 dark:text-slate-200 focus:ring-2 focus:ring-orange-500/20 outline-none\"\n                      />\n                    </div>\n                  )}\n                </div>\n              )}\n            </div>\n          )}\n\n          {/* Actions */}\n          <div className=\"flex gap-4 pt-2 border-t border-slate-50 dark:border-slate-800\">\n            <button\n              type=\"button\"\n              onClick={closeModal}\n              className=\"flex-1 px-6 py-3.5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 rounded-2xl font-bold text-xs uppercase tracking-widest hover:bg-slate-50 dark:hover:bg-slate-800 transition-all active:scale-95\"\n            >\n              {t(\"common.cancel\")}\n            </button>\n            <button\n              type=\"submit\"\n              disabled={createMutation.isPending || (assigneeType !== \"workspace\" && !assigneeId)}\n              className=\"flex-[1.5] bg-teal-600 text-white rounded-2xl font-bold text-xs uppercase tracking-widest hover:bg-teal-700 transition-all shadow-xl shadow-teal-100 dark:shadow-black/30 active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed py-3.5\"\n            >\n              {createMutation.isPending ? t(\"common.saving\") + \"…\" : \"Assign Rule\"}\n            </button>\n          </div>\n        </form>\n      </Modal>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/payroll/RuleTierManager.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Save' is defined but never used. Allowed unused vars must match /^_/u.","line":4,"column":24,"nodeType":"Identifier","messageId":"unusedVar","endLine":4,"endColumn":28,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Save"},"fix":{"range":[142,148],"text":""},"desc":"Remove unused variable \"Save\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'X' is defined but never used. Allowed unused vars must match /^_/u.","line":4,"column":30,"nodeType":"Identifier","messageId":"unusedVar","endLine":4,"endColumn":31,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"X"},"fix":{"range":[148,151],"text":""},"desc":"Remove unused variable \"X\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'cn' is defined but never used. Allowed unused vars must match /^_/u.","line":11,"column":10,"nodeType":"Identifier","messageId":"unusedVar","endLine":11,"endColumn":12,"suggestions":[{"messageId":"removeUnusedImportDeclaration","data":{"varName":"cn"},"fix":{"range":[420,454],"text":""},"desc":"Remove unused import declaration."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'onClose' is defined but never used. Allowed unused args must match /^_/u.","line":19,"column":57,"nodeType":"Identifier","messageId":"unusedVar","endLine":19,"endColumn":64}],"suppressedMessages":[],"errorCount":4,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from \"react\";\n\nimport { useQuery, useMutation, useQueryClient } from \"@tanstack/react-query\";\nimport { Plus, Trash2, Save, X, LayoutList } from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { useToast } from \"@/components/ui/Toast\";\n\nimport { fetchPayrollRuleTiers, createPayrollRuleTier } from \"@/lib/api/payroll\";\nimport { PayrollRuleTier } from \"@/lib/api/types\";\nimport { cn } from \"@/lib/utils\";\n\ninterface Props {\n  wsId: string;\n  ruleId: string;\n  onClose?: () => void;\n}\n\nexport default function RuleTierManager({ wsId, ruleId, onClose }: Props) {\n  const { t } = useTranslation();\n  const queryClient = useQueryClient();\n  const toast = useToast();\n\n  const { data: tiers, isLoading } = useQuery({\n    queryKey: [\"payroll-rule-tiers\", ruleId],\n    queryFn: () => fetchPayrollRuleTiers(wsId, ruleId),\n    enabled: !!ruleId,\n  });\n\n  const [newTier, setNewTier] = useState<Partial<PayrollRuleTier>>({\n    min_amount: 0,\n    max_amount: undefined,\n    rate: 0,\n    fixed_amount: 0,\n  });\n\n  const createMutation = useMutation({\n    mutationFn: (data: Partial<PayrollRuleTier>) => createPayrollRuleTier(wsId, ruleId, { ...data, tier_order: (tiers?.length || 0) + 1 }),\n    onSuccess: () => {\n      toast.success(t(\"common.success\"));\n      queryClient.invalidateQueries({ queryKey: [\"payroll-rule-tiers\", ruleId] });\n      setNewTier({ min_amount: 0, max_amount: undefined, rate: 0, fixed_amount: 0 });\n    },\n  });\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    createMutation.mutate(newTier);\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"bg-slate-50 dark:bg-slate-800/50 rounded-2xl p-6 border border-slate-100 dark:border-slate-800\">\n        <div className=\"flex items-center gap-3 mb-4\">\n          <div className=\"w-8 h-8 rounded-lg bg-primary-100 dark:bg-primary-900/30 text-primary-600 flex items-center justify-center\">\n            <LayoutList size={16} />\n          </div>\n          <div>\n            <h3 className=\"font-bold text-sm uppercase tracking-widest text-slate-700 dark:text-slate-200\">{t(\"payroll.rule_tiers.title\")}</h3>\n            <p className=\"text-[10px] text-slate-500 uppercase tracking-widest mt-1\">{t(\"payroll.rule_tiers.subtitle\")}</p>\n          </div>\n        </div>\n\n        {isLoading ? (\n          <div className=\"p-10 text-center text-slate-500\">{t(\"payroll.rule_tiers.loading\")}</div>\n        ) : (\n          <div className=\"space-y-2\">\n            {tiers?.map((tier) => (\n              <div key={tier.id} className=\"flex items-center justify-between p-4 bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm\">\n                <div className=\"flex items-center gap-4\">\n                  <span className=\"w-6 h-6 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-xs font-bold text-slate-500\">{tier.tier_order}</span>\n                  <div className=\"text-sm font-bold text-slate-700 dark:text-slate-200 font-mono\">\n                    {tier.min_amount.toLocaleString()} ₫ - {tier.max_amount ? `${tier.max_amount.toLocaleString()} ₫` : '∞'}\n                  </div>\n                </div>\n                <div className=\"flex items-center gap-4\">\n                  {tier.rate !== undefined && tier.rate > 0 && <span className=\"text-xs font-bold text-primary-600 bg-primary-50 px-2 py-1 rounded-md\">{tier.rate}%</span>}\n                  {tier.fixed_amount !== undefined && tier.fixed_amount > 0 && <span className=\"text-xs font-bold text-rose-600 bg-rose-50 px-2 py-1 rounded-md\">-{tier.fixed_amount.toLocaleString()} ₫</span>}\n                  <button className=\"text-slate-400 hover:text-rose-500 transition-colors\"><Trash2 size={16} /></button>\n                </div>\n              </div>\n            ))}\n\n            {/* Add new tier form */}\n            <form onSubmit={handleSubmit} className=\"mt-4 p-4 bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700 shadow-inner flex items-end gap-4\">\n              <div className=\"flex-1 space-y-2\">\n                <label className=\"text-[10px] font-bold text-slate-500 uppercase tracking-widest\">{t(\"payroll.rule_tiers.fields.min_amount\")}</label>\n                <input type=\"number\" required className=\"w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-sm font-bold\" value={newTier.min_amount} onChange={e => setNewTier({...newTier, min_amount: parseFloat(e.target.value)})} />\n              </div>\n              <div className=\"flex-1 space-y-2\">\n                <label className=\"text-[10px] font-bold text-slate-500 uppercase tracking-widest\">{t(\"payroll.rule_tiers.fields.max_amount\")}</label>\n                <input type=\"number\" className=\"w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-sm font-bold\" value={newTier.max_amount || \"\"} onChange={e => setNewTier({...newTier, max_amount: e.target.value ? parseFloat(e.target.value) : undefined})} />\n              </div>\n              <div className=\"flex-1 space-y-2\">\n                <label className=\"text-[10px] font-bold text-slate-500 uppercase tracking-widest\">{t(\"payroll.rule_tiers.fields.rate\")}</label>\n                <input type=\"number\" step=\"0.01\" className=\"w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-sm font-bold\" value={newTier.rate || \"\"} onChange={e => setNewTier({...newTier, rate: e.target.value ? parseFloat(e.target.value) : 0})} />\n              </div>\n              <div className=\"flex-1 space-y-2\">\n                <label className=\"text-[10px] font-bold text-slate-500 uppercase tracking-widest\">{t(\"payroll.rule_tiers.fields.fixed_deduction\")}</label>\n                <input type=\"number\" className=\"w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-sm font-bold\" value={newTier.fixed_amount || \"\"} onChange={e => setNewTier({...newTier, fixed_amount: e.target.value ? parseFloat(e.target.value) : 0})} />\n              </div>\n              <button type=\"submit\" disabled={createMutation.isPending} className=\"bg-primary-600 text-white p-2.5 rounded-lg hover:bg-primary-700 transition-colors disabled:opacity-50\">\n                <Plus size={16} />\n              </button>\n            </form>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/payroll/SalaryBaseGroupManager.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'useState' is defined but never used. Allowed unused vars must match /^_/u.","line":1,"column":10,"nodeType":"Identifier","messageId":"unusedVar","endLine":1,"endColumn":18,"suggestions":[{"messageId":"removeUnusedImportDeclaration","data":{"varName":"useState"},"fix":{"range":[0,34],"text":""},"desc":"Remove unused import declaration."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState } from \"react\";\n\nimport { useQuery, useMutation, useQueryClient } from \"@tanstack/react-query\";\nimport { Loader2, Database, Info, Plus, X } from \"lucide-react\";\n\nimport { useToast } from \"@/components/ui/Toast\";\n\nimport { \n  fetchSalaryBaseGroups, \n  fetchSalaryComponents,\n  assignComponentToSalaryBase,\n  unassignComponentFromSalaryBase\n} from \"@/lib/api/payroll\";\n\nexport default function SalaryBaseGroupManager({ wsId }: { wsId: string }) {\n  const queryClient = useQueryClient();\n  const toast = useToast();\n\n  const { data: salaryBasesResponse, isLoading: loadingGroups } = useQuery({\n    queryKey: [\"salary-base-groups\", wsId],\n    queryFn: () => fetchSalaryBaseGroups(wsId),\n  });\n\n  const { data: components, isLoading: loadingComponents } = useQuery({\n    queryKey: [\"salary-components\", wsId],\n    queryFn: () => fetchSalaryComponents(wsId),\n  });\n\n  const groups = salaryBasesResponse?.groups;\n  const members = salaryBasesResponse?.members;\n\n  const assignMutation = useMutation({\n    mutationFn: ({ baseId, componentId }: { baseId: string, componentId: string }) => \n      assignComponentToSalaryBase(wsId, baseId, componentId),\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: [\"salary-base-members\", wsId] });\n      toast.success(\"Component assigned to base successfully\");\n    },\n    onError: () => {\n      toast.error(\"Failed to assign component\");\n    }\n  });\n\n  const unassignMutation = useMutation({\n    mutationFn: ({ baseId, componentId }: { baseId: string, componentId: string }) => \n      unassignComponentFromSalaryBase(wsId, baseId, componentId),\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: [\"salary-base-members\", wsId] });\n      toast.success(\"Component unassigned from base successfully\");\n    },\n    onError: () => {\n      toast.error(\"Failed to unassign component\");\n    }\n  });\n\n  if (loadingGroups || loadingComponents) {\n    return (\n      <div data-testid=\"loader\" className=\"flex items-center justify-center p-12 text-slate-400\">\n        <Loader2 className=\"animate-spin w-8 h-8\" />\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex items-center justify-between\">\n        <div>\n          <h2 className=\"text-xl font-bold text-slate-800 dark:text-slate-100 flex items-center gap-2\">\n            <Database className=\"w-5 h-5 text-primary-500\" />\n            Salary Bases\n          </h2>\n          <p className=\"text-sm text-slate-500 dark:text-slate-400 mt-1\">\n            Group your salary components into functional bases (e.g., Gross Salary, BHXH Base) to be used in Payroll Rules.\n          </p>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6\">\n        {groups?.map(group => {\n          const groupMembers = members?.filter(m => m.base_group_id === group.id) || [];\n          const memberIds = new Set(groupMembers.map(m => m.component_definition_id));\n\n          return (\n            <div key={group.id} className=\"bg-white dark:bg-slate-800/50 rounded-2xl border border-slate-200 dark:border-slate-700 overflow-hidden shadow-sm hover:shadow-md transition-shadow\">\n              <div className=\"p-5 border-b border-slate-100 dark:border-slate-700/50 bg-slate-50 dark:bg-slate-800/80\">\n                <div className=\"flex justify-between items-start mb-2\">\n                  <h3 className=\"font-semibold text-slate-800 dark:text-slate-200\">{group.name}</h3>\n                  {group.is_system && (\n                    <span className=\"bg-primary-50 text-primary-600 text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full dark:bg-primary-900/30 dark:text-primary-400 border border-primary-100 dark:border-primary-800/50\">System</span>\n                  )}\n                </div>\n                <p className=\"text-xs text-slate-500 line-clamp-2\">{group.description || \"No description provided.\"}</p>\n                <div className=\"mt-3 text-xs font-mono text-slate-400 bg-slate-100 dark:bg-slate-900 px-2 py-1 rounded inline-block\">\n                  {group.slug}\n                </div>\n              </div>\n\n              <div className=\"p-4\">\n                <h4 className=\"text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3\">Included Components</h4>\n                <div className=\"space-y-2 max-h-64 overflow-y-auto pr-2 custom-scrollbar\">\n                  {components?.length === 0 ? (\n                    <div className=\"text-center py-4 text-sm text-slate-400 flex flex-col items-center\">\n                      <Info className=\"w-5 h-5 mb-1 opacity-50\" />\n                      No components available\n                    </div>\n                  ) : (\n                    components?.map(comp => {\n                      const isAssigned = memberIds.has(comp.id);\n                      \n                      return (\n                        <div \n                          key={comp.id} \n                          className={`flex items-center justify-between p-2.5 rounded-xl border transition-colors ${\n                            isAssigned \n                              ? 'border-primary-200 bg-primary-50/50 dark:border-primary-900/50 dark:bg-primary-900/20' \n                              : 'border-slate-100 bg-white hover:border-slate-200 dark:border-slate-700/50 dark:bg-slate-800 dark:hover:border-slate-600'\n                          }`}\n                        >\n                          <div className=\"flex-1 min-w-0 pr-3\">\n                            <p className={`text-sm font-medium truncate ${isAssigned ? 'text-primary-700 dark:text-primary-300' : 'text-slate-600 dark:text-slate-300'}`}>\n                              {comp.name}\n                            </p>\n                            <p className=\"text-xs text-slate-400 font-mono mt-0.5\">{comp.code}</p>\n                          </div>\n                          \n                          <button\n                            onClick={() => {\n                              if (isAssigned) {\n                                unassignMutation.mutate({ baseId: group.id, componentId: comp.id });\n                              } else {\n                                assignMutation.mutate({ baseId: group.id, componentId: comp.id });\n                              }\n                            }}\n                            disabled={assignMutation.isPending || unassignMutation.isPending || (group.slug === 'gross')}\n                            className={`flex-shrink-0 w-8 h-8 rounded-full flex items-center justify-center transition-colors ${\n                              isAssigned \n                                ? 'bg-rose-50 text-rose-500 hover:bg-rose-100 dark:bg-rose-500/10 dark:hover:bg-rose-500/20' \n                                : 'bg-slate-100 text-slate-400 hover:bg-primary-50 hover:text-primary-600 dark:bg-slate-700 dark:text-slate-300 dark:hover:bg-primary-500/20 dark:hover:text-primary-400'\n                            } disabled:opacity-50 disabled:cursor-not-allowed`}\n                            title={group.slug === 'gross' ? 'Gross base automatically includes all components' : isAssigned ? 'Unassign Component' : 'Assign Component'}\n                          >\n                            {isAssigned ? <X className=\"w-4 h-4\" /> : <Plus className=\"w-4 h-4\" />}\n                          </button>\n                        </div>\n                      );\n                    })\n                  )}\n                </div>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/payroll/SalaryComponentManager.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'List' is defined but never used. Allowed unused vars must match /^_/u.","line":4,"column":16,"nodeType":"Identifier","messageId":"unusedVar","endLine":4,"endColumn":20,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"List"},"fix":{"range":[134,140],"text":""},"desc":"Remove unused variable \"List\"."}]},{"ruleId":"jsx-a11y/label-has-associated-control","severity":2,"message":"A form label must have accessible text.","line":98,"column":15,"nodeType":"JSXOpeningElement","endLine":100,"endColumn":18},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":99,"column":30,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":99,"endColumn":33,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[8659,8662],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[8659,8662],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":101,"column":237,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":101,"endColumn":240,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[9187,9190],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[9187,9190],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":4,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from \"react\";\n\nimport { useQuery, useMutation, useQueryClient } from \"@tanstack/react-query\";\nimport { Plus, List, Coins, ShieldCheck, Percent, Trash2 } from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport Modal from \"@/components/ui/Modal\";\nimport { useToast } from \"@/components/ui/Toast\";\n\nimport { fetchSalaryComponents, createSalaryComponent } from \"@/lib/api/payroll\";\nimport { SalaryComponentDefinition } from \"@/lib/api/types\";\nimport { cn } from \"@/lib/utils\";\n\ninterface Props {\n  wsId: string;\n}\n\nexport default function SalaryComponentManager({ wsId }: Props) {\n  const { t } = useTranslation();\n  const queryClient = useQueryClient();\n  const toast = useToast();\n  const [isModalOpen, setIsModalOpen] = useState(false);\n\n  const { data: components, isLoading } = useQuery({ queryKey: [\"salary-components\", wsId], queryFn: () => fetchSalaryComponents(wsId), enabled: !!wsId });\n  const [formData, setFormData] = useState<Partial<SalaryComponentDefinition>>({ name: \"\", code: \"\", is_base_for_ot: true, is_taxable: true });\n\n  const createMutation = useMutation({\n    mutationFn: (data: Partial<SalaryComponentDefinition>) => createSalaryComponent(wsId, data),\n    onSuccess: () => { toast.success(t(\"common.success\")); queryClient.invalidateQueries({ queryKey: [\"salary-components\"] }); setIsModalOpen(false); setFormData({ name: \"\", code: \"\", is_base_for_ot: true, is_taxable: true }); },\n  });\n\n  const handleSubmit = (e: React.FormEvent) => { e.preventDefault(); createMutation.mutate(formData); };\n\n  return (\n    <div className=\"bg-white dark:bg-slate-900 rounded-[2.5rem] border border-slate-100 dark:border-slate-800 shadow-sm overflow-hidden animate-in fade-in duration-700\">\n      <div className=\"p-10 border-b border-slate-50 dark:border-slate-800 flex items-center justify-between bg-slate-50 dark:bg-slate-800/30 px-12\">\n        <div className=\"flex items-center gap-4\">\n          <div className=\"w-12 h-12 rounded-[1.25rem] bg-amber-50 dark:bg-amber-950 flex items-center justify-center text-amber-600 dark:text-amber-300 shadow-inner border border-amber-100 dark:border-amber-800/50\"><Coins size={24} /></div>\n          <div>\n            <h2 className=\"text-xl font-bold text-slate-800 dark:text-slate-100 tracking-tight uppercase leading-none\">{t(\"payroll.components.title\")}</h2>\n            <p className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest mt-1.5 opacity-70\">{t(\"payroll.components.subtitle\")}</p>\n          </div>\n        </div>\n        <button onClick={() => setIsModalOpen(true)} className=\"flex items-center gap-3 bg-primary-600 text-white px-8 py-3 rounded-2xl font-bold text-xs uppercase tracking-widest hover:bg-primary-700 transition-all shadow-xl shadow-primary-100 dark:shadow-black/30 active:scale-95\"><Plus size={18} /> {t(\"common.add\").toUpperCase()}</button>\n      </div>\n\n      <div className=\"divide-y divide-slate-50 dark:divide-slate-800 px-2\">\n        {isLoading ? (\n          <div className=\"p-20 text-center\"><div className=\"w-10 h-10 border-4 border-primary-600 border-t-transparent rounded-full animate-spin mx-auto\"></div></div>\n        ) : components?.length === 0 ? (\n          <div className=\"p-32 text-center bg-slate-50 dark:bg-slate-800/30 m-8 rounded-[3rem] border-2 border-dashed border-slate-100 dark:border-slate-800 flex flex-col items-center\">\n            <div className=\"w-20 h-20 bg-white dark:bg-slate-900 rounded-full flex items-center justify-center shadow-sm mb-4 border border-slate-100 dark:border-slate-800\"><Coins size={32} className=\"text-slate-200 dark:text-slate-700\" /></div>\n            <p className=\"text-[10px] font-bold text-slate-300 dark:text-slate-600 uppercase tracking-widest\">{t(\"payroll.components.no_components\")}</p>\n          </div>\n        ) : (\n          components?.map((comp) => (\n            <div key={comp.id} className=\"p-8 px-10 flex items-center justify-between hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-all group relative rounded-3xl m-2\">\n              <div className=\"flex items-center gap-6\">\n                <div className=\"w-14 h-14 rounded-2xl bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 flex items-center justify-center text-slate-500 dark:text-slate-400 font-bold text-lg shadow-inner group-hover:bg-white dark:hover:bg-slate-900 group-hover:text-primary-600 dark:group-hover:text-primary-400 group-hover:border-primary-100 dark:border-primary-800 group-hover:shadow-md transition-all uppercase\">{comp.code.slice(0, 2)}</div>\n                <div>\n                  <p className=\"font-bold text-slate-700 dark:text-slate-200 text-sm tracking-tight uppercase leading-none\">{comp.name}</p>\