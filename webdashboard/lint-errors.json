talErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * Converts a local date and time string to a UTC ISO string based on the provided timezone.\n * Uses Intl.DateTimeFormat for robust conversion without heavy libraries.\n */\nexport function toUTCISO(dateStr: string, timeStr: string, timezone: string): string {\n  const localStr = `${dateStr}T${timeStr}:00`;\n  \n  try {\n    const formatter = new Intl.DateTimeFormat('en-GB', {\n      timeZone: timezone,\n      year: 'numeric',\n      month: '2-digit',\n      day: '2-digit',\n      hour: '2-digit',\n      minute: '2-digit',\n      second: '2-digit',\n      hourCycle: 'h23'\n    });\n    \n    // First approximation: treat local as UTC\n    let utcDate = new Date(localStr + 'Z'); \n    \n    const getFormatted = (d: Date) => {\n      const parts = formatter.formatToParts(d);\n      const p: any = {};\n      parts.forEach(part => p[part.type] = part.value);\n      // Ensure ISO-like string YYYY-MM-DDTHH:mm:ss\n      return `${p.year}-${p.month}-${p.day}T${p.hour}:${p.minute}:${p.second}`;\n    };\n\n    // Refine the UTC date by calculating the difference\n    const formatted = getFormatted(utcDate);\n    const diff = new Date(localStr + 'Z').getTime() - new Date(formatted + 'Z').getTime();\n    utcDate = new Date(utcDate.getTime() + diff);\n    \n    return utcDate.toISOString();\n  } catch (err) {\n    console.error(\"Timezone conversion failed:\", err);\n    return localStr + 'Z';\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/lib/excel-builder.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/lib/permission-groups.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePat