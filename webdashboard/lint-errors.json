ow-sm active:scale-90 hover:shadow-md\"><ChevronLeft size={20} /></button>\n        <span className=\"text-lg font-bold text-slate-700 dark:text-slate-200 tracking-tighter uppercase\">{year}</span>\n        <button onClick={(e) => { e.preventDefault(); handleYearChange(1); }} className=\"w-10 h-10 flex items-center justify-center hover:bg-white dark:hover:bg-slate-900 rounded-xl text-slate-500 dark:text-slate-400 hover:text-primary-600 dark:text-primary-400 transition-all shadow-sm active:scale-90 hover:shadow-md\"><ChevronRight size={20} /></button>\n      </div>\n\n      {/* Month Grid */}\n      <div className=\"grid grid-cols-3 gap-3\">\n        {Array.from({ length: 12 }, (_, i) => i + 1).map((m) => (\n          <button\n            key={m}\n            type=\"button\"\n            onClick={() => handleMonthClick(m)}\n            aria-label={t(\"common.month_short\", { defaultValue: `Tháng ${m}`, month: m })}\n            className={cn(\n              \"py-3.5 rounded-[1.25rem] text-sm font-bold transition-all border\",\n              month === m\n                ? \"bg-primary-600 text-white border-primary-600 shadow-lg shadow-primary-100 scale-105 z-10\"\n                : \"bg-white dark:bg-slate-900 text-slate-500 dark:text-slate-400 hover:bg-primary-50 dark:bg-primary-950 hover:text-primary-600 dark:text-primary-400 border-slate-100 dark:border-slate-800\"\n            )}\n          >\n            {m}\n          </button>\n        ))}\n      </div>\n\n      {/* Shortcuts */}\n      {showShortcuts && (\n        <div className=\"flex gap-3 pt-2 border-t border-slate-50 dark:border-slate-800\">\n          <button type=\"button\" onClick={setLastMonth} className=\"flex-1 py-3 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 text-[9px] font-bold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400 hover:text-primary-600 dark:text-primary-400 hover:bg-primary-50 dark:bg-primary-950 hover:border-primary-100 dark:border-primary-800 transition-all active:scale-95\">{t(\"common.filters.last_month\")}</button>\n          <button type=\"button\" onClick={setCurrentMonth} className=\"flex-1 py-3 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 text-[9px] font-bold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400 hover:text-primary-600 dark:text-primary-400 hover:bg-primary-50 dark:bg-primary-950 hover:border-primary-100 dark:border-primary-800 transition-all active:scale-95\">{t(\"common.filters.this_month\")}</button>\n        </div>\n      )}\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/common/NavigableList.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'useCallback' is defined but never used. Allowed unused vars must match /^_/u.","line":1,"column":57,"nodeType":"Identifier","messageId":"unusedVar","endLine":1,"endColumn":68,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"useCallback"},"fix":{"range":[54,67],"text":""},"desc":"Remove unused variable \"useCallback\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Loader2' is defined but never used. Allowed unused vars must match /^_/u.","line":3,"column":19,"nodeType":"Identifier","messageId":"unusedVar","endLine":3,"endColumn":26,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Loader2"},"fix":{"range":[101,110],"text":""},"desc":"Remove unused variable \"Loader2\"."}]}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { RefObject, useEffect, useRef, useState, useCallback } from \"react\";\n\nimport { SearchX, Loader2, ChevronRight } from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport InfiniteScrollSentinel from \"@/components/common/InfiniteScrollSentinel\";\nimport SearchBox from \"@/components/common/SearchBox\";\n\nimport { useInfiniteScroll } from \"@/hooks/use-infinite-scroll\";\nimport { useKeyboardListNav } from \"@/hooks/use-keyboard-list-nav\";\nimport { useStickyHeader } from \"@/hooks/use-sticky-header\";\nimport { cn } from \"@/lib/utils\";\n\n\n\n// ---------------------------------------------------------------------------\n// Column definition\n// ---------------------------------------------------------------------------\n\nexport interface NavigableListColumn<T> {\n    /** Unique key for this column */\n    key: string;\n    /** Header label (already translated) — can be a ReactNode for sort icons, etc. */\n    header: React.ReactNode;\n    /** How to render a cell for a given row item */\n    cell: (item: T, index: number) => React.ReactNode;\n    /** Optional header className override */\n    headerClassName?: string;\n    /** Optional cell className override */\n    cellClassName?: string;\n    /** If true, column is hidden (useful for conditional columns) */\n    hidden?: boolean;\n    /** If provided, header becomes clickable (e.g. for sorting) */\n    onHeaderClick?: () => void;\n}\n\n// ---------------------------------------------------------------------------\n// Component props\n// ---------------------------------------------------------------------------\n\nexport interface NavigableListProps<T> {\n    /** Column definitions */\n    columns: NavigableListColumn<T>[];\n    /** Data items to render */\n    items: T[];\n    /** Unique key extractor for each item */\n    itemKey: (item: T) => string;\n    /** Called when user clicks a row or presses Enter on focused row */\n    onSelect: (item: T) => void;\n    /** Currently selected item key (for active highlight) */\n    selectedKey?: string | null;\n    /** Whether data is loading (show skeletons) */\n    isLoading?: boolean;\n    /** Number of skeleton rows to show while loading */\n    skeletonRows?: number;\n    /** Empty state message */\n    emptyMessage?: string;\n    /** Show a chevron at end of each row */\n    showChevron?: boolean;\n    /** Show an active indicator bar on selected row */\n    showActiveBar?: boolean;\n    /** Prefix for row element IDs (for scroll-into-view) */\n    rowIdPrefix?: string;\n    /** data-testid prefix for rows (item key appended) */\n    testIdPrefix?: string;\n    /** Extra deps to reset keyboard focus */\n    resetDeps?: unknown[];\n\n    // --- Search ---\n    /** Search value (controlled) */\n    searchValue?: string;\n    /** Search change handler */\n    onSearchChange?: (value: string) => void;\n    /** Search placeholder */\n    searchPlaceholder?: string;\n    /** Ref for search input */\n    searchInputRef?: RefObject<HTMLInputElement | null>;\n    /** data-testid for search input */\n    searchTestId?: string;\n\n    // --- Infinite scroll ---\n    hasNextPage?: boolean;\n    isFetchingNextPage?: boolean;\n    fetchNextPage?: () => void;\n\n    // --- Appearance ---\n    /** Container className override */\n    className?: string;\n    /** Max height CSS class (default: \"max-h-[60vh]\") */\n    maxHeightClass?: string;\n    /** Additional content above the table (filters, stats) */\n    headerSlot?: React.ReactNode;\n    /** Ref callback to get the internal keyboard handler (for external search inputs) */\n    onKeyDownRef?: React.MutableRefObject<((e: React.KeyboardEvent<HTMLInputElement>) => void) | null>;\n    /** Enable smart header: auto-hide on scroll down, reveal on scroll up (full-page mode only) */\n    smartHeader?: boolean;\n}\n\n// ---------------------------------------------------------------------------\n// Component\n// ---------------------------------------------------------------------------\n\nexport default function NavigableList<T>({\n    columns,\n    items,\n    itemKey,\n    onSelect,\n    selectedKey,\n    isLoading = false,\n    skeletonRows = 5,\n    emptyMessage,\n    showChevron = true,\n    showActiveBar = false,\n    rowIdPrefix = \"nav-row\",\n    testIdPrefix,\n    resetDeps = [],\n    searchValue,\n    onSearchChange,\n    searchPlaceholder,\n    searchInputRef,\n    searchTestId,\n    hasNextPage,\n    isFetchingNextPage,\n    fetchNextPage,\n    className,\n    maxHeightClass = \"max-h-[60vh]\",\n    headerSlot,\n    onKeyDownRef,\n    smartHeader = false,\n}: NavigableListProps<T>) {\n    const { t } = useTranslation();\n\n    // Keyboard navigation\n    const listNav = useKeyboardListNav({\n        items,\n        onSelect,\n        rowIdPrefix,\n        resetDeps,\n    });\n\n    // Expose keyboard handler to external consumers\n    useEffect(() => {\n        if (onKeyDownRef) {\n            onKeyDownRef.current = listNav.onKeyDown;\n        }\n    }, [onKeyDownRef, listNav.onKeyDown]);\n\n    // Infinite scroll\n    const loadMoreRef = useInfiniteScroll<HTMLTableRowElement>({\n        hasNextPage: hasNextPage ?? false,\n        isFetchingNextPage: isFetchingNextPage ?? false,\n        fetchNextPage: fetchNextPage ?? (() => { }),\n    });\n\n    const visibleColumns = columns.filter((c) => !c.hidden);\n    const colSpan = visibleColumns.length + (showChevron ? 1 : 0);\n\n    // Measure sticky search bar height for thead offset in full-page mode\n    const isFullPage = !maxHeightClass;\n    const smartHeaderEnabled = isFullPage && smartHeader;\n    const stickySearchRef = useRef<HTMLDivElement>(null);\n    const [measuredSearchHeight, setMeasuredSearchHeight] = useState(0);\n\n    // Smart header (auto-hide / reveal on scroll)\n    const { headerRef: smartHeaderRef, isVisible: smartHeaderVisible, headerHeight: smartHeaderHeight } = useStickyHeader({\n        enabled: smartHeaderEnabled,\n    });\n\n    // For non-smart-header full-page mode: measure search bar height via ResizeObserver\n    useEffect(() => {\n        if (!isFullPage || smartHeaderEnabled || !stickySearchRef.current) return;\n        const el = stickySearchRef.current;\n        const update = () => setMeasuredSearchHeight(el.offsetHeight);\n        update();\n        const ro = new ResizeObserver(update);\n        ro.observe(el);\n        return () => ro.disconnect();\n    }, [isFullPage, smartHeaderEnabled]);\n\n    // Compute offset: smart header mode derives from hook state, otherwise from measured search height\n    const stickyOffset = smartHeaderEnabled\n        ? (smartHeaderVisible ? smartHeaderHeight : 0)\n        : (isFullPage ? measuredSearchHeight : 0);\n\n    return (\n        <div className={cn(\"flex flex-col gap-6\", className)}>\n            {/* Smart header wrapper — auto-hide on scroll down, reveal on scroll up */}\n            {smartHeaderEnabled ? (\n                <div\n                    ref={smartHeaderRef}\n                    className={cn(\n                        \"sticky top-0 z-20 backdrop-blur-md transition-transform duration-300 ease-out\",\n                        smartHeaderVisible ? \"translate-y-0\" : \"-translate-y-full\"\n                    )}\n                >\n                    <div className=\"flex flex-col gap-6 pb-2\">\n                        {headerSlot}\n                        {onSearchChange && (\n                            <SearchBox\n                                value={searchValue ?? \"\"}\n                                onChange={onSearchChange}\n                                onKeyDown={listNav.onKeyDown}\n                                inputRef={searchInputRef}\n                                placeholder={searchPlaceholder}\n                                data-testid={searchTestId ?? \"navigable-list-search\"}\n                            />\n                        )}\n                    </div>\n                </div>\n            ) : (\n                <>\n                    {/* Optional header slot (filters, stats) */}\n                    {headerSlot}\n\n                    {/* In full-page mode, search + header stick together as one group */}\n                    {isFullPage && onSearchChange && (\n                        <div ref={stickySearchRef} className=\"sticky top-0 z-20 backdrop-blur-md pt-1 pb-2 -mt-1\">\n                            <SearchBox\n                                value={searchValue ?? \"\"}\n                                onChange={onSearchChange}\n                                onKeyDown={listNav.onKeyDown}\n                                inputRef={searchInputRef}\n                                placeholder={searchPlaceholder}\n                                data-testid={searchTestId ?? \"navigable-list-search\"}\n                            />\n                        </div>\n                    )}\n                </>\n            )}\n\n            {/* In constrained mode, search renders normally */}\n            {!isFullPage && onSearchChange && (\n                <SearchBox\n                    value={searchValue ?? \"\"}\n                    onChange={onSearchChange}\n                    onKeyDown={listNav.onKeyDown}\n                    inputRef={searchInputRef}\n                    placeholder={searchPlaceholder}\n                    data-testid={searchTestId ?? \"navigable-list-search\"}\n                />\n            )}\n\n            {/* Table container */}\n            <div className={cn(\"bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-[2.5rem] shadow-sm\", isFullPage ? \"overflow-x-clip\" : \"overflow-hidden\")}>\n                <div className={cn(isFullPage ? \"\" : \"overflow-auto\", maxHeightClass)}>\n                    <table className=\"w-full text-left border-collapse\">\n                        {/* Header */}\n                        <thead>\n                            <tr\n                                className=\"bg-slate-50/95 dark:bg-slate-800/95 backdrop-blur-sm border-b border-slate-100 dark:border-slate-800 sticky z-10\"\n                                style={{ top: isFullPage ? stickyOffset : 0 }}\n                            >\n                                {visibleColumns.map((col) => (\n                                    <th\n                                        key={col.key}\n                                        onClick={col.onHeaderClick}\n                                        className={cn(\n                                            \"px-8 py-5 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em]\",\n                                            col.onHeaderClick && \"cursor-pointer hover:text-primary-600 dark:hover:text-primary-400 transition-colors group\",\n                                            col.headerClassName\n                                        )}\n                                    >\n                                        {col.header}\n                                    </th>\n                                ))}\n                                {showChevron && <th className=\"px-4 py-5 w-10\" />}\n                            </tr>\n                        </thead>\n\n                        {/* Body */}\n                        <tbody className=\"divide-y divide-slate-50 dark:divide-slate-800\">\n                            {isLoading ? (\n                                // Loading skeletons\n                                Array.from({ length: skeletonRows }).map((_, i) => (\n                                    <tr key={`skeleton-${i}`}>\n                                        {visibleColumns.map((col) => (\n                                            <td key={col.key} className={cn(\"px-8 py-5\", col.cellClassName)}>\n                                                <div className=\"h-4 w-24 bg-slate-200 dark:bg-slate-800 rounded animate-pulse\" />\n                                            </td>\n                                        ))}\n                                        {showChevron && <td className=\"px-4 py-5\" />}\n                                    </tr>\n                                ))\n                            ) : items.length === 0 ? (\n                                // Empty state\n                                <tr>\n                                    <td colSpan={colSpan} className=\"px-10 py-32\">\n                                        <div className=\"flex flex-col items-center justify-center text-center animate-in fade-in zoom-in-95 duration-500 max-w-sm mx-auto\">\n                                            <div className=\"w-20 h-20 mb-6 rounded-3xl bg-slate-50 dark:bg-slate-800/80 flex items-center justify-center text-slate-300 dark:text-slate-600 shadow-inner border border-slate-100 dark:border-slate-700/50 rotate-3\">\n                                                <SearchX size={32} className=\"-rotate-3\" />\n                                            </div>\n                                            <h3 className=\"text-sm font-bold text-slate-700 dark:text-slate-200 uppercase tracking-widest mb-2\">\n                                                {emptyMessage ?? t(\"common.no_data\", \"No data\")}\n                                            </h3>\n                                        </div>\n                                    </td>\n                                </tr>\n                            ) : (\n                                // Data rows\n                                items.map((item, index) => {\n                                    const key = itemKey(item);\n                                    const isSelected = selectedKey != null && key === selectedKey;\n                                    const isFocused = listNav.focusedIndex === index;\n\n                                    return (\n                                        <tr\n                                            key={key}\n                                            id={`${rowIdPrefix}-${index}`}\n                                            data-testid={testIdPrefix ? `${testIdPrefix}-${key}` : undefined}\n                                            onClick={() => onSelect(item)}\n                                            className={cn(\n                                                \"cursor-pointer transition-all group relative\",\n                                                isSelected\n                                                    ? \"bg-primary-50 dark:bg-primary-950/50\"\n                                                    : isFocused\n                                                        ? \"bg-primary-50/50 dark:bg-primary-900/20 ring-1 ring-inset ring-primary-500/50\"\n                                                        : \"hover:bg-slate-50 dark:hover:bg-slate-800/50\"\n                                            )}\n                                        >\n                                            {visibleColumns.map((col) => (\n                                                <td key={col.key} className={cn(\"px-8 py-5\", col.cellClassName)}>\n                                                    {col.cell(item, index)}\n                                                </td>\n                                            ))}\n                                            {showChevron && (\n                                                <td className=\"px-4 py-5 text-right\">\n                                                    <ChevronRight\n                                                        size={16}\n                                                        className={cn(\n                                                            \"transition-all duration-200 ml-auto\",\n                                                            isSelected\n                                                                ? \"translate-x-1 text-primary-600 dark:text-primary-400\"\n                                                                : \"text-slate-300 dark:text-slate-600 group-hover:text-primary-500 dark:group-hover:text-primary-400 group-hover:translate-x-1\"\n                                                        )}\n                                                    />\n                                                </td>\n                                            )}\n                                            {showActiveBar && isSelected && (\n                                                <div className=\"absolute left-0 top-0 bottom-0 w-1.5 bg-primary-600 rounded-r-full shadow-lg shadow-primary-500/50\" />\n                                            )}\n                                        </tr>\n                                    );\n                                })\n                            )}\n\n                            {/* Infinite scroll sentinel */}\n                            {fetchNextPage && (\n                                <InfiniteScrollSentinel\n                                    sentinelRef={loadMoreRef}\n                                    isFetchingNextPage={isFetchingNextPage ?? false}\n                                    colSpan={colSpan}\n                                />\n                            )}\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n        </div>\n    );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/common/NewVersionBanner.tsx","messages":[{"ruleId":"import-x/no-named-as-default-member","severity":1,"message":"Caution: `React` also has a named export `useState`. Check if you meant to write `import {useState} from 'react'` instead.","line":9,"column":33,"nodeType":"MemberExpression","messageId":"member","endLine":9,"endColumn":47}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from \"react\";\n\ninterface NewVersionBannerProps {\n  onRefresh: () => void;\n  onDismiss: () => void;\n}\n\nexport function NewVersionBanner({ onRefresh, onDismiss }: NewVersionBannerProps) {\n  const [leaving, setLeaving] = React.useState(false);\n\n  const handleRefresh = () => {\n    setLeaving(true);\n    setTimeout(() => onRefresh(), 300);\n  };\n\n  const handleDismiss = () => {\n    setLeaving(true);\n    setTimeout(() => onDismiss(), 300);\n  };\n\n  return (\n    <div\n      className={`fixed top-0 left-0 right-0 z-[9999] transition-transform duration-300 ${\n        leaving ? \"-translate-y-full\" : \"translate-y-0\"\n      }`}\n    >\n      <div className=\"mx-auto max-w-7xl px-4 py-2.5\">\n        <div className=\"flex items-center justify-between gap-4 rounded-xl bg-blue-600 px-5 py-3 text-white shadow-lg\">\n          <div className=\"flex items-center gap-2 text-sm font-medium\">\n            <svg className=\"h-4 w-4 shrink-0\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\">\n              <path d=\"M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9\" />\n            </svg>\n            <span>A new version is available</span>\n          </div>\n          <div className=\"flex items-center gap-2 shrink-0\">\n            <button\n              onClick={handleRefresh}\n              className=\"rounded-lg bg-white/20 px-4 py-1.5 text-sm font-medium hover:bg-white/30 transition-colors\"\n            >\n              Refresh\n            </button>\n            <button\n              onClick={handleDismiss}\n              className=\"rounded-lg p-1.5 hover:bg-white/20 transition-colors\"\n              aria-label=\"Dismiss\"\n            >\n              <svg className=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\">\n                <path d=\"M18 6L6 18M6 6l12 12\" />\n              </svg>\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/common/PaginationControls.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/common/PermissionGate.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/common/SearchBox.tsx","messages":[{"ruleId":"jsx-a11y/no-autofocus","severity":2,"message":"The autoFocus prop should not be used, as it can reduce usability and accessibility for users.","line":37,"column":17,"nodeType":"JSXAttribute","endLine":37,"endColumn":38}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from \"react\";\n\nimport { Search, X } from \"lucide-react\";\n\nimport { cn } from \"@/lib/utils\";\n\ninterface SearchBoxProps {\n    value: string;\n    onChange: (value: string) => void;\n    placeholder?: string;\n    autoFocus?: boolean;\n    inputRef?: React.RefObject<HTMLInputElement | null>;\n    onKeyDown?: (e: React.KeyboardEvent<HTMLInputElement>) => void;\n    className?: string;\n    \"data-testid\"?: string;\n}\n\nexport default function SearchBox({\n    value,\n    onChange,\n    placeholder = \"Search...\",\n    autoFocus = true,\n    inputRef,\n    onKeyDown,\n    className,\n    \"data-testid\": testId = \"search-box\",\n}: SearchBoxProps) {\n    return (\n        <div className={cn(\"relative\", className)}>\n            <Search\n                size={18}\n                className=\"absolute left-6 top-1/2 -translate-y-1/2 text-slate-400 dark:text-slate-500 pointer-events-none\"\n            />\n            <input\n                ref={inputRef}\n                data-testid={testId}\n                autoFocus={autoFocus}\n                type=\"text\"\n                value={value}\n                onChange={(e) => onChange(e.target.value)}\n                onKeyDown={onKeyDown}\n                onFocus={(e) => e.target.select()}\n                placeholder={placeholder}\n                className=\"w-full pl-14 pr-12 py-4 bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-2xl text-sm font-bold text-slate-700 dark:text-slate-200 placeholder:text-slate-400 dark:placeholder:text-slate-500 placeholder:font-medium focus:outline-none focus:ring-4 focus:ring-primary-500/10 focus:border-primary-300 dark:focus:border-primary-700 transition-all shadow-sm uppercase tracking-tight\"\n            />\n            {value && (\n                <button\n                    onClick={() => onChange(\"\")}\n                    className=\"absolute right-4 top-1/2 -translate-y-1/2 p-1.5 rounded-lg text-slate-400 hover:text-rose-500 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all active:scale-90\"\n                >\n                    <X size={16} />\n                </button>\n            )}\n        </div>\n    );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/common/TableSkeleton.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/common/TemporalConfigTable.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Trash2' is defined but never used. Allowed unused vars must match /^_/u.","line":3,"column":16,"nodeType":"Identifier","messageId":"unusedVar","endLine":3,"endColumn":22,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Trash2"},"fix":{"range":[55,63],"text":""},"desc":"Remove unused variable \"Trash2\"."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from \"react\";\n\nimport { Plus, Trash2, Calendar, History, Save, Calculator, AlertCircle, CheckCircle2 } from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { useDateTimeFormatter } from \"@/hooks/use-datetime\";\nimport { cn } from \"@/lib/utils\";\n\ninterface ConfigRecord {\n  id?: string;\n  std_working_days: number;\n  hours_per_day: number;\n  max_ot_hours_per_day?: number | null;\n  max_ot_hours_per_month?: number | null;\n  effective_date: string;\n  created_at?: string;\n  is_virtual?: boolean;\n}\n\ninterface Props {\n  title: string;\n  records: ConfigRecord[];\n  onSave: (data: { std_working_days: number; hours_per_day: number; max_ot_hours_per_day: number | null; max_ot_hours_per_month: number | null; effective_date: string }) => Promise<void>;\n  isLoading?: boolean;\n}\n\nexport default function TemporalConfigTable({ title, records, onSave, isLoading }: Props) {\n  const { t } = useTranslation();\n  const { formatDate } = useDateTimeFormatter();\n  const [isAdding, setIsAdding] = useState(false);\n  const [newDays, setNewDays] = useState<number>(26);\n  const [newHours, setNewHours] = useState<number>(8);\n  const [newMaxOtDay, setNewMaxOtDay] = useState<string>(\"4\");\n  const [newMaxOtMonth, setNewMaxOtMonth] = useState<string>(\"40\");\n\n  const firstOfMonth = new Date(); firstOfMonth.setDate(1);\n  const [newEffectiveDate, setNewEffectiveDate] = useState(firstOfMonth.toISOString().split('T')[0]);\n\n  const handleSave = async () => {\n    await onSave({\n      std_working_days: newDays,\n      hours_per_day: newHours,\n      max_ot_hours_per_day: newMaxOtDay === '' ? null : parseFloat(newMaxOtDay),\n      max_ot_hours_per_month: newMaxOtMonth === '' ? null : parseFloat(newMaxOtMonth),\n      effective_date: newEffectiveDate,\n    });\n    setIsAdding(false);\n  };\n\n  const displayRecords = [...records];\n  if (displayRecords.length === 0 && !isLoading) {\n    displayRecords.push({ std_working_days: 26, hours_per_day: 8, effective_date: \"1970-01-01\", is_virtual: true });\n  }\n\n  const sortedRecords = displayRecords.sort((a, b) => new Date(b.effective_date).getTime() - new Date(a.effective_date).getTime());\n  const now = new Date();\n  const activeIdx = sortedRecords.findIndex(r => new Date(r.effective_date) <= now);\n\n  return (\n    <div className=\"space-y-8 animate-in fade-in duration-500\">\n      <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-6 px-2\">\n        <div className=\"flex items-center gap-4\">\n          <div className=\"w-10 h-10 rounded-2xl bg-primary-50 dark:bg-primary-950 flex items-center justify-center text-primary-600 dark:text-primary-400 shadow-sm border border-primary-100 dark:border-primary-800/50\"><Calculator size={20} /></div>\n          <div>\n            <h3 className=\"text-lg font-bold text-slate-800 dark:text-slate-100 tracking-tight uppercase\">{title}</h3>\n            <p className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest mt-0.5\">{t(\"payroll.settings.policy_desc\")}</p>\n          </div>\n        </div>\n        {!isAdding && (\n          <button onClick={() => setIsAdding(true)} className=\"flex items-center justify-center gap-2 bg-primary-600 text-white px-6 py-2.5 rounded-2xl font-bold text-[10px] uppercase tracking-widest hover:bg-primary-700 transition-all shadow-lg shadow-primary-100 active:scale-95\"><Plus size={14} /> {t(\"common.add_new\").toUpperCase()}</button>\n        )}\n      </div>\n\n      {isAdding && (\n        <div className=\"bg-white dark:bg-slate-900 border-2 border-primary-100 dark:border-primary-800 rounded-[2.5rem] p-8 shadow-xl shadow-primary-50/50 animate-in slide-in-from-top-4 duration-500\">\n          <div className=\"flex items-center gap-3 mb-8 text-primary-700 dark:text-primary-300\">\n            <div className=\"w-8 h-8 rounded-xl bg-primary-50 dark:bg-primary-950 flex items-center justify-center shadow-inner\"><Plus size={16} /></div>\n            <h4 className=\"text-[10px] font-bold uppercase tracking-[0.2em]\">{t(\"payroll.settings.add_version\")}</h4>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-8 mb-8\">\n            <div className=\"space-y-3\">\n              <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">{t(\"payroll.settings.effective_date\")}</label>\n              <input type=\"date\" value={newEffectiveDate} onChange={e => setNewEffectiveDate(e.target.value)} className=\"w-full bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl px-5 py-4 text-sm font-bold focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all\" />\n            </div>\n            <div className=\"space-y-3\">\n              <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">{t(\"payroll.settings.std_days\")}</label>\n              <input type=\"number\" value={newDays} onChange={e => setNewDays(parseFloat(e.target.value))} className=\"w-full bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl px-5 py-4 text-sm font-bold focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-mono\" />\n            </div>\n            <div className=\"space-y-3\">\n              <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">{t(\"payroll.settings.hours_per_day\")}</label>\n              <input type=\"number\" value={newHours} onChange={e => setNewHours(parseFloat(e.target.value))} className=\"w-full bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl px-5 py-4 text-sm font-bold focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-mono\" />\n            </div>\n          </div>\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8 mb-8\">\n            <div className=\"space-y-3\">\n              <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">{t(\"payroll.settings.max_ot_hours_per_day\")}</label>\n              <input type=\"number\" step=\"0.5\" value={newMaxOtDay} onChange={e => setNewMaxOtDay(e.target.value)} placeholder={t(\"payroll.settings.no_limit\") || \"\"} className=\"w-full bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl px-5 py-4 text-sm font-bold focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-mono\" />\n              <p className=\"text-[9px] text-slate-400 ml-1\">{t(\"payroll.settings.ot_empty_hint\")}</p>\n            </div>\n            <div className=\"space-y-3\">\n              <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">{t(\"payroll.settings.max_ot_hours_per_month\")}</label>\n              <input type=\"number\" step=\"0.5\" value={newMaxOtMonth} onChange={e => setNewMaxOtMonth(e.target.value)} placeholder={t(\"payroll.settings.no_limit\") || \"\"} className=\"w-full bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl px-5 py-4 text-sm font-bold focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-mono\" />\n              <p className=\"text-[9px] text-slate-400 ml-1\">{t(\"payroll.settings.ot_empty_hint\")}</p>\n            </div>\n          </div>\n\n          <div className=\"p-6 bg-amber-50 dark:bg-amber-950/50 border border-amber-100 dark:border-amber-800 rounded-[1.5rem] flex gap-4 mb-8 shadow-inner\">\n            <AlertCircle className=\"w-6 h-6 text-amber-500 shrink-0\" />\n            <p className=\"text-[10px] text-amber-800 leading-relaxed font-bold uppercase tracking-tight opacity-80\">{t(\"payroll.settings.date_warning\")}</p>\n          </div>\n\n          <div className=\"flex justify-end gap-4\">\n            <button onClick={() => setIsAdding(false)} className=\"px-8 py-4 rounded-2xl font-bold text-[10px] uppercase tracking-widest text-slate-500 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-all\">{t(\"common.cancel\")}</button>\n            <button onClick={handleSave} className=\"flex items-center gap-3 bg-primary-600 text-white px-10 py-4 rounded-2xl font-bold text-[10px] uppercase tracking-widest hover:bg-primary-700 transition-all shadow-xl shadow-primary-100 dark:shadow-black/30 active:scale-95\"><Save size={16} /> {t(\"common.save\").toUpperCase()}</button>\n          </div>\n        </div>\n      )}\n\n      <div className=\"bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-[2.5rem] overflow-hidden shadow-sm\">\n        {isLoading ? (\n          <div className=\"p-20 text-center\"><div className=\"w-10 h-10 border-4 border-primary-600 border-t-transparent rounded-full animate-spin mx-auto\"></div></div>\n        ) : (\n          <table className=\"w-full text-left border-collapse\">\n            <thead>\n              <tr className=\"bg-slate-50 dark:bg-slate-800/50 border-b border-slate-100 dark:border-slate-800\">\n                <th className=\"px-8 py-5 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">{t(\"payroll.settings.status\")}</th>\n                <th className=\"px-8 py-5 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">{t(\"payroll.settings.effective_date\")}</th>\n                <th className=\"px-8 py-5 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest text-right\">{t(\"payroll.settings.std_days\")}</th>\n                <th className=\"px-8 py-5 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest text-right\">{t(\"payroll.settings.hours_per_day\")}</th>\n                <th className=\"px-8 py-5 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest text-right\">{t(\"payroll.settings.max_ot_day_short\")}</th>\n                <th className=\"px-8 py-5 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest text-right\">{t(\"payroll.settings.max_ot_month_short\")}</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-50 dark:divide-slate-800\">\n              {sortedRecords.map((record, idx) => {\n                const isActive = idx === activeIdx; const isFuture = new Date(record.effective_date) > now;\n                return (\n                  <tr key={idx} className={cn(\"group transition-all hover:bg-slate-50 dark:hover:bg-slate-800/50\", isActive && \"bg-emerald-50 dark:bg-emerald-950/30\")}>\n                    <td className=\"px-8 py-6\">\n                      {record.is_virtual ? (\n                        <span className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[9px] font-bold uppercase tracking-widest border bg-amber-50 dark:bg-amber-950 text-amber-600 dark:text-amber-300 border-amber-100 dark:border-amber-800 shadow-sm\"><AlertCircle size={12} /> {t(\"payroll.settings.virtual\")}</span>\n                      ) : isActive ? (\n                        <span className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[9px] font-bold uppercase tracking-widest border bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-300 border-emerald-100 dark:border-emerald-800 shadow-sm\"><CheckCircle2 size={12} /> {t(\"common.active\")}</span>\n                      ) : isFuture ? (\n                        <span className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[9px] font-bold uppercase tracking-widest border bg-blue-50 dark:bg-blue-950 text-blue-600 dark:text-blue-300 border-blue-100 dark:border-blue-800 shadow-sm\"><Calendar size={12} /> {t(\"common.upcoming\")}</span>\n                      ) : (\n                        <span className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[9px] font-bold uppercase tracking-widest border bg-slate-50 dark:bg-slate-800 text-slate-500 dark:text-slate-400 border-slate-100 dark:border-slate-800 opacity-60\"><History size={12} /> {t(\"common.expired\")}</span>\n                      )}\n                    </td>\n                    <td className=\"px-8 py-6\"><div className={cn(\"text-sm font-bold uppercase tracking-tight\", isActive ? \"text-slate-700 dark:text-slate-200\" : \"text-slate-500 dark:text-slate-400\")}>{record.is_virtual ? t(\"common.from_start\") : formatDate(record.effective_date)}</div></td>\n                    <td className=\"px-8 py-6 text-right font-mono font-bold\"><span className={cn(\"text-sm\", isActive ? \"text-primary-600 dark:text-primary-400\" : \"text-slate-500 dark:text-slate-400\")}>{record.std_working_days} {t(\"common.days_short\")}</span></td>\n                    <td className=\"px-8 py-6 text-right font-mono font-bold\"><span className={cn(\"text-sm\", isActive ? \"text-slate-700 dark:text-slate-200\" : \"text-slate-300 dark:text-slate-600\")}>{record.hours_per_day}h / {t(\"common.day_short\")}</span></td>\n                    <td className=\"px-8 py-6 text-right font-mono font-bold\"><span className={cn(\"text-sm\", isActive ? \"text-amber-600 dark:text-amber-400\" : \"text-slate-300 dark:text-slate-600\")}>{record.max_ot_hours_per_day != null ? `${record.max_ot_hours_per_day}h` : '∞'}</span></td>\n                    <td className=\"px-8 py-6 text-right font-mono font-bold\"><span className={cn(\"text-sm\", isActive ? \"text-amber-600 dark:text-amber-400\" : \"text-slate-300 dark:text-slate-600\")}>{record.max_ot_hours_per_month != null ? `${record.max_ot_hours_per_month}h` : '∞'}</span></td>\n                  </tr>\n                );\n              })}\n            </tbody>\n          </table>\n        )}\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/common/WorkspaceGuard.tsx","messages":[],"suppressedMessages":[{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/workspace/webdashboard/src/components/common/WorkspaceGuard.tsx:36:7\n  34 |       setCurrentWorkspaceId(workspaces[0].id);\n  35 |       // eslint-disable-next-line react-hooks/set-state-in-effect\n> 36 |       setActiveWsId(workspaces[0].id);\n     |       ^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  37 |     }\n  38 |   }, [workspaces, activeWsId, isLoading]);\n  39 |","line":36,"column":7,"nodeType":null,"endLine":36,"endColumn":20,"suppressions":[{"kind":"directive","justification":""}]}],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/common/__tests__/EmployeeSearch.test.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":36,"column":18,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":36,"endColumn":21,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1076,1079],"