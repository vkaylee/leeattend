:"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[2186,2189],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":4,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from \"react\";\n\nimport { ShieldAlert, ShieldCheck, Shield, Users, Plus, Trash2, ShieldHalf } from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport Modal from \"@/components/ui/Modal\";\nimport PageHeader from \"@/components/ui/PageHeader\";\n\nimport { useConfirm } from \"@/hooks/use-confirm\";\nimport { useSystemRoles } from \"@/hooks/use-system-roles\";\nimport { cn } from \"@/lib/utils\";\n\n\n\nconst roleDescriptions: Record<string, string> = {\n  platform_admin: \"system_roles.descriptions.platform_admin\",\n  support: \"system_roles.descriptions.support\",\n  billing_admin: \"system_roles.descriptions.billing_admin\",\n};\n\nconst roleIcons: Record<string, any> = {\n  platform_admin: ShieldAlert,\n  support: ShieldCheck,\n  billing_admin: ShieldHalf,\n};\n\nexport default function SystemRolesPage() {\n  const { t } = useTranslation();\n  const { roles, isLoading, assignRole, revokeRole, isAssigning, isRevoking } = useSystemRoles();\n  const { confirm, ConfirmationDialog } = useConfirm();\n  const [isModalOpen, setIsModalOpen] = useState(false);\n  const [selectedRole, setSelectedRole] = useState<string | null>(null);\n  const [userIdInput, setUserIdInput] = useState(\"\");\n  const [assignError, setAssignError] = useState(\"\");\n\n  const handleOpenAssign = (roleName: string) => {\n    setSelectedRole(roleName);\n    setUserIdInput(\"\");\n    setAssignError(\"\");\n    setIsModalOpen(true);\n  };\n\n  const handleAssignSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!selectedRole || !userIdInput.trim()) return;\n    try {\n      setAssignError(\"\");\n      await assignRole({ userId: userIdInput.trim(), request: { role_name: selectedRole } });\n      setIsModalOpen(false);\n    } catch (err: any) {\n      setAssignError(err.message || t(\"system_roles.messages.assign_error\"));\n    }\n  };\n\n  const handleRevoke = async (userId: string, roleName: string) => {\n    const isConfirmed = await confirm({\n      title: t(\"system_roles.confirm.revoke_title\"),\n      message: t(\"system_roles.confirm.revoke_message\"),\n      variant: \"danger\"\n    });\n    if (isConfirmed) {\n      try {\n        await revokeRole({ userId, roleName });\n      } catch (err: any) {\n        alert(err.message || t(\"system_roles.messages.revoke_error\"));\n      }\n    }\n  };\n\n  return (\n    <div className=\"space-y-8 animate-in fade-in duration-500\">\n      <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4\">\n        <PageHeader\n          title={t(\"system_roles.title\")}\n          subtitle={t(\"system_roles.subtitle\")}\n        />\n      </div>\n\n      {isLoading ? (\n        <div className=\"flex justify-center p-20\">\n          <div className=\"w-10 h-10 border-4 border-indigo-600 border-t-transparent rounded-full animate-spin\"></div>\n        </div>\n      ) : (\n        <div className=\"grid grid-cols-1 xl:grid-cols-2 gap-6\">\n          {roles.map((role) => {\n            const Icon = roleIcons[role.name] || Shield;\n            \n            return (\n              <div\n                key={role.id}\n                className=\"bg-white dark:bg-slate-900 rounded-[2rem] border border-slate-100 dark:border-slate-800 p-6 shadow-sm hover:shadow-xl hover:shadow-slate-200/50 dark:hover:shadow-black/20 transition-all duration-300 group flex flex-col\"\n              >\n                <div className=\"flex items-start justify-between mb-4\">\n                  <div className=\"flex items-center gap-4\">\n                    <div className=\"w-14 h-14 rounded-2xl flex items-center justify-center border bg-indigo-50 text-indigo-600 dark:bg-indigo-500/10 dark:text-indigo-400 border-indigo-200/50 dark:border-indigo-500/20\">\n                      <Icon size={24} />\n                    </div>\n                    <div>\n                      <div className=\"flex items-center gap-2\">\n                        <h3 className=\"text-lg font-bold text-slate-800 dark:text-slate-200\">\n                          {role.name}\n                        </h3>\n                        <span className=\"px-2 py-0.5 rounded-lg text-[10px] font-bold uppercase tracking-wider bg-rose-100 dark:bg-rose-900/30 text-rose-600 dark:text-rose-400\">\n                          {t(\"system_roles.system_label\")}\n                        </span>\n                      </div>\n                      <div className=\"flex items-center gap-1.5 text-sm font-medium text-slate-500 mt-1\">\n                        <Users size={14} />\n                        <span>{t(\"system_roles.assignees_count\", { count: role.assignees?.length || 0 })}</span>\n                      </div>\n                    </div>\n                  </div>\n                  \n                  <button\n                    onClick={() => handleOpenAssign(role.name)}\n                    className=\"p-2 text-indigo-600 bg-indigo-50 hover:bg-indigo-100 dark:bg-indigo-500/10 dark:text-indigo-400 dark:hover:bg-indigo-500/20 rounded-xl transition-colors\"\n                    title={t(\"system_roles.assign_to_user\")}\n                  >\n                    <Plus size={20} />\n                  </button>\n                </div>\n\n                <p className=\"text-sm font-medium text-slate-500 dark:text-slate-400 mb-6 flex-1\">\n                  {role.description || t(roleDescriptions[role.name] || \"system_roles.descriptions.default\")}\n                </p>\n\n                <div className=\"space-y-3 pt-4 border-t border-slate-100 dark:border-slate-800\">\n                  <h4 className=\"text-xs font-bold text-slate-400 uppercase tracking-wider\">{t(\"system_roles.assigned_users\")}</h4>\n                  {role.assignees?.length === 0 ? (\n                    <p className=\"text-sm text-slate-500 italic\">{t(\"system_roles.no_users\")}</p>\n                  ) : (\n                    <div className=\"space-y-2 max-h-[200px] overflow-y-auto pr-2 custom-scrollbar\">\n                      {role.assignees?.map((assignee) => (\n                        <div key={assignee.user_id} className=\"flex items-center justify-between p-3 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800\">\n                          <div className=\"flex flex-col\">\n                            <span className=\"text-sm font-bold text-slate-700 dark:text-slate-300 font-mono\">\n                              {assignee.user_id}\n                            </span>\n                            <span className=\"text-xs text-slate-500\">\n                              {t(\"system_roles.assigned_date\", { date: new Date(assignee.assigned_at).toLocaleDateString() })}\n                            </span>\n                          </div>\n                          <button\n                            onClick={() => handleRevoke(assignee.user_id, role.name)}\n                            disabled={isRevoking}\n                            className=\"p-2 text-slate-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-500/10 rounded-lg transition-colors disabled:opacity-50\"\n                            title={t(\"system_roles.revoke_role\")}\n                          >\n                            <Trash2 size={16} />\n                          </button>\n                        </div>\n                      ))}\n                    </div>\n                  )}\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      )}\n\n      <Modal\n        isOpen={isModalOpen}\n        onClose={() => setIsModalOpen(false)}\n        title={t(\"system_roles.modal.assign_title\", { role: selectedRole })}\n        subtitle={t(\"system_roles.grant_privileges\")}\n        maxWidth=\"md\"\n      >\n        <form onSubmit={handleAssignSubmit} className=\"space-y-6\">\n          <div className=\"space-y-2\">\n            <label className=\"text-sm font-bold text-slate-700 dark:text-slate-300\">\n              {t(\"system_roles.user_id_label\")}\n            </label>\n            <input\n              type=\"text\"\n              value={userIdInput}\n              onChange={(e) => setUserIdInput(e.target.value)}\n              placeholder=\"e.g. 123e4567-e89b-12d3-a456-426614174000\"\n              className=\"w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all font-mono text-sm\"\n              required\n            />\n            {assignError && (\n              <p className=\"text-sm text-rose-500 font-medium mt-1\">{assignError}</p>\n            )}\n          </div>\n          \n          <div className=\"flex justify-end gap-3 pt-4 border-t border-slate-100 dark:border-slate-800\">\n            <button\n              type=\"button\"\n              onClick={() => setIsModalOpen(false)}\n              className=\"px-5 py-2.5 text-sm font-bold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-xl transition-colors\"\n            >\n              {t(\"common.cancel\")}\n            </button>\n            <button\n              type=\"submit\"\n              disabled={isAssigning || !userIdInput.trim()}\n              className=\"px-5 py-2.5 text-sm font-bold text-white bg-indigo-600 hover:bg-indigo-700 rounded-xl transition-all disabled:opacity-50 shadow-md shadow-indigo-200 dark:shadow-none\"\n            >\n              {isAssigning ? t(\"system_roles.modal.assigning\") : t(\"system_roles.modal.submit_btn\")}\n            </button>\n          </div>\n        </form>\n      </Modal>\n      <ConfirmationDialog />\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/WorkerMonitorPage.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'sseConnected' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":33,"column":22,"nodeType":"Identifier","messageId":"unusedVar","endLine":33,"endColumn":34}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { formatDistanceToNow } from \"date-fns\";\nimport {\n  Activity,\n  Server,\n  CheckCircle2,\n  XCircle,\n  Clock,\n  Cpu,\n  RefreshCw,\n  Loader2,\n  Zap,\n  Coffee,\n  AlertTriangle,\n  Briefcase,\n  ArrowUp,\n  ArrowDown,\n} from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport JobStatusDistributionChart from \"@/components/features/monitor/JobStatusDistributionChart\";\nimport QueuePressureChart from \"@/components/features/monitor/QueuePressureChart\";\nimport WorkerUtilizationGauge from \"@/components/features/monitor/WorkerUtilizationGauge\";\n\nimport { useWorkerUtilization, useQueuePressure, useJobStatusDistribution } from \"@/hooks/use-monitor-charts\";\nimport { useMonitorStream } from \"@/hooks/use-monitor-stream\";\nimport { useWorkerMonitor, MONITOR_REFETCH_INTERVAL_S } from \"@/hooks/use-worker-monitor\";\nimport { cn } from \"@/lib/utils\";\n\n\nexport default function WorkerMonitorPage() {\n  const { t } = useTranslation();\n  const { stats, workers, recentJobs, isLoading, isFetching, error, refetch } = useWorkerMonitor();\n  const { connected: sseConnected } = useMonitorStream();\n  const utilization = useWorkerUtilization(stats);\n  const queuePressure = useQueuePressure(stats);\n  const jobDistribution = useJobStatusDistribution(recentJobs);\n\n  const statCards = [\n    {\n      label: t(\"monitor.pending_high\"),\n      value: stats?.pending_high ?? 0,\n      icon: ArrowUp,\n      color: \"bg-orange-50 dark:bg-orange-950 text-orange-600 dark:text-orange-300 border-orange-100 dark:border-orange-800\",\n      bgIcon: \"text-orange-100\",\n    },\n    {\n      label: t(\"monitor.pending_low\"),\n      value: stats?.pending_low ?? 0,\n      icon: ArrowDown,\n      color: \"bg-amber-50 dark:bg-amber-950 text-amber-600 dark:text-amber-300 border-amber-100 dark:border-amber-800\",\n      bgIcon: \"text-amber-100\",\n    },\n    {\n      label: t(\"monitor.active_workers\"),\n      value: stats?.active_workers ?? 0,\n      icon: Zap,\n      color: \"bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-300 border-emerald-100 dark:border-emerald-800\",\n      bgIcon: \"text-emerald-100\",\n    },\n    {\n      label: t(\"monitor.idle_workers\"),\n      value: stats?.idle_workers ?? 0,\n      icon: Coffee,\n      color: \"bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border-slate-100 dark:border-slate-700\",\n      bgIcon: \"text-slate-100\",\n    },\n    {\n      label: t(\"monitor.completed_today\"),\n      value: stats?.completed_today ?? 0,\n      icon: CheckCircle2,\n      color: \"bg-primary-50 dark:bg-primary-950 text-primary-600 dark:text-primary-400 border-primary-100 dark:border-primary-800\",\n      bgIcon: \"text-primary-100\",\n    },\n    {\n      label: t(\"monitor.failed_today\"),\n      value: stats?.failed_today ?? 0,\n      icon: XCircle,\n      color: \"bg-rose-50 dark:bg-rose-950 text-rose-600 dark:text-rose-300 border-rose-100 dark:border-rose-800\",\n      bgIcon: \"text-rose-100\",\n    },\n    {\n      label: t(\"monitor.total_workers\"),\n      value: stats?.total_workers ?? 0,\n      icon: Server,\n      color: \"bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-300 border-emerald-100 dark:border-emerald-800\",\n      bgIcon: \"text-emerald-100 dark:text-emerald-800\",\n    },\n  ];\n\n  return (\n    <div className=\"space-y-10 animate-in fade-in duration-700\">\n      {/* Header */}\n      <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-8 px-2\">\n        <div className=\"flex items-center gap-5\">\n          <div className=\"w-14 h-14 rounded-2xl bg-primary-50 dark:bg-primary-950 border border-primary-100 dark:border-primary-800 flex items-center justify-center\">\n            <Activity size={28} className=\"text-primary-600 dark:text-primary-400\" />\n          </div>\n          <div>\n            <h3 className=\"text-4xl font-bold tracking-tighter text-slate-700 dark:text-slate-200 uppercase leading-none\">\n              {t(\"monitor.title\")}\n            </h3>\n            <p className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em] mt-2 opacity-60\">\n              {t(\"monitor.subtitle\")}\n            </p>\n          </div>\n        </div>\n\n        <button\n          onClick={() => refetch()}\n          disabled={isFetching}\n          className=\"flex items-center gap-3 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 px-6 py-3 rounded-2xl hover:bg-slate-50 dark:hover:bg-slate-700 transition-all font-bold text-xs uppercase tracking-widest shadow-lg dark:shadow-black/20 active:scale-95 disabled:opacity-50\"\n        >\n          <RefreshCw size={16} className={cn(isFetching && \"animate-spin\")} />\n          {t(\"common.refresh\")}\n        </button>\n      </div>\n\n      {/* Error Banner */}\n      {error && (\n        <div className=\"flex items-center gap-3 px-5 py-4 rounded-2xl bg-rose-50 dark:bg-rose-950 border border-rose-200 dark:border-rose-800 text-rose-700 dark:text-rose-300 text-sm font-medium\">\n          <AlertTriangle size={18} className=\"shrink-0\" />\n          {t(\"monitor.error_loading\", { defaultValue: \"Failed to load monitoring data. Retrying...\" })}\n        </div>\n      )}\n\n      {/* Stats Cards */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-7 gap-6\">\n        {statCards.map((stat, i) => (\n          <div\n            key={i}\n            className=\"bg-white dark:bg-slate-900 p-6 rounded-[2rem] border border-slate-100 dark:border-slate-800 shadow-sm dark:shadow-black/10 hover:shadow-xl dark:hover:shadow-black/20 transition-all group relative overflow-hidden\"\n          >\n            <div\n              className={cn(\n                \"w-12 h-12 rounded-xl flex items-center justify-center mb-4 border\",\n                stat.color\n              )}\n            >\n              <stat.icon size={22} />\n            </div>\n            <p className=\"text-[9px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.2em] mb-1 opacity-70\">\n              {stat.label}\n            </p>\n            <p className=\"text-3xl font-bold text-slate-700 dark:text-slate-200 tracking-tighter\">\n              {isLoading ? \"...\" : stat.value}\n            </p>\n            <stat.icon\n              className={cn(\n                \"absolute -right-4 -bottom-4 w-24 h-24 opacity-10 -rotate-12 group-hover:rotate-0 transition-transform duration-500\",\n                stat.bgIcon\n              )}\n            />\n          </div>\n        ))}\n      </div>\n\n      {/* Scaling Decision Charts */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        <WorkerUtilizationGauge data={utilization} isLoading={isLoading} />\n        <QueuePressureChart data={queuePressure} isLoading={isLoading} />\n        <JobStatusDistributionChart data={jobDistribution} isLoading={isLoading} />\n      </div>\n\n      {/* Live Indicator */}\n      <div className=\"flex items-center gap-3 px-2\">\n        <div className=\"relative flex h-3 w-3\">\n          <span className=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75\"></span>\n          <span className=\"relative inline-flex rounded-full h-3 w-3 bg-emerald-50 dark:bg-emerald-950\"></span>\n        </div>\n        <span className=\"text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">\n          {t(\"monitor.live_updates\", { seconds: MONITOR_REFETCH_INTERVAL_S })}\n        </span>\n        {isFetching && (\n          <Loader2 size={14} className=\"text-slate-400 dark:text-slate-500 animate-spin\" />\n        )}\n      </div>\n\n      {/* Workers Table */}\n      <div className=\"bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-[2.5rem] overflow-hidden shadow-sm dark:shadow-black/10\">\n        <div className=\"p-6 border-b border-slate-100 dark:border-slate-800\">\n          <h4 className=\"text-lg font-bold text-slate-700 dark:text-slate-200 uppercase tracking-tight\">\n            {t(\"monitor.worker_list\")}\n          </h4>\n          <p className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.2em] mt-1 opacity-60\">\n            {t(\"monitor.worker_list_subtitle\")}\n          </p>\n        </div>\n\n        {workers.length === 0 ? (\n          <div className=\"p-12 text-center\">\n            <Server size={48} className=\"mx-auto text-slate-200 dark:text-slate-700 mb-4\" />\n            <p className=\"text-sm font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest\">\n              {t(\"monitor.no_workers\")}\n            </p>\n          </div>\n        ) : (\n          <div className=\"overflow-x-auto\">\n            <table className=\"w-full\">\n              <thead>\n                <tr className=\"bg-slate-50 dark:bg-slate-800/50\">\n                  <th className=\"text-left px-6 py-4 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">\n                    {t(\"monitor.worker_id\")}\n                  </th>\n                  <th className=\"text-left px-6 py-4 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">\n                    {t(\"monitor.host\")}\n                  </th>\n                  <th className=\"text-left px-6 py-4 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">\n                    {t(\"monitor.status\")}\n                  </th>\n                  <th className=\"text-left px-6 py-4 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">\n                    {t(\"monitor.current_task\")}\n                  </th>\n                  <th className=\"text-left px-6 py-4 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">\n                    {t(\"monitor.last_seen\")}\n                  </th>\n                </tr>\n              </thead>\n              <tbody>\n                {workers.map((worker) => (\n                  <tr\n                    key={worker.id}\n                    className=\"border-t border-slate-50 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors\"\n                  >\n                    <td className=\"px-6 py-4\">\n                      <code\n                        title={worker.id}\n                        className=\"text-xs font-mono text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-slate-700 px-2 py-1 rounded cursor-help\"\n                      >\n                        {worker.id.slice(0, 8)}...\n                      </code>\n                    </td>\n                    <td className=\"px-6 py-4\">\n                      <div className=\"flex items-center gap-2\">\n                        <Cpu size={14} className=\"text-slate-400 dark:text-slate-500\" />\n                        <span className=\"text-sm font-medium text-slate-700 dark:text-slate-200\">\n                          {worker.host}\n                        </span>\n                      </div>\n                    </td>\n                    <td className=\"px-6 py-4\">\n                      <span\n                        className={cn(\n                          \"inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider\",\n                          worker.status === \"PROCESSING\"\n                            ? \"bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-300\"\n                            : \"bg-slate-100 dark:bg-slate-700 text-slate-500 dark:text-slate-400\"\n                        )}\n                      >\n                        {worker.status === \"PROCESSING\" ? (\n                          <Zap size={12} />\n                        ) : (\n                          <Coffee size={12} />\n                        )}\n                        {worker.status}\n                      </span>\n                    </td>\n                    <td className=\"px-6 py-4\">\n                      {worker.current_task_type ? (\n                        <span className=\"text-sm font-medium text-slate-700 dark:text-slate-200\">\n                          {worker.current_task_type}\n                        </span>\n                      ) : (\n                        <span className=\"text-sm text-slate-400 dark:text-slate-500\">—</span>\n                      )}\n                    </td>\n                    <td className=\"px-6 py-4\">\n                      <span className=\"text-sm text-slate-500 dark:text-slate-400\">\n                        {formatDistanceToNow(new Date(worker.last_seen_at), {\n                          addSuffix: true,\n                        })}\n                      </span>\n                    </td>\n                  </tr>\n                ))}\n              </tbody>\n            </table>\n          </div>\n        )}\n      </div>\n\n      {/* Recent Jobs Table */}\n      <div className=\"bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-[2.5rem] overflow-hidden shadow-sm dark:shadow-black/10\">\n        <div className=\"p-6 border-b border-slate-100 dark:border-slate-800\">\n          <h4 className=\"text-lg font-bold text-slate-700 dark:text-slate-200 uppercase tracking-tight\">\n            {t(\"monitor.recent_jobs\", { defaultValue: \"Recent Jobs\" })}\n          </h4>\n          <p className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.2em] mt-1 opacity-60\">\n            {t(\"monitor.recent_jobs_subtitle\", { defaultValue: \"Job metadata from last 24 hours\" })}\n          </p>\n        </div>\n\n        {recentJobs.length === 0 ? (\n          <div className=\"p-12 text-center\">\n            <Briefcase size={48} className=\"mx-auto text-slate-200 dark:text-slate-700 mb-4\" />\n            <p className=\"text-sm font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest\">\n              {t(\"monitor.no_jobs\", { defaultValue: \"No recent jobs\" })}\n            </p>\n          </div>\n        ) : (\n          <div className=\"overflow-x-auto\">\n            <table className=\"w-full\">\n              <thead>\n                <tr className=\"bg-slate-50 dark:bg-slate-800/50\">\n                  <th className=\"text-left px-6 py-4 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">\n                    {t(\"monitor.job_id\", { defaultValue: \"Job ID\" })}\n                  </th>\n                  <th className=\"text-left px-6 py-4 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">\n                    {t(\"monitor.status\")}\n                  </th>\n                  <th className=\"text-left px-6 py-4 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">\n                    {t(\"monitor.job_type\", { defaultValue: \"Type\" })}\n                  </th>\n                  <th className=\"text-left px-6 py-4 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">\n                    {t(\"monitor.batches\", { defaultValue: \"Batches\" })}\n                  </th>\n                  <th className=\"text-left px-6 py-4 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">\n                    {t(\"monitor.created_at\", { defaultValue: \"Created\" })}\n                  </th>\n                  <th className=\"text-left px-6 py-4 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">\n                    {t(\"monitor.error\", { defaultValue: \"Error\" })}\n                  </th>\n                </tr>\n              </thead>\n              <tbody>\n                {recentJobs.map((job) => (\n                  <tr\n                    key={job.job_id}\n                    className=\"border-t border-slate-50 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors\"\n                  >\n                    <td className=\"px-6 py-4\">\n                      <code\n                        title={job.job_id}\n                        className=\"text-xs font-mono text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-slate-700 px-2 py-1 rounded cursor-help\"\n                      >\n                        {job.job_id.slice(0, 8)}...\n                      </code>\n                    </td>\n                    <td className=\"px-6 py-4\">\n                      <span\n                        className={cn(\n                          \"inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider\",\n                          job.status === \"completed\"\n                            ? \"bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-300\"\n                            : job.status === \"failed\"\n                              ? \"bg-rose-50 dark:bg-rose-950 text-rose-600 dark:text-rose-300\"\n                              : job.status === \"processing\"\n                                ? \"bg-amber-50 dark:bg-amber-950 text-amber-600 dark:text-amber-300\"\n                                : \"bg-slate-100 dark:bg-slate-700 text-slate-500 dark:text-slate-400\"\n                        )}\n                      >\n                        {job.status === \"completed\" ? (\n                          <CheckCircle2 size={12} />\n                        ) : job.status === \"failed\" ? (\n                          <XCircle size={12} />\n                        ) : job.status === \"processing\" ? (\n                          <Loader2 size={12} className=\"animate-spin\" />\n                        ) : (\n                          <Clock size={12} />\n                        )}\n                        {job.status}\n                      </span>\n                    </td>\n                    <td className=\"px-6 py-4\">\n                      <span className=\"text-sm font-medium text-slate-700 dark:text-slate-200\">\n                        {job.report_type}\n                      </span>\n                    </td>\n                    <td className=\"px-6 py-4\">\n                      <span className=\"text-sm text-slate-700 dark:text-slate-200\">\n                        {job.completed_batches}/{job.total_batches}\n                        {job.failed_batches > 0 && (\n                          <span className=\"text-rose-500 ml-1\">\n                            ({job.failed_batches} failed)\n                          </span>\n                        )}\n                      </span>\n                    </td>\n                    <td className=\"px-6 py-4\">\n                      <span className=\"text-sm text-slate-500 dark:text-slate-400\">\n                        {formatDistanceToNow(new Date(job.created_at), {\n                          addSuffix: true,\n                        })}\n                      </span>\n                    </td>\n                    <td className=\"px-6 py-4 max-w-[200px]\">\n                      {job.error_message ? (\n                        <span\n                          title={job.error_message}\n                          className=\"text-xs text-rose-500 dark:text-rose-400 truncate block cursor-help\"\n                        >\n                          {job.error_message}\n                        </span>\n                      ) : (\n                        <span className=\"text-sm text-slate-400 dark:text-slate-500\">—</span>\n                      )}\n                    </td>\n                  </tr>\n                ))}\n              </tbody>\n            </table>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/WorkingPatternsPage.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Link' is defined but never used. Allowed unused vars must match /^_/u.","line":4,"column":10,"nodeType":"Identifier","messageId":"unusedVar","endLine":4,"endColumn":14,"suggestions":[{"messageId":"removeUnusedImportDeclaration","data":{"varName":"Link"},"fix":{"range":[121,168],"text":""},"desc":"Remove unused import declaration."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'ArrowLeft' is defined but never used. Allowed unused vars must match /^_/u.","line":11,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":11,"endColumn":12,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"ArrowLeft"},"fix":{"range":[267,280],"text":""},"desc":"Remove unused variable \"ArrowLeft\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Settings2' is defined but never used. Allowed unused vars must match /^_/u.","line":15,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":15,"endColumn":12,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Settings2"},"fix":{"range":[306,319],"text":""},"desc":"Remove unused variable \"Settings2\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Search' is defined but never used. Allowed unused vars must match /^_/u.","line":18,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":18,"endColumn":9,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Search"},"fix":{"range":[347,357],"text":""},"desc":"Remove unused variable \"Search\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'fetchEmployees' is defined but never used. Allowed unused vars must match /^_/u.","line":38,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":38,"endColumn":17,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"fetchEmployees"},"fix":{"range":[967,985],"text":""},"desc":"Remove unused variable \"fetchEmployees\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Shift' is defined but never used. Allowed unused vars must match /^_/u.","line":43,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":43,"endColumn":8,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Shift"},"fix":{"range":[1073,1082],"text":""},"desc":"Remove unused variable \"Shift\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Employee' is defined but never used. Allowed unused vars must match /^_/u.","line":44,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":44,"endColumn":11,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Employee"},"fix":{"range":[1082,1094],"text":""},"desc":"Remove unused variable \"Employee\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'formatTime' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":52,"column":11,"nodeType":"Identifier","messageId":"unusedVar","endLine":52,"endColumn":21},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":90,"column":24,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":90,"endColumn":27,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[2802,2805],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[2802,2805],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":102,"column":24,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":102,"endColumn":27,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[3231,3234],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[3231,3234],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":10,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from \"react\";\n\nimport { useQuery, useMutation, useQueryClient } from \"@tanstack/react-query\";\nimport { Link } from \"@tanstack/react-router\";\nimport { format, startOfToday } from \"date-fns\";\nimport {\n  Plus,\n  Trash2,\n  CalendarDays,\n  Clock,\n  ArrowLeft,\n  Info,\n  Check,\n  Users,\n  Settings2,\n  ChevronDown,\n  ChevronUp,\n  Search,\n  X\n} from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { EmployeeSearch } from \"@/components/common/EmployeeSearch\";\nimport Button from \"@/components/ui/Button\";\nimport FormField, { LABEL_BASE, INPUT_BASE } from \"@/components/ui/FormField\";\nimport Modal from \"@/components/ui/Modal\";\nimport StatusBadge from \"@/components/ui/StatusBadge\";\n\nimport { useDateTimeFormatter } from \"@/hooks/use-datetime\";\nimport { cn } from \"@/lib/utils\";\n\nimport { useToast } from \"../components/ui/Toast\";\nimport {\n  fetchWorkingPatterns,\n  createWorkingPattern,\n  fetchPatternDetails,\n  fetchShifts,\n  fetchEmployees,\n  bulkAssignPattern,\n  deleteWorkingPattern,\n  getCurrentWorkspaceId,\n  WorkingPattern,\n  Shift,\n  Employee\n} from \"../lib/api\";\n\nexport default function WorkingPatternsPage() {\n  const { t } = useTranslation();\n  const wsId = getCurrentWorkspaceId() || \"\";\n  const queryClient = useQueryClient();\n  const toast = useToast();\n  const { formatTime } = useDateTimeFormatter();\n\n  const [isCreateModalOpen, setIsCreateModalOpen] = useState(false);\n  const [isBulkModalOpen, setIsBulkModalOpen] = useState(false);\n\n  const [newPatternName, setNewPatternName] = useState(\"\");\n  const [newPatternDesc, setNewPatternDesc] = useState(\"\");\n\n  // Bulk Assign State\n  const [selectedPatternId, setSelectedPatternId] = useState<string>(\"\");\n  const [selectedEmployeeIds, setSelectedEmployeeIds] = useState<string[]>([]);\n  const [assignStartDate, setAssignStartDate] = useState(format(startOfToday(), \"yyyy-MM-01\"));\n\n  // Weekly grid state: 0=Sun, 1=Mon, ..., 6=Sat. Value = array of shift_ids (supports split shifts)\n  const [weeklyGrid, setWeeklyGrid] = useState<string[][]>(Array.from({ length: 7 }, () => []));\n\n  const { data: patterns, isLoading } = useQuery({\n    queryKey: [\"working-patterns\", wsId],\n    queryFn: () => fetchWorkingPatterns(wsId),\n    enabled: !!wsId,\n  });\n\n  const { data: shifts } = useQuery({\n    queryKey: [\"shifts\", wsId],\n    queryFn: () => fetchShifts(wsId),\n    enabled: !!wsId,\n  });\n\n  // Fetch details for expanded view\n  const [expandedPatternId, setExpandedPatternId] = useState<string | null>(null);\n\n  const { data: patternDetails } = useQuery({\n    queryKey: [\"pattern-details\", wsId, expandedPatternId],\n    queryFn: () => fetchPatternDetails(wsId, expandedPatternId!),\n    enabled: !!wsId && !!expandedPatternId,\n  });\n\n  const createMutation = useMutation({\n    mutationFn: (data: any) => createWorkingPattern(wsId, data),\n    onSuccess: () => {\n      toast.success(t(\"patterns.messages.create_success\"));\n      setIsCreateModalOpen(false);\n      setNewPatternName(\"\");\n      setNewPatternDesc(\"\");\n      setWeeklyGrid(Array.from({ length: 7 }, () => []));\n      queryClient.invalidateQueries({ queryKey: [\"working-patterns\"] });\n    },\n  });\n\n  const bulkAssignMutation = useMutation({\n    mutationFn: (data: any) => bulkAssignPattern(wsId, data),\n    onSuccess: (data) => {\n      if (data.success_count > 0) {\n        toast.success(t(\"patterns.messages.bulk_assign_success_count\", { count: data.success_count }));\n        setIsBulkModalOpen(false);\n        setSelectedEmployeeIds([]);\n        queryClient.invalidateQueries({ queryKey: [\"schedules\"] });\n      } else if (data.failed_employees.length > 0) {\n        toast.error(t(\"patterns.messages.bulk_assign_conflict\", { count: data.failed_employees.length }));\n      }\n    },\n  });\n\n  const deleteMutation = useMutation({\n    mutationFn: (patternId: string) => deleteWorkingPattern(wsId, patternId),\n    onSuccess: () => {\n      toast.success(t(\"patterns.messages.delete_success\"));\n      queryClient.invalidateQueries({ queryKey: [\"working-patterns\"] });\n    },\n  });\n\n  const handleDelete = (pattern: WorkingPattern) => {\n    if (confirm(t(\"patterns.confirm_delete\", { name: pattern.name }))) {\n      deleteMutation.mutate(pattern.id);\n    }\n  };\n\n  const addShiftToDay = (dayIdx: number, shiftId: string) => {\n    setWeeklyGrid(prev => {\n      const newGrid = prev.map(arr => [...arr]);\n      if (!newGrid[dayIdx].includes(shiftId)) {\n        newGrid[dayIdx] = [...newGrid[dayIdx], shiftId];\n      }\n      return newGrid;\n    });\n  };\n\n  const removeShiftFromDay = (dayIdx: number, shiftId: string) => {\n    setWeeklyGrid(prev => {\n      const newGrid = prev.map(arr => [...arr]);\n      newGrid[dayIdx] = newGrid[dayIdx].filter(id => id !== shiftId);\n      return newGrid;\n    });\n  };\n\n  const handleCreate = () => {\n    if (!newPatternName) {\n      toast.warning(t(\"patterns.validation_name_required\"));\n      return;\n    }\n    const details = weeklyGrid.flatMap((shiftIds, idx) =>\n      shiftIds.length > 0\n        ? shiftIds.map(sid => ({ day_of_week: idx, shift_id: sid as string | null }))\n        : [{ day_of_week: idx, shift_id: null as string | null }]\n    );\n    createMutation.mutate({\n      name: newPatternName,\n      description: newPatternDesc,\n      details,\n    });\n  };\n\n  const handleBulkAssign = () => {\n    if (!selectedPatternId || selectedEmployeeIds.length === 0) return;\n    bulkAssignMutation.mutate({\n      employee_ids: selectedEmployeeIds,\n      pattern_id: selectedPatternId,\n      start_date: assignStartDate,\n    });\n  };\n\n  const daysOfWeekShort = [\n    t(\"days.sunday_short\"), t(\"days.monday_short\"), t(\"days.tuesday_short\"),\n    t(\"days.wednesday_short\"), t(\"days.thursday_short\"), t(\"days.friday_short\"), t(\"days.saturday_short\")\n  ];\n\n  const daysOfWeekFull = [\n    t(\"days.sunday\"), t(\"days.monday\"), t(\"days.tuesday\"),\n    t(\"days.wednesday\"), t(\"days.thursday\"), t(\"days.friday\"), t(\"days.saturday\")\n  ];\n\n  const prefillStandard = () => {\n    if (!shifts || shifts.length === 0) return;\n    const defaultShift = shifts[0].id;\n    const newGrid = weeklyGrid.map(arr => [...arr]);\n    for (let i = 1; i <= 5; i++) newGrid[i] = [defaultShift];\n    setWeeklyGrid(newGrid);\n  };\n\n  if (!wsId) return <div className=\"p-12 text-center text-slate-500 dark:text-slate-400 font-bold italic uppercase tracking-widest text-xs opacity-50\">{t(\"common.select_workspace\")}</div>;\n\n  return (\n    <div className=\"space-y-10 animate-in fade-in duration-700 pb-20\">\n      <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-8 px-2\">\n        <div className=\"flex items-center gap-4\">\n          <div className=\"w-12 h-12 rounded-[1.25rem] bg-primary-50 dark:bg-primary-950 flex items-center justify-center text-primary-600 dark:text-primary-400 shadow-sm border border-primary-100 dark:border-primary-800/50\"><CalendarDays size={24} /></div>\n          <div>\n            <h3 data-testid=\"patterns-title\" className=\"text-2xl font-bold tracking-tight text-slate-700 dark:text-slate-200 uppercase leading-none\">{t(\"patterns.title\")}</h3>\n            <p className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest mt-1.5 opacity-70\">{t(\"patterns.subtitle\")}</p>\n          </div>\n        </div>\n        <div className=\"flex items-center gap-4\">\n          <Button variant=\"outline\" onClick={() => setIsBulkModalOpen(true)} icon={<Users size={18} />}>{t(\"patterns.bulk_assign_btn\").toUpperCase()}</Button>\n          <Button onClick={() => { setIsCreateModalOpen(true); setWeeklyGrid(Array.from({ length: 7 }, () => [])); }} icon={<Plus size={18} />}>{t(\"patterns.create_btn\").toUpperCase()}</Button>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8\">\n        {isLoading ? (\n          Array.from({ length: 3 }).map((_, i) => (\n            <div key={i} className=\"bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 p-10 rounded-[2.5rem] shadow-sm animate-pulse h-80\" />\n          ))\n        ) : patterns?.length === 0 ? (\n          <div className=\"col-span-full py-32 text-center border-2 border-dashed border-slate-100 dark:border-slate-800 rounded-[3rem] bg-slate-50 dark:bg-slate-800/30 flex flex-col items-center animate-in zoom-in-95 duration-500\">\n            <div className=\"w-24 h-24 bg-white dark:bg-slate-900 rounded-full flex items-center justify-center shadow-sm mb-6 border border-slate-100 dark:border-slate-800\"><CalendarDays size={40} className=\"text-slate-200 dark:text-slate-700\" /></div>\n            <h3 className=\"text-xl font-bold text-slate-700 dark:text-slate-200 uppercase tracking-tight\">{t(\"patterns.empty_title\")}</h3>\n            <p className=\"text-slate-500 dark:text-slate-400 text-sm font-bold uppercase tracking-widest mt-1 opacity-50 italic\">{t(\"patterns.empty_desc\")}</p>\n          </div>\n        ) : patterns?.map(pattern => (\n          <div key={pattern.id} className=\"bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-[2.5rem] p-10 shadow-sm hover:shadow-2xl hover:shadow-primary-100/10 hover:scale-[1.02] transition-all group relative overflow-hidden flex flex-col\">\n            <div className=\"absolute top-0 right-0 p-8 flex gap-3 translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500\">\n              <button onClick={() => handleDelete(pattern)} className=\"p-3 bg-white dark:bg-slate-900 text-slate-500 dark:text-slate-400 hover:text-rose-600 dark:text-rose-300 rounded-xl shadow-md border border-slate-100 dark:border-slate-800 transition-all active:scale-90\" title={t(\"common.delete\")}><Trash2 size={18} /></button>\n            </div>\n\n            <div className=\"flex items-center gap-5 mb-8\">\n              <div className=\"w-16 h-16 bg-primary-50 dark:bg-primary-950 text-primary-600 dark:text-primary-400 rounded-[1.5rem] flex items-center justify-center shadow-inner border border-primary-100 dark:border-primary-800/50 group-hover:scale-110 group-hover:rotate-3 transition-all duration-500\"><CalendarDays size={32} /></div>\n              <div>\n                <h3 className=\"font-bold text-2xl text-slate-700 dark:text-slate-200 leading-none uppercase tracking-tight mb-2\">{pattern.name}</h3>\n                <StatusBadge variant={pattern.is_active ? \"success\" : \"neutral\"}>{pattern.is_active ? t(\"status_active_caps\") : t(\"status_off\")}</StatusBadge>\n              </div>\n            </div>\n\n            <p className=\"text-slate-500 dark:text-slate-400 text-xs mb-10 line-clamp-2 min-h-[3rem] font-bold uppercase tracking-tight opacity-60 leading-relaxed italic\">{pattern.description || t(\"common.no_description\")}</p>\n\n            <button\n              onClick={() => setExpandedPatternId(expandedPatternId === pattern.id ? null : pattern.id)}\n              className=\"mt-auto flex items-center justify-between w-full p-5 bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl hover:bg-white dark:hover:bg-slate-900 hover:border-primary-100 dark:border-primary-800 transition-all group/btn\"\n            >\n              <span className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 group-hover/btn:text-primary-600 dark:text-primary-400 uppercase tracking-widest transition-colors\">{t(\"patterns.view_details\").toUpperCase()}</span>\n              {expandedPatternId === pattern.id ? <ChevronUp size={16} className=\"text-slate-300 dark:text-slate-600\" /> : <ChevronDown size={16} className=\"text-slate-300 dark:text-slate-600\" />}\n            </button>\n\n            {expandedPatternId === pattern.id && (\n              <div className=\"mt-6 pt-6 border-t border-slate-100 dark:border-slate-800 animate-in slide-in-from-top-4 duration-500\">\n                <div className=\"flex flex-col gap-2\">\n                  {daysOfWeekShort.map((day, idx) => {\n                    const dayDetails = patternDetails?.filter(d => d.day_of_week === idx) || [];\n                    const hasShifts = dayDetails.some(d => d.shift_id);\n                    return (\n                      <div key={idx} className={cn(\n                        \"flex items-center gap-3 px-4 py-2 rounded-xl border transition-all\",\n                        hasShifts\n                          ? \"bg-w