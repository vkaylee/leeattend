s();\n  const { confirm, ConfirmationDialog } = useConfirm();\n\n  const [newRoleId, setNewRoleId] = useState(\"\");\n  const [expiresAt, setExpiresAt] = useState(\"\");\n\n  const primaryRoleId = memberRoles?.primary || \"\";\n  const extraRoles = memberRoles?.extra || [];\n\n  const getRoleName = (roleId: string) => {\n    return workspaceRoles.find(r => r.id === roleId)?.name || roleId;\n  };\n\n  const roleOptions = workspaceRoles.map(r => ({\n    value: r.id,\n    label: r.name.toUpperCase(),\n    description: r.description || undefined,\n    icon: <Shield className={`w-4 h-4 ${r.is_system ? 'text-primary-600 dark:text-primary-400' : 'text-slate-500 dark:text-slate-400'}`} />,\n  }));\n\n  const availableExtraRoleOptions = roleOptions.filter(opt =>\n    opt.value !== primaryRoleId && !extraRoles.some(er => er.role_id === opt.value)\n  );\n\n  async function handleUpdatePrimary(roleId: string) {\n    if (roleId === primaryRoleId) return;\n    const roleName = getRoleName(roleId);\n    const ok = await confirm({\n      title: t(\"common.warning\", { defaultValue: \"Warning\" }),\n      message: t(\"members.roles.confirm_change_primary\", { role: roleName.toUpperCase() }),\n      variant: \"danger\"\n    });\n    if (!ok) return;\n    try { await updatePrimaryRole(roleId); } catch (e: any) { console.error(e); }\n  }\n\n  async function handleAssign(e: React.FormEvent) {\n    e.preventDefault(); if (!expiresAt || !userId || !newRoleId) return;\n    try {\n      const isoExpiresAt = new Date(expiresAt).toISOString();\n      await assignRole({ role: newRoleId, expiresAt: isoExpiresAt });\n      setExpiresAt(\"\");\n      setNewRoleId(\"\");\n    } catch (e) { console.error(e); }\n  }\n\n  async function handleRevoke(roleId: string) {\n    const ok = await confirm({\n      title: t(\"common.warning\", { defaultValue: \"Warning\" }),\n      message: t(\"members.roles.confirm_revoke\"),\n      variant: \"danger\"\n    });\n    if (!ok) return;\n    try { await revokeRole(roleId); } catch (e) { console.error(e); }\n  }\n\n  if (!isOpen) return null;\n\n  return (\n    <Modal\n      isOpen={isOpen}\n      onClose={onClose}\n      title={t(\"members.roles.modal_title\")}\n      subtitle={t(\"members.roles.modal_subtitle\")}\n      icon={<UserCheck size={24} />}\n      maxWidth=\"lg\"\n    >\n      <div className=\"space-y-10\">\n          {isLoading ? (\n            <div className=\"py-20 text-center text-slate-500 dark:text-slate-400 font-bold italic uppercase tracking-widest text-xs opacity-50 animate-pulse\">{t(\"common.loading\")}</div>\n          ) : (\n            <div className=\"space-y-10 animate-in fade-in duration-700\">\n              <div className=\"space-y-4 px-1\">\n                <label htmlFor=\"primary-role-select\" className=\"text-[10px] font-bold uppercase tracking-[0.25em] text-slate-500 dark:text-slate-400 ml-1\">\n                  {t(\"members.roles.primary_role_label\").toUpperCase()}\n                </label>\n                <Combobox\n                  id=\"primary-role-select\"\n                  options={roleOptions}\n                  value={primaryRoleId}\n                  onChange={handleUpdatePrimary}\n                  className=\"bg-slate-50 dark:bg-slate-800 border-slate-100 dark:border-slate-800 h-16 rounded-[1.5rem] text-sm shadow-inner\"\n                />\n              </div>\n\n              <div className=\"space-y-5 px-1\">\n                <label className=\"text-[10px] font-bold uppercase tracking-[0.25em] text-slate-500 dark:text-slate-400 ml-1\">\n                  {t(\"members.roles.extra_roles_label\").toUpperCase()}\n                </label>\n\n                <div className=\"space-y-4\">\n                  {extraRoles.map((extraRole) => (\n                    <div key={extraRole.id} className=\"flex items-center justify-between p-6 bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-[2rem] hover:bg-white dark:hover:bg-slate-900 hover:shadow-xl hover:shadow-primary-100/10 transition-all group relative overflow-hidden shadow-inner\">\n                      <div className=\"space-y-2\">\n                        <p className=\"font-bold text-slate-700 dark:text-slate-200 text-base uppercase tracking-tight leading-none\">{getRoleName(extraRole.role_id)}</p>\n                        <div className=\"flex items-center gap-2 text-[10px] text-slate-500 dark:text-slate-400 font-bold uppercase tracking-widest opacity-70\">\n                          <Clock size={12} className=\"text-primary-400\" /> <span>{t(\"members.roles.expires_at\").toUpperCase()}: {formatDateTime(extraRole.expires_at)}</span>\n                        </div>\n                      </div>\n                      <button onClick={() => handleRevoke(extraRole.id)} className=\"p-3 bg-white dark:bg-slate-900 text-slate-300 dark:text-slate-600 hover:text-rose-600 dark:text-rose-300 rounded-xl shadow-md border border-slate-100 dark:border-slate-800 transition-all opacity-0 group-hover:opacity-100 translate-x-2 group-hover:translate-x-0 active:scale-90\"><Trash2 size={18} /></button>\n                    </div>\n                  ))}\n\n                  {extraRoles.length === 0 && (\n                    <div className=\"text-center py-12 border-2 border-dashed border-slate-100 dark:border-slate-800 rounded-[2.5rem] bg-slate-50 dark:bg-slate-800/30 flex flex-col items-center\">\n                      <Shield size={32} className=\"text-slate-200 dark:text-slate-700 mb-4\" />\n                      <p className=\"text-[10px] font-bold text-slate-300 dark:text-slate-600 uppercase tracking-widest opacity-60 italic\">{t(\"members.roles.no_extra_roles\")}</p>\n                    </div>\n                  )}\n                </div>\n              </div>\n            </div>\n          )}\n\n          <div className=\"pt-10 border-t border-slate-50 dark:border-slate-800 space-y-8\">\n            <h3 className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.3em] flex items-center gap-3 px-1\">\n              <Plus size={16} className=\"text-primary-500\" /> {t(\"members.roles.assign_new_title\").toUpperCase()}\n            </h3>\n            <form onSubmit={handleAssign} className=\"grid grid-cols-1 md:grid-cols-2 gap-8 animate-in slide-in-from-bottom-4 duration-700\">\n              <div className=\"space-y-3 px-1\">\n                <label htmlFor=\"extra-role-select\" className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">{t(\"members.invite.role_label\")}</label>\n                <Combobox\n                  id=\"extra-role-select\"\n                  options={availableExtraRoleOptions}\n                  value={newRoleId}\n                  onChange={setNewRoleId}\n                  className=\"bg-slate-50 dark:bg-slate-800 border-slate-100 dark:border-slate-800 h-14 rounded-2xl\"\n                />\n              </div>\n              <div className=\"space-y-3 px-1\">\n                <label htmlFor=\"expires-at-input\" className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">{t(\"members.roles.expiry_date_label\")}</label>\n                <input id=\"expires-at-input\" required type=\"datetime-local\" className=\"w-full bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl px-6 py-4 focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-bold text-sm tracking-tight shadow-sm\" value={expiresAt} onChange={(e) => setExpiresAt(e.target.value)} />\n              </div>\n              <div className=\"md:col-span-2 pt-2\">\n                <button type=\"submit\" disabled={!newRoleId} className=\"w-full bg-slate-900 text-white py-5 rounded-2xl font-bold text-xs uppercase tracking-[0.2em] hover:bg-primary-700 transition-all shadow-2xl shadow-slate-400 dark:shadow-black/40 active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed\">{t(\"members.roles.assign_btn\").toUpperCase()}</button>\n              </div>\n            </form>\n          </div>\n      </div>\n      <ConfirmationDialog />\n    </Modal>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/workspaces/CreateWorkspaceDialog.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'e' is defined but never used.","line":33,"column":14,"nodeType":"Identifier","messageId":"unusedVar","endLine":33,"endColumn":15},{"ruleId":"jsx-a11y/no-autofocus","severity":2,"message":"The autoFocus prop should not be used, as it can reduce usability and accessibility for users.","line":58,"column":18,"nodeType":"JSXAttribute","endLine":58,"endColumn":27}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from \"react\";\n\nimport { Plus, LayoutDashboard, Loader2 } from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport Modal from \"@/components/ui/Modal\";\n\nimport { useWorkspaces } from \"@/hooks/use-workspace\";\n\n\ninterface CreateWorkspaceDialogProps {\n  isOpen: boolean;\n  onClose: () => void;\n}\n\nexport default function CreateWorkspaceDialog({\n  isOpen,\n  onClose,\n}: CreateWorkspaceDialogProps) {\n  const { t } = useTranslation();\n  const { createWorkspace } = useWorkspaces();\n  const [name, setName] = useState(\"\");\n  const [isSubmitting, setIsSubmitting] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n\n  async function handleSubmit(e: React.FormEvent) {\n    e.preventDefault();\n    if (!name.trim()) return;\n    setIsSubmitting(true); setError(null);\n    try {\n      await createWorkspace({ name });\n      setName(\"\"); onClose();\n    } catch (e) {\n      setError(t(\"common.create_workspace_error\"));\n    } finally { setIsSubmitting(false); }\n  }\n\n  return (\n    <Modal\n      isOpen={isOpen}\n      onClose={onClose}\n      title={t(\"common.create_workspace\")}\n      subtitle={t(\"common.leeattend_system\")}\n      icon={<LayoutDashboard size={24} />}\n      maxWidth=\"md\"\n    >\n      <form onSubmit={handleSubmit} className=\"space-y-8 pt-4\">\n        {error && (\n          <div className=\"p-4 text-[11px] font-bold uppercase tracking-widest text-rose-600 dark:text-rose-300 bg-rose-50 dark:bg-rose-950 border border-rose-100 dark:border-rose-800 rounded-2xl animate-in slide-in-from-top-2\">\n            {error}\n          </div>\n        )}\n\n        <div className=\"space-y-3\">\n          <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">\n            {t(\"common.org_name_label\")}\n          </label>\n          <input autoFocus type=\"text\" required className=\"w-full px-5 py-4 bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-bold text-sm tracking-tight\" placeholder={t(\"common.org_name_placeholder\")} value={name} onChange={(e) => setName(e.target.value)}\n            disabled={isSubmitting}\n          />\n        </div>\n\n        <div className=\"pt-2\">\n          <button\n            type=\"submit\"\n            disabled={isSubmitting || !name.trim()}\n            className=\"w-full flex items-center justify-center gap-3 bg-slate-900 text-white py-4 rounded-2xl font-bold text-xs uppercase tracking-widest hover:bg-primary-700 transition-all shadow-xl shadow-slate-200 dark:shadow-black/30 active:scale-95 disabled:opacity-50\"\n          >\n            {isSubmitting ? (\n              <Loader2 size={18} className=\"animate-spin\" />\n            ) : (\n              <Plus size={18} />\n            )}\n            {t(\"common.create_workspace\").toUpperCase()}\n          </button>\n        </div>\n      </form>\n    </Modal>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/layout/InfraLayout.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Activity' is defined but never used. Allowed unused vars must match /^_/u.","line":2,"column":10,"nodeType":"Identifier","messageId":"unusedVar","endLine":2,"endColumn":18,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Activity"},"fix":{"range":[64,73],"text":""},"desc":"Remove unused variable \"Activity\"."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Outlet, Link } from \"@tanstack/react-router\";\nimport { Activity, LogOut, ArrowLeft } from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { ROUTES } from \"@/lib/routes\";\n\n\n/**\n * Minimal layout for infrastructure pages that don't require workspace context.\n * Used for global monitoring, system admin, etc.\n */\nexport default function InfraLayout() {\n  const { t } = useTranslation();\n\n  const handleLogout = () => {\n    localStorage.clear();\n    window.location.href = ROUTES.LOGIN;\n  };\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 dark:bg-slate-800\">\n      {/* Top bar */}\n      <header className=\"h-16 bg-white dark:bg-slate-900 border-b border-slate-100 dark:border-slate-800 px-6 flex items-center justify-between\">\n        <div className=\"flex items-center gap-4\">\n          <Link\n            to={ROUTES.HOME}\n            className=\"flex items-center gap-2 text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 dark:text-slate-700 transition-colors\"\n          >\n            <ArrowLeft size={18} />\n            <span className=\"text-sm font-medium\">{t(\"common.back_to_workspace\")}</span>\n          </Link>\n        </div>\n\n        <div className=\"flex items-center gap-3\">\n          <div className=\"h-10 w-10 rounded-2xl bg-gradient-to-tr from-primary-600 to-indigo-500 shadow-lg shadow-primary-200 flex items-center justify-center text-white font-black text-xl tracking-tighter italic\">\n            L\n          </div>\n          <span className=\"text-xl font-black tracking-tighter text-slate-800 dark:text-slate-100 uppercase italic\">\n            Lee<span className=\"text-primary-600 dark:text-primary-400\">Attend</span>\n          </span>\n        </div>\n\n        <button\n          onClick={handleLogout}\n          className=\"flex items-center gap-2 text-slate-500 dark:text-slate-400 hover:text-rose-600 dark:text-rose-300 transition-colors\"\n        >\n          <LogOut size={18} />\n          <span className=\"text-sm font-medium\">{t(\"auth.logout\")}</span>\n        </button>\n      </header>\n\n      {/* Content */}\n      <main className=\"p-8\">\n        <Outlet />\n      </main>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/layout/MainLayout.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'X' is defined but never used. Allowed unused vars must match /^_/u.","line":4,"column":21,"nodeType":"Identifier","messageId":"unusedVar","endLine":4,"endColumn":22,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"X"},"fix":{"range":[133,136],"text":""},"desc":"Remove unused variable \"X\"."}]},{"ruleId":"jsx-a11y/click-events-have-key-events","severity":2,"message":"Visible, non-interactive elements with click handlers must have at least one keyboard listener.","line":104,"column":9,"nodeType":"JSXOpeningElement","endLine":107,"endColumn":11},{"ruleId":"jsx-a11y/no-static-element-interactions","severity":2,"message":"Avoid non-native interactive elements. If using native HTML is not possible, add an appropriate role and support for tabbing, mouse, keyboard, and touch inputs to an interactive content element.","line":104,"column":9,"nodeType":"JSXOpeningElement","endLine":107,"endColumn":11}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from \"react\";\n\nimport { Outlet, useLocation } from \"@tanstack/react-router\";\nimport { Building2, X } from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { useI18nSync } from \"@/hooks/use-i18n-sync\";\nimport { useTheme } from \"@/hooks/use-theme\";\nimport { useWorkspaces } from \"@/hooks/use-workspace\";\nimport { getCurrentWorkspaceId } from \"@/lib/api\";\nimport { ROUTES } from \"@/lib/routes\";\nimport { cn } from \"@/lib/utils\";\n\nimport Modal from \"../ui/Modal\";\n\nimport Navbar from \"./Navbar\";\nimport Sidebar from \"./Sidebar\";\nimport WorkspaceSwitcher from \"./WorkspaceSwitcher\";\n\n\n\n// Stable module-level arrays for sidebar section matching\nconst ORG_PATHS: string[] = [ROUTES.PEOPLE, ROUTES.EMPLOYEES, ROUTES.DEPARTMENTS];\nconst TIME_PATHS: string[] = [ROUTES.ATTENDANCE_LOGS, ROUTES.LEAVE_REQUESTS, ROUTES.ATTENDANCE_ADJUSTMENTS, ROUTES.REPORTS, ROUTES.LEAVE_BALANCES, ROUTES.SHIFT_SWAPS];\nconst PAYROLL_PATHS: string[] = [ROUTES.SHIFTS, ROUTES.PAYROLL];\n\nexport default function MainLayout() {\n  const { t } = useTranslation();\n  useTheme();\n  useI18nSync();\n  const location = useLocation();\n\n  const [isSidebarOpen, setIsSidebarOpen] = useState(false);\n  const [showSwitcher, setShowSwitcher] = useState(false);\n  const [isCollapsed, setIsCollapsed] = useState(() => {\n    const saved = localStorage.getItem(\"sidebar-collapsed\");\n    return saved === \"true\";\n  });\n\n  const getInitialOpenSections = () => {\n    const path = location.pathname;\n    return {\n      org: ORG_PATHS.includes(path),\n      time: TIME_PATHS.includes(path) || path === ROUTES.HOME,\n      payroll: PAYROLL_PATHS.includes(path),\n      system: path.startsWith(ROUTES.SETTINGS.ROOT),\n      ess: path.startsWith(\"/ess/\"),\n    };\n  };\n\n  const [openSections, setOpenSections] = useState<Record<string, boolean>>(getInitialOpenSections());\n\n  const { workspaces } = useWorkspaces();\n  const currentWsId = getCurrentWorkspaceId();\n  const currentWorkspace = workspaces.find(ws => ws.id === currentWsId);\n\n  const toggleSection = (section: string) => {\n    setOpenSections(prev => ({\n      org: false,\n      time: false,\n      payroll: false,\n      system: false,\n      ess: false,\n      [section]: !prev[section]\n    }));\n  };\n\n  const toggleCollapsed = () => {\n    setIsCollapsed(prev => {\n      const newValue = !prev;\n      localStorage.setItem(\"sidebar-collapsed\", String(newValue));\n      return newValue;\n    });\n  };\n\n  useEffect(() => {\n    const path = location.pathname;\n    const isOrg = ORG_PATHS.includes(path);\n    const isTime = TIME_PATHS.includes(path);\n    const isPayroll = PAYROLL_PATHS.includes(path);\n    const isSystem = path.startsWith(ROUTES.SETTINGS.ROOT);\n    const isEss = path.startsWith(\"/ess/\");\n\n    const timer = setTimeout(() => {\n      setOpenSections(prev => {\n        const next = { ...prev };\n        let changed = false;\n        if (isOrg && !prev.org) { next.org = true; changed = true; }\n        if (isTime && !prev.time) { next.time = true; changed = true; }\n        if (isPayroll && !prev.payroll) { next.payroll = true; changed = true; }\n        if (isSystem && !prev.system) { next.system = true; changed = true; }\n        if (isEss && !prev.ess) { next.ess = true; changed = true; }\n        return changed ? next : prev;\n      });\n      setIsSidebarOpen(false);\n    }, 0);\n\n    return () => clearTimeout(timer);\n  }, [location.pathname]);\n\n  return (\n    <div className=\"flex min-h-screen bg-background text-foreground font-sans relative overflow-x-hidden\">\n      {isSidebarOpen && (\n        <div\n          className=\"fixed inset-0 bg-slate-900/50 dark:bg-slate-950/60 backdrop-blur-sm z-40 lg:hidden transition-opacity duration-500\"\n          onClick={() => setIsSidebarOpen(false)}\n        />\n      )}\n\n      <Sidebar\n        isOpen={isSidebarOpen}\n        onClose={() => setIsSidebarOpen(false)}\n        openSections={openSections}\n        toggleSection={toggleSection}\n        onShowSwitcher={() => setShowSwitcher(true)}\n        isCollapsed={isCollapsed}\n      />\n\n      <div className={cn(\n        \"flex-1 flex flex-col min-w-0 h-screen overflow-hidden relative transition-all duration-300\",\n        isCollapsed ? \"lg:ml-20\" : \"lg:ml-72\"\n      )}>\n        <Navbar\n          currentWorkspaceName={currentWorkspace?.name || \"Workspace\"}\n          onOpenSidebar={() => setIsSidebarOpen(true)}\n          isCollapsed={isCollapsed}\n          onToggleCollapsed={toggleCollapsed}\n        />\n\n        <main className=\"flex-1 overflow-y-auto p-4 md:p-8 lg:p-10 relative scroll-smooth\">\n          <div key={location.pathname} className=\"max-w-7xl mx-auto animate-in fade-in slide-in-from-bottom-4 duration-500 fill-mode-both\">\n            <Outlet />\n          </div>\n        </main>\n      </div>\n\n      <Modal\n        isOpen={showSwitcher}\n        onClose={() => setShowSwitcher(false)}\n        title={t(\"common.switch_workspace\")}\n        subtitle={t(\"common.office_branch\")}\n        icon={<Building2 className=\"w-6 h-6\" />}\n        maxWidth=\"lg\"\n      >\n        <div className=\"space-y-8\">\n          <p className=\"text-sm text-slate-500 dark:text-slate-400 font-medium px-1\">{t(\"common.select_workspace_desc\")}</p>\n          <WorkspaceSwitcher />\n          <div className=\"pt-6 border-t border-slate-50 dark:border-slate-800 flex justify-end\">\n            <button\n              onClick={() => setShowSwitcher(false)}\n              className=\"px-8 py-3 bg-slate-100 dark:bg-slate-800 text-foreground/70 rounded-2xl font-bold text-xs uppercase tracking-widest hover:bg-slate-200 dark:hover:bg-slate-700 transition-all\"\n            >\n              {t(\"common.close\")}\n            </button>\n          </div>\n        </div>\n      </Modal>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/layout/Navbar.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/layout/Sidebar.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Cpu' is defined but never used. Allowed unused vars must match /^_/u.","line":6,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":6,"endColumn":6,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Cpu"},"fix":{"range":[114,121],"text":""},"desc":"Remove unused variable \"Cpu\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'UserCheck' is defined but never used. Allowed unused vars must match /^_/u.","line":9,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":9,"endColumn":12,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"UserCheck"},"fix":{"range":[144,157],"text":""},"desc":"Remove unused variable \"UserCheck\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'CalendarDays' is defined but never used. Allowed unused vars must match /^_/u.","line":14,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":14,"endColumn":15,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"CalendarDays"},"fix":{"range":[204,220],"text":""},"desc":"Remove unused variable \"CalendarDays\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Banknote' is defined but never used. Allowed unused vars must match /^_/u.","line":16,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":16,"endColumn":11,"suggestions":[{"messageId":"removeUnused