rom \"../../context/DebugContext\";\nimport { debugApi, ClearDbGroup } from \"../../lib/api/debug\";\nimport { getCurrentWorkspaceId } from \"../../lib/api/helpers\";\n\n\ntype DebugTab = \"identity\" | \"time\" | \"database\";\n\nexport const DebugToolbar: React.FC = () => {\n  const queryClient = useQueryClient();\n  const { isEnabled, impersonateId, mockDate, setIsEnabled, setImpersonateId, setMockDate, reset } = useDebug();\n  const [isOpen, setIsOpen] = useState(false);\n  const [activeTab, setActiveTab] = useState<DebugTab>(\"identity\");\n  const [tempId, setTempId] = useState(impersonateId || \"\");\n  const [tempDate, setTempDate] = useState(mockDate || \"\");\n  const [debugUsers, setDebugUsers] = useState<any[]>([]);\n  const [isWiping, setIsWiping] = useState(false);\n\n  React.useEffect(() => {\n    if (isOpen && isEnabled && activeTab === \"identity\") {\n      debugApi.getUsers()\n        .then(res => {\n          if (Array.isArray(res)) {\n            setDebugUsers(res);\n          } else {\n            console.warn(\"Debug users API did not return an array:\", res);\n            setDebugUsers([]);\n          }\n        })\n        .catch(err => {\n          console.error(\"Failed to fetch debug users:\", err);\n          setDebugUsers([]);\n        });\n    }\n  }, [isOpen, isEnabled, activeTab]);\n\n  // Only show in DEV\n  if (!import.meta.env.DEV) return null;\n\n  const currentWorkspaceId = getCurrentWorkspaceId();\n\n  const handleClearDb = async (group: ClearDbGroup) => {\n    if (!currentWorkspaceId) return alert(\"No workspace selected\");\n    \n    const actionVerb = group === \"seed\" ? \"seed demo\" : \"wipe\";\n    const warning = group === \"full_reset\" ? \" This will delete EVERYTHING.\" : group === \"employees\" ? \" This will delete all employees and their history.\" : \"\";\n    \n    if (!confirm(`Are you sure you want to ${actionVerb} ${group === \"seed\" ? \"data\" : group + \" data\"}?${warning}`)) return;\n    \n    setIsWiping(true);\n    try {\n      await debugApi.clearDb(currentWorkspaceId, group);\n      // Invalidate all queries to refresh the UI\n      queryClient.invalidateQueries();\n      alert(`${group === \"seed\" ? \"Demo data seeded\" : group + \" data wiped\"} successfully.`);\n    } catch (err) {\n      alert(\"Operation failed: \" + (err as Error).message);\n    } finally {\n      setIsWiping(false);\n    }\n  };\n\n  if (!isOpen) {\n    return (\n      <button\n        onClick={() => setIsOpen(true)}\n        className=\"fixed bottom-4 right-4 bg-slate-900 text-white p-3 rounded-full shadow-2xl z-[9999] hover:bg-slate-800 transition-colors border border-slate-700\"\n        title=\"Open Debug Tools\"\n      >\n        <Terminal size={20} className={isEnabled ? \"text-green-400\" : \"text-white\"} />\n      </button>\n    );\n  }\n\n  return (\n    <div className=\"fixed bottom-4 right-4 bg-slate-900 text-white rounded-xl shadow-2xl z-[9999] border border-slate-700 w-80 overflow-hidden animate-in slide-in-from-bottom-4 duration-200\">\n      <div className=\"flex items-center justify-between p-3 border-b border-slate-800 bg-slate-950\">\n        <div className=\"flex items-center gap-2\">\n          <Terminal size={16} className=\"text-blue-400\" />\n          <span className=\"text-xs font-bold tracking-wider uppercase\">Debug Suite v2.0</span>\n        </div>\n        <button onClick={() => setIsOpen(false)} className=\"hover:text-slate-500 dark:text-slate-400\">\n          <X size={16} />\n        </button>\n      </div>\n\n      {/* Mode Toggle */}\n      <div className=\"px-4 pt-4\">\n        <div className=\"flex items-center justify-between p-2 bg-slate-800/50 rounded-lg\">\n          <div className=\"flex items-center gap-2\">\n            <Power size={14} className={isEnabled ? \"text-green-400\" : \"text-slate-500 dark:text-slate-400\"} />\n            <span className=\"text-xs font-medium\">Global Debug Mode</span>\n          </div>\n          <button\n            onClick={() => setIsEnabled(!isEnabled)}\n            className={`w-10 h-5 rounded-full relative transition-colors ${\n              isEnabled ? \"bg-green-600\" : \"bg-slate-600\"\n            }`}\n          >\n            <div className={`absolute top-1 w-3 h-3 bg-white dark:bg-slate-900 rounded-full transition-all ${\n              isEnabled ? \"left-6\" : \"left-1\"\n            }`} />\n          </button>\n        </div>\n      </div>\n\n      {/* Tabs Header */}\n      <div className=\"flex border-b border-slate-800 mt-2\">\n        <button \n          onClick={() => setActiveTab(\"identity\")}\n          className={`flex-1 py-2 text-[10px] font-bold uppercase tracking-tight flex items-center justify-center gap-1.5 transition-colors ${\n            activeTab === \"identity\" ? \"bg-slate-800 text-blue-400 border-b-2 border-blue-400\" : \"text-slate-500 dark:text-slate-400 hover:text-slate-300 dark:text-slate-600\"\n          }`}\n        >\n          <User size={12} /> Identity\n        </button>\n        <button \n          onClick={() => setActiveTab(\"time\")}\n          className={`flex-1 py-2 text-[10px] font-bold uppercase tracking-tight flex items-center justify-center gap-1.5 transition-colors ${\n            activeTab === \"time\" ? \"bg-slate-800 text-teal-400 border-b-2 border-teal-400\" : \"text-slate-500 dark:text-slate-400 hover:text-slate-300 dark:text-slate-600\"\n          }`}\n        >\n          <Calendar size={12} /> Time\n        </button>\n        <button \n          onClick={() => setActiveTab(\"database\")}\n          className={`flex-1 py-2 text-[10px] font-bold uppercase tracking-tight flex items-center justify-center gap-1.5 transition-colors ${\n            activeTab === \"database\" ? \"bg-slate-800 text-red-400 border-b-2 border-red-400\" : \"text-slate-500 dark:text-slate-400 hover:text-slate-300 dark:text-slate-600\"\n          }`}\n        >\n          <Database size={12} /> Database\n        </button>\n      </div>\n\n      <div className={`p-4 min-h-[160px] ${!isEnabled ? \"opacity-40 pointer-events-none\" : \"\"}`}>\n        {activeTab === \"identity\" && (\n          <div className=\"space-y-3 animate-in fade-in duration-300\">\n            <div className=\"space-y-1.5\">\n              <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase flex items-center gap-1\">\n                Select User\n              </label>\n              <select \n                className=\"w-full bg-slate-800 border border-slate-700 rounded px-2 py-1.5 text-[11px] mb-2 focus:outline-none focus:border-blue-500\"\n                onChange={(e) => setTempId(e.target.value)}\n                value={tempId}\n              >\n                <option value=\"\">-- All Workspace Users --</option>\n                {Array.isArray(debugUsers) && debugUsers.map(u => (\n                  <option key={u.id} value={u.id}>{u.name} ({u.role})</option>\n                ))}\n              </select>\n              <div className=\"flex gap-2\">\n                <input\n                  type=\"text\"\n                  value={tempId}\n                  onChange={(e) => setTempId(e.target.value)}\n                  placeholder=\"Paste UUID...\"\n                  className=\"flex-1 bg-slate-800 border border-slate-700 rounded px-2 py-1.5 text-[11px] font-mono focus:outline-none focus:border-blue-500\"\n                />\n                <button\n                  onClick={() => setImpersonateId(tempId)}\n                  className=\"bg-blue-600 hover:bg-blue-50 dark:bg-blue-950 px-3 py-1.5 rounded text-[10px] font-bold\"\n                >\n                  Apply\n                </button>\n              </div>\n            </div>\n          </div>\n        )}\n\n        {activeTab === \"time\" && (\n          <div className=\"space-y-3 animate-in fade-in duration-300\">\n            <div className=\"space-y-1.5\">\n              <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase flex items-center gap-1\">\n                Travel to Date\n              </label>\n              <div className=\"flex gap-2\">\n                <input\n                  type=\"date\"\n                  value={tempDate}\n                  onChange={(e) => setTempDate(e.target.value)}\n                  className=\"flex-1 bg-slate-800 border border-slate-700 rounded px-2 py-1.5 text-[11px] focus:outline-none focus:border-teal-500 [color-scheme:dark]\"\n                />\n                <button\n                  onClick={() => setMockDate(tempDate)}\n                  className=\"bg-teal-600 hover:bg-teal-50 dark:bg-teal-950 px-3 py-1.5 rounded text-[10px] font-bold\"\n                >\n                  Apply\n                </button>\n              </div>\n              <p className=\"text-[9px] text-slate-500 dark:text-slate-400 italic mt-2\">\n                Note: Mock date affects payroll segments and policy resolution.\n              </p>\n            </div>\n          </div>\n        )}\n\n        {activeTab === \"database\" && (\n          <div className=\"space-y-3 animate-in fade-in duration-300\">\n             {/* Data Operations */}\n            <div className=\"grid grid-cols-3 gap-2\">\n              <button\n                onClick={() => handleClearDb(\"attendance\")}\n                disabled={isWiping}\n                className=\"flex flex-col items-center gap-1 bg-slate-800 hover:bg-slate-700 border border-slate-700 p-2 rounded transition-colors group\"\n                title=\"Clear attendance logs and time entries\"\n              >\n                <Trash2 size={12} className=\"text-slate-500 dark:text-slate-400 group-hover:text-amber-400\" />\n                <span className=\"text-[8px] font-bold uppercase\">Logs</span>\n              </button>\n              <button\n                onClick={() => handleClearDb(\"payroll\")}\n                disabled={isWiping}\n                className=\"flex flex-col items-center gap-1 bg-slate-800 hover:bg-slate-700 border border-slate-700 p-2 rounded transition-colors group\"\n                title=\"Clear payroll history\"\n              >\n                <Trash2 size={12} className=\"text-slate-500 dark:text-slate-400 group-hover:text-amber-400\" />\n                <span className=\"text-[8px] font-bold uppercase\">Payroll</span>\n              </button>\n              <button\n                onClick={() => handleClearDb(\"rosters\")}\n                disabled={isWiping}\n                className=\"flex flex-col items-center gap-1 bg-slate-800 hover:bg-slate-700 border border-slate-700 p-2 rounded transition-colors group\"\n                title=\"Clear schedules and rosters\"\n              >\n                <Trash2 size={12} className=\"text-slate-500 dark:text-slate-400 group-hover:text-amber-400\" />\n                <span className=\"text-[8px] font-bold uppercase\">Rosters</span>\n              </button>\n            </div>\n\n            {/* Destructive Zone */}\n            <div className=\"grid grid-cols-2 gap-2 pt-2 border-t border-slate-800\">\n                <button\n                onClick={() => handleClearDb(\"employees\")}\n                disabled={isWiping}\n                className=\"flex flex-col items-center gap-1 bg-red-900/10 hover:bg-red-900/30 border border-red-900/30 p-2 rounded transition-colors group\"\n                title=\"Delete all employees and their data (keeps settings)\"\n              >\n                <UserMinus size={14} className=\"text-red-400\" />\n                <span className=\"text-[9px] font-bold uppercase text-red-200\">Wipe Staff</span>\n              </button>\n              <button\n                onClick={() => handleClearDb(\"full_reset\")}\n                disabled={isWiping}\n                className=\"flex flex-col items-center gap-1 bg-red-900/20 hover:bg-red-900/40 border border-red-900/50 p-2 rounded transition-colors group\"\n                title=\"Delete EVERYTHING (Factory Reset)\"\n              >\n                <Trash2 size={14} className=\"text-red-400\" />\n                <span className=\"text-[9px] font-bold uppercase text-red-200\">Factory Reset</span>\n              </button>\n            </div>\n            \n            {/* Seeding */}\n            <div className=\"pt-2 border-t border-slate-800\">\n               <button\n                onClick={() => handleClearDb(\"seed\")}\n                disabled={isWiping}\n                className=\"w-full flex items-center justify-center gap-2 bg-green-900/20 hover:bg-green-900/40 border border-green-900/50 p-2 rounded text-[10px] font-bold text-green-200 transition-colors\"\n                title=\"Create default departments, shifts, and employees\"\n              >\n                <UserPlus size={14} /> Quick Seed Demo Team\n              </button>\n            </div>\n          </div>\n        )}\n      </div>\n\n      <div className=\"p-3 bg-slate-950 border-t border-slate-800 flex justify-between gap-2\">\n        <button\n          onClick={() => {\n            reset();\n            setTempId(\"\");\n            setTempDate(\"\");\n            window.location.reload();\n          }}\n          className=\"flex-1 flex items-center justify-center gap-1.5 bg-slate-800 hover:bg-slate-700 py-2 rounded text-[10px] font-bold text-slate-300 dark:text-slate-600\"\n        >\n          <RefreshCcw size={12} /> Clear Settings\n        </button>\n        {isEnabled && (\n          <button\n            onClick={() => window.location.reload()}\n            className=\"flex-1 flex items-center justify-center gap-1.5 bg-blue-600 hover:bg-blue-50 dark:bg-blue-950 py-2 rounded text-[10px] font-bold\"\n          >\n            Reload UI\n          </button>\n        )}\n      </div>\n    </div>\n  );\n};\n\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/employees/WorkingConditionConfig.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'ChevronRight' is defined but never used. Allowed unused vars must match /^_/u.","line":9,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":9,"endColumn":15,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"ChevronRight"},"fix":{"range":[199,216],"text":""},"desc":"Remove unused variable \"ChevronRight\"."}]},{"ruleId":"jsx-a11y/click-events-have-key-events","severity":2,"message":"Visible, non-interactive elements with click handlers must have at least one keyboard listener.","line":139,"column":11,"nodeType":"JSXOpeningElement","endLine":139,"endColumn":200},{"ruleId":"jsx-a11y/no-static-element-interactions","severity":2,"message":"Avoid non-native interactive elements. If using native HTML is not possible, add an appropriate role and support for tabbing, mouse, keyboard, and touch inputs to an interactive content element.","line":139,"column":11,"nodeType":"JSXOpeningElement","endLine":139,"endColumn":200}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from \"react\";\n\nimport { useQuery, useMutation, useQueryClient } from \"@tanstack/react-query\";\nimport { format } from \"date-fns\";\nimport { \n  Plus, \n  Trash2, \n  AlertCircle, \n  ChevronRight,\n  Clock,\n  CheckCircle2,\n  Calendar,\n  Baby,\n  ShieldAlert\n} from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { useToast } from \"@/components/ui/Toast\";\n\nimport { useConfirm } from \"@/hooks/use-confirm\";\nimport { useDateTimeFormatter } from \"@/hooks/use-datetime\";\nimport { \n  fetchWorkingConditions,\n  createWorkingCondition,\n  deleteWorkingCondition\n} from \"@/lib/api/employees\";\nimport { WorkingCondition } from \"@/lib/api/types\";\nimport { cn } from \"@/lib/utils\";\n\ninterface Props {\n  wsId: string;\n  employeeId: string;\n}\n\nexport default function WorkingConditionConfig({ wsId, employeeId }: Props) {\n  const { t } = useTranslation();\n  const queryClient = useQueryClient();\n  const toast = useToast();\n  const { formatDate } = useDateTimeFormatter();\n  const { confirm, ConfirmationDialog } = useConfirm();\n  \n  const [isAdding, setIsAdding] = useState(false);\n  const [type, setType] = useState(\"EARLY_LEAVE\");\n  const [minuteAllowance, setMinuteAllowance] = useState(60);\n  const [isPaid, setIsPaid] = useState(true);\n  const [startDate, setStartDate] = useState(format(new Date(), \"yyyy-MM-01\"));\n  const [endDate, setEndDate] = useState(\"\");\n\n  const { data: conditions = [], isLoading } = useQuery({ \n    queryKey: [\"working-conditions\", employeeId], \n    queryFn: () => fetchWorkingConditions(wsId, employeeId) \n  });\n\n  const createMutation = useMutation({\n    mutationFn: (data: Partial<WorkingCondition>) => createWorkingCondition(wsId, employeeId, data),\n    onSuccess: () => { \n      toast.success(t(\"common.success\")); \n      queryClient.invalidateQueries({ queryKey: [\"working-conditions\", employeeId] }); \n      setIsAdding(false); \n    },\n  });\n\n  const deleteMutation = useMutation({\n    mutationFn: (id: string) => deleteWorkingCondition(wsId, employeeId, id),\n    onSuccess: () => { \n      toast.success(t(\"common.success\")); \n      queryClient.invalidateQueries({ queryKey: [\"working-conditions\", employeeId] }); \n    },\n  });\n\n  const handleDelete = async (id: string) => {\n    const ok = await confirm({\n      title: t(\"common.warning\", { defaultValue: \"Warning\" }),\n      message: t(\"common.confirm_delete\"),\n      variant: \"danger\"\n    });\n    if (ok) {\n      deleteMutation.mutate(id);\n    }\n  };\n\n  const handleAdd = (e: React.FormEvent) => {\n    e.preventDefault();\n    createMutation.mutate({\n      type,\n      minute_allowance: minuteAllowance,\n      is_paid: isPaid,\n      start_date: startDate,\n      end_date: endDate || undefined,\n    });\n  };\n\n  const getIcon = (type: string) => {\n    switch (type) {\n      case \"EARLY_LEAVE\": return <Clock className=\"text-orange-500\" size={18} />;\n      case \"BREASTFEEDING\": return <Baby className=\"text-pink-500\" size={18} />;\n      default: return <AlertCircle className=\"text-primary-500\" size={18} />;\n    }\n  };\n\n  if (isLoading) return <div className=\"p-10 text-center animate-pulse font-bold text-slate-300 dark:text-slate-600 uppercase tracking-widest text-[10px]\">{t(\"common.loading\")}...</div>;\n\n  return (\n    <div className=\"flex flex-col gap-8 animate-in fade-in duration-500\">\n      <div className=\"flex items-center justify-between px-2\">\n        <div className=\"flex items-center gap-4\">\n          <div className=\"w-10 h-10 rounded-2xl bg-amber-50 dark:bg-amber-950 flex items-center justify-center text-amber-600 dark:text-amber-300 shadow-sm border border-amber-100 dark:border-amber-800/50\"><ShieldAlert size={20} /></div>\n          <div><h3 className=\"text-lg font-bold text-slate-800 dark:text-slate-100 tracking-tight\">{t(\"employees.details.special_policies\")}</h3><p className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest mt-0.5\">{t(\"employees.policies.subtitle\")}</p></div>\n        </div>\n        <button onClick={() => setIsAdding(!isAdding)} className={cn(\"flex items-center gap-2 px-6 py-2.5 rounded-2xl font-bold text-[10px] uppercase tracking-widest transition-all\", isAdding ? 'bg-slate-100 dark:bg-slate-700 text-slate-500 dark:text-slate-400 border border-slate-200 dark:border-slate-700' : 'bg-primary-600 text-white shadow-lg shadow-primary-100 active:scale-95')}>\n          {isAdding ? t(\"common.cancel\") : <><Plus size={14} /> {t(\"employees.policies.add_btn\")}</>}\n        </button>\n      </div>\n\n      {isAdding && (\n        <form onSubmit={handleAdd} className=\"bg-white dark:bg-slate-900 border-2 border-primary-100 dark:border-primary-800 p-10 rounded-[2.5rem] shadow-xl shadow-primary-50/50 animate-in slide-in-from-top-4 duration-500 space-y-8\">\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n            <div className=\"space-y-3\">\n              <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">{t(\"employees.policies.type\")}</label>\n              <select value={type} onChange={(e) => setType(e.target.value)} className=\"w-full px-6 py-4 bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl font-bold text-sm uppercase tracking-tight focus:ring-4 focus:ring-primary-500/10 outline-none transition-all\">\n                <option value=\"EARLY_LEAVE\">{t(\"employees.policies.types.early_leave\")}</option>\n                <option value=\"BREASTFEEDING\">{t(\"employees.policies.types.breastfeeding\")}</option>\n                <option value=\"LATE_IN\">{t(\"employees.policies.types.late_in\")}</option>\n              </select>\n            </div>\n            <div className=\"space-y-3\">\n              <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">{t(\"employees.policies.allowance_mins\")}</label>\n              <input type=\"number\" value={minuteAllowance} onChange={(e) => setMinuteAllowance(parseInt(e.target.value))} className=\"w-full px-6 py-4 bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl font-bold text-sm tracking-widest focus:ring-4 focus:ring-primary-500/10 outline-none transition-all\" />\n            </div>\n            <div className=\"space-y-3\">\n              <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">{t(\"employees.policies.start_date\")}</label>\n              <input type=\"date\" value={startDate} onChange={(e) => setStartDate(e.target.value)} className=\"w-full px-6 py-4 bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl font-bold text-sm focus:ring-4 focus:ring-primary-500/10 outline-none transition-all\" />\n            </div>\n            <div className=\"space-y-3\">\n              <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">{t(\"employees.policies.end_date\")} ({t(\"common.optional\")})</label>\n              <input type=\"date\" value={endDate} onChange={(e) => setEndDate(e.target.value)} className=\"w-full px-6 py-4 bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl font-bold text-sm focus:ring-4 focus:ring-primary-500/10 outline-none transition-all\" />\n            </div>\n          </div>\n          <div className=\"flex items-center gap-4 bg-slate-50 dark:bg-slate-800 p-6 rounded-2xl border border-slate-100 dark:border-slate-800 group cursor-pointer\" onClick={() => setIsPaid(!isPaid)}>\n            <div className={cn(\"w-6 h-6 rounded-lg border-2 flex items-center justify-center transition-all\", isPaid ? \"bg-primary-600 border-primary-600 text-white\" : \"bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-700\")}>\n              {isPaid && <CheckCircle2 size={16} />}\n            </div>\n            <span className=\"text-xs font-bold text-slate-700 dark:text-slate-200 uppercase tracking-widest\">{t(\"employees.policies.is_paid\")}</span>\n          </div>\n          <div className=\"pt-4 flex justify-end gap-4\">\n            <button type=\"submit\" disabled={createMutation.isPending} className=\"px-10 py-4 bg-slate-900 text-white rounded-2xl font-bold text-xs uppercase tracking-widest hover:bg-primary-700 transition-all shadow-xl shadow-slate-200 dark:shadow-black/30 active:scale-95 disabled:opacity-50\">\n              {createMutation.isPending ? t(\"common.saving\") : t(\"common.save\")}\n            </button>\n          </div>\n        </form>\n      )}\n\n      <div className=\"grid grid-cols-1 gap-4\">\n        {conditions.length === 0 ? (\n          <div className=\"p-20 border-2 border-dashed border-slate-100 dark:border-slate-800 rounded-[3rem] text-center\">\n            <div className=\"w-16 h-16 bg-slate-50 dark:bg-slate-800 rounded-full flex items-center justify-center mx-auto mb-6 text-slate-300 dark:text-slate-600\"><ShieldAlert size={32} /></div>\n            <p className=\"text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.2em]\">{t(\"employees.policies.no_data\")}</p>\n          </div>\n        ) : conditions.map((cond) => (\n          <div key={cond.id} className=\"group bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 p-8 rounded-[2.5rem] hover:shadow-xl hover:shadow-primary-100/10 transition-all relative overflow-hidden\">\n            <div className=\"flex justify-between items-center relative z-10\">\n              <div className=\"flex items-center gap-6\">\n                <div className=\"w-14 h-14 bg-slate-50 dark:bg-slate-800 rounded-2xl flex items-center justify-center transition-transform group-hover:scale-110 duration-500 shadow-inner\">\n                  {getIcon(cond.type)}\n                </div>\n                <div>\n                  <div className=\"flex items-center gap-3 mb-1.5\">\n                    <h4 className=\"font-bold text-slate-700 dark:text-slate-200 text-lg tracking-tight uppercase leading-none\">{t(`employees.policies.types.${cond.type.toLowerCase()}`)}</h4>\n                    <span className={cn(\"px-2.5 py-0.5 rounded-full text-[9px] font-bold uppercase tracking-widest border\", cond.is_paid ? \"bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-300 border-emerald-100 dark:border-emerald-800\" : \"bg-slate-50 dark:bg-slate-800 text-slate-500 dark:text-slate-400 border-slate-100 dark:border-slate-800\")}>\n                      {cond.is_paid ? t(\"employees.policies.paid_allowance\") : t(\"employees.policies.unpaid_allowance\")}\n                    </span>\n                  </div>\n                  <div className=\"flex items-center gap-4 text-[10px] text-slate-500 dark:text-slate-400 font-bold uppercase tracking-widest opacity-70\">\n                    <div className=\"flex items-center gap-1.5\"><Clock size={12} className=\"text-primary-400\" /> {cond.minute_allowance} {t(\"common.minutes\")}</div>\n                    <div className=\"w-1 h-1 bg-slate-200 dark:bg-slate-600 rounded-full\" />\n                    <div className=\"flex items-center gap-1.5\"><Calendar size={12} className=\"text-primary-400\" /> {formatDate(cond.start_date)} {cond.end_date ? `→ ${formatDate(cond.end_date)}` : `(${t(\"employees.history.present\")})`}</div>\n                  </div>\n                </div>\n              </div>\n              <button onClick={() => handleDelete(cond.id)} className=\"p-3 text-slate-200 dark:text-slate-700 hover:text-rose-500 hover:bg-rose-50 dark:bg-rose-950 rounded-xl transition-all active:scale-90 opacity-0 group-hover:opacity-100\">\n                <Trash2 size={20} />\n              </button>\n            </div>\n            <div className=\"absolute -right-8 -bottom-8 w-32 h-32 text-slate-700 dark:text-slate-200 opacity-[0.02] -rotate-12 group-hover:rotate-0 transition-transform duration-700 pointer-events-none\">\n              {getIcon(cond.type)}\n            </div>\n          </div>\n        ))}\n      </div>\n      <ConfirmationDialog />\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/employees/__tests__/WorkingConditionConfig.test.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":27,"column":37,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":27,"endColumn":40,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[787,790],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[787,790],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":43,"column":33,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":43,"endColumn":36,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1253,1256],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1253,1256],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from \"react\";\n\nimport { QueryClient, QueryClientProvider } from \"@tanstack/react-query\";\nimport { render, screen, waitFor } from \"@testing-library/react\";\nimport userEvent from \"@testing-library/user-event\";\nimport { describe, it, expect, vi, beforeEach } from \"vitest\";\n\nimport { ToastProvider } from \"@/components/ui/Toast\";\n\nimport WorkingConditionConfig from \"../WorkingConditionConfig\";\n\n\n\n// Mock API\nconst mockDelete = vi.fn().mockResolvedValue(undefined);\nvi.mock(\"@/lib/api/employees\", () => ({\n  fetchWorkingConditions: vi.fn().mockResolvedValue([\n    {\n      id: \"cond-1\",\n      type: \"EARLY_LEAVE\",\n      minute_allowance: 60,\n      is_paid: true,\n      start_date: \"2026-01-01\"\n    }\n  ]),\n  createWorkingCondition: vi.fn(),\n  deleteWorkingCondition: (...args: any[]) => mockDelete(...args)\n}));\n\n// Mock translation\nvi.mock(\"react-i18next\", () => ({\n  useTranslation: () => ({\n    t: (key: string) => {\n      if (key === \"common.confirm_delete\") return \"Delete policy?\";\n      if (key === \"common.warning\") return \"Warning\";\n      if (key === \"common.confirm\") return \"Confirm\";\n      if (key === \"employees.policies.types.early_leave\") return \"Early Leave\";\n      return key;\n    }\n  })\n}));\n\nconst renderComponent = (props: any) => {\n  const queryClient = new QueryClient({\n    defaultOptions: { queries: { retry: false, gcTime: 0, staleTime: 0 } },\n  });\n  return render(\n    <QueryClientProvider client={queryClient}>\n      <ToastProvider>\n        <WorkingConditionConfig {...props} />\n      </ToastProvider>\n    </QueryClientProvider>\n  );\n};\n\ndescribe(\"WorkingConditionConfig\", () => {\n  beforeEach(() => {\n    vi.clearAllMocks();\n  });\n\n  it(\"should show useConfirm dialog when deleting a condition\", async () => {\n    const user = userEvent.setup();\n    renderComponent({\n      wsId: \"ws-1\",\n      employeeId: \"emp-1\"\n    });\n\n    // Wait for the mock condition to render\n    expect(await screen.findByText(\"Early Leave\")).toBeDefined();\n\n    // Find the delete button. The icon is Trash2.\n    // We can find the button by getting all buttons and picking the one that looks like delete\n    const buttons = screen.getAllByRole(\"button\");\n    // The first button is \"Add btn\" or \"Cancel\", the second one is inside the condition\n    const deleteBtn = buttons[buttons.length - 1];\n    await user.click(deleteBtn);\n\n    // Confirm dialog should appear\n    expect(await screen.findByText(\"Warning\")).toBeDefined();\n    expect(await screen.findByText(\"Delete policy?\")).toBeDefined();\n\n    // Click confirm\n    const confirmBtn = screen.getByRole(\"button\", { name: \"Confirm\" });\n    await user.click(confirmBtn);\n\n    await waitFor(() => {\n      expect(mockDelete).toHaveBeenCalledWith(\"ws-1\", \"emp-1\", \"cond-1\");\n    });\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/ess/ClaimOtDialog.tsx","messages":[],"sup