pe { NavigableListColumn } from \"@/components/common/NavigableList\";\nimport EmployeeDailyDrawer from \"@/components/features/reports/EmployeeDailyDrawer\";\nimport ReportExportDialog from \"@/components/features/reports/ReportExportDialog\";\nimport ReportFilters from \"@/components/features/reports/ReportFilters\";\n\nimport { useDebounce } from \"@/hooks/use-debounce\";\nimport { formatUnitsToHours } from \"@/lib/utils/attendance\";\n\nimport {\n  fetchAttendanceReport,\n  getCurrentWorkspaceId,\n  fetchWorkspace,\n  searchEmployees,\n  fetchDepartments,\n  AttendanceReportSort,\n  AttendanceSummary,\n} from \"../lib/api\";\n\nconst PAGE_SIZE = 50;\n\nexport default function ReportsPage() {\n  const { t } = useTranslation();\n  const wsId = getCurrentWorkspaceId();\n  // URL search params — read once on mount for cross-page navigation\n  const searchParams = new URLSearchParams(window.location.search);\n  const setSearchParams = (_params: Record<string, string>, _opts?: any) => {\n    // No-op: local state only\n  };\n\n  // Read URL params for cross-navigation\n  const urlFrom = searchParams.get(\"from\");\n  const urlTo = searchParams.get(\"to\");\n\n  const { data: workspace } = useQuery({\n    queryKey: [\"workspace\", wsId],\n    queryFn: () => fetchWorkspace(wsId!),\n    enabled: !!wsId,\n  });\n\n  const workUnitMinutes = workspace?.work_unit_minutes || 60;\n\n  const getMonthRange = (offset: number = 0) => {\n    const d = new Date(); d.setMonth(d.getMonth() + offset);\n    const firstDay = format(new Date(d.getFullYear(), d.getMonth(), 1), 'yyyy-MM-dd');\n    const lastDay = format(new Date(d.getFullYear(), d.getMonth() + 1, 0), 'yyyy-MM-dd');\n    return { start: firstDay, end: lastDay };\n  };\n\n  const [filterMode, setFilterMode] = useState<\"this_month\" | \"last_month\" | \"custom\" | \"specific_month\">(\n    urlFrom && urlTo ? \"custom\" : \"last_month\"\n  );\n  const [dateRange, setDateRange] = useState(\n    urlFrom && urlTo ? { start: urlFrom, end: urlTo } : getMonthRange(-1)\n  );\n  const [specificMonth, setSpecificMonth] = useState({\n    month: new Date().getMonth() === 0 ? 12 : new Date().getMonth(),\n    year: new Date().getMonth() === 0 ? new Date().getFullYear() - 1 : new Date().getFullYear()\n  });\n\n  // Clear URL params after initialization\n  useEffect(() => {\n    if (urlFrom || urlTo) {\n      setSearchParams({}, { replace: true });\n    }\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, []);\n\n  const [searchQuery, setSearchQuery] = useState(\"\");\n  const debouncedSearch = useDebounce(searchQuery, 400);\n  const [isExportDialogOpen, setIsExportDialogOpen] = useState(false);\n  const [selectedDepartmentId, setSelectedDepartmentId] = useState<string | null>(null);\n  const searchInputRef = useRef<HTMLInputElement>(null);\n  const keyDownRef = useRef<((e: React.KeyboardEvent<HTMLInputElement>) => void) | null>(null);\n\n  const focusSearch = () => setTimeout(() => searchInputRef.current?.focus(), 100);\n\n  // Drill-down state\n  const [selectedEmployee, setSelectedEmployee] = useState<{ id: string; name: string } | null>(null);\n\n  const [sortBy, setSortBy] = useState<AttendanceReportSort | undefined>(undefined);\n\n\n\n  // Resolve search query → employee IDs (server-side)\n  const { data: searchResults } = useQuery({\n    queryKey: [\"employees\", wsId, \"search\", debouncedSearch],\n    queryFn: () => searchEmployees(wsId!, debouncedSearch),\n    enabled: !!wsId && debouncedSearch.trim().length > 0,\n  });\n\n  // Fetch departments for chip filter\n  const { data: departments } = useQuery({\n    queryKey: [\"departments\", wsId],\n    queryFn: () => fetchDepartments(wsId!),\n    enabled: !!wsId,\n  });\n\n  // Derive employee IDs from search results for server-side filtering\n  const employeeIdsFilter = useMemo(() => {\n    if (!debouncedSearch.trim()) return undefined; // No filter — show all\n    if (!searchResults?.data?.length) return [\"__none__\"]; // Search returned nothing — show empty\n    return searchResults.data.map((emp) => emp.id);\n  }, [debouncedSearch, searchResults]);\n\n  const handleFilterModeChange = (mode: \"this_month\" | \"last_month\" | \"custom\" | \"specific_month\") => {\n    setFilterMode(mode);\n    let range;\n    focusSearch();\n    if (mode === \"this_month\") range = getMonthRange(0);\n    else if (mode === \"last_month\") range = getMonthRange(-1);\n\n    if (range) {\n      setDateRange(range);\n    }\n  };\n\n  const handleSpecificMonthChange = (m: number, y: number) => {\n    setSpecificMonth({ month: m, year: y });\n    setFilterMode(\"specific_month\");\n    const start = format(new Date(y, m - 1, 1), 'yyyy-MM-dd');\n    const end = format(endOfMonth(new Date(y, m - 1, 1)), 'yyyy-MM-dd');\n    setDateRange({ start, end });\n  };\n\n  const handleDateRangeChange = (newRange: { start: string; end: string }) => {\n    setDateRange(newRange);\n  };\n\n  const handleSearchQueryChange = (query: string) => {\n    setSearchQuery(query);\n  };\n\n  const handleDepartmentChange = (departmentId: string | null) => {\n    setSelectedDepartmentId(departmentId);\n    focusSearch();\n  };\n\n  // Fetch summary with infinite scroll\n  const {\n    data: reportPages,\n    isLoading,\n    fetchNextPage,\n    hasNextPage,\n    isFetchingNextPage,\n  } = useInfiniteQuery({\n    queryKey: [\"attendance-report\", wsId, dateRange, \"summary\", PAGE_SIZE, sortBy, employeeIdsFilter, selectedDepartmentId],\n    queryFn: ({ pageParam }) =>\n      fetchAttendanceReport(wsId!, dateRange.start, dateRange.end, \"summary\", pageParam as number, PAGE_SIZE, sortBy, employeeIdsFilter, selectedDepartmentId),\n    getNextPageParam: (lastPage, allPages) => {\n      const totalLoaded = allPages.reduce((sum, p) => sum + (p.data?.length || 0), 0);\n      const total = lastPage.total || 0;\n      if (totalLoaded >= total) return undefined;\n      return allPages.length + 1;\n    },\n    initialPageParam: 1,\n    enabled: !!wsId,\n  });\n\n  // Flatten all pages into a single array\n  const filteredData = useMemo(() => {\n    if (!reportPages) return [];\n    return reportPages.pages.flatMap((p) => p.data || []);\n  }, [reportPages]);\n\n  // Separate query for ALL employees (unpaginated) — used only for stats computation\n  const { data: allStatsResponse } = useQuery({\n    queryKey: [\"attendance-report-stats\", wsId, dateRange, \"summary\", sortBy, employeeIdsFilter, selectedDepartmentId],\n    queryFn: () => fetchAttendanceReport(wsId!, dateRange.start, dateRange.end, \"summary\", 1, 99999, sortBy, employeeIdsFilter, selectedDepartmentId),\n    enabled: !!wsId,\n  });\n\n  // Compute quick stats from the FULL dataset (all employees, not just loaded pages)\n  const quickStats = useMemo(() => {\n    const allData = allStatsResponse?.data || [];\n    const stdHours = formatUnitsToHours(\n      allData.reduce((acc: number, r: any) => acc + (r.total_std_units || 0), 0),\n      workUnitMinutes\n    );\n    const otHours = formatUnitsToHours(\n      allData.reduce((acc: number, r: any) => acc + (r.total_ot_units || 0), 0),\n      workUnitMinutes\n    );\n    const totalEmployees = new Set(allData.map((r: any) => r.employee_id)).size;\n    return { stdHours, otHours, totalEmployees };\n  }, [allStatsResponse, workUnitMinutes]);\n\n\n\n  type SortField = 'name' | 'work_hours' | 'leave_days' | 'ot_hours' | 'total_hours';\n\n  const getSortIcon = (field: SortField) => {\n    const prefix = field;\n    if (sortBy === `${prefix}_asc`) return <ArrowUp size={12} className=\"ml-1 text-primary-600 dark:text-primary-400\" />;\n    if (sortBy === `${prefix}_desc`) return <ArrowDown size={12} className=\"ml-1 text-primary-600 dark:text-primary-400\" />;\n    return <ArrowUpDown size={12} className=\"ml-1 opacity-20 group-hover:opacity-100 transition-opacity\" />;\n  };\n\n  const handleSort = (field: SortField) => {\n    const defaultDesc = field !== 'name'; // numeric fields default to desc first\n    const descKey = `${field}_desc` as AttendanceReportSort;\n    const ascKey = `${field}_asc` as AttendanceReportSort;\n    if (defaultDesc) {\n      setSortBy(sortBy === descKey ? ascKey : descKey);\n    } else {\n      setSortBy(sortBy === ascKey ? descKey : ascKey);\n    }\n  };\n\n  // Column definitions for NavigableList\n  const reportColumns: NavigableListColumn<AttendanceSummary>[] = [\n    {\n      key: \"name\",\n      header: <div className=\"flex items-center\">{t(\"common.employee\")}{getSortIcon('name')}</div>,\n      onHeaderClick: () => handleSort('name'),\n      cell: (row) => (\n        <div>\n          <div className=\"font-bold text-slate-700 dark:text-slate-200 text-sm tracking-tight uppercase leading-none\">{row.employee_name}</div>\n          <div className=\"text-[9px] font-bold text-primary-600 dark:text-primary-400 uppercase tracking-widest mt-0.5\">{row.employee_id_number || \"—\"}</div>\n        </div>\n      ),\n      headerClassName: \"px-10\",\n      cellClassName: \"px-10 py-6\",\n    },\n    {\n      key: \"std_hours\",\n      header: <div className=\"flex items-center justify-end\">{t(\"reports.table.std_hours\")}{getSortIcon('work_hours')}</div>,\n      onHeaderClick: () => handleSort('work_hours'),\n      cell: (row) => (\n        <div className=\"font-mono font-bold text-primary-600 dark:text-primary-400 text-base tracking-tighter cursor-default\" title={`${row.total_std_units} units`}>\n          {formatUnitsToHours(row.total_std_units, workUnitMinutes)}h\n        </div>\n      ),\n      headerClassName: \"text-right\",\n      cellClassName: \"py-6 text-right\",\n    },\n    {\n      key: \"ot_hours\",\n      header: <div className=\"flex items-center justify-end\">{t(\"reports.table.ot_hours\")}{getSortIcon('ot_hours')}</div>,\n      onHeaderClick: () => handleSort('ot_hours'),\n      cell: (row) => row.total_ot_units > 0 ? (\n        <div className=\"font-mono font-bold text-orange-600 dark:text-orange-400 text-base tracking-tighter cursor-default\" title={`${row.total_ot_units} OT units`}>\n          {formatUnitsToHours(row.total_ot_units, workUnitMinutes)}h\n        </div>\n      ) : (\n        <span className=\"text-slate-200 dark:text-slate-700 font-bold\">—</span>\n      ),\n      headerClassName: \"text-right text-orange-500 dark:text-orange-400\",\n      cellClassName: \"py-6 text-right\",\n    },\n    {\n      key: \"total_hours\",\n      header: <div className=\"flex items-center justify-end\">{t(\"reports.table.total_hours\")}{getSortIcon('total_hours')}</div>,\n      onHeaderClick: () => handleSort('total_hours'),\n      cell: (row) => (\n        <div className=\"font-mono font-bold text-slate-700 dark:text-slate-200 text-base tracking-tighter cursor-default\" title={`${row.total_std_units + row.total_ot_units} total units`}>\n          {formatUnitsToHours(row.total_std_units + row.total_ot_units, workUnitMinutes)}h\n        </div>\n      ),\n      headerClassName: \"text-right\",\n      cellClassName: \"py-6 text-right\",\n    },\n    {\n      key: \"leave_days\",\n      header: <div className=\"flex items-center justify-end\">{t(\"reports.table.leave_days\")}{getSortIcon('leave_days')}</div>,\n      onHeaderClick: () => handleSort('leave_days'),\n      cell: (row) => <span className=\"font-mono font-bold text-orange-600 dark:text-orange-300 text-base tracking-tighter\">{row.total_leave_days} {t(\"common.days_short\")}</span>,\n      headerClassName: \"px-10 text-right\",\n      cellClassName: \"px-10 py-6 text-right\",\n    },\n    {\n      key: \"notes\",\n      header: t(\"common.notes\"),\n      cell: () => <span className=\"text-slate-200 dark:text-slate-700 font-bold tracking-widest\">—</span>,\n      headerClassName: \"px-10 text-right\",\n      cellClassName: \"px-10 py-6 text-right\",\n    },\n  ];\n\n  const handleEmployeeClick = (employeeId: string, employeeName: string) => {\n    setSelectedEmployee({ id: employeeId, name: employeeName });\n  };\n\n  const handleDrawerClose = () => {\n    setSelectedEmployee(null);\n    focusSearch();\n  };\n\n  if (!wsId) return <div className=\"p-12 text-center text-slate-500 dark:text-slate-400 font-bold italic uppercase tracking-widest text-xs opacity-50\">{t(\"common.select_workspace\")}</div>;\n\n  return (\n    <div className=\"space-y-10 pb-20 animate-in fade-in duration-700\">\n\n      <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-8 px-2\">\n        <div className=\"space-y-1\">\n          <h1 className=\"text-4xl font-bold tracking-tighter text-slate-700 dark:text-slate-200 uppercase leading-none\">{t(\"reports.title\")}</h1>\n          <p className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em] opacity-60\">{t(\"reports.subtitle\")}</p>\n        </div>\n\n        <div className=\"flex items-center gap-3\">\n          <Link\n            to=\"/attendance-logs\"\n            search={{ from: dateRange.start, to: dateRange.end } as any}\n            className=\"flex items-center gap-3 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-primary-600 dark:text-primary-400 px-8 py-3 rounded-2xl hover:bg-primary-50 dark:hover:bg-primary-950 transition-all font-bold text-xs uppercase tracking-widest shadow-xl active:scale-95\"\n          >\n            <CalendarCheck size={18} /> {t(\"reports.view_raw_logs\").toUpperCase()}\n          </Link>\n          <button\n            onClick={() => setIsExportDialogOpen(true)}\n            className=\"flex items-center gap-3 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 px-8 py-3 rounded-2xl hover:bg-slate-50 dark:hover:bg-slate-800 transition-all font-bold text-xs uppercase tracking-widest shadow-xl active:scale-95\"\n          >\n            <Download size={18} /> {t(\"reports.export_excel\").toUpperCase()}\n          </button>\n        </div>\n      </div>\n\n      <NavigableList<AttendanceSummary>\n        columns={reportColumns}\n        items={filteredData}\n        itemKey={(row) => row.employee_id}\n        onSelect={(row) => handleEmployeeClick(row.employee_id, row.employee_name)}\n        isLoading={isLoading}\n        emptyMessage={t(\"reports.messages.no_data\")}\n        showChevron\n        rowIdPrefix=\"summary-row\"\n        resetDeps={[searchQuery, filterMode, specificMonth, dateRange]}\n        hasNextPage={hasNextPage}\n        isFetchingNextPage={isFetchingNextPage}\n        fetchNextPage={fetchNextPage}\n        maxHeightClass=\"\"\n        searchValue={searchQuery}\n        onSearchChange={handleSearchQueryChange}\n        searchPlaceholder={t(\"reports.search_placeholder\")}\n        searchInputRef={searchInputRef}\n        searchTestId=\"report-search\"\n        className=\"animate-in slide-in-from-bottom-8 duration-700\"\n        onKeyDownRef={keyDownRef}\n        headerSlot={\n          <ReportFilters\n            filterMode={filterMode}\n            dateRange={dateRange}\n            specificMonth={specificMonth}\n            searchQuery={searchQuery}\n            searchInputRef={searchInputRef}\n            t={t}\n            onFilterModeChange={handleFilterModeChange}\n            onDateRangeChange={handleDateRangeChange}\n            onSpecificMonthChange={handleSpecificMonthChange}\n            onSearchQueryChange={handleSearchQueryChange}\n            departments={departments}\n            selectedDepartmentId={selectedDepartmentId}\n            onDepartmentChange={handleDepartmentChange}\n            onSearchKeyDown={(e) => keyDownRef.current?.(e)}\n            statsSlot={\n              <>\n                <div className=\"flex items-center gap-2 bg-slate-900 dark:bg-slate-800 px-4 py-2.5 rounded-2xl border border-slate-800 dark:border-slate-700 shadow-lg\">\n                  <FileBarChart size={14} className=\"text-primary-400\" />\n                  <span className=\"text-[10px] font-bold text-slate-400 uppercase tracking-widest\">{t(\"reports.quick_stats.std_hours\")}</span>\n                  <span className=\"font-mono font-bold text-white text-sm tracking-tighter\">{quickStats.stdHours}h</span>\n                </div>\n                <div className=\"flex items-center gap-2 bg-gradient-to-r from-orange-900 to-orange-950 px-4 py-2.5 rounded-2xl border border-orange-800 shadow-lg\">\n                  <Clock size={14} className=\"text-orange-400\" />\n                  <span className=\"text-[10px] font-bold text-orange-400/70 uppercase tracking-widest\">{t(\"reports.quick_stats.ot_hours\")}</span>\n                  <span className=\"font-mono font-bold text-orange-100 text-sm tracking-tighter\">{quickStats.otHours}h</span>\n                </div>\n                <div className=\"flex items-center gap-2 bg-white dark:bg-slate-900 px-4 py-2.5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-lg\">\n                  <Users2 size={14} className=\"text-primary-600 dark:text-primary-400\" />\n                  <span className=\"text-[10px] font-bold text-slate-400 uppercase tracking-widest\">{t(\"common.employees\")}</span>\n                  <span className=\"font-mono font-bold text-slate-700 dark:text-slate-200 text-sm tracking-tighter\">{quickStats.totalEmployees}</span>\n                </div>\n              </>\n            }\n          />\n        }\n      />\n\n      {/* Employee Daily Drill-down Drawer */}\n      <EmployeeDailyDrawer\n        key={selectedEmployee?.id || \"closed\"}\n        isOpen={!!selectedEmployee}\n        onClose={handleDrawerClose}\n        workspaceId={wsId}\n        employeeId={selectedEmployee?.id || \"\"}\n        employeeName={selectedEmployee?.name || \"\"}\n        dateRange={dateRange}\n        workUnitMinutes={workUnitMinutes}\n      />\n\n      <ReportExportDialog\n        isOpen={isExportDialogOpen}\n        onClose={() => setIsExportDialogOpen(false)}\n        wsId={wsId || \"\"}\n        startDate={dateRange.start}\n        endDate={dateRange.end}\n        reportType=\"detail\"\n        employeeIds={employeeIdsFilter && employeeIdsFilter[0] !== \"__none__\" ? employeeIdsFilter : undefined}\n      />\n\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/ShiftSwapsPage.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'fetchShifts' is defined but never used. Allowed unused vars must match /^_/u.","line":33,"column":5,"nodeType":"Identifier","messageId":"unusedVar","endLine":33,"endColumn":16,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"fetchShifts"},"fix":{"range":[744,761],"text":""},"desc":"Remove unused variable \"fetchShifts\"."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from \"react\";\n\nimport { useQuery, useMutation, useQueryClient } from \"@tanstack/react-query\";\nimport {\n    ArrowLeftRight,\n    Plus,\n    Clock,\n    CheckCircle,\n    XCircle,\n    Check,\n    X,\n    ArrowRight,\n    CalendarDays,\n    HelpCircle,\n    ChevronDown,\n    ChevronRight,\n    Info,\n} from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport Button from \"@/components/ui/Button\";\nimport { LABEL_BASE } from \"@/components/ui/FormField\";\nimport StatusBadge from \"@/components/ui/StatusBadge\";\nimport { useToast } from \"@/components/ui/Toast\";\n\nimport { useDateTimeFormatter } from \"@/hooks/use-datetime\";\nimport { cn } from \"@/lib/utils\";\n\n\nimport {\n    fetchEmployees,\n    getCurrentWorkspaceId,\n    fetchShifts,\n} from \"../lib/api\";\nimport {\n    fetchShiftSwaps,\n    createShiftSwap,\n    approveShiftSwap,\n    fetchShiftSwapStats,\n    ShiftSwapStatus,\n} from \"../lib/api/shift-swaps\";\n\ntype TabType = \"pending_target\" | \"pending_admin\" | \"approved\" | \"rejected\" | \"cancelled\";\n\nexport default function ShiftSwapsPage() {\n    const { t } = useTranslation();\n    const wsId = getCurrentWorkspaceId();\n    const queryClient = useQueryClient();\n    const { formatDate } = useDateTimeFormatter();\n    const [activeTab, setActiveTab] = useState<TabType>(\"pending_admin\");\n    const [showCreateForm, setShowCreateForm] = useState(false);\n    const [showGuide, setShowGuide] = useState(false);\n    const toast = useToast();\n\n    // Form state\n    const [requesterId, setRequesterId] = useState(\"\");\n    const [targetId, setTargetId] = useState(\"\");\n    const [swapDate, setSwapDate] = useState(\"\");\n    const [reason, setReason] = useState(\"\");\n\n    const { data: swaps = [], isLoading } = useQuery({\n        queryKey: [\"shift-swaps\", wsId, activeTab],\n        queryFn: () => fetchShiftSwaps(wsId!, activeTab as ShiftSwapStatus),\n        enabled: !!wsId,\n    });\n\n    const { data: stats } = useQuery({\n        queryKey: [\"shift-swap-stats\", wsId],\n        queryFn: () => fetchShiftSwapStats(wsId!),\n        enabled: !!wsId,\n    });\n\n    const { data: employeesData } = useQuery({\n        queryKey: [\"employees\", wsId],\n        queryFn: () => fetchEmployees(wsId!, 1, 3000),\n        enabled: !!wsId,\n    });\n    const employees = employeesData?.data || [];\n\n    const createMutation = useMutation({\n        mutationFn: (data: {\n            requester_id: string;\n            target_id: string;\n            swap_date: string;\n            reason?: string;\n        }) => createShiftSwap(wsId!, data),\n        onSuccess: () => {\n            queryClient.invalidateQueries({ queryKey: [\"shift-swaps\"] });\n            toast.success(t(\"shift_swaps.messages.create_success\"));\n            setShowCreateForm(false);\n            setRequesterId(\"\");\n            setTargetId(\"\");\n            setSwapDate(\"\");\n            setReason(\"\");\n        },\n        onError: () => {\n            toast.error(t(\"shift_swaps.messages.create_error\"));\n        },\n    });\n\n    const approveMutation = useMutation({\n        mutationFn: (data: { id: string; status: ShiftSwapStatus }) =>\n            approveShiftSwap(wsId!, data.id, { status: data.status }),\n        onSuccess: () => {\n            queryClient.invalidateQueries({ queryKey: [\"shift-swaps\"] });\n            queryClient.invalidateQueries({ queryKey: [\"employee-rosters\"] });\n            queryClient.invalidateQueries({ queryKey: [\"workspace-schedules\"] });\n            toast.success(t(\"common.success\"));\n        },\n    });\n\n    const handleCreate = () => {\n        if (!requesterId || !targetId || !swapDate) return;\n        createMutation.mutate({\n            requester_id: requesterId,\n            target_id: targetId,\n            swap_date: swapDate,\n            reason: reason || undefined,\n        });\n    };\n\n    if (!wsId)\n        return (\n            <div className=\"p-12 text-center text-slate-500 dark:text-slate-400 font-bold italic uppercase tracking-widest text-xs opacity-50\">\n                {t(\"common.select_workspace\")}\n            </div>\n        );\n\n    return (\n        <div className=\"space-y-10 animate-in fade-in duration-700 pb-20\">\n            {/* Header */}\n            <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-8 px-2\">\n                <div className=\"space-y-1\">\n                    <h1 className=\"text-4xl font-bold tracking-tighter text-slate-700 dark:text-slate-200 uppercase leading-none\">\n                        {t(\"shift_swaps.title\")}\n                    </h1>\n                    <p className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em] opacity-60\">\n                        {t(\"shift_swaps.subtitle\")}\n                    </p>\n                </div>\n                <Button\n                    onClick={() => setShowCreateForm(!showCreateForm)}\n                    icon={<Plus size={18} />}\n                >\n                    {t(\"shift_swaps.create_btn\")}\n                </Button>\n            </div>\n\n            {/* Usage Guide */}\n            <div className=\"bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-blue-950/30 dark:to-indigo-950/30 border border-blue-100 dark:border-blue-800/50 rounded-[2rem] overflow-hidden shadow-sm\">\n                <button\n                    onClick={() => setShowGuide(!showGuide)}\n                    className=\"flex items-center justify-between w-full px-8 py-5 group\"\n                >\n                    <div className=\"flex items-center gap-3\">\n                        <div className=\"p-2 bg-blue-100 dark:bg-blue-900/50 rounded-xl\">\n                            <HelpCircle size={18} className=\"text-blue-600 dark:text-blue-400\" />\n                        </div>\n                        <span className=\"text-sm font-bold text-blue-700 dark:text-blue-300 uppercase tracking-widest\">\n                            {t(\"shift_swaps.guide.title\")}\n                        </span>\n                    </div>\n                    {showGuide ? (\n                        <ChevronDown size={16} className=\"text-blue-400\" />\n                    ) : (\n                        <ChevronRight size={16} className=\"text-blue-400\" />\n                    )}\n                </button>\n                {showGuide && (\n                    <div className=\"px-8 pb-6 space-y-4 animate-in slide-in-from-top-2 duration-300\">\n                        <p className=\"text-xs text-blue-700 dark:text-blue-300 leading-relaxed font-medium\">\n                            {t(\"shift_swaps.guide.intro\")}\n                        </p>\n\n                        {/* Steps */}\n                        <div className=\"space-y-3\">\n                            <div className=\"flex items-start gap-3\">\n                                <span className=\"flex-shrink-0 w-6 h-6 bg-blue-600 text-white rounded-full flex items-center justify-center text-[10px] font-black\">1</span>\n                                <div>\n                                    <p className=\"text-xs font-bold text-slate-700 dark:text-slate-200\">{t(\"shift_swaps.guide.step1_title\")}</p>\n                                    <p className=\"text-[11px] text-slate-500 dark:text-slate-400 mt-0.5\">{t(\"shift_swaps.guide.step1_desc\")}</p>\n                                </div>\n                            </div>\n                            <div className=\"flex items-start gap-3\">\n                                <span className=\"flex-shrink-0 w-6 h-6 bg-blue-600 text-white rounded-full flex items-center justify-center text-[10px] font-black\">2</span>\n                                <div>\n                                    <p className=\"text-xs font-bold text-slate-700 dark:text-slate-200\">{t(\"shift_swaps.guide.step2_title\")}</p>\n                                    <p className=\"text-[11px] text-slate-500 dark:text-slate-400 mt-0.5\">{t(\"shift_swaps.guide.step2_desc\")}</p>\n                                </div>\n                            </div>\n                            <div className=\"flex items-start gap-3\">\n                                <span className=\"flex-shrink-0 w-6 h-6 bg-blue-600 text-white rounded-full flex items-center justify-center text-[10px] font-black\">3</span>\n                                <div>\n                                    <p className=\"text-xs font-bold text-slate-700 dark:text-slate-200\">{t(\"shift_swaps.guide.step3_title\")}</p>\n                                    <p className=\"text-[11px] text-slate-500 dark:text-slate-400 mt-0.5\">{t(\"shift_swaps.guide.step3_desc\")}</p>\n                                </div>\n                            </div>\n                        </div>\n\n                        {/* Important notes */}\n                        <div className=\"mt-4 bg-amber-50 dark:bg-amber-950/30 border border-amber-100 dark:border-amber-800/50 rounded-xl p-4\">\n                            <div className=\"flex items-start gap-2\">\n                                <Info size={14} className=\"text-amber-600 dark:text-amber-400 mt-0.5 shrink-0\" />\n                                <div className=\"space-y-1\">\n                                    <p className=\"text-[10px] font-bold text-amber-700 dark:text-amber-300 uppercase tracking-widest\">{t(\"shift_swaps.guide.notes_title\")}</p>\n                                    <ul className=\"text-[11px] text-amber-700 dark:text-amber-300/80 space-y-1 list-disc list-inside\">\n                                        <li>{t(\"shift_swaps.guide.note1\")}</li>\n                                        <li>{t(\"shift_swaps.guide.note2\")}</li>\n                                        <li>{t(\"shift_swaps.guide.note3\")}</li>\n                                    </ul>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                )}\n            </div>\n\n            {/* Create Form */}\n            {showCreateForm && (\n                <div className=\"bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-[2rem] p-8 shadow-sm animate-in slide-in-from-top-4 duration-500\">\n                    <h3 className=\"text-sm font-bold text-slate-700 dark:text-slate-200 uppercase tracking-widest mb-6\">\n                        {t(\"shift_swaps.create_btn\")}\n                    </h3>\n                    <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6\">\n                        <div>\n                            <label className={cn(LABEL_BASE, \"block mb-2\")}>\n                                {t(\"shift_swaps.requester\")}\n                            </label>\n                            <select\n                                value={requesterId}\n                                onChange={(e) => setRequesterId(e.target.value)}\n                                className=\"w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-sm text-slate-700 dark:text-slate-200 font-medium\"\n                            >\n                                <option value=\"\">{t(\"shift_swaps.select_employee\")}</option>\n                                {employees.map((emp) => (\n                                    <option key={emp.id} value={emp.id}>\n                                        {emp.full_name} ({emp.employee_id_number})\n                                    </option>\n                                ))}\n                            </select>\n                        </div>\n                        <div>\n                            <label className={cn(LABEL_BASE, \"block mb-2\")}>\n                                {t(\"shift_swaps.target\")}\n                            </label>\n                            <select\n                                value={targetId}\n                                onChange={(e) => setTargetId(e.target.value)}\n                                className=\"w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-sm text-slate-700 dark:text-slate-200 font-medium\"\n                            >\n                                <option value=\"\">{t(\"shift_swaps.select_employee\")}</option>\n                                {employees\n                                    .filter((emp) => emp.id !== requesterId)\n                                    .map((emp) => (\n                                        <option key={emp.id} value={emp.id}>\n                                            {emp.full_name} ({emp.employee_id_number})\n                                        </option>\n                                    ))}\n                            </select>\n                        </div>\n                        <div>\n                            <label className={cn(LABEL_BASE, \"block mb-2\")}>\n                                {t(\"shift_swaps.swap_date\")}\n                            </label>\n                            <input\n                                type=\"date\"\n                                value={swapDate}\n                                onChange={(e) => setSwapDate(e.target.value)}\n                                className=\"w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-sm text-slate-700 dark:text-slate-200 font-medium\"\n                            />\n                        </div>\n                        <div>\n                            <label className={cn(LABEL_BASE, \"block mb-2\")}>\n                                {t(\"shift_swaps.reason\")}\n                            </label>\n                            <input\n                                type=\"text\"\n                                value={reason}\n                                onChange={(e) => setReason(e.target.value)}\n                                placeholder={t(\"shift_swaps.reason_placeholder\")}\n                                className=\"w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-sm text-slate-700 dark:text-slate-200 font-medium\"\n                            />\n                        </div>\n                    </div>\n                    <div className=\"flex justify-end gap-3 mt-6\">\n                        <Button variant=\"ghost\" onClick={() => setShowCreateForm(false)}>\n                            {t(\"common.cancel\")}\n                        </Button>\n                        <Button\n                            onClick={handleCreate}\n                            disabled={!requesterId || !targetId || !swapDate || createMutation.isPending}\n                            loading={createMutation.isPending}\n                        >\n                            {createMutation.isPending ? t(\"common.loading\") : t(\"common.submit\")}\n                        </Button>\n                    </div>\n                </div>\n            )}\n\n            {/* Stats Bar */}\n            {stats && (\n                <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4 animate-in fade-in duration-500\">\n                    {[\n                        { label: t(\"shift_swaps.stats.pending\"), value: (stats.pending_target || 0) + (stats.pending_admin || 0), color: \"amber\" },\n                        { label: t(\"shift_swaps.stats.approved_month\"), value: stats.approved_this_month || 0, color: \"emerald\" },\n                        { label: t(\"shift_swaps.stats.rejected_month\"), value: stats.rejected_this_month || 0, color: \"rose\" },\n                        { label: t(\"shift_swaps.stats.total\"), value: (stats.approved || 0) + (stats.rejected || 0) + (stats.cancelled || 0), color: \"slate\" },\n                    ].map((stat) => (\n                        <div key={stat.label} className=\"bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-2xl p-5 shadow-sm\">\n                            <p className={`text-2xl font-black tracking-tighter text-${stat.color}-600 dark:text-${stat.color}-400`}>{stat.value}</p>\n                            <p className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest mt-1\">{stat.label}</p>\n                        </div>\n                    ))}\n                </div>\n            )}\n\n            {/* Status Tabs */}\n            <div className=\"flex flex-wrap bg-slate-100 dark:bg-slate-700/50 p-1.5 rounded-[22px] w-fit border border-slate-200 dark:border-slate-700/50 shadow-inner\">\n                <button\n                    onClick={() => setActiveTab(\"pending_target\")}\n                    className={cn(\n                        \"flex items-center gap-2 px-6 py-2.5 rounded-[18px] text-xs font-bold uppercase tracking-widest transition-all\",\n                        activeTab === \"pending_target\"\n                            ? \"bg-white dark:bg-slate-900 text-blue-600 dark:text-blue-300 shadow-sm border border-slate-100 dark:border-slate-800\"\n                            : \"text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200\",\n                    )}\n                >\n                    <Clock size={14} /> {t(\"shift_swaps.status.pending_target\")}\n                </button>\n                <button\n                    onClick={() => setActiveTab(\"pending_admin\")}\n                    className={cn(\n                        \"flex items-center gap-2 px-6 py-2.5 rounded-[18px] text-xs font-bold uppercase tracking-widest transition-all\",\n                        activeTab === \"pending_admin\"\n                            ? \"bg-white dark:bg-slate-900 text-amber-600 dark:text-amber-300 shadow-sm border border-slate-100 dark:border-slate-800\"\n                            : \"text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200\",\n                    )}\n                >\n                    <Clock size={14} /> {t(\"shift_swaps.status.pending_admin\")}\n                </button>\n                <button\n                    onClick={() => setActiveTab(\"approved\")}\n                    className={cn(\n                        \"flex items-center gap-2 px-6 py-2.5 rounded-[18px] text-xs font-bold uppercase tracking-widest transition-all\",\n                        activeTab === \"approved\"\n                            ? \"bg-white dark:bg-slate-900 text-emerald-600 dark:text-emerald-300 shadow-sm border border-slate-100 dark:border-slate-800\"\n                            : \"text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200\",\n                    )}\n                >\n                    <CheckCircle size={14} /> {t(\"shift_swaps.status.approved\")}\n                </button>\n                <button\n                    onClick={() => setActiveTab(\"rejected\")}\n                    className={cn(\n                        \"flex items-center gap-2 px-6 py-2.5 rounded-[18px] text-xs font-bold uppercase tracking-widest transition-all\",\n                        activeTab === \"rejected\"\n                            ? \"bg-white dark:bg-slate-900 text-rose-600 dark:text-rose-300 shadow-sm border border-slate-100 dark:border-slate-800\"\n                            : \"text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200\",\n                    )}\n                >\n                    <XCircle size={14} /> {t(\"shift_swaps.status.rejected\")}\n                </button>\n                <button\n                    onClick={() => setActiveTab(\"cancelled\")}\n                    className={cn(\n                        \"flex items-center gap-2 px-6 py-2.5 rounded-[18px] text-xs font-bold uppercase tracking-widest transition-all\",\n                        activeTab === \"cancelled\"\n                            ? \"bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 shadow-sm border border-slate-100 dark:border-slate-800\"\n                            : \"text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200\",\n                    )}\n                >\n                    <XCircle size={14} /> {t(\"shift_swaps.status.cancelled\")}\n                </button>\n            </div>\n\n            {/* Table */}\n            <div className=\"bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-[3rem] overflow-hidden shadow-sm animate-in slide-in-from-bottom-8 duration-700\">\n                <div className=\"overflow-x-auto\">\n                    <table className=\"w-full text-left border-collapse\">\n                        <thead>\n                            <tr className=\"bg-slate-50 dark:bg-slate-800/50 border-b border-slate-100 dark:border-slate-800\">\n                                <th className=\"px-10 py-6 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em]\">\n                                    {t(\"shift_swaps.swap_date\")}\n                                </th>\n                                <th className=\"px-8 py-6 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em]\">\n                                    {t(\"shift_swaps.requester\")}\n                                </th>\n                                <th className=\"px-4 py-6 text-center\">\n                                    <ArrowLeftRight\n                                        size={14}\n                                        className=\"text-slate-400 mx-auto\"\n                                    />\n                                </th>\n                                <th className=\"px-8 py-6 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em]\">\n                                    {t(\"shift_swaps.target\")}\n                                </th>\n                                <th className=\"px-8 py-6 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em]\">\n                                    {t(\"shift_swaps.reason\")}\n                                </th>\n                                <th className=\"px-8 py-6 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em] text-center\">\n                                    {t(\"common.status\")}\n                                </th>\n                                <th className=\"px-10 py-6\"></th>\n                            </tr>\n                        </thead>\n                        <tbody className=\"divide-y divide-slate-50 dark:divide-slate-800\">\n                            {isLoading ? (\n                                <tr>\n                                    <td\n                                        colSpan={7}\n                                        className=\"px-10 py-20 text-center text-slate-500 dark:text-slate-400 font-bold italic uppercase tracking-widest text-xs opacity-50 animate-pulse\"\n                                    >\n                                        {t(\"common.loading\")}\n                                    </td>\n                                </tr>\n                            ) : swaps.length === 0 ? (\n                                <tr>\n                                    <td\n                                        colSpan={7}\n                                        className=\"px-10 py-32 text-center\"\n                                    >\n                                        <div className=\"flex flex-col items-center gap-4\">\n                                            <ArrowLeftRight\n                                                size={40}\n                                                className=\"text-slate-200 dark:text-slate-700\"\n                                            />\n                                            <span className=\"text-slate-500 dark:text-slate-400 font-bold italic uppercase tracking-widest text-xs opacity-50\">\n                                                {t(\"shift_swaps.messages.no_data\")}\n                                            </span>\n                                        </div>\n                                    </td>\n                                </tr>\n                            ) : (\n                                swaps.map((swap) => (\n                                    <tr\n                                        key={swap.id}\n                                        className=\"hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-all group\"\n                                    >\n                                        {/* Date */}\n                                        <td className=\"px-10 py-6\">\n                                            <div className=\"inline-flex items-center gap-2 bg-slate-50 dark:bg-slate-800 px-4 py-2 rounded-xl border border-slate-100 dark:border-slate-800 shadow-inner\">\n                                                <CalendarDays\n                                                    size={14}\n                                                    className=\"text-primary-600 dark:text-primary-400\"\n                                                />\n                                                <span className=\"text-xs font-bold text-slate-700 dark:text-slate-200 uppercase tracking-tighter\">\n                                                    {formatDate(swap.swap_date)}\n                                                </span>\n                                            </div>\n                                        </td>\n\n                                        {/* Requester */}\n                                        <td className=\"px-8 py-6\">\n                                            <div>\n                                                <div className=\"font-bold text-slate-700 dark:text-slate-200 text-sm tracking-tight uppercase leading-none mb-1\">\n                                                    {swap.requester_name || \"—\"}\n                                                </div>\n                                                <div className=\"text-[10px] text-primary-600 dark:text-primary-400 font-bold\">\n                                                    {swap.requester_shift_name || t(\"shift_swaps.day_off\")}\n                                                </div>\n                                            </div>\n                                        </td>\n\n                                        {/* Arrow */}\n                                        <td className=\"px-4 py-6 text-center\">\n                                            <ArrowRight\n                                                size={16}\n                                                className=\"text-slate-300 dark:text-slate-600 mx-auto\"\n                                            />\n                                        </td>\n\n                                        {/* Target */}\n                                        <td className=\"px-8 py-6\">\n                                            <div>\n                                                <div className=\"font-bold text-slate-700 dark:text-slate-200 text-sm tracking-tight uppercase leading-none mb-1\">\n                                                    {swap.target_name || \"—\"}\n                                                </div>\n                                                <div className=\"text-[10px] text-primary-600 dark:text-primary-400 font-bold\">\n                                                    {swap.target_shift_name || t(\"shift_swaps.day_off\")}\n                                                </div>\n                                            </div>\n                                        </td>\n\n                                        {/* Reason */}\n                                        <td className=\"px-8 py-6\">\n                                            <p className=\"text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-tight line-clamp-2 italic opacity-70 leading-relaxed\">\n                                                {swap.reason || t(\"common.no_notes\")}\n                                            </p>\n                                        </td>\n\n                                        {/* Status */}\n                                        <td className=\"px-8 py-6 text-center\">\n                                            <StatusBadge variant={\n                                                swap.status === \"pending_admin\" ? \"warning\" :\n                                                swap.status === \"approved\" ? \"success\" : \"danger\"\n                                            }>\n                                                {t(`shift_swaps.status.${swap.status}`)}\n                                            </StatusBadge>\n                                        </td>\n\n                                        {/* Actions */}\n                                        <td className=\"px-10 py-6 text-right\">\n                                            {swap.status === \"pending_admin\" && (\n                                                <div className=\"flex items-center justify-end gap-3 opacity-0 group-hover:opacity-100 transition-all duration-300\">\n                                                    <button\n                                                        onClick={() =>\n                                                            approveMutation.mutate({\n                                                                id: swap.id,\n                                                                status: \"approved\",\n                                                            })\n                                                        }\n                                                        className=\"p-3 bg-emerald-600 text-white hover:bg-emerald-700 rounded-xl shadow-lg shadow-emerald-100 transition-all active:scale-90\"\n                                                        title={t(\"common.approve\")}\n                                                    >\n                                                        <Check size={18} />\n                                                    </button>\n                                                    <button\n                                                        onClick={() =>\n                                                            approveMutation.mutate({\n                                                                id: swap.id,\n                                                                status: \"rejected\",\n                                                            })\n                                                        }\n                                                        className=\"p-3 bg-white dark:bg-slate-900 text-rose-600 dark:text-rose-300 hover:bg-rose-50 dark:hover:bg-rose-950 rounded-xl shadow-md border border-rose-100 dark:border-rose-800 transition-all active:scale-90\"\n                                                        title={t(\"common.reject\")}\n                                                    >\n                                                        <X size={18} />\n                                                    </button>\n                                                </div>\n                                            )}\n                                        </td>\n                                    </tr>\n                                ))\n                            )}\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n        </div>\n    );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/ShiftsPage.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'assignShift' is defined but never used. Allowed unused vars must match /^_/u.","line":22,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":22,"endColumn":14,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"assignShift"},"fix":{"range":[514,529],"text":""},"desc":"Remove unused variable \"assignShift\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'fetchWorkspace' is defined but never used. Allowed unused vars must match /^_/u.","line":25,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":25,"endColumn":17,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"fetchWorkspace"},"fix":{"range":[559,577],"text":""},"desc":"Remove unused variable \"fetchWorkspace\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","se