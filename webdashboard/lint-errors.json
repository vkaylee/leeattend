st { t } = useTranslation();\n  const toast = useToast();\n\n  const {\n    agents,\n    isLoading: agentsLoading,\n    refetch: refetchAgents,\n    includeInactive,\n    setIncludeInactive,\n    createAgent,\n    updateTrust,\n    deleteAgent,\n    updateAgent,\n    sendCommand\n  } = useAuthorizedAgents();\n\n  const { agents: agentsStatus, refetch: refetchStatus } = useAgentsStatus();\n\n  // Create a map of agent_id -> online status for easy lookup\n  const agentOnlineMap = useMemo(() => {\n    const map: Record<string, boolean> = {};\n    agentsStatus.forEach(a => {\n      map[a.agent_id] = a.is_online;\n    });\n    return map;\n  }, [agentsStatus]);\n\n  // Create a flattened map of device_id -> status\n  const deviceStatuses = useMemo(() => {\n    const map: Record<string, any> = {};\n    agentsStatus.forEach(a => {\n      a.devices.forEach(d => {\n        map[d.device_id.toLowerCase()] = d;\n      });\n    });\n    return map;\n  }, [agentsStatus]);\n\n  async function handleRefreshDevice(agentId: string, deviceId: string) {\n    try {\n      console.log(`Refreshing device ${deviceId} on agent ${agentId}`);\n      await sendCommand({\n        id: agentId,\n        command: {\n          method: \"get_device_info\",\n          device_id: deviceId,\n          data: {}\n        }\n      });\n      toast.success(t(\"devices.toast.refresh_sent\"));\n      // Refresh status after a short delay\n      setTimeout(refetchStatus, 2000);\n    } catch (e: any) {\n      console.error(\"Refresh failed:\", e);\n      const msg = e?.message || \"\";\n      toast.error(`${t(\"devices.toast.refresh_error\")} (${msg})`);\n    }\n  }\n\n  const {\n    devices,\n    isLoading: devicesLoading,\n    createDevice,\n    updateDevice,\n    deleteDevice\n  } = useDevices();\n\n  const [expandedAgents, setExpandedAgents] = useState<Set<string>>(new Set());\n  const [showAddForm, setShowAddForm] = useState(false);\n  const [showAddDeviceForm, setShowAddDeviceForm] = useState(false);\n  const [newAgent, setNewAgent] = useState({ id: \"\", name: \"\", token: \"\" });\n  const [newDevice, setNewDevice] = useState({ name: \"\", agent_id: \"\", ip: \"\", port: 4370, brand: \"zkteco\", password: \"\", timezone: \"UTC\" });\n  const [editingAgent, setEditingAgent] = useState<AuthorizedAgent | null>(null);\n  const [editingDevice, setEditingDevice] = useState<Device | null>(null);\n\n  // Group devices by agent_id\n  const { groupedDevices, unassignedDevices } = useMemo(() => {\n    const grouped: Record<string, Device[]> = {};\n    const unassigned: Device[] = [];\n\n    for (const device of devices) {\n      const agentExists = agents.some(a => a.id === device.agent_id);\n      if (agentExists) {\n        if (!grouped[device.agent_id]) grouped[device.agent_id] = [];\n        grouped[device.agent_id].push(device);\n      } else {\n        unassigned.push(device);\n      }\n    }\n\n    return { groupedDevices: grouped, unassignedDevices: unassigned };\n  }, [agents, devices]);\n\n  const toggleExpanded = (agentId: string) => {\n    setExpandedAgents(prev => {\n      const next = new Set(prev);\n      if (next.has(agentId)) next.delete(agentId);\n      else next.add(agentId);\n      return next;\n    });\n  };\n\n  const expandAll = () => setExpandedAgents(new Set(agents.map(a => a.id)));\n  const collapseAll = () => setExpandedAgents(new Set());\n\n  async function handleAddAgent(e: React.FormEvent) {\n    e.preventDefault();\n    try {\n      await createAgent(newAgent);\n      toast.success(t(\"agents.messages.add_success\", { name: newAgent.name }));\n      setShowAddForm(false);\n      setNewAgent({ id: \"\", name: \"\", token: \"\" });\n    } catch (e) {\n      console.error(e);\n    }\n  }\n\n  async function handleToggleTrust(agent: AuthorizedAgent) {\n    await updateTrust({ id: agent.id, is_trusted: !agent.is_trusted });\n  }\n\n  async function handleDeleteAgent(agent: AuthorizedAgent) {\n    await deleteAgent(agent.id);\n  }\n\n  async function handleUpdateDevice(id: string, data: Partial<Device>) {\n    await updateDevice(id, data);\n  }\n\n  async function handleDeleteDevice(id: string) {\n    await deleteDevice(id);\n  }\n\n  async function handleAddDevice(e: React.FormEvent) {\n    e.preventDefault();\n    try {\n      await createDevice(newDevice);\n      toast.success(t(\"devices.toast.add_success\", { name: newDevice.name }));\n      setShowAddDeviceForm(false);\n      setNewDevice({ name: \"\", agent_id: \"\", ip: \"\", port: 4370, brand: \"zkteco\", password: \"\", timezone: \"UTC\" });\n    } catch (e) {\n      console.error(e);\n      toast.error(t(\"devices.toast.add_error\"));\n    }\n  }\n\n  const handleEditAgent = (agent: AuthorizedAgent) => setEditingAgent(agent);\n  const handleSaveAgent = (updated: AuthorizedAgent) => {\n    toast.success(t(\"agents.messages.update_success\", { name: updated.name }));\n    refetchAgents();\n  };\n\n  async function handleSaveDevice(e: React.FormEvent) {\n    e.preventDefault();\n    if (!editingDevice) return;\n    try {\n      await updateDevice(editingDevice.id, {\n        name: editingDevice.name,\n        ip: editingDevice.ip,\n        port: editingDevice.port,\n        brand: editingDevice.brand,\n        agent_id: editingDevice.agent_id,\n      });\n      toast.success(t(\"devices.toast.update_success\", { name: editingDevice.name }));\n      setEditingDevice(null);\n    } catch (e) {\n      console.error(e);\n      toast.error(t(\"devices.toast.update_error\"));\n    }\n  }\n\n  const brandOptions = [\n    { value: \"zkteco\", label: \"ZKTeco\", icon: <Cpu size={14} /> },\n    { value: \"mock\", label: \"Mock (Dev)\", icon: <Cpu size={14} /> }\n  ];\n\n  const isLoading = agentsLoading || devicesLoading;\n\n  return (\n    <div data-testid=\"connectivity-topology\" className=\"space-y-8 animate-in fade-in duration-500\">\n      {/* Header */}\n      <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-6 px-2\">\n        <div className=\"flex items-center gap-4\">\n          <div className=\"w-12 h-12 rounded-[1.25rem] bg-primary-50 dark:bg-primary-950 flex items-center justify-center text-primary-600 dark:text-primary-400 shadow-sm border border-primary-100 dark:border-primary-800/50\">\n            <Share2 size={24} />\n          </div>\n          <div>\n            <h1 className=\"text-3xl font-bold tracking-tight text-slate-700 dark:text-slate-200 leading-tight\">\n              {t(\"common.settings.categories.connectivity\")}\n            </h1>\n            <p className=\"text-slate-500 dark:text-slate-400 mt-1 font-medium\">\n              {t(\"common.settings.categories.connectivity_desc\")}\n            </p>\n          </div>\n        </div>\n\n        <div className=\"flex items-center gap-3\">\n          {agents.length > 0 && (\n            <>\n              <button\n                data-testid=\"expand-all-btn\"\n                onClick={expandAll}\n                className=\"px-4 py-2 text-xs font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400 hover:text-primary-600 dark:text-primary-400 transition-colors\"\n              >\n                {t(\"common.expand_all\")}\n              </button>\n              <button\n                data-testid=\"collapse-all-btn\"\n                onClick={collapseAll}\n                className=\"px-4 py-2 text-xs font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400 hover:text-primary-600 dark:text-primary-400 transition-colors\"\n              >\n                {t(\"common.collapse_all\")}\n              </button>\n              <div className=\"w-px h-6 bg-slate-200 dark:bg-slate-600\" />\n            </>\n          )}\n          <button\n            data-testid=\"toggle-inactive-btn\"\n            onClick={() => setIncludeInactive(!includeInactive)}\n            className={cn(\n              \"flex items-center gap-2 px-6 py-3 rounded-2xl font-bold text-[10px] uppercase tracking-widest transition-all border shadow-sm active:scale-95\",\n              includeInactive\n                ? \"bg-slate-900 text-white border-transparent\"\n                : \"bg-white dark:bg-slate-900 text-slate-500 dark:text-slate-400 border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800\"\n            )}\n          >\n            {includeInactive ? t(\"common.status_inactive\") : t(\"common.status_active\")}\n          </button>\n          <button\n            data-testid=\"add-agent-btn\"\n            onClick={() => setShowAddForm(true)}\n            className=\"flex items-center gap-3 bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 px-6 py-3 rounded-2xl font-bold text-xs uppercase tracking-widest hover:border-primary-200 dark:hover:border-primary-800 transition-all border border-slate-200 dark:border-slate-700 active:scale-95\"\n          >\n            <Plus size={18} /> {t(\"agents.add_btn\")}\n          </button>\n          <button\n            data-testid=\"global-add-device-btn\"\n            onClick={() => {\n              if (agents.length > 0) {\n                setNewDevice({ ...newDevice, agent_id: agents[0].id });\n                setShowAddDeviceForm(true);\n              } else {\n                toast.error(t(\"agents.messages.no_agents\"));\n              }\n            }}\n            className=\"flex items-center gap-3 bg-primary-600 text-white px-8 py-3 rounded-2xl font-bold text-xs uppercase tracking-widest hover:bg-primary-700 transition-all shadow-xl shadow-primary-100 dark:shadow-black/30 active:scale-95\"\n          >\n            <Plus size={18} /> {t(\"devices.add_btn\")}\n          </button>\n        </div>\n      </div>\n\n      {/* Add Agent Form */}\n      {showAddForm && (\n        <form data-testid=\"add-agent-form\" onSubmit={handleAddAgent} className=\"bg-white dark:bg-slate-900 border-2 border-primary-100 dark:border-primary-800 p-10 rounded-[2.5rem] shadow-xl shadow-primary-50/50 animate-in slide-in-from-top-4 duration-500\">\n          <div className=\"flex items-center gap-3 mb-8 text-primary-700 dark:text-primary-300\">\n            <div className=\"w-8 h-8 rounded-xl bg-primary-50 dark:bg-primary-950 flex items-center justify-center shadow-inner\"><Plus size={16} /></div>\n            <h4 className=\"text-[10px] font-bold uppercase tracking-[0.2em]\">{t(\"agents.add_form_title\")}</h4>\n          </div>\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-8\">\n            <div className=\"space-y-3 px-1\">\n              <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">{t(\"agents.id_label\")}</label>\n              <input data-testid=\"agent-id-input\" required placeholder=\"agent-001\" className=\"w-full bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl px-5 py-4 focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-mono font-bold text-sm tracking-tight\" value={newAgent.id} onChange={(e) => setNewAgent({ ...newAgent, id: e.target.value })} />\n            </div>\n            <div className=\"space-y-3 px-1\">\n              <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">{t(\"agents.name_label\")}</label>\n              <input data-testid=\"agent-name-input\" required placeholder=\"Office Main\" className=\"w-full bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl px-5 py-4 focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-bold text-sm tracking-tight\" value={newAgent.name} onChange={(e) => setNewAgent({ ...newAgent, name: e.target.value })} />\n            </div>\n            <div className=\"space-y-3 px-1\">\n              <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">{t(\"agents.token_label\")}</label>\n              <input data-testid=\"agent-token-input\" required placeholder=\"Connection token\" className=\"w-full bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl px-5 py-4 focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-mono font-bold text-sm\" value={newAgent.token} onChange={(e) => setNewAgent({ ...newAgent, token: e.target.value })} />\n            </div>\n          </div>\n          <div className=\"mt-10 flex justify-end gap-4\">\n            <button data-testid=\"agent-form-cancel\" type=\"button\" onClick={() => setShowAddForm(false)} className=\"px-8 py-4 rounded-2xl font-bold text-xs uppercase tracking-widest text-slate-500 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-all\">{t(\"common.cancel\")}</button>\n            <button data-testid=\"agent-form-submit\" type=\"submit\" className=\"bg-primary-600 text-white px-12 py-4 rounded-2xl font-bold text-xs uppercase tracking-widest hover:bg-primary-700 transition-all shadow-xl shadow-primary-100 dark:shadow-black/30 active:scale-95\">{t(\"agents.save_btn\")}</button>\n          </div>\n        </form>\n      )}\n\n      {/* Agent Topology */}\n      {isLoading ? (\n        <div data-testid=\"agents-loading\" className=\"space-y-4\">\n          {Array.from({ length: 3 }).map((_, i) => (\n            <div key={i} className=\"bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 p-8 rounded-[2.5rem] shadow-sm animate-pulse h-28\" />\n          ))}\n        </div>\n      ) : agents.length === 0 ? (\n        <div data-testid=\"empty-agents-state\" className=\"py-32 text-center border-2 border-dashed border-slate-100 dark:border-slate-800 rounded-[3rem] bg-slate-50 dark:bg-slate-800/30 flex flex-col items-center animate-in zoom-in-95 duration-500\">\n          <div className=\"w-24 h-24 bg-white dark:bg-slate-900 rounded-full flex items-center justify-center shadow-sm mb-6 border border-slate-100 dark:border-slate-800\">\n            <Server size={32} className=\"text-slate-200 dark:text-slate-700\" />\n          </div>\n          <p className=\"text-slate-500 dark:text-slate-400 font-bold uppercase tracking-widest text-[10px] opacity-60 mb-2\">\n            {t(\"agents.table.no_agents\")}\n          </p>\n          <p className=\"text-slate-400 dark:text-slate-500 text-xs max-w-md mb-8\">\n            {t(\"connectivity.empty_guide\")}\n          </p>\n          <button\n            data-testid=\"empty-add-agent-btn\"\n            onClick={() => setShowAddForm(true)}\n            className=\"px-10 py-4 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-2xl font-bold text-[10px] uppercase tracking-[0.2em] text-slate-600 dark:text-slate-300 hover:border-primary-200 dark:border-primary-800 hover:text-primary-600 dark:text-primary-400 transition-all shadow-sm active:scale-95\"\n          >\n            {t(\"agents.add_btn\")}\n          </button>\n        </div>\n      ) : (\n        <div data-testid=\"agents-list\" className=\"space-y-4\">\n          {agents.map(agent => (\n            <AgentAccordionCard\n              key={agent.id}\n              agent={agent}\n              devices={groupedDevices[agent.id] || []}\n              deviceStatuses={deviceStatuses}\n              isOnline={agentOnlineMap[agent.id] || false}\n              isExpanded={expandedAgents.has(agent.id)}\n              onToggleExpand={() => toggleExpanded(agent.id)}\n              onEdit={handleEditAgent}\n              onToggleTrust={handleToggleTrust}\n              onDelete={handleDeleteAgent}\n              onUpdateDevice={handleUpdateDevice}\n              onDeleteDevice={handleDeleteDevice}\n              onEditDevice={setEditingDevice}\n              onRefreshDevice={(deviceId) => handleRefreshDevice(agent.id, deviceId)}\n              onAddDevice={(agentId) => {\n                setNewDevice({ ...newDevice, agent_id: agentId });\n                setShowAddDeviceForm(true);\n              }}\n            />\n          ))}\n        </div>\n      )}\n\n      {/* Unassigned Devices Section */}\n      {unassignedDevices.length > 0 && (\n        <div data-testid=\"unassigned-devices-section\" className=\"mt-8 animate-in fade-in duration-500\">\n          <div className=\"flex items-center gap-3 mb-4 px-2\">\n            <AlertCircle size={16} className=\"text-amber-500\" />\n            <h3 className=\"text-xs font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400\">\n              {t(\"devices.unassigned_title\")} ({unassignedDevices.length})\n            </h3>\n          </div>\n          <div data-testid=\"unassigned-devices-list\" className=\"bg-amber-50 dark:bg-amber-950/50 border border-amber-100 dark:border-amber-800 rounded-[2.5rem] p-6 space-y-3\">\n            {unassignedDevices.map(device => (\n              <DeviceListItem\n                key={device.id}\n                device={device}\n                parentAgentActive={false}\n                onUpdate={handleUpdateDevice}\n                onDelete={handleDeleteDevice}\n                onEdit={setEditingDevice}\n              />\n            ))}\n          </div>\n        </div>\n      )}\n\n      {/* Edit Agent Modal */}\n      <AgentEditModal\n        key={editingAgent?.id}\n        agent={editingAgent}\n        isOpen={!!editingAgent}\n        onClose={() => setEditingAgent(null)}\n        onSave={handleSaveAgent}\n      />\n\n      {/* Add/Edit Device Modal */}\n      <Modal\n        isOpen={showAddDeviceForm || !!editingDevice}\n        onClose={() => { setShowAddDeviceForm(false); setEditingDevice(null); }}\n        title={editingDevice ? t(\"devices.form.edit_device\") : t(\"devices.form.new_device\")}\n        subtitle={t(\"devices.form.infrastructure\")}\n        icon={<Cpu size={24} />}\n        maxWidth=\"lg\"\n      >\n        <form data-testid={editingDevice ? \"edit-device-form\" : \"add-device-form\"} onSubmit={editingDevice ? handleSaveDevice : handleAddDevice} className=\"space-y-8 pt-4 animate-in fade-in duration-500\">\n          <div className=\"space-y-3 px-1\">\n            <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">{t(\"devices.form.clock_name\")}</label>\n            <input data-testid=\"device-name-input\" required className=\"w-full px-5 py-4 bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-bold text-sm tracking-tight shadow-sm\" placeholder={t(\"devices.form.clock_name_placeholder\")} value={editingDevice ? editingDevice.name : newDevice.name} onChange={(e) => editingDevice ? setEditingDevice({ ...editingDevice, name: e.target.value }) : setNewDevice({ ...newDevice, name: e.target.value })}\n            />\n          </div>\n\n          <div className=\"grid grid-cols-2 gap-8\">\n            <div className=\"space-y-3 px-1\">\n              <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">{t(\"devices.form.managed_by\")}</label>\n              {/* Show agent name as read-only (device always belongs to an agent) */}\n              <div className=\"w-full px-5 py-4 bg-slate-100 dark:bg-slate-700 border border-slate-200 dark:border-slate-700 rounded-2xl font-bold text-sm uppercase tracking-tight text-slate-600 dark:text-slate-300 flex items-center gap-2\">\n                <Server size={14} className=\"text-slate-400 dark:text-slate-500\" />\n                {agents.find(a => a.id === (editingDevice ? editingDevice.agent_id : newDevice.agent_id))?.name || \"—\"}\n              </div>\n            </div>\n            <div className=\"space-y-3 px-1\">\n              <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">{t(\"devices.form.brand\")}</label>\n              <Combobox\n                data-testid=\"device-brand-select\"\n                options={brandOptions}\n                value={editingDevice ? editingDevice.brand : newDevice.brand}\n                onChange={(val) => editingDevice ? setEditingDevice({ ...editingDevice, brand: val }) : setNewDevice({ ...newDevice, brand: val })}\n                placeholder={t(\"devices.form.brand_placeholder\")}\n                className=\"bg-slate-50 dark:bg-slate-800 border-slate-100 dark:border-slate-800 h-14\"\n              />\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-3 gap-8\">\n            <div className=\"col-span-2 space-y-3 px-1\">\n              <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">{t(\"devices.form.ip_local\")}</label>\n              <input\n                data-testid=\"device-ip-input\"\n                required\n                className=\"w-full px-5 py-4 bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-mono font-bold text-sm tracking-tight\"\n                placeholder=\"192.168.1.100\"\n                value={editingDevice ? editingDevice.ip : newDevice.ip}\n                onChange={(e) => editingDevice ? setEditingDevice({ ...editingDevice, ip: e.target.value }) : setNewDevice({ ...newDevice, ip: e.target.value })}\n              />\n            </div>\n            <div className=\"space-y-3 px-1\">\n              <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">{t(\"devices.form.port\")}</label>\n              <input\n                data-testid=\"device-port-input\"\n                type=\"number\"\n                required\n                className=\"w-full px-5 py-4 bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-mono font-bold text-sm text-center tracking-tighter\"\n                value={editingDevice ? editingDevice.port : newDevice.port}\n                onChange={(e) => editingDevice ? setEditingDevice({ ...editingDevice, port: parseInt(e.target.value) }) : setNewDevice({ ...newDevice, port: parseInt(e.target.value) })}\n              />\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-2 gap-8\">\n            <div className=\"space-y-3 px-1\">\n              <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">{t(\"devices.form.password\")}</label>\n              <div className=\"relative\">\n                <Lock size={16} className=\"absolute left-4 top-1/2 -translate-y-1/2 text-slate-400\" />\n                <input\n                  data-testid=\"device-password-input\"\n                  type=\"password\"\n                  className=\"w-full pl-11 pr-5 py-4 bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-mono font-bold text-sm tracking-tight\"\n                  placeholder={t(\"devices.form.password_placeholder\")}\n                  value={editingDevice ? (editingDevice.password || \"\") : newDevice.password}\n                  onChange={(e) => editingDevice ? setEditingDevice({ ...editingDevice, password: e.target.value }) : setNewDevice({ ...newDevice, password: e.target.value })}\n                />\n              </div>\n            </div>\n            {/* Timezone field hidden from UI — workspace timezone is used for all log processing.\n               The timezone value defaults to \"UTC\" in the data model for backward compatibility. */}\n          </div>\n\n          <div className=\"flex gap-4 pt-6\">\n            <button\n              data-testid=\"device-form-cancel\"\n              type=\"button\"\n              onClick={() => { setShowAddDeviceForm(false); setEditingDevice(null); }}\n              className=\"flex-1 px-8 py-4 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-2xl font-bold text-xs uppercase tracking-widest text-slate-500 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-all active:scale-95\"\n            >\n              {t(\"devices.form.cancel\")}\n            </button>\n            <button\n              data-testid=\"device-form-submit\"\n              type=\"submit\"\n              className=\"flex-1 bg-primary-600 text-white px-8 py-4 rounded-2xl font-bold uppercase tracking-widest text-xs hover:bg-primary-700 transition-all shadow-xl shadow-primary-100 dark:shadow-black/30 active:scale-95 flex items-center justify-center gap-3\"\n            >\n              {editingDevice ? <Save size={18} /> : <Plus size={18} />}\n              {editingDevice ? t(\"devices.form.update_device\") : t(\"devices.form.save_device\")}\n            </button>\n          </div>\n        </form>\n      </Modal>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/connectivity/DeviceListItem.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Hash' is defined but never used. Allowed unused vars must match /^_/u.","line":7,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":7,"endColumn":7,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Hash"},"fix":{"range":[114,122],"text":""},"desc":"Remove unused variable \"Hash\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'refetchInfo' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":84,"column":38,"nodeType":"Identifier","messageId":"unusedVar","endLine":84,"endColumn":49},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'infoError' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":84,"column":58,"nodeType":"Identifier","messageId":"unusedVar","endLine":84,"endColumn":67}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState } from \"react\";\n\nimport { useQueryClient } from \"@tanstack/react-query\";\nimport {\n  Cpu,\n  Globe,\n  Hash,\n  MoreVertical,\n  Pencil,\n  Trash2,\n  RefreshCw,\n  Power,\n  AlertTriangle,\n  User,\n  ClipboardList,\n  Terminal,\n  Activity,\n  Clock\n} from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuTrigger,\n} from \"@/components/ui/dropdown-menu\";\nimport Modal from \"@/components/ui/Modal\";\nimport { useToast } from \"@/components/ui/Toast\";\n\nimport { useDeviceInfo, devicesKeys } from \"@/hooks/use-devices\";\nimport { useTickingDeviceTime } from \"@/hooks/useTickingDeviceTime\";\nimport { Device, DeviceInfo, DeviceStatus } from \"@/lib/api\";\nimport { cn } from \"@/lib/utils\";\n\n\n\n\ninterface DeviceListItemProps {\n  device: Device;\n  status?: DeviceStatus;\n  parentAgentActive?: boolean;\n  isVisible?: boolean;\n  onUpdate: (id: string, data: Partial<Device>) => Promise<void>;\n  onDelete: (id: string) => Promise<void>;\n  onEdit?: (device: Device) => void;\n  onRefresh?: (deviceId: string) => void;\n}\n\nfunction DeviceTimeTicker({ deviceTime, lastSync }: { deviceTime?: string; lastSync?: string }) {\n  const { t } = useTranslation();\n  const tickingTime = useTickingDeviceTime(deviceTime, lastSync);\n\n  return (\n    <div className=\"flex flex-col gap-1 min-w-[150px]\">\n      <span className=\"text-[8px] font-bold text-slate-400 uppercase tracking-widest\">{t(\"devices.info.device_time\")}</span>\n      <div className=\"flex items-center gap-1.5 text-primary-600 dark:text-primary-400\">\n        <Clock size={12} />\n        <span className=\"text-[10px] font-mono font-black tracking-tighter\">{tickingTime || \"--:--:--\"}</span>\n      </div>\n    </div>\n  );\n}\n\nexport default function DeviceListItem({\n  device,\n  status,\n  parentAgentActive = true,\n  onUpdate,\n  onDelete,\n  onEdit,\n  onRefresh,\n  isVisible = true\n}: DeviceListItemProps) {\n  const { t } = useTranslation();\n  const toast = useToast();\n  const queryClient = useQueryClient();\n  const [isToggling, setIsToggling] = useState(false);\n  const [isRefreshing, setIsRefreshing] = useState(false);\n  const [showToggleModal, setShowToggleModal] = useState(false);\n  const [showDeleteModal, setShowDeleteModal] = useState(false);\n\n  // Fetch detailed info automatically on mount (if agent is active)\n  const { data: deviceInfo, refetch: refetchInfo, error: infoError } = useDeviceInfo(device.id, parentAgentActive && isVisible);\n\n  // Merge status.info (heartbeat data) with deviceInfo (on-demand data)\n  const displayInfo: DeviceInfo | null = deviceInfo ?? status?.info ?? null;\n\n  async function handleRefresh() {\n    if (!onRefresh) return;\n    setIsRefreshing(true);\n    try {\n      await onRefresh(device.id);\n      // Invalidate the query to trigger a refetch after the agent has time to respond\n      setTimeout(() => {\n        queryClient.invalidateQueries({ queryKey: devicesKeys.info(device.id) });\n      }, 2000);\n    } finally {\n      setTimeout(() => setIsRefreshing(false), 2000);\n    }\n  }\n\n  async function handleToggleConfirm() {\n    setShowToggleModal(false);\n    setIsToggling(true);\n    try {\n      await onUpdate(device.id, { is_enabled: !device.is_enabled });\n      toast.success(t(device.is_enabled ? \"devices.toast.disabled\" : \"devices.toast.enabled\", { name: device.name }));\n    } catch (e) {\n      console.error(e);\n      toast.error(t(\"devices.toast.toggle_error\"));\n    } finally {\n      setIsToggling(false);\n    }\n  }\n\n  async function handleDeleteConfirm() {\n    setShowDeleteModal(false);\n    try {\n      await onDelete(device.id);\n      toast.success(t(\"devices.toast.delete_success\"));\n    } catch (e) {\n      console.error(e);\n    }\n  }\n\n  const isDimmed = !parentAgentActive || !device.is_enabled;\n\n  return (\n    <div\n      data-testid={`device-item-${device.id}`}\n      className={cn(\n        \"relative flex flex-col p-5 rounded-[1.5rem] transition-all group border-2\",\n        isDimmed\n          ? \"bg-slate-50/50 dark:bg-slate-900/20 border-slate-100 dark:border-slate-800 opacity-60\"\n          : \"bg-white dark:bg-slate-900 border-transparent hover:border-primary-100 dark:hover:border-primary-900 shadow-sm\",\n      )}\n    >\n      {/* 1. TOP BAR: Name, IP, Status & Menu */}\n      <div className=\"flex items-center justify-between mb-4 pb-4 border-b border-slate-50 dark:border-slate-800/50\">\n        <div className=\"flex items-center gap-3 min-w-0\">\n          <div className={cn(\n            \"w-10 h-10 rounded-xl flex items-center justify-center border shadow-inner shrink-0\",\n            status?.status === \"online\"\n              ? \"bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 border-emerald-100 dark:border-emerald-800\"\n              : \"bg-slate-100 dark:bg-slate-800 text-slate-400 border-slate-200 dark:border-slate-700\"\n          )}>\n            <Cpu size={20} className={cn(status?.status === \"online\" && \"animate-pulse\")} />\n          </div>\n          <div className=\"min-w-0\">\n            <h3 className=\"font-black text-slate-700 dark:text-slate-200 text-sm uppercase tracking-tight truncate\">\n              {device.name}\n            </h3>\n            <div className=\"flex items-center gap-2 text-[10px] font-mono font-bold text-slate-400\">\n              <Globe size={10} /> {device.ip}\n            </div>\n          </div>\n        </div>\n\n        <div className=\"flex items-center gap-3\">\n          <span className={cn(\n            \"px-2.5 py-0.5 rounded-full text-[8px] font-black uppercase tracking-widest border\",\n            status?.status === \"online\"\n              ? \"bg-emerald-500 text-white border-transparent\"\n              : \"bg-slate-100 dark:bg-slate-800 text-slate-500 border-slate-200 dark:border-slate-700\"\n          )}>\n            {status?.status === \"online\" ? \"Online\" : \"Offline\"}\n          </span>\n          <DropdownMenu>\n            <DropdownMenuTrigger asChild>\n              <button data-testid={`device-menu-${device.id}`} className=\"p-2 text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg transition-colors\">\n                <MoreVertical size={16} />\n              </button>\n            </DropdownMenuTrigger>\n            <DropdownMenuContent align=\"end\" className=\"w-52 p-2 rounded-xl shadow-2xl\">\n              <DropdownMenuItem data-testid={`device-refresh-${device.id}`} className=\"gap-3 p-3 rounded-lg font-bold text-xs uppercase\" onSelect={handleRefresh} disabled={isRefreshing}>\n                <RefreshCw size={14} className={cn(isRefreshing && \"animate-spin\")} />\n                {isRefreshing ? t(\"common.loading\") : t(\"common.refresh\")}\n              </DropdownMenuItem>\n              {onEdit && (\n                <DropdownMenuItem data-testid={`device-edit-${device.id}`} className=\"gap-3 p-3 rounded-lg font-bold text-xs uppercase\" onSelect={() => onEdit(device)}>\n                  <Pencil size={14} /> {t(\"devices.table.edit\")}\n                </DropdownMenuItem>\n              )}\n              <DropdownMenuItem data-testid={`device-delete-${device.id}`} className=\"gap-3 p-3 rounded-lg font-bold text-xs uppercase text-rose-600 focus:text-rose-600\" onSelect={() => setShowDeleteModal(true)}>\n                <Trash2 size={14} /> {t(\"devices.table.delete\")}\n              </DropdownMenuItem>\n            </DropdownMenuContent>\n          </DropdownMenu>\n        </div>\n      </div>\n\n      {/* 2. INFO WRAPPER: Responsive flex layout to prevent overflow */}\n      <div className=\"flex flex-wrap gap-y-6 gap-x-8\">\n        {/* Users */}\n        <div className=\"flex flex-col gap-1 min-w-[80px]\">\n          <span className=\"text-[8px] font-bold text-slate-400 uppercase tracking-widest\">{t(\"devices.info.users_capacity\")}</span>\n          <div className=\"flex items-center gap-1.5\">\n            <User size={12} className=\"text-slate-300\" />\n            <span className=\"text-sm font-black text-slate-700 dark:text-slate-200\">\n              {displayInfo ? (\n                <>\n                  {(displayInfo.users_count ?? 0).toLocaleString()}\n                  {typeof displayInfo.users_capacity === 'number' && (\n                    <span className=\"text-slate-400 font-bold text-[10px]\"> / {displayInfo.users_capacity.toLocaleString()}</span>\n                  )}\n                </>\n              ) : \"--\"}\n            </span>\n          </div>\n        </div>\n\n        {/* Logs / Capacity */}\n        <div className=\"flex flex-col gap-1 min-w-[80px]\">\n          <span className=\"text-[8px] font-bold text-slate-400 uppercase tracking-widest\">{t(\"devices.info.logs_capacity\")}</span>\n          <div className=\"flex items-center gap-1.5\">\n            <ClipboardList size={12} className=\"text-amber-400\" />\n            <span className=\"text-sm font-black text-amber-600\">\n              {displayInfo ? (\n                <>\n                  {displayInfo.logs_count != null ? displayInfo.logs_count.toLocaleString() : \"N/A\"}\n                  {typeof displayInfo.logs_capacity === 'number' && displayInfo.logs_capacity > 0 && (\n                    <span className=\"text-slate-400 font-bold text-[10px]\"> / {displayInfo.logs_capacity.toLocaleString()}</span>\n                  )}\n                </>\n              ) : \"--\"}\n            </span>\n          </div>\n        </div>\n\n        {/* Device Time - Live ticking clock */}\n        <DeviceTimeTicker deviceTime={displayInfo?.device_time} lastSync={displayInfo?.last_sync} />\n\n        {/* Serial Number */}\n        <div className=\"flex flex-col gap-1 min-w-[130px]\">\n          <span className=\"text-[8px] font-bold text-slate-400 uppercase tracking-widest\">{t(\"devices.info.serial\")}</span>\n          <div className=\"flex items-center gap-1.5\">\n            <Terminal size={12} className=\"text-slate-300\" />\n            <span className=\"text-[10px] font-mono font-bold text-slate-600 dark:text-slate-400 truncate\">{displayInfo?.serial || \"N/A\"}</span>\n          </div>\n        </div>\n\n        {/* MAC Address */}\n        <div className=\"flex flex-col gap-1 min-w-[130px]\">\n          <span className=\"text-[8px] font-bold text-slate-400 uppercase tracking-widest\">{t(\"devices.info.mac\")}</span>\n          <div className=\"flex items-center gap-1.5\">\n            <Globe size={12} className=\"text-slate-300\" />\n            <span className=\"text-[10px] font-mono font-bold text-slate-600 dark:text-slate-400 truncate\">{displayInfo?.mac || \"N/A\"}</span>\n          </div>\n        </div>\n\n        {/* HW & FW */}\n        <div className=\"flex flex-col gap-1 min-w-[120px]\">\n          <span className=\"text-[8px] font-bold text-slate-400 uppercase tracking-widest\">{t(\"devices.info.hw_fw\")}</span>\n          <div className=\"flex flex-wrap gap-1\">\n            <span className=\"text-[9px] font-black px-1.5 py-0.5 bg-slate-100 dark:bg-slate-800 rounded text-slate-500 border border-slate-200/50 dark:border-slate-700/50\">{displayInfo?.hw_name || \"N/A\"}</span>\n            <span className=\"text-[9px] font-black px-1.5 py-0.5 bg-primary-50 dark:bg-primary-950 text-primary-600 rounded border border-primary-100/50\">v{displayInfo?.firmware || \"?.?\"}</span>\n          </div>\n        </div>\n      </div>\n\n      {/* 3. FOOTER: Quick Toggle */}\n      <div className=\"mt-4 pt-4 border-t border-slate-50 dark:border-slate-800/50 flex items-center justify-between\">\n        <div className=\"text-[10px] font-bold text-slate-400\">\n          {displayInfo ? (\n            <span className=\"text-emerald-500 flex items-center gap-1.5\">\n              <Activity size={10} /> {t(\"devices.info.last_synced\", { time: displayInfo?.last_sync ? new Date(displayInfo.last_sync).toLocaleString() : \"—\" })}\n            </span>\n          ) : (\n            <span className=\"italic\">{t(\"devices.info.loading\")}</span>\n          )}\n        </div>\n        <button\n          data-testid={`device-toggle-${device.id}`}\n          onClick={() => setShowToggleModal(true)}\n          disabled={isToggling}\n          className={cn(\n            \"px-4 py-1.5 rounded-lg text-[9px] font-black uppercase tracking-widest transition-all border\",\n            device.is_enabled\n              ? \"text-rose-500 border-rose-100 dark:border-rose-900/50 hover:bg-rose-500 hover:text-white\"\n              : \"bg-emerald-600 text-white border-transparent hover:bg-emerald-700\"\n          )}\n        >\n          {device.is_enabled ? t(\"devices.info.disable_btn\") : t(\"devices.info.enable_btn\")}\n        </button>\n      </div>\n\n      {/* Modals */}\n      <Modal isOpen={showToggleModal} onClose={() => setShowToggleModal(false)} title={t(device.is_enabled ? \"devices.modal.disable_title\" : \"devices.modal.enable_title\")} icon={<Power size={20} />} maxWidth=\"sm\" testId={`toggle-modal-${device.id}`}>\n        <p className=\"text-sm text-slate-600 dark:text-slate-300 mb-6\">{t(device.is_enabled ? \"devices.confirm_disable\" : \"devices.confirm_enable\", { name: device.name })}</p>\n        <div className=\"flex justify-end gap-3\">\n          <button data-testid={`toggle-cancel-${device.id}`} onClick={() => setShowToggleModal(false)} className=\"px-4 py-2 text-xs font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400 rounded-xl transition-colors\">{t(\"common.cancel\")}</button>\n          <button data-testid={`toggle-confirm-${device.id}`} onClick={handleToggleConfirm} className={cn(\"px-4 py-2 text-xs font-bold uppercase tracking-widest rounded-xl transition-colors\", device.is_enabled ? \"bg-rose-600 text-white\" : \"bg-emerald-600 text-white\")}>\n            {device.is_enabled ? t(\"common.disable\") : t(\"common.enable\")}\n          </button>\n        </div>\n      </Modal>\n\n      <Modal isOpen={showDeleteModal} onClose={() => setShowDeleteModal(false)} title={t(\"devices.modal.delete_title\")} icon={<AlertTriangle size={20} />} maxWidth=\"sm\" testId={`delete-modal-${device.id}`}>\n        <p className=\"text-sm text-slate-600 dark:text-slate-300 mb-6\">{t(\"devices.toast.delete_confirm\", { name: device.name })}</p>\n        <div className=\"flex justify-end gap-3\">\n          <button data-testid={`delete-cancel-${device.id}`} onClick={() => setShowDeleteModal(false)} className=\"px-4 py-2 text-xs font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400 rounded-xl transition-colors\">{t(\"common.cancel\")}</button>\n          <button data-testid={`delete-confirm-${device.id}`} onClick={handleDeleteConfirm} className=\"px-4 py-2 text-xs font-bold uppercase tracking-widest bg-rose-600 text-white rounded-xl transition-colors\">{t(\"devices.table.delete\")}</button>\n        </div>\n      </Modal>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/connectivity/__tests__/AgentAccordionCard.test.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":17,"column":32,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":17,"endColumn":35,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[483,486],"text":"unknown"},"desc":"Use 