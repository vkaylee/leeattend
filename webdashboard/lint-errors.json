he type of."}]}],"suppressedMessages":[],"errorCount":19,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { QueryClient, QueryClientProvider } from \"@tanstack/react-query\";\nimport { render, screen, waitFor } from \"@testing-library/react\";\nimport userEvent from \"@testing-library/user-event\";\nimport { describe, it, expect, beforeEach, afterEach, vi } from \"vitest\";\n\nimport { useReportStream } from \"@/hooks/use-report-stream\";\nimport * as attendanceApi from \"@/lib/api/attendance\";\n\nimport ReportExportDialog from \"../ReportExportDialog\";\n\n/**\n * Integration Tests for ReportExportDialog\n * Verifies phase management, WebSocket connection, progress updates, and fallback mechanism\n */\n\n// Mock the API module\nvi.mock(\"@/lib/api/attendance\", () => ({\n  createReportExportJob: vi.fn(),\n  fetchExportJobStatus: vi.fn(),\n  downloadExportReport: vi.fn(),\n}));\n\n// Mock the useReportStream hook\nvi.mock(\"@/hooks/use-report-stream\", () => ({\n  useReportStream: vi.fn(),\n}));\n\n// Mock Modal component\nvi.mock(\"@/components/ui/Modal\", () => ({\n  default: ({ isOpen, title, children, ...props }: any) =>\n    isOpen ? (\n      <div data-testid=\"modal\" {...props}>\n        <h2>{title}</h2>\n        {children}\n      </div>\n    ) : null,\n}));\n\n// Wrapper component with QueryClientProvider\nconst renderWithQueryClient = (component: React.ReactElement) => {\n  const queryClient = new QueryClient({\n    defaultOptions: {\n      queries: { retry: false },\n      mutations: { retry: false },\n    },\n  });\n\n  return render(\n    <QueryClientProvider client={queryClient}>\n      {component}\n    </QueryClientProvider>\n  );\n};\n\ndescribe(\"ReportExportDialog - Integration Tests\", () => {\n  const mockOnClose = vi.fn();\n  const defaultProps = {\n    isOpen: true,\n    onClose: mockOnClose,\n    wsId: \"test-workspace\",\n    startDate: \"2024-01-01\",\n    endDate: \"2024-01-31\",\n    reportType: \"summary\" as const,\n    employeeIds: undefined,\n  };\n\n  const mockStreamHook = (overrides = {}) => {\n    const defaults = {\n      status: \"idle\" as const,\n      progress: 0,\n      chunks: [],\n      error: null,\n      reconnect: vi.fn(),\n    };\n    return { ...defaults, ...overrides };\n  };\n\n  beforeEach(() => {\n    vi.clearAllMocks();\n    (useReportStream as any).mockReturnValue(mockStreamHook());\n    (attendanceApi.createReportExportJob as any).mockResolvedValue({\n      job_id: \"job-123\",\n      total_batches: 5,\n    });\n    (attendanceApi.fetchExportJobStatus as any).mockResolvedValue({\n      status: \"processing\",\n      progress: { percentage: 50, completed_batches: 2 },\n    });\n  });\n\n  afterEach(() => {\n    vi.clearAllMocks();\n  });\n\n  describe(\"Initialization & UI Rendering\", () => {\n    it(\"should render export dialog with proper structure\", async () => {\n      renderWithQueryClient(\n        <ReportExportDialog {...defaultProps} />\n      );\n\n      expect(screen.getByTestId(\"report-export-dialog\")).toBeInTheDocument();\n      expect(screen.getByTestId(\"report-export-info\")).toBeInTheDocument();\n      expect(screen.getByTestId(\"report-export-start-button\")).toBeInTheDocument();\n    });\n\n    it(\"should display correct date range and report type\", async () => {\n      renderWithQueryClient(\n        <ReportExportDialog {...defaultProps} />\n      );\n\n      const infoSection = screen.getByTestId(\"report-export-info\");\n      expect(infoSection.textContent).toContain(\"2024-01-01\");\n      expect(infoSection.textContent).toContain(\"2024-01-31\");\n      expect(infoSection.textContent).toContain(\"summary\");\n    });\n\n    it(\"should show employee count when employeeIds provided\", async () => {\n      const props = {\n        ...defaultProps,\n        employeeIds: [\"emp-1\", \"emp-2\", \"emp-3\"],\n      };\n\n      renderWithQueryClient(\n        <ReportExportDialog {...props} />\n      );\n\n      const infoSection = screen.getByTestId(\"report-export-info\");\n      expect(infoSection.textContent).toContain(\"3\");\n    });\n\n    it(\"should have data-testid on all interactive elements\", async () => {\n      renderWithQueryClient(\n        <ReportExportDialog {...defaultProps} />\n      );\n\n      expect(screen.getByTestId(\"report-export-start-button\")).toBeInTheDocument();\n      expect(screen.getByTestId(\"report-export-cancel-button\")).toBeInTheDocument();\n    });\n  });\n\n  describe(\"Job Creation & WebSocket Connection (Fix 2: Proxy)\", () => {\n    it(\"should create export job when start button clicked\", async () => {\n      const user = userEvent.setup();\n\n      renderWithQueryClient(\n        <ReportExportDialog {...defaultProps} />\n      );\n\n      const startBtn = screen.getByTestId(\"report-export-start-button\");\n      await user.click(startBtn);\n\n      await waitFor(() => {\n        expect(attendanceApi.createReportExportJob).toHaveBeenCalledWith(\n          \"test-workspace\",\n          expect.objectContaining({\n            start_date: \"2024-01-01\",\n            end_date: \"2024-01-31\",\n            report_type: \"summary\",\n          })\n        );\n      });\n    });\n\n    it(\"should pass jobId to useReportStream hook for WebSocket connection\", async () => {\n      const user = userEvent.setup();\n\n      (attendanceApi.createReportExportJob as any).mockResolvedValue({\n        job_id: \"test-job-456\",\n        total_batches: 3,\n      });\n\n      renderWithQueryClient(\n        <ReportExportDialog {...defaultProps} />\n      );\n\n      const startBtn = screen.getByTestId(\"report-export-start-button\");\n      await user.click(startBtn);\n\n      await waitFor(() => {\n        expect(useReportStream).toHaveBeenCalledWith(\n          expect.objectContaining({\n            jobId: \"test-job-456\",\n          })\n        );\n      });\n    });\n\n    it(\"should pass employee IDs to API when provided\", async () => {\n      const user = userEvent.setup();\n      const employeeIds = [\"emp-1\", \"emp-2\"];\n\n      const props = {\n        ...defaultProps,\n        employeeIds,\n      };\n\n      renderWithQueryClient(\n        <ReportExportDialog {...props} />\n      );\n\n      const startBtn = screen.getByTestId(\"report-export-start-button\");\n      await user.click(startBtn);\n\n      await waitFor(() => {\n        expect(attendanceApi.createReportExportJob).toHaveBeenCalledWith(\n          \"test-workspace\",\n          expect.objectContaining({\n            employee_ids: employeeIds,\n          })\n        );\n      });\n    });\n  });\n\n  describe(\"Phase Management (Fix 1: Race Condition)\", () => {\n    it(\"should control phase transitions via WebSocket status only\", async () => {\n      const user = userEvent.setup();\n\n      // Mock WebSocket status changes\n      (useReportStream as any).mockImplementation(({ jobId }: any) => {\n        // Simulate connecting -> streaming transition\n        return mockStreamHook({\n          status: jobId ? \"streaming\" : \"idle\",\n          progress: 0,\n        });\n      });\n\n      renderWithQueryClient(\n        <ReportExportDialog {...defaultProps} />\n      );\n\n      const startBtn = screen.getByTestId(\"report-export-start-button\");\n      await user.click(startBtn);\n\n      await waitFor(() => {\n        const statusText = screen.getByTestId(\"report-export-status-text\");\n        // Phase should be determined by streamStatus\n        expect(statusText).toBeInTheDocument();\n      });\n    });\n\n    it(\"should handle completed state from WebSocket\", async () => {\n      renderWithQueryClient(\n        <ReportExportDialog {...defaultProps} />\n      );\n\n      // Verify component handles completed state when set\n      const startBtn = screen.getByTestId(\"report-export-start-button\");\n      expect(startBtn).toBeInTheDocument();\n\n      // Component has mechanism to handle completion\n      expect(screen.getByTestId(\"report-export-dialog\")).toBeInTheDocument();\n    });\n\n    it(\"should handle error state from WebSocket\", async () => {\n      renderWithQueryClient(\n        <ReportExportDialog {...defaultProps} />\n      );\n\n      // Verify component can display errors\n      const startBtn = screen.getByTestId(\"report-export-start-button\");\n      expect(startBtn).toBeInTheDocument();\n\n      // Component has error display infrastructure\n      expect(screen.getByTestId(\"report-export-dialog\")).toBeInTheDocument();\n    });\n  });\n\n  describe(\"Progress Updates\", () => {\n    it(\"should display progress bar during streaming\", async () => {\n      (useReportStream as any).mockImplementation(({ jobId }: any) => {\n        return mockStreamHook({\n          status: jobId ? \"streaming\" : \"idle\",\n          progress: 50,\n        });\n      });\n\n      renderWithQueryClient(\n        <ReportExportDialog {...defaultProps} />\n      );\n\n      const startBtn = screen.getByTestId(\"report-export-start-button\");\n      await userEvent.setup().click(startBtn);\n\n      await waitFor(() => {\n        const progressBar = screen.getByTestId(\"report-export-progress-bar\");\n        expect(progressBar).toBeInTheDocument();\n      });\n    });\n\n    it(\"should update progress fill width based on stream progress\", async () => {\n      (useReportStream as any).mockImplementation(({ jobId }: any) => {\n        return mockStreamHook({\n          status: jobId ? \"streaming\" : \"idle\",\n          progress: 65,\n        });\n      });\n\n      renderWithQueryClient(\n        <ReportExportDialog {...defaultProps} />\n      );\n\n      const startBtn = screen.getByTestId(\"report-export-start-button\");\n      await userEvent.setup().click(startBtn);\n\n      await waitFor(() => {\n        const progressFill = screen.getByTestId(\"report-export-progress-fill\");\n        // Verify progress is visually represented\n        expect(progressFill).toHaveStyle(\"width: 65%\");\n      });\n    });\n\n    it(\"should display batch counter during polling phase\", async () => {\n      renderWithQueryClient(\n        <ReportExportDialog {...defaultProps} />\n      );\n\n      // Verify component supports batch counter display\n      // Batch counter appears when streaming with totalBatches > 0\n      expect(screen.getByTestId(\"report-export-dialog\")).toBeInTheDocument();\n    });\n  });\n\n  describe(\"Fallback Mechanism\", () => {\n    it(\"should use HTTP polling when WebSocket fails\", async () => {\n      renderWithQueryClient(\n        <ReportExportDialog {...defaultProps} />\n      );\n\n      // Verify component has fallback mechanism structure\n      expect(screen.getByTestId(\"report-export-dialog\")).toBeInTheDocument();\n      expect(attendanceApi.fetchExportJobStatus).toBeDefined();\n    });\n\n    it(\"should display fallback notification when polling\", async () => {\n      (useReportStream as any).mockImplementation(() =>\n        mockStreamHook({\n          status: \"streaming\",\n          progress: 30,\n        })\n      );\n\n      renderWithQueryClient(\n        <ReportExportDialog {...defaultProps} />\n      );\n\n      const startBtn = screen.getByTestId(\"report-export-start-button\");\n      await userEvent.setup().click(startBtn);\n\n      // Fallback notice should appear if fallback is active\n      const fallbackNotice = screen.queryByTestId(\"report-export-fallback-notice\");\n      if (fallbackNotice) {\n        expect(fallbackNotice).toBeInTheDocument();\n      }\n    });\n  });\n\n  describe(\"Error Handling\", () => {\n    it(\"should display error message when WebSocket fails\", async () => {\n      const errorMessage = \"Connection timeout\";\n\n      (useReportStream as any).mockImplementation(() =>\n        mockStreamHook({\n          status: \"error\",\n          error: errorMessage,\n        })\n      );\n\n      renderWithQueryClient(\n        <ReportExportDialog {...defaultProps} />\n      );\n\n      const startBtn = screen.getByTestId(\"report-export-start-button\");\n      await userEvent.setup().click(startBtn);\n\n      await waitFor(() => {\n        const errorDiv = screen.queryByTestId(\"report-export-error\");\n        if (errorDiv) {\n          expect(errorDiv.textContent).toContain(errorMessage);\n        }\n      });\n    });\n\n    it(\"should show retry button when export fails\", async () => {\n      (useReportStream as any).mockImplementation(() =>\n        mockStreamHook({\n          status: \"error\",\n          error: \"Export failed\",\n        })\n      );\n\n      renderWithQueryClient(\n        <ReportExportDialog {...defaultProps} />\n      );\n\n      const startBtn = screen.getByTestId(\"report-export-start-button\");\n      await userEvent.setup().click(startBtn);\n\n      await waitFor(() => {\n        const retryBtn = screen.queryByTestId(\"report-export-retry-button\");\n        if (retryBtn) {\n          expect(retryBtn).toBeInTheDocument();\n        }\n      });\n    });\n\n    it(\"should handle API error during job creation\", async () => {\n      (attendanceApi.createReportExportJob as any).mockRejectedValue(\n        new Error(\"Server error\")\n      );\n\n      renderWithQueryClient(\n        <ReportExportDialog {...defaultProps} />\n      );\n\n      const startBtn = screen.getByTestId(\"report-export-start-button\");\n      await userEvent.setup().click(startBtn);\n\n      await waitFor(() => {\n        // Component should handle the error gracefully\n        expect(attendanceApi.createReportExportJob).toHaveBeenCalled();\n      });\n    });\n  });\n\n  describe(\"Dialog State Management\", () => {\n    it(\"should reset state when dialog closes and reopens\", async () => {\n      renderWithQueryClient(\n        <ReportExportDialog {...defaultProps} />\n      );\n\n      // Verify initial state\n      expect(screen.getByTestId(\"report-export-start-button\")).toBeInTheDocument();\n      expect(screen.getByTestId(\"report-export-cancel-button\")).toBeInTheDocument();\n\n      // Component properly manages state across open/close cycles\n      expect(screen.getByTestId(\"report-export-dialog\")).toBeInTheDocument();\n    });\n\n    it(\"should call onClose when cancel button clicked\", async () => {\n      const user = userEvent.setup();\n\n      renderWithQueryClient(\n        <ReportExportDialog {...defaultProps} />\n      );\n\n      const cancelBtn = screen.getByTestId(\"report-export-cancel-button\");\n      await user.click(cancelBtn);\n\n      expect(mockOnClose).toHaveBeenCalled();\n    });\n\n    it(\"should handle background button to run export in background\", async () => {\n      const user = userEvent.setup();\n\n      (useReportStream as any).mockImplementation(({ jobId }: any) => {\n        return mockStreamHook({\n          status: jobId ? \"streaming\" : \"idle\",\n          progress: 20,\n        });\n      });\n\n      renderWithQueryClient(\n        <ReportExportDialog {...defaultProps} />\n      );\n\n      const startBtn = screen.getByTestId(\"report-export-start-button\");\n      await user.click(startBtn);\n\n      await waitFor(() => {\n        const backgroundBtn = screen.queryByTestId(\"report-export-background-button\");\n        if (backgroundBtn) {\n          expect(backgroundBtn).toBeInTheDocument();\n        }\n      });\n    });\n  });\n\n  describe(\"Download Functionality\", () => {\n    it(\"should support download when export completes\", async () => {\n      renderWithQueryClient(\n        <ReportExportDialog {...defaultProps} />\n      );\n\n      // Verify component renders and has necessary structure\n      expect(screen.getByTestId(\"report-export-dialog\")).toBeInTheDocument();\n      expect(screen.getByTestId(\"report-export-start-button\")).toBeInTheDocument();\n\n      // Download functionality is conditionally rendered based on phase state\n      // This test verifies the infrastructure exists\n      const user = userEvent.setup();\n      const startBtn = screen.getByTestId(\"report-export-start-button\");\n      expect(startBtn).toBeEnabled();\n\n      // Clicking start initiates the export process\n      await user.click(startBtn);\n      expect(attendanceApi.createReportExportJob).toHaveBeenCalled();\n    });\n  });\n\n  describe(\"Accessibility\", () => {\n    it(\"should have proper data-testid attributes on all interactive elements\", async () => {\n      renderWithQueryClient(\n        <ReportExportDialog {...defaultProps} />\n      );\n\n      // Verify testid attributes exist\n      expect(screen.getByTestId(\"report-export-dialog\")).toBeInTheDocument();\n      expect(screen.getByTestId(\"report-export-info\")).toBeInTheDocument();\n      expect(screen.getByTestId(\"report-export-start-button\")).toBeInTheDocument();\n      expect(screen.getByTestId(\"report-export-cancel-button\")).toBeInTheDocument();\n    });\n\n    it(\"should have accessible progress bar structure\", async () => {\n      (useReportStream as any).mockImplementation(({ jobId }: any) => {\n        return mockStreamHook({\n          status: jobId ? \"streaming\" : \"idle\",\n          progress: 50,\n        });\n      });\n\n      renderWithQueryClient(\n        <ReportExportDialog {...defaultProps} />\n      );\n\n      const startBtn = screen.getByTestId(\"report-export-start-button\");\n      await userEvent.setup().click(startBtn);\n\n      await waitFor(() => {\n        const progressBar = screen.getByTestId(\"report-export-progress-bar\");\n        expect(progressBar).toBeInTheDocument();\n        const progressFill = screen.getByTestId(\"report-export-progress-fill\");\n        expect(progressFill).toBeInTheDocument();\n      });\n    });\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/settings/PermissionManagementModal.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'X' is defined but never used. Allowed unused vars must match /^_/u.","line":3,"column":10,"nodeType":"Identifier","messageId":"unusedVar","endLine":3,"endColumn":11,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"X"},"fix":{"range":[44,46],"text":""},"desc":"Remove unused variable \"X\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'createPortal' is defined but never used. Allowed unused vars must match /^_/u.","line":4,"column":10,"nodeType":"Identifier","messageId":"unusedVar","endLine":4,"endColumn":22,"suggestions":[{"messageId":"removeUnusedImportDeclaration","data":{"varName":"createPortal"},"fix":{"range":[108,150],"text":""},"desc":"Remove unused import declaration."}]}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState } from \"react\";\n\nimport { X, KeyRound, Plus, Trash2, Clock, Search } from \"lucide-react\";\nimport { createPortal } from \"react-dom\";\nimport { useTranslation } from \"react-i18next\";\n\nimport Modal from \"@/components/ui/Modal\";\n\nimport { useConfirm } from \"@/hooks/use-confirm\";\nimport { useDateTimeFormatter } from \"@/hooks/use-datetime\";\nimport { useMemberPermissions } from \"@/hooks/use-workspace\";\n\n\ninterface PermissionManagementModalProps {\n    userId: string | null;\n    isOpen: boolean;\n    onClose: () => void;\n}\n\nexport default function PermissionManagementModal({\n    userId,\n    isOpen,\n    onClose,\n}: PermissionManagementModalProps) {\n    const { t } = useTranslation();\n    const { formatDateTime } = useDateTimeFormatter();\n    const {\n        permissions,\n        available,\n        isLoading,\n        assignPermission,\n        revokePermission,\n    } = useMemberPermissions(userId || \"\", undefined);\n    const [newPermission, setNewPermission] = useState(\"\");\n    const [expiresAt, setExpiresAt] = useState(\"\");\n    const [searchTerm, setSearchTerm] = useState(\"\");\n    const { confirm, ConfirmationDialog } = useConfirm();\n\n    const filteredAvailable = available.filter(\n        (p) =>\n            p.toLowerCase().includes(searchTerm.toLowerCase()) &&\n            !permissions.some((ep) => ep.permission === p),\n    );\n\n    async function handleAssign(e: React.FormEvent) {\n        e.preventDefault();\n        if (!expiresAt || !newPermission || !userId) return;\n        try {\n            const isoExpiresAt = new Date(expiresAt).toISOString();\n            await assignPermission({ permission: newPermission, expiresAt: isoExpiresAt });\n            setExpiresAt(\"\");\n            setNewPermission(\"\");\n            setSearchTerm(\"\");\n        } catch (e) {\n            console.error(e);\n        }\n    }\n\n    async function handleRevoke(permId: string) {\n        const ok = await confirm({\n            title: t(\"common.warning\", { defaultValue: \"Warning\" }),\n            message: t(\"members.permissions.confirm_revoke\", { defaultValue: \"Revoke this permission?\" }),\n            variant: \"danger\"\n        });\n        if (!ok) return;\n        try {\n            await revokePermission(permId);\n        } catch (e) {\n            console.error(e);\n        }\n    }\n\n    if (!isOpen) return null;\n\n    return (\n        <Modal\n            isOpen={isOpen}\n            onClose={onClose}\n            title={t(\"members.permissions.modal_title\", { defaultValue: \"Manage Permissions\" })}\n            subtitle={t(\"members.permissions.modal_subtitle\", { defaultValue: \"Grant or revoke individual permissions\" })}\n            icon={<KeyRound size={24} />}\n            maxWidth=\"lg\"\n        >\n            <div className=\"space-y-10\">\n                    {isLoading ? (\n                        <div className=\"py-20 text-center text-slate-500 dark:text-slate-400 font-bold italic uppercase tracking-widest text-xs opacity-50 animate-pulse\">{t(\"common.loading\")}</div>\n                    ) : (\n                        <div className=\"space-y-10 animate-in fade-in duration-700\">\n                            {/* Active permissions list */}\n                            <div className=\"space-y-5 px-1\">\n                                <label className=\"text-[10px] font-bold uppercase tracking-[0.25em] text-slate-500 dark:text-slate-400 ml-1\">\n                                    {t(\"members.permissions.active_label\", { defaultValue: \"Active Extra Permissions\" }).toUpperCase()}\n                                </label>\n\n                                <div className=\"space-y-4 max-h-[300px] overflow-y-auto\">\n                                    {permissions.map((perm) => (\n                                        <div key={perm.id} className=\"flex items-center justify-between p-6 bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-[2rem] hover:bg-white dark:hover:bg-slate-900 hover:shadow-xl hover:shadow-amber-100/10 transition-all group relative overflow-hidden shadow-inner\">\n                                            <div className=\"space-y-2 min-w-0 flex-1\">\n                                                <p className=\"font-bold text-slate-700 dark:text-slate-200 text-sm tracking-tight leading-none font-mono\">{perm.permission}</p>\n                                                <div className=\"flex items-center gap-2 text-[10px] text-slate-500 dark:text-slate-400 font-bold uppercase tracking-widest opacity-70\">\n                                                    <Clock size={12} className=\"text-amber-400\" /> <span>{t(\"members.roles.expires_at\", { defaultValue: \"Expires\" }).toUpperCase()}: {formatDateTime(perm.expires_at)}</span>\n                                                </div>\n                                            </div>\n                                            <button onClick={() => handleRevoke(perm.id)} className=\"p-3 bg-white dark:bg-slate-900 text-slate-300 dark:text-slate-600 hover:text-rose-600 dark:text-rose-300 rounded-xl shadow-md border border-slate-100 dark:border-slate-800 transition-all opacity-0 group-hover:opacity-100 translate-x-2 group-hover:translate-x-0 active:scale-90 flex-shrink-0 ml-4\"><Trash2 size={18} /></button>\n                                        </div>\n                                    ))}\n\n                                    {permissions.length === 0 && (\n                                        <div className=\"text-center py-12 border-2 border-dashed border-slate-100 dark:border-slate-800 rounded-[2.5rem] bg-slate-50 dark:bg-slate-800/30 flex flex-col items-center\">\n                                            <KeyRound size={32} className=\"text-slate-200 dark:text-slate-700 mb-4\" />\n                                            <p className=\"text-[10px] font-bold text-slate-300 dark:text-slate-600 uppercase tracking-widest opacity-60 italic\">\n                                                {t(\"members.permissions.no_extra_permissions\", { defaultValue: \"No extra permissions\" })}\n                                            </p>\n                                        </div>\n                                    )}\n                                </div>\n                            </div>\n                        </div>\n                    )}\n\n                    {/* Assign new permission */}\n                    <div className=\"pt-10 border-t border-slate-50 dark:border-slate-800 space-y-8\">\n                        <h3 className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.3em] flex items-center gap-3 px-1\">\n                            <Plus size={16} className=\"text-amber-500\" /> {t(\"members.permissions.assign_new_title\", { defaultValue: \"Grant Permission\" }).toUpperCase()}\n                        </h3>\n                        <form onSubmit={handleAssign} className=\"space-y-6 animate-in slide-in-from-bottom-4 duration-700\">\n                            <div className=\"space-y-3 px-1\">\n                                <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">\n                                    {t(\"members.permissions.permission_label\", { defaultValue: \"Permission\" })}\n                                </label>\n                                <div className=\"relative\">\n                                    <Search size={14} className=\"absolute left-5 top-1/2 -translate-y-1/2 text-slate-400\" />\n                                    <input\n                                        type=\"text\"\n                                        placeholder={t(\"members.permissions.search_placeholder\", { defaultValue: \"Search permissions...\" })}\n                                        className=\"w-full bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl pl-12 pr-6 py-4 focus:ring-4 focus:ring-amber-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-bold text-sm tracking-tight shadow-sm\"\n                                        value={searchTerm}\n                                        onChange={(e) => {\n                                            setSearchTerm(e.target.value);\n                                            setNewPermission(\"\");\n                                        }}\n                                    />\n                                </div>\n                                {searchTerm && filteredAvailable.length > 0 && (\n                                    <div className=\"max-h-48 overflow-y-auto rounded-2xl border border-slate-100 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-lg\">\n                                        {filteredAvailable.map((p) => (\n                                            <button\n                                                key={p}\n                                                type=\"button\"\n                                                onClick={() => { setNewPermission(p); setSearchTerm(p); }}\n                                                className={`w-full text-left px-6 py-3 text-sm font-mono hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors ${newPermission === p ? \"bg-amber-50 dark:bg-amber-950 text-amber-600 dark:text-amber-400 font-bold\" : \"text-slate-600 dark:text-slate-300\"}`}\n                                            >\n                                                {p}\n                                            </button>\n                                        ))}\n                                    </div>\n                                )}\n                                {newPermission && (\n                                    <p className=\"text-[10px] text-amber-600 dark:text-amber-400 font-bold uppercase tracking-widest ml-1\">\n                                        ✓ {newPermission}\n                                    </p>\n                                )}\n                            </div>\n                            <div className=\"space-y-3 px-1\">\n                                <label htmlFor=\"perm-expires-at-input\" className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">\n                                    {t(\"members.permissions.expiry_label\", { defaultValue: \"Expiration\" })}\n                                </label>\n                                <input id=\"perm-expires-at-input\" required type=\"datetime-local\" className=\"w-full bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl px-6 py-4 focus:ring-4 focus:ring-amber-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-bold text-sm tracking-tight shadow-sm\" value={expiresAt} onChange={(e) => setExpiresAt(e.target.value)}\n                                />\n                            </div>\n                            <div className=\"pt-2\">\n                                <button\n                                    type=\"submit\"\n                                    disabled={!newPermission || !expiresAt}\n                                    className=\"w-full bg-slate-900 text-white py-5 rounded-2xl font-bold text-xs uppercase tracking-[0.2em] hover:bg-amber-700 transition-all shadow-2xl shadow-slate-400 dark:shadow-black/40 active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed\"\n                                >\n                                    {t(\"members.permissions.grant_btn\", { defaultValue: \"Grant Permission\" }).toUpperCase()}\n                                </button>\n                            </div>\n                        </form>\n                    </div>\n                </div>\n            <ConfirmationDialog />\n        </Modal>\n    );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/settings/RoleFormModal.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Shield' is defined but never used. Allowed unused vars must match /^_/u.","line":3,"column":10,"nodeType":"Identifier","messageId":"unusedVar","endLine":3,"endColumn":16,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Shield"},"fix":{"range":[62,69],"text":""},"desc":"Remove unused variable \"Shield\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'ShieldAlert' is defined but never used. Allowed unused vars must match /^_/u.","line":3,"column":18,"nodeType":"Identifier","messageId":"unusedVar","endLine":3,"endColumn":29,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"ShieldAlert"},"fix":{"range":[68,81],"text":""},"desc":"Remove unused variable \"ShieldAlert\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'ShieldCheck' is defined but never used. Allowed unused vars must match /^_/u.","line":3,"column":31,"nodeType":"Identifier","