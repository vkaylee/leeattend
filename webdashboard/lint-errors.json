bersQuery.isLoading,\n    addMember: addMemberMutation.mutateAsync,\n    isAdding: addMemberMutation.isPending,\n    removeMember: removeMemberMutation.mutateAsync,\n    isRemoving: removeMemberMutation.isPending,\n  };\n}\n\nexport function useMemberRoles(userId: string, wsId?: string) {\n  const queryClient = useQueryClient();\n  const activeWsId = wsId || getCurrentWorkspaceId();\n\n  const rolesQuery = useQuery({\n    queryKey: workspaceKeys.roles(activeWsId || \"\", userId),\n    queryFn: () => fetchMemberRoles(activeWsId!, userId),\n    enabled: !!activeWsId && !!userId,\n  });\n\n  const updatePrimaryRoleMutation = useMutation({\n    mutationFn: (role: string) =>\n      updateWorkspaceMemberRole(activeWsId!, userId, role),\n    onSuccess: () => {\n      queryClient.invalidateQueries({\n        queryKey: workspaceKeys.roles(activeWsId!, userId),\n      });\n      queryClient.invalidateQueries({\n        queryKey: workspaceKeys.members(activeWsId!),\n      });\n    },\n  });\n\n  const assignRoleMutation = useMutation({\n    mutationFn: ({ role, expiresAt }: { role: string; expiresAt: string }) =>\n      assignExtraRole(activeWsId!, userId, role, expiresAt),\n    onSuccess: () => {\n      queryClient.invalidateQueries({\n        queryKey: workspaceKeys.roles(activeWsId!, userId),\n      });\n    },\n  });\n\n  const revokeRoleMutation = useMutation({\n    mutationFn: (roleId: string) =>\n      revokeExtraRole(activeWsId!, userId, roleId),\n    onSuccess: () => {\n      queryClient.invalidateQueries({\n        queryKey: workspaceKeys.roles(activeWsId!, userId),\n      });\n    },\n  });\n\n  return {\n    roles: rolesQuery.data,\n    isLoading: rolesQuery.isLoading,\n    updatePrimaryRole: updatePrimaryRoleMutation.mutateAsync,\n    assignRole: assignRoleMutation.mutateAsync,\n    revokeRole: revokeRoleMutation.mutateAsync,\n  };\n}\n\nexport function useMemberPermissions(userId: string, wsId?: string) {\n  const queryClient = useQueryClient();\n  const activeWsId = wsId || getCurrentWorkspaceId();\n\n  const permissionsQuery = useQuery({\n    queryKey: workspaceKeys.permissions(activeWsId || \"\", userId),\n    queryFn: () => fetchMemberPermissions(activeWsId!, userId),\n    enabled: !!activeWsId && !!userId,\n  });\n\n  const availableQuery = useQuery({\n    queryKey: workspaceKeys.availablePermissions(activeWsId || \"\"),\n    queryFn: () => fetchAvailablePermissions(activeWsId!),\n    enabled: !!activeWsId,\n  });\n\n  const assignMutation = useMutation({\n    mutationFn: ({ permission, expiresAt }: { permission: string; expiresAt: string }) =>\n      assignExtraPermission(activeWsId!, userId, permission, expiresAt),\n    onSuccess: () => {\n      queryClient.invalidateQueries({\n        queryKey: workspaceKeys.permissions(activeWsId!, userId),\n      });\n    },\n  });\n\n  const revokeMutation = useMutation({\n    mutationFn: (permId: string) =>\n      revokeExtraPermission(activeWsId!, userId, permId),\n    onSuccess: () => {\n      queryClient.invalidateQueries({\n        queryKey: workspaceKeys.permissions(activeWsId!, userId),\n      });\n    },\n  });\n\n  return {\n    permissions: permissionsQuery.data ?? [],\n    available: availableQuery.data ?? [],\n    isLoading: permissionsQuery.isLoading,\n    assignPermission: assignMutation.mutateAsync,\n    isAssigning: assignMutation.isPending,\n    revokePermission: revokeMutation.mutateAsync,\n    isRevoking: revokeMutation.isPending,\n  };\n}\n\nexport function useRolePermissions(roleId: string, wsId?: string) {\n  const queryClient = useQueryClient();\n  const activeWsId = wsId || getCurrentWorkspaceId();\n\n  const permissionsQuery = useQuery({\n    queryKey: workspaceKeys.rolePermissions(activeWsId || \"\", roleId),\n    queryFn: () => fetchRolePermissions(activeWsId!, roleId),\n    enabled: !!activeWsId && !!roleId,\n  });\n\n  const updateMutation = useMutation({\n    mutationFn: (permissions: string[]) => updateRolePermissions(activeWsId!, roleId, permissions),\n    onSuccess: () => {\n      queryClient.invalidateQueries({\n        queryKey: workspaceKeys.rolePermissions(activeWsId!, roleId),\n      });\n    },\n  });\n\n  return {\n    permissions: permissionsQuery.data ?? [],\n    isLoading: permissionsQuery.isLoading,\n    updatePermissions: updateMutation.mutateAsync,\n    isUpdating: updateMutation.isPending,\n  };\n}\n\nexport function useWorkspacePermissionsMatrix(wsId?: string) {\n  const activeWsId = wsId || getCurrentWorkspaceId();\n  const { roles } = useWorkspaceRoles(activeWsId ?? undefined);\n\n  const roleIds = roles.map(r => r.id).sort().join(',');\n\n  const matrixQuery = useQuery({\n    queryKey: [...workspaceKeys.permissionsMatrix(activeWsId || \"\"), roleIds],\n    queryFn: async () => {\n      const matrix: Record<string, string[]> = {};\n      await Promise.all(roles.map(async (role) => {\n        try {\n          const perms = await fetchRolePermissions(activeWsId!, role.id);\n          matrix[role.id] = perms;\n        } catch (e) {\n          matrix[role.id] = [];\n        }\n      }));\n      return matrix;\n    },\n    enabled: !!activeWsId && roles.length > 0,\n  });\n\n  return {\n    matrix: matrixQuery.data ?? {},\n    isLoading: matrixQuery.isLoading,\n    refetch: matrixQuery.refetch,\n  };\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/hooks/useTickingDeviceTime.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/i18n/__tests__/locales.test.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":7,"column":36,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":7,"endColumn":39,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[195,198],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[195,198],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { describe, it, expect } from 'vitest';\n\nimport en from '../locales/en.json';\nimport vi from '../locales/vi.json';\nimport zh from '../locales/zh.json';\n\ntype JsonObject = { [key: string]: any };\n\nfunction getAllKeys(obj: JsonObject, prefix = ''): string[] {\n  return Object.keys(obj).reduce((keys: string[], key: string) => {\n    const value = obj[key];\n    const newPrefix = prefix ? `${prefix}.${key}` : key;\n\n    if (value && typeof value === 'object' && !Array.isArray(value)) {\n      return [...keys, ...getAllKeys(value, newPrefix)];\n    }\n\n    return [...keys, newPrefix];\n  }, []);\n}\n\ndescribe('i18n Locales Synchronization', () => {\n  const locales = {\n    vi,\n    en,\n    zh\n  };\n\n  const localeKeys = {\n    vi: getAllKeys(vi),\n    en: getAllKeys(en),\n    zh: getAllKeys(zh)\n  };\n\n  const allLanguages = Object.keys(locales) as (keyof typeof locales)[];\n\n  allLanguages.forEach((sourceLang) => {\n    allLanguages.forEach((targetLang) => {\n      if (sourceLang === targetLang) return;\n\n      it(`should have all keys from ${sourceLang} present in ${targetLang}`, () => {\n        const sourceKeys = localeKeys[sourceLang];\n        const targetKeys = localeKeys[targetLang];\n\n        const missingKeys = sourceKeys.filter(key => !targetKeys.includes(key));\n\n        if (missingKeys.length > 0) {\n          console.error(`Missing keys in ${targetLang} (present in ${sourceLang}):`, missingKeys);\n        }\n\n        expect(missingKeys, `Missing keys in ${targetLang} that exist in ${sourceLang}`).toEqual([]);\n      });\n    });\n  });\n\n  it('all locale files should have the same number of keys', () => {\n    const counts = {\n      vi: localeKeys.vi.length,\n      en: localeKeys.en.length,\n      zh: localeKeys.zh.length\n    };\n\n    expect(counts.en, 'English should match Vietnamese key count').toBe(counts.vi);\n    expect(counts.zh, 'Chinese should match Vietnamese key count').toBe(counts.vi);\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/i18n/__tests__/translation-usage.test.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":10,"column":36,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":10,"endColumn":39,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[242,245],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[242,245],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import fs from 'fs';\nimport path from 'path';\n\nimport { describe, it, expect } from 'vitest';\n\nimport en from '../locales/en.json';\nimport vi from '../locales/vi.json';\nimport zh from '../locales/zh.json';\n\ntype JsonObject = { [key: string]: any };\n\nconst locales = { en, vi, zh };\n\nconst KEY_WHITELIST = [\n  'common.languages.', // Dynamic language keys\n];\n\nfunction getAllKeys(obj: JsonObject, prefix = ''): { key: string; value: string }[] {\n  return Object.keys(obj).reduce((keys: { key: string; value: string }[], key: string) => {\n    const value = obj[key];\n    const newPrefix = prefix ? `${prefix}.${key}` : key;\n\n    if (value && typeof value === 'object' && !Array.isArray(value)) {\n      return [...keys, ...getAllKeys(value, newPrefix)];\n    }\n\n    if (typeof value === 'string') {\n      keys.push({ key: newPrefix, value });\n    }\n    return keys;\n  }, []);\n}\n\nfunction getFilesRecursively(dir: string, fileList: string[] = []): string[] {\n  const files = fs.readdirSync(dir);\n  files.forEach((file) => {\n    const filePath = path.join(dir, file);\n    const stat = fs.statSync(filePath);\n    if (stat.isDirectory()) {\n      if (file !== 'node_modules' && file !== '__tests__' && file !== 'i18n' && file !== 'test' && file !== 'dist') {\n        getFilesRecursively(filePath, fileList);\n      }\n    } else if ((file.endsWith('.ts') || file.endsWith('.tsx')) && !file.endsWith('.test.ts') && !file.endsWith('.test.tsx')) {\n      fileList.push(filePath);\n    }\n  });\n  return fileList;\n}\n\nconst localeData: Record<string, { key: string; value: string }[]> = {\n  en: getAllKeys(en),\n  vi: getAllKeys(vi),\n  zh: getAllKeys(zh),\n};\n\nconst localeKeySets: Record<string, Set<string>> = {\n  en: new Set(localeData.en.map(d => d.key)),\n  vi: new Set(localeData.vi.map(d => d.key)),\n  zh: new Set(localeData.zh.map(d => d.key)),\n};\n\ndescribe('Translation Usage', () => {\n  it('all translation keys used in the code should exist in all locale files', () => {\n    const srcDir = path.resolve(__dirname, '../..'); // webdashboard/src\n    const files = getFilesRecursively(srcDir);\n\n    const missingKeys: { file: string; key: string; lang: string }[] = [];\n    const tRegex = /\\b(?:t|i18n\\.t)\\s*\\(\\s*['\"]([^'\"]+)['\"]/g;\n\n    files.forEach((file) => {\n      const content = fs.readFileSync(file, 'utf-8');\n      let match;\n\n      while ((match = tRegex.exec(content)) !== null) {\n        const key = match[1];\n        if (key.includes('${') || key.includes('+')) continue;\n\n        // Check whitelist\n        if (KEY_WHITELIST.some(w => key.startsWith(w))) continue;\n\n        Object.keys(localeKeySets).forEach(lang => {\n          if (!localeKeySets[lang].has(key)) {\n            const relativePath = path.relative(path.resolve(__dirname, '../../..'), file);\n            missingKeys.push({ file: relativePath, key, lang });\n          }\n        });\n      }\n    });\n\n    if (missingKeys.length > 0) {\n      console.error('Found translation keys in code that are missing from locale files:');\n      const grouped = missingKeys.reduce((acc, { file, key, lang }) => {\n        const fileKey = `${file} [${lang}]`;\n        if (!acc[fileKey]) acc[fileKey] = [];\n        acc[fileKey].push(key);\n        return acc;\n      }, {} as Record<string, string[]>);\n\n      Object.entries(grouped).forEach(([fileLang, keys]) => {\n        console.error(`  ${fileLang}: ${Array.from(new Set(keys)).sort().join(', ')}`);\n      });\n    }\n\n    fs.writeFileSync('missing-keys.json', JSON.stringify(missingKeys, null, 2));\n    expect(missingKeys.length, `Found ${missingKeys.length} missing translation keys across all languages.`).toBe(0);\n  });\n\n  it('should not have untranslated keys (value matches key name)', () => {\n    const untranslated: { lang: string; key: string }[] = [];\n\n    Object.entries(localeData).forEach(([lang, data]) => {\n      data.forEach(({ key, value }) => {\n        // Only check long keys that look like paths, or keys that are likely auto-generated\n        if (key.includes('.') && key === value) {\n          untranslated.push({ lang, key });\n        }\n      });\n    });\n\n    if (untranslated.length > 0) {\n      console.warn('Found potentially untranslated keys (value equals key path):');\n      untranslated.forEach(({ lang, key }) => {\n        console.warn(`  [${lang}] ${key}`);\n      });\n    }\n\n    // We keep this as a warning for now\n    // expect(untranslated.length).toBe(0);\n  });\n\n  it('should not have hardcoded strings in JSX', () => {\n    const srcDir = path.resolve(__dirname, '../..'); // webdashboard/src\n    const files = getFilesRecursively(srcDir);\n\n    const hardcodedStrings: { file: string; line: number; text: string }[] = [];\n\n    const textNodeRegex = />([^<>{}\\n\\s][^<>{}\\n]*[^<>{}\\n\\s])</g;\n    const attrRegex = /\\b(placeholder|title|label)\\s*=\\s*['\"]([^'\"]+)['\"]/g;\n\n    files.forEach((file) => {\n      if (file.includes('lib/api') || file.includes('lib/utils') || file.includes('DebugToolbar')) return;\n\n      const content = fs.readFileSync(file, 'utf-8');\n      const lines = content.split('\\n');\n\n      lines.forEach((line, index) => {\n        if (line.trim().startsWith('import') || line.trim().startsWith('//') || line.includes('t(')) return;\n        // Skip common UI primitives that might have hardcoded classes or icons\n        if (line.includes('<path') || line.includes('<svg')) return;\n\n        let match;\n        while ((match = textNodeRegex.exec(line)) !== null) {\n          const text = match[1].trim();\n          if (text.length > 2 && /[a-zA-Z]/.test(text)) {\n            // Filter out common non-translatable things\n            if (/^[A-Z0-9_-]+$/.test(text)) return; // Likely a constant or ID\n            if (text.startsWith('data-')) return;\n            // Brand names and technical identifiers\n            if (['Lee', 'Attend', 'ID:'].includes(text)) return;\n\n            hardcodedStrings.push({ file, line: index + 1, text });\n          }\n        }\n\n        while ((match = attrRegex.exec(line)) !== null) {\n          const text = match[2].trim();\n          if (text.length > 2 && /[a-zA-Z]/.test(text)) {\n            hardcodedStrings.push({ file, line: index + 1, text });\n          }\n        }\n      });\n    });\n\n    if (hardcodedStrings.length > 0) {\n      const relative = (p: string) => path.relative(path.resolve(__dirname, '../../..'), p);\n      console.error(`Found ${hardcodedStrings.length} potential hardcoded strings:`);\n      hardcodedStrings.slice(0, 20).forEach(({ file, line, text }) => {\n        console.error(`  ${relative(file)}:${line}: \"${text}\"`);\n      });\n    }\n\n    // Fail if we find too many (e.g. > 50) or if we want to be strict\n    expect(hardcodedStrings.length).toBeLessThan(250);\n  });\n\n  it('all locale files should have the exact same set of keys', () => {\n    const allKeys = new Set([\n      ...localeKeySets.en,\n      ...localeKeySets.vi,\n      ...localeKeySets.zh,\n    ]);\n\n    const mismatches: { lang: string; missing: string[] }[] = [];\n\n    Object.keys(locales).forEach(lang => {\n      const currentKeys = localeKeySets[lang];\n      const missing = Array.from(allKeys).filter(k => !currentKeys.has(k));\n\n      if (missing.length > 0) {\n        mismatches.push({ lang, missing });\n      }\n    });\n\n    if (mismatches.length > 0) {\n      console.error('Locale files are not synchronized:');\n      mismatches.forEach(({ lang, missing }) => {\n        console.error(`  [${lang}] is missing ${missing.length} keys: ${missing.slice(0, 5).join(', ')}...`);\n      });\n    }\n\n    expect(mismatches.length, 'Locale files should be 100% synchronized').toBe(0);\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/i18n/config.ts","messages":[{"ruleId":"import-x/no-named-as-default","severity":1,"message":"Using exported name 'i18n' as identifier for default export.","line":1,"column":8,"nodeType":"ImportDefaultSpecifier","messageId":"default","endLine":1,"endColumn":12},{"ruleId":"import-x/no-named-as-default-member","severity":1,"message":"Caution: `i18n` also has a named export `use`. Check if you meant to write `import {use} from 'i18next'` instead.","line":20,"column":1,"nodeType":"MemberExpression","messageId":"member","endLine":21,"endColumn":7}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import i18n from 'i18next';\nimport LanguageDetector from 'i18next-browser-languagedetector';\nimport { initReactI18next } from 'react-i18next';\n\nconst localeLoaders: Record<string, () => Promise<{ default: Record<string, unknown> }>> = {\n  en: () => import('./locales/en.json'),\n  vi: () => import('./locales/vi.json'),\n  zh: () => import('./locales/zh.json'),\n};\n\nconst loadedLanguages = new Set<string>();\n\nasync function loadLocale(lng: string) {\n  if (loadedLanguages.has(lng) || !localeLoaders[lng]) return;\n  loadedLanguages.add(lng);\n  const mod = await localeLoaders[lng]();\n  i18n.addResourceBundle(lng, 'translation', mod.default || mod, true, true);\n}\n\ni18n\n  .use(LanguageDetector)\n  .use(initReactI18next)\n  .init({\n    fallbackLng: 'vi',\n    partialBundledLanguages: true,\n    interpolation: {\n      escapeValue: false,\n    },\n    detection: {\n      order: ['localStorage', 'navigator'],\n      caches: ['localStorage'],\n    },\n  });\n\nconst detected = i18n.language?.split('-')[0] || 'vi';\nloadLocale(detected);\n\ni18n.on('languageChanged', (lng) => {\n  loadLocale(lng.split('-')[0]);\n});\n\nexport default i18n;\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/lib/__tests__/api.test.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":11,"column":30,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":11,"endColumn":33,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[263,266],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[263,266],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":12,"column":15,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":12,"endColumn":18,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[292,295],"text":"unknown"},"desc":"Use `unknown` ins