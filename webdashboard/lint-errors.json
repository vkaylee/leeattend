yee created. Starting search test...');\n\n    // 3. Use the search input\n    await employeesPage.search('SearchTarget');\n\n    // 4. Verify the list is filtered\n    await employeesPage.verifyEmployeeVisible('SearchTarget');\n    \n    console.log('Search successful, target found in filtered list.');\n  });\n});","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/tests/attendance-logs.spec.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/tests/build-smoke.spec.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/tests/change-password.spec.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/tests/connectivity-buttons.spec.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'authPage' is defined but never used. Allowed unused args must match /^_/u.","line":4,"column":30,"nodeType":"Identifier","messageId":"unusedVar","endLine":4,"endColumn":38}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { test, expect } from \"./worker-orchestrator\";\n\ntest.describe(\"Connectivity Buttons Visibility Tests\", () => {\n    test.beforeEach(async ({ authPage, connectivityPage }) => {\n        // authPage fixture automatically logs in and sets up workspace\n        await connectivityPage.goto();\n        await connectivityPage.waitForLoad();\n    });\n\n    test('should show global add device button and agent-specific add device button', async ({ page, connectivityPage }) => {\n        // 1. Verify global \"Add Device\" button\n        const globalAddBtn = page.getByTestId('global-add-device-btn');\n        await expect(globalAddBtn).toBeVisible();\n        // Use regular expression to handle both languages\n        await expect(globalAddBtn).toHaveText(/add device|thêm thiết bị/i);\n\n        // 2. Check agent-specific button if agents exist\n        const agentCards = page.locator('[data-testid^=\"agent-card-\"]');\n        const agentCount = await agentCards.count();\n\n        if (agentCount > 0) {\n            const firstCard = agentCards.first();\n            const testId = await firstCard.getAttribute('data-testid') || '';\n            const agentId = testId.replace('agent-card-', '');\n\n            // Expand agent to see its inner \"Add Device\" button\n            await connectivityPage.expandAgent(agentId);\n\n            // Verify button inside card\n            const agentAddBtn = page.getByTestId(`add-device-btn-${agentId}`);\n            await expect(agentAddBtn).toBeVisible();\n            await expect(agentAddBtn).toHaveText(/add device|thêm thiết bị/i);\n        } else {\n            console.log(\"No agents found, skipping agent-specific button check\");\n        }\n    });\n\n    test('global add device button should open form if agent exists', async ({ page, connectivityPage }) => {\n        const agentsList = page.locator('[data-testid^=\"agent-card-\"]');\n        if (await agentsList.count() > 0) {\n            await connectivityPage.clickGlobalAddDevice();\n            await expect(page.getByTestId('add-device-form')).toBeVisible();\n        } else {\n            test.skip(true, 'No agents available to test global add device form');\n        }\n    });\n});\n\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/tests/debug-login.spec.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/we