 (key: string, opts?: any) => opts?.defaultValue || key,\n    }),\n}));\n\n// Mock chart components to avoid recharts SVG rendering in jsdom\nvi.mock(\"@/components/features/monitor/WorkerUtilizationGauge\", () => ({\n    default: (props: any) => <div data-testid=\"utilization-gauge\" />,\n}));\nvi.mock(\"@/components/features/monitor/QueuePressureChart\", () => ({\n    default: (props: any) => <div data-testid=\"queue-pressure-chart\" />,\n}));\nvi.mock(\"@/components/features/monitor/JobStatusDistributionChart\", () => ({\n    default: (props: any) => <div data-testid=\"job-distribution-chart\" />,\n}));\n\n// Mock data transformation hooks\nvi.mock(\"@/hooks/use-monitor-charts\", () => ({\n    useWorkerUtilization: () => ({ active: 2, idle: 1, total: 3, percent: 67 }),\n    useQueuePressure: () => ({ high: 3, low: 2, total: 5 }),\n    useJobStatusDistribution: () => [\n        { status: \"completed\", count: 1, color: \"#10b981\" },\n        { status: \"failed\", count: 1, color: \"#ef4444\" },\n    ],\n}));\n\nconst mockMonitorData = {\n    pending_tasks: 5,\n    pending_high: 3,\n    pending_low: 2,\n    total_workers: 3,\n    active_workers: 2,\n    idle_workers: 1,\n    completed_today: 42,\n    failed_today: 1,\n    workers: [\n        {\n            id: \"aabbccdd-1111-2222-3333-444455556666\",\n            host: \"worker-pod-1\",\n            status: \"PROCESSING\" as const,\n            current_task_type: \"LeaveAccrual\",\n            last_seen_at: new Date().toISOString(),\n        },\n        {\n            id: \"eeffaabb-5555-6666-7777-888899990000\",\n            host: \"worker-pod-2\",\n            status: \"IDLE\" as const,\n            current_task_type: null,\n            last_seen_at: new Date().toISOString(),\n        },\n    ],\n    recent_jobs: [\n        {\n            job_id: \"job-1111-2222-3333-444455556666\",\n            status: \"completed\" as const,\n            total_batches: 4,\n            completed_batches: 4,\n            failed_batches: 0,\n            workspace_id: \"ws-1\",\n            requester_id: \"user-1\",\n            report_type: \"summary\",\n            created_at: new Date(Date.now() - 60000).toISOString(),\n            completed_at: new Date().toISOString(),\n            error_message: null,\n        },\n        {\n            job_id: \"job-aaaa-bbbb-cccc-ddddeeeeffff\",\n            status: \"failed\" as const,\n            total_batches: 1,\n            completed_batches: 0,\n            failed_batches: 1,\n            workspace_id: \"ws-1\",\n            requester_id: \"user-1\",\n            report_type: \"summary\",\n            created_at: new Date(Date.now() - 120000).toISOString(),\n            completed_at: new Date().toISOString(),\n            error_message: \"DB connection timeout\",\n        },\n        {\n            job_id: \"job-ffff-eeee-dddd-ccccbbbbaaaa\",\n            status: \"processing\" as const,\n            total_batches: 3,\n            completed_batches: 1,\n            failed_batches: 0,\n            workspace_id: \"ws-1\",\n            requester_id: \"user-1\",\n            report_type: \"summary\",\n            created_at: new Date().toISOString(),\n            completed_at: null,\n            error_message: null,\n        },\n    ],\n};\n\nvi.mock(\"@/hooks/use-worker-monitor\", () => ({\n    MONITOR_REFETCH_INTERVAL_S: 2,\n    useWorkerMonitor: vi.fn(() => ({\n        stats: mockMonitorData,\n        workers: mockMonitorData.workers,\n        recentJobs: mockMonitorData.recent_jobs,\n        isLoading: false,\n        isFetching: false,\n        error: null,\n        refetch: vi.fn(),\n    })),\n}));\n\nimport WorkerMonitorPage from \"../WorkerMonitorPage\";\n\nfunction renderPage() {\n    const queryClient = new QueryClient({\n        defaultOptions: { queries: { retry: false } },\n    });\n    return render(\n        <QueryClientProvider client={queryClient}>\n            <WorkerMonitorPage />\n        </QueryClientProvider>\n    );\n}\n\ndescribe(\"WorkerMonitorPage\", () => {\n    beforeEach(() => {\n        vi.clearAllMocks();\n    });\n\n    // --- Stats Cards ---\n    it(\"renders stat cards with correct values\", () => {\n        renderPage();\n        expect(screen.getByText(\"42\")).toBeInTheDocument(); // completed_today (unique)\n        expect(screen.getAllByText(\"3\").length).toBeGreaterThanOrEqual(1); // pending_high\n        // Stat labels are rendered\n        expect(screen.getByText(\"monitor.pending_high\")).toBeInTheDocument();\n        expect(screen.getByText(\"monitor.pending_low\")).toBeInTheDocument();\n        expect(screen.getByText(\"monitor.active_workers\")).toBeInTheDocument();\n        expect(screen.getByText(\"monitor.completed_today\")).toBeInTheDocument();\n        expect(screen.getByText(\"monitor.failed_today\")).toBeInTheDocument();\n    });\n\n    // --- Workers Table ---\n    it(\"renders worker table with worker entries\", () => {\n        renderPage();\n        expect(screen.getByText(\"worker-pod-1\")).toBeInTheDocument();\n        expect(screen.getByText(\"worker-pod-2\")).toBeInTheDocument();\n        expect(screen.getByText(\"LeaveAccrual\")).toBeInTheDocument();\n    });\n\n    it(\"shows processing and idle status badges\", () => {\n        renderPage();\n        expect(screen.getByText(\"PROCESSING\")).toBeInTheDocument();\n        expect(screen.getByText(\"IDLE\")).toBeInTheDocument();\n    });\n\n    it(\"renders truncated worker IDs\", () => {\n        renderPage();\n        expect(screen.getByText(\"aabbccdd...\")).toBeInTheDocument();\n        expect(screen.getByText(\"eeffaabb...\")).toBeInTheDocument();\n    });\n\n    // --- Recent Jobs Table ---\n    it(\"renders recent jobs section\", () => {\n        renderPage();\n        expect(screen.getByText(\"Recent Jobs\")).toBeInTheDocument();\n    });\n\n    it(\"renders recent jobs with truncated IDs\", () => {\n        renderPage();\n        expect(screen.getByText(\"job-1111...\")).toBeInTheDocument();\n        expect(screen.getByText(\"job-aaaa...\")).toBeInTheDocument();\n        expect(screen.getByText(\"job-ffff...\")).toBeInTheDocument();\n    });\n\n    it(\"shows color-coded status badges for jobs\", () => {\n        renderPage();\n        const statusBadges = screen.getAllByText(/completed|failed|processing/i);\n        // Should find at least 3 (from the 3 recent jobs)\n        expect(statusBadges.length).toBeGreaterThanOrEqual(3);\n    });\n\n    it(\"shows batch progress for each job\", () => {\n        renderPage();\n        expect(screen.getByText(\"4/4\")).toBeInTheDocument(); // completed job\n        expect(screen.getByText(\"1/3\")).toBeInTheDocument(); // processing job\n    });\n\n    it(\"shows failed batch count when present\", () => {\n        renderPage();\n        expect(screen.getByText(\"(1 failed)\")).toBeInTheDocument();\n    });\n\n    it(\"displays error messages for failed jobs\", () => {\n        renderPage();\n        expect(screen.getByText(\"DB connection timeout\")).toBeInTheDocument();\n    });\n\n    it(\"shows dash for jobs without errors\", () => {\n        renderPage();\n        // There should be dashes for successful/processing jobs\n        const dashes = screen.getAllByText(\"—\");\n        expect(dashes.length).toBeGreaterThanOrEqual(2);\n    });\n\n    // --- Empty State ---\n    it(\"shows empty state when no workers\", async () => {\n        const useWorkerMonitor = (await import(\"@/hooks/use-worker-monitor\")).useWorkerMonitor;\n        (useWorkerMonitor as any).mockReturnValue({\n            stats: { ...mockMonitorData, total_workers: 0 },\n            workers: [],\n            recentJobs: [],\n            isLoading: false,\n            isFetching: false,\n            error: null,\n            refetch: vi.fn(),\n        });\n\n        renderPage();\n        expect(screen.getByText(\"monitor.no_workers\")).toBeInTheDocument();\n        expect(screen.getByText(\"No recent jobs\")).toBeInTheDocument();\n    });\n\n    // --- Loading State ---\n    it(\"shows loading indicator for stats\", async () => {\n        const useWorkerMonitor = (await import(\"@/hooks/use-worker-monitor\")).useWorkerMonitor;\n        (useWorkerMonitor as any).mockReturnValue({\n            stats: undefined,\n            workers: [],\n            recentJobs: [],\n            isLoading: true,\n            isFetching: false,\n            error: null,\n            refetch: vi.fn(),\n        });\n\n        renderPage();\n        // Stats should show \"...\" when loading\n        const loadingIndicators = screen.getAllByText(\"...\");\n        expect(loadingIndicators.length).toBeGreaterThanOrEqual(1);\n    });\n\n    // --- Error State ---\n    it(\"shows error banner when fetch fails\", async () => {\n        const useWorkerMonitor = (await import(\"@/hooks/use-worker-monitor\")).useWorkerMonitor;\n        (useWorkerMonitor as any).mockReturnValue({\n            stats: undefined,\n            workers: [],\n            recentJobs: [],\n            isLoading: false,\n            isFetching: false,\n            error: new Error(\"Redis connection failed\"),\n            refetch: vi.fn(),\n        });\n\n        renderPage();\n        expect(screen.getByText(\"Failed to load monitoring data. Retrying...\")).toBeInTheDocument();\n    });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/__tests__/WorkingPatternsPage.test.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'fireEvent' is defined but never used. Allowed unused vars must match /^_/u.","line":4,"column":26,"nodeType":"Identifier","messageId":"unusedVar","endLine":4,"endColumn":35,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"fireEvent"},"fix":{"range":[125,136],"text":""},"desc":"Remove unused variable \"fireEvent\"."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":16,"column":38,"nodeT