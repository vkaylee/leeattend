user.click(confirmModalBtn);\n\n    await waitFor(() => {\n      expect(api.revokeExtraRole).toHaveBeenCalledWith(\"test-ws-id\", \"user-1\", \"extra-role-1\");\n    });\n  });\n\n  it(\"filters out primary role and existing extra roles from available options\", async () => {\n    (api.fetchMemberRoles as any).mockResolvedValue({\n      primary: EMPLOYEE_ROLE_ID,\n      extra: [{ id: \"extra-1\", role_id: ADMIN_ROLE_ID, workspace_id: \"test-ws-id\", user_id: \"user-1\", assigned_at: \"\", expires_at: \"2027-01-01T00:00:00Z\" }]\n    });\n\n    renderWithProviders(<RoleManagementModal userId=\"user-1\" isOpen={true} onClose={() => {}} />);\n\n    await waitFor(() => {\n      expect(api.fetchWorkspaceRoles).toHaveBeenCalled();\n    });\n\n    // The extra role select should not contain the primary role (employee) or existing extra (admin)\n    const extraRoleSelect = screen.getByLabelText(/Vai trò gán/i);\n    \n    // Wait for options to populate\n    await waitFor(() => {\n      expect(extraRoleSelect.children.length).toBeGreaterThan(1);\n    });\n\n    const options = extraRoleSelect.querySelectorAll(\"option\");\n\n    const optionValues = Array.from(options).map(o => (o as HTMLOptionElement).value);\n    expect(optionValues).not.toContain(EMPLOYEE_ROLE_ID);\n    expect(optionValues).not.toContain(ADMIN_ROLE_ID);\n  });\n\n  it(\"does not render when isOpen is false\", () => {\n    renderWithProviders(<RoleManagementModal userId=\"user-1\" isOpen={false} onClose={() => {}} />);\n    expect(screen.queryByText(/Quản lý quyền hạn/i)).toBeNull();\n  });\n});","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/__tests__/WorkspaceGuard.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/approvals/BulkUploadOtDialog.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":120,"column":17,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":120,"endColumn":20,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[3469,3472],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[3469,3472],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState } from \"react\";\n\nimport * as Dialog from \"@radix-ui/react-dialog\";\nimport { X, Upload, Download, FileText, AlertCircle, CheckCircle2, XCircle } from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { useBulkUploadPaperOt } from \"@/hooks/use-attendance\";\nimport { useConfirm } from \"@/hooks/use-confirm\";\n\ninterface Props {\n  open: boolean;\n  onOpenChange: (open: boolean) => void;\n  onSuccess?: () => void;\n}\n\ninterface UploadResult {\n  total_rows: number;\n  success_count: number;\n  failed_count: number;\n  errors: Array<{\n    line_number: number;\n    employee_id: string;\n    error_message: string;\n  }>;\n}\n\nexport function BulkUploadOtDialog({ open, onOpenChange, onSuccess }: Props) {\n  const { t } = useTranslation();\n  const { bulkUploadPaperOt, isUploading } = useBulkUploadPaperOt();\n  const { confirm, ConfirmationDialog } = useConfirm();\n\n  const [selectedFile, setSelectedFile] = useState<File | null>(null);\n  const [uploadResult, setUploadResult] = useState<UploadResult | null>(null);\n  const [error, setError] = useState<string | null>(null);\n  const [isDragOver, setIsDragOver] = useState(false);\n\n  const resetForm = () => {\n    setSelectedFile(null);\n    setUploadResult(null);\n    setError(null);\n    setIsDragOver(false);\n  };\n\n  const handleFileChange = (file: File | null) => {\n    if (!file) return;\n\n    if (!file.name.endsWith(\".csv\")) {\n      setError(t(\"approvals.bulk_upload.error_csv_only\") || \"Only CSV files are allowed\");\n      return;\n    }\n\n    setSelectedFile(file);\n    setError(null);\n    setUploadResult(null);\n  };\n\n  const handleDrop = (e: React.DragEvent) => {\n    e.preventDefault();\n    setIsDragOver(false);\n    const file = e.dataTransfer.files[0];\n    handleFileChange(file);\n  };\n\n  const handleDragOver = (e: React.DragEvent) => {\n    e.preventDefault();\n    setIsDragOver(true);\n  };\n\n  const handleDragLeave = () => {\n    setIsDragOver(false);\n  };\n\n  const downloadTemplate = () => {\n    const csvContent = `employee_id,date,minutes,reason\nE001,2026-01-28,120,Production line overtime - paper form #123\nE002,2026-01-28,90,Urgent order completion`;\n\n    const blob = new Blob([csvContent], { type: \"text/csv\" });\n    const url = window.URL.createObjectURL(blob);\n    const a = document.createElement(\"a\");\n    a.href = url;\n    a.download = \"ot_upload_template.csv\";\n    document.body.appendChild(a);\n    a.click();\n    document.body.removeChild(a);\n    window.URL.revokeObjectURL(url);\n  };\n\n  const downloadErrorReport = () => {\n    if (!uploadResult || uploadResult.errors.length === 0) return;\n\n    const headers = \"line_number,employee_id,error_message\";\n    const rows = uploadResult.errors\n      .map(e => `${e.line_number},${e.employee_id},\"${e.error_message}\"`)\n      .join(\"\\n\");\n\n    const csvContent = `${headers}\\n${rows}`;\n    const blob = new Blob([csvContent], { type: \"text/csv\" });\n    const url = window.URL.createObjectURL(blob);\n    const a = document.createElement(\"a\");\n    a.href = url;\n    a.download = `ot_upload_errors_${new Date().getTime()}.csv`;\n    document.body.appendChild(a);\n    a.click();\n    document.body.removeChild(a);\n    window.URL.revokeObjectURL(url);\n  };\n\n  const handleUpload = async () => {\n    if (!selectedFile) return;\n\n    setError(null);\n    try {\n      const result = await bulkUploadPaperOt(selectedFile);\n      setUploadResult(result);\n\n      if (result.success_count > 0) {\n        onSuccess?.();\n      }\n    } catch (e: any) {\n      setError(e.message || \"Failed to upload file\");\n    }\n  };\n\n  const handleClose = async () => {\n    if (uploadResult && uploadResult.failed_count > 0) {\n      const ok = await confirm({\n        title: t(\"common.warning\", { defaultValue: \"Warning\" }),\n        message: t(\"approvals.bulk_upload.confirm_close_with_errors\", { defaultValue: \"Some rows failed. Are you sure you want to close?\" }),\n        variant: \"danger\"\n      });\n      if (!ok) return;\n    }\n    resetForm();\n    onOpenChange(false);\n  };\n\n  return (\n    <Dialog.Root open={open} onOpenChange={(o) => { if (!o) handleClose(); }}>\n      <Dialog.Portal>\n        <Dialog.Overlay className=\"fixed inset-0 bg-black/40 z-50 backdrop-blur-sm\" />\n        <Dialog.Content className=\"fixed left-1/2 top-1/2 z-50 w-full max-w-2xl -translate-x-1/2 -translate-y-1/2 border border-slate-100 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-xl rounded-[2rem] max-h-[90vh] overflow-y-auto\">\n          <Dialog.Title className=\"text-xl font-bold text-slate-800 dark:text-slate-100 uppercase tracking-tight flex items-center gap-2\">\n            <Upload className=\"w-5 h-5\" />\n            {t(\"approvals.bulk_upload.title\") || \"Bulk Upload OT\"}\n          </Dialog.Title>\n          <Dialog.Description className=\"text-sm text-slate-500 dark:text-slate-400 mt-1\">\n            {t(\"approvals.bulk_upload.description\") || \"Upload CSV file to enter multiple OT claims at once\"}\n          </Dialog.Description>\n\n          <button\n            onClick={handleClose}\n            className=\"absolute right-4 top-4 p-2 rounded-full hover:bg-slate-100 dark:hover:bg-slate-700\"\n          >\n            <X className=\"h-4 w-4\" />\n          </button>\n\n          <div className=\"mt-6 space-y-5\">\n            {/* Download Template Button */}\n            <div className=\"flex justify-center\">\n              <button\n                onClick={downloadTemplate}\n                className=\"px-6 py-3 rounded-xl bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:bg-slate-600 text-slate-700 dark:text-slate-200 text-xs font-bold uppercase tracking-wider transition-all flex items-center gap-2\"\n              >\n                <Download className=\"w-4 h-4\" />\n                {t(\"approvals.bulk_upload.download_template\") || \"Download CSV Template\"}\n              </button>\n            </div>\n\n            {/* File Upload Zone */}\n            {!uploadResult && (\n              <div\n                onDrop={handleDrop}\n                onDragOver={handleDragOver}\n                onDragLeave={handleDragLeave}\n                className={`border-2 border-dashed rounded-xl p-8 text-center transition-all cursor-pointer ${\n                  isDragOver\n                    ? \"border-primary-500 bg-primary-50 dark:bg-primary-950\"\n                    : \"border-slate-200 dark:border-slate-700 hover:border-primary-400\"\n                }`}\n              >\n                {selectedFile ? (\n                  <div className=\"space-y-3\">\n                    <FileText className=\"w-12 h-12 text-primary-600 dark:text-primary-400 mx-auto\" />\n                    <p className=\"text-sm font-bold text-slate-700 dark:text-slate-200\">{selectedFile.name}</p>\n                    <p className=\"text-xs text-slate-500 dark:text-slate-400\">\n                      {(selectedFile.size / 1024).toFixed(2)} KB\n                    </p>\n                    <button\n                      onClick={(e) => {\n                        e.stopPropagation();\n                        setSelectedFile(null);\n                      }}\n                      className=\"text-xs text-rose-600 dark:text-rose-300 hover:underline\"\n                    >\n                      {t(\"common.remove\") || \"Remove\"}\n                    </button>\n                  </div>\n                ) : (\n                  <>\n                    <Upload className=\"w-12 h-12 text-slate-400 dark:text-slate-500 mx-auto mb-3\" />\n                    <p className=\"text-sm font-bold text-slate-700 dark:text-slate-200 mb-1\">\n                      {t(\"approvals.bulk_upload.drag_drop\") || \"Drag and drop CSV file here\"}\n                    </p>\n                    <p className=\"text-xs text-slate-500 dark:text-slate-400 mb-4\">\n                      {t(\"approvals.bulk_upload.or_click\") || \"or click to browse\"}\n                    </p>\n                    <input\n                      type=\"file\"\n                      accept=\".csv\"\n                      onChange={(e) => handleFileChange(e.target.files?.[0] || null)}\n                      className=\"hidden\"\n                      id=\"csv-upload\"\n                    />\n                    <label\n                      htmlFor=\"csv-upload\"\n                      className=\"inline-block px-6 py-2 rounded-xl bg-primary-600 text-white text-xs font-bold uppercase tracking-wider cursor-pointer hover:bg-primary-700\"\n                    >\n                      {t(\"approvals.bulk_upload.select_file\") || \"Select File\"}\n                    </label>\n                  </>\n                )}\n              </div>\n            )}\n\n            {/* Upload Button */}\n            {selectedFile && !uploadResult && (\n              <div className=\"flex justify-center\">\n                <button\n                  onClick={handleUpload}\n                  disabled={isUploading}\n                  className=\"px-8 py-3 rounded-xl bg-primary-600 text-white text-xs font-bold uppercase tracking-wider shadow-lg hover:bg-primary-700 disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2\"\n                >\n                  {isUploading ? (\n                    <>\n                      <div className=\"w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin\" />\n                      {t(\"common.uploading\") || \"Uploading...\"}\n                    </>\n                  ) : (\n                    <>\n                      <Upload className=\"w-4 h-4\" />\n                      {t(\"approvals.bulk_upload.upload\") || \"Upload & Process\"}\n                    </>\n                  )}\n                </button>\n              </div>\n            )}\n\n            {/* Error Message */}\n            {error && (\n              <div className=\"flex items-center gap-3 bg-rose-50 dark:bg-rose-950 border border-rose-200 rounded-xl p-4\">\n                <AlertCircle className=\"w-5 h-5 text-rose-600 dark:text-rose-300 flex-shrink-0\" />\n                <p className=\"text-xs font-bold text-rose-600 dark:text-rose-300 uppercase tracking-wide\">{error}</p>\n              </div>\n            )}\n\n            {/* Upload Result */}\n            {uploadResult && (\n              <div className=\"space-y-4\">\n                {/* Summary */}\n                <div className=\"bg-slate-50 dark:bg-slate-800 rounded-xl p-4 space-y-2\">\n                  <h3 className=\"text-sm font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wide\">\n                    {t(\"approvals.bulk_upload.result_summary\") || \"Upload Summary\"}\n                  </h3>\n                  <div className=\"grid grid-cols-3 gap-3 text-center\">\n                    <div className=\"bg-white dark:bg-slate-900 rounded-lg p-3 border border-slate-100 dark:border-slate-800\">\n                      <p className=\"text-xs text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1\">\n                        {t(\"approvals.bulk_upload.total\") || \"Total\"}\n                      </p>\n                      <p className=\"text-2xl font-bold text-slate-700 dark:text-slate-200\">{uploadResult.total_rows}</p>\n                    </div>\n                    <div className=\"bg-emerald-50 dark:bg-emerald-950 rounded-lg p-3 border border-emerald-200 dark:border-emerald-800\">\n                      <p className=\"text-xs text-emerald-600 dark:text-emerald-300 uppercase tracking-wider mb-1 flex items-center justify-center gap-1\">\n                        <CheckCircle2 className=\"w-3 h-3\" />\n                        {t(\"approvals.bulk_upload.success\") || \"Success\"}\n                      </p>\n                      <p className=\"text-2xl font-bold text-emerald-700 dark:text-emerald-300\">{uploadResult.success_count}</p>\n                    </div>\n                    <div className=\"bg-rose-50 dark:bg-rose-950 rounded-lg p-3 border border-rose-200\">\n                      <p className=\"text-xs text-rose-600 dark:text-rose-300 uppercase tracking-wider mb-1 flex items-center justify-center gap-1\">\n                        <XCircle className=\"w-3 h-3\" />\n                        {t(\"approvals.bulk_upload.failed\") || \"Failed\"}\n                      </p>\n                      <p className=\"text-2xl font-bold text-rose-700 dark:text-rose-300\">{uploadResult.failed_count}</p>\n                    </div>\n                  </div>\n                </div>\n\n                {/* Error Details */}\n                {uploadResult.errors.length > 0 && (\n                  <div className=\"space-y-3\">\n                    <div className=\"flex items-center justify-between\">\n                      <h3 className=\"text-sm font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wide\">\n                        {t(\"approvals.bulk_upload.error_details\") || \"Error Details\"}\n                      </h3>\n                      <button\n                        onClick={downloadErrorReport}\n                        className=\"px-4 py-2 rounded-xl bg-rose-100 dark:bg-rose-900 hover:bg-rose-200 text-rose-700 dark:text-rose-300 text-xs font-bold uppercase tracking-wider transition-all flex items-center gap-2\"\n                      >\n                        <Download className=\"w-3 h-3\" />\n                        {t(\"approvals.bulk_upload.download_errors\") || \"Download Errors\"}\n                      </button>\n                    </div>\n\n                    <div className=\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl overflow-hidden max-h-64 overflow-y-auto\">\n                      <table className=\"w-full text-left\">\n                        <thead className=\"bg-slate-50 dark:bg-slate-800 sticky top-0\">\n                          <tr>\n                            <th className=\"px-4 py-2 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider\">\n                              {t(\"approvals.bulk_upload.line\") || \"Line\"}\n                            </th>\n                            <th className=\"px-4 py-2 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider\">\n                              {t(\"common.employee\") || \"Employee ID\"}\n                            </th>\n                            <th className=\"px-4 py-2 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider\">\n                              {t(\"common.error\") || \"Error\"}\n                            </th>\n                          </tr>\n                        </thead>\n                        <tbody className=\"divide-y divide-slate-100 dark:divide-slate-800\">\n                          {uploadResult.errors.map((err, idx) => (\n                            <tr key={idx} className=\"hover:bg-slate-50 dark:hover:bg-slate-800\">\n                              <td className=\"px-4 py-2 text-xs font-mono text-slate-600 dark:text-slate-300\">\n                                {err.line_number}\n                              </td>\n                              <td className=\"px-4 py-2 text-xs font-mono text-slate-600 dark:text-slate-300\">\n                                {err.employee_id}\n                              </td>\n                              <td className=\"px-4 py-2 text-xs text-rose-600 dark:text-rose-300\">\n                                {err.error_message}\n                              </td>\n                            </tr>\n                          ))}\n                        </tbody>\n                      </table>\n                    </div>\n                  </div>\n                )}\n\n                {/* Success Message */}\n                {uploadResult.success_count > 0 && (\n                  <div className=\"flex items-center gap-3 bg-emerald-50 dark:bg-emerald-950 border border-emerald-200 dark:border-emerald-800 rounded-xl p-4\">\n                    <CheckCircle2 className=\"w-5 h-5 text-emerald-600 dark:text-emerald-300 flex-shrink-0\" />\n                    <p className=\"text-xs font-bold text-emerald-700 dark:text-emerald-300 uppercase tracking-wide\">\n                      {t(\"approvals.bulk_upload.success_message\", { count: uploadResult.success_count }) ||\n                        `${uploadResult.success_count} OT claims entered successfully`}\n                    </p>\n                  </div>\n                )}\n              </div>\n            )}\n\n            {/* Action Buttons */}\n            <div className=\"flex justify-end gap-3 pt-2\">\n              {uploadResult ? (\n                <button\n                  onClick={() => {\n                    resetForm();\n                    onOpenChange(false);\n                  }}\n                  className=\"px-6 py-2 rounded-xl bg-primary-600 text-white text-xs font-bold uppercase tracking-wider shadow-lg hover:bg-primary-700\"\n                >\n                  {t(\"common.close\") || \"Close\"}\n                </button>\n              ) : (\n                <button\n                  onClick={handleClose}\n                  className=\"px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700\"\n                >\n                  {t(\"common.cancel\") || \"Cancel\"}\n                </button>\n              )}\n            </div>\n          </div>\n        </Dialog.Content>\n      </Dialog.Portal>\n      <ConfirmationDialog />\n    </Dialog.Root>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/approvals/EnterPaperOtDialog.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":69,"column":17,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":69,"endColumn":20,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[2013,2016],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[2013,2016],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState } from \"react\";\n\nimport * as Dialog from \"@radix-ui/react-dialog\";\nimport { format } from \"date-fns\";\nimport { X, Upload, FileText, Calendar } from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { EmployeeSearch } from \"@/components/common/EmployeeSearch\";\n\nimport { useEnterPaperOt } from \"@/hooks/use-attendance\";\nimport { getCurrentWorkspaceId } from \"@/lib/api/helpers\";\n\ninterface Props {\n  open: boolean;\n  onOpenChange: (open: boolean) => void;\n  onSuccess?: () => void;\n}\n\nexport function EnterPaperOtDialog({ open, onOpenChange, onSuccess }: Props) {\n  const { t } = useTranslation();\n  const wsId = getCurrentWorkspaceId() || \"\";\n  const { enterPaperOt, isSubmitting } = useEnterPaperOt();\n\n  // Form state\n  const [employeeId, setEmployeeId] = useState<string>(\"\");\n  const [date, setDate] = useState(format(new Date(), \"yyyy-MM-dd\"));\n  const [minutes, setMinutes] = useState(0);\n  const [reason, setReason] = useState(\"\");\n  const [photoUrl] = useState<string | null>(null);\n  const [error, setError] = useState<string | null>(null);\n\n  const resetForm = () => {\n    setEmployeeId(\"\");\n    setDate(format(new Date(), \"yyyy-MM-dd\"));\n    setMinutes(0);\n    setReason(\"\");\n    setError(null);\n  };\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setError(null);\n\n    // Validation\n    if (!employeeId) {\n      setError(t(\"approvals.paper_ot.error_no_employee\") || \"Select an employee\");\n      return;\n    }\n    if (minutes <= 0) {\n      setError(t(\"approvals.paper_ot.error_minutes\") || \"Minutes must be > 0\");\n      return;\n    }\n    if (!reason.trim()) {\n      setError(t(\"approvals.paper_ot.error_reason\") || \"Reason is required\");\n      return;\n    }\n\n    try {\n      await enterPaperOt({\n        employeeId,\n        date,\n        claimed_minutes: minutes,\n        reason,\n        paper_form_photo_url: photoUrl || undefined,\n      });\n      resetForm();\n      onOpenChange(false);\n      onSuccess?.();\n    } catch (e: any) {\n      setError(e.message || \"Failed to submit\");\n    }\n  };\n\n  return (\n    <Dialog.Root open={open} onOpenChange={(o) => { if (!o) resetForm(); onOpenChange(o); }}>\n      <Dialog.Portal>\n        <Dialog.Overlay className=\"fixed inset-0 bg-black/40 z-50 backdrop-blur-sm\" />\n        <Dialog.Content className=\"fixed left-1/2 top-1/2 z-50 w-full max-w-lg -translate-x-1/2 -translate-y-1/2 border border-slate-100 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-xl rounded-[2rem]\">\n          <Dialog.Title className=\"text-xl font-bold text-slate-800 dark:text-slate-100 uppercase tracking-tight flex items-center gap-2\">\n            <FileText className=\"w-5 h-5\" />\n            {t(\"approvals.paper_ot.title\") || \"Enter Paper OT Form\"}\n          </Dialog.Title>\n          <Dialog.Description className=\"text-sm text-slate-500 dark:text-slate-400 mt-1\">\n            {t(\"approvals.paper_ot.description\") || \"Enter overtime claim from signed paper form\"}\n          </Dialog.Description>\n\n          <button onClick={() => onOpenChange(false)} className=\"absolute right-4 top-4 p-2 rounded-full hover:bg-slate-100 dark:hover:bg-slate-700\">\n            <X className=\"h-4 w-4\" />\n          </button>\n\n          <form onSubmit={handleSubmit} className=\"mt-6 space-y-5\">\n            {/* Employee Selector */}\n            <div className=\"space-y-2\">\n              <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.2em]\">\n                {t(\"common.employee\") || \"Employee\"}\n              </label>\n              <EmployeeSearch\n                workspaceId={wsId}\n                value={employeeId}\n                onChange={setEmployeeId}\n                placeholder={t(\"approvals.paper_ot.select_employee\") || \"Search employee...\"}\n              />\n            </div>\n\n            {/* Date Picker */}\n            <div className=\"space-y-2\">\n              <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.2em]\">\n                {t(\"common.date\") || \"Date\"}\n              </label>\n              <div className=\"relative\">\n                <Calendar className=\"absolute left-3 top-3 h-4 w-4 text-slate-400 dark:text-slate-500\" />\n                <input\n                  type=\"date\"\n                  value={date}\n                  onChange={(e) => setDate(e.target.value)}\n                  max={format(new Date(), \"yyyy-MM-dd\")}\n                  className=\"w-full pl-10 h-10 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-3 text-sm focus:ring-2 focus:ring-primary-600\"\n                />\n              </div>\n            </div>\n\n            {/* Minutes Input */}\n            <div className=\"space-y-2\">\n              <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.2em]\">\n                {t(\"approvals.paper_ot.minutes\") || \"OT Minutes\"}\n              </label>\n              <input\n                type=\"number\"\n                value={minutes || \"\"}\n                onChange={(e) => setMinutes(parseInt(e.target.value) || 0)}\n                min={1}\n                className=\"w-full h-10 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-3 text-sm font-mono focus:ring-2 focus:ring-primary-600\"\n                placeholder=\"120\"\n              />\n            </div>\n\n            {/* Reason Textarea */}\n            <div className=\"space-y-2\">\n              <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.2em]\">\n                {t(\"common.reason\") || \"Reason\"}\n              </label>\n              <textarea\n                value={reason}\n                onChange={(e) => setReason(e.target.value)}\n                rows={3}\n                className=\"w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-3 py-2 text-sm resize-none focus:ring-2 focus:ring-primary-600\"\n                placeholder={t(\"approvals.paper_ot.reason_placeholder\") || \"Paper form #1234 - Production line\"}\n              />\n            </div>\n\n            {/* Photo Upload Placeholder (Optional) */}\n            <div className=\"space-y-2\">\n              <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.2em]\">\n                {t(\"approvals.paper_ot.photo\") || \"Paper Form Photo (Optional)\"}\n              </label>\n              <div className=\"border-2 border-dashed border-slate-200 dark:border-slate-700 rounded-xl p-4 text-center hover:border-primary-400 transition-colors cursor-not-allowed opacity-50\">\n                <Upload className=\"w-8 h-8 text-slate-400 dark:text-slate-500 mx-auto mb-2\" />\n                <p className=\"text-xs text-slate-500 dark:text-slate-400\">{t(\"approvals.paper_ot.photo_coming_soon\") || \"Photo upload coming soon\"}</p>\n              </div>\n            </div>\n\n            {/* Error Message */}\n            {error && (\n              <div className=\"text-xs font-bold text-rose-500 uppercase tracking-wide bg-rose-50 dark:bg-rose-950 p-3 rounded-lg\">\n                {error}\n              </div>\n            )}\n\n            {/* Action Buttons */}\n            <div className=\"flex justify-end gap-3 pt-2\">\n              <button\n                type=\"button\"\n                onClick={() => onOpenChange(false)}\n                className=\"px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700\"\n              >\n                {t(\"common.cancel\") || \"Cancel\"}\n              </button>\n              <button\n                type=\"submit\"\n                disabled={isSubmitting}\n                className=\"px-6 py-2 rounded-xl bg-primary-600 text-white text-xs font-bold uppercase tracking-wider shadow-lg hover:bg-primary-700 disabled:opacity-50\"\n              >\n                {isSubmitting ? (t(\"common.saving\") || \"Saving...\") : (t(\"common.submit\") || \"Submit\")}\n              </button>\n            </div>\n          </form>\n        </Dialog.Content>\n      </Dialog.Portal>\n    </Dialog.Root>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/approvals/__tests__/BulkUploadOtDialog.test.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'options' is defined but never used. Allowed unused args must match /^_/u.","line":28,"column":22,"nodeType":"Identifier","messageId":"unusedVar","endLine":28,"endColumn":29},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":28,"column":32,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":28,"endColumn":35,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[786,789],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[786,789],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":39,"column":33,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":39,"endColumn":36,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1171,1174],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1171,1174],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from \"react\";\n\nimport { render, screen, waitFor, fireEvent } from \"@testing-library/react\";\nimport userEvent from \"@testing-library/user-event\";\nimport { describe, it, expect, vi, beforeEach } from \"vitest\";\n\nimport { ToastProvider } from \"@/components/ui/Toast\";\n\nimport { BulkUploadOtDialog } from \"../BulkUploadOtDialog\";\n\n\n// Mock the hook\nvi.mock(\"@/hooks/use-attendance\", () => ({\n  useBulkUploadPaperOt: () => ({\n    bulkUploadPaperOt: vi.fn().mockResolvedValue({\n      total_rows: 2,\n      success_count: 1,\n      failed_count: 1,\n      errors: [{ line_number: 2, employee_id: \"E002\", error_message: \"Error\" }]\n    }),\n    isUploading: false\n  })\n}));\n\n// Mock translation\nvi.mock(\"react-i18next\", () => ({\n  useTranslation: () => ({\n    t: (key: string, options?: any) => {\n      if (key === \"approvals.bulk_upload.confirm_close_with_errors\") return \"Close with errors?\";\n      if (key === \"common.warning\") return \"Warning\";\n      if (key === \"common.confirm\") return \"Confirm\";\n      if (key === \"common.cancel\") return \"Cancel\";\n      if (key === \"common.close\") return \"Close\";\n      return key;\n    }\n  })\n}));\n\nconst renderComponent = (props: any) => {\n  return render(\n    <ToastProvider>\n      <BulkUploadOtDialog {...props} />\n    </ToastProvider>\n  );\n};\n\ndescribe(\"BulkUploadOtDialog\", () => {\n  beforeEach(() => {\n    vi.clearAllMocks();\n  });\n\n  it(\"should show useConfirm dialog when closing with errors\", async () => {\n    const user = userEvent.setup();\n    const onOpenChange = vi.fn();\n    \n    renderComponent({\n      open: true,\n      onOpenChange,\n    });\n\n    // We need to simulate uploading a file so it gets to the result state with errors\n    const file = new File([\"test\"], \"test.csv\", { type: \"text/csv\" });\n    const input = screen.getByLabelText(/Select File|approvals.bulk_upload.select_file/i);\n    await user.upload(input, file);\n\n    const uploadBtn = screen.getByRole(\"button\", { name: /Upload & Process|approvals.bulk_upload.upload/i });\n    await user.click(uploadBtn);\n\n    // Wait for result to appear\n    expect(await screen.findByText(\"Error\")).toBeDefined();\n\n    // Now click the dialog's top-right X button which calls handleClose\n    // We can find it by getting the first button (it's the X button at the top)\n    const buttons = screen.getAllByRole(\"button\");\n    const xBtn = buttons[0]; \n    await user.click(xBtn);\n\n    // Confirm dialog should appear\n    expect(await screen.findByText(\"Warning\")).toBeDefined();\n    expect(await screen.findByText(\"Close with errors?\")).toBeDefined();\n\n    // Click confirm\n    const confirmBtn = screen.getByRole(\"button\", { name: \"Confirm\" });\n    fireEvent.click(confirmBtn);\n\n    await waitFor(() => {\n      expect(onOpenChange).toHaveBeenCalledWith(false);\n    });\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/common/AuthGuard.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/common/EmployeeSearch.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":15,"column":21,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":15,"endColumn":24,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[482,485],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[482,485],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'isLoading' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":50,"column":32,"nodeType":"Identifier","messageId":"unusedVar","endLine":50,"endColumn":41},{"ruleId":"import-x/no-named-as-default-member","severity":1,"message":"Caution: `React` also has a named export `useMemo`. Check if you meant to write `import {useMemo} from 'react'` instead.","line":56,"column":21,"nodeType":"MemberExpression","messageId":"member","endLine":56,"endColumn":34},{"ruleId":"import-x/no-named-as-default-member","severity":1,"message":"Caution: `React` also has a named export `useMemo`. Check if you meant to write `import {useMemo} from 'react'` instead.","line":61,"column":23,"nodeType":"MemberExpression","messageId":"member","endLine":61,"endColumn":36},{"ruleId":"import-x/no-named-as-default-member","severity":1,"message":"Caution: `React` also has a named export `useEffect`. Check if you meant to write `import {useEffect} from 'react'` instead.","line":67,"column":3,"nodeType":"MemberExpression","messageId":"member","endLine":67,"endColumn":18},{"ruleId":"jsx-a11y/no-autofocus","severity":2,"message":"The autoFocus prop should not be used, as it can reduce usability and accessibility for users.","line":170,"column":9,"nodeType":"JSXAttribute","endLine":170,"endColumn":30}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from 'react';\n\nimport { useQuery } from '@tanstack/react-query';\nimport { User, X } from 'lucide-react';\nimport { useTranslation } from 'react-i18next';\n\nimport { useDebounce } from '../../hooks/use-debounce';\nimport { searchEmployees } from '../../lib/api';\nimport { Employee } from '../../lib/api/types';\nimport { Combobox } from '../ui/Combobox';\n\ninterface EmployeeSearchProps {\n  workspaceId: string;\n  value?: string | string[];\n  onChange: (value: any) => void;\n  placeholder?: string;\n  className?: string;\n  id?: string;\n  'data-testid'?: string;\n  multiple?: boolean;\n  autoFocus?: boolean;\n  keyboardShortcut?: string | string[];\n  clearOnEscape?: boolean;\n  onSelectEmployee?: (employee: Employee) => void;\n}\n\n/**\n * A reusable employee search component with debounced server-side filtering.\n * Supports single or multiple selection (with chips).\n */\nexport function EmployeeSearch({\n  workspaceId,\n  value,\n  onChange,\n  placeholder,\n  className,\n  id,\n  'data-testid': testId,\n  multiple = false,\n  autoFocus = false,\n  keyboardShortcut,\n  clearOnEscape,\n  onSelectEmployee,\n}: EmployeeSearchProps) {\n  const { t } = useTranslation();\n  const [searchTerm, setSearchTerm] = useState('');\n  const debouncedSearchTerm = useDebounce(searchTerm, 300);\n\n  // Fetch employees with debounced query\n  const { data: employeesData, isLoading } = useQuery({\n    queryKey: ['employees', workspaceId, 'search', debouncedSearchTerm],\n    queryFn: () => searchEmployees(workspaceId, debouncedSearchTerm),\n    enabled: !!workspaceId,\n  });\n\n  const employees = React.useMemo(() => employeesData?.data || [], [employeesData?.data]);\n\n  // Keep track of selected employee objects to show their names in chips\n  const [selectedMeta, setSelectedMeta] = useState<Employee[]>([]);\n\n  const selectedIds = React.useMemo(() =>\n    Array.isArray(value) ? value : value ? [value] : [],\n    [value]\n  );\n\n  // Auto-populate selectedMeta when employees are loaded\n  React.useEffect(() => {\n    if (employees.length > 0 && selectedIds.length > 0) {\n      const found = employees.filter(emp => selectedIds.includes(emp.id));\n      if (found.length > 0) {\n        setSelectedMeta(prev => {\n          const missing = found.filter(f => !prev.find(m => m.id === f.id));\n          if (missing.length === 0) return prev;\n          return [...prev, ...missing];\n        });\n      }\n    }\n  }, [employees, selectedIds]);\n\n  const handleSelect = (selectedId: string) => {\n    const emp = employees.find(e => e.id === selectedId);\n\n    if (emp && !selectedMeta.find(m => m.id === emp.id)) {\n      setSelectedMeta(prev => [...prev, emp]);\n    }\n\n    if (emp && onSelectEmployee) {\n      onSelectEmployee(emp);\n    }\n\n    if (multiple) {\n      const current = Array.isArray(value) ? value : [];\n      if (!current.includes(selectedId)) {\n        onChange([...current, selectedId]);\n      }\n      setSearchTerm(''); // Reset for next search\n    } else {\n      onChange(selectedId);\n    }\n  };\n\n  const handleRemove = (idToRemove: string) => {\n    if (multiple && Array.isArray(value)) {\n      onChange(value.filter(id => id !== idToRemove));\n    }\n  };\n\n  // Helper to highlight matching text in search results\n  const highlightMatch = (text: string, query: string) => {\n    if (!query.trim()) return text;\n\n    // Escape regex characters from query\n    const escapedQuery = query.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n    const regex = new RegExp(`(${escapedQuery})`, 'gi');\n    const parts = text.split(regex);\n\n    return (\n      <>\n        {parts.map((part, i) =>\n          regex.test(part) ? (\n            <span key={i} className=\"text-primary-600 dark:text-primary-400 font-black\">{part}</span>\n          ) : (\n            <span key={i}>{part}</span>\n          )\n        )}\n      </>\n    );\n  };\n\n  // Transform to Combobox options\n  const baseOptions = employees\n    .filter(emp => !multiple || !selectedIds.includes(emp.id))\n    .map((emp) => ({\n      value: emp.id,\n      label: emp.full_name,\n      displayLabel: highlightMatch(emp.full_name, debouncedSearchTerm),\n      description: emp.employee_id_number,\n      displayDescription: highlightMatch(emp.employee_id_number, debouncedSearchTerm),\n      icon: <User className='h-4 w-4 text-slate-500 dark:text-slate-400' />,\n    }));\n\n  // Only show previously-selected employee at top when NOT actively searching.\n  // During search, only server-filtered results should appear.\n  const extraOptions = searchTerm\n    ? []\n    : selectedMeta\n      .filter(m => selectedIds.includes(m.id))\n      .filter(m => !baseOptions.find(opt => opt.value === m.id))\n      .map(m => ({\n        value: m.id,\n        label: m.full_name,\n        displayLabel: highlightMatch(m.full_name, debouncedSearchTerm),\n        description: m.employee_id_number,\n        displayDescription: highlightMatch(m.employee_id_number, debouncedSearchTerm),\n        icon: <User className='h-4 w-4 text-slate-500 dark:text-slate-400' />,\n      }));\n\n  const options = [...extraOptions, ...baseOptions];\n\n  return (\n    <div className={'space-y-2 ' + (className || '')}>\n      <Combobox\n        id={id}\n        data-testid={testId}\n        options={options}\n        value={multiple ? '' : (Array.isArray(value) ? '' : (value || ''))}\n        onChange={handleSelect}\n        placeholder={placeholder || t('common.search')}\n        onSearchChange={setSearchTerm}\n        autoFocus={autoFocus}\n        keyboardShortcut={keyboardShortcut}\n        clearOnEscape={clearOnEscape}\n      />\n\n      {multiple && selectedIds.length > 0 && (\n        <div className='flex flex-wrap gap-2'>\n          {selectedIds.map(id => {\n            const meta = selectedMeta.find(m => m.id === id);\n            return (\n              <div\n                key={id}\n                className='flex items-center gap-1.5 px-2.5 py-1 bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 rounded-lg text-xs font-medium border border-slate-200 dark:border-slate-700'\n              >\n                <span>{meta?.full_name || id}</span>\n                <button\n                  type='button'\n                  onClick={() => handleRemove(id)}\n                  className='hover:text-rose-500 transition-colors'\n                >\n                  <X size={14} />\n                </button>\n              </div>\n            );\n          })}\n        </div>\n      )}\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/common/ErrorBoundary.tsx","messages":[{"ruleId":"import-x/no-named-as-default-member","severity":1,"message":"Caution: `React` also has a named export `Component`. Check if you meant to write `import {Component} from 'react'` instead.","line":14,"column":36,"nodeType":"MemberExpression","messageId":"member","endLine":14,"endColumn":51}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from \"react\";\n\ninterface ErrorBoundaryProps {\n  children?: React.ReactNode;\n  fallback?: React.ReactNode;\n  onError?: (error: Error, errorInfo: React.ErrorInfo) => void;\n}\n\ninterface ErrorBoundaryState {\n  hasError: boolean;\n  error: Error | null;\n}\n\nexport class ErrorBoundary extends React.Component<\n  ErrorBoundaryProps,\n  ErrorBoundaryState\n> {\n  constructor(props: ErrorBoundaryProps) {\n    super(props);\n    this.state = { hasError: false, error: null };\n  }\n\n  static getDerivedStateFromError(error: Error): ErrorBoundaryState {\n    return { hasError: true, error };\n  }\n\n  componentDidCatch(error: Error, errorInfo: React.ErrorInfo) {\n    console.error(\"[ErrorBoundary]\", error, errorInfo);\n    this.props.onError?.(error, errorInfo);\n  }\n\n  handleRetry = () => {\n    this.setState({ hasError: false, error: null });\n  };\n\n  handleHardReload = () => {\n    window.location.reload();\n  };\n\n  render() {\n    if (this.state.hasError) {\n      if (this.props.fallback) return this.props.fallback;\n\n      return (\n        <div className=\"min-h-[400px] flex items-center justify-center p-8\">\n          <div className=\"max-w-md text-center space-y-4\">\n            <div className=\"w-16 h-16 mx-auto rounded-full bg-red-100 dark:bg-red-900/30 flex items-center justify-center\">\n              <svg className=\"w-8 h-8 text-red-500\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\">\n                <circle cx=\"12\" cy=\"12\" r=\"10\" />\n                <line x1=\"15\" y1=\"9\" x2=\"9\" y2=\"15\" />\n                <line x1=\"9\" y1=\"9\" x2=\"15\" y2=\"15\" />\n              </svg>\n            </div>\n            <h2 className=\"text-lg font-semibold text-slate-800 dark:text-slate-200\">\n              Something went wrong\n            </h2>\n            <p className=\"text-sm text-slate-500 dark:text-slate-400\">\n              {this.state.error?.message || \"An unexpected error occurred\"}\n            </p>\n            <div className=\"flex justify-center gap-3\">\n              <button\n                onClick={this.handleRetry}\n                className=\"px-4 py-2 text-sm font-medium rounded-lg bg-blue-600 text-white hover:bg-blue-700 transition-colors\"\n              >\n                Try again\n              </button>\n              <button\n                onClick={this.handleHardReload}\n                className=\"px-4 py-2 text-sm font-medium rounded-lg border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors\"\n              >\n                Reload page\n              </button>\n            </div>\n            {this.state.error && import.meta.env.DEV && (\n              <pre className=\"mt-4 p-4 text-left text-xs bg-slate-100 dark:bg-slate-900 rounded-lg overflow-auto max-h-[200px] text-red-600 dark:text-red-400\">\n                {this.state.error.stack}\n              </pre>\n            )}\n          </div>\n        </div>\n      );\n    }\n\n    return this.props.children ?? null;\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/common/FloatingRecordBadge.tsx","messages":[{"ruleId":"import-x/no-named-as-default-member","severity":1,"message":"Caution: `React` also has a named export `memo`. Check if you meant to write `import {memo} from 'react'` instead.","line":13,"column":29,"nodeType":"MemberExpression","messageId":"member","endLine":13,"endColumn":39}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from \"react\";\n\nimport { cn } from \"@/lib/utils\";\n\ninterface FloatingR