eDashboardLayout } from \"@/hooks/use-dashboard-layout\";\nimport { useDevices } from \"@/hooks/use-devices\";\n\ndescribe(\"DashboardPage\", () => {\n  let queryClient: QueryClient;\n\n  beforeEach(() => {\n    queryClient = new QueryClient({\n      defaultOptions: { queries: { retry: false } },\n    });\n    vi.clearAllMocks();\n\n    (useAgentsStatus as any).mockReturnValue({\n      agents: [],\n      isLoading: false,\n      error: null,\n    });\n\n    (useDevices as any).mockReturnValue({\n      devices: [],\n      isLoading: false,\n      error: null,\n    });\n\n    (useDashboardStats as any).mockReturnValue({\n      data: {\n        total_employees: 100,\n        present_today: 95,\n        late_today: 5,\n        absent_today: 2,\n        on_leave_today: 3,\n        pending_leave_requests: 1,\n        avg_work_hours_today: 7.5,\n        early_departure_today: 1,\n        estimated_monthly_payroll: 50000,\n      },\n      isLoading: false,\n      error: null,\n    });\n\n    (useDashboardLayout as any).mockReturnValue({\n      activeView: \"overview\",\n      visibleWidgets: {\n        kpi_cards: true,\n        donut_chart: true,\n        quick_stats: true,\n        attendance_trend: true,\n        department_chart: true,\n        promo_cards: true,\n      },\n      widgetOrder: [\n        \"kpi_cards\",\n        \"donut_chart\",\n        \"quick_stats\",\n        \"attendance_trend\",\n        \"department_chart\",\n        \"promo_cards\",\n      ],\n      collapsedSections: {\n        summary: false,\n        charts: false,\n        actions: false,\n      },\n      isSaving: false,\n      setActiveView: vi.fn(),\n      toggleWidget: vi.fn(),\n      setWidgetOrder: vi.fn(),\n      toggleSection: vi.fn(),\n      resetToDefault: vi.fn(),\n      allWidgets: [],\n    });\n  });\n\n  const renderComponent = () => {\n    return render(\n      <QueryClientProvider client={queryClient}>\n        <DashboardPage />\n      </QueryClientProvider>\n    );\n  };\n\n  i