type.","line":530,"column":38,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":530,"endColumn":41,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[18526,18529],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[18526,18529],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":564,"column":38,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":564,"endColumn":41,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[19792,19795],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[19792,19795],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":584,"column":38,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":584,"endColumn":41,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[20438,20441],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[20438,20441],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":23,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { render, screen, fireEvent, waitFor, act } from \"@testing-library/react\";\nimport userEvent from \"@testing-library/user-event\";\nimport { describe, it, expect, vi, beforeEach, afterEach } from \"vitest\";\n\nimport * as api from \"@/lib/api\";\n\nimport LeaveImportDialog from \"../LeaveImportDialog\";\n\n// Mock API\nvi.mock(\"@/lib/api\", () => ({\n  uploadLeaveExcel: vi.fn(),\n  fetchLatestLeaveImport: vi.fn().mockResolvedValue(null),\n  downloadLeaveImportTemplate: vi.fn().mockResolvedValue(undefined),\n  downloadLeaveImportErrors: vi.fn().mockResolvedValue(undefined),\n  getCurrentWorkspaceId: vi.fn().mockReturnValue(\"ws-test\"),\n}));\n\n// Mock i18n — return key as text for testability\nvi.mock(\"react-i18next\", () => ({\n  useTranslation: () => ({\n    t: (key: string, fallback?: string) => fallback || key,\n    i18n: { language: \"vi\" },\n  }),\n}));\n\nconst createFile = (name = \"test.xlsx\", size = 1024) => {\n  const content = new ArrayBuffer(size);\n  return new File([content], name, {\n    type: \"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet\",\n  });\n};\n\ndescribe(\"LeaveImportDialog\", () => {\n  let onClose: () => void;\n  let onImportComplete: () => void;\n\n  beforeEach(() => {\n    vi.clearAllMocks();\n    vi.useFakeTimers({ shouldAdvanceTime: true });\n    onClose = vi.fn() as unknown as () => void;\n    onImportComplete = vi.fn() as unknown as () => void;\n    (api.getCurrentWorkspaceId as any).mockReturnValue(\"ws-test\");\n    (api.fetchLatestLeaveImport as any).mockResolvedValue(null);\n  });\n\n  afterEach(() => {\n    vi.useRealTimers();\n  });\n\n  const renderDialog = (props: Partial<Parameters<typeof LeaveImportDialog>[0]> = {}) =>\n    render(\n      <LeaveImportDialog\n        isOpen={true}\n        onClose={onClose}\n        onImportComplete={onImportComplete}\n        {...props}\n      />\n    );\n\n  // ═══════════════════════════════════════════════════════════════════\n  // Rendering\n  // ═══════════════════════════════════════════════════════════════════\n\n  describe(\"Rendering\", () => {\n    it(\"renders nothing when isOpen is false\", () => {\n      renderDialog({ isOpen: false });\n      expect(screen.queryByTestId(\"leave-import-dialog\")).toBeNull();\n    });\n\n    it(\"renders modal with title and subtitle when isOpen\", () => {\n      renderDialog();\n      expect(screen.getByText(/Import đơn nghỉ phép/i)).toBeDefined();\n      expect(screen.getByText(/Upload file Excel/i)).toBeDefined();\n    });\n\n    it(\"renders instructions panel with all 6 column requirements\", () => {\n      renderDialog();\n      expect(screen.getByText(/Yêu cầu file/i)).toBeDefined();\n      expect(screen.getByText(/Cột A: Mã nhân viên/i)).toBeDefined();\n      expect(screen.getByText(/Cột B: Mã loại nghỉ/i)).toBeDefined();\n      expect(screen.getByText(/Cột C-D/i)).toBeDefined();\n      expect(screen.getByText(/Cột E: Lý do/i)).toBeDefined();\n      expect(screen.getByText(/Cột F: Loại thời gian/i)).toBeDefined();\n      expect(screen.getAllByText(/\\.xlsx, \\.xls, \\.csv/i).length).toBeGreaterThanOrEqual(1);\n    });\n\n    it(\"renders download template button\", () => {\n      renderDialog();\n      expect(screen.getByText(/Tải file mẫu Excel/i)).toBeDefined();\n    });\n\n    it(\"renders file drop zone with prompt\", () => {\n      renderDialog();\n      expect(screen.getByText(/Nhấn để chọn file Excel/i)).toBeDefined();\n      expect(screen.getByText(/Hỗ trợ .xlsx, .xls, .csv/i)).toBeDefined();\n    });\n\n    it(\"renders cancel and import buttons\", () => {\n      renderDialog();\n      expect(screen.getByText(\"Hủy\")).toBeDefined();\n      expect(screen.getByText(/BẮT ĐẦU IMPORT/i)).toBeDefined();\n    });\n\n    it(\"disables import button when no file selected\", () => {\n      renderDialog();\n      const importBtn = screen.getByText(/BẮT ĐẦU IMPORT/i).closest(\"button\");\n      expect(importBtn).toBeDisabled();\n    });\n  });\n\n  // ═══════════════════════════════════════════════════════════════════\n  // File Selection\n  // ═══════════════════════════════════════════════════════════════════\n\n  describe(\"File Selection\", () => {\n    it(\"shows file info when a file is selected\", async () => {\n      renderDialog();\n      const fileInput = document.getElementById(\"leave-import-file-input\") as HTMLInputElement;\n      expect(fileInput).toBeDefined();\n\n      const file = createFile(\"leave_data.xlsx\", 2048);\n      fireEvent.change(fileInput, { target: { files: [file] } });\n\n      expect(await screen.findByText(\"leave_data.xlsx\")).toBeDefined();\n      expect(screen.getByText(/2\\.0 KB/i)).toBeDefined();\n      expect(screen.getByText(/SẴN SÀNG UPLOAD/i)).toBeDefined();\n    });\n\n    it(\"enables import button after file selection\", () => {\n      renderDialog();\n      const fileInput = document.getElementById(\"leave-import-file-input\") as HTMLInputElement;\n      const file = createFile();\n      fireEvent.change(fileInput, { target: { files: [file] } });\n\n      const importBtn = screen.getByText(/BẮT ĐẦU IMPORT/i).closest(\"button\");\n      expect(importBtn).not.toBeDisabled();\n    });\n\n    it(\"shows 'select another file' button and allows file removal\", async () => {\n      const user = userEvent.setup({ advanceTimers: vi.advanceTimersByTime });\n      renderDialog();\n      const fileInput = document.getElementById(\"leave-import-file-input\") as HTMLInputElement;\n      fireEvent.change(fileInput, { target: { files: [createFile()] } });\n\n      const removeBtn = await screen.findByText(/Chọn file khác/i);\n      expect(removeBtn).toBeDefined();\n\n      await user.click(removeBtn);\n      // Drop zone prompt should reappear\n      expect(screen.getByText(/Nhấn để chọn file Excel/i)).toBeDefined();\n    });\n  });\n\n  // ═══════════════════════════════════════════════════════════════════\n  // Template Download\n  // ═══════════════════════════════════════════════════════════════════\n\n  describe(\"Template Download\", () => {\n    it(\"calls downloadLeaveImportTemplate when button is clicked\", async () => {\n      const user = userEvent.setup({ advanceTimers: vi.advanceTimersByTime });\n      (api.downloadLeaveImportTemplate as any).mockResolvedValue(undefined);\n      renderDialog();\n\n      const downloadBtn = screen.getByText(/Tải file mẫu Excel/i).closest(\"button\")!;\n      await user.click(downloadBtn);\n\n      await waitFor(() => {\n        expect(api.downloadLeaveImportTemplate).toHaveBeenCalledWith(\"ws-test\", \"vi\");\n      });\n    });\n\n    it(\"handles template download error gracefully\", async () => {\n      const user = userEvent.setup({ advanceTimers: vi.advanceTimersByTime });\n      (api.downloadLeaveImportTemplate as any).mockRejectedValue(new Error(\"Network error\"));\n      renderDialog();\n\n      const downloadBtn = screen.getByText(/Tải file mẫu Excel/i).closest(\"button\")!;\n      // Should not throw\n      await user.click(downloadBtn);\n      \n      // Button should still be clickable after error\n      await waitFor(() => {\n        expect(downloadBtn).not.toBeDisabled();\n      });\n    });\n  });\n\n  // ═══════════════════════════════════════════════════════════════════\n  // Upload Flow\n  // ═══════════════════════════════════════════════════════════════════\n\n  describe(\"Upload Flow\", () => {\n    it(\"calls uploadLeaveExcel with correct args when import is clicked\", async () => {\n      const user = userEvent.setup({ advanceTimers: vi.advanceTimersByTime });\n      (api.uploadLeaveExcel as any).mockResolvedValue({ job_id: \"job-123\" });\n      renderDialog();\n\n      const fileInput = document.getElementById(\"leave-import-file-input\") as HTMLInputElement;\n      const file = createFile(\"data.xlsx\");\n      fireEvent.change(fileInput, { target: { files: [file] } });\n\n      const importBtn = screen.getByText(/BẮT ĐẦU IMPORT/i).closest(\"button\")!;\n      await user.click(importBtn);\n\n      await waitFor(() => {\n        expect(api.uploadLeaveExcel).toHaveBeenCalledWith(\"ws-test\", file);\n      });\n    });\n\n    it(\"transitions to progress view after successful upload\", async () => {\n      const user = userEvent.setup({ advanceTimers: vi.advanceTimersByTime });\n      (api.uploadLeaveExcel as any).mockResolvedValue({ job_id: \"job-456\" });\n      renderDialog();\n\n      const fileInput = document.getElementById(\"leave-import-file-input\") as HTMLInputElement;\n      fireEvent.change(fileInput, { target: { files: [createFile()] } });\n\n      await user.click(screen.getByText(/BẮT ĐẦU IMPORT/i).closest(\"button\")!);\n\n      // Should switch to progress view\n      await waitFor(() => {\n        expect(screen.getByText(/Đang xử lý.../i)).toBeDefined();\n      });\n      // Upload view elements should be gone\n      expect(screen.queryByText(/Nhấn để chọn file Excel/i)).toBeNull();\n    });\n\n    it(\"handles upload error gracefully (stays on upload view)\", async () => {\n      const user = userEvent.setup({ advanceTimers: vi.advanceTimersByTime });\n      (api.uploadLeaveExcel as any).mockRejectedValue(new Error(\"Upload failed\"));\n      renderDialog();\n\n      const fileInput = document.getElementById(\"leave-import-file-input\") as HTMLInputElement;\n      fireEvent.change(fileInput, { target: { files: [createFile()] } });\n\n      await user.click(screen.getByText(/BẮT ĐẦU IMPORT/i).closest(\"button\")!);\n\n      // Should stay on upload view after error\n      await waitFor(() => {\n        expect(screen.getByText(/BẮT ĐẦU IMPORT/i)).toBeDefined();\n      });\n    });\n\n    it(\"does not upload when no file is selected\", async () => {\n      renderDialog();\n      const importBtn = screen.getByText(/BẮT ĐẦU IMPORT/i).closest(\"button\")!;\n      expect(importBtn).toBeDisabled();\n      expect(api.uploadLeaveExcel).not.toHaveBeenCalled();\n    });\n\n    it(\"does not upload when workspace ID is null\", () => {\n      (api.getCurrentWorkspaceId as any).mockReturnValue(null);\n      renderDialog();\n      // Template download button should be disabled\n      const downloadBtn = screen.getByText(/Tải file mẫu Excel/i).closest(\"button\");\n      expect(downloadBtn).toBeDisabled();\n    });\n  });\n\n  // ═══════════════════════════════════════════════════════════════════\n  // Progress / Status Views\n  // ═══════════════════════════════════════════════════════════════════\n\n  describe(\"Progress View\", () => {\n    it(\"shows processing status with progress rows\", async () => {\n      (api.fetchLatestLeaveImport as any).mockResolvedValue({\n        id: \"job-1\",\n        status: \"processing\",\n        total_rows: 100,\n        processed_rows: 45,\n        error_log: null,\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString(),\n      });\n\n      renderDialog();\n\n      await waitFor(() => {\n        expect(screen.getByText(/Đang xử lý.../i)).toBeDefined();\n      });\n      expect(screen.getByText(/45 \\/ 100/i)).toBeDefined();\n      expect(screen.getByText(\"45%\")).toBeDefined();\n    });\n\n    it(\"shows completed status without errors\", async () => {\n      (api.fetchLatestLeaveImport as any).mockResolvedValue({\n        id: \"job-2\",\n        status: \"completed\",\n        total_rows: 50,\n        processed_rows: 50,\n        error_log: null,\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString(),\n      });\n\n      renderDialog();\n\n      await waitFor(() => {\n        expect(screen.getByText(/Import thành công/i)).toBeDefined();\n      });\n      expect(screen.getByText(\"100%\")).toBeDefined();\n    });\n\n    it(\"shows partial success status with error details and download\", async () => {\n      const errorLog = JSON.stringify({\n        success_count: 40,\n        error_count: 10,\n        error_file_path: \"/tmp/errors.xlsx\",\n      });\n\n      (api.fetchLatestLeaveImport as any).mockResolvedValue({\n        id: \"job-3\",\n        status: \"completed\",\n        total_rows: 50,\n        processed_rows: 40,\n        error_log: errorLog,\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString(),\n      });\n\n      renderDialog();\n\n      await waitFor(() => {\n        expect(screen.getByText(/Import có lỗi/i)).toBeDefined();\n      });\n      // Partial detail text\n      expect(screen.getByText(/40.*10/)).toBeDefined();\n      // Error file download button\n      expect(screen.getByText(/Tải file lỗi/i)).toBeDefined();\n    });\n\n    it(\"calls downloadLeaveImportErrors when clicking download errors button\", async () => {\n      const user = userEvent.setup({ advanceTimers: vi.advanceTimersByTime });\n      const errorLog = JSON.stringify({\n        success_count: 40,\n        error_count: 10,\n        error_file_path: \"/tmp/errors.xlsx\",\n      });\n\n      (api.fetchLatestLeaveImport as any).mockResolvedValue({\n        id: \"job-err\",\n        status: \"completed\",\n        total_rows: 50,\n        processed_rows: 40,\n        error_log: errorLog,\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString(),\n      });\n\n      renderDialog();\n\n      const errBtn = await screen.findByText(/Tải file lỗi/i);\n      await user.click(errBtn);\n\n      expect(api.downloadLeaveImportErrors).toHaveBeenCalledWith(\"ws-test\", \"job-err\");\n    });\n\n    it(\"shows failed status with error detail\", async () => {\n      (api.fetchLatestLeaveImport as any).mockResolvedValue({\n        id: \"job-4\",\n        status: \"failed\",\n        total_rows: 0,\n        processed_rows: 0,\n        error_log: \"Connection timeout to database\",\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString(),\n      });\n\n      renderDialog();\n\n      await waitFor(() => {\n        expect(screen.getByText(/Import thất bại/i)).toBeDefined();\n      });\n      expect(screen.getByText(/Chi tiết lỗi/i)).toBeDefined();\n      expect(screen.getByText(/Connection timeout/i)).toBeDefined();\n    });\n\n    it(\"shows footer buttons (upload another + close) when finished\", async () => {\n      (api.fetchLatestLeaveImport as any).mockResolvedValue({\n        id: \"job-5\",\n        status: \"completed\",\n        total_rows: 50,\n        processed_rows: 50,\n        error_log: null,\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString(),\n      });\n\n      renderDialog();\n\n      await waitFor(() => {\n        expect(screen.getByText(/Upload file khác/i)).toBeDefined();\n      });\n      expect(screen.getByText(/ĐÓNG/i)).toBeDefined();\n    });\n\n    it(\"hides footer buttons while processing\", async () => {\n      (api.fetchLatestLeaveImport as any).mockResolvedValue({\n        id: \"job-6\",\n        status: \"processing\",\n        total_rows: 100,\n        processed_rows: 10,\n        error_log: null,\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString(),\n      });\n\n      renderDialog();\n\n      await waitFor(() => {\n        expect(screen.getByText(/Đang xử lý.../i)).toBeDefined();\n      });\n      expect(screen.queryByText(/Upload file khác/i)).toBeNull();\n      expect(screen.queryByText(/ĐÓNG/i)).toBeNull();\n    });\n\n    it(\"resets to upload view when 'upload another' is clicked\", async () => {\n      const user = userEvent.setup({ advanceTimers: vi.advanceTimersByTime });\n      (api.fetchLatestLeaveImport as any).mockResolvedValue({\n        id: \"job-7\",\n        status: \"completed\",\n        total_rows: 10,\n        processed_rows: 10,\n        error_log: null,\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString(),\n      });\n\n      renderDialog();\n\n      const uploadAnotherBtn = await screen.findByText(/Upload file khác/i);\n      await user.click(uploadAnotherBtn);\n\n      // Should show upload view again\n      await waitFor(() => {\n        expect(screen.getByText(/Nhấn để chọn file Excel/i)).toBeDefined();\n      });\n    });\n  });\n\n  // ═══════════════════════════════════════════════════════════════════\n  // Callbacks\n  // ═══════════════════════════════════════════════════════════════════\n\n  describe(\"Callbacks\", () => {\n    it(\"calls onClose when cancel button is clicked\", async () => {\n      const user = userEvent.setup({ advanceTimers: vi.advanceTimersByTime });\n      renderDialog();\n\n      await user.click(screen.getByText(\"Hủy\"));\n      expect(onClose).toHaveBeenCalled();\n    });\n\n    it(\"calls onClose when close button is clicked after completion\", async () => {\n      const user = userEvent.setup({ advanceTimers: vi.advanceTimersByTime });\n      (api.fetchLatestLeaveImport as any).mockResolvedValue({\n        id: \"job-done\",\n        status: \"completed\",\n        total_rows: 10,\n        processed_rows: 10,\n        error_log: null,\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString(),\n      });\n\n      renderDialog();\n      const closeBtn = await screen.findByText(/ĐÓNG/i);\n      await user.click(closeBtn);\n      expect(onClose).toHaveBeenCalled();\n    });\n  });\n\n  // ═══════════════════════════════════════════════════════════════════\n  // Latest Job Recovery (offline resilience)\n  // ═══════════════════════════════════════════════════════════════════\n\n  describe(\"Job Recovery\", () => {\n    it(\"fetches latest import job on mount when open\", async () => {\n      renderDialog();\n      await waitFor(() => {\n        expect(api.fetchLatestLeaveImport).toHaveBeenCalledWith(\"ws-test\");\n      });\n    });\n\n    it(\"does NOT fetch latest job when isOpen is false\", () => {\n      renderDialog({ isOpen: false });\n      expect(api.fetchLatestLeaveImport).not.toHaveBeenCalled();\n    });\n\n    it(\"ignores jobs older than 24 hours\", async () => {\n      const oldDate = new Date(Date.now() - 25 * 60 * 60 * 1000).toISOString();\n      (api.fetchLatestLeaveImport as any).mockResolvedValue({\n        id: \"job-old\",\n        status: \"completed\",\n        total_rows: 10,\n        processed_rows: 10,\n        error_log: null,\n        created_at: oldDate,\n        updated_at: oldDate,\n      });\n\n      renderDialog();\n\n      // Should show upload view, not progress view\n      await waitFor(() => {\n        expect(screen.getByText(/Nhấn để chọn file Excel/i)).toBeDefined();\n      });\n    });\n\n    it(\"shows existing processing job when dialog opens\", async () => {\n      (api.fetchLatestLeaveImport as any).mockResolvedValue({\n        id: \"job-active\",\n        status: \"processing\",\n        total_rows: 200,\n        processed_rows: 80,\n        error_log: null,\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString(),\n      });\n\n      renderDialog();\n\n      await waitFor(() => {\n        expect(screen.getByText(/Đang xử lý.../i)).toBeDefined();\n      });\n      expect(screen.getByText(/80 \\/ 200/i)).toBeDefined();\n    });\n\n    it(\"handles API error when fetching latest job\", async () => {\n      (api.fetchLatestLeaveImport as any).mockRejectedValue(new Error(\"Server error\"));\n      renderDialog();\n      // Should fall back to upload view\n      await waitFor(() => {\n        expect(screen.getByText(/Nhấn để chọn file Excel/i)).toBeDefined();\n      });\n    });\n  });\n\n  // ═══════════════════════════════════════════════════════════════════\n  // Edge Cases\n  // ═══════════════════════════════════════════════════════════════════\n\n  describe(\"Edge Cases\", () => {\n    it(\"resets file state when dialog closes and reopens\", () => {\n      const { rerender } = render(\n        <LeaveImportDialog isOpen={true} onClose={onClose} />\n      );\n\n      // Select a file\n      const fileInput = document.getElementById(\"leave-import-file-input\") as HTMLInputElement;\n      fireEvent.change(fileInput, { target: { files: [createFile()] } });\n      expect(screen.getByText(\"test.xlsx\")).toBeDefined();\n\n      // Close dialog\n      rerender(<LeaveImportDialog isOpen={false} onClose={onClose} />);\n      // Reopen\n      rerender(<LeaveImportDialog isOpen={true} onClose={onClose} />);\n\n      // Should be reset\n      expect(screen.getByText(/Nhấn để chọn file Excel/i)).toBeDefined();\n    });\n\n    it(\"handles completed job with unparseable error_log\", async () => {\n      (api.fetchLatestLeaveImport as any).mockResolvedValue({\n        id: \"job-bad-log\",\n        status: \"completed\",\n        total_rows: 20,\n        processed_rows: 15,\n        error_log: \"not-json-just-text\",\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString(),\n      });\n\n      renderDialog();\n\n      await waitFor(() => {\n        expect(screen.getByText(/Import có lỗi/i)).toBeDefined();\n      });\n      // Should show partial detail with fallback values\n      expect(screen.getAllByText(/15/).length).toBeGreaterThanOrEqual(1);\n    });\n\n    it(\"handles pending job with zero total_rows\", async () => {\n      (api.fetchLatestLeaveImport as any).mockResolvedValue({\n        id: \"job-pending\",\n        status: \"pending\",\n        total_rows: 0,\n        processed_rows: 0,\n        error_log: null,\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString(),\n      });\n\n      renderDialog();\n\n      await waitFor(() => {\n        expect(screen.getByText(/Đang xử lý.../i)).toBeDefined();\n      });\n      // Should show \"0 / ?\" for rows\n      expect(screen.getByText(/0 \\/ \\?/)).toBeDefined();\n    });\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/monitor/JobStatusDistributionChart.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/work