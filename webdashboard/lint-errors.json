e":"import React, { useState } from \"react\";\n\nimport { useQuery, useMutation, useQueryClient } from \"@tanstack/react-query\";\nimport { Plus, Trash2, Clock, Pencil, ShieldCheck, Milestone, LayoutGrid } from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { Combobox } from \"@/components/ui/Combobox\";\nimport Modal from \"@/components/ui/Modal\";\nimport { useToast } from \"@/components/ui/Toast\";\n\nimport { useConfirm } from \"@/hooks/use-confirm\";\nimport { fetchLeavePolicies, createLeavePolicy, deleteLeavePolicy, updateLeavePolicy, fetchLeaveTypes } from \"@/lib/api/leaves\";\nimport { LeavePolicy, LeaveType } from \"@/lib/api/types\";\nimport { cn } from \"@/lib/utils\";\nconst FormRow = ({ label, children, info }: { label: string; children: React.ReactNode; info?: string }) => (\n  <div className=\"grid grid-cols-1 md:grid-cols-12 gap-4 items-center group\">\n    <div className=\"md:col-span-4 md:text-right\">\n      <label className=\"text-[10px] font-black text-slate-400 dark:text-slate-500 uppercase tracking-[0.2em] group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors\">\n        {label}\n      </label>\n    </div>\n    <div className=\"md:col-span-8 flex flex-col\">\n      <div className=\"w-full max-w-md\">\n        {children}\n      </div>\n      {info && <p className=\"text-[9px] text-slate-400 dark:text-slate-500 italic font-medium ml-1 mt-1\">{info}</p>}\n    </div>\n  </div>\n);\n\n\ninterface LeavePolicyManagerProps {\n  wsId: string;\n}\n\nexport function LeavePolicyManager({ wsId }: LeavePolicyManagerProps) {\n  const { t } = useTranslation();\n  const toast = useToast();\n  const queryClient = useQueryClient();\n  const [isCreating, setIsCreating] = useState(false);\n  const [editingPolicy, setEditingPolicy] = useState<LeavePolicy | null>(null);\n  const { confirm, ConfirmationDialog } = useConfirm();\n\n  const { data: policies = [], isLoading } = useQuery({\n    queryKey: [\"leave-policies\", wsId],\n    queryFn: () => fetchLeavePolicies(wsId),\n  });\n\n  const { data: leaveTypes = [] } = useQuery({\n    queryKey: [\"leave-types\", wsId],\n    queryFn: () => fetchLeaveTypes(wsId),\n  });\n\n  const deleteMutation = useMutation({\n    mutationFn: (id: string) => deleteLeavePolicy(wsId, id),\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: [\"leave-policies\"] });\n      toast.success(\"Policy deleted successfully\");\n    },\n  });\n\n  const handleDelete = async (id: string) => {\n    const ok = await confirm({\n      title: t(\"common.warning\", { defaultValue: \"Warning\" }),\n      message: t(\"leave.policy.confirm_delete\", { defaultValue: \"Delete this policy?\" }),\n      variant: \"danger\"\n    });\n    if (ok) deleteMutation.mutate(id);\n  };\n\n  const mutation = useMutation({\n    mutationFn: (data: Partial<LeavePolicy>) => \n      editingPolicy ? updateLeavePolicy(wsId, editingPolicy.id, data) : createLeavePolicy(wsId, data),\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: [\"leave-policies\"] });\n      toast.success(editingPolicy ? \"Policy updated\" : \"Policy created\");\n      setIsCreating(false);\n      setEditingPolicy(null);\n    },\n    onError: (error: Error) => toast.error(error.message),\n  });\n\n  const calculateAnnualEntitlement = (policy: LeavePolicy) => {\n    const amount = policy.rule_config.accrual_amount;\n    switch (policy.rule_config.frequency) {\n      case \"monthly\": return amount * 12;\n      case \"quarterly\": return amount * 4;\n      case \"yearly\": return amount;\n      default: return amount;\n    }\n  };\n\n  if (isLoading) return <div className=\"p-12 text-center text-slate-400 dark:text-slate-500 animate-pulse font-bold uppercase tracking-widest text-[10px]\">Loading policies...</div>;\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex justify-end px-1\">\n         <button data-testid=\"add-policy-btn\" onClick={() => setIsCreating(true)} className=\"flex items-center gap-2 rounded-xl bg-primary-600 px-6 py-2.5 text-[10px] font-bold text-white uppercase tracking-widest hover:bg-primary-700 transition-all shadow-lg shadow-primary-100\"><Plus size={14} /> Create Policy</button>\n      </div>\n\n      <div className=\"grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3\">\n        {policies.length === 0 ? (\n          <div className=\"col-span-full py-20 bg-slate-50 dark:bg-slate-800 border-2 border-dashed border-slate-200 dark:border-slate-700 rounded-[2.5rem] flex flex-col items-center justify-center text-slate-400 dark:text-slate-500\">\n            <ShieldCheck size={40} className=\"mb-4 opacity-20\" />\n            <p className=\"text-xs font-bold uppercase tracking-widest\">No policies defined yet</p>\n          </div>\n        ) : policies.map((policy) => {\n          const type = leaveTypes.find(t => t.id === policy.leave_type_id);\n          const bonusCount = policy.rule_config.seniority_bonus?.length || 0;\n          return (\n            <div key={policy.id} className=\"relative flex flex-col justify-between rounded-[2rem] border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-7 shadow-sm hover:shadow-md transition-all group\">\n              <div>\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"inline-flex items-center rounded-lg bg-primary-50 dark:bg-primary-950 px-2.5 py-1 text-[9px] font-bold text-primary-600 dark:text-primary-400 uppercase tracking-widest border border-primary-100 dark:border-primary-800 shadow-sm\">\n                    {type?.name || \"Unknown\"}\n                  </span>\n                  <div className=\"flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity\">\n                    <button data-testid=\"edit-policy-btn\" onClick={() => setEditingPolicy(policy)} className=\"p-2 text-slate-400 dark:text-slate-500 hover:text-primary-600 dark:text-primary-400 bg-slate-50 dark:bg-slate-800 rounded-xl border border-slate-100 dark:border-slate-800\"><Pencil size={16} /></button>\n                    <button data-testid=\"delete-policy-btn\" onClick={() => handleDelete(policy.id)} className=\"p-2 text-slate-400 dark:text-slate-500 hover:text-rose-600 dark:text-rose-300 bg-slate-50 dark:bg-slate-800 rounded-xl border border-slate-100 dark:border-slate-800\"><Trash2 size={16} /></button>\n                  </div>\n                </div>\n                <h3 className=\"mt-5 text-lg font-bold text-slate-800 dark:text-slate-100 tracking-tight leading-none uppercase\">{policy.name}</h3>\n                \n                <div className=\"mt-6 p-4 bg-slate-50 dark:bg-slate-800 rounded-2xl border border-slate-100 dark:border-slate-800 space-y-3\">\n                  <div className=\"flex items-center justify-between\">\n                    <div className=\"flex items-center gap-2 text-slate-400 dark:text-slate-500\"><Clock size={14} /><span className=\"text-[10px] font-bold uppercase tracking-widest\">Base Accrual</span></div>\n                    <span className=\"text-[10px] font-bold text-slate-600 dark:text-slate-300 uppercase tracking-widest\">{policy.rule_config.accrual_amount} / {policy.rule_config.frequency}</span>\n                  </div>\n                  <div className=\"flex items-center justify-between\">\n                    <div className=\"flex items-center gap-2 text-slate-400 dark:text-slate-500\"><Milestone size={14} /><span className=\"text-[10px] font-bold uppercase tracking-widest\">Bonus Steps</span></div>\n                    <span className=\"text-[10px] font-bold text-primary-600 dark:text-primary-400 uppercase tracking-widest\">{bonusCount} steps</span>\n                  </div>\n                </div>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n\n      {(isCreating || editingPolicy) && (\n        <PolicyModal\n          isOpen={true}\n          onClose={() => { setIsCreating(false); setEditingPolicy(null); }}\n          leaveTypes={leaveTypes}\n          policy={editingPolicy}\n          onSave={(data: any) => mutation.mutate(data)}\n          isSaving={mutation.isPending}\n        />\n      )}\n      <ConfirmationDialog />\n    </div>\n  );\n}\n\nfunction PolicyModal({ isOpen, onClose, leaveTypes, policy, onSave, isSaving }: any) {\n  const [formData, setFormData] = useState({\n    name: policy?.name || \"\",\n    description: policy?.description || \"\",\n    leave_type_id: policy?.leave_type_id || (leaveTypes.length > 0 ? leaveTypes[0].id : \"\"),\n    accrual_amount: policy?.rule_config.accrual_amount || 1.0,\n    frequency: policy?.rule_config.frequency || \"monthly\",\n    carry_over_limit: policy?.rule_config.carry_over_limit || 5,\n    min_work_days_threshold: policy?.rule_config.min_work_days_threshold || 14\n  });\n\n  const [seniorityBonus, setSeniorityBonus] = useState<{ months: number; bonus_amount: number }[]>(\n    policy?.rule_config.seniority_bonus || []\n  );\n\n  const addBonusMilestone = () => {\n    setSeniorityBonus([...seniorityBonus, { months: 12, bonus_amount: 1.0 }]);\n  };\n\n  const removeBonusMilestone = (index: number) => {\n    setSeniorityBonus(seniorityBonus.filter((_, i) => i !== index));\n  };\n\n  const updateBonusMilestone = (index: number, field: \"months\" | \"bonus_amount\", value: number) => {\n    const next = [...seniorityBonus];\n    next[index] = { ...next[index], [field]: value };\n    setSeniorityBonus(next);\n  };\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    onSave({\n      ...formData,\n      rule_config: {\n        frequency: formData.frequency,\n        accrual_amount: formData.accrual_amount,\n        accrual_timing: \"start_of_period\",\n        carry_over_limit: formData.carry_over_limit,\n        min_work_days_threshold: formData.min_work_days_threshold,\n        seniority_bonus: seniorityBonus.sort((a, b) => a.months - b.months)\n      }\n    });\n  };\n\n\n\n  return (\n    <Modal isOpen={isOpen} onClose={onClose} title={policy ? \"Edit Policy\" : \"Create Leave Policy\"} maxWidth=\"lg\">\n      <form onSubmit={handleSubmit} className=\"p-8 space-y-12 max-h-[85vh] overflow-y-auto custom-scrollbar\">\n        {/* IDENTITY */}\n        <div className=\"space-y-8\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"h-8 w-8 rounded-xl bg-primary-50 dark:bg-primary-950 flex items-center justify-center text-primary-600 dark:text-primary-400\"><LayoutGrid size={18} /></div>\n            <h4 className=\"text-sm font-black text-slate-800 dark:text-slate-100 uppercase tracking-tighter\">Identity</h4>\n          </div>\n          <div className=\"space-y-6 px-2\">\n            <FormRow label=\"Policy Name\">\n              <input required type=\"text\" value={formData.name} onChange={(e) => setFormData({...formData, name: e.target.value})} className=\"w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-3 text-sm font-bold outline-none focus:ring-4 focus:ring-primary-500/5 transition-all h-[54px]\" id=\"policy-name\" placeholder=\"e.g. Standard Policy\" />\n            </FormRow>\n            <FormRow label=\"Leave Type\">\n              <Combobox options={leaveTypes.map((t: any) => ({ value: t.id, label: t.name }))} value={formData.leave_type_id} onChange={(val) => setFormData({...formData, leave_type_id: val})} className=\"bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-700 h-[54px] rounded-xl\" />\n            </FormRow>\n          </div>\n        </div>\n\n        {/* ACCRUAL RULES */}\n        <div className=\"space-y-8\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"h-8 w-8 rounded-xl bg-emerald-50 dark:bg-emerald-950 flex items-center justify-center text-emerald-600 dark:text-emerald-300\"><Clock size={18} /></div>\n            <h4 className=\"text-sm font-black text-slate-800 dark:text-slate-100 uppercase tracking-tighter\">Accrual Logic</h4>\n          </div>\n          <div className=\"bg-slate-50 dark:bg-slate-800/50 p-10 rounded-[2.5rem] border border-slate-100 dark:border-slate-800 space-y-6\">\n            <FormRow label=\"Base Amount\" info=\"Days to grant per period\">\n              <input required type=\"number\" step=\"0.1\" id=\"annual-entitlement\" value={formData.accrual_amount} onChange={(e) => setFormData({...formData, accrual_amount: parseFloat(e.target.value)})} className=\"w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-3 text-sm font-bold font-mono text-center h-[54px]\" />\n            </FormRow>\n            <FormRow label=\"Frequency\">\n              <select value={formData.frequency} onChange={(e) => setFormData({...formData, frequency: e.target.value})} className=\"w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-3 text-sm font-bold uppercase h-[54px]\">\n                <option value=\"monthly\">Monthly</option>\n                <option value=\"quarterly\">Quarterly</option>\n                <option value=\"yearly\">Yearly</option>\n              </select>\n            </FormRow>\n            <FormRow label=\"Min Days Work\" info=\"Threshold to receive accrual\">\n              <input required type=\"number\" step=\"0.5\" value={formData.min_work_days_threshold} onChange={(e) => setFormData({...formData, min_work_days_threshold: parseFloat(e.target.value)})} className=\"w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-3 text-sm font-bold font-mono text-center text-amber-600 dark:text-amber-300 h-[54px]\" />\n            </FormRow>\n            <FormRow label=\"Carry Limit\" info=\"Max days to carry over next year\">\n              <input required type=\"number\" value={formData.carry_over_limit} onChange={(e) => setFormData({...formData, carry_over_limit: parseInt(e.target.value)})} className=\"w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-3 text-sm font-bold font-mono text-center h-[54px]\" />\n            </FormRow>\n          </div>\n        </div>\n\n        {/* SENIORITY BONUS */}\n        <div className=\"space-y-8\">\n          <div className=\"flex justify-between items-center px-1\">\n            <div className=\"flex items-center gap-3\">\n              <div className=\"h-8 w-8 rounded-xl bg-indigo-50 dark:bg-indigo-950 flex items-center justify-center text-indigo-600\"><Milestone size={18} /></div>\n              <h4 className=\"text-sm font-black text-slate-800 dark:text-slate-100 uppercase tracking-tighter\">Service Bonuses</h4>\n            </div>\n            <button type=\"button\" onClick={addBonusMilestone} className=\"flex items-center gap-2 rounded-xl bg-indigo-600 px-4 py-2 text-[10px] font-bold text-white uppercase tracking-widest hover:bg-indigo-700 transition-all shadow-lg shadow-indigo-100\"><Plus size={12} /> Add Row</button>\n          </div>\n          \n          <div className=\"space-y-8 px-2\">\n            {seniorityBonus.length === 0 ? (\n              <div className=\"py-10 text-center bg-white dark:bg-slate-900 border-2 border-dashed border-slate-100 dark:border-slate-800 rounded-[2rem] text-slate-400 dark:text-slate-500 italic text-xs\">No bonus milestones defined.</div>\n            ) : seniorityBonus.map((bonus, idx) => (\n              <div key={idx} className=\"space-y-6 pt-8 first:pt-0 border-t first:border-0 border-slate-100 dark:border-slate-800 animate-in slide-in-from-right-2 duration-300 relative group/row\">\n                <div className=\"absolute -left-4 top-10 font-black text-[8px] text-slate-300 dark:text-slate-600 uppercase vertical-text tracking-widest\">Row {idx + 1}</div>\n                \n                <FormRow label=\"After Months\">\n                  <input type=\"number\" value={bonus.months} onChange={(e) => updateBonusMilestone(idx, \"months\", parseInt(e.target.value))} className=\"w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-3 text-sm font-bold font-mono text-center h-[54px] focus:ring-4 focus:ring-indigo-500/5 transition-all outline-none\" />\n                </FormRow>\n                \n                <FormRow label=\"Bonus Amount\">\n                  <div className=\"flex gap-4 w-full max-w-md\">\n                    <input type=\"number\" step=\"0.5\" value={bonus.bonus_amount} onChange={(e) => updateBonusMilestone(idx, \"bonus_amount\", parseFloat(e.target.value))} className=\"flex-1 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-3 text-sm font-bold font-mono text-center text-primary-600 dark:text-primary-400 h-[54px] focus:ring-4 focus:ring-primary-500/5 transition-all outline-none\" />\n                    <button type=\"button\" onClick={() => removeBonusMilestone(idx)} className=\"p-4 text-slate-300 dark:text-slate-600 hover:text-rose-600 dark:text-rose-300 hover:bg-rose-50 dark:bg-rose-950 rounded-2xl transition-all h-[54px] flex items-center justify-center border border-transparent hover:border-rose-100 dark:border-rose-800 shadow-sm hover:shadow-md\"><Trash2 size={18} /></button>\n                  </div>\n                </FormRow>\n              </div>\n            ))}\n          </div>\n        </div>\n\n        {/* FOOTER */}\n        <div className=\"flex justify-end gap-4 pt-8 border-t border-slate-100 dark:border-slate-800 sticky bottom-0 bg-white dark:bg-slate-900 pb-2\">\n          <button type=\"button\" onClick={onClose} className=\"px-8 py-3 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-[0.2em] hover:text-slate-600 dark:hover:text-slate-300 dark:text-slate-600\">Cancel</button>\n          <button type=\"submit\" data-testid=\"save-policy-btn\" disabled={isSaving} className=\"rounded-2xl bg-primary-600 px-10 py-4 text-xs font-black text-white uppercase tracking-[0.2em] shadow-2xl shadow-primary-200 hover:bg-primary-700 active:scale-95 transition-all\">\n            {isSaving ? \"Saving...\" : (policy ? \"Update Policy\" : \"Create Policy\")}\n          </button>\n        </div>\n      </form>\n    </Modal>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/leave/LeaveTypeManager.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'t' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":19,"column":11,"nodeType":"Identifier","messageId":"unusedVar","endLine":19,"endColumn":12},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":97,"column":97,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":97,"endColumn":100,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[5615,5618],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[5615,5618],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":111,"column":59,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":111,"endColumn":62,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[6681,6684],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[6681,6684],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"jsx-a11y/label-has-associated-control","severity":2,"message":"A form label must be associated with a control.","line":118,"column":176,"nodeType":"JSXOpeningElement","endLine":118,"endColumn":223},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":125,"column":71,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":125,"endColumn":74,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[7972,7975],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[7972,7975],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":5,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from \"react\";\n\nimport { useQuery, useMutation, useQueryClient } from \"@tanstack/react-query\";\nimport { Wallet, AlertTriangle, Pencil, Plus, Trash2 } from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport Modal from \"@/components/ui/Modal\";\nimport { useToast } from \"@/components/ui/Toast\";\n\nimport { fetchLeaveTypes, updateLeaveTypeConfig, createLeaveType, deleteLeaveType } from \"@/lib/api/leaves\";\nimport { LeaveType, LeaveTypeConfig } from \"@/lib/api/types\";\nimport { cn } from \"@/lib/utils\";\n\ninterface LeaveTypeManagerProps {\n  wsId: string;\n}\n\nexport function LeaveTypeManager({ wsId }: LeaveTypeManagerProps) {\n  const { t } = useTranslation();\n  const toast = useToast();\n  const queryClient = useQueryClient();\n  \n  const [editingType, setEditingType] = useState<LeaveType | null>(null);\n  const [isAddingType, setIsAddingType] = useState(false);\n  const [deletingType, setDeletingType] = useState<LeaveType | null>(null);\n\n  const { data: leaveTypes = [], isLoading: isTypesLoading } = useQuery({\n    queryKey: [\"leave-types\", wsId],\n    queryFn: () => fetchLeaveTypes(wsId),\n  });\n\n  const createTypeMutation = useMutation({\n    mutationFn: (data: { code: string; name: string; is_paid: boolean }) => createLeaveType(wsId, data),\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: [\"leave-types\"] });\n      toast.success(\"Leave type created successfully\");\n      setIsAddingType(false);\n    },\n    onError: (error: Error) => toast.error(error.message),\n  });\n\n  const updateTypeMutation = useMutation({\n    mutationFn: (data: { typeId: string; config: LeaveTypeConfig }) => updateLeaveTypeConfig(wsId, data.typeId, data.config),\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: [\"leave-types\"] });\n      toast.success(\"Leave type updated successfully\");\n      setEditingType(null);\n    },\n    onError: () => toast.error(\"Failed to update leave type\"),\n  });\n\n  const deleteTypeMutation = useMutation({\n    mutationFn: (typeId: string) => deleteLeaveType(wsId, typeId),\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: [\"leave-types\"] });\n      toast.success(\"Leave type deleted successfully\");\n      setDeletingType(null);\n    },\n    onError: (error: Error) => {\n      toast.error(error.message);\n      setDeletingType(null);\n    },\n  });\n\n  if (isTypesLoading) return <div className=\"py-12 text-center text-slate-400 dark:text-slate-500 animate-pulse\">Loading leave types...</div>;\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex justify-between items-center px-1\">\n         <p className=\"text-xs font-medium text-slate-500 dark:text-slate-400 max-w-md italic\">Define the categories of leave available in your organization (e.g., Annual Leave, Sick Leave).</p>\n         <button onClick={() => setIsAddingType(true)} className=\"flex items-center gap-2 rounded-xl bg-primary-600 px-6 py-2.5 text-[10px] font-bold text-white uppercase tracking-widest hover:bg-primary-700 transition-all shadow-lg shadow-primary-100\"><Plus size={14} /> Add Leave Type</button>\n      </div>\n      \n      <div className=\"grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3\">\n        {leaveTypes.map((type) => (\n          <div key={type.id} className=\"relative flex flex-col justify-between rounded-[2rem] border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-7 shadow-sm hover:shadow-md transition-all group\">\n            <div>\n              <div className=\"flex items-center justify-between\">\n                <div className={cn(\"flex h-12 w-12 items-center justify-center rounded-2xl shadow-inner\", type.is_paid ? \"bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-300 border border-emerald-100 dark:border-emerald-800\" : \"bg-amber-50 dark:bg-amber-950 text-amber-600 dark:text-amber-300 border border-amber-100 dark:border-amber-800\")}>\n                  {type.is_paid ? <Wallet size={20} /> : <AlertTriangle size={20} />}\n                </div>\n                <div className=\"flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity\">\n                  <button onClick={() => setEditingType(type)} className=\"p-2 text-slate-400 dark:text-slate-500 hover:text-primary-600 dark:text-primary-400 bg-slate-50 dark:bg-slate-800 rounded-xl border border-slate-100 dark:border-slate-800\"><Pencil size={16} /></button>\n                  <button onClick={() => setDeletingType(type)} className=\"p-2 text-slate-400 dark:text-slate-500 hover:text-rose-600 dark:text-rose-300 bg-slate-50 dark:bg-slate-800 rounded-xl border border-slate-100 dark:border-slate-800\"><Trash2 size={16} /></button>\n                </div>\n              </div>\n              <h3 className=\"mt-5 text-lg font-bold text-slate-800 dark:text-slate-100 tracking-tight leading-none uppercase\">{type.name}</h3>\n              <p className=\"mt-1 text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest\">Code: {type.code}</p>\n              <div className=\"mt-4 flex gap-2\">\n                 <span className={cn(\"px-2.5 py-1 rounded-lg text-[9px] font-bold uppercase tracking-widest border\", type.is_paid ? \"bg-emerald-50 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300 border-emerald-100 dark:border-emerald-800\" : \"bg-amber-50 dark:bg-amber-950 text-amber-700 dark:text-amber-300 border-amber-100 dark:border-amber-800\")}>{type.is_paid ? \"Paid\" : \"Unpaid\"}</span>\n              </div>\n            </div>\n          </div>\n        ))}\n      </div>\n\n      {isAddingType && <AddLeaveTypeModal onClose={() => setIsAddingType(false)} onSave={(data: any) => createTypeMutation.mutate(data)} isSaving={createTypeMutation.isPending} />}\n      {editingType && <EditLeaveTypeModal leaveType={editingType} onClose={() => setEditingType(null)} onSave={(config: LeaveTypeConfig) => updateTypeMutation.mutate({ typeId: editingType.id, config })} isSaving={updateTypeMutation.isPending} />}\n      {deletingType && (\n        <Modal isOpen={true} onClose={() => setDeletingType(null)} title=\"Confirm Delete\">\n          <div className=\"p-8\">\n            <p className=\"text-sm\">Are you sure you want to delete \"{deletingType.name}\"?</p>\n            <div className=\"mt-8 flex justify-end gap-3\"><button onClick={() => setDeletingType(null)} className=\"px-6 py-2 text-xs font-bold text-slate-400 dark:text-slate-500\">Cancel</button><button onClick={() => deleteTypeMutation.mutate(deletingType.id)} className=\"rounded-xl bg-rose-600 px-6 py-2.5 text-[10px] font-bold text-white uppercase\">Delete</button></div>\n          </div>\n        </Modal>\n      )}\n    </div>\n  );\n}\n\nfunction AddLeaveTypeModal({ onClose, onSave, isSaving }: any) {\n  const [formData, setFormData] = useState({ code: \"\", name: \"\", is_paid: true });\n  return (\n    <Modal isOpen={true} onClose={onClose} title=\"Add Leave Type\">\n      <form onSubmit={(e) => { e.preventDefault(); onSave(formData); }} className=\"p-8 space-y-5\">\n        <input required type=\"text\" placeholder=\"Code\" value={formData.code} onChange={(e) => setFormData({ ...formData, code: e.target.value.toUpperCase() })} className=\"w-full rounded-2xl border p-4 text-sm\" />\n        <input required type=\"text\" placeholder=\"Name\" value={formData.name} onChange={(e) => setFormData({ ...formData, name: e.target.value })} className=\"w-full rounded-2xl border p-4 text-sm\" />\n        <div className=\"flex items-center gap-3\"><input type=\"checkbox\" checked={formData.is_paid} onChange={(e) => setFormData({ ...formData, is_paid: e.target.checked })} /><label className=\"text-xs font-bold uppercase\">Paid Leave?</label></div>\n        <div className=\"flex justify-end gap-3 pt-6\"><button type=\"button\" onClick={onClose}>Cancel</button><button type=\"submit\" disabled={isSaving} className=\"rounded-xl bg-primary-600 px-8 py-3 text-xs font-bold text-white uppercase\">Create</button></div>\n      </form>\n    </Modal>\n  );\n}\n\nfunction EditLeaveTypeModal({ leaveType, onClose, onSave, isSaving }: any) {\n  const [config, setConfig] = useState(leaveType.policy_config || { approval_required: true, requires_document: false, allow_negative_balance: false });\n  return (\n    <Modal isOpen={true} onClose={onClose} title={`Config: ${leaveType.name}`}>\n      <form onSubmit={(e) => { e.preventDefault(); onSave(config); }} className=\"p-8 space-y-4\">\n        <label className=\"flex items-center gap-3\"><input type=\"checkbox\" checked={config.approval_required} onChange={(e) => setConfig({ ...config, approval_required: e.target.checked })} /><span className=\"text-xs font-bold uppercase\">Approval Required</span></label>\n        <div className=\"flex justify-end gap-3 pt-6\"><button type=\"button\" onClick={onClose}>Cancel</button><button type=\"submit\" disabled={isSaving} className=\"rounded-xl bg-primary-600 px-8 py-3 text-xs font-bold text-white uppercase\">Save</button></div>\n      </form>\n    </Modal>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/leave/__tests__/AssignPolicyModal.test.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":33,"column":35,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":33,"endColumn":38,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[949,952],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[949,952],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":34,"column":28,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":34,"endColumn":31,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1012,1015],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1012,1015],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":37,"column":30,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":37,"endColumn":33,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1207,1210],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1207,1210],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"