unt":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from \"react\";\n\nimport { createFileRoute, Outlet, redirect } from \"@tanstack/react-router\";\n\nimport { profileKeys } from \"@/hooks/use-profile\";\nimport { fetchMe, clearAuthSession } from \"@/lib/api\";\n\nfunction AuthPendingComponent() {\n  const { t } = (window as any).__i18n_t__ ?? { t: (k: string) => k };\n  return (\n    <div className=\"min-h-screen flex items-center justify-center bg-slate-50 dark:bg-slate-800\">\n      <div className=\"flex flex-col items-center gap-4\">\n        <div className=\"animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600\" />\n        <p className=\"text-slate-500 dark:text-slate-400 text-sm\">\n          {t(\"auth.checking_security\")}\n        </p>\n      </div>\n    </div>\n  );\n}\n\nexport const Route = createFileRoute(\"/_authenticated\")({\n  beforeLoad: async ({ context }) => {\n    try {\n      const user = await context.queryClient.ensureQueryData({\n        queryKey: profileKeys.me,\n        queryFn: fetchMe,\n      });\n      if (!user) {\n        clearAuthSession();\n        throw redirect({ to: \"/login\" });\n      }\n      return { user };\n    } catch (error: any) {\n      // If it's already a redirect, rethrow\n      if (error?.isRedirect) throw error;\n      \n      // Prevent infinite redirect loops by clearing the session \n      // before sending the user back to the login page.\n      clearAuthSession();\n      \n      // Auth failure or network error → redirect to login\n      throw redirect({ to: \"/login\" });\n    }\n  },\n  pendingComponent: AuthPendingComponent,\n  component: Outlet,\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/routes/_authenticated/_infra.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Outlet' is defined but never used. Allowed unused vars must match /^_/u.","line":1,"column":27,"nodeType