r) => {\n    const value = Math.round(c + (percent / 100) * (percent > 0 ? 255 - c : c));\n    return Math.min(255, Math.max(0, value)).toString(16).padStart(2, '0');\n  };\n\n  return `#${calculate(r)}${calculate(g)}${calculate(b)}`;\n}\n\nexport function useTheme() {\n  const { workspace } = useWorkspace();\n  const [userColor, setUserColor] = useState<string | null>(localStorage.getItem('user_theme_primary_color'));\n  const [previewColor, setPreviewColor] = useState<string | null>(null);\n\n  useEffect(() => {\n    // Listen for storage changes (to sync across tabs or from Profile page)\n    const handleStorage = () => {\n      setUserColor(localStorage.getItem('user_theme_primary_color'));\n    };\n\n    const handlePreview = (e: any) => {\n      setPreviewColor(e.detail);\n    };\n\n    window.addEventListener('storage', handleStorage);\n    // Custom event for same-tab updates\n    window.addEventListener('theme-change', handleStorage);\n    // Live preview event\n    window.addEventListener('theme-preview' as any, handlePreview);\n    \n    return () => {\n      window.removeEventListener('storage', handleStorage);\n      window.removeEventListener('theme-change', handleStorage);\n      window.removeEventListener('theme-preview' as any, handlePreview);\n    };\n  }, []);\n\n  const primaryColor = previewColor || userColor || workspace?.theme_primary_color || '#10b981';\n\n  useEffect(() => {\n    const root = document.documentElement;\n    \n    const shades = {\n      50: adjustBrightness(primaryColor, 95),\n      100: adjustBrightness(primaryColor, 85),\n      200: adjustBrightness(primaryColor, 70),\n      300: adjustBrightness(primaryColor, 50),\n      400: adjustBrightness(primaryColor, 30),\n      500: primaryColor,\n      600: adjustBrightness(primaryColor, -10),\n      700: adjustBrightness(primaryColor, -25),\n      800: adjustBrightness(primaryColor, -40),\n      900: adjustBrightness(primaryColor, -55),\n      950: adjustBrightness(primaryColor, -70),\n    };\n\n    Object.entries(shades).forEach(([shade, color]) => {\n      root.style.setProperty(`--primary-${shade}`, color);\n    });\n\n    root.style.setProperty('--sidebar-primary', primaryColor);\n  }, [primaryColor]);\n\n  return {\n    primaryColor,\n    isOverridden: !!userColor,\n    setUserTheme: (color: string | null) => {\n      if (color) {\n        localStorage.setItem('user_theme_primary_color', color);\n      } else {\n        localStorage.removeItem('user_theme_primary_color');\n      }\n      setUserColor(color);\n      window.dispatchEvent(new Event('theme-change'));\n    },\n    setPreviewTheme: (color: string | null) => {\n      window.dispatchEvent(new CustomEvent('theme-preview', { detail: color }));\n    }\n  };\n}","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/hooks/use-version-check.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/hooks/use-websocket.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":15,"column":36,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":15,"endColumn":39,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[508,511],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[508,511],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\"use client\";\n\nimport { useEffect, useRef, useState } from \"react\";\n\nimport { WS_BASE_URL } from \"@/lib/api\";\n\nexport type ReportStreamMessage = \n  | { type: \"CHUNK\"; batch_index: number; total_batches: number; data: string }\n  | { type: \"DONE\"; total_batches: number; total_records: number }\n  | { type: \"ERROR\"; message: string; batch_index: number | null };\n\nexport type WsMessage = \n  | { type: \"handshake\"; client_type: \"dashboard\" | \"agent\" }\n  | ReportStreamMessage\n  | { type: string; [key: string]: any }; // Fallback for other message types\n\nexport function useWebSocket() {\n  const [isConnected, setIsConnected] = useState(false);\n  const [lastMessage, setLastMessage] = useState<WsMessage | null>(null);\n  const socketRef = useRef<WebSocket | null>(null);\n  const pingIntervalRef = useRef<NodeJS.Timeout | null>(null);\n\n  useEffect(() => {\n    const socket = new WebSocket(WS_BASE_URL);\n    socketRef.current = socket;\n\n    socket.onopen = () => {\n      setIsConnected(true);\n      console.log(\"Connected to API Server WebSocket\");\n\n      // Handshake cho Dashboard (nếu cần phân biệt với Agent)\n      const handshake: WsMessage = {\n        type: \"handshake\",\n        client_type: \"dashboard\",\n      };\n      socket.send(JSON.stringify(handshake));\n\n      // Bật heartbeat ping mỗi 30s để giữ kết nối qua proxy/Cloudflare\n      pingIntervalRef.current = setInterval(() => {\n        if (socket.readyState === WebSocket.OPEN) {\n          socket.send(JSON.stringify({ type: \"ping\" }));\n        }\n      }, 30000);\n    };\n\n    socket.onmessage = (event) => {\n      try {\n        const data = JSON.parse(event.data) as WsMessage;\n        setLastMessage(data);\n      } catch (e) {\n        console.error(\"Failed to parse WS message\", e);\n      }\n    };\n\n    socket.onclose = () => {\n      setIsConnected(false);\n      console.log(\"Disconnected from API Server WebSocket\");\n    };\n\n    return () => {\n      if (pingIntervalRef.current) {\n        clearInterval(pingIntervalRef.current);\n        pingIntervalRef.current = null;\n      }\n      socket.close();\n    };\n  }, []);\n\n  const sendMessage = (msg: WsMessage) => {\n    if (socketRef.current?.readyState === WebSocket.OPEN) {\n      socketRef.current.send(JSON.stringify(msg));\n    }\n  };\n\n  return { isConnected, lastMessage, sendMessage };\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/hooks/use-worker-monitor.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/hooks/use-workspace.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'e' is defined but never used.","line":303,"column":18,"nodeType":"Identifier","messageId":"unusedVar","endLine":303,"endColumn":19}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useQuery, useMutation, useQueryClient } from \"@tanstack/react-query\";\n\nimport {\n  fetchWorkspaces,\n  fetchWorkspace,\n  createWorkspace,\n  fetchWorkspaceMembers,\n  addWorkspaceMember,\n  removeWorkspaceMember,\n  updateWorkspaceMemberRole,\n  fetchMemberRoles,\n  assignExtraRole,\n  revokeExtraRole,\n  fetchMemberPermissions,\n  assignExtraPermission,\n  revokeExtraPermission,\n  fetchAvailablePermissions,\n  getCurrentWorkspaceId,\n  fetchWorkspaceRoles,\n  createWorkspaceRole,\n  updateWorkspaceRole,\n  deleteWorkspaceRole,\n  fetchRolePermissions,\n  updateRolePermissions,\n} from \"@/lib/api\";\n\nexport const workspaceKeys = {\n  all: [\"workspaces\"] as const,\n  members: (wsId: string) => [\"workspaces\", wsId, \"members\"] as const,\n  roles: (wsId: string, userId: string) =>\n    [\"workspaces\", wsId, \"members\", userId, \"roles\"] as const,\n  permissions: (wsId: string, userId: string) =>\n    [\"workspaces\", wsId, \"members\", userId, \"permissions\"] as const,\n  availablePermissions: (wsId: string) =>\n    [\"workspaces\", wsId, \"permissions\", \"available\"] as const,\n  workspaceRoles: (wsId: string) => [\"workspaces\", wsId, \"roles\"] as const,\n  rolePermissions: (wsId: string, roleId: string) => [\"workspaces\", wsId, \"roles\", roleId, \"permissions\"] as const,\n  permissionsMatrix: (wsId: string) => [\"workspaces\", wsId, \"permissions\", \"matrix\"] as const,\n};\n\nexport function useWorkspaces() {\n  const queryClient = useQueryClient();\n\n  const workspacesQuery = useQuery({\n    queryKey: workspaceKeys.all,\n    queryFn: fetchWorkspaces,\n  });\n\n  const createMutation = useMutation({\n    mutationFn: createWorkspace,\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: workspaceKeys.all });\n    },\n  });\n\n  return {\n    workspaces: workspacesQuery.data ?? [],\n    isLoading: workspacesQuery.isLoading,\n    isError: workspacesQuery.isError,\n    createWorkspace: createMutation.mutateAsync,\n  };\n}\n\nexport function useWorkspace(wsId?: string) {\n  const activeWsId = wsId || getCurrentWorkspaceId();\n\n  const workspaceQuery = useQuery({\n    queryKey: [\"workspace\", activeWsId],\n    queryFn: () => fetchWorkspace(activeWsId!),\n    enabled: !!activeWsId,\n  });\n\n  return {\n    workspace: workspaceQuery.data,\n    isLoading: workspaceQuery.isLoading,\n    isError: workspaceQuery.isError,\n  };\n}\n\nexport function useWorkspaceRoles(wsId?: string) {\n  const queryClient = useQueryClient();\n  const activeWsId = wsId || getCurrentWorkspaceId();\n\n  const rolesQuery = useQuery({\n    queryKey: workspaceKeys.workspaceRoles(activeWsId || \"\"),\n    queryFn: () => fetchWorkspaceRoles(activeWsId!),\n    enabled: !!activeWsId,\n    staleTime: 5 * 60 * 1000,\n  });\n\n  const createRoleMutation = useMutation({\n    mutationFn: (data: { name: string; description?: string; color: string }) => createWorkspaceRole(activeWsId!, data),\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: workspaceKeys.workspaceRoles(activeWsId!) });\n    },\n 