riority] = useState(0);\n  const [conditions, setConditions] = useState<AssignmentRuleConditions>({});\n\n  const { data: rules, isLoading: rulesLoading } = useQuery({ queryKey: [\"assignment-rules\", wsId], queryFn: () => fetchAssignmentRules(wsId), enabled: !!wsId });\n  const { data: patterns } = useQuery({ queryKey: [\"working-patterns\", wsId], queryFn: () => fetchWorkingPatterns(wsId), enabled: !!wsId });\n  const { data: departments } = useQuery({ queryKey: [\"departments\", wsId], queryFn: () => fetchDepartments(wsId), enabled: !!wsId });\n\n  const createMutation = useMutation({\n    mutationFn: (data: any) => createAssignmentRule(wsId, data),\n    onSuccess: () => { toast.success(t(\"rules.messages.create_success\")); closeModal(); queryClient.invalidateQueries({ queryKey: [\"assignment-rules\"] }); },\n  });\n\n  const updateMutation = useMutation({\n    mutationFn: ({ id, data }: { id: string, data: any }) => updateAssignmentRule(wsId, id, data),\n    onSuccess: () => { toast.success(t(\"rules.messages.update_success\")); closeModal(); queryClient.invalidateQueries({ queryKey: [\"assignment-rules\"] }); },\n  });\n\n  const deleteMutation = useMutation({\n    mutationFn: (id: string) => deleteAssignmentRule(wsId, id),\n    onSuccess: () => { toast.success(t(\"rules.messages.delete_success\")); queryClient.invalidateQueries({ queryKey: [\"assignment-rules\"] }); }\n  });\n\n  const openCreateModal = () => { setName(\"\"); setPatternId(\"\"); setPriority(0); setConditions({}); setIsCreateModalOpen(true); };\n  const openEditModal = (rule: AssignmentRule) => { setEditingRule(rule); setName(rule.name); setPatternId(rule.pattern_id); setPriority(rule.priority); setConditions(rule.conditions); setIsCreateModalOpen(true); };\n  const closeModal = () => { setIsCreateModalOpen(false); setEditingRule(null); };\n\n  const handleSubmit = () => {\n    if (!name || !patternId) return;\n    const payload = { name, pattern_id: patternId, priority, conditions };\n    if (editingRule) updateMutation.mutate({ id: editingRule.id, data: payload });\n    else createMutation.mutate(payload);\n  };\n\n  return (\n    <div className=\"space-y-10 animate-in fade-in duration-700 pb-20\">\n      <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-8 px-2\">\n        <div className=\"space-y-1\">\n          <h1 data-testid=\"assignment-rules-title\" className=\"text-4xl font-bold tracking-tighter text-slate-700 dark:text-slate-200 uppercase leading-none\">{t(\"rules.title\")}</h1>\n          <p className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em] opacity-60\">{t(\"rules.subtitle\")}</p>\n        </div>\n        <Button onClick={openCreateModal} icon={<Plus size={18} />}>{t(\"rules.create_btn\").toUpperCase()}</Button>\n      </div>\n\n      <div className=\"bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-[3rem] overflow-hidden shadow-sm dark:shadow-black/10 animate-in slide-in-from-bottom-8 duration-700\">\n        <table className=\"w-full text-left border-collapse\">\n          <thead>\n            <tr className=\"bg-slate-50 dark:bg-slate-800/50 dark:bg-slate-800/50 border-b border-slate-100 dark:border-slate-800\">\n              <th className=\"px-10 py-6 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em]\">{t(\"rules.table.priority\")}</th>\n              <th className=\"px-8 py-6 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em]\">{t(\"rules.table.name\")}</th>\n              <th className=\"px-8 py-6 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em]\">{t(\"rules.table.pattern\")}</th>\n              <th className=\"px-8 py-6 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em]\">{t(\"rules.table.conditions\")}</th>\n              <th className=\"px-10 py-6 border-b border-slate-100 dark:border-slate-800\"></th>\n            </tr>\n          </thead>\n          <tbody className=\"divide-y divide-slate-50 dark:divide-slate-800\">\n            {rules?.map((rule) => (\n              <tr key={rule.id} className=\"hover:bg-slate-50 dark:hover:bg-slate-800/50 dark:hover:bg-slate-800/50 transition-all group\">\n                <td className=\"px-10 py-6\"><span className=\"bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 px-3 py-1.5 rounded-xl text-[10px] font-bold tracking-tight border border-slate-200 dark:border-slate-700 shadow-inner font-mono uppercase\">P{rule.priority}</span></td>\n                <td className=\"px-8 py-6\">\n                  <div className=\"font-bold text-slate-700 dark:text-slate-200 text-sm tracking-tight uppercase leading-none mb-1.5\">{rule.name}</div>\n                  {!rule.is_active && <StatusBadge variant=\"danger\">{t(\"common.inactive\").toUpperCase()}</StatusBadge>}\n                </td>\n                <td className=\"px-8 py-6\"><span className=\"bg-primary-50 dark:bg-primary-950 text-primary-600 dark:text-primary-400 px-3 py-1.5 rounded-xl text-[10px] font-bold uppercase tracking-widest border border-primary-100 dark:border-primary-800 shadow-sm dark:shadow-black/10\">{patterns?.find(p => p.id === rule.pattern_id)?.name.toUpperCase() || \"UNKNOWN\"}</span></td>\n                <td className=\"px-8 py-6\">\n                  <div className=\"flex flex-wrap gap-2.5\">\n                    {rule.conditions.department_id && (\n                      <span className=\"bg-blue-50 dark:bg-blue-950 text-blue-600 dark:text-blue-300 px-3 py-1.5 rounded-[10px] text-[9px] font-bold uppercase tracking-widest border border-blue-100 dark:border-blue-800 flex items-center gap-2 shadow-sm dark:shadow-black/10\"><Building2 size={12} className=\"opacity-50\" /> {departments?.find(d => d.id === rule.conditions.department_id)?.name.toUpperCase()}</span>\n                    )}\n                    {rule.conditions.tags?.map(tag => (<span key={tag} className=\"bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-300 px-3 py-1.5 rounded-[10px] text-[9px] font-bold uppercase tracking-widest border border-emerald-100 dark:border-emerald-800 shadow-sm dark:shadow-black/10\">#{tag.toUpperCase()}</span>))}\n                    {!rule.conditions.department_id && (!rule.conditions.tags || rule.conditions.tags.length === 0) && (\n                      <span className=\"text-slate-300 dark:text-slate-600 text-[10px] font-bold uppercase tracking-[0.2em] italic opacity-60\">{t(\"rules.match_all\")}</span>\n                    )}\n                  </div>\n                </td>\n                <td className=\"px-10 py-6 text-right\">\n                  <div className=\"flex justify-end gap-3 opacity-0 group-hover:opacity-100 transition-all duration-300 translate-x-2 group-hover:translate-x-0\">\n                    <button onClick={() => openEditModal(rule)} className=\"p-3 bg-white dark:bg-slate-800 text-slate-500 dark:text-slate-400 hover:text-primary-600 dark:hover:text-primary-400 rounded-xl shadow-md dark:shadow-black/20 border border-slate-100 dark:border-slate-700 transition-all active:scale-90\" title={t(\"common.edit\")}><Pencil size={18} /></button>\n                    <button onClick={() => { if(confirm(t(\"common.confirm_delete\"))) deleteMutation.mutate(rule.id); }} className=\"p-3 bg-white dark:bg-slate-800 text-slate-500 dark:text-slate-400 hover:text-rose-600 dark:hover:text-rose-400 rounded-xl shadow-md dark:shadow-black/20 border border-slate-100 dark:border-slate-700 transition-all active:scale-90\" title={t(\"common.delete\")}><Trash2 size={18} /></button>\n                  </div>\n                </td>\n              </tr>\n            ))}\n            {(!rules || rules.length === 0) && !rulesLoading && (\n              <tr><td colSpan={5} className=\"px-10 py-32 text-center bg-slate-50 dark:bg-slate-800/30 dark:bg-slate-800/30 flex flex-col items-center\"><Zap size={40} className=\"text-slate-200 dark:text-slate-700 mb-4\" /><p className=\"text-[10px] font-bold text-slate-300 dark:text-slate-600 uppercase tracking-widest\">{t(\"rules.empty_list\")}</p></td></tr>\n            )}\n          </tbody>\n        </table>\n      </div>\n\n      <div className=\"p-8 bg-blue-50 dark:bg-blue-950/50 dark:bg-blue-950/50 border border-blue-100 dark:border-blue-900 rounded-[2.5rem] flex gap-6 shadow-inner animate-in fade-in slide-in-from-bottom-4 duration-1000\">\n        <div className=\"w-12 h-12 rounded-2xl bg-white dark:bg-slate-800 flex items-center justify-center text-blue-600 dark:text-blue-400 shadow-sm dark:shadow-black/10 border border-blue-100 dark:border-blue-900 shrink-0\"><AlertCircle size={24} /></div>\n        <div className=\"text-xs text-blue-900 dark:text-blue-200 leading-relaxed font-medium pt-1\">\n          <p className=\"font-bold uppercase tracking-[0.2em] mb-2 text-blue-950 dark:text-blue-100 opacity-80\">{t(\"common.did_you_know\")}</p>\n          <p className=\"opacity-70 font-bold uppercase tracking-tight\">{t(\"rules.info_priority\")}</p>\n        </div>\n      </div>\n\n      {/* Create/Edit Modal */}\n      <Modal\n        isOpen={isModalOpen}\n        onClose={closeModal}\n        title={editingRule ? t(\"rules.edit_title\", \"Edit Rule\") : t(\"rules.create_title\", \"Create New Rule\")}\n        subtitle={t(\"rules.form_subtitle\", \"Define when this pattern should be applied\")}\n        maxWidth=\"2xl\"\n      >\n        <div className=\"space-y-6 pt-4\">\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            <div className=\"space-y-2\">\n              <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">{t(\"rules.form.name\", \"Rule Name\")}</label>\n              <input\n                type=\"text\"\n                value={name}\n                onChange={(e) => setName(e.target.value)}\n                placeholder={t(\"rules.form.name_placeholder\")}\n                className=\"w-full bg-slate-50 dark:bg-slate-800 border-none rounded-2xl px-5 py-3.5 font-bold text-slate-700 dark:text-slate-200 focus:ring-2 focus:ring-primary-500 transition-all\"\n              />\n            </div>\n\n            <div className=\"space-y-2\">\n              <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">{t(\"rules.form.priority\")}</label>\n              <input\n                type=\"number\"\n                value={priority}\n                onChange={(e) => setPriority(parseInt(e.target.value))}\n                className=\"w-full bg-slate-50 dark:bg-slate-800 border-none rounded-2xl px-5 py-3.5 font-bold text-slate-700 dark:text-slate-200 focus:ring-2 focus:ring-primary-500 transition-all\"\n              />\n            </div>\n          </div>\n\n          <div className=\"space-y-2\">\n            <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">{t(\"rules.form.pattern\")}</label>\n            <select\n              value={patternId}\n              onChange={(e) => setPatternId(e.target.value)}\n              className=\"w-full bg-slate-50 dark:bg-slate-800 border-none rounded-2xl px-5 py-3.5 font-bold text-slate-700 dark:text-slate-200 focus:ring-2 focus:ring-primary-500 transition-all\"\n            >\n              <option value=\"\">{t(\"patterns.form.select_pattern_placeholder\")}</option>\n              {patterns?.map(p => (\n                <option key={p.id} value={p.id}>{p.name}</option>\n              ))}\n            </select>\n          </div>\n\n          <div className=\"bg-slate-50 dark:bg-slate-800 rounded-[32px] p-6 border border-slate-100 dark:border-slate-800 space-y-4\">\n            <h4 className=\"text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest flex items-center gap-2\">\n              <Filter size={14} /> {t(\"rules.conditions_title\")}\n            </h4>\n\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n              <div className=\"space-y-2\">\n                <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400\">{t(\"common.department\")}</label>\n                <select\n                  value={conditions.department_id || \"\"}\n                  onChange={(e) => setConditions({ ...conditions, department_id: e.target.value || undefined })}\n                  className=\"w-full bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-700 rounded-xl px-4 py-2 text-sm font-bold text-slate-700 dark:text-slate-200\"\n                >\n                  <option value=\"\">{t(\"common.all_departments\")}</option>\n                  {departments?.map(d => (\n                    <option key={d.id} value={d.id}>{d.name}</option>\n                  ))}\n                </select>\n              </div>\n\n              <div className=\"space-y-2\">\n                <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400\">{t(\"common.tags\")}</label>\n                <input\n                  type=\"text\"\n                  value={conditions.tags?.join(\", \") || \"\"}\n                  onChange={(e) => {\n                    const tags = e.target.value.split(\",\").map(t => t.trim()).filter(t => t !== \"\");\n                    setConditions({ ...conditions, tags: tags.length > 0 ? tags : undefined });\n                  }}\n                  placeholder={t(\"rules.form.tags_placeholder\")}\n                  className=\"w-full bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-700 rounded-xl px-4 py-2 text-sm font-bold text-slate-700 dark:text-slate-200\"\n                />\n              </div>\n            </div>\n\n            <p className=\"text-[10px] text-slate-500 dark:text-slate-400 italic\">\n              {t(\"rules.condition_help\")}\n            </p>\n          </div>\n\n          <div className=\"flex gap-3 pt-2\">\n            <Button variant=\"ghost\" size=\"lg\" className=\"flex-1\" onClick={closeModal}>\n              {t(\"common.cancel\")}\n            </Button>\n            <Button className=\"flex-1\" size=\"lg\" onClick={handleSubmit} loading={createMutation.isPending || updateMutation.isPending} icon={<Save className=\"w-4 h-4\" />}>\n              {editingRule ? t(\"common.save_changes\") : t(\"common.create\")}\n            </Button>\n          </div>\n        </div>\n      </Modal>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/AttendanceAdjustmentsPage.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Search' is defined but never used. Allowed unused vars must match /^_/u.","line":11,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":11,"endColumn":9,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Search"},"fix":{"range":[211,221],"text":""},"desc":"Remove unused variable \"Search\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'AlertCircle' is defined but never used. Allowed unused vars must match /^_/u.","line":14,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":14,"endColumn":14,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"AlertCircle"},"fix":{"range":[235,250],"text":""},"desc":"Remove unused variable \"AlertCircle\"."}]}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from \"react\";\n\nimport { useQuery, useMutation, useQueryClient } from \"@tanstack/react-query\";\nimport { \n  Clock, \n  CheckCircle, \n  XCircle, \n  FileDown, \n  Upload, \n  User as UserIcon,\n  Search,\n  Check,\n  X,\n  AlertCircle\n} from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\n\nimport AttendanceImportDialog from \"@/components/features/attendance/AttendanceImportDialog\";\nimport Button from \"@/components/ui/Button\";\nimport StatusBadge from \"@/components/ui/StatusBadge\";\nimport { useToast } from \"@/components/ui/Toast\";\n\nimport { useDateTimeFormatter } from \"@/hooks/use-datetime\";\nimport { cn } from \"@/lib/utils\";\n\n\nimport { \n  fetchWorkspaceAttendanceAdjustments, \n  fetchEmployees, \n  approveAttendanceAdjustment, \n  getCurrentWorkspaceId \n} from \"../lib/api\";\n\ntype TabType = \"pending\" | \"approved\" | \"rejected\";\n\nexport default function AttendanceAdjustmentsPage() {\n  const { t } = useTranslation();\n  const wsId = getCurrentWorkspaceId();\n  const queryClient = useQueryClient();\n  const { formatDate, formatTime } = useDateTimeFormatter();\n  const [isImportDialogOpen, setIsImportDialogOpen] = useState(false);\n  const [activeTab, setActiveTab] = useState<TabType>(\"pending\");\n  const toast = useToast();\n\n  const { data: requests = [], isLoading } = useQuery({ \n    queryKey: [\"attendance-adjustments\", wsId, activeTab], \n    queryFn: () => fetchWorkspaceAttendanceAdjustments(wsId!, activeTab), \n    enabled: !!wsId \n  });\n  const { data: employeesData } = useQuery({ \n    queryKey: [\"employees\", wsId], \n    queryFn: () => fetchEmployees(wsId!, 1, 3000), \n    enabled: !!wsId \n  });\n  const employees = employeesData?.data || [];\n\n  const approveMutation = useMutation({\n    mutationFn: (data: { id: string; status: string }) => approveAttendanceAdjustment(wsId!, data.id, { status: data.status }),\n    onSuccess: () => { \n      queryClient.invalidateQueries({ queryKey: [\"attendance-adjustments\"] }); \n      queryClient.invalidateQueries({ queryKey: [\"time-history\"] }); \n      toast.success(t(\"common.success\")); \n    },\n  });\n\n  const downloadTemplate = () => {\n    const headers = \"empNo,empName,empDt\"; const example = \"EMP001,Nguyen Van A,11/01/2026 08:00\";\n    const blob = new Blob([`\\uFEFF${headers}\\n${example}`], { type: 'text/csv;charset=utf-8;' });\n    const link = document.body.appendChild(document.createElement(\"a\")); link.href = URL.createObjectURL(blob); link.download = \"attendance_template.csv\"; link.click(); document.body.removeChild(link);\n  };\n\n  const getEmployeeName = (id: string) => { const emp = employees.find(e => e.id === id); return emp ? emp.full_name : \"Unknown\"; };\n  const getEmployeeID = (id: string) => { const emp = employees.find(e => e.id === id); return emp ? emp.employee_id_number : \"N/A\"; };\n\n  if (!wsId) return <div className=\"p-12 text-center text-slate-500 dark:text-slate-400 font-bold italic uppercase tracking-widest text-xs opacity-50\">{t(\"common.select_workspace\")}</div>;\n\n  return (\n    <div className=\"space-y-10 animate-in fade-in duration-700 pb-20\">\n      <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-8 px-2\">\n        <div className=\"space-y-1\">\n          <h1 className=\"text-4xl font-bold tracking-tighter text-slate-700 dark:text-slate-200 uppercase leading-none\">{t(\"attendance_confirm.title\")}</h1>\n          <p className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em] opacity-60\">{t(\"attendance_confirm.subtitle\")}</p>\n        </div>\n        <div className=\"flex items-center gap-4\">\n          <Button variant=\"outline\" onClick={downloadTemplate} icon={<FileDown size={18} />}>{t(\"attendance_confirm.excel_template\").toUpperCase()}</Button>\n          <Button onClick={() => setIsImportDialogOpen(true)} icon={<Upload size={18} />}>{t(\"attendance_confirm.import_excel\").toUpperCase()}</Button>\n        </div>\n      </div>\n\n      <div className=\"flex bg-slate-100 dark:bg-slate-700/50 p-1.5 rounded-[22px] w-fit border border-slate-200 dark:border-slate-700/50 shadow-inner\">\n        <button onClick={() => setActiveTab(\"pending\")} className={cn(\"flex items-center gap-2 px-8 py-2.5 rounded-[18px] text-xs font-bold uppercase tracking-widest transition-all\", activeTab === 'pending' ? \"bg-white dark:bg-slate-900 text-amber-600 dark:text-amber-300 shadow-sm border border-slate-100 dark:border-slate-800\" : \"text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 dark:text-slate-700\")}><Clock size={14} /> {t(\"common.status_pending\")}</button>\n        <button onClick={() => setActiveTab(\"approved\")} className={cn(\"flex items-center gap-2 px-8 py-2.5 rounded-[18px] text-xs font-bold uppercase tracking-widest transition-all\", activeTab === 'approved' ? \"bg-white dark:bg-slate-900 text-emerald-600 dark:text-emerald-300 shadow-sm border border-slate-100 dark:border-slate-800\" : \"text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 dark:text-slate-700\")}><CheckCircle size={14} /> {t(\"common.status_approved\")}</button>\n        <button onClick={() => setActiveTab(\"rejected\")} className={cn(\"flex items-center gap-2 px-8 py-2.5 rounded-[18px] text-xs font-bold uppercase tracking-widest transition-all\", activeTab === 'rejected' ? \"bg-white dark:bg-slate-900 text-rose-600 dark:text-rose-300 shadow-sm border border-slate-100 dark:border-slate-800\" : \"text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 dark:text-slate-700\")}><XCircle size={14} /> {t(\"common.status_rejected\")}</button>\n      </div>\n\n      <div className=\"bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-[3rem] overflow-hidden shadow-sm animate-in slide-in-from-bottom-8 duration-700\">\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left border-collapse\">\n            <thead>\n              <tr className=\"bg-slate-50 dark:bg-slate-800/50 border-b border-slate-100 dark:border-slate-800\">\n                <th className=\"px-10 py-6 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em]\">{t(\"common.employee\")}</th>\n                <th className=\"px-8 py-6 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em] text-center\">{t(\"common.time\")}</th>\n                <th className=\"px-8 py-6 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em]\">{t(\"common.notes\")}</th>\n                <th className=\"px-8 py-6 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em] text-center\">{t(\"common.status\")}</th>\n                <th className=\"px-10 py-6 border-b border-slate-100 dark:border-slate-800\"></th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-50 dark:divide-slate-800\">\n              {isLoading ? (\n                <tr><td colSpan={5} className=\"px-10 py-20 text-center text-slate-500 dark:text-slate-400 font-bold italic uppercase tracking-widest text-xs opacity-50 animate-pulse\">{t(\"common.loading\")}</td></tr>\n              ) : requests.length === 0 ? (\n                <tr><td colSpan={5} className=\"px-10 py-32 text-center text-slate-500 dark:text-slate-400 font-bold italic uppercase tracking-widest text-xs opacity-50 flex flex-col items-center gap-4\">\n                  <Clock size={40} className=\"text-slate-200 dark:text-slate-700\" />\n                  {t(\"attendance_confirm.messages.no_data\")}\n                </td></tr>\n              ) : requests.map((req) => (\n                <tr key={req.id} className=\"hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-all group\">\n                  <td className=\"px-10 py-6\">\n                    <div className=\"flex items-center gap-4\">\n                      <div className=\"w-12 h-12 rounded-2xl bg-primary-50 dark:bg-primary-950 flex items-center justify-center text-primary-600 dark:text-primary-400 font-bold shadow-inner border border-primary-100 dark:border-primary-800/50 overflow-hidden\">\n                        <UserIcon size={20} />\n                      </div>\n                      <div>\n                        <div className=\"font-bold text-slate-700 dark:text-slate-200 text-sm tracking-tight uppercase leading-none mb-1\">{getEmployeeName(req.employee_id)}</div>\n                        <div className=\"text-[10px] text-slate-500 dark:text-slate-400 font-mono font-bold uppercase opacity-70\">ID: {getEmployeeID(req.employee_id)}</div>\n                      </div>\n                    </div>\n                  </td>\n                  <td className=\"px-8 py-6 text-center\">\n                    <div className=\"inline-flex flex-col items-center bg-slate-50 dark:bg-slate-800 px-4 py-2 rounded-xl border border-slate-100 dark:border-slate-800 shadow-inner\">\n                      <div className=\"text-xs font-bold text-slate-700 dark:text-slate-200 uppercase tracking-tighter\">{formatDate(req.requested_punch_in_time)}</div>\n                      <div className=\"text-[10px] font-mono font-bold text-primary-600 dark:text-primary-400 mt-1\">{formatTime(req.requested_punch_in_time)} — {req.requested_punch_out_time ? formatTime(req.requested_punch_out_time) : \"???\"}</div>\n                    </div>\n                  </td>\n                  <td className=\"px-8 py-6\">\n                    <p className=\"text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-tight line-clamp-2 italic opacity-70 leading-relaxed\">{req.reason || t(\"common.no_notes\")}</p>\n                  </td>\n                  <td className=\"px-8 py-6 text-center\">\n                    <StatusBadge variant={req.status === \"pending\" ? \"warning\" : req.status === \"approved\" ? \"success\" : \"danger\"}>\n                      {t(`common.status_${req.status}`).toUpperCase()}\n                    </StatusBadge>\n                  </td>\n                  <td className=\"px-10 py-6 text-right\">\n                    {req.status === \"pending\" && (\n                      <div className=\"flex items-center justify-end gap-3 opacity-0 group-hover:opacity-100 transition-all duration-300\">\n                        <button onClick={() => approveMutation.mutate({ id: req.id, status: \"approved\" })} className=\"p-3 bg-emerald-600 text-white hover:bg-emerald-700 rounded-xl shadow-lg shadow-emerald-100 transition-all active:scale-90\" title={t(\"common.approve\")}><Check size={18} /></button>\n                        <button onClick={() => approveMutation.mutate({ id: req.id, status: \"rejected\" })} className=\"p-3 bg-white dark:bg-slate-900 text-rose-600 dark:text-rose-300 hover:bg-rose-50 dark:bg-rose-950 rounded-xl shadow-md border border-rose-100 dark:border-rose-800 transition-all active:scale-90\" title={t(\"common.reject\")}><X size={18} /></button>\n                      </div>\n                    )}\n                  </td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      </div>\n\n            <AttendanceImportDialog \n\n              isOpen={isImportDialogOpen} \n\n              onClose={() => setIsImportDialogOpen(false)} \n\n              title={t(\"attendance_confirm.import_excel\")}\n\n              endpoint=\"/attendance-adjustments/upload\"\n\n              targetType=\"adjustment\"\n\n            />\n\n          </div>\n\n        );\n\n      }\n\n      ","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/AttendanceLogsPage.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'useSearch' is defined but never used. Allowed unused vars must match /^_/u.","line":4,"column":29,"nodeType":"Identifier","messageId":"unusedVar","endLine":4,"endColumn":38,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"useSearch"},"fix":{"range":[198,209],"text":""},"desc":"Remove unused variable \"useSearch\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'UserPlus' is defined but never used. Allowed unused vars must match /^_/u.","