d safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[10848,10851],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useMemo, useState } from \"react\";\n\nimport { ShieldAlert, Building2, Users } from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\nimport {\n    BarChart,\n    Bar,\n    XAxis,\n    YAxis,\n    CartesianGrid,\n    Tooltip,\n    ResponsiveContainer,\n} from \"recharts\";\n\nimport { useUnexcusedAbsences } from \"@/hooks/use-dashboard\";\nimport { cn } from \"@/lib/utils\";\n\ntype RangePreset = \"7d\" | \"30d\" | \"custom\";\ntype GroupBy = \"department\" | \"employee\";\n\nfunction formatDate(d: Date): string {\n    return d.toISOString().slice(0, 10);\n}\n\nconst COLORS = {\n    unexcused: \"#ef4444\",\n    consecutive: \"#f97316\",\n};\n\nfunction CustomTooltip({ active, payload, label }: any) {\n    const { t } = useTranslation();\n    if (!active || !payload?.length) return null;\n\n    const data = payload[0]?.payload;\n    return (\n        <div className=\"bg-white dark:bg-slate-900 rounded-2xl p-4 border border-slate-100 dark:border-slate-800 shadow-xl min-w-[200px]\">\n            <p className=\"text-xs font-bold text-slate-700 dark:text-slate-200 mb-2\">\n                {label}\n            </p>\n            <div className=\"space-y-1.5\">\n                <div className=\"flex justify-between text-[11px]\">\n                    <span className=\"text-red-500 font-semibold\">{t(\"dashboard.hr.unexcused\")}</span>\n                    <span className=\"font-bold text-slate-700 dark:text-slate-200\">{data?.unexcused_count ?? 0}</span>\n                </div>\n\n                <div className=\"flex justify-between text-[11px]\">\n                    <span className=\"text-orange-500 font-semibold\">{t(\"dashboard.hr.consecutive_days\")}</span>\n                    <span className=\"font-bold text-slate-700 dark:text-slate-200\">{data?.consecutive_count ?? 0}</span>\n                </div>\n                <div className=\"border-t border-slate-100 dark:border-slate-800 pt-1.5 mt-1.5 flex justify-between text-[11px]\">\n                    <span className=\"text-slate-500 font-semibold\">{t(\"dashboard.hr.total_absent\")}</span>\n                    <span className=\"font-bold text-slate-700 dark:text-slate-200\">{data?.total_absent_count ?? 0}</span>\n                </div>\n            </div>\n        </div>\n    );\n}\n\nexport default function UnexcusedAbsencesChart() {\n    const { t } = useTranslation();\n    const [preset, setPreset] = useState<RangePreset>(\"7d\");\n    const [groupBy, setGroupBy] = useState<GroupBy>(\"department\");\n\n    const { startDate, endDate } = useMemo(() => {\n        const now = new Date();\n        if (preset === \"7d\") {\n            const s = new Date(now);\n            s.setDate(s.getDate() - 6);\n            return { startDate: formatDate(s), endDate: formatDate(now) };\n        }\n        if (preset === \"30d\") {\n            const s = new Date(now);\n            s.setDate(s.getDate() - 29);\n            return { startDate: formatDate(s), endDate: formatDate(now) };\n        }\n        // custom — default to 30 days\n        const s = new Date(now);\n        s.setDate(s.getDate() - 29);\n        return { startDate: formatDate(s), endDate: formatDate(now) };\n    }, [preset]);\n\n    const { data, isLoading } = useUnexcusedAbsences(startDate, endDate, groupBy);\n\n    const chartData = (data ?? [])\n        .map((d) => ({\n            ...d,\n            name: groupBy === \"employee\" ? (d.employee_name ?? d.department_name) : d.department_name,\n            remaining_unexcused: Math.max(0, d.unexcused_count - d.consecutive_count),\n        }))\n        .filter((d) => d.unexcused_count >= 1);\n\n    const hasData = chartData.length > 0 && chartData.some((d) => d.unexcused_count > 0);\n\n    const presets: { key: RangePreset; label: string }[] = [\n        { key: \"7d\", label: t(\"dashboard.hr.last_7_days\") },\n        { key: \"30d\", label: t(\"dashboard.hr.last_30_days_range\") },\n    ];\n\n    const groupByOptions: { key: GroupBy; label: string; icon: typeof Building2 }[] = [\n        { key: \"department\", label: t(\"dashboard.hr.group_by_department\"), icon: Building2 },\n        { key: \"employee\", label: t(\"dashboard.hr.group_by_employee\"), icon: Users },\n    ];\n\n    // Dynamic chart height based on number of entries for horizontal layout\n    const chartHeight = Math.max(320, chartData.length * 40 + 80);\n\n    return (\n        <div className=\"bg-white dark:bg-slate-900 rounded-[3rem] p-10 border border-slate-100 dark:border-slate-800 shadow-sm\">\n            <div className=\"flex items-center justify-between mb-8\">\n                <div className=\"flex items-center gap-4\">\n                    <div className=\"bg-red-50 dark:bg-red-950 w-12 h-12 rounded-[1rem] flex items-center justify-center text-red-600 dark:text-red-400 shadow-inner border border-red-100 dark:border-red-800\">\n                        <ShieldAlert size={22} />\n                    </div>\n                    <div>\n                        <h2 className=\"text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em]\">\n                            {t(\"dashboard.hr.unexcused_absences\")}\n                        </h2>\n                        <p className=\"text-[9px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest mt-0.5\">\n                            {t(\"dashboard.hr.unexcused_absences_subtitle\")}\n                        </p>\n                    </div>\n                </div>\n\n                <div className=\"flex items-center gap-3\">\n                    {/* Group-by toggle */}\n                    <div className=\"flex bg-slate-100 dark:bg-slate-700/50 p-1 rounded-[14px] border border-slate-200 dark:border-slate-700/50 shadow-inner\">\n                        {groupByOptions.map((g) => {\n                            const Icon = g.icon;\n                            return (\n                                <button\n                                    key={g.key}\n                                    onClick={() => setGroupBy(g.key)}\n                                    className={cn(\n                                        \"px-3 py-1.5 rounded-[10px] text-[9px] font-bold uppercase tracking-widest transition-all flex items-center gap-1.5\",\n                                        groupBy === g.key\n                                            ? \"bg-white dark:bg-slate-900 text-primary-600 dark:text-primary-400 shadow-sm border border-slate-100 dark:border-slate-800\"\n                                            : \"text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200\"\n                                    )}\n                                >\n                                    <Icon size={12} />\n                                    {g.label}\n                                </button>\n                            );\n                        })}\n                    </div>\n\n                    {/* Time-range toggle */}\n                    <div className=\"flex bg-slate-100 dark:bg-slate-700/50 p-1 rounded-[14px] border border-slate-200 dark:border-slate-700/50 shadow-inner\">\n                        {presets.map((p) => (\n                            <button\n                                key={p.key}\n                                onClick={() => setPreset(p.key)}\n                                className={cn(\n                                    \"px-5 py-1.5 rounded-[10px] text-[9px] font-bold uppercase tracking-widest transition-all\",\n                                    preset === p.key\n                                        ? \"bg-white dark:bg-slate-900 text-primary-600 dark:text-primary-400 shadow-sm border border-slate-100 dark:border-slate-800\"\n                                        : \"text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200\"\n                                )}\n                            >\n                                {p.label}\n                            </button>\n                        ))}\n                    </div>\n                </div>\n            </div>\n\n\n            {isLoading ? (\n                <div className=\"h-[320px] flex items-center justify-center\">\n                    <div className=\"w-8 h-8 border-2 border-primary-200 dark:border-primary-800 border-t-primary-600 dark:border-t-primary-400 rounded-full animate-spin\" />\n                </div>\n            ) : !hasData ? (\n                <div className=\"h-[320px] flex flex-col items-center justify-center\">\n                    <ShieldAlert size={48} className=\"text-slate-200 dark:text-slate-700 mb-4\" />\n                    <p className=\"text-[10px] font-bold text-slate-300 dark:text-slate-600 uppercase tracking-widest\">\n                        {t(\"common.no_data\")}\n                    </p>\n                </div>\n            ) : (\n                <ResponsiveContainer width=\"100%\" height={chartHeight}>\n                    <BarChart\n                        data={chartData}\n                        layout=\"vertical\"\n                        margin={{ top: 5, right: 30, left: 10, bottom: 5 }}\n                    >\n                        <CartesianGrid\n                            strokeDasharray=\"3 3\"\n                            stroke=\"currentColor\"\n                            className=\"text-slate-100 dark:text-slate-800\"\n                            horizontal={false}\n                        />\n                        <XAxis\n                            type=\"number\"\n                            tick={{ fontSize: 9, fontWeight: 700, fill: \"currentColor\" }}\n                            className=\"text-slate-400 dark:text-slate-500\"\n                            tickLine={false}\n                            axisLine={false}\n                            allowDecimals={false}\n                        />\n                        <YAxis\n                            type=\"category\"\n                            dataKey=\"name\"\n                            tick={{ fontSize: 9, fontWeight: 700, fill: \"currentColor\" }}\n                            className=\"text-slate-400 dark:text-slate-500\"\n                            tickLine={false}\n                            axisLine={false}\n                            width={120}\n                        />\n                        <Tooltip content={<CustomTooltip />} cursor={{ fill: \"rgba(0,0,0,0.04)\" }} />\n                        <Bar\n                            dataKey=\"consecutive_count\"\n                            name={t(\"dashboard.hr.consecutive_days\")}\n                            fill={COLORS.consecutive}\n                            stackId=\"absences\"\n                            radius={[0, 0, 0, 0]}\n                            label={false}\n                        />\n                        <Bar\n                            dataKey=\"remaining_unexcused\"\n                            name={t(\"dashboard.hr.unexcused\")}\n                            fill={COLORS.unexcused}\n                            stackId=\"absences\"\n                            radius={[0, 4, 4, 0]}\n                            label={(props: any) => {\n                                const { x, y, width, height, index } = props;\n                                const row = chartData[index];\n                                const total = row?.unexcused_count ?? 0;\n                                if (!total || total === 0) return null;\n                                return (\n                                    <text x={x + width + 4} y={y + height / 2} fill=\"#64748b\" fontSize={9} fontWeight={700} dominantBaseline=\"middle\">\n                                        {total}\n                                    </text>\n                                );\n                            }}\n                        />\n                    </BarChart>\n                </ResponsiveContainer>\n            )}\n        </div>\n    );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/dashboard/WidgetRenderer.tsx","messages":[{"ruleId":"import-x/no-named-as-default-member","severity":1,"message":"Caution: `React` also has a named export `memo`. Check if you meant to write `import {memo} from 'react'` instead.","line":72,"column":24,"nodeType":"MemberExpression","messageId":"member","endLine":72,"endColumn":34}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { lazy, Suspense } from \"react\";\n\nimport type { WidgetId } from \"@/hooks/use-dashboard-layout\";\n\n// ── Lazy-loaded chart components ───────────────────────────────────\n\nconst AttendanceTrendChart = lazy(\n    () => import(\"@/components/features/dashboard/AttendanceTrendChart\")\n);\nconst DepartmentAttendanceChart = lazy(\n    () => import(\"@/components/features/dashboard/DepartmentAttendanceChart\")\n);\nconst OvertimeTrendChart = lazy(\n    () => import(\"@/components/features/dashboard/OvertimeTrendChart\")\n);\nconst PeakTimesChart = lazy(\n    () => import(\"@/components/features/dashboard/PeakTimesChart\")\n);\nconst LeaveTypesChart = lazy(\n    () => import(\"@/components/features/dashboard/LeaveTypesChart\")\n);\nconst LatenessByDayChart = lazy(\n    () => import(\"@/components/features/dashboard/LatenessByDayChart\")\n);\nconst RecruitmentSourceChart = lazy(\n    () => import(\"@/components/features/dashboard/RecruitmentSourceChart\")\n);\nconst TurnoverAnalyticsChart = lazy(\n    () => import(\"@/components/features/dashboard/TurnoverAnalyticsChart\")\n);\nconst UnexcusedAbsencesChart = lazy(\n    () => import(\"@/components/features/dashboard/UnexcusedAbsencesChart\")\n);\n\n// ── Static chart map (hoisted to module scope — never re-created) ──\n\nconst chartMap: Record<string, React.LazyExoticComponent<React.ComponentType>> = {\n    attendance_trend: AttendanceTrendChart,\n    department_chart: DepartmentAttendanceChart,\n    overtime_trend: OvertimeTrendChart,\n    peak_times: PeakTimesChart,\n    leave_types: LeaveTypesChart,\n    lateness_by_day: LatenessByDayChart,\n    recruitment_sources: RecruitmentSourceChart,\n    turnover_analytics: TurnoverAnalyticsChart,\n    unexcused_absences: UnexcusedAbsencesChart,\n};\n\n// ── Loading skeleton ───────────────────────────────────────────────\n\nfunction ChartSkeleton() {\n    return (\n        <div className=\"bg-white dark:bg-slate-900 rounded-[3rem] p-10 border border-slate-100 dark:border-slate-800 shadow-sm animate-pulse\">\n            <div className=\"h-4 w-40 bg-slate-200 dark:bg-slate-700 rounded-full mb-8\" />\n            <div className=\"h-64 bg-slate-100 dark:bg-slate-800 rounded-3xl\" />\n        </div>\n    );\n}\n\n// ── Widget Renderer ────────────────────────────────────────────────\n\ninterface WidgetRendererProps {\n    widgetId: WidgetId;\n}\n\n/**\n * Renders a single dashboard widget by ID.\n * \"kpi_cards\", \"donut_chart\", \"quick_stats\", and \"promo_cards\" are rendered\n * directly in DashboardPage because they require data from the page scope.\n * This renderer handles chart-type widgets with lazy loading.\n */\nconst WidgetRenderer = React.memo(function WidgetRenderer({ widgetId }: WidgetRendererProps) {\n    const ChartComponent = chartMap[widgetId];\n\n    if (!ChartComponent) {\n        // Non-chart widgets (kpi_cards, donut, quick_stats, promo_cards) \n        // are rendered directly in DashboardPage\n        return null;\n    }\n\n    return (\n        <Suspense fallback={<ChartSkeleton />}>\n            <ChartComponent />\n        </Suspense>\n    );\n});\n\nexport default WidgetRenderer;\n\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/dashboard/__tests__/AttendanceTrendChart.test.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":23,"column":41,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":23,"endColumn":44,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[672,675],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[672,675],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":26,"column":19,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":26,"endColumn":22,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[773,776],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[773,776],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":31,"column":41,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":31,"endColumn":44,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1075,1078],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1075,1078],"text"