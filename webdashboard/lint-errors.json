Z\",\n    updated_at: \"2024-01-21T17:00:00Z\"\n  };\n\n  const breakEntry = {\n    id: \"2\",\n    employee_id: \"emp-1\",\n    punch_in_time: \"2024-01-21T12:00:00Z\",\n    punch_out_time: \"2024-01-21T12:30:00Z\",\n    entry_type: \"break\",\n    is_break_overtime: false,\n    created_at: \"2024-01-21T12:00:00Z\",\n    updated_at: \"2024-01-21T12:30:00Z\"\n  };\n\n  const activeEntry: TimeEntry = {\n    id: \"3\",\n    employee_id: \"emp-1\",\n    punch_in_time: \"2024-01-21T08:00:00Z\",\n    punch_out_time: undefined,\n    entry_type: \"work\",\n    is_break_overtime: false,\n    created_at: \"2024-01-21T08:00:00Z\",\n    updated_at: \"2024-01-21T08:00:00Z\"\n  };\n\n  beforeEach(() => {\n    vi.clearAllMocks();\n  });\n\n  it(\"renders work entry with punch in and punch out times\", () => {\n    render(\n      <table>\n        <tbody>\n          <TimeEntryRow entry={workEntry} />\n        </tbody>\n      </table>\n    );\n\n    expect(screen.getByText(\"2024-01-21\")).toBeInTheDocument();\n    expect(screen.getByText(\"Work\")).toBeInTheDocument();\n    expect(screen.getAllByText(\"08:00 AM\")).toHaveLength(2);\n  });\n\n  it(\"renders break entry with break badge\", () => {\n    render(\n      <table>\n        <tbody>\n          <TimeEntryRow entry={breakEntry} />\n        </tbody>\n      </table>\n    );\n\n    expect(screen.getByText(\"Break\")).toBeInTheDocument();\n  });\n\n  it(\"renders active entry without punch out time\", () => {\n    render(\n      <table>\n        <tbody>\n          <TimeEntryRow entry={activeEntry} />\n        </tbody>\n      </table>\n    );\n\n    expect(screen.getByText(\"Working\")).toBeInTheDocument();\n  });\n\n  it(\"shows adjust button when showAdjustButton is true\", () => {\n    render(\n      <table>\n        <tbody>\n          <TimeEntryRow entry={workEntry} onAdjust={mockOnAdjust} showAdjustButton={true} />\n        </tbody>\n      </table>\n    );\n\n    expect(screen.getByText(\"Adjust\")).toBeInTheDocument();\n  });\n\n  it(\"does not show adjust button when showAdjustButton is false\", () => {\n    render(\n      <table>\n        <tbody>\n          <TimeEntryRow entry={workEntry} onAdjust={mockOnAdjust} showAdjustButton={false} />\n        </tbody>\n      </table>\n    );\n\n    expect(screen.queryByText(\"Adjust\")).not.toBeInTheDocument();\n  });\n\n  it(\"calls onAdjust with entry when adjust button clicked\", async () => {\n    const user = userEvent.setup();\n    render(\n      <table>\n        <tbody>\n          <TimeEntryRow entry={workEntry} onAdjust={mockOnAdjust} showAdjustButton={true} />\n        </tbody>\n      </table>\n    );\n\n    const adjustButton = screen.getByText(\"Adjust\");\n    await user.click(adjustButton);\n\n    await waitFor(() => {\n      expect(mockOnAdjust).toHaveBeenCalledWith(workEntry);\n    });\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/ui/Button.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/ui/Button.tsx","messages":[{"ruleId":"import-x/no-named-as-default-member","severity":1,"message":"Caution: `React` also has a named export `memo`. Check if you meant to write `import {memo} from 'react'` instead.","line":42,"column":16,"nodeType":"MemberExpression","messageId":"member","endLine":42,"endColumn":26},{"ruleId":"import-x/no-named-as-default-member","severity":1,"message":"Caution: `React` also has a named export `forwardRef`. Check if you meant to write `import {forwardRef} from 'react'` instead.","line":43,"column":3,"nodeType":"MemberExpression","messageId":"member","endLine":43,"endColumn":19}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from \"react\";\n\nimport { Loader2 } from \"lucide-react\";\n\nimport { cn } from \"@/lib/utils\";\n\n// ── Variant styles ─────────────────────────────────────────────────\n\nconst VARIANT_STYLES = {\n  primary:\n    \"bg-primary-600 text-white hover:bg-primary-700 shadow-xl shadow-primary-100 dark:shadow-black/30\",\n  secondary:\n    \"bg-slate-900 text-white hover:bg-primary-700 shadow-xl shadow-slate-200 dark:shadow-black/30\",\n  outline:\n    \"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-800 shadow-sm\",\n  ghost:\n    \"hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300\",\n  destructive:\n    \"bg-rose-600 text-white hover:bg-rose-700 shadow-sm\",\n} as const;\n\nconst SIZE_STYLES = {\n  sm: \"px-4 py-2 text-[10px] rounded-xl gap-2\",\n  md: \"px-8 py-3 text-xs rounded-2xl gap-3\",\n  lg: \"px-10 py-4 text-xs rounded-2xl gap-4\",\n} as const;\n\n// ── Component ──────────────────────────────────────────────────────\n\nexport type ButtonVariant = keyof typeof VARIANT_STYLES;\nexport type ButtonSize = keyof typeof SIZE_STYLES;\n\nexport interface ButtonProps\n  extends Omit<React.ButtonHTMLAttributes<HTMLButtonElement>, \"children\"> {\n  variant?: ButtonVariant;\n  size?: ButtonSize;\n  icon?: React.ReactNode;\n  loading?: boolean;\n  children: React.ReactNode;\n}\n\nconst Button = React.memo(\n  React.forwardRef<HTMLButtonElement, ButtonProps>(function Button(\n    {\n      variant = \"primary\",\n      size = \"md\",\n      icon,\n      loading = false,\n      disabled,\n      className,\n      children,\n      type = \"button\",\n      ...rest\n    },\n    ref,\n  ) {\n    return (\n      <button\n        ref={ref}\n        type={type}\n        disabled={disabled || loading}\n        className={cn(\n          \"inline-flex items-center justify-center font-bold uppercase tracking-widest transition-all active:scale-95 disabled:opacity-50 disabled:pointer-events-none\",\n          VARIANT_STYLES[variant],\n          SIZE_STYLES[size],\n          className,\n        )}\n        {...rest}\n      >\n        {loading ? <Loader2 size={18} className=\"animate-spin\" /> : icon}\n        {children}\n      </button>\n    );\n  }),\n);\n\nexport default Button;\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/ui/Combobox.tsx","messages":[{"ruleId":"jsx-a11y/no-autofocus","severity":2,"message":"The autoFocus prop should not be used, as it can reduce usability and accessibility for users.","line":114,"column":46,"nodeType":"JSXAttribute","endLine":114,"endColumn":67},{"ruleId":"jsx-a11y/no-autofocus","severity":2,"message":"The autoFocus prop should not be used, as it can reduce usability and accessibility for users.","line":128,"column":30,"nodeType":"JSXAttribute","endLine":128,"endColumn":39}],"suppressedMessages":[{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/workspace/webdashboard/src/components/ui/Combobox.tsx:102:7\n  100 |     if (firstItemCmdkValue) {\n  101 |       // eslint-disable-next-line react-hooks/set-state-in-effect\n> 102 |       setHighlightedValue(firstItemCmdkValue);\n      |       ^^^^^^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  103 |     }\n  104 |   }, [firstItemCmdkValue]);\n  105 |","line":102,"column":7,"nodeType":null,"endLine":102,"endColumn":26,"suppressions":[{"kind":"directive","justification":""}]}],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from \"react\";\n\nimport * as Popover from \"@radix-ui/react-popover\";\nimport { Command } from \"cmdk\";\nimport { Search, Check, ChevronDown } from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { cn } from \"@/lib/utils\";\n\ninterface ComboboxOption {\n  value: string;\n  label: string;\n  displayLabel?: React.ReactNode;\n  description?: string | React.ReactNode;\n  displayDescription?: React.ReactNode;\n  icon?: React.ReactNode;\n}\n\ninterface ComboboxProps {\n  options: ComboboxOption[];\n  value?: string;\n  onChange: (value: string) => void;\n  onSearchChange?: (value: string) => void;\n  placeholder?: string;\n  searchPlaceholder?: string;\n  emptyText?: string;\n  className?: string;\n  id?: string;\n  \"data-testid\"?: string;\n  shouldFilter?: boolean;\n  autoFocus?: boolean;\n  keyboardShortcut?: string | string[];\n  clearOnEscape?: boolean; // New prop to allow clearing the selection globally\n}\n\nexport function Combobox({\n  options,\n  value,\n  onChange,\n  onSearchChange,\n  placeholder,\n  searchPlaceholder,\n  emptyText,\n  className,\n  id,\n  \"data-testid\": testId,\n  shouldFilter,\n  autoFocus,\n  keyboardShortcut,\n  clearOnEscape,\n}: ComboboxProps) {\n  const { t } = useTranslation();\n  const [open, setOpen] = useState(autoFocus || false);\n\n  // Global keyboard shortcut(s) to re-open and refocus the combobox, or to clear it\n  useEffect(() => {\n    const handleKeyDown = (e: KeyboardEvent) => {\n      // 1. Handle Escape to clear value globally (only if closed, so we don't interfere with Radix closing the popover)\n      if (clearOnEscape && e.key === 'Escape' && !open && value !== \"\") {\n        e.preventDefault();\n        onChange(\"\");\n        if (onSearchChange) onSearchChange(\"\");\n        return;\n      }\n\n      if (!keyboardShortcut) return;\n      const shortcuts = Array.isArray(keyboardShortcut) ? keyboardShortcut : [keyboardShortcut];\n\n      // Don't intercept if the combobox popover is already open (let cmdk handle it)\n      if (open) return;\n      const target = e.target as HTMLElement;\n      const tagName = target.tagName;\n      // Don't intercept if user is typing inside another input/textarea/contenteditable\n      if (tagName === 'INPUT' || tagName === 'TEXTAREA' || target.isContentEditable) return;\n      if (shortcuts.includes(e.key)) {\n        e.preventDefault();\n        setOpen(true);\n        if (onSearchChange) onSearchChange('');\n      }\n    };\n    window.addEventListener('keydown', handleKeyDown);\n    return () => window.removeEventListener('keydown', handleKeyDown);\n  }, [keyboardShortcut, onSearchChange, open, clearOnEscape, value, onChange]);\n\n  placeholder = placeholder || t(\"common.combobox.placeholder\");\n  searchPlaceholder = searchPlaceholder || t(\"common.combobox.search\");\n  emptyText = emptyText || t(\"common.combobox.no_results\");\n\n  const selectedOption = options.find((opt) => opt.value === value);\n\n  // When shouldFilter is false (server-side search), cmdk doesn't auto-select\n  // the first item when options change. We explicitly track and reset it.\n  const firstItemCmdkValue = options.length > 0\n    ? `${options[0].label} ${typeof options[0].description === 'string' ? options[0].description : \"\"} ${options[0].value}`\n    : \"\";\n  const [highlightedValue, setHighlightedValue] = useState(firstItemCmdkValue);\n\n  // Reset highlight to first item whenever options change\n  useEffect(() => {\n    if (firstItemCmdkValue) {\n      // eslint-disable-next-line react-hooks/set-state-in-effect\n      setHighlightedValue(firstItemCmdkValue);\n    }\n  }, [firstItemCmdkValue]);\n\n  return (\n    <Popover.Root open={open} onOpenChange={setOpen}>\n      <select id={id ? `${id}-select` : undefined} value={value} onChange={(e) => onChange(e.target.value)} className=\"sr-only\" aria-hidden=\"true\" tabIndex={-1} data-testid={testId ? `${testId}-select` : undefined}>\n        <option value=\"\">{placeholder}</option>\n        {options.map(opt => (<option key={opt.value} value={opt.value}>{opt.label}</option>))}\n      </select>\n\n      <Popover.Trigger asChild>\n        <button id={id} data-testid={testId} autoFocus={autoFocus} type=\"button\" className={cn(\"flex w-full items-center justify-between rounded-[1.25rem] border border-slate-100 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-5 py-4 text-sm font-bold text-primary-600 dark:text-primary-400 transition-all hover:border-primary-200 dark:hover:border-primary-800 hover:bg-white dark:hover:bg-slate-700 focus:outline-none focus:ring-4 focus:ring-primary-500/10 shadow-inner uppercase tracking-tight\", className)}>\n          <span className=\"flex items-center gap-3 truncate\">\n            {selectedOption?.icon}\n            {selectedOption ? selectedOption.label : <span className=\"text-primary-400 font-bold opacity-60 flex items-center gap-2\">{placeholder} {keyboardShortcut && <kbd className=\"hidden sm:inline-flex items-center h-5 px-1.5 text-[10px] uppercase font-mono bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded text-slate-400 dark:text-slate-500 shadow-sm ml-2\">{Array.isArray(keyboardShortcut) ? keyboardShortcut[0] : keyboardShortcut}</kbd>}</span>}\n          </span>\n          <ChevronDown className={cn(\"ml-2 h-4 w-4 shrink-0 text-slate-300 transition-transform duration-300\", open && \"rotate-180 text-primary-500\")} />\n        </button>\n      </Popover.Trigger>\n\n      <Popover.Portal>\n        <Popover.Content className=\"z-[10000] w-[var(--radix-popover-trigger-width)] min-w-[240px] overflow-hidden rounded-[2rem] border border-slate-100 dark:border-slate-700 bg-white dark:bg-slate-900 p-2.5 shadow-2xl dark:shadow-black/30 animate-in fade-in zoom-in-95 duration-300\" sideOffset={8}>\n          <Command shouldFilter={shouldFilter ?? !onSearchChange} value={highlightedValue} onValueChange={setHighlightedValue} className=\"flex flex-col gap-3\">\n            <div className=\"flex items-center border-b border-slate-50 dark:border-slate-800 px-4 pb-3 pt-1\">\n              <Search className=\"mr-3 h-4 w-4 shrink-0 text-slate-300 dark:text-slate-500\" />\n              <Command.Input autoFocus placeholder={searchPlaceholder} onValueChange={onSearchChange} className=\"flex h-10 w-full rounded-md bg-transparent text-sm text-primary-700 dark:text-primary-300 outline-none placeholder:text-slate-300 dark:placeholder:text-slate-600 disabled:cursor-not-allowed disabled:opacity-50 font-bold\" />\n            </div>\n\n            <Command.List className=\"max-h-[320px] overflow-y-auto overflow-x-hidden p-1 custom-scrollbar\">\n              <Command.Empty className=\"py-10 text-center text-[10px] text-primary-400 font-bold uppercase tracking-widest opacity-50\">{emptyText}</Command.Empty>\n              <Command.Group>\n                {options.map((option) => (\n                  <Command.Item\n                    key={option.value}\n                    value={`${option.label} ${typeof option.description === 'string' ? option.description : \"\"} ${option.value}`}\n                    data-testid={testId ? `${testId}-option-${option.value}` : `combo-option-${option.value}`}\n                    onSelect={() => { onChange(option.value); setOpen(false); }}\n                    className={cn(\n                      \"relative flex cursor-pointer select-none items-center rounded-2xl px-4 py-3.5 text-sm font-bold outline-none transition-all hover:bg-primary-50 dark:hover:bg-primary-950 hover:text-primary-600 dark:hover:text-primary-300 data-[selected=true]:bg-primary-50 dark:data-[selected=true]:bg-primary-950 data-[selected=true]:text-primary-600 dark:data-[selected=true]:text-primary-300 uppercase tracking-tight\",\n                      value === option.value && \"bg-primary-50 dark:bg-primary-950 text-primary-600 dark:text-primary-300 shadow-inner\"\n                    )}\n                  >\n                    <div className=\"flex flex-1 items-center gap-4\">\n                      {option.icon}\n                      <div className=\"flex flex-col\">\n                        <span className=\"leading-tight\">{option.displayLabel || option.label}</span>\n                        {option.description && <div className=\"mt-1 opacity-60\">{option.displayDescription || option.description}</div>}\n                      </div>\n                    </div>\n                    {value === option.value && <Check className=\"ml-auto h-4 w-4 text-primary-600 dark:text-primary-300\" />}\n                  </Command.Item>\n                ))}\n              </Command.Group>\n            </Command.List>\n          </Command>\n        </Popover.Content>\n      </Popover.Portal>\n    </Popover.Root>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/ui/ComboboxAutoFocus.test.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'afterEach' is defined but never used. Allowed unused vars must match /^_/u.","line":4,"column":48,"nodeType":"Identifier","messageId":"unusedVar","endLine":4,"endColumn":57,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"afterEach"},"fix":{"range":[141,152],"text":""},"desc":"Remove unused variable \"afterEach\"."}]},{"ruleId":"import-x/order","severity":2,"message":"`cmdk` import should occur before import of `vitest`","line":10,"column":1,"nodeType":"ImportDeclaration","messageId":"order","endLine":10,"endColumn":32},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":13,"column":44,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":13,