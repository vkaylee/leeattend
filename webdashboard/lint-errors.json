his will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[985,988],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Page } from '@playwright/test';\n\nimport { Device } from '../../src/lib/api/types';\n\nimport { MOCK_WORKSPACE, MOCK_USER, MOCK_EMPLOYEES, MOCK_DEPARTMENTS, MOCK_AGENTS, MOCK_DEVICES_INITIAL } from './mock-data';\n\n// --- Stateful mock stores (reset per page via setupApiMocks) ---\nlet devices: Device[];\nlet nextDeviceId = 100;\n\nexport async function setupApiMocks(page: Page) {\n  // Reset stateful stores for each test\n  devices = structuredClone(MOCK_DEVICES_INITIAL);\n  nextDeviceId = 100;\n\n  // Chặn các request gọi đến Backend API (/api/...)\n  // Loại trừ các file tĩnh (.ts, .js, .css, .jsx, .tsx) của Vite\n  await page.route(url => url.pathname.startsWith('/api/') && !url.pathname.match(/\\.(ts|js|css|jsx|tsx)$/), async (route) => {\n    const url = route.request().url();\n    const method = route.request().method();\n    const pathname = new URL(url).pathname;\n\n    console.log(`[MOCK API] Intercepted API Call: ${method} ${pathname}`);\n\n    const fulfill = async (data: any, status = 200) => {\n      console.log(`[MOCK API] Fulfilling ${method} ${pathname} with status ${status}`);\n      return route.fulfill({\n        status,\n        contentType: 'application/json',\n        body: JSON.stringify(data)\n      });\n    };\n\n    // 1. Health check\n    if (pathname === '/api/health') {\n      return fulfill({ status: \"ok\" });\n    }\n\n    // 2. Auth & Profile\n    if (pathname.match(/\\/api\\/me(\\/|$)/) || pathname.match(/\\/api\\/auth\\/profile/)) {\n      if (pathname.includes('/permissions')) {\n        return fulfill({\n          permissions: [\"workspace.admin\", \"devices.manage\", \"agents.manage\"],\n          roles: [\"Admin\"],\n          managed_department_ids: null\n        });\n      }\n      return fulfill(MOCK_USER);\n    }\n\n    if (pathname.match(/\\/api\\/auth\\/login/) || pathname.match(/\\/api\\/debug\\/login/)) {\n      return fulfill({\n        access_token: \"mock-access-token\",\n        refresh_token: \"mock-refresh-token\",\n        user: MOCK_USER\n      });\n    }\n\n    if (pathname.match(/\\/api\\/auth\\/refresh/)) {\n      return fulfill({\n        access_token: \"mock-access-token-refreshed\",\n        refresh_token: \"mock-refresh-token-new\"\n      });\n    }\n\n    // 3. Workspaces\n    if (pathname.match(/\\/api\\/workspaces/)) {\n      // Handle GET /api/workspaces/{id}/preferences\n      if (pathname.includes('/preferences')) {\n         return fulfill({\n            dashboard_layout: {},\n            theme: \"light\",\n            notifications_enabled: true\n          });\n      }\n\n      // Handle Workspace members\n      if (pathname.includes('/members')) {\n        return fulfill([\n          { id: \"member-1\", user_id: MOCK_USER.id, role: \"admin\", user: MOCK_USER }\n        ]);\n      }\n\n      if (method === 'GET') {\n        if (pathname === '/api/workspaces' || pathname === '/api/workspaces/') {\n          return fulfill([MOCK_WORKSPACE]);\n        }\n        // Explicitly handle GET /api/workspaces/{id}\n        const wsIdMatch = pathname.match(/\\/api\\/workspaces\\/([^/]+)/);\n        if (wsIdMatch) {\n          return fulfill(MOCK_WORKSPACE);\n        }\n      }\n      \n      if (method === 'POST') {\n        return fulfill(MOCK_WORKSPACE, 201);\n      }\n\n      return fulfill(MOCK_WORKSPACE);\n    }\n\n    // 4. Employees\n    if (pathname.match(/\\/api\\/employees/)) {\n      return fulfill({\n        data: MOCK_EMPLOYEES,\n        pagination: { total_count: MOCK_EMPLOYEES.length, page: 1, page_size: 50, total_pages: 1 }\n      });\n    }\n\n    // 5. Departments\n    if (pathname.match(/\\/api\\/departments/)) {\n      return fulfill(MOCK_DEPARTMENTS);\n    }\n\n    // 6. Attendance Logs\n    if (pathname.match(/\\/api\\/attendance\\/logs/)) {\n      return fulfill({\n        data: [\n          { id: \"log-1\", employee_id: \"emp-mock-1\", punch_time: \"2026-01-15T08:00:00Z\", punch_type: \"in\", source: \"device\", device_name: \"Main Door\" }\n        ],\n        pagination: { total_count: 1, page: 1, page_size: 50, total_pages: 1 }\n      });\n    }\n\n    // 7. Dashboard Stats & Trends\n    if (pathname.match(/\\/api\\/dashboard\\/workspace-stats/)) {\n      return fulfill({ employee_count: 2, present_today: 1, on_leave: 0, pending_requests: 0 });\n    }\n\n    if (pathname.match(/\\/api\\/dashboard\\/attendance-trend/)) {\n      return fulfill([\n        { date: \"2026-01-10\", present: 20, absent: 2, late: 1 },\n        { date: \"2026-01-11\", present: 22, absent: 0, late: 0 }\n      ]);\n    }\n\n    if (pathname.match(/\\/api\\/dashboard\\/unexcused-absences/)) {\n      return fulfill({\n        data: [],\n        pagination: { total_count: 0, page: 1, page_size: 50, total_pages: 0 }\n      });\n    }\n\n    if (pathname.match(/\\/api\\/dashboard\\/overtime-trend/)) {\n      return fulfill([\n        { date: \"2026-01-10\", hours: 5.5 },\n        { date: \"2026-01-11\", hours: 3.2 }\n      ]);\n    }\n\n    if (pathname.match(/\\/api\\/dashboard\\/peak-times/)) {\n      return fulfill([\n        { hour: 8, count: 15 },\n        { hour: 9, count: 5 }\n      ]);\n    }\n\n    if (pathname.match(/\\/api\\/dashboard\\/leave-types/)) {\n      return fulfill([\n        { type: \"SICK\", count: 2 },\n        { type: \"ANNUAL\", count: 5 }\n      ]);\n    }\n\n    if (pathname.match(/\\/api\\/dashboard\\/lateness-by-day/)) {\n      return fulfill([\n        { day: \"Mon\", count: 3 },\n        { day: \"Tue\", count: 1 }\n      ]);\n    }\n\n    if (pathname.match(/\\/api\\/dashboard\\/preferences/)) {\n      return fulfill({\n        dashboard_layout: {},\n        theme: \"light\",\n        notifications_enabled: true\n      });\n    }\n\n    if (pathname.match(/\\/api\\/health/)) {\n      return fulfill({ status: \"ok\" });\n    }\n\n    // 8. Authorized Agents (READ)\n    if (pathname.match(/\\/api\\/authorized-agents(\\/|$)/)) {\n      if (method === 'GET') {\n        const mockAgents = MOCK_AGENTS.map(a => ({\n          ...a,\n          is_trusted: true,\n          last_seen: new Date().toISOString()\n        }));\n        console.log(`[MOCK API] Fulfilling agents list with ${mockAgents.length} items`);\n        return fulfill(mockAgents);\n      }\n      if (method === 'POST') {\n        return fulfill({ success: true }, 201);\n      }\n      if (method === 'PATCH' || method === 'PUT') {\n        return fulfill(MOCK_AGENTS[0]);\n      }\n    }\n\n    // 9. Agent Status (realtime polling)\n    if (pathname.match(/\\/api\\/agents(\\/|$)/) || pathname.match(/\\/api\\/agents\\/status/)) {\n      return fulfill([\n        {\n          agent_id: \"agent-mock-1\",\n          is_online: true,\n          last_seen: new Date().toISOString(),\n          devices: devices.map(d => ({\n            device_id: d.id,\n            is_connected: d.is_enabled,\n            employee_count: 0,\n            last_sync: new Date().toISOString()\n          }))\n        }\n      ]);\n    }\n\n    // 10. Devices — STATEFUL CRUD\n    if (pathname.match(/\\/api\\/devices(\\/|$)/)) {\n      // GET /api/devices\n      if (method === 'GET' && (pathname === '/api/devices' || pathname === '/api/devices/')) {\n        return fulfill(devices);\n      }\n\n      // POST /api/devices (create)\n      if (method === 'POST' && (pathname === '/api/devices' || pathname === '/api/devices/')) {\n        const body = JSON.parse(route.request().postData() || '{}');\n        const newDevice: Device = {\n          id: `device-new-${nextDeviceId++}`,\n          agent_id: body.agent_id || \"agent-mock-1\",\n          name: body.name || \"New Device\",\n          ip: body.ip || \"0.0.0.0\",\n          port: body.port || 4370,\n          is_enabled: true,\n          brand: body.brand || \"zkteco\",\n          password: body.password,\n          timezone: body.timezone || \"UTC\",\n          last_status: \"pending\",\n          created_at: new Date().toISOString(),\n          workspace_id: MOCK_WORKSPACE.id,\n        };\n        devices.push(newDevice);\n        return fulfill(newDevice, 201);\n      }\n\n      // Extract device ID from URL pattern /api/devices/{id}\n      const idMatch = pathname.match(/\\/api\\/devices\\/([^/]+)/);\n      if (idMatch) {\n        const deviceId = idMatch[1];\n\n        // PUT /api/devices/:id (update)\n        if (method === 'PUT') {\n          const body = JSON.parse(route.request().postData() || '{}');\n          const idx = devices.findIndex(d => d.id === deviceId);\n          if (idx >= 0) {\n            devices[idx] = { ...devices[idx], ...body };\n            return fulfill(devices[idx]);\n          }\n          return fulfill({ error: \"not found\" }, 404);\n        }\n\n        // DELETE /api/devices/:id\n        if (method === 'DELETE') {\n          devices = devices.filter(d => d.id !== deviceId);\n          return fulfill({ success: true });\n        }\n      }\n\n      // Fallback for unhandled device routes\n      return fulfill(devices);\n    }\n\n    // 11. Working Patterns, Shifts, Schedules, Holidays, Leaves (Common workspace resources)\n    if (pathname.includes('/working-patterns')) {\n      return fulfill([]);\n    }\n    if (pathname.includes('/shifts')) {\n      return fulfill([]);\n    }\n    if (pathname.includes('/schedules')) {\n      return fulfill({ data: [], pagination: { total_count: 0, page: 1, page_size: 50, total_pages: 0 } });\n    }\n    if (pathname.includes('/holidays')) {\n      return fulfill([]);\n    }\n    if (pathname.includes('/leave/')) {\n      if (pathname.endsWith('/submit')) return fulfill({ success: true }, 201);\n      return fulfill({ data: [], pagination: { total_count: 0, page: 1, page_size: 50, total_pages: 0 } });\n    }\n    if (pathname.includes('/payroll') || pathname.includes('/salary-components')) {\n      return fulfill([]);\n    }\n    if (pathname.includes('/assignment-rules')) {\n      return fulfill([]);\n    }\n\n    // Mặc định trả về success cho các POST/PUT/DELETE khác để không gãy flow UI\n    if (['POST', 'PUT', 'DELETE'].includes(method)) {\n      return fulfill({ success: true, id: \"new-id\" });\n    }\n\n    // Fallback cho các API khác - Luôn trả về Array rỗng nếu không biết, \n    // vì hầu hết logic UI của bạn duyệt qua list (employees, logs, agents...)\n    console.warn(`[MOCK API] UNHANDLED ENDPOINT: ${pathname}. Returning fallback [].`);\n    return fulfill([]);\n  });\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/tests/mocks/mock-data.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/tests/pom/BasePage.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/tests/pom/ConnectivityPage.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/tests/pom/DevicesPage.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/tests/pom/EmployeesPage.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/tests/pom/LoginPage.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/tests/pom/Sidebar.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'expect' is defined but never used. Allowed unused vars must match /^_/u.","line":1,"column":16,"nodeType":"Identifier","messageId":"unusedVar","endLine":1,"endColumn":22,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"expect"},"fix":{"range":[13,21],"text":""},"desc":"Remove unused variable \"expect\"."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Page, expect } from '@playwright/test';\n\nexport class Sidebar {\n  constructor(private readonly page: Page) {}\n\n  async navigateTo(testId: string) {\n    const link = this.page.getByTestId(testId);\n    if (!(await link.isVisible())) {\n      // Logic to expand section if needed could go here\n      // For now, assume standard visibility or use direct navigation if needed\n    }\n    await link.click();\n  }\n\n  async expandSection(sectionTestId: string) {\n    await this.page.getByTestId(sectionTestId).click();\n  }\n\n  async logout() {\n    await this.page.getByTestId('sidebar-btn-logout').click();\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/tests/register-flow.spec.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/tests/report-export-realtime.spec.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'initialText' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":164,"column":11,"nodeType":"Identifier","messageId":"unusedVar","endLine":164,"endColumn":22}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { test, expect } from \"@playwright/test\";\n\n/**\n * Report Export Real-Time WebSocket Tests\n *\n * Tests the complete WebSocket streaming flow in ReportExportDialog\n * including fallback mechanism and error scenarios\n */\n\ntest.describe.skip(\"Report Export Real-Time Updates\", () => {\n  test.beforeEach(async ({ page }) => {\n    // Setup: Navigate to login\n    await page.goto(\"/login\");\n\n    // Use fast login if available\n    const fastLoginBtn = page.getByTestId(\"fast-login-btn\");\n    if (await fastLoginBtn.isVisible({ timeout: 5000 }).catch(() => false)) {\n      await fastLoginBtn.click();\n    } else {\n      // Manual login as fallback\n      await page.fill('[data-testid=\"login-email\"]', \"test@example.com\");\n      await page.fill('[data-testid=\"login-password\"]', \"password\");\n      await page.click('[data-testid=\"login-submit\"]');\n    }\n\n    // Wait for dashboard to load\n    await expect(page.getByRole(\"heading\", { level: 1 })).toBeVisible({\n      timeout: 30000,\n    });\n\n    // Navigate to reports page\n    await page.goto(\"/reports\");\n    await page.waitForLoadState(\"networkidle\");\n  });\n\n  test.skip(\"should open export dialog\", async ({ page }) => {\n    // Click export button\n    const exportBtn = page.getByTestId(\"reports-export-button\");\n    if (await exportBtn.isVisible().catch(() => false)) {\n      await exportBtn.click();\n    } else {\n      // Alternative: Use menu button\n      await page.click('button:has-text(\"Export\")');\n    }\n\n    // Verify dialog appears\n    const dialog = page.getByTestId(\"report-export-dialog\");\n    await expect(dialog).toBeVisible();\n\n    // Verify key elements are visible\n    await expect(page.getByTestId(\"report-export-info\")).toBeVisible();\n    await expect(page.getByTestId(\"report-export-start-button\")).toBeVisible();\n  });\n\n  test.skip(\"should show real-time progress via WebSocket\", async ({ page }) => {\n    // Click export button\n    const exportBtn = page.getByTestId(\"reports-export-button\");\n    if (await exportBtn.isVisible().catch(() => false)) {\n      await exportBtn.click();\n    }\n\n    // Wait for dialog\n    await expect(page.getByTestId(\"report-export-dialog\")).toBeVisible();\n\n    // Start export\n    await page.click('[data-testid=\"report-export-start-button\"]');\n\n    // Verify connecting/preparing state\n    await expect(page.getByTestId(\"report-export-status-text\")).toContainText(\n      /Preparing|Processing/i,\n      { timeout: 5000 }\n    );\n\n    // Verify progress bar is visible\n    const progressBar = page.getByTestId(\"report-export-progress-bar\");\n    await expect(progressBar).toBeVisible();\n\n    // Wait for streaming status\n    await expect(page.getByTestId(\"report-export-status-text\")).toContainText(\n      /Processing|Completed/i,\n      { timeout: 15000 }\n    );\n\n    // Verify batch counter appears during processing\n    const batchCounter = page.getByTestId(\"report-export-batch-counter\");\n    if (await batchCounter.isVisible({ timeout: 2000 }).catch(() => false)) {\n      await expect(batchCounter).toContainText(/\\d+ of \\d+/);\n    }\n\n    // Wait for completion\n    await expect(page.getByTestId(\"report-export-status-text\")).toContainText(\n      /Completed|completed/i,\n      { timeout: 30000 }\n    );\n\n    // Verify download button appears\n    await expect(page.getByTestId(\"report-export-download-button\")).toBeVisible();\n  });\n\n  test.skip(\"should show progress bar updates\", async ({ page }) => {\n    // Click export button\n    const exportBtn = page.getByTestId(\"reports-export-button\");\n    if (await exportBtn.isVisible().catch(() => false)) {\n      await exportBtn.click();\n    }\n\n    // Wait for dialog\n    await expect(page.getByTestId(\"report-export-dialog\")).toBeVisible();\n\n    // Start export\n    await page.click('[data-testid=\"report-export-start-button\"]');\n\n    // Wait for processing to start\n    await expect(page.getByTestId(\"report-export-status-text\")).toContainText(\n      /Processing/i,\n      { timeout: 10000 }\n    );\n\n    // Get initial progress\n    const progressFill = page.getByTestId(\"report-export-progress-fill\");\n    const initialWidth = await progressFill.evaluate((el) => {\n      const width = window.getComputedStyle(el).width;\n      return parseFloat(width);\n    });\n\n    // Wait a bit and check progress increased\n    await page.waitForTimeout(2000);\n    const updatedWidth = await progressFill.evaluate((el) => {\n      const width = window.getComputedStyle(el).width;\n      return parseFloat(width);\n    });\n\n    // Progress should have increased or be at completion\n    expect(updatedWidth).toBeGreaterThanOrEqual(initialWidth);\n  });\n\n  test.skip(\"should update batch counter in real-time\", async ({ page }) => {\n    // Click export button\n    const exportBtn = page.getByTestId(\"reports-export-button\");\n    if (await exportBtn.isVisible().catch(() => false)) {\n      await exportBtn.click();\n    }\n\n    // Wait for dialog\n    await expect(page.getByTestId(\"report-export-dialog\")).toBeVisible();\n\n    // Start export\n    await page.click('[data-testid=\"report-export-start-button\"]');\n\n    // Wait for processing\n    await expect(page.getByTestId(\"report-export-status-text\")).toContainText(\n      /Processing/i,\n      { timeout: 10000 }\n    );\n\n    // Wait for batch counter to appear\n    const batchCounter = page.getByTestId(\"report-export-batch-counter\");\n    await expect(batchCounter).toBeVisible({ timeout: 5000 });\n\n    // Verify format: \"X of Y\" or similar\n    await expect(batchCounter).toContainText(/\\d+ (of|\\/|out of) \\d+/i);\n\n    // Get initial text\n    const initialText = await batchCounter.textContent();\n\n    // Wait and check it updates\n    await page.waitForTimeout(1000);\n    const updatedText = await batchCounter.textContent();\n\n    // Text may update, or may reach completion\n    expect(updatedText).toBeDefined();\n  });\n\n  test.skip(\"should handle cancellation during processing\", async ({ page }) => {\n    // Click export button\n    const exportBtn = page.getByTestId(\"reports-export-button\");\n    if (await exportBtn.isVisible().catch(() => false)) {\n      await exportBtn.click();\n    }\n\n    // Wait for dialog\n    await expect(page.getByTestId(\"report-export-dialog\")).toBeVisible();\n\n    // Start export\n    await page.click('[data-testid=\"report-export-start-button\"]');\n\n    // Wait for processing to start\n    await expect(page.getByTestId(\"report-export-status-text\")).toContainText(\n      /Processing|Preparing/i,\n      { timeout: 5000 }\n    );\n\n    // Click background button to cancel/close\n    const bgButton = page.getByTestId(\"report-export-background-button\");\n    if (await bgButton.isVisible({ timeout: 2000 }).catch(() => false)) {\n      await bgButton.click();\n\n      // Verify dialog closed\n      await expect(page.getByTestId(\"report-export-dialog\")).not.toBeVisible();\n    }\n  });\n\n  test.skip(\"should download file on completion\", async ({ page }) => {\n    // Click export button\n    const exportBtn = page.getByTestId(\"reports-export-button\");\n    if (await exportBtn.isVisible().catch(() => false)) {\n      await exportBtn.click();\n    }\n\n    // Wait for dialog\n    await expect(page.getByTestId(\"report-export-dialog\")).toBeVisible();\n\n    // Start export\n    await page.click('[data-testid=\"report-export-start-button\"]');\n\n    // Wait for completion\n    await expect(page.getByTestId(\"report-export-status-text\")).toContainText(\n      /Completed|completed/i,\n      { timeout: 30000 }\n    );\n\n    // Setup download listener\n    const downloadPromise = page.waitForEvent(\"download\");\n\n    // Click download\n    await page.click('[data-testid=\"report-export-download-button\"]');\n\n    // Wait for download to start\n    const download = await downloadPromise;\n\n    // Verify filename contains expected pattern\n    const filename = download.suggestedFilename();\n    expect(filename).toMatch(/attendance-report.*\\.xlsx/i);\n\n    // Cleanup: Delete the download\n    await download.delete();\n  });\n\n  test.skip(\"should show error state on failure\", async ({ page }) => {\n    // This test would require mocking an error response\n    // In real environment, we simulate error conditions\n\n    // Click export button\n    const exportBtn = page.getByTestId(\"reports-export-button\");\n    if (await exportBtn.isVisible().catch(() => false)) {\n      await exportBtn.click();\n    }\n\n    // Wait for dialog\n    await expect(page.getByTestId(\"report-export-dialog\")).toBeVisible();\n\n    // Try to start export and look for potential errors\n    await page.click('[data-testid=\"report-export-start-button\"]');\n\n    // Wait to see if error appears (timeout means no error in this test)\n    const errorElement = page.getByTestId(\"report-export-error\");\n    const errorVisible = await errorElement.isVisible({ timeout: 5000 }).catch(() => false);\n\n    if (errorVisible) {\n      // If error appeared, verify retry button is available\n      await expect(page.getByTestId(\"report-export-retry-button\")).toBeVisible();\n    }\n  });\n\n  test.skip(\"should show fallback notification when WebSocket unavailable\", async ({\n    page,\n  }) => {\n    // This test checks for fallback mode notification\n    // In production, this would only trigger on actual WebSocket failures\n\n    // Click export button\n    const exportBtn = page.getByTestId(\"reports-export-button\");\n    if (await exportBtn.isVisible().catch(() => false)) {\n      await exportBtn.click();\n    }\n\n    // Wait for dialog\n    await expect(page.getByTestId(\"report-export-dialog\")).toBeVisible();\n\n    // Start export\n    await page.click('[data-testid=\"report-export-start-button\"]');\n\n    // Wait for processing\n    await expect(page.getByTestId(\"report-export-status-text\")).toContainText(\n      /Processing|Completed/i,\n      { timeout: 15000 }\n    );\n\n    // Check if fallback notification appears (won't in normal WebSocket mode)\n    const fallbackNotice = page.getByTestId(\n      \"report-export-fallback-notice\"\n    );\n    const isFallback = await fallbackNotice.isVisible({ timeout: 2000 }).catch(() => false);\n\n    if (isFallback) {\n      // If fallback is active, verify it still completes\n      await expect(page.getByTestId(\"report-export-status-text\")).toContainText(\n        /Completed|completed/i,\n        { timeout: 30000 }\n      );\n    }\n  });\n\n  test.skip(\"should handle retry after error\", async ({ page }) => {\n    // Click export button\n    const exportBtn = page.getByTestId(\"reports-export-button\");\n    if (await exportBtn.isVisible().catch(() => false)) {\n      await exportBtn.click();\n    }\n\n    // Wait for dialog\n    await expect(page.getByTestId(\"report-export-dialog\")).toBeVisible();\n\n    // Start export\n    await page.click('[data-testid=\"report-export-start-button\"]');\n\n    // Wait to see if we get an error\n    const errorElement = page.getByTestId(\"report-export-error\");\n    const errorVisible = await errorElement.isVisible({ timeout: 10000 }).catch(() => false);\n\n    if (errorVisible) {\n      // Verify error state\n      await expect(page.getByTestId(\"report-export-status-text\")).toContainText(\n        /Failed|failed/i\n      );\n\n      // Click retry\n      const retryBtn = page.getByTestId(\"report-export-retry-button\");\n      if (await retryBtn.isVisible()) {\n        await retryBtn.click();\n\n        // Should return to processing state\n        await expect(page.getByTestId(\"report-export-status-text\")).toContainText(\n          /Processing|Preparing/i,\n          { timeout: 5000 }\n        );\n      }\n    }\n  });\n\n  test.skip(\"should maintain UI state consistency\", async ({ page }) => {\n    // Click export button\n    const exportBtn = page.getByTestId(\"reports-export-button\");\n    if (await exportBtn.isVisible().catch(() => false)) {\n      await exportBtn.click();\n    }\n\n    // Dialog should be visible\n    const dialog = page.getByTestId(\"report-export-dialog\");\n    await expect(dialog).toBeVisible();\n\n    // Initially should show start button\n    let startBtn = page.getByTestId(\"report-export-start-button\");\n    await expect(startBtn).toBeVisible();\n\n    // Start export\n    await startBtn.click();\n\n    // Start button should be replaced by background button\n    startBtn = page.getByTestId(\"report-export-start-button\");\n    const bgBtn = page.getByTestId(\"report-export-background-button\");\n\n    // Wait for transition\n    await page.waitForTimeout(500);\n\n    // One of them should be visible (depending on state)\n    const isStartVisible = await startBtn.isVisible({ timeout: 1000 }).catch(() => false);\n    const isBgVisible = await bgBtn.isVisible({ timeout: 1000 }).catch(() => false);\n\n    expect(isStartVisible || isBgVisible).toBe(true);\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/tests/report-export-stream.spec.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":178,"column":26,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":178,"endColumn":29,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[7012,7015],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[7012,7015],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":249,"column":23,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":249,"endColumn":26,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[9589,9592],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[9589,9592],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":273,"column":29,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":273,"endColumn":32,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[10257,10260],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[10257,10260],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { test, expect } from './worker-orchestrator';\n\n/**\n * E2E Tests for Report Export Streaming\n *\n * Current Implementation: Polling-based export (ReportExportDialog.tsx)\n * Future Implementation: WebSocket-based streaming (use-report-stream.ts)\n *\n * Test Coverage:\n * - Happy path export flow\n * - Progress tracking\n * - Error handling and retry\n * - Download verification\n * - WebSocket fallback (when implemented)\n */\n\ntest.describe.skip('Report Export Streaming E2E', () => {\n  test.setTimeout(120000); // 2 minutes for export operations\n\n  test.beforeEach(async ({ page }) => {\n    // Enable browser console logging for debugging\n    page.on('console', msg => console.log(`[BROWSER] ${msg.type().toUpperCase()}: ${msg.text()}`));\n    page.on('pageerror', err => console.log(`[BROWSER ERROR] ${err.message}`));\n\n    // Login first\n    await page.goto('/login');\n    await page.getByTestId('fast-login-btn').click();\n    await expect(page.getByRole('heading', { level: 1 })).toBeVisible({ timeout: 60000 });\n  });\n\n  // TODO: Skipped until Reports page is implemented with export button\n  test('should export report with progress tracking via polling', async ({ page }) => {\n    // Navigate to Reports page\n    await page.goto('/reports');\n    await expect(page.getByTestId('reports-page')).toBeVisible({ timeout: 10000 });\n\n    // Open export dialog\n    await page.getByTestId('export-report-btn').click();\n    await expect(page.getByTestId('export-dialog')).toBeVisible({ timeout: 5000 });\n\n    // Verify export configuration is displayed\n    await expect(page.getByTestId('export-date-range')).toBeVisible();\n    await expect(page.getByTestId('export-report-type')).toBeVisible();\n\n    // Start export\n    await page.getByTestId('start-export-btn').click();\n\n    // Verify progress bar appears\n    const progressBar = page.locator('.h-4.w-full.bg-slate-100'); // Progress container\n    await expect(progressBar).toBeVisible({ timeout: 5000 });\n\n    // Verify status changes to \"processing\"\n    await expect(page.locator('text=/processing|preparing/i')).toBeVisible({ timeout: 5000 });\n\n    // Wait for completion status\n    await expect(page.locator('text=/completed|success/i')).toBeVisible({ timeout: 60000 });\n\n    // Verify download button appears\n    const downloadBtn = page.getByTestId('download-report-btn');\n    await expect(downloadBtn).toBeVisible({ timeout: 5000 });\n\n    // Trigger download and verify\n    const downloadPromise = page.waitForEvent('download', { timeout: 30000 });\n    await downloadBtn.click();\n    const download = await downloadPromise;\n\n    // Verify download filename\n    expect(download.suggestedFilename()).toMatch(/attendance-report-.*\\.xlsx$/);\n\n    // Verify dialog closes after download\n    await expect(page.getByTestId('export-dialog')).not.toBeVisible({ timeout: 10000 });\n  });\n\n  // TODO: Skipped until Reports page is implemented\n  test('should display batch progress during export', async ({ page }) => {\n    await page.goto('/reports');\n    await expect(page.getByTestId('reports-page')).toBeVisible({ timeout: 10000 });\n\n    // Open export dialog\n    await page.getByTestId('export-report-btn').click();\n\n    // Start export\n    await page.getByTestId('start-export-btn').click();\n\n    // Wait for progress to appear\n    await expect(page.locator('text=/processing/i')).toBeVisible({ timeout: 5000 });\n\n    // Verify batch progress text appears\n    // Format: \"Batches completed: X / Y\" or similar\n    const batchProgress = page.locator('text=/batch|completed|total/i');\n\n    // Check if batch progress updates (at least visible)\n    await expect(batchProgress).toBeVisible({ timeout: 10000 });\n\n    // Verify progress bar percentage increases\n    const progressBar = page.locator('.h-4.w-full.bg-slate-100 > div').first();\n    const initialWidth = await progressBar.evaluate(el => el.style.width);\n\n    // Wait a moment for progress update\n    await page.waitForTimeout(2000);\n\n    const updatedWidth = await progressBar.evaluate(el => el.style.width);\n\n    // Progress should increase (comparing width percentages)\n    expect(updatedWidth).not.toBe(initialWidth);\n  });\n\n  // TODO: Skipped until Reports page is implemented\n  test('should handle export errors and show retry option', async ({ page }) => {\n    // Intercept export job creation to simulate error\n    await page.route('**/api/v1/workspaces/*/reports/export/jobs', route => {\n      route.fulfill({\n        status: 500,\n        contentType: 'application/json',\n        body: JSON.stringify({ error: 'Simulated export error' }),\n      });\n    });\n\n    await page.goto('/reports');\n    await expect(page.getByTestId('reports-page')).toBeVisible({ timeout: 10000 });\n\n    // Open export dialog\n    await page.getByTestId('export-report-btn').click();\n\n    // Start export\n    await page.getByTestId('start-export-btn').click();\n\n    // Verify error state appears\n    await expect(page.locator('text=/failed|error/i')).toBeVisible({ timeout: 15000 });\n\n    // Verify error message is displayed\n    const errorMessage = page.locator('.bg-rose-50, .text-rose-700, [class*=\"error\"]');\n    await expect(errorMessage).toBeVisible({ timeout: 5000 });\n\n    // Verify retry button is available\n    const retryBtn = page.getByTestId('retry-export-btn').or(page.locator('button:has-text(\"Retry\")'));\n    await expect(retryBtn).toBeVisible({ timeout: 5000 });\n\n    // Verify close button is available\n    const closeBtn = page.getByTestId('close-dialog-btn').or(page.locator('button:has-text(\"Close\")'));\n    await expect(closeBtn).toBeVisible({ timeout: 5000 });\n  });\n\n  // TODO: Skipped until Reports page is implemented\n  test('should allow running export in background', async ({ page }) => {\n    await page.goto('/reports');\n    await expect(page.getByTestId('reports-page')).toBeVisible({ timeout: 10000 });\n\n    // Open export dialog\n    await page.getByTestId('export-report-btn').click();\n\n    // Start export\n    await page.getByTestId('start-export-btn').click();\n\n    // Wait for processing to start\n    await expect(page.locator('text=/processing|preparing/i')).toBeVisible({ timeout: 5000 });\n\n    // Click \"Run in Background\" button\n    const backgroundBtn = page.locator('button:has-text(/run.*background/i)');\n    await expect(backgroundBtn).toBeVisible({ timeout: 5000 });\n    await backgroundBtn.click();\n\n    // Verify dialog closes\n    await expect(page.getByTestId('export-dialog')).not.toBeVisible({ timeout: 5000 });\n\n    // TODO: Verify background job notification or status indicator\n    // This would require additional UI components for job tracking\n  });\n\n  // TODO: Skipped until WebSocket streaming is implemented in UI\n  test('should stream report data via WebSocket (future implementation)', async ({ page }) => {\n    // This test covers the use-report-stream.ts hook when integrated\n\n    await page.goto('/reports');\n    await expect(page.getByTestId('reports-page')).toBeVisible({ timeout: 10000 });\n\n    // Listen for WebSocket connections\n    const wsConnections: any[] = [];\n    page.on('websocket', ws => {\n      console.log(`[WS] WebSocket connection: ${ws.url()}`);\n      wsConnections.push(ws);\n\n      ws.on('framereceived', event => {\n        console.log(`[WS] Received: ${event.payload}`);\n      });\n\n      ws.on('framesent', event => {\n        console.log(`[WS] Sent: ${event.payload}`);\n      });\n    });\n\n    // Open export dialog\n    await page.getByTestId('export-report-btn').click();\n\n    // Start export with streaming\n    await page.getByTestId('start-export-btn').click();\n\n    // Verify WebSocket connection is established\n    await page.waitForTimeout(2000);\n    expect(wsConnections.length).toBeGreaterThan(0);\n\n    // Verify WebSocket URL pattern\n    const wsUrl = wsConnections[0].url();\n    expect(wsUrl).toMatch(/ws:\\/\\/.*\\/api\\/ws\\/reports\\/.+/);\n\n    // Verify streaming status indicator\n    await expect(page.getByTestId('streaming-status')).toContainText(/streaming|connected/i);\n\n    // Verify chunk progress updates\n    const progressText = page.getByTestId('streaming-progress');\n    await expect(progressText).toBeVisible({ timeout: 5000 });\n\n    // Wait for completion\n    await expect(page.locator('text=/completed|done/i')).toBeVisible({ timeout: 60000 });\n\n    // Verify download becomes available\n    await expect(page.getByTestId('download-report-btn')).toBeVisible({ timeout: 5000 });\n  });\n\n  // TODO: Skipped until WebSocket streaming is implemented\n  test('should fallback to polling when WebSocket fails', async ({ page }) => {\n    // Block WebSocket connections\n    await page.route('**/api/ws/**', route => {\n      route.abort('failed');\n    });\n\n    await page.goto('/reports');\n    await expect(page.getByTestId('reports-page')).toBeVisible({ timeout: 10000 });\n\n    // Open export dialog\n    await page.getByTestId('export-report-btn').click();\n\n    // Start export\n    await page.getByTestId('start-export-btn').click();\n\n    // Verify fallback to polling (no WebSocket connection indicator)\n    await expect(page.locator('text=/processing|preparing/i')).toBeVisible({ timeout: 10000 });\n\n    // Verify polling-based progress still works\n    const progressBar = page.locator('.h-4.w-full.bg-slate-100 > div').first();\n    await expect(progressBar).toBeVisible({ timeout: 5000 });\n\n    // Verify completion works via polling\n    await expect(page.locator('text=/completed|success/i')).toBeVisible({ timeout: 60000 });\n  });\n\n  // TODO: Skipped until WebSocket streaming is implemented\n  test('should handle WebSocket reconnection after disconnect', async ({ page }) => {\n    let wsConnection: any;\n\n    page.on('websocket', ws => {\n      if (ws.url().includes('/api/ws/reports/')) {\n        wsConnection = ws;\n      }\n    });\n\n    await page.goto('/reports');\n    await expect(page.getByTestId('reports-page')).toBeVisible({ timeout: 10000 });\n\n    // Open export dialog\n    await page.getByTestId('export-report-btn').click();\n\n    // Start export\n    await page.getByTestId('start-export-btn').click();\n\n    // Wait for WebSocket connection\n    await page.waitForTimeout(2000);\n    expect(wsConnection).toBeDefined();\n\n    // Simulate disconnect\n    await page.evaluate(() => {\n      // Close WebSocket connection from client side\n      const ws = (window as any).__reportWebSocket;\n      if (ws) ws.close();\n    });\n\n    // Verify reconnection attempt indicator\n    await expect(page.locator('text=/reconnect|connecting/i')).toBeVisible({ timeout: 5000 });\n\n    // Verify stream continues after reconnect\n    await expect(page.locator('text=/streaming|processing/i')).toBeVisible({ timeout: 15000 });\n  });\n\n  // TODO: Skipped until Reports page is implemented\n  test('should cancel export job on dialog close during processing', async ({ page }) => {\n    await page.goto('/reports');\n    await expect(page.getByTestId('reports-page')).toBeVisible({ timeout: 10000 });\n\n    // Track DELETE requests for job cancellation\n    const deleteRequests: string[] = [];\n    page.on('request', request => {\n      if (request.method() === 'DELETE' && request.url().includes('/export/jobs/')) {\n        deleteRequests.push(request.url());\n      }\n    });\n\n    // Open export dialog\n    await page.getByTestId('export-report-btn').click();\n\n    // Start export\n    await page.getByTestId('start-export-btn').click();\n\n    // Wait for processing to start\n    await expect(page.locator('text=/processing/i')).toBeVisible({ timeout: 5000 });\n\n    // Close dialog while processing\n    const closeBtn = page.locator('button:has-text(/close|cancel/i)').first();\n    await closeBtn.click();\n\n    // Verify dialog closes\n    await expect(page.getByTestId('export-dialog')).not.toBeVisible({ timeout: 5000 });\n\n    // TODO: Verify job cancellation request was sent\n    // This depends on whether the backend supports job cancellation\n    // expect(deleteRequests.length).toBeGreaterThan(0);\n  });\n\n  // TODO: Skipped until UI components have data-testid attributes\n  test('should display correct report metadata in export dialog', async ({ page }) => {\n    await page.goto('/reports');\n    await expect(page.getByTestId('reports-page')).toBeVisible({ timeout: 10000 });\n\n    // Set filters before opening export\n    const startDate = '2026-01-01';\n    const endDate = '2026-01-31';\n\n    // Fill date filters (assuming date pickers exist)\n    await page.getByTestId('filter-start-date').fill(startDate);\n    await page.getByTestId('filter-end-date').fill(endDate);\n\n    // Select report type\n    await page.getByTestId('report-type-summary').click();\n\n    // Open export dialog\n    await page.getByTestId('export-report-btn').click();\n\n    // Verify dialog displays correct metadata\n    await expect(page.getByTestId('export-date-range')).toContainText(startDate);\n    await expect(page.getByTestId('export-date-range')).toContainText(endDate);\n    await expect(page.getByTestId('export-report-type')).toContainText('summary');\n  });\n\n  // TODO: Skipped until employee filter UI is implemented\n  test('should export filtered employee subset', async ({ page }) => {\n    await page.goto('/reports');\n    await expect(page.getByTestId('reports-page')).toBeVisible({ timeout: 10000 });\n\n    // Select specific employees\n    await page.getByTestId('employee-filter-dropdown').click();\n    await page.getByTestId('employee-filter-option-1').click();\n    await page.getByTestId('employee-filter-option-2').click();\n    await page.getByTestId('employee-filter-apply').click();\n\n    // Open export dialog\n    await page.getByTestId('export-report-btn').click();\n\n    // Verify employee count in dialog\n    await expect(page.getByTestId('export-employee-count')).toContainText('2');\n\n    // Start export\n    await page.getByTestId('start-export-btn').click();\n\n    // Verify export completes\n    await expect(page.locator('text=/completed/i')).toBeVisible({ timeout: 60000 });\n\n    // Download and verify\n    const downloadPromise = page.waitForEvent('download', { timeout: 30000 });\n    await page.getByTestId('download-report-btn').click();\n    const download = await downloadPromise;\n\n    expect(download.suggestedFilename()).toMatch(/attendance-.*\\.xlsx$/);\n  });\n});\n\n/**\n * Integration Test Notes:\n *\n * CURRENT IMPLEMENTATION (Polling):\n * - Rep