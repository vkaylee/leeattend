rom \"../../components/ui/Toast\";\nimport * as api from \"../../lib/api\";\nimport AttendanceAdjustmentsPage from \"../AttendanceAdjustmentsPage\";\n\n\n// Mock TanStack Router\nvi.mock(\"@tanstack/react-router\", () => ({\n  useNavigate: () => vi.fn(),\n  useLocation: () => ({ pathname: \"/\", search: \"\", hash: \"\" }),\n  Link: ({ to, children, ...props }: any) => <a href={to} {...props}>{children}</a>,\n}));\n\n// Mock the API library\nvi.mock(\"../../lib/api\", () => ({\n  fetchWorkspaceAttendanceAdjustments: vi.fn(),\n  fetchEmployees: vi.fn(),\n  approveAttendanceAdjustment: vi.fn(),\n  getCurrentWorkspaceId: vi.fn(),\n}));\n\n// Override i18n\nvi.mock('react-i18next', () => ({\n  useTranslation: () => ({\n    t: (key: string) => key,\n    i18n: {\n      changeLanguage: () => Promise.resolve(),\n      language: 'en',\n    },\n  }),\n}));\n\ndescribe(\"AttendanceAdjustmentsPage\", () => {\n  let queryClient: QueryClient;\n\n  beforeEach(() => {\n    vi.clearAllMocks();\n    queryClient = new QueryClient({\n      defaultOptions: {\n        queries: {\n          retry: false,\n          gcTime: 0,\n          staleTime: 0,\n        },\n      },\n    });\n    (api.getCurrentWorkspaceId as any).mockReturnValue(\"test-ws-id\");\n    (api.fetchEmployees as any).mockResolvedValue({\n      data: [\n        { id: \"emp-1\", full_name: \"John Doe\", employee_id_number: \"EMP001\", workspace_id: \"ws-1\", is_active: true, hire_date: \"2025-01-01\", created_at: \"2025-01-01T00:00:00Z\", updated_at: \"2025-01-01T00:00:00Z\" }\n      ],\n      total: 1,\n      page: 1,\n      limit: 50,\n    });\n    (api.fetchWorkspaceAttendanceAdjustments as any).mockResolvedValue([\n      { \n        id: \"adj-1\", \n        employee_id: \"emp-1\", \n        requested_date: \"2026-01-01\", \n        requested_punch_in: \"08:00\", \n        requested_punch_out: \"17:00\", \n        status: \"pending\", \n        reason: \"Forgot to punch\" \n      }\n    ]);\n  });\n\n  const renderWithProviders = (ui: React.ReactElement) => {\n    return render(\n      <QueryClientProvider client={queryClient}>\n        <ToastProvider>\n          {ui}\n        </ToastProvider>\n      </QueryClientProvider>\n    );\n  };\n\n  it(\"renders list of adjustment requests\", async () => {\n    renderWithProviders(<AttendanceAdjustmentsPage />);\n    expect(await screen.findByText(/John Doe/i)).toBeDefined();\n    expect(screen.getByText(/Forgot to punch/i)).toBeDefined();\n  });\n\n  it(\"handles approve action\", async () => {\n    const user = userEvent.setup();\n    (api.approveAttendanceAdjustment as any).mockResolvedValue({});\n\n    renderWithProviders(<AttendanceAdjustmentsPage />);\n    \n    const approveBtn = await screen.findByTitle(/common.approve/i);\n    await user.click(approveBtn);\n\n    await waitFor(() => {\n      expect(api.approveAttendanceAdjustment).toHaveBeenCalledWith(\"test-ws-id\", \"adj-1\", { status: \"approved\" });\n    });\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/__tests__/AttendanceLogsPage.test.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'fireEvent' is defined but never used. Allowed unused vars must match /^_/u.","line":4,"column":26,"nodeType":"Identifier","messageId":"unusedVar","endLine":4,"endColumn":35,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"fireEvent"},"fix":{"range":[125,136],"text":""},"desc":"Remove unused variable \"fireEvent\"."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":17,"column":46,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":17,"endColumn":49,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[657,660],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[657,660],"text":"never"},"desc":"