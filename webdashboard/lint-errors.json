\n// Mock useDateTimeFormatter hook\nvi.mock(\"@/hooks/use-datetime\", () => ({\n  useDateTimeFormatter: () => ({\n    formatMonthYear: (date: string) => {\n      const d = new Date(date);\n      return `${String(d.getMonth() + 1).padStart(2, '0')}/${d.getFullYear()}`;\n    },\n    formatDate: (date: string) => {\n      const d = new Date(date);\n      const day = String(d.getDate()).padStart(2, '0');\n      const month = String(d.getMonth() + 1).padStart(2, '0');\n      const year = d.getFullYear();\n      return `${day}/${month}/${year}`;\n    },\n  }),\n}));\n\nconst createMockEmployee = (overrides: Partial<Employee> = {}): Employee => ({\n  id: \"emp-1\",\n  workspace_id: \"ws-1\",\n  full_name: \"Nguyen Van A\",\n  employee_id_number: \"EMP001\",\n  department_name: \"Engineering\",\n  hire_date: \"2024-01-01\",\n  is_active: true,\n  created_at: \"2024-01-01T00:00:00Z\",\n  updated_at: \"2024-01-01T00:00:00Z\",\n  ...overrides,\n});\n\nconst createMockPayslip = (overrides: Partial<Payslip> = {}): Payslip => ({\n  id: \"slip-1\",\n  employee_id: \"emp-1\",\n  period_start: \"2026-01-01\",\n  period_end: \"2026-01-31\",\n  base_pay_amount: \"10000000\",\n  overtime_pay_amount: \"500000\",\n  deductions_amount: \"500000\",\n  holiday_work_premium_amount: \"0\",\n  net_pay_amount: \"10000000\",\n  standard_units: 200,\n  overtime_units: 10,\n  status: \"published\",\n  created_at: \"2026-01-31T00:00:00Z\",\n  updated_at: \"2026-01-31T00:00:00Z\",\n  segments: [{\n    id: \"seg-1\",\n    start_date: \"2026-01-01\",\n    end_date: \"2026-01-31\",\n    applied_base_salary: 10000000,\n    applied_std_days: 22,\n    applied_hours_per_day: 8,\n    actual_work_days: 22,\n    paid_work_days: 22,\n    amount: 10000000,\n    reason: \"Standard\",\n  }],\n  salary_components: [\n    {\n      component: {\n        id: \"comp-1\",\n        employee_id: \"emp-1\",\n        component_definition_id: \"def-1\",\n        amount: \"10000000\",\n        effective_date: \"2024-01-01\",\n        created_at: \"2024-01-01T00:00:00Z\",\n        updated_at: \"2024-01-01T00:00:00Z\",\n      },\n      definition: {\n        id: \"def-1\",\n        workspace_id: \"ws-1\",\n        name: \"Base Salary\",\n        code: \"BS\",\n        is_base_for_ot: true,\n        is_taxable: true,\n        created_at: \"2024-01-01T00:00:00Z\",\n        updated_at: \"2024-01-01T00:00:00Z\",\n      },\n    },\n  ],\n  incentives: [\n    { policy_name: \"Diligence Bonus\", amount: \"500000\" },\n  ],\n  ...overrides,\n});\n\nconst createMockWorkspace = (overrides: Partial<Workspace> = {}): Workspace => ({\n  id: \"ws-1\",\n  name: \"Tech Company Ltd\",\n  work_unit_minutes: 60,\n  rounding_policy: \"nearest\",\n  date_format: \"DD/MM/YYYY\",\n  time_format: \"24h\",\n  timezone: \"Asia/Bangkok\",\n  theme_primary_color: \"#3b82f6\",\n  default_language: \"vi\",\n  created_at: \"2024-01-01T00:00:00Z\",\n  ...overrides,\n});\n\nconst queryClient = new QueryClient({\n  defaultOptions: { queries: { retry: false, gcTime: 0 } },\n});\n\nconst renderWithProviders = (ui: React.ReactElement) => {\n  return render(\n    <QueryClientProvider client={queryClient}>\n      {ui}\n    </QueryClientProvider>\n  );\n};\n\ndescribe(\"PayslipDocument\", () => {\n  it(\"renders document container with correct ID\", () => {\n    const { container } = renderWithProviders(\n      <PayslipDocument\n        employee={createMockEmployee()}\n        payslip={createMockPayslip()}\n        workspace={createMockWorkspace()}\n      />\n    );\n\n    const doc = container.querySelector(\"#payslip-document\");\n    expect(doc).toBeDefined();\n    expect(doc?.className).toContain(\"bg-white\");\n  });\n\n  it(\"displays company header with workspace name\", () => {\n    renderWithProviders(\n      <PayslipDocument\n        employee={createMockEmployee()}\n        payslip={createMockPayslip()}\n        workspace={createMockWorkspace({ name: \"Tech Corp Vietnam\" })}\n      />\n    );\n\n    expect(screen.getByText(\"Tech Corp Vietnam\")).toBeDefined();\n    expect(screen.getByText(\"payroll.document.system_subtitle\")).toBeDefined();\n    expect(screen.getByText(\"payroll.document.verified\")).toBeDefined();\n  });\n\n  it(\"displays fallback workspace name when null\", () => {\n    renderWithProviders(\n      <PayslipDocument\n        employee={createMockEmployee()}\n        payslip={createMockPayslip()}\n        workspace={null}\n      />\n    );\n\n    expect(screen.getByText(\"LeeAttend\")).toBeDefined();\n  });\n\n  it('shows \"Pay Slip\" title and period info', () => {\n    renderWithProviders(\n      <PayslipDocument\n        employee={createMockEmployee()}\n        payslip={createMockPayslip()}\n        workspace={createMockWorkspace()}\n      />\n    );\n\n    expect(screen.getByText(\"payroll.document.title\")).toBeDefined();\n    // Check period dates are shown\n    expect(screen.getByText(/01\\/01\\/2026/)).toBeDefined();\n    expect(screen.getByText(/31\\/01\\/2026/)).toBeDefined();\n  });\n\n  it(\"displays employee details section\", () => {\n    renderWithProviders(\n      <PayslipDocument\n        employee={createMockEmployee({\n          full_name: \"Nguyen Van A\",\n          employee_id_number: \"EMP001\",\n          department_name: \"Engineering\",\n        })}\n        payslip={createMockPayslip()}\n        workspace={createMockWorkspace()}\n      />\n    );\n\n    expect(screen.getByText(\"payroll.document.employee_details\")).toBeDefined();\n    // CSS uppercase class makes text display uppercase, but DOM text remains original\n    expect(screen.getByText(\"Nguyen Van A\")).toBeDefined();\n    expect(screen.getByText(\"EMP001\")).toBeDefined();\n    expect(screen.getByText(\"Engineering\")).toBeDefined();\n  });\n\n  it(\"renders Net Payment summary box\", () => {\n    renderWithProviders(\n      <PayslipDocument\n        employee={createMockEmployee()}\n        payslip={createMockPayslip({ net_pay_amount: \"10000000\" })}\n        workspace={createMockWorkspace()}\n      />\n    );\n\n    expect(screen.getByText(\"payroll.document.net_payment\")).toBeDefined();\n    expect(screen.getByText(\"Paid via Bank Transfer\")).toBeDefined();\n  });\n\n  it(\"renders salary components breakdown with prorated calculation\", () => {\n    const payslip = createMockPayslip({\n      salary_components: [\n        {\n          component: {\n            id: \"comp-1\",\n            employee_id: \"emp-1\",\n            component_definition_id: \"def-1\",\n            amount: \"10000000\",\n            effective_date: \"2024-01-01\",\n            created_at: \"2024-01-01T00:00:00Z\",\n            updated_at: \"2024-01-01T00:00:00Z\",\n          },\n          definition: {\n            id: \"def-1\",\n            workspace_id: \"ws-1\",\n            name: \"Base Salary\",\n            code: \"BS\",\n            is_base_for_ot: true,\n            is_taxable: true,\n            created_at: \"2024-01-01T00:00:00Z\",\n            updated_at: \"2024-01-01T00:00:00Z\",\n          },\n        },\n        {\n          component: {\n            id: \"comp-2\",\n            employee_id: \"emp-1\",\n            component_definition_id: \"def-2\",\n            amount: \"1000000\",\n            effective_date: \"2024-01-01\",\n            created_at: \"2024-01-01T00:00:00Z\",\n            updated_at: \"2024-01-01T00:00:00Z\",\n          },\n          definition: {\n            id: \"def-2\",\n            workspace_id: \"ws-1\",\n            name: \"Allowance\",\n            code: \"AL\",\n            is_base_for_ot: false,\n            is_taxable: true,\n            created_at: \"2024-01-01T00:00:00Z\",\n            updated_at: \"2024-01-01T00:00:00Z\",\n          },\n        },\n      ],\n      segments: [{\n        id: \"seg-1\",\n        start_date: \"2026-01-01\",\n        end_date: \"2026-01-31\",\n        applied_base_salary: 10000000,\n        applied_std_days: 22,\n        applied_hours_per_day: 8,\n        actual_work_days: 20,\n        paid_work_days: 20,\n        amount: 10000000,\n        reason: \"Standard\",\n      }],\n    });\n\n    renderWithProviders(\n      <PayslipDocument\n        employee={createMockEmployee()}\n        payslip={payslip}\n        workspace={createMockWorkspace()}\n      />\n    );\n\n    expect(screen.getByText(\"Base Salary\")).toBeDefined();\n    expect(screen.getByText(\"Allowance\")).toBeDefined();\n    expect(screen.getByText(/Code: BS/)).toBeDefined();\n    expect(screen.getByText(/Code: AL/)).toBeDefined();\n  });\n\n  it(\"calculates and displays prorated amounts correctly\", () => {\n    // 10,000,000 / 22 * 22 = 10,000,000\n    // 1,000,000 / 22 * 22 = 1,000,000\n    const payslip = createMockPayslip({\n      salary_components: [\n        {\n          component: {\n            id: \"comp-1\",\n            employee_id: \"emp-1\",\n            component_definition_id: \"def-1\",\n            amount: \"10000000\",\n            effective_date: \"2024-01-01\",\n            created_at: \"2024-01-01T00:00:00Z\",\n            updated_at: \"2024-01-01T00:00:00Z\",\n          },\n          definition: {\n            id: \"def-1\",\n            workspace_id: \"ws-1\",\n            name: \"Base Salary\",\n            code: \"BS\",\n            is_base_for_ot: true,\n            is_taxable: true,\n            created_at: \"2024-01-01T00:00:00Z\",\n            updated_at: \"2024-01-01T00:00:00Z\",\n          },\n        },\n      ],\n      segments: [{\n        id: \"seg-1\",\n        start_date: \"2026-01-01\",\n        end_date: \"2026-01-31\",\n        applied_base_salary: 10000000,\n        applied_std_days: 22,\n        applied_hours_per_day: 8,\n        actual_work_days: 11, // Worked half month\n        paid_work_days: 11,\n        amount: 5000000,\n        reason: \"Standard\",\n      }],\n    });\n\n    renderWithProviders(\n      <PayslipDocument\n        employee={createMockEmployee()}\n        payslip={payslip}\n        workspace={createMockWorkspace()}\n      />\n    );\n\n    // Monthly: 10,000,000\n    // Daily: 10,000,000 / 22 = 454,545.45...\n    // Paid Days: 11\n    // Prorated: 5,000,000\n\n    // We expect to see the formatted amount \"5.000.000 ₫\" (or similar depending on locale mock)\n    // The locale mock might be just returning the key or simple text? \n    // Wait, the component uses Intl.NumberFormat('vi-VN'). \n    // In node environment, full ICU might not be available or might differ.\n    // But usually Vitest/JSDOM supports it reasonably well.\n    // 5,000,000 VND formatted is usually \"5.000.000 ₫\" or \"5.000.000 ₫\" (nbsp).\n\n    // Let's use a regex to be safe about spacing/currency symbol\n    expect(screen.getByText(/5\\.000\\.000/)).toBeDefined();\n  });\n\n  it(\"renders segments fallback when no salary_components\", () => {\n    const payslip = createMockPayslip({\n      salary_components: [],\n      segments: [{\n        id: \"seg-1\",\n        start_date: \"2026-01-01\",\n        end_date: \"2026-01-31\",\n        applied_base_salary: 11000000,\n        applied_std_days: 22,\n        applied_hours_per_day: 8,\n        actual_work_days: 22,\n        paid_work_days: 22,\n        amount: 11000000,\n        reason: \"Standard\",\n      }],\n    });\n\n    renderWithProviders(\n      <PayslipDocument\n        employee={createMockEmployee()}\n        payslip={payslip}\n        workspace={createMockWorkspace()}\n      />\n    );\n\n    expect(screen.getByText(\"Base Salary\")).toBeDefined();\n    expect(screen.getByText(/2026-01-01 - 2026-01-31/)).toBeDefined();\n  });\n\n  it(\"handles malformed salary_components gracefully (simulating partial API response)\", () => {\n    // Simulate a case where definition is missing (e.g. bad join) or component is missing\n    const payslip = createMockPayslip({\n      salary_components: [\n        {\n          // @ts-expect-error - Simulating runtime data mismatch\n          component: {\n            amount: \"10000000\"\n          }\n          // definition is missing\n        }\n      ]\n    });\n\n    // This should NOT crash the entire component\n    // We expect it might fail to render that row, or render empty, but not throw\n    renderWithProviders(\n      <PayslipDocument\n        employee={createMockEmployee()}\n        payslip={payslip}\n        workspace={createMockWorkspace()}\n      />\n    );\n\n    // If it survives, check if it rendered the document shell\n    expect(screen.getByText(\"payroll.document.title\")).toBeDefined();\n  });\n\n  it(\"renders overtime section when present\", () => {\n    renderWithProviders(\n      <PayslipDocument\n        employee={createMockEmployee()}\n        payslip={createMockPayslip({\n          overtime_pay_amount: \"500000\",\n          overtime_units: 10,\n        })}\n        workspace={createMockWorkspace()}\n      />\n    );\n\n    expect(screen.getByText(\"Overtime Compensation\")).toBeDefined();\n    expect(screen.getByText(\"10 Units\")).toBeDefined();\n  });\n\n  it(\"does not render overtime section when zero\", () => {\n    renderWithProviders(\n      <PayslipDocument\n        employee={createMockEmployee()}\n        payslip={createMockPayslip({ overtime_pay_amount: \"0\" })}\n        workspace={createMockWorkspace()}\n      />\n    );\n\n    expect(screen.queryByText(\"Overtime Compensation\")).toBeNull();\n  });\n\n  it(\"renders incentives section when present\", () => {\n    renderWithProviders(\n      <PayslipDocument\n        employee={createMockEmployee()}\n        payslip={createMockPayslip({\n          incentives: [\n            { policy_name: \"Diligence Bonus\", amount: \"500000\" },\n            { policy_name: \"Safety Bonus\", amount: \"200000\" },\n          ],\n        })}\n        workspace={createMockWorkspace()}\n      />\n    );\n\n    expect(screen.getByText(\"Diligence Bonus\")).toBeDefined();\n    expect(screen.getByText(\"Safety Bonus\")).toBeDefined();\n  });\n\n  it(\"does not render incentive rows when empty\", () => {\n    renderWithProviders(\n      <PayslipDocument\n        employee={createMockEmployee()}\n        payslip={createMockPayslip({ incentives: [] })}\n        workspace={createMockWorkspace()}\n      />\n    );\n\n    expect(screen.queryByText(\"Diligence Bonus\")).toBeNull();\n  });\n\n  it(\"displays deductions and net pay\", () => {\n    renderWithProviders(\n      <PayslipDocument\n        employee={createMockEmployee()}\n        payslip={createMockPayslip({\n          deductions_amount: \"500000\",\n          net_pay_amount: \"10000000\",\n        })}\n        workspace={createMockWorkspace()}\n      />\n    );\n\n    expect(screen.getByText(\"Gross Pay\")).toBeDefined();\n    expect(screen.getByText(\"Deductions\")).toBeDefined();\n    expect(screen.getByText(\"Net Pay\")).toBeDefined();\n  });\n\n  it(\"renders footer with system information\", () => {\n    renderWithProviders(\n      <PayslipDocument\n        employee={createMockEmployee()}\n        payslip={createMockPayslip()}\n        workspace={createMockWorkspace()}\n      />\n    );\n\n    expect(screen.getByText(\"Generated by LeeAttend System\")).toBeDefined();\n  });\n\n  it(\"handles employee with no department\", () => {\n    renderWithProviders(\n      <PayslipDocument\n        employee={createMockEmployee({ department_name: undefined })}\n        payslip={createMockPayslip()}\n        workspace={createMockWorkspace()}\n      />\n    );\n\n    expect(screen.getByText(\"N/A\")).toBeDefined();\n  });\n\n  it(\"renders earnings breakdown section header\", () => {\n    renderWithProviders(\n      <PayslipDocument\n        employee={createMockEmployee()}\n        payslip={createMockPayslip()}\n        workspace={createMockWorkspace()}\n      />\n    );\n\n    expect(screen.getByText(\"Earnings Breakdown\")).toBeDefined();\n    expect(screen.getByText(\"Description\")).toBeDefined();\n    expect(screen.getByText(\"Amount\")).toBeDefined();\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/payroll/__tests__/PayslipModal.test.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":8,"column":38,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":8,"endColumn":41,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[330,333],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[330,333],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"import-x/order","severity":2,"message":"`@tanstack/react-query` import should occur before import of `@testing-library/react`","line":14,"column":1,"nodeType":"ImportDeclaration","messageId":"order","endLine":14,"endColumn":74}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { render, screen, fireEvent } from \"@testing-library/react\";\nimport { describe, it, expect, vi, beforeEach } from \"vitest\";\n\n// Mock TanStack Router\nvi.mock(\"@tanstack/react-router\", () => ({\n  useNavigate: () => vi.fn(),\n  useLocation: () => ({ pathname: \"/\", search: \"\", hash: \"\" }),\n  Link: ({ to, children, ...props }: any) => <a href={to} {...props}>{children}</a>,\n}));\nimport { Employee, Payslip, Workspace } from \"@/lib/api/types\";\n\nimport PayslipModal from \"../PayslipModal\";\n\nimport { QueryClient, QueryClientProvider } from \"@tanstack/react-query\";\n\n// Mock i18next\nvi.mock(\"react-i18next\", () => ({\n  useTranslation: () => ({\n    t: (key: string) => key,\n  }),\n}));\n\n// Mock useDateTimeFormatter hook\nvi.mock(\"@/hooks/use-datetime\", () => ({\n  useDateTimeFormatter: () => ({\n    formatMonthYear: (date: string) => {\n      const d = new Date(date);\n      return `${String(d.getMonth() + 1).padStart(2, '0')}/${d.getFullYear()}`;\n    },\n    formatDate: (date: string) => {\n      const d = new Date(date);\n      const day = String(d.getDate()).padStart(2, '0');\n      const month = String(d.getMonth() + 1).padStart(2, '0');\n      const year = d.getFullYear();\n      return `${day}/${month}/${year}`;\n    },\n  }),\n}));\n\nconst mockEmployee: Employee = {\n  id: \"emp-1\",\n  workspace_id: \"ws-1\",\n  full_name: \"Nguyen Van A\",\n  employee_id_number: \"EMP001\",\n  department_name: \"Engineering\",\n  hire_date: \"2024-01-01\",\n  is_active: true,\n  created_at: \"2024-01-01T00:00:00Z\",\n  updated_at: \"2024-01-01T00:00:00Z\",\n};\n\nconst mockPayslip: Payslip = {\n  id: \"slip-1\",\n  employee_id: \"emp-1\",\n  period_start: \"2026-01-01\",\n  period_end: \"2026-01-31\",\n  base_pay_amount: \"10000000\",\n  overtime_pay_amount: \"500000\",\n  deductions_amount: \"500000\",\n  holiday_work_premium_amount: \"0\",\n  net_pay_amount: \"10000000\",\n  standard_units: 200,\n  overtime_units: 10,\n  status: \"published\",\n  created_at: \"2026-01-31T00:00:00Z\",\n  updated_at: \"2026-01-31T00:00:00Z\",\n  segments: [{\n    id: \"seg-1\",\n    start_date: \"2026-01-01\",\n    end_date: \"2026-01-31\",\n    applied_base_salary: 10000000,\n    applied_std_days: 22,\n    applied_hours_per_day: 8,\n    actual_work_days: 22,\n    paid_work_days: 22,\n    amount: 10000000,\n    reason: \"Standard\",\n  }],\n  salary_components: [\n    {\n      component: {\n        id: \"comp-1\",\n        employee_id: \"emp-1\",\n        component_definition_id: \"def-1\",\n        amount: \"10000000\",\n        effective_date: \"2024-01-01\",\n        created_at: \"2024-01-01T00:00:00Z\",\n        updated_at: \"2024-01-01T00:00:00Z\",\n      },\n      definition: {\n        id: \"def-1\",\n        workspace_id: \"ws-1\",\n        name: \"Base Salary\",\n        code: \"BS\",\n        is_base_for_ot: true,\n        is_taxable: true,\n        created_at: \"2024-01-01T00:00:00Z\",\n        updated_at: \"2024-01-01T00:00:00Z\",\n      },\n    },\n  ],\n  incentives: [\n    { policy_name: \"Diligence Bonus\", amount: \"500000\" },\n  ],\n};\n\nconst mockWorkspace: Workspace = {\n  id: \"ws-1\",\n  name: \"Tech Company Ltd\",\n  work_unit_minutes: 60,\n  rounding_policy: \"nearest\",\n  date_format: \"DD/MM/YYYY\",\n  time_format: \"24h\",\n  timezone: \"Asia/Bangkok\",\n  theme_primary_color: \"#3b82f6\",\n  default_language: \"vi\",\n  created_at: \"2024-01-01T00:00:00Z\",\n};\n\nconst queryClient = new QueryClient({\n  defaultOptions: { queries: { retry: false, gcTime: 0 } },\n});\n\nconst renderWithProviders = (ui: React.ReactElement) => {\n  return render(\n    <QueryClientProvider client={queryClient}>\n        {ui}\n    </QueryClientProvider>\n  );\n};\n\ndescribe(\"PayslipModal\", () => {\n  const onClose = vi.fn();\n\n  beforeEach(() => {\n    vi.clearAllMocks();\n  });\n\n  it(\"renders modal with payslip data when open\", () => {\n    renderWithProviders(\n      <PayslipModal\n        isOpen={true}\n        onClose={onClose}\n        employee={mockEmployee}\n        payslip={mockPayslip}\n        workspace={mockWorkspace}\n      />\n    );\n\n    // Dialog content should exist\n    expect(screen.getAllByText(\"Official Payslip Preview\").length).toBeGreaterThan(0);\n    // Period should display (appears in modal header and document header)\n    expect(screen.getAllByText(/common.month/).length).toBeGreaterThan(0);\n  });\n\n  it(\"displays formatted month and year correctly\", () => {\n    renderWithProviders(\n      <PayslipModal\n        isOpen={true}\n        onClose={onClose}\n        employee={mockEmployee}\n        payslip={mockPayslip}\n        workspace={mockWorkspace}\n      />\n    );\n\n    // Should show the formatted month/year (01/2026) - appears in multiple places\n    expect(screen.getAllByText(/01\\/2026/).length).toBeGreaterThan(0);\n  });\n\n  it(\"renders print button with correct styling\", () => {\n    renderWithProviders(\n      <PayslipModal\n        isOpen={true}\n        onClose={onClose}\n        employee={mockEmployee}\n        payslip={mockPayslip}\n        workspace={mockWorkspace}\n      />\n    );\n\n    const printButton = screen.getByText(\"Print Payslip\");\n    expect(printButton).toBeDefined();\n    expect(printButton.closest(\"button\")).toBeDefined();\n  });\n\n  it(\"opens print window when print button clicked\", () => {\n    // Mock window.open to return a mock window object\n    const mockPrintWindow = {\n      document: {\n        write: vi.fn(),\n        close: vi.fn(),\n      },\n      focus: vi.fn(),\n      print: vi.fn(),\n      close: vi.fn(),\n      closed: false,\n      onload: null as (() => void) | null,\n    };\n    const openMock = vi.spyOn(window, \"open\").mockReturnValue(mockPrintWindow as unknown as Window);\n\n    renderWithProviders(\n      <PayslipModal\n        isOpen={true}\n        onClose={onClose}\n        employee={mockEmployee}\n        payslip={mockPayslip}\n        workspace={mockWorkspace}\n      />\n    );\n\n    // window.open should NOT be called on initial render\n    expect(openMock).not.toHaveBeenCalled();\n\n    const printButton = screen.getByText(\"Print Payslip\").closest(\"button\");\n    if (printButton) fireEvent.click(printButton);\n\n    // window.open IS called when print button clicked\n    expect(openMock).toHaveBeenCalledWith('', '_blank', 'width=600,height=800');\n    // Document should be written to with A5 page size styling\n    expect(mockPrintWindow.document.write).toHaveBeenCalled();\n    const writeCall = mockPrintWindow.document.write.mock.calls[0][0];\n    expect(writeCall).toContain('size: A5 portrait');\n    expect(writeCall).toContain('Payslip - Nguyen Van A');\n  });\n\n  it(\"calls onClose callback when close button clicked\", () => {\n    renderWithProviders(\n      <PayslipModal\n        isOpen={true}\n        onClose={onClose}\n        employee={mockEmployee}\n        payslip={mockPayslip}\n        workspace={mockWorkspace}\n      />\n    );\n\n    // Find the close button (the one with X icon)\n    const closeBtn = screen.getAllByRole(\"button\").find(b => b.querySelector(\".lucide-x\"));\n    if (closeBtn) fireEvent.click(closeBtn);\n\n    expect(onClose).toHaveBeenCalled();\n  });\n\n  it(\"does not render modal content when closed\", () => {\n    renderWithProviders(\n      <PayslipModal\n        isOpen={false}\n        onClose={onClose}\n        employee={mockEmployee}\n        payslip={mockPayslip}\n        workspace={mockWorkspace}\n      />\n    );\n\n    // Modal content should not be visible when closed\n    expect(screen.queryByText(\"Official Payslip Preview\")).toBeNull();\n  });\n\n  it(\"passes correct props to PayslipDocument child\", () => {\n    renderWithProviders(\n      <PayslipModal\n        isOpen={true}\n        onClose={onClose}\n        employee={mockEmployee}\n        payslip={mockPayslip}\n        workspace={mockWorkspace}\n      />\n    );\n\n    // Verify PayslipDocument renders with correct data\n    // Employee name should appear in the document (CSS uppercase, but DOM text is original)\n    expect(screen.getByText(\"Nguyen Van A\")).toBeDefined();\n    // Employee ID should appear\n    expect(screen.getByText(\"EMP001\")).toBeDefined();\n    // Workspace name should appear\n    expect(screen.getByText(\"Tech Company Ltd\")).toBeDefined();\n  });\n\n  it(\"renders footer warning about print/PDF\", () => {\n    renderWithProviders(\n      <PayslipModal\n        isOpen={true}\n        onClose={onClose}\n        employee={mockEmployee}\n        payslip={mockPayslip}\n        workspace={mockWorkspace}\n      />\n    );\n\n    expect(screen.getByText(/Use the print button above/)).toBeDefined();\n  });\n\n  it(\"does not crash when payslip data is incomplete/malformed\", () => {\n    // Create a malformed payslip with missing nested objects in salary_components\n    const malformedPayslip = {\n    