;\n    expect(screen.getByText(\"Jane Smith\")).toBeDefined();\n    expect(screen.getByText(\"10.500.000\")).toBeDefined(); // Net pay for John\n  });\n\n  it(\"filters employees based on search term\", () => {\n    render(\n        <PayrollSummaryTable\n          employees={mockEmployees}\n          payslips={mockPayslips}\n          isLoading={false}\n          selectedIds={new Set()}\n          onToggleSelect={onToggleSelect}\n          onToggleSelectAll={onToggleSelectAll}\n          onViewDetail={onViewDetail}\n          searchTerm=\"Jane\"\n          onSearchChange={onSearchChange}\n        />\n    );\n\n    expect(screen.queryByText(\"John Doe\")).toBeNull();\n    expect(screen.getByText(\"Jane Smith\")).toBeDefined();\n  });\n\n  it(\"calls onToggleSelect when checkbox is clicked\", () => {\n    render(\n        <PayrollSummaryTable\n          employees={mockEmployees}\n          payslips={mockPayslips}\n          isLoading={false}\n          selectedIds={new Set()}\n          onToggleSelect={onToggleSelect}\n          onToggleSelectAll={onToggleSelectAll}\n          onViewDetail={onViewDetail}\n          searchTerm=\"\"\n          onSearchChange={onSearchChange}\n        />\n    );\n\n    const checkbox = screen.getByTestId(\"select-employee-emp-1\");\n    fireEvent.click(checkbox);\n    expect(onToggleSelect).toHaveBeenCalledWith(\"emp-1\");\n  });\n\n  it(\"calls onViewDetail when row is clicked\", () => {\n    render(\n        <PayrollSummaryTable\n          employees={mockEmployees}\n          payslips={mockPayslips}\n          isLoading={false}\n          selectedIds={new Set()}\n          onToggleSelect={onToggleSelect}\n          onToggleSelectAll={onToggleSelectAll}\n          onViewDetail={onViewDetail}\n          searchTerm=\"\"\n          onSearchChange={onSearchChange}\n        />\n    );\n\n    fireEvent.click(screen.getByText(\"John Doe\"));\n    expect(onViewDetail).toHaveBeenCalledWith(mockEmployees[0]);\n  });\n\n  it(\"maintains input focus when switching to loading state (regression test)\", () => {\n    const { rerender } = render(\n        <PayrollSummaryTable\n          employees={mockEmployees}\n          payslips={mockPayslips}\n          isLoading={false}\n          selectedIds={new Set()}\n          onToggleSelect={onToggleSelect}\n          onToggleSelectAll={onToggleSelectAll}\n          onViewDetail={onViewDetail}\n          searchTerm=\"test\"\n          onSearchChange={onSearchChange}\n        />\n    );\n\n    // 1. Find input and focus it\n    const input = screen.getByLabelText(\"common.search\");\n    input.focus();\n    expect(input).toHaveFocus();\n\n    // 2. Rerender with isLoading=true\n    rerender(\n        <PayrollSummaryTable\n          employees={mockEmployees}\n          payslips={mockPayslips}\n          isLoading={true}\n          selectedIds={new Set()}\n          onToggleSelect={onToggleSelect}\n          onToggleSelectAll={onToggleSelectAll}\n          onViewDetail={onViewDetail}\n          searchTerm=\"test\"\n          onSearchChange={onSearchChange}\n        />\n    );\n\n    // 3. Verify input is still there and still focused\n    expect(screen.getByLabelText(\"common.search\")).toBeInTheDocument();\n    expect(screen.getByLabelText(\"common.search\")).toHaveFocus();\n\n    // 4. Verify loading state is also visible (somewhere else)\n    expect(screen.getByText(\"common.loading\")).toBeInTheDocument();\n  });\n\n  it(\"auto-focuses the search input on mount\", () => {\n    render(\n        <PayrollSummaryTable\n          employees={mockEmployees}\n          payslips={mockPayslips}\n          isLoading={false}\n          selectedIds={new Set()}\n          onToggleSelect={onToggleSelect}\n          onToggleSelectAll={onToggleSelectAll}\n          onViewDetail={onViewDetail}\n          searchTerm=\"\"\n          onSearchChange={onSearchChange}\n        />\n    );\n\n    const input = screen.getByLabelText(\"common.search\");\n    expect(input).toHaveFocus();\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/payroll/__tests__/PayrollTable.test.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'beforeEach' is defined but never used. Allowed unused vars must match /^_/u.","line":2,"column":36,"nodeType":"Identifier","messageId":"unusedVar","endLine":2,"endColumn":46,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"beforeEach"},"fix":{"range":[101,113],"text":""},"desc":"Remove unused variable \"beforeEach\"."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":8,"column":38,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":8,"endColumn":41,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[330,333],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[330,333],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"import-x/order","severity":2,"message":"`@tanstack/react-query` import should occur before import of `@testing-library/react`","line":15,"column":1,"nodeType":"ImportDeclaration","messageId":"order","endLine":15,"endColumn":74},{"ruleId":"import-x/order","severity":2,"message":"`react` import should occur before import of `@testing-library/react`","line":17,"column":1,"nodeType":"ImportDeclaration","messageId":"order","endLine":17,"endColumn":27},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":122,"column":41,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":122,"endColumn":44,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[3546,3549],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, an