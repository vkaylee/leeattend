ect."},{"messageId":"suggestNever","fix":{"range":[6762,6765],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":223,"column":39,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":223,"endColumn":42,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[7081,7084],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[7081,7084],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":649,"column":32,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":649,"endColumn":35,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[21493,21496],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[21493,21496],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":15,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { QueryClient, QueryClientProvider } from \"@tanstack/react-query\";\nimport { render, screen, fireEvent, waitFor, within } from \"@testing-library/react\";\nimport userEvent from \"@testing-library/user-event\";\nimport { describe, it, expect, vi, beforeEach } from \"vitest\";\n\nimport { ToastProvider } from \"../../components/ui/Toast\";\nimport * as api from \"../../lib/api\";\nimport ShiftsPage from \"../ShiftsPage\";\n\n// Mock TanStack Router\nvi.mock(\"@tanstack/react-router\", () => ({\n  useNavigate: () => vi.fn(),\n  useLocation: () => ({ pathname: \"/\", search: \"\", hash: \"\" }),\n  Link: ({ to, children, ...props }: any) => <a href={to} {...props}>{children}</a>,\n}));\n\n// Mock the API library\nvi.mock(\"../../lib/api\", () => ({\n  fetchEmployees: vi.fn(),\n  searchEmployees: vi.fn(),\n  fetchShifts: vi.fn(),\n  fetchWorkspace: vi.fn(),\n  fetchWorkspaceSchedules: vi.fn(),\n  fetchAssignmentHistory: vi.fn(),\n  assignShift: vi.fn(),\n  createShift: vi.fn(),\n  updateShift: vi.fn(),\n  upsertRoster: vi.fn(),\n  bulkUpsertRoster: vi.fn(),\n  deleteRoster: vi.fn(),\n  getCurrentWorkspaceId: vi.fn(),\n  fetchWorkingPatterns: vi.fn(),\n}));\n\n// Mock date-fns functions\nvi.mock(\"date-fns\", async () => {\n  const actual = await vi.importActual<typeof import(\"date-fns\")>(\"date-fns\");\n  return {\n    ...actual,\n    format: (date: Date, formatStr: string, options?: any) => {\n      if (formatStr === \"EEEE\") {\n        const days = [\"Sunday\", \"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\"];\n        return days[date.getDay()];\n      }\n      // For other formats, return YYYY-MM-DD in local time\n      const year = date.getFullYear();\n      const month = String(date.getMonth() + 1).padStart(2, '0');\n      const day = String(date.getDate()).padStart(2, '0');\n      return `${year}-${month}-${day}`;\n    },\n  };\n});\n\n// Mock i18next\nvi.mock(\"react-i18next\", () => ({\n  useTranslation: () => ({\n    t: (key: string, params?: any) => {\n      const translations: Record<string, string> = {\n        \"shifts.title\": \"Scheduling System\",\n        \"shifts.subtitle\": \"Manage flexible and fixed work shifts\",\n        \"shifts.create_btn\": \"Create Shift\",\n        \"shifts.tabs.weekly_roster\": \"WEEKLY ROSTER\",\n        \"shifts.tabs.fixed_assignments\": \"FIXED ASSIGNMENTS\",\n        \"shifts.tabs.directory\": \"DIRECTORY\",\n        \"shifts.empty_state.title\": \"Select personnel to continue\",\n        \"shifts.empty_state.desc\": \"Please select an employee from the left list to start scheduling.\",\n        \"shifts.current_week_roster\": \"Current Week Roster\",\n        \"shifts.days_selected\": `${params?.count} days selected`,\n        \"shifts.assign_selected_btn\": \"Assign shift to selected\",\n        \"shifts.off_day\": \"OFF\",\n        \"shifts.actions.copy_previous\": \"Copy previous week\",\n        \"shifts.actions.assign_all_week\": \"Assign all this week\",\n        \"shifts.actions.clear_week\": \"Clear this week\",\n        \"shifts.modal.select_shift_title\": \"Select Work Shift\",\n        \"shifts.modal.select_shift_subtitle\": `Choose shift for ${params?.count} selected days`,\n        \"shifts.modal.mark_as_off\": \"Mark selected days as off/rest day\",\n        \"common.employees\": \"Employees\",\n        \"common.people\": \"people\",\n        \"common.week\": \"Week\",\n        \"common.quick_actions\": \"Quick Actions\",\n        \"common.cancel\": \"Cancel\",\n        \"common.break\": \"Break\",\n        \"common.minutes\": \"minutes\",\n        \"common.search_employee\": \"Search employees...\",\n      };\n      return translations[key] || key;\n    },\n    i18n: { language: \"en\" },\n  }),\n}));\n\n// Mock useDateTimeFormatter\nvi.mock(\"@/hooks/use-datetime\", () => ({\n  useDateTimeFormatter: () => ({\n    formatDate: (date: Date | string) => {\n      const d = typeof date === \"string\" ? new Date(date) : date;\n      const day = String(d.getDate()).padStart(2, '0');\n      const month = String(d.getMonth() + 1).padStart(2, '0');\n      const year = d.getFullYear();\n      return `${day}/${month}/${year}`;\n    },\n    formatTime: (time: string) => time.substring(0, 5),\n    formatDateTime: (datetime: string) => datetime,\n  }),\n}));\n\ndescribe(\"ShiftsPage - Shift Picker Modal\", () => {\n  let queryClient: QueryClient;\n\n  const mockEmployees = {\n    data: [\n      {\n        id: \"emp-1\",\n        full_name: \"John Doe\",\n        employee_id_number: \"EMP001\",\n        workspace_id: \"ws-1\",\n        is_active: true,\n        hire_date: \"2025-01-01\",\n        created_at: \"2025-01-01T00:00:00Z\",\n        updated_at: \"2025-01-01T00:00:00Z\",\n      },\n      {\n        id: \"emp-2\",\n        full_name: \"Jane Smith\",\n        employee_id_number: \"EMP002\",\n        workspace_id: \"ws-1\",\n        is_active: true,\n        hire_date: \"2025-01-02\",\n        created_at: \"2025-01-02T00:00:00Z\",\n        updated_at: \"2025-01-02T00:00:00Z\",\n      },\n    ],\n    total: 2,\n    page: 1,\n    limit: 50,\n  };\n\n  const mockShifts = [\n    {\n      id: \"shift-1\",\n      name: \"Morning Shift\",\n      start_time: \"08:00:00\",\n      end_time: \"16:00:00\",\n      break_duration_minutes: 60,\n      break_start: null,\n      break_end: null,\n      is_break_auto_deduct: true,\n    },\n    {\n      id: \"shift-2\",\n      name: \"Afternoon Shift\",\n      start_time: \"14:00:00\",\n      end_time: \"22:00:00\",\n      break_duration_minutes: 60,\n      break_start: \"18:00:00\",\n      break_end: \"19:00:00\",\n      is_break_auto_deduct: true,\n    },\n    {\n      id: \"shift-3\",\n      name: \"Night Shift\",\n      start_time: \"22:00:00\",\n      end_time: \"06:00:00\",\n      break_duration_minutes: 30,\n      break_start: null,\n      break_end: null,\n      is_break_auto_deduct: true,\n    },\n  ];\n\n  const mockSchedules = [\n    {\n      employee_id: \"emp-1\",\n      schedules: [\n        {\n          date: \"2026-01-20\",\n          shift_id: \"shift-1\",\n          shift_name: \"Morning Shift\",\n          start_time: \"08:00:00\",\n          end_time: \"16:00:00\",\n          break_duration_minutes: 60,\n          break_start: null,\n          break_end: null,\n          source: \"roster\",\n        },\n      ],\n    },\n  ];\n\n  beforeEach(() => {\n    vi.clearAllMocks();\n    queryClient = new QueryClient({\n      defaultOptions: {\n        queries: {\n          retry: false,\n          gcTime: 0,\n          staleTime: 0,\n        },\n      },\n    });\n\n    (api.getCurrentWorkspaceId as any).mockReturnValue(\"test-ws-id\");\n    (api.fetchEmployees as any).mockResolvedValue(mockEmployees);\n    (api.fetchShifts as any).mockResolvedValue(mockShifts);\n    (api.fetchWorkspace as any).mockResolvedValue({ id: \"test-ws-id\", name: \"Test Workspace\" });\n    (api.fetchWorkspaceSchedules as any).mockResolvedValue(mockSchedules);\n    (api.fetchAssignmentHistory as any).mockResolvedValue([]);\n    (api.bulkUpsertRoster as any).mockResolvedValue({});\n    (api.fetchWorkingPatterns as any).mockResolvedValue([]);\n    (api as any).searchEmployees.mockResolvedValue(mockEmployees);\n  });\n\n  const renderShiftsPage = () => {\n    return render(\n      <QueryClientProvider client={queryClient}>\n        <ToastProvider>\n          <ShiftsPage />\n        </ToastProvider>\n      </QueryClientProvider>\n    );\n  };\n\n  const selectEmployee = async (user: any, employeeId: string) => {\n    const select = screen.getByTestId(\"employee-select\") as HTMLSelectElement;\n    await waitFor(() => expect(select.options.length).toBeGreaterThan(1));\n    fireEvent.change(select, { target: { value: employeeId } });\n  };\n\n  describe(\"Shift Picker Modal - Unit Tests\", () => {\n    it(\"should render weekly roster tab by default\", async () => {\n      renderShiftsPage();\n\n      await waitFor(() => {\n        expect(screen.getByText(\"WEEKLY ROSTER\")).toBeDefined();\n      });\n    });\n\n    it(\"should show employee options in select\", async () => {\n      const user = userEvent.setup();\n      renderShiftsPage();\n\n      // Open combobox\n      const trigger = await screen.findByTestId(\"employee-select\");\n      await user.click(trigger);\n\n      await waitFor(() => {\n        expect(screen.getByText(\"John Doe\")).toBeInTheDocument();\n        expect(screen.getByText(\"Jane Smith\")).toBeInTheDocument();\n      });\n    });\n\n    it(\"should allow selecting an employee\", async () => {\n      const user = userEvent.setup();\n      renderShiftsPage();\n\n      await selectEmployee(user, \"emp-1\");\n\n      await waitFor(() => {\n        expect(screen.getByText(\"Current Week Roster\")).toBeDefined();\n      });\n    });\n\n    it(\"should allow selecting multiple days by clicking\", async () => {\n      const user = userEvent.setup();\n      renderShiftsPage();\n\n      await selectEmployee(user, \"emp-1\");\n\n      await waitFor(() => {\n        expect(screen.getByText(\"Current Week Roster\")).toBeDefined();\n      });\n\n      const dayCards = screen.getAllByRole(\"generic\").filter(el =>\n        el.className.includes(\"rounded-[32px]\") && el.className.includes(\"cursor-pointer\")\n      );\n\n      if (dayCards.length > 0) {\n        await user.click(dayCards[0]);\n        await waitFor(() => {\n          expect(screen.getByText(\"1 days selected\")).toBeDefined();\n        });\n      }\n    });\n\n    it(\"should show assign button when days are selected\", async () => {\n      const user = userEvent.setup();\n      renderShiftsPage();\n\n      await selectEmployee(user, \"emp-1\");\n\n      await waitFor(() => {\n        expect(screen.getByText(\"Current Week Roster\")).toBeDefined();\n      });\n\n      const dayCards = screen.getAllByRole(\"generic\").filter(el =>\n        el.className.includes(\"rounded-[32px]\") && el.className.includes(\"cursor-pointer\")\n      );\n\n      if (dayCards.length > 0) {\n        await user.click(dayCards[0]);\n        await waitFor(() => {\n          expect(screen.getByText(\"Assign shift to selected\")).toBeDefined();\n        });\n      }\n    });\n\n    it(\"should open shift picker modal when assign button is clicked\", async () => {\n      const user = userEvent.setup();\n      renderShiftsPage();\n\n      await selectEmployee(user, \"emp-1\");\n\n      await waitFor(() => {\n        expect(screen.getByText(\"Current Week Roster\")).toBeDefined();\n      });\n\n      const dayCards = screen.getAllByRole(\"generic\").filter(el =>\n        el.className.includes(\"rounded-[32px]\") && el.className.includes(\"cursor-pointer\")\n      );\n\n      if (dayCards.length > 0) {\n        await user.click(dayCards[0]);\n        const assignButton = await screen.findByText(\"Assign shift to selected\");\n        await user.click(assignButton.closest(\"button\")!);\n        await waitFor(() => {\n          expect(screen.getByText(\"Select Work Shift\")).toBeDefined();\n        });\n      }\n    });\n\n    it(\"should display all available shifts in the modal\", async () => {\n      const user = userEvent.setup();\n      renderShiftsPage();\n\n      await selectEmployee(user, \"emp-1\");\n\n      await waitFor(() => {\n        expect(screen.getByText(\"Current Week Roster\")).toBeDefined();\n      });\n\n      const dayCards = screen.getAllByRole(\"generic\").filter(el =>\n        el.className.includes(\"rounded-[32px]\") && el.className.includes(\"cursor-pointer\")\n      );\n\n      if (dayCards.length > 0) {\n        await user.click(dayCards[0]);\n        const assignButton = await screen.findByText(\"Assign shift to selected\");\n        await user.click(assignButton.closest(\"button\")!);\n        await waitFor(() => {\n          expect(screen.getAllByText(\"Morning Shift\").length).toBeGreaterThan(0);\n          expect(screen.getAllByText(\"Afternoon Shift\").length).toBeGreaterThan(0);\n          expect(screen.getAllByText(\"Night Shift\").length).toBeGreaterThan(0);\n        });\n      }\n    });\n\n    it(\"should display OFF option in the modal\", async () => {\n      const user = userEvent.setup();\n      renderShiftsPage();\n\n      await selectEmployee(user, \"emp-1\");\n\n      await waitFor(() => {\n        expect(screen.getByText(\"Current Week Roster\")).toBeDefined();\n      });\n\n      const dayCards = screen.getAllByRole(\"generic\").filter(el =>\n        el.className.includes(\"rounded-[32px]\") && el.className.includes(\"cursor-pointer\")\n      );\n\n      if (dayCards.length > 0) {\n        await user.click(dayCards[0]);\n        const assignButton = await screen.findByText(\"Assign shift to selected\");\n        await user.click(assignButton.closest(\"button\")!);\n        await waitFor(() => {\n          expect(screen.getAllByText(\"OFF\").length).toBeGreaterThan(0);\n          expect(screen.getByText(\"Mark selected days as off/rest day\")).toBeDefined();\n        });\n      }\n    });\n\n    it(\"should close modal when cancel is clicked\", async () => {\n      const user = userEvent.setup();\n      renderShiftsPage();\n\n      await selectEmployee(user, \"emp-1\");\n\n      await waitFor(() => {\n        expect(screen.getByText(\"Current Week Roster\")).toBeDefined();\n      });\n\n      const dayCards = screen.getAllByRole(\"generic\").filter(el =>\n        el.className.includes(\"rounded-[32px]\") && el.className.includes(\"cursor-pointer\")\n      );\n\n      if (dayCards.length > 0) {\n        await user.click(dayCards[0]);\n        const assignButton = await screen.findByText(\"Assign shift to selected\");\n        await user.click(assignButton.closest(\"button\")!);\n        await waitFor(() => {\n          expect(screen.getByText(\"Select Work Shift\")).toBeDefined();\n        });\n\n        const cancelButtons = screen.getAllByText(\"Cancel\");\n        if (cancelButtons.length > 0) {\n          await user.click(cancelButtons[0].closest(\"button\")!);\n          await waitFor(() => {\n            expect(screen.queryByText(\"Select Work Shift\")).toBeNull();\n          });\n        }\n      }\n    });\n\n    it(\"should keep selected days when modal is cancelled\", async () => {\n      const user = userEvent.setup();\n      renderShiftsPage();\n\n      await selectEmployee(user, \"emp-1\");\n\n      await waitFor(() => {\n        expect(screen.getByText(\"Current Week Roster\")).toBeDefined();\n      });\n\n      const dayCards = screen.getAllByRole(\"generic\").filter(el =>\n        el.className.includes(\"rounded-[32px]\") && el.className.includes(\"cursor-pointer\")\n      );\n\n      if (dayCards.length > 0) {\n        await user.click(dayCards[0]);\n        const assignButton = await screen.findByText(\"Assign shift to selected\");\n        await user.click(assignButton.closest(\"button\")!);\n        await waitFor(() => {\n          expect(screen.getByText(\"Select Work Shift\")).toBeDefined();\n        });\n\n        const cancelButtons = screen.getAllByText(\"Cancel\");\n        if (cancelButtons.length > 0) {\n          await user.click(cancelButtons[0].closest(\"button\")!);\n          await waitFor(() => {\n            expect(screen.queryByText(\"Select Work Shift\")).toBeNull();\n          });\n          await waitFor(() => {\n            expect(screen.getByText(\"1 days selected\")).toBeDefined();\n          });\n        }\n      }\n    });\n  });\n\n  describe(\"Shift Picker Modal - Integration Tests\", () => {\n    it(\"should call bulkUpsertRoster when a shift is selected\", async () => {\n      const user = userEvent.setup();\n      renderShiftsPage();\n\n      await selectEmployee(user, \"emp-1\");\n\n      await waitFor(() => {\n        expect(screen.getByText(\"Current Week Roster\")).toBeDefined();\n      });\n\n      const dayCards = screen.getAllByRole(\"generic\").filter(el =>\n        el.className.includes(\"rounded-[32px]\") && el.className.includes(\"cursor-pointer\")\n      );\n\n      if (dayCards.length > 0) {\n        await user.click(dayCards[0]);\n        const assignButton = await screen.findByText(\"Assign shift to selected\");\n        await user.click(assignButton.closest(\"button\")!);\n\n        const modal = await screen.findByRole(\"dialog\");\n        const morningShiftButton = within(modal).getByText(\"Morning Shift\").closest(\"button\");\n        await user.click(morningShiftButton!);\n\n        await waitFor(() => {\n          expect(api.bulkUpsertRoster).toHaveBeenCalledWith(\n            \"test-ws-id\",\n            \"emp-1\",\n            expect.arrayContaining([\n              expect.objectContaining({ shift_id: \"shift-1\" })\n            ])\n          );\n        });\n      }\n    });\n\n    it(\"should call bulkUpsertRoster with null when OFF is selected\", async () => {\n      const user = userEvent.setup();\n      renderShiftsPage();\n\n      await selectEmployee(user, \"emp-1\");\n\n      await waitFor(() => {\n        expect(screen.getByText(\"Current Week Roster\")).toBeDefined();\n      });\n\n      const dayCards = screen.getAllByRole(\"generic\").filter(el =>\n        el.className.includes(\"rounded-[32px]\") && el.className.includes(\"cursor-pointer\")\n      );\n\n      if (dayCards.length > 0) {\n        await user.click(dayCards[0]);\n        const assignButton = await screen.findByText(\"Assign shift to selected\");\n        await user.click(assignButton.closest(\"button\")!);\n\n        await waitFor(() => {\n          expect(screen.getByText(\"Mark selected days as off/rest day\")).toBeDefined();\n        });\n\n        const offButton = screen.getByText(\"Mark selected days as off/rest day\").closest(\"button\");\n        await user.click(offButton!);\n\n        await waitFor(() => {\n          expect(api.bulkUpsertRoster).toHaveBeenCalledWith(\n            \"test-ws-id\",\n            \"emp-1\",\n            expect.arrayContaining([\n              expect.objectContaining({ shift_id: null })\n            ])\n          );\n        });\n      }\n    });\n\n    it(\"should close modal after successful shift assignment\", async () => {\n      const user = userEvent.setup();\n      renderShiftsPage();\n\n      await selectEmployee(user, \"emp-1\");\n\n      await waitFor(() => {\n        expect(screen.getByText(\"Current Week Roster\")).toBeDefined();\n      });\n\n      const dayCards = screen.getAllByRole(\"generic\").filter(el =>\n        el.className.includes(\"rounded-[32px]\") && el.className.includes(\"cursor-pointer\")\n      );\n\n      if (dayCards.length > 0) {\n        await user.click(dayCards[0]);\n        const assignButton = await screen.findByText(\"Assign shift to selected\");\n        await user.click(assignButton.closest(\"button\")!);\n\n        const modal = await screen.findByRole(\"dialog\");\n        const morningShiftButton = within(modal).getByText(\"Morning Shift\").closest(\"button\");\n        await user.click(morningShiftButton!);\n\n        await waitFor(() => {\n          expect(screen.queryByText(\"Select Work Shift\")).toBeNull();\n        });\n      }\n    });\n\n    it(\"should handle bulk assignment for multiple selected days\", async () => {\n      const user = userEvent.setup();\n      renderShiftsPage();\n\n      await selectEmployee(user, \"emp-1\");\n\n      await waitFor(() => {\n        expect(screen.getByText(\"Current Week Roster\")).toBeDefined();\n      });\n\n      const dayCards = screen.getAllByRole(\"generic\").filter(el =>\n        el.className.includes(\"rounded-[32px]\") && el.className.includes(\"cursor-pointer\")\n      );\n\n      if (dayCards.length >= 3) {\n        await user.click(dayCards[0]);\n        await user.click(dayCards[1]);\n        await user.click(dayCards[2]);\n\n        await waitFor(() => {\n          expect(screen.getByText(\"3 days selected\")).toBeDefined();\n        });\n\n        const assignButton = await screen.findByText(\"Assign shift to selected\");\n        await user.click(assignButton.closest(\"button\")!);\n\n        const modal = await screen.findByRole(\"dialog\");\n        const morningShiftButton = within(modal).getByText(\"Morning Shift\").closest(\"button\");\n        await user.click(morningShiftButton!);\n\n        await waitFor(() => {\n          expect(api.bulkUpsertRoster).toHaveBeenCalledWith(\n            \"test-ws-id\",\n            \"emp-1\",\n            expect.arrayContaining([\n              expect.objectContaining({ shift_id: \"shift-1\" }),\n              expect.objectContaining({ shift_id: \"shift-1\" }),\n              expect.objectContaining({ shift_id: \"shift-1\" }),\n            ])\n          );\n        }, { timeout: 20000 });\n      }\n    }, 30000);\n\n    it(\"should open shift picker from quick actions assign all week\", async () => {\n      const user = userEvent.setup();\n      renderShiftsPage();\n\n      await selectEmployee(user, \"emp-1\");\n\n      await waitFor(() => {\n        expect(screen.getByText(\"Current Week Roster\")).toBeDefined();\n      });\n      // Test omitted as it requires deeper Combobox mocking\n    });\n\n    it(\"should invalidate queries after successful assignment\", async () => {\n      const user = userEvent.setup();\n      const invalidateSpy = vi.spyOn(queryClient, \"invalidateQueries\");\n\n      renderShiftsPage();\n\n      await selectEmployee(user, \"emp-1\");\n\n      await waitFor(() => {\n        expect(screen.getByText(\"Current Week Roster\")).toBeDefined();\n      });\n\n      const dayCards = screen.getAllByRole(\"generic\").filter(el =>\n        el.className.includes(\"rounded-[32px]\") && el.className.includes(\"cursor-pointer\")\n      );\n\n      if (dayCards.length > 0) {\n        await user.click(dayCards[0]);\n        const assignButton = await screen.findByText(\"Assign shift to selected\");\n        await user.click(assignButton.closest(\"button\")!);\n\n        const modal = await screen.findByRole(\"dialog\");\n        const morningShiftButton = within(modal).getByText(\"Morning Shift\").closest(\"button\");\n        await user.click(morningShiftButton!);\n\n        await waitFor(() => {\n          expect(invalidateSpy).toHaveBeenCalledWith(\n            expect.objectContaining({ queryKey: [\"schedules\"] })\n          );\n          expect(invalidateSpy).toHaveBeenCalledWith(\n            expect.objectContaining({ queryKey: [\"assignment_history\"] })\n          );\n        });\n      }\n    });\n  });\n\n  describe(\"Shift Picker Modal - Error Handling\", () => {\n    it(\"should handle API error gracefully\", async () => {\n      const user = userEvent.setup();\n      (api.bulkUpsertRoster as any).mockRejectedValueOnce(new Error(\"API Error\"));\n\n      renderShiftsPage();\n\n      await selectEmployee(user, \"emp-1\");\n\n      await waitFor(() => {\n        expect(screen.getByText(\"Current Week Roster\")).toBeDefined();\n      });\n\n      const dayCards = screen.getAllByRole(\"generic\").filter(el =>\n        el.className.includes(\"rounded-[32px]\") && el.className.includes(\"cursor-pointer\")\n      );\n\n      if (dayCards.length > 0) {\n        await user.click(dayCards[0]);\n        const assignButton = await screen.findByText(\"Assign shift to selected\");\n        await user.click(assignButton.closest(\"button\")!);\n\n        const modal = await screen.findByRole(\"dialog\");\n        const morningShiftButton = within(modal).getByText(\"Morning Shift\").closest(\"button\");\n        await user.click(morningShiftButton!);\n\n        await new Promise(resolve => setTimeout(resolve, 100));\n\n        await waitFor(() => {\n          expect(screen.queryByText(\"Select Work Shift\")).toBeNull();\n        }, { timeout: 2000 });\n\n        expect(api.bulkUpsertRoster).toHaveBeenCalled();\n      }\n    });\n\n    it(\"should not open modal when no employee is selected\", async () => {\n      renderShiftsPage();\n      await waitFor(() => {\n        expect(screen.getByTestId(\"employee-select\")).toBeDefined();\n      });\n      expect(screen.queryByText(\"Assign shift to selected\")).toBeNull();\n    });\n  });\n});","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/__tests__/SystemRolesPage.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]