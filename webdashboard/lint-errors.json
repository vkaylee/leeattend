URL } from \"../config\";\nimport { apiFetch } from \"../helpers\";\n\ndescribe(\"fetchAttendanceReport\", () => {\n    beforeEach(() => {\n        vi.clearAllMocks();\n    });\n\n    it(\"should append standard query parameters correctly\", async () => {\n        (apiFetch as any).mockResolvedValueOnce({\n            ok: true,\n            json: async () => ({ data: [], total: 0 }),\n        });\n\n        await fetchAttendanceReport(\"test-ws-id\", \"2026-03-01\", \"2026-03-31\", \"summary\");\n\n        expect(apiFetch).toHaveBeenCalledTimes(1);\n        const calledUrl = (apiFetch as any).mock.calls[0][0];\n\n        expect(calledUrl).toContain(`${API_BASE_URL}/workspaces/test-ws-id/reports/attendance`);\n        expect(calledUrl).toContain(\"start_date=2026-03-01\");\n        expect(calledUrl).toContain(\"end_date=2026-03-31\");\n        expect(calledUrl).toContain(\"type=summary\");\n        expect(calledUrl).not.toContain(\"department_id=\"); // Should not be there if omitted\n    });\n\n    it(\"should append department_id query parameter when provided\", async () => {\n        (apiFetch as any).mockResolvedValueOnce({\n            ok: true,\n            json: async () => ({ data: [], total: 0 }),\n        });\n\n        const departmentId = \"dept-uuid-123\";\n\n        // type signature: wsId, start, end, type, page, limit, sort, employeeIds, departmentId\n        await fetchAttendanceReport(\n            \"test-ws-id\",\n            \"2026-03-01\",\n            \"2026-03-31\",\n            \"summary\",\n            1,\n            20,\n            undefined,\n            undefined,\n            departmentId\n        );\n\n        expect(apiFetch).toHaveBeenCalledTimes(1);\n        const calledUrl = (apiFetch as any).mock.calls[0][0];\n\n        // Verify department_id is appended correctly\n        expect(calledUrl).toContain(`department_id=${departmentId}`);\n\n        // Check some other standard params were mapped correctly\n        expect(calledUrl).toContain(\"page=1\");\n        expect(calledUrl).toContain(\"limit=20\");\n    });\n\n    it(\"should format employee_ids as comma-separated string when provided\", async () => {\n        (apiFetch as any).mockResolvedValueOnce({\n            ok: true,\n            json: async () => ({ data: [], total: 0 }),\n        });\n\n        const employeeIds = [\"emp-1\", \"emp-2\"];\n\n        await fetchAttendanceReport(\n            \"test-ws-id\",\n            \"2026-03-01\",\n            \"2026-03-31\",\n            \"summary\",\n            1,\n            20,\n            undefined,\n            employeeIds\n        );\n\n        expect(apiFetch).toHaveBeenCalledTimes(1);\n        const calledUrl = (apiFetch as any).mock.calls[0][0];\n\n        expect(calledUrl).toContain(\"employee_ids=emp-1%2Cemp-2\"); // %2C is URL encoded comma\n    });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/lib/api/__tests__/helpers.test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/lib/api/__tests__/pagination-response-handling.test.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'beforeEach' is defined but never used. Allowed unused vars must match /^_/u.","line":1,"column":32,"nodeType":"Identifier","messageId":"unusedVar","endLine":1,"endColumn":42,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"beforeEach"},"fix":{"range":[29,41],"text":""},"desc":"Remove unused variable \"beforeEach\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'fetchEmployees' is defined but never used. Allowed unused vars must match /^_/u.","line":3,"column":10,"nodeType":"Identifier","messageId":"unusedVar","endLine":3,"endColumn":24,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"fetchEmployees"},"fix":{"range":[73,88],"text"