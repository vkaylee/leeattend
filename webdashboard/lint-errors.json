,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from \"react\";\n\nimport { QueryClient, QueryClientProvider } from \"@tanstack/react-query\";\nimport { renderHook, waitFor } from \"@testing-library/react\";\nimport { describe, it, expect, vi } from \"vitest\";\n\nimport * as api from \"@/lib/api\";\n\nimport {\n  useWorkspaces,\n  useWorkspaceMembers,\n  useMemberRoles,\n} from \"../use-workspace\";\n\n\n\n\n// Mock the API\nvi.mock(\"@/lib/api\", () => ({\n  fetchWorkspaces: vi.fn(),\n  createWorkspace: vi.fn(),\n  fetchWorkspaceMembers: vi.fn(),\n  addWorkspaceMember: vi.fn(),\n  fetchWorkspaceRoles: vi.fn(),\n  createWorkspaceRole: vi.fn(),\n  updateWorkspaceRole: vi.fn(),\n  deleteWorkspaceRole: vi.fn(),\n  fetchRolePermissions: vi.fn(),\n  updateRolePermissions: vi.fn(),\n  fetchMemberRoles: vi.fn(),\n  assignExtraRole: vi.fn(),\n  revokeExtraRole: vi.fn(),\n  getCurrentUserId: vi.fn().mockReturnValue(\"user-123\"),\n  getCurrentWorkspaceId: vi.fn().mockReturnValue(\"ws-123\"),\n  setCurrentWorkspaceId: vi.fn(),\n}));\n\nconst createWrapper = () => {\n  const queryClient = new QueryClient({\n    defaultOptions: {\n      queries: {\n        retry: false,\n      },\n    },\n  });\n  return ({ children }: { children: React.ReactNode }) => (\n    <QueryClientProvider client={queryClient}>{children}</QueryClientProvider>\n  );\n};\n\ndescribe(\"useWorkspaces\", () => {\n  it(\"fetches workspaces successfully\", async () => {\n      const mockWorkspaces = [\n        {\n          id: \"ws-1\",\n          name: \"Workspace 1\",\n          work_unit_minutes: 30,\n          rounding_policy: \"none\",\n          date_format: \"DD/MM/YYYY\",\n          time_format: \"24h\",\n          timezone: \"Asia/Ho_Chi_Minh\",\n          theme_primary_color: \"#10b981\",\n          default_language: \"en\",\n          created_at: new Date().toISOString()\n        },\n      ];\n        vi.mocked(api.fetchWorkspaces).mockResolvedValue(mockWorkspaces as any);\n\n    const { result } = renderHook(() => useWorkspaces(), {\n      wrapper: createWrapper(),\n    });\n\n    await waitFor(() => expect(result.current.isLoading).toBe(false));\n    expect(result.current.workspaces).toEqual(mockWorkspaces);\n  });\n\n  it(\"creates a workspace and invalidates queries\", async () => {\n        const newWs = { \n          id: \"ws-new\", \n          name: \"New WS\", \n          work_unit_minutes: 30, \n          rounding_policy: \"none\", \n          date_format: \"DD/MM/YYYY\", \n          time_format: \"24h\", \n          timezone: \"Asia/Ho_Chi_Minh\", \n          theme_primary_color: \"#10b981\",\n          default_language: \"en\",\n          created_at: new Date().toISOString() \n        };    vi.mocked(api.createWorkspace).mockResolvedValue(newWs as any);\n\n    const { result } = renderHook(() => useWorkspaces(), {\n      wrapper: createWrapper(),\n    });\n\n    const created = await result.current.createWorkspace({ name: \"New WS\" });\n    expect(created).toEqual(newWs);\n    expect(api.createWorkspace).toHaveBeenCalled();\n  });\n});\n\ndescribe(\"useWorkspaceMembers\", () => {\n  it(\"fetches members successfully\", async () => {\n    const mockMembers = [\n      { workspace_id: \"ws-1\", user_id: \"u-1\", email: \"owner@test.com\", role_id: \"role-1\", extra_role_ids: [] },\n    ];\n    vi.mocked(api.fetchWorkspaceMembers).mockResolvedValue(mockMembers as any);\n\n    const { result } = renderHook(() => useWorkspaceMembers(\"ws-1\"), {\n      wrapper: createWrapper(),\n    });\n\n    await waitFor(() => expect(result.current.isLoading).toBe(false));\n    expect(result.current.members).toEqual(mockMembers);\n  });\n\n  it(\"adds a member successfully\", async () => {\n    vi.mocked(api.addWorkspaceMember).mockResolvedValue(undefined as any);\n\n    const { result } = renderHook(() => useWorkspaceMembers(\"ws-1\"), {\n      wrapper: createWrapper(),\n    });\n\n    await result.current.addMember({\n      email: \"test@example.com\",\n      roleId: \"role-1\",\n    });\n    expect(api.addWorkspaceMember).toHaveBeenCalledWith(\n      \"ws-1\",\n      \"test@example.com\",\n      \"role-1\",\n    );\n  });\n});\n\ndescribe(\"useWorkspaceRoles\", () => {\n  it(\"fetches roles successfully\", async () => {\n    const mockRoles = [\n      { id: \"role-1\", name: \"Admin\", is_system: true, color: \"indigo\", created_at: \"\", updated_at: \"\" }\n    ];\n    vi.mocked(api.fetchWorkspaceRoles).mockResolvedValue(mockRoles as any);\n\n    const { renderHook, waitFor } = await import(\"@testing-library/react\");\n    const { useWorkspaceRoles } = await import(\"../use-workspace\");\n    const { result } = renderHook(() => useWorkspaceRoles(\"ws-1\"), {\n      wrapper: createWrapper(),\n    });\n\n    await waitFor(() => expect(result.current.isLoading).toBe(false));\n    expect(result.current.roles).toEqual(mockRoles);\n  });\n\n  it(\"creates a role successfully\", async () => {\n    vi.mocked(api.createWorkspaceRole).mockResolvedValue({ id: \"role-new\", name: \"New Role\" } as any);\n    const { renderHook } = await import(\"@testing-library/react\");\n    const { useWorkspaceRoles } = await import(\"../use-workspace\");\n    \n    const { result } = renderHook(() => useWorkspaceRoles(\"ws-1\"), {\n      wrapper: createWrapper(),\n    });\n\n    await result.current.createRole({ name: \"New Role\", color: \"blue\" });\n    expect(api.createWorkspaceRole).toHaveBeenCalledWith(\"ws-1\", { name: \"New Role\", color: \"blue\" });\n  });\n\n  it(\"updates a role successfully\", async () => {\n    vi.mocked(api.updateWorkspaceRole).mockResolvedValue({ id: \"role-1\", name: \"Updated\" } as any);\n    const { renderHook } = await import(\"@testing-library/react\");\n    const { useWorkspaceRoles } = await import(\"../use-workspace\");\n    \n    const { result } = renderHook(() => useWorkspaceRoles(\"ws-1\"), {\n      wrapper: createWrapper(),\n    });\n\n    await result.current.updateRole({ roleId: \"role-1\", data: { name: \"Updated\" } });\n    expect(api.updateWorkspaceRole).toHaveBeenCalledWith(\"ws-1\", \"role-1\", { name: \"Updated\" });\n  });\n\n  it(\"deletes a role successfully\", async () => {\n    vi.mocked(api.deleteWorkspaceRole).mockResolvedValue(undefined as any);\n    const { renderHook } = await import(\"@testing-library/react\");\n    const { useWorkspaceRoles } = await import(\"../use-workspace\");\n    \n    const { result } = renderHook(() => useWorkspaceRoles(\"ws-1\"), {\n      wrapper: createWrapper(),\n    });\n\n    await result.current.deleteRole(\"role-1\");\n    expect(api.deleteWorkspaceRole).toHaveBeenCalledWith(\"ws-1\", \"role-1\");\n  });\n});\n\ndescribe(\"useWorkspacePermissionsMatrix\", () => {\n  it(\"fetches matrix successfully\", async () => {\n    const mockRoles = [\n      { id: \"role-1\", name: \"Admin\", is_system: true, color: \"indigo\" },\n      { id: \"role-2\", name: \"Member\", is_system: false, color: \"slate\" }\n    ];\n    vi.mocked(api.fetchWorkspaceRoles).mockResolvedValue(mockRoles as any);\n    \n    // role-1 has perms: p1, p2. role-2 has: p2.\n    vi.mocked(api.fetchRolePermissions).mockImplementation(async (wsId, roleId) => {\n      if (roleId === \"role-1\") return [\"p1\", \"p2\"];\n      if (roleId === \"role-2\") return [\"p2\"];\n      return [];\n    });\n\n    const { renderHook, waitFor } = await import(\"@testing-library/react\");\n    const { useWorkspacePermissionsMatrix } = await import(\"../use-workspace\");\n    const { result } = renderHook(() => useWorkspacePermissionsMatrix(\"ws-1\"), {\n      wrapper: createWrapper(),\n    });\n\n    await waitFor(() => expect(Object.keys(result.current.matrix).length).toBeGreaterThan(0));\n    expect(result.current.matrix).toEqual({\n      \"role-1\": [\"p1\", \"p2\"],\n      \"role-2\": [\"p2\"],\n    });\n  });\n\n  it(\"includes role IDs in the query key to trigger refetch when roles change\", async () => {\n    const mockRoles = [\n      { id: \"role-1\", name: \"Admin\", is_system: true, color: \"indigo\" },\n      { id: \"role-new\", name: \"New\", is_system: false, color: \"slate\" }\n    ];\n    vi.mocked(api.fetchWorkspaceRoles).mockResolvedValue(mockRoles as any);\n    vi.mocked(api.fetchRolePermissions).mockResolvedValue([]);\n\n    const { renderHook, waitFor } = await import(\"@testing-library/react\");\n    const { useWorkspacePermissionsMatrix } = await import(\"../use-workspace\");\n    \n    // We can spy on useQuery indirectly, but it's simpler to test that it doesn't crash\n    // and returns a matrix with the new role.\n    const { result } = renderHook(() => useWorkspacePermissionsMatrix(\"ws-1\"), {\n      wrapper: createWrapper(),\n    });\n\n    await waitFor(() => expect(result.current.matrix[\"role-new\"]).toBeDefined());\n    expect(result.current.matrix[\"role-new\"]).toEqual([]);\n  });\n});\n\ndescribe(\"useMemberRoles\", () => {\n  it(\"fetches roles successfully\", async () => {\n    const mockRoles = { primary: \"a0000000-0000-0000-0000-000000000002\", extra: [] };\n    vi.mocked(api.fetchMemberRoles).mockResolvedValue(mockRoles as any);\n\n    const { result } = renderHook(() => useMemberRoles(\"u-1\", \"ws-1\"), {\n      wrapper: createWrapper(),\n    });\n\n    await waitFor(() => expect(result.current.isLoading).toBe(false));\n    expect(result.current.roles).toEqual(mockRoles);\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/hooks/__tests__/useTickingDeviceTime.test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/hooks/use-agents.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":67,"column":58,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":67,"endColumn":61,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1842,1845],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1842,1845],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState } from \"react\";\n\nimport { useQuery, useMutation, useQueryClient } from \"@tanstack/react-query\";\n\nimport {\n  fetchAuthorizedAgents,\n  createAuthorizedAgent,\n  updateAgentTrust,\n  deleteAuthorizedAgent,\n  updateAuthorizedAgent,\n  fetchAgents,\n  AuthorizedAgent,\n  sendAgentCommand,\n} from \"@/lib/api\";\n\nexport const agentsKeys = {\n  authorized: (includeInactive: boolean) =>\n    [\"authorized-agents\", { includeInactive }] as const,\n  status: [\"agents-status\"] as const,\n};\n\nexport function useAuthorizedAgents() {\n  const queryClient = useQueryClient();\n  const [includeInactive, setIncludeInactive] = useState(false);\n\n  const agentsQuery = useQuery({\n    queryKey: agentsKeys.authorized(includeInactive),\n    queryFn: () => fetchAuthorizedAgents(includeInactive),\n  });\n\n  const createMutation = useMutation({\n    mutationFn: createAuthorizedAgent,\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: [\"authorized-agents\"] });\n    },\n  });\n\n  const updateTrustMutation = useMutation({\n    mutationFn: ({ id, is_trusted }: { id: string; is_trusted: boolean }) =>\n      updateAgentTrust(id, is_trusted),\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: [\"authorized-agents\"] });\n    },\n  });\n\n  const deleteMutation = useMutation({\n    mutationFn: deleteAuthorizedAgent,\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: [\"authorized-agents\"] });\n    },\n  });\n\n  const updateMutation = useMutation({\n    mutationFn: ({\n      id,\n      agent,\n    }: {\n      id: string;\n      agent: Partial<AuthorizedAgent>;\n    }) => updateAuthorizedAgent(id, agent),\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: [\"authorized-agents\"] });\n    },\n  });\n\n  const sendCommandMutation = useMutation({\n    mutationFn: ({ id, command }: { id: string; command: any }) =>\n      sendAgentCommand(id, command),\n  });\n\n  return {\n    agents: agentsQuery.data ?? [],\n    isLoading: agentsQuery.isLoading,\n    isFetching: agentsQuery.isFetching,\n    error: agentsQuery.error,\n    refetch: agentsQuery.refetch,\n    includeInactive,\n    setIncludeInactive,\n\n    createAgent: createMutation.mutateAsync,\n    updateTrust: updateTrustMutation.mutateAsync,\n    deleteAgent: deleteMutation.mutateAsync,\n    updateAgent: updateMutation.mutateAsync,\n    sendCommand: sendCommandMutation.mutateAsync,\n\n    isCreating: createMutation.isPending,\n    isUpdatingTrust: updateTrustMutation.isPending,\n    isDeleting: deleteMutation.isPending,\n    isUpdating: updateMutation.isPending,\n    isSendingCommand: sendCommandMutation.isPending,\n  };\n}\n\nexport function useAgentsStatus() {\n  const agentsStatusQuery = useQuery({\n    queryKey: agentsKeys.status,\n    queryFn: fetchAgents,\n    refetchInterval: 30000, // Tự động làm mới mỗi 30s\n  });\n\n  return {\n    agents: agentsStatusQuery.data ?? [],\n    isLoading: agentsStatusQuery.isLoading,\n    isFetching: agentsStatusQuery.isFetching,\n    error: agentsStatusQuery.error,\n    refetch: agentsStatusQuery.refetch,\n  };\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/hooks/use-attendance.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'OtStatus' is defined but never used. Allowed unused vars must match /^_/u.","line":10,"column":34,"nodeType":"Identifier","messageId":"unusedVar","endLine":10,"endColumn":42,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"OtStatus"},"fix":{"range":[277,287],"text":""},"desc":"Remove unused variable \"OtStatus\"."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useQuery, useMutation, useQueryClient } from \"@tanstack/react-query\";\n\nimport {\n  fetchAttendanceSummaries,\n  approveOt,\n  enterPaperOt,\n  bulkUploadPaperOt,\n} from \"@/lib/api\";\nimport { getCurrentWorkspaceId } from \"@/lib/api/helpers\";\nimport { AttendanceDailySummary, OtStatus } from \"@/lib/api/types\";\n\ninterface SummaryParams {\n  start: string;\n  end: string;\n  employeeId?: string;\n}\n\nexport const attendanceKeys = {\n  all: [\"attendance\"] as const,\n  summaries: (params: SummaryParams) => [...attendanceKeys.all, \"summaries\", params] as const,\n};\n\n// --- OT Manager Hooks ---\n\nexport function useAttendanceSummaries(start: string, end: string, employeeId?: string) {\n  const wsId = getCurrentWorkspaceId();\n  \n  const query = useQuery({\n    queryKey: attendanceKeys.summaries({ start, end, employeeId }),\n    queryFn: () => {\n        if (!wsId) throw new Error(\"No workspace\");\n        return fetchAttendanceSummaries(wsId, start, end, employeeId);\n    },\n    enabled: !!wsId,\n  });\n\n  return {\n    summaries: (query.data || []) as AttendanceDailySummary[],\n    isLoading: query.isLoading,\n    isError: query.isError,\n    refetch: query.refetch,\n  };\n}\n\nexport function useApproveOt() {\n  const queryClient = useQueryClient();\n  const wsId = getCurrentWorkspaceId();\n\n  const mutation = useMutation({\n    mutationFn: (data: { employeeId: string, date: string; approved_minutes: number; manager_note?: string; status: \"approved\" | \"rejected\" }) => {\n        if (!wsId) throw new Error(\"No workspace\");\n        return approveOt(wsId, data.employeeId, {\n            date: data.date,\n            approved_minutes: data.approved_minutes,\n            manager_note: data.manager_note,\n            status: data.status,\n        });\n    },\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: attendanceKeys.all });\n    },\n  });\n\n  return {\n    approveOt: mutation.mutateAsync,\n    isProcessing: mutation.isPending,\n  };\n}\n\nexport function useEnterPaperOt() {\n  const queryClient = useQueryClient();\n  const wsId = getCurrentWorkspaceId();\n\n  const mutation = useMutation({\n    mutationFn: (data: {\n      employeeId: string;\n      date: string;\n      claimed_minutes: number;\n      reason: string;\n      paper_form_photo_url?: string;\n    }) => {\n      if (!wsId) throw new Error(\"No workspace\");\n      return enterPaperOt(wsId, data.employeeId, {\n        date: data.date,\n        claimed_minutes: data.claimed_minutes,\n        reason: data.reason,\n        paper_form_photo_url: data.paper_form_photo_url,\n      });\n    },\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: attendanceKeys.all });\n    },\n  });\n\n  return {\n    enterPaperOt: mutation.mutateAsync,\n    isSubmitting: mutation.isPending,\n  };\n}\n\nexport function useBulkUploadPaperOt() {\n  const queryClient = useQueryClient();\n  const wsId = getCurrentWorkspaceId();\n\n  const mutation = useMutation({\n    mutationFn: (file: File) => {\n      if (!wsId) throw new Error(\"No workspace\");\n      return bulkUploadPaperOt(wsId, file);\n    },\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: attendanceKeys.all });\n    },\n  });\n\n  return {\n    bulkUploadPaperOt: mutation.mutateAsync,\n    isUploading: mutation.isPending,\n  };\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/hooks/use-confirm.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/ho