  )}\n\n      <AttendanceImportDialog isOpen={isImportDialogOpen} onClose={() => setIsImportDialogOpen(false)} title={t(\"attendance_logs.modal.import_title\")} endpoint=\"/attendance/logs/upload\" targetType=\"log\" />\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/DashboardPage.tsx","messages":[],"suppressedMessages":[{"ruleId":"react-hooks/exhaustive-deps","severity":2,"message":"React Hook useMemo has a missing dependency: 'chartWidgetIds'. Either include it or remove the dependency array.","line":109,"column":5,"nodeType":"ArrayExpression","endLine":109,"endColumn":34,"suggestions":[{"desc":"Update the dependencies array to be: [widgetOrder, chartWidgetIds, visibleWidgets]","fix":{"range":[3997,4026],"text":"[widgetOrder, chartWidgetIds, visibleWidgets]"}}],"suppressions":[{"kind":"directive","justification":""}]}],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/DepartmentsPage.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Search' is defined but never used. Allowed unused vars must match /^_/u.","line":4,"column":16,"nodeType":"Identifier","messageId":"unusedVar","endLine":4,"endColumn":22,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Search"},"fix":{"range":[145,153],"text":""},"desc":"Remove unused variable \"Search\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Loader2' is defined but never used. Allowed unused vars must match /^_/u.","line":4,"column":108,"nodeType":"Identifier","messageId":"unusedVar","endLine":4,"endColumn":115,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Loader2"},"fix":{"range":[237,246],"text":""},"desc":"Remove unused variable \"Loader2\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Calendar' is defined but never used. Allow