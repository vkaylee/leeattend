 QueryClient;\n\n  beforeEach(() => {\n    vi.clearAllMocks();\n    queryClient = new QueryClient({\n      defaultOptions: { queries: { retry: false } },\n    });\n    \n    (api.getCurrentWorkspaceId as any).mockReturnValue(\"test-ws-id\");\n    \n    (useWorkspace as any).mockReturnValue({\n      workspace: {\n        id: \"test-ws-id\",\n        name: \"Test Workspace\",\n        timezone: \"Asia/Ho_Chi_Minh\",\n        created_at: \"2024-01-01T00:00:00Z\",\n      },\n      isLoading: false,\n    });\n    \n    (useWorkspaceMembers as any).mockReturnValue({\n      members: [\n        { workspace_id: \"ws-1\", user_id: \"user-1\", email: \"owner@test.com\", full_name: \"Owner User\", role_id: \"role-1\", extra_role_ids: [] },\n        { workspace_id: \"ws-1\", user_id: \"user-2\", email: \"member@test.com\", full_name: \"Member User\", role_id: \"role-2\", extra_role_ids: [] },\n      ],\n      isLoading: false,\n    });\n    \n    (useWorkspaceRoles as any).mockReturnValue({ roles: [{ id: \"role-1\", name: \"owner\", is_system: true }], isLoading: false });\n    \n    (api.apiFetch as any).mockResolvedValue({\n      ok: true,\n      json: async () => ({\n        total_employees: 42,\n        present_today: 40,\n        late_today: 2,\n        on_leave_today: 1,\n      }),\n    });\n  });\n\n  const renderWithProviders = (ui: React.ReactElement) => {\n    return render(\n      <QueryClientProvider client={queryClient}>\n        {ui}\n      </QueryClientProvider>\n    );\n  };\n\n  it(\"renders workspace stats correctly\", async () => {\n    renderWithProviders(<WorkspaceOverviewPage />);\n\n    // Check workspace name and timezone\n    expect(await screen.findByText(\"Test Workspace\")).toBeDefined();\n    expect(await screen.findByText(/Asia\\/Ho_Chi_Minh/)).toBeDefined();\n\n    // Check stats numbers\n    expect(await screen.findByText(\"42\")).toBeDefined(); // total_employees\n    expect(await screen.findByText(\"40\")).toBeDefined(); // present_today\n    expect(await screen.findByText(\"2\")).toBeDefined(); // late_today\n    expect(await screen.findByText(\"1\")).toBeDefined(); // on_leave_today\n\n    // Check admin members (should only render owner/admin)\n    expect(screen.getByText(\"Owner User\")).toBeDefined();\n    expect(screen.queryByText(\"Member User\")).toBeNull(); // members shouldn't appear in admin preview\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/__tests__/WorkspacePermissionsPage.test.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'within' is defined but never used. Allowed unused vars must match /^_/u.","line":4,"column":26,"nodeType":"Identifier","messageId":"unusedVar","endLine":4,"endColumn":32,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"within"},"fix":{"range":[125,133],"text":""},"desc":"Remove unused variable \"within\"."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":16,"column":36,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":16,"endColumn":39,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[715,718],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[715,718],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":64,"column":31,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":64,"endColumn":34,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[2084,2087],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[2084,2087],