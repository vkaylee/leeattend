types\";\n\nexport default function HolidaysPage() {\n    const { t } = useTranslation();\n    const [holidays, setHolidays] = useState<Holiday[]>([]);\n    const [leaveTypes, setLeaveTypes] = useState<LeaveType[]>([]);\n    const [isLoading, setIsLoading] = useState(true);\n    const [year, setYear] = useState(new Date().getFullYear());\n    const [showForm, setShowForm] = useState(false);\n    const [editingHoliday, setEditingHoliday] = useState<Holiday | null>(null);\n    const [error, setError] = useState<string | null>(null);\n\n    // Form state\n    const [formName, setFormName] = useState(\"\");\n    const [formDate, setFormDate] = useState(\"\");\n    const [formType, setFormType] = useState(\"national\");\n    const [formIsPaid, setFormIsPaid] = useState(true);\n    const [formLeaveTypeId, setFormLeaveTypeId] = useState(\"\");\n    const [formOtMultiplier, setFormOtMultiplier] = useState(\"\");\n    const [formDescription, setFormDescription] = useState(\"\");\n    const [formIsCreditOnWork, setFormIsCreditOnWork] = useState(true);\n    const [formThresholdPercent, setFormThresholdPercent] = useState(\"\");\n\n    const wsId = getCurrentWorkspaceId();\n\n    const loadHolidays = useCallback(async () => {\n        if (!wsId) return;\n        setIsLoading(true);\n        try {\n            const data = await fetchHolidays(wsId, year);\n            setHolidays(data);\n        } catch {\n            setError(t('holidays.messages.load_error'));\n        } finally {\n            setIsLoading(false);\n        }\n    }, [wsId, year, t]);\n\n    useEffect(() => {\n        loadHolidays();\n    }, [loadHolidays]);\n\n    useEffect(() => {\n        if (!wsId) return;\n        fetchLeaveTypes(wsId).then(setLeaveTypes).catch(() => { });\n    }, [wsId]);\n\n    const resetForm = () => {\n        setFormName(\"\");\n        setFormDate(\"\");\n        setFormType(\"national\");\n        setFormIsPaid(true);\n        setFormLeaveTypeId(\"\");\n        setFormOtMultiplier(\"\");\n        setFormDescription(\"\");\n        setFormIsCreditOnWork(true);\n        setFormThresholdPercent(\"\");\n        setEditingHoliday(null);\n        setShowForm(false);\n        setError(null);\n    };\n\n    const openEdit = (h: Holiday) => {\n        setEditingHoliday(h);\n        setFormName(h.name);\n        setFormDate(h.date);\n        setFormType(h.holiday_type);\n        setFormIsPaid(h.is_paid);\n        setFormLeaveTypeId(h.leave_type_id || \"\");\n        setFormOtMultiplier(h.ot_multiplier?.toString() || \"\");\n        setFormDescription(h.description || \"\");\n        setFormIsCreditOnWork(h.is_credit_on_work ?? true);\n        setFormThresholdPercent(h.work_threshold_percent?.toString() || \"\");\n        setShowForm(true);\n    };\n\n    const handleSubmit = async (e: React.FormEvent) => {\n        e.preventDefault();\n        if (!wsId) return;\n        setError(null);\n\n        const payload: any = {\n            name: formName,\n            date: formDate,\n            holiday_type: formType,\n            is_paid: formIsPaid,\n            leave_type_id: !formIsPaid && formLeaveTypeId ? formLeaveTypeId : undefined,\n            description: formDescription || undefined,\n            ot_multiplier: formOtMultiplier ? parseFloat(formOtMultiplier) : undefined,\n            is_credit_on_work: formIsCreditOnWork,\n            work_threshold_percent: formThresholdPercent ? parseInt(formThresholdPercent) : undefined,\n        };\n\n        try {\n            if (editingHoliday) {\n                await updateHoliday(wsId, editingHoliday.id, payload);\n            } else {\n                await createHoliday(wsId, payload);\n            }\n            resetForm();\n            loadHolidays();\n        } catch (err: any) {\n            setError(err.message || t('holidays.messages.save_error'));\n        }\n    };\n\n    const handleDelete = async (id: string) => {\n        if (!wsId) return;\n        if (!confirm(t('holidays.messages.confirm_delete'))) return;\n        try {\n            await deleteHoliday(wsId, id);\n            loadHolidays();\n        } catch {\n            setError(t('holidays.messages.delete_error'));\n        }\n    };\n\n    return (\n        <div className=\"space-y-8\">\n            {/* Header */}\n            <div className=\"flex items-center justify-between\">\n                <div>\n                    <h1 className=\"text-2xl font-bold text-slate-900 dark:text-white tracking-tight\">\n                        🏖️ {t('holidays.title')}\n                    </h1>\n                    <p className=\"text-sm text-slate-500 dark:text-slate-400 mt-1\">\n                        {t('holidays.subtitle')}\n                    </p>\n                </div>\n                <button\n                    onClick={() => { resetForm(); setShowForm(true); }}\n                    className=\"flex items-center gap-2 px-4 py-2 bg-primary-600 text-white rounded-xl font-bold text-sm hover:bg-primary-700 transition-colors shadow-sm\"\n                >\n                    <Plus size={16} />\n                    {t('holidays.add_btn')}\n                </button>\n            </div>\n\n            {/* Year Navigation */}\n            <div className=\"flex items-center justify-center gap-4\">\n                <button\n                    onClick={() => setYear(y => y - 1)}\n                    className=\"p-2 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors\"\n                >\n                    <ChevronLeft size={16} />\n                </button>\n                <span className=\"text-xl font-bold text-slate-900 dark:text-white tabular-nums\">\n                    {year}\n                </span>\n                <button\n                    onClick={() => setYear(y => y + 1)}\n                    className=\"p-2 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors\"\n                >\n                    <ChevronRight size={16} />\n                </button>\n            </div>\n\n            {/* Error */}\n            {error && (\n                <div className=\"p-3 bg-rose-50 dark:bg-rose-950 border border-rose-200 dark:border-rose-800 rounded-xl text-rose-600 dark:text-rose-300 text-sm font-medium\">\n                    {error}\n                </div>\n            )}\n\n            {/* Form Modal */}\n            {showForm && (\n                <div className=\"bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 shadow-lg\">\n                    <h2 className=\"text-lg font-bold text-slate-900 dark:text-white mb-4\">\n                        {editingHoliday ? t('holidays.modal_title_edit') : t('holidays.modal_title_new')}\n                    </h2>\n                    <form onSubmit={handleSubmit} className=\"space-y-4\">\n                        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                            <div>\n                                <label className=\"block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1\">\n                                    {t('holidays.fields.name')} *\n                                </label>\n                                <input\n                                    type=\"text\"\n                                    value={formName}\n                                    onChange={(e) => setFormName(e.target.value)}\n                                    required\n                                    placeholder={t('holidays.fields.name_placeholder')}\n                                    className=\"w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm\"\n                                />\n                            </div>\n                            <div>\n                                <label className=\"block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1\">\n                                    {t('holidays.fields.date')} *\n                                </label>\n                                <input\n                                    type=\"date\"\n                                    value={formDate}\n                                    onChange={(e) => setFormDate(e.target.value)}\n                                    required\n                                    className=\"w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm\"\n                                />\n                            </div>\n                            <div>\n                                <label className=\"block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1\">\n                                    {t('holidays.fields.type')}\n                                </label>\n                                <select\n                                    value={formType}\n                                    onChange={(e) => setFormType(e.target.value)}\n                                    className=\"w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm\"\n                                >\n                                    <option value=\"national\">{t('holidays.fields.types.national')}</option>\n                                    <option value=\"company\">{t('holidays.fields.types.company')}</option>\n                                    <option value=\"regional\">{t('holidays.fields.types.regional')}</option>\n                                </select>\n                            </div>\n                        </div>\n                        <div>\n                            <label className=\"block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1\">\n                                {t('holidays.fields.description')}\n                            </label>\n                            <input\n                                type=\"text\"\n                                value={formDescription}\n                                onChange={(e) => setFormDescription(e.target.value)}\n                                placeholder={t('holidays.fields.description_placeholder')}\n                                className=\"w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm\"\n                            />\n                        </div>\n                        <div className=\"flex items-center gap-2\">\n                            <input\n                                type=\"checkbox\"\n                                id=\"isPaid\"\n                                checked={formIsPaid}\n                                onChange={(e) => { setFormIsPaid(e.target.checked); if (e.target.checked) setFormLeaveTypeId(\"\"); }}\n                                className=\"rounded\"\n                            />\n                            <label htmlFor=\"isPaid\" className=\"text-sm text-slate-700 dark:text-slate-300\">\n                                {t('holidays.fields.paid_holiday')}\n                            </label>\n                        </div>\n                        {!formIsPaid && (\n                            <div className=\"space-y-3\">\n                                <div className=\"p-3 bg-blue-50 dark:bg-blue-900/30 border border-blue-200 dark:border-blue-800/50 rounded-xl flex items-start gap-3\">\n                                    <Info className=\"w-5 h-5 text-blue-500 dark:text-blue-400 mt-0.5 shrink-0\" />\n                                    <div>\n                                        <h4 className=\"text-sm font-bold text-blue-900 dark:text-blue-200 mb-1\">\n                                            {t('holidays.info.title')}\n                                        </h4>\n                                        <p className=\"text-xs text-blue-800 dark:text-blue-300 font-medium mb-2\">\n                                            {t('holidays.info.body_1')}\n                                        </p>\n                                        <ul className=\"text-xs text-blue-800 dark:text-blue-300 space-y-1 list-disc list-inside\">\n                                            <li><span className=\"font-bold\">{t('holidays.info.rule_1').split(':')[0]}:</span> {t('holidays.info.rule_1').split(':')[1]}</li>\n                                            <li><span className=\"font-bold\">{t('holidays.info.rule_2').split(':')[0]}:</span> {t('holidays.info.rule_2').split(':')[1]}</li>\n                                        </ul>\n                                    </div>\n                                </div>\n                                <div>\n                                    <label className=\"block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1\">\n                                        {t('holidays.fields.deduct_leave_type')}\n                                    </label>\n                                    <select\n                                        value={formLeaveTypeId}\n                                        onChange={(e) => setFormLeaveTypeId(e.target.value)}\n                                        className=\"w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm\"\n                                    >\n                                        <option value=\"\">{t('holidays.fields.auto_first_paid')}</option>\n                                        {leaveTypes.filter(lt => lt.is_paid).map(lt => (\n                                            <option key={lt.id} value={lt.id}>{lt.name} ({lt.code})</option>\n                                        ))}\n                                    </select>\n                                    <p className=\"text-xs text-amber-600 dark:text-amber-400 mt-1\">\n                                        ⚠️ {t('holidays.fields.deduction_warning')}\n                                    </p>\n                                </div>\n                            </div>\n                        )}\n                        {/* Work Policy Section */}\n                        <div className=\"mt-2 p-4 bg-slate-50 dark:bg-slate-800/50 rounded-xl border border-slate-200 dark:border-slate-700\">\n                            <h3 className=\"text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-3 flex items-center gap-1.5\">\n                                ⚙️ {t('holidays.fields.work_policy_title', 'Chính sách khi NV đi làm ngày lễ')}\n                            </h3>\n                            <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n                                <div className=\"flex items-start gap-2\">\n                                    <input\n                                        type=\"checkbox\"\n                                        id=\"isCreditOnWork\"\n                                        checked={formIsCreditOnWork}\n                                        onChange={(e) => setFormIsCreditOnWork(e.target.checked)}\n                                        className=\"rounded mt-0.5\"\n                                    />\n                                    <div>\n                                        <label htmlFor=\"isCreditOnWork\" className=\"text-sm text-slate-700 dark:text-slate-300 font-medium\">\n                                            {t('holidays.fields.credit_on_work', 'Credit lương ngày lễ')}\n                                        </label>\n                                        <p className=\"text-[10px] text-slate-400\">\n                                            {t('holidays.fields.credit_on_work_help', 'NV vẫn nhận lương ngày lễ + lương giờ làm')}\n                                        </p>\n                                    </div>\n                                </div>\n                                <div>\n                                    <label className=\"block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1\">\n                                        {t('holidays.fields.threshold_percent', 'Ngưỡng hoàn phép')} (%)\n                                    </label>\n                                    <input\n                                        type=\"number\"\n                                        min={0}\n                                        max={100}\n                                        value={formThresholdPercent}\n                                        onChange={(e) => setFormThresholdPercent(e.target.value)}\n                                        placeholder=\"50\"\n                                        className=\"w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm\"\n                                    />\n                                    <p className=\"text-[10px] text-slate-400 mt-0.5\">\n                                        {t('holidays.fields.threshold_help', 'NV làm ≥ ngưỡng → hoàn phép. < ngưỡng → giữ phép')}\n                                    </p>\n                                </div>\n                                <div>\n                                    <label className=\"block text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1\">\n                                        {t('holidays.fields.ot_multiplier', 'Hệ số nhân giờ làm')}\n                                    </label>\n                                    <input\n                                        type=\"number\"\n                                        step=\"0.1\"\n                                        value={formOtMultiplier}\n                                        onChange={(e) => setFormOtMultiplier(e.target.value)}\n                                        placeholder={t('holidays.fields.ot_multiplier_placeholder', '3.0')}\n                                        className=\"w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm\"\n                                    />\n                                    <p className=\"text-[10px] text-slate-400 mt-0.5\">\n                                        {t('holidays.fields.ot_multiplier_help', 'VD: 3× = 300% lương cho mỗi giờ đi làm')}\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                        <div className=\"flex gap-2 justify-end\">\n                            <button\n                                type=\"button\"\n                                onClick={resetForm}\n                                className=\"px-4 py-2 rounded-xl border border-slate-200 dark:border-slate-700 text-sm font-bold text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800\"\n                            >\n                                {t('common.cancel')}\n                            </button>\n                            <button\n                                type=\"submit\"\n                                className=\"px-4 py-2 bg-primary-600 text-white rounded-xl font-bold text-sm hover:bg-primary-700 transition-colors\"\n                            >\n                                {editingHoliday ? t('common.update') : t('common.create')}\n                            </button>\n                        </div>\n                    </form>\n                </div>\n            )}\n\n            {/* Holidays Table */}\n            <div className=\"bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 overflow-hidden shadow-sm\">\n                {isLoading ? (\n                    <div className=\"p-12 text-center text-slate-400 text-sm font-bold uppercase tracking-widest animate-pulse\">\n                        {t('common.loading')}\n                    </div>\n                ) : holidays.length === 0 ? (\n                    <div className=\"p-12 text-center\">\n                        <CalendarDays className=\"w-12 h-12 text-slate-300 dark:text-slate-600 mx-auto mb-3\" />\n                        <p className=\"text-slate-400 text-sm font-medium\">\n                            {t('holidays.no_holidays', { year })}\n                        </p>\n                    </div>\n                ) : (\n                    <table className=\"w-full text-left\">\n                        <thead>\n                            <tr className=\"border-b border-slate-100 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/50\">\n                                <th className=\"px-4 py-3 text-[10px] font-bold text-slate-500 uppercase tracking-widest\">{t('holidays.table.date')}</th>\n                                <th className=\"px-4 py-3 text-[10px] font-bold text-slate-500 uppercase tracking-widest\">{t('holidays.table.name')}</th>\n                                <th className=\"px-4 py-3 text-[10px] font-bold text-slate-500 uppercase tracking-widest\">{t('holidays.table.type')}</th>\n                                <th className=\"px-4 py-3 text-[10px] font-bold text-slate-500 uppercase tracking-widest text-center\">{t('holidays.table.paid')}</th>\n                                <th className=\"px-4 py-3 text-[10px] font-bold text-slate-500 uppercase tracking-widest text-center\">{t('holidays.table.ot')}</th>\n                                <th className=\"px-4 py-3 text-[10px] font-bold text-slate-500 uppercase tracking-widest text-center\">{t('holidays.table.credit', 'Credit')}</th>\n                                <th className=\"px-4 py-3 text-[10px] font-bold text-slate-500 uppercase tracking-widest text-center\">{t('holidays.table.threshold', 'Ngưỡng')}</th>\n                                <th className=\"px-4 py-3 text-[10px] font-bold text-slate-500 uppercase tracking-widest\">{t('holidays.table.description')}</th>\n                                <th className=\"px-4 py-3\"></th>\n                            </tr>\n                        </thead>\n                        <tbody className=\"divide-y divide-slate-50 dark:divide-slate-800\">\n                            {holidays.map((h) => (\n                                <tr key={h.id} className=\"hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors group\">\n                                    <td className=\"px-4 py-3 font-mono text-sm font-bold text-slate-700 dark:text-slate-200\">\n                                        {h.date}\n                                    </td>\n                                    <td className=\"px-4 py-3 font-bold text-slate-900 dark:text-white text-sm\">\n                                        {h.name}\n                                    </td>\n                                    <td className=\"px-4 py-3\">\n                                        <span className=\"px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wide bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700\">\n                                            {t(`holidays.fields.types.${h.holiday_type}`)}\n                                        </span>\n                                    </td>\n                                    <td className=\"px-4 py-3 text-center\">\n                                        {h.is_paid ? (\n                                            <span className=\"text-emerald-600\">✅ {t('holidays.table.paid_status')}</span>\n                                        ) : (\n                                            <span className=\"text-amber-600 text-xs font-bold\">\n                                                ⚡ {t('holidays.table.deduct_leave')}\n                                                {h.leave_type_id && leaveTypes.find(lt => lt.id === h.leave_type_id) && (\n                                                    <span className=\"block text-[10px] text-slate-400 font-normal\">\n                                                        → {leaveTypes.find(lt => lt.id === h.leave_type_id)?.name}\n                                                    </span>\n                                                )}\n                                            </span>\n                                        )}\n                                    </td>\n                                    <td className=\"px-4 py-3 text-center font-mono font-bold text-sm text-orange-600 dark:text-orange-400\">\n                                        {h.ot_multiplier ? `${h.ot_multiplier}×` : \"—\"}\n                                    </td>\n                                    <td className=\"px-4 py-3 text-center text-sm\">\n                                        {h.is_credit_on_work ? (\n                                            <span className=\"text-emerald-600\">✅</span>\n                                        ) : (\n                                            <span className=\"text-slate-400\">❌</span>\n                                        )}\n                                    </td>\n                                    <td className=\"px-4 py-3 text-center font-mono text-sm text-slate-600 dark:text-slate-400\">\n                                        {h.work_threshold_percent != null ? `${h.work_threshold_percent}%` : \"—\"}\n                                    </td>\n                                    <td className=\"px-4 py-3 text-xs text-slate-500 dark:text-slate-400 max-w-[200px] truncate\">\n                                        {h.description || \"—\"}\n                                    </td>\n                                    <td className=\"px-4 py-3\">\n                                        <div className=\"flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity\">\n                                            <button\n                                                onClick={() => openEdit(h)}\n                                                className=\"p-1.5 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-500 hover:text-primary-600 hover:bg-primary-50 transition-colors\"\n                                            >\n                                                <Pencil size={14} />\n                                            </button>\n                                            <button\n                                                onClick={() => handleDelete(h.id)}\n                                                className=\"p-1.5 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-500 hover:text-rose-600 hover:bg-rose-50 transition-colors\"\n                                            >\n                                                <Trash2 size={14} />\n                                            </button>\n                                        </div>\n                                    </td>\n                                </tr>\n                            ))}\n                        </tbody>\n                    </table>\n                )}\n            </div>\n        </div>\n    );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/settings/LeaveSettings.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":172,"column":43,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":172,"endColumn":46,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[9515,9518],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[9515,9518],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from \"react\";\n\nimport { useQuery } from \"@tanstack/react-query\";\nimport { format } from \"date-fns\";\nimport { CalendarDays, ShieldCheck, UserPlus, Info } from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { AssignPolicyModal } from \"@/components/leave/AssignPolicyModal\";\nimport { LeavePolicyManager } from \"@/components/leave/LeavePolicyManager\";\nimport { LeaveTypeManager } from \"@/components/leave/LeaveTypeManager\";\n\nimport { fetchLeavePolicyAssignments } from \"@/lib/api\";\nimport { getCurrentWorkspaceId } from \"@/lib/api/helpers\";\nimport { cn } from \"@/lib/utils\";\n\n\n\n\n\ntype TabType = \"types\" | \"policies\" | \"assignments\";\n\nexport default function LeaveSettings() {\n  const { t } = useTranslation();\n  const wsId = getCurrentWorkspaceId();\n  const [activeTab, setActiveTab] = useState<TabType>(\"types\");\n  const [isAssignModalOpen, setIsAssignModalOpen] = useState(false);\n\n  const { data: assignments = [], isLoading: assignmentsLoading } = useQuery({\n    queryKey: [\"leave-assignments\", wsId],\n    queryFn: () => fetchLeavePolicyAssignments(wsId!),\n    enabled: !!wsId && activeTab === \"assignments\"\n  });\n\n\n  if (!wsId) return null;\n\n  return (\n    <div className=\"space-y-10 animate-in fade-in slide-in-from-bottom-4 duration-500\">\n      <header className=\"flex flex-col gap-2\">\n        <div className=\"flex items-center gap-4\">\n          <div className=\"bg-primary-600 p-3 rounded-2xl shadow-xl shadow-primary-100 dark:shadow-black/30 rotate-3\">\n            <CalendarDays className=\"text-white w-6 h-6\" />\n          </div>\n          <div>\n            <h2 className=\"text-3xl font-bold tracking-tighter text-slate-800 dark:text-slate-100 uppercase leading-none\">\n              {t(\"settings.leave.title\")}\n            </h2>\n            <p className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em] mt-1 opacity-60\">\n              {t(\"settings.leave.desc\")}\n            </p>\n          </div>\n        </div>\n      </header>\n\n      <div className=\"bg-white dark:bg-slate-900 rounded-3xl border border-slate-100 dark:border-slate-800 p-8 shadow-sm\">\n        <div className=\"flex bg-slate-100 dark:bg-slate-700/50 p-1.5 rounded-[22px] w-fit border border-slate-200 dark:border-slate-700/50 shadow-inner mb-8\">\n          <button\n            onClick={() => setActiveTab(\"types\")}\n            data-testid=\"leave-tab-types\"\n            className={cn(\n              \"flex items-center gap-3 px-8 py-2.5 rounded-[18px] text-xs font-bold uppercase tracking-widest transition-all duration-300\",\n              activeTab === \"types\"\n                ? \"bg-white dark:bg-slate-900 text-primary-600 dark:text-primary-400 shadow-sm border border-slate-100 dark:border-slate-800\"\n                : \"text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:text-slate-100\"\n            )}\n          >\n            <CalendarDays className=\"w-4 h-4\" />\n            {t(\"settings.leave.tabs.types\")}\n          </button>\n          <button\n            onClick={() => setActiveTab(\"policies\")}\n            data-testid=\"leave-tab-policies\"\n            className={cn(\n              \"flex items-center gap-3 px-8 py-2.5 rounded-[18px] text-xs font-bold uppercase tracking-widest transition-all duration-300\",\n              activeTab === \"policies\"\n                ? \"bg-white dark:bg-slate-900 text-primary-600 dark:text-primary-400 shadow-sm border border-slate-100 dark:border-slate-800\"\n                : \"text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:text-slate-100\"\n            )}\n          >\n            <ShieldCheck className=\"w-4 h-4\" />\n            {t(\"settings.leave.tabs.policies\")}\n          </button>\n          <button\n            onClick={() => setActiveTab(\"assignments\")}\n            data-testid=\"leave-tab-assignments\"\n            className={cn(\n              \"flex items-center gap-3 px-8 py-2.5 rounded-[18px] text-xs font-bold uppercase tracking-widest transition-all duration-300\",\n              activeTab === \"assignments\"\n                ? \"bg-white dark:bg-slate-900 text-primary-600 dark:text-primary-400 shadow-sm border border-slate-100 dark:border-slate-800\"\n                : \"text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:text-slate-100\"\n            )}\n          >\n            <UserPlus className=\"w-4 h-4\" />\n            {t(\"settings.leave.tabs.assignments\")}\n          </button>\n        </div>\n\n        <div className=\"animate-in fade-in slide-in-from-bottom-2 duration-500\">\n          {activeTab === \"types\" && (\n            <div>\n              <div className=\"mb-8 border-b border-slate-50 dark:border-slate-800 pb-6\">\n                <h3 className=\"text-xl font-bold text-slate-800 dark:text-slate-100 tracking-tight uppercase\">\n                  {t(\"settings.leave.tabs.types\")}\n                </h3>\n                <p className=\"text-xs font-bold text-slate-500 dark:text-slate-400 mt-1 uppercase tracking-tight\">\n                  {t(\"settings.leave.tabs.types_desc\")}\n                </p>\n              </div>\n              <LeaveTypeManager wsId={wsId} />\n            </div>\n          )}\n\n          {activeTab === \"policies\" && (\n            <div>\n              <div className=\"mb-8 border-b border-slate-50 dark:border-slate-800 pb-6\">\n                <h3 className=\"text-xl font-bold text-slate-800 dark:text-slate-100 tracking-tight uppercase\">\n                  {t(\"settings.leave.tabs.policies\")}\n                </h3>\n                <p className=\"text-xs font-bold text-slate-500 dark:text-slate-400 mt-1 uppercase tracking-tight\">\n                  {t(\"settings.leave.tabs.policies_desc\")}\n                </p>\n              </div>\n              <LeavePolicyManager wsId={wsId} />\n            </div>\n          )}\n\n          {activeTab === \"assignments\" && (\n            <div>\n              <div className=\"mb-8 border-b border-slate-50 dark:border-slate-800 pb-6 flex justify-between items-end\">\n                <div>\n                  <h3 className=\"text-xl font-bold text-slate-800 dark:text-slate-100 tracking-tight uppercase\">\n                    {t(\"settings.leave.tabs.assignments\")}\n                  </h3>\n                  <p className=\"text-xs font-bold text-slate-500 dark:text-slate-400 mt-1 uppercase tracking-tight\">\n                    {t(\"settings.leave.tabs.assignments_desc\")}\n                  </p>\n                </div>\n                <button\n                  onClick={() => setIsAssignModalOpen(true)}\n                  data-testid=\"assign-policy-btn\" className=\"flex items-center gap-2 rounded-xl bg-primary-600 px-6 py-2.5 text-[10px] font-bold text-white uppercase tracking-widest hover:bg-primary-700 shadow-lg shadow-primary-100\"\n                >\n                  <UserPlus className=\"w-4 h-4\" />\n                  {t(\"settings.leave.actions.assign\")}\n                </button>\n              </div>\n              <div className=\"bg-amber-50 dark:bg-amber-950 border border-amber-100 dark:border-amber-800 p-8 rounded-[2.5rem] flex items-start gap-6\">\n                <Info className=\"text-amber-600 dark:text-amber-300 w-6 h-6 mt-1 shrink-0\" />\n                <div className=\"space-y-2\">\n                  <p className=\"font-bold text-amber-900 uppercase tracking-widest text-xs\">{t(\"common.important_note\")}</p>\n                  <p className=\"text-sm text-amber-800 leading-relaxed\">\n                    {t(\"settings.leave.messages.assignment_note\")}\n                  </p>\n                </div>\n              </div>\n              <div className=\"bg-white dark:bg-slate-900 rounded-3xl border border-slate-100 dark:border-slate-800 overflow-hidden shadow-sm mt-8 animate-in slide-in-from-bottom-4 duration-700\">\n                <table className=\"w-full text-left border-collapse\">\n                  <thead className=\"bg-slate-50 dark:bg-slate-800 border-b border-slate-100 dark:border-slate-800\">\n                    <tr>\n                      <th className=\"px-6 py-4 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">{t(\"settings.leave.table.policy\")}</th>\n                      <th className=\"px-6 py-4 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">{t(\"settings.leave.table.type\")}</th>\n                      <th className=\"px-6 py-4 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">{t(\"settings.leave.table.assignee\")}</th>\n                      <th className=\"px-6 py-4 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">{t(\"settings.leave.table.effective_date\")}</th>\n                      <th className=\"px-6 py-4 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest text-right\">{t(\"settings.leave.table.created_at\")}</th>\n                    </tr>\n                  </thead>\n                  <tbody className=\"divide-y divide-slate-50 dark:divide-slate-800\">\n                    {assignmentsLoading ? (\n                      <tr><td colSpan={5} className=\"p-8 text-center text-slate-400 dark:text-slate-500 italic font-bold text-xs uppercase tracking-widest\">{t(\"settings.leave.messages.loading\")}</td></tr>\n                    ) : assignments.length === 0 ? (\n                      <tr><td colSpan={5} className=\"p-12 text-center text-slate-400 dark:text-slate-500 italic font-bold text-xs uppercase tracking-widest opacity-50\">{t(\"settings.leave.messages.no_assignments\")}</td></tr>\n                    ) : (\n                      assignments.map((a: any) => (\n                        <tr key={a.id} className=\"hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors group\">\n                          <td className=\"px-6 py-5 font-bold text-slate-700 dark:text-slate-200 text-xs tracking-tight\">{a.policy_name}</td>\n                          <td className=\"px-6 py-5 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">{a.leave_type_name}</td>\n                          <td className=\"px-6 py-5\">\n                            <span className={cn(\"px-2.5 py-1 rounded-lg text-[9px] font-bold uppercase tracking-widest border shadow-sm\", \n                              a.assignee_type === \"workspace\" ? \"bg-teal-50 dark:bg-teal-950 text-teal-600 dark:text-teal-300 border-teal-100\" :\n                              a.assignee_type === \"department\" ? \"bg-blue-50 dark:bg-blue-950 text-blue-600 dark:text-blue-300 border-blue-100 dark:border-blue-800\" :\n                              \"bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-300 border-emerald-100 dark:border-emerald-800\"\n                            )}>\n                              {a.assignee_type}\n                            </span>\n                          </td>\n                          <td className=\"px-6 py-5 text-xs font-mono text-slate-600 dark:text-slate-300 font-bold\">\n                             {format(new Date(a.effective_from), \"MMM dd, yyyy\")} \n                             <span className=\"text-slate-300 dark:text-slate-600 mx-2\">→</span>\n                             {a.effective_to ? format(new Date(a.effective_to), \"MMM dd, yyyy\") : <span className=\"text-slate-400 dark:text-slate-500 italic\">{t(\"common.forever\")}</span>}\n                          </td>\n                          <td className=\"px-6 py-5 text-[10px] font-mono text-slate-400 dark:text-slate-500 text-right uppercase\">\n                            {format(new Date(a.created_at), \"MMM dd HH:mm\")}\n                          </td>\n                        </tr>\n                      ))\n                    )}\n                  </tbody>\n                </table>\n              </div>\n            </div>\n          )}\n        </div>\n      </div>\n\n      <AssignPolicyModal \n        isOpen={isAssignModalOpen}\n        onClose={() => setIsAssignModalOpen(false)}\n        wsId={wsId}\n      />\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/settings/OrganizationSettings.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'isLoading' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":18,"column":18,"nodeType":"Identifier","messageId":"unusedVar","endLine":18,"endColumn":27}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState } from \"react\";\n\nimport { Building2, Layers } from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport EmploymentPhaseManager from \"@/components/people/EmploymentPhaseManager\";\n\nimport { useWorkspaceRoles } from \"@/hooks/use-workspace\";\nimport { cn } from \"@/lib/utils\";\nimport DepartmentsPage from \"@/pages/DepartmentsPage\";\n\n\ntype TabType = \"departments\" | \"employment_phases\";\n\nexport default function OrganizationSettings() {\n\n  const { t } = useTranslation();\n  const { roles, isLoading } = useWorkspaceRoles();\n  const [activeTab, setActiveTab] = useState<TabType>(\"departments\");\n  return (\n\n    <div className=\"space-y-8 animate-in fade-in duration-500\">\n\n      <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-6 px-2\">\n\n        <div className=\"flex items-center gap-4\">\n\n          <div className=\"w-12 h-12 rounded-[1.25rem] bg-primary-50 dark:bg-primary-950 flex items-center justify-center text-primary-600 dark:text-primary-400 shadow-sm border border-primary-100 dark:border-primary-800/50\"><Building2 size={24} /></div>\n\n          <div>\n\n            <h1 data-testid=\"organization-settings-title\" className=\"text-3xl font-bold tracking-tight text-slate-700 dark:text-slate-200 leading-tight\">{t(\"common.settings.categories.organization\", { defaultValue: \"Organization\" })}</h1>\n\n            <p className=\"text-slate-500 dark:text-slate-400 mt-1 font-medium\">{t(\"common.settings.categories.organization_desc\", { defaultValue: \"Manage departments and employment phases\" })}</p>\n\n          </div>\n\n        </div>\n\n      </div>\n\n\n\n      <div className=\"flex bg-slate-100 dark:bg-slate-700/50 p-1.5 rounded-[22px] w-fit border border-slate-200 dark:border-slate-700/50 shadow-inner\">\n\n        <button data-testid=\"tab-departments\" onClick={() => setActiveTab(\"departments\")} className={cn(\"flex items-center gap-2 px-8 py-2.5 rounded-[18px] text-xs font-bold uppercase tracking-widest transition-all\", activeTab === 'departments' ? \"bg-white dark:bg-slate-900 text-primary-600 dark:text-primary-400 shadow-sm border border-slate-100 dark:border-slate-800\" : \"text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 dark:text-slate-700\")}><Building2 size={14} /> {t(\"common.settings.tabs.departments\")}</button>\n        <button data-testid=\"tab-phases\" onClick={() => setActiveTab(\"employment_phases\")} className={cn(\"flex items-center gap-2 px-8 py-2.5 rounded-[18px] text-xs font-bold uppercase tracking-widest transition-all\", activeTab === 'employment_phases' ? \"bg-white dark:bg-slate-900 text-primary-600 dark:text-primary-400 shadow-sm border border-slate-100 dark:border-slate-800\" : \"text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 dark:text-slate-700\")}><Layers size={14} /> {t(\"common.settings.tabs.employment_phases\")}</button>\n      </div>\n\n\n\n      <div className=\"animate-in slide-in-from-bottom-4 duration-500\">\n\n\n\n\n\n        {activeTab === \"departments\" && (\n\n          <div className=\"bg-white dark:bg-slate-900 rounded-[2.5rem] border border-slate-100 dark:border-slate-800 overflow-hidden shadow-sm p-4\"><DepartmentsPage /></div>\n\n        )}\n\n        {activeTab === \"employment_phases\" && (\n          <div className=\"bg-white dark:bg-slate-900 rounded-[2.5rem] border border-slate-100 dark:border-slate-800 overflow-hidden shadow-sm p-4\">\n            <EmploymentPhaseManager wsId={roles[0]?.workspace_id || \"\"} />\n          </div>\n        )}\n\n      </div>\n\n\n\n\n\n    </div>\n\n  );\n\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/settings/PayrollSettings.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/settings/SettingsLayout.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/settings/TimeSettings.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Save' is defined but never used. Allowed unused vars must match /^_/u.","line":4,"column":29,"nodeType":"Identifier","messageId":"unusedVar","endLine":4,"endColumn":33,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Save"},"fix":{"range":[151,157],"text":""},"desc":"Remove unused variable \"Save\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'ChevronDown' is defined but never used. Allowed unused vars must match /^_/u.","line":4,"column":117,"nodeType":"Identifier","messageId":"unusedVar","endLine":4,"endColumn":128,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"ChevronDown"},"fix":{"range":[239,252],"text":""},"desc":"Remove unused variable \"ChevronDown\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'ChevronUp' is defined but never used. Allowed unused vars must match /^_/u.","line":4,"column":130,"nodeType":"Identifier","messageId":"unusedVar","endLine":4,"endColumn":139,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"ChevronUp"},"fix":{"range":[252,263],"text":""},"desc":"Remove unused variable \"ChevronUp\"."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":97,"column":30,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":97,"endColumn":33,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[3864,3867],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[3864,3867],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":128,"column":18,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":128,"endColumn":21,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[5021,5024],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[5021,5024],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'updateWsMutation' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":137,"column":9,"nodeType":"Identifier","messageId":"unusedVar","endLine":137,"endColumn":25},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":158,"column":55,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":158,"endColumn":58,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[6017,6020],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[6017,6020],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":364,"column":67,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":364,"endColumn":70,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[23030,23033],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[23030,23033],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":8,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState, useEffect } from \"react\";\n\nimport { useQuery, useMutation, useQueryClient } from \"@tanstack/react-query\";\nimport { Clock, Calculator, Save, ShieldAlert, Settings2, LayoutGrid, Zap, RefreshCw, AlertTriangle, Plus, History, ChevronDown, ChevronUp, CheckCircle2 } from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { PolicyAssignmentsSection } from \"@/components/features/attendance/PolicyAssignmentsSection\";\nimport Button from \"@/components/ui/Button\";\nimport { Combobox } from \"@/components/ui/Combobox\";\nimport { LABEL_BASE } from \"@/components/ui/FormField\";\nimport Modal from \"@/components/ui/Modal\";\nimport { useToast } from \"@/components/ui/Toast\";\n\nimport { fetchWorkspace, updateWorkspace, getCurrentWorkspaceId, Workspace, reprocessAllAttendance, fetchGenericJobStatus, fetchDefaultAttendanceRules, updateDefaultAttendanceRules, fetchAttendancePolicyVersions, AttendanceRules, AttendancePolicyVersion, UpdateAttendanceRulesRequest } from \"@/lib/api\";\nimport { cn } from \"@/lib/utils\";\nimport AssignmentRulesPage from \"@/pages/AssignmentRulesPage\";\nimport WorkingPatternsPage from \"@/pages/WorkingPatternsPage\";\n\n\nexport default function TimeSettings() {\n  const wsId = getCurrentWorkspaceId();\n\n  const { data: workspace, isLoading: isLoadingWs } = useQuery({\n    queryKey: [\"workspace\", wsId],\n    queryFn: () => fetchWorkspace(wsId!),\n    enabled: !!wsId,\n  });\n\n  const { data: rules, isLoading: isLoadingRules } = useQuery({\n    queryKey: [\"attendance-rules\", wsId],\n    queryFn: () => fetchDefaultAttendanceRules(wsId!),\n    enabled: !!wsId,\n  });\n\n  const { data: versions = [], isLoading: isLoadingVersions } = useQuery({\n    queryKey: [\"attendance-policy-versions\", wsId],\n    queryFn: () => fetchAttendancePolicyVersions(wsId!),\n    enabled: !!wsId,\n  });\n\n  if (isLoadingWs || isLoadingRules || isLoadingVersions) {\n    return (\n      <div className=\"flex items-center justify-center min-h-[400px]\">\n        <div className=\"animate-spin rounded-full h-8 w-8 border-b-2 border-primary-600\"></div>\n      </div>\n    );\n  }\n\n  if (!workspace || !rules) return null;\n\n  return <TimeSettingsContent key={`${workspace.id}-${versions.length}`} workspace={workspace} rules={rules} versions={versions} />;\n}\n\ntype TabType = \"general\" | \"patterns\" | \"rules\";\n\nfunction TimeSettingsContent({ workspace, rules, versions }: { workspace: Workspace; rules: AttendanceRules; versions: AttendancePolicyVersion[] }) {\n\n  const { t } = useTranslation();\n\n  const wsId = workspace.id;\n\n  const queryClient = useQueryClient();\n\n  const toast = useToast();\n\n\n\n  const [activeTab, setActiveTab] = useState<TabType>(\"general\");\n\n  const handleTabChange = (tab: TabType) => {\n    setActiveTab(tab);\n  };\n\n  const [workUnit, setWorkUnit] = useState(rules.work_unit_minutes ?? 15);\n  const [roundingPolicy, setRoundingPolicy] = useState(rules.rounding_policy || \"none\");\n  const [earlyArrivalStrategy, setEarlyArrivalStrategy] = useState(rules.early_arrival_strategy || \"block\");\n  const [showCreateModal, setShowCreateModal] = useState(false);\n  const [newValidFrom, setNewValidFrom] = useState(() => new Date().toISOString().split(\"T\")[0]);\n\n  // --- Bulk Reprocess State ---\n  const [reprocessStart, setReprocessStart] = useState(() => {\n    const d = new Date();\n    d.setDate(d.getDate() - 30);\n    return d.toISOString().split(\"T\")[0];\n  });\n  const [reprocessEnd, setReprocessEnd] = useState(() => {\n    return new Date().toISOString().split(\"T\")[0];\n  });\n  const [showReprocessConfirm, setShowReprocessConfirm] = useState(false);\n\n  const [pollingJobId, setPollingJobId] = useState<string | null>(null);\n\n  const jobStatusQuery = useQuery({\n    queryKey: [\"generic-job-status\", wsId, pollingJobId],\n    queryFn: () => fetchGenericJobStatus(wsId, pollingJobId!),\n    enabled: !!pollingJobId,\n    refetchInterval: (query: any) => {\n      const data = query.state?.data;\n      return data && (data.status === \"completed\" || data.status === \"failed\") ? false : 3000;\n    },\n  });\n\n  useEffect(() => {\n    if (jobStatusQuery.data) {\n      if (jobStatusQuery.data.status === \"completed\") {\n        setTimeout(() => {\n          toast.success(t(\"common.success\") + \" - Reprocessing finished\");\n          queryClient.invalidateQueries({ queryKey: [\"attendance-report\"] });\n          queryClient.invalidateQueries({ queryKey: [\"attendance-logs\"] });\n          setShowReprocessConfirm(false);\n          setPollingJobId(null);\n        }, 0);\n      } else if (jobStatusQuery.data.status === \"failed\") {\n        setTimeout(() => {\n          toast.error(\"Process failed: \" + (jobStatusQuery.data.error || \"Unknown error\"));\n          setShowReprocessConfirm(false);\n          setPollingJobId(null);\n        }, 0);\n      }\n    }\n  }, [jobStatusQuery.data, queryClient, t, toast]);\n\n  const reprocessMutation = useMutation({\n    mutationFn: () => reprocessAllAttendance(wsId, reprocessStart, reprocessEnd),\n    onSuccess: (data) => {\n      setPollingJobId(data.job_id);\n    },\n    onError: (e: any) => {\n      toast.error(e.message || t(\"common.error\"));\n    }\n  });\n\n  const handleReprocessSubmit = () => {\n    reprocessMutation.mutate();\n  };\n\n  const updateWsMutation = useMutation({\n    mutationFn: (data: Partial<Workspace>) => updateWorkspace(wsId, data),\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: [\"workspace\", wsId] });\n    },\n  });\n\n  const updateRulesMutation = useMutation({\n    mutationFn: (data: UpdateAttendanceRulesRequest) => updateDefaultAttendanceRules(wsId, data),\n    onSuccess: () => {\n      toast.success(t(\"common.success\"));\n      queryClient.invalidateQueries({ queryKey: [\"attendance-rules\", wsId] });\n      queryClient.invalidateQueries({ queryKey: [\"attendance-policy-versions\", wsId] });\n      setShowCreateModal(false);\n    },\n  });\n\n  function handleSaveNewVersion() {\n    updateRulesMutation.mutate({\n      work_unit_minutes: workUnit,\n      rounding_policy: roundingPolicy,\n      early_arrival_strategy: earlyArrivalStrategy as any,\n      valid_from: newValidFrom,\n    });\n  }\n\n  const formatDate = (iso: string) => {\n    try { return new Date(iso).toLocaleDateString(undefined, { year: \"numeric\", month: \"short\", day: \"numeric\" }); } catch { return iso; }\n  };\n\n  const workUnitLabel = (v: number) => {\n    if (v === 1) return t(\"common.workspace_settings.work_unit_options.1min\");\n    if (v === 15) return t(\"common.workspace_settings.work_unit_options.15min\");\n    if (v === 30) return t(\"common.workspace_settings.work_unit_options.30min\");\n    if (v === 60) return t(\"common.workspace_settings.work_unit_options.60min\");\n    return `${v} min`;\n  };\n  const roundingLabel = (v: string) => {\n    const map: Record<string, string> = { \n      none: t(\"common.workspace_settings.rounding_options.none\"), \n      floor: t(\"common.workspace_settings.rounding_options.floor\"), \n      ceil: t(\"common.workspace_settings.rounding_options.ceil\"), \n      round: t(\"common.workspace_settings.rounding_options.round\") \n    };\n    return map[v] || v;\n  };\n\n\n\n\n\n  return (\n\n    <div className=\"space-y-8 animate-in fade-in duration-500\">\n\n      <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-6 px-2\">\n\n        <div className=\"flex items-center gap-4\">\n\n          <div className=\"w-12 h-12 rounded-[1.25rem] bg-primary-50 dark:bg-primary-950 flex items-center justify-center text-primary-600 dark:text-primary-400 shadow-sm border border-primary-100 dark:border-primary-800/50\"><Clock size={24} /></div>\n\n          <div>\n\n            <h1 className=\"text-3xl font-bold tracking-tight text-slate-700 dark:text-slate-200 leading-tight\">{t(\"common.settings.categories.time\")}</h1>\n\n            <p className=\"text-slate-500 dark:text-slate-400 mt-1 font-medium\">{t(\"common.settings.categories.time_desc\")}</p>\n\n          </div>\n\n        </div>\n\n        {activeTab === \"general\" && (\n          <Button onClick={() => { setShowCreateModal(true); setNewValidFrom(new Date().toISOString().split(\"T\")[0]); }} icon={<Plus size={18} />}>{t(\"common.workspace_settings.new_version\") || \"NEW VERSION\"}</Butt