e":"Unexpected any. Specify a different type.","line":341,"column":45,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":341,"endColumn":48,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[12811,12814],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[12811,12814],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":341,"column":81,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":341,"endColumn":84,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[12847,12850],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[12847,12850],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"jsx-a11y/no-autofocus","severity":2,"message":"The autoFocus prop should not be used, as it can reduce usability and accessibility for users.","line":376,"column":15,"nodeType":"JSXAttribute","endLine":376,"endColumn":24}],"suppressedMessages":[],"errorCount":10,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from \"react\";\n\nimport { useQuery, useMutation, useQueryClient } from \"@tanstack/react-query\";\nimport { Link } from \"@tanstack/react-router\";\nimport { format, addDays } from \"date-fns\";\nimport {\n  CalendarRange,\n  Plus,\n  User,\n  LayoutGrid,\n  List,\n  Zap\n} from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { EmployeeSearch } from \"@/components/common/EmployeeSearch\";\nimport { useToast } from \"@/components/ui/Toast\";\n\nimport {\n  fetchEmployees,\n  fetchShifts,\n  assignShift,\n  createShift,\n  updateShift,\n  fetchWorkspace,\n  fetchWorkspaceSchedules,\n  fetchAssignmentHistory,\n  upsertRoster,\n  bulkUpsertRoster,\n  deleteRoster,\n  getCurrentWorkspaceId,\n  fetchWorkingPatterns,\n  assignPattern\n} from \"@/lib/api\";\nimport {\n  AssignPatternRequest,\n  Shift,\n  ShiftRoster,\n  EmployeeSchedule,\n  Employee\n} from \"@/lib/api/types\";\nimport { ROUTES } from \"@/lib/routes\";\n\nimport { AssignmentHistory } from \"../components/shifts/AssignmentHistory\";\nimport { CreateShiftModal } from \"../components/shifts/CreateShiftModal\";\nimport { EditShiftModal } from \"../components/shifts/EditShiftModal\";\nimport { PatternAssignmentForm } from \"../components/shifts/PatternAssignmentForm\";\nimport { PriorityLegend } from \"../components/shifts/PriorityLegend\";\nimport { ShiftList } from \"../components/shifts/ShiftList\";\nimport { ShiftPickerModal } from \"../components/shifts/ShiftPickerModal\";\nimport { WeeklyRosterGrid } from \"../components/shifts/WeeklyRosterGrid\";\n\n\n\ntype TabType = \"weekly-roster\" | \"assignments\" | \"directory\";\n\nexport default function ShiftsPage() {\n  const { t } = useTranslation();\n  const wsId = getCurrentWorkspaceId() || \"\";\n  const queryClient = useQueryClient();\n  const toast = useToast();\n  const [activeTab, setActiveTab] = useState<TabType>(\"weekly-roster\");\n\n  // Selection states\n  const [selectedEmployee, setSelectedEmployee] = useState<Employee | null>(null);\n  const [selectedDays, setSelectedDays] = useState<string[]>([]);\n\n  // Shift Picker Modal State\n  const [isShiftPickerOpen, setIsShiftPickerOpen] = useState(false);\n  const [targetDates, setTargetDates] = useState<string[]>([]);\n\n  // Weekly Roster Navigation\n  const [currentDate, setCurrentDate] = useState(new Date());\n\n  // Fixed Assignment Form State\n  const [selectedPatternId, setSelectedPatternId] = useState(\"\");\n  const [startDate, setStartDate] = useState(format(new Date(), 'yyyy-MM-01'));\n  const [endDate, setEndDate] = useState<string>(\"\");\n  const [isForever, setIsForever] = useState(true);\n\n  // Create Shift Modal State\n  const [isCreateModalOpen, setIsCreateModalOpen] = useState(false);\n  const [newShiftName, setNewShiftName] = useState(\"\");\n  const [newShiftSymbol, setNewShiftSymbol] = useState(\"\");\n  const [newShiftStart, setNewShiftStart] = useState(\"08:00\");\n  const [newShiftEnd, setNewShiftEnd] = useState(\"17:00\");\n  const [newShiftBreak, setNewShiftBreak] = useState(60);\n  const [newShiftGrace, setNewShiftGrace] = useState(15);\n  const [newBreakStart, setNewBreakStart] = useState(\"\");\n  const [newBreakEnd, setNewBreakEnd] = useState(\"\");\n  const [isFixedBreak, setIsFixedBreak] = useState(false);\n  const [isAutoDeduct, setIsAutoDeduct] = useState(true);\n\n  // Edit Shift State\n  const [editingShift, setEditingShift] = useState<Shift | null>(null);\n  const [isCorrection, setIsCorrection] = useState(false);\n  const [correctionEffectiveDate, setCorrectionEffectiveDate] = useState(format(new Date(), 'yyyy-MM-dd'));\n\n  // Queries\n  const { data: employeesData } = useQuery({\n    queryKey: [\"employees\", wsId],\n    queryFn: () => fetchEmployees(wsId, 1, 3000),\n    enabled: !!wsId,\n  });\n  const employees = employeesData?.data || [];\n\n  const { data: shifts } = useQuery({\n    queryKey: [\"shifts\", wsId],\n    queryFn: () => fetchShifts(wsId),\n    enabled: !!wsId,\n  });\n\n  const { data: patterns } = useQuery({\n    queryKey: [\"working-patterns\", wsId],\n    queryFn: () => fetchWorkingPatterns(wsId),\n    enabled: !!wsId,\n  });\n\n  // Weekly Dates Logic\n  const startOfWeek = new Date(currentDate);\n  startOfWeek.setDate(currentDate.getDate() - currentDate.getDay() + 1); // Monday\n  const weekDays = Array.from({ length: 7 }, (_, i) => {\n    const d = new Date(startOfWeek);\n    d.setDate(startOfWeek.getDate() + i);\n    return d;\n  });\n\n  // Fetch Effective Schedules (Bulk)\n  const { data: allSchedules } = useQuery({\n    queryKey: [\"schedules\", wsId, format(startOfWeek, 'yyyy-MM-dd')],\n    queryFn: () => fetchWorkspaceSchedules(\n      wsId,\n      format(weekDays[0], 'yyyy-MM-dd'),\n      format(weekDays[6], 'yyyy-MM-dd')\n    ),\n    enabled: !!wsId,\n  });\n\n  const { data: history } = useQuery({\n    queryKey: [\"assignment_history\", wsId],\n    queryFn: () => fetchAssignmentHistory(wsId),\n    enabled: !!wsId,\n  });\n\n  // Find schedule for selected employee\n  const employeeSchedule = allSchedules?.find(s => s.employee_id === selectedEmployee?.id);\n\n  // Mutations\n  const assignPatternMutation = useMutation({\n    mutationFn: (data: AssignPatternRequest) => assignPattern(wsId, selectedEmployee!.id, data),\n    onSuccess: () => {\n      toast.success(t(\"shifts.messages.assign_success\"));\n      setSelectedPatternId(\"\");\n      setEndDate(\"\");\n      setIsForever(true);\n      queryClient.invalidateQueries({ queryKey: [\"schedules\"] });\n      queryClient.invalidateQueries({ queryKey: [\"assignment_history\"] });\n    },\n    onError: (error: Error) => toast.error(error.message, t(\"shifts.messages.assign_error\"))\n  });\n\n  const rosterMutation = useMutation({\n    mutationFn: (data: { date: string; shift_id: string | null; notes?: string }) => upsertRoster(wsId, selectedEmployee!.id, data),\n    onSuccess: () => {\n      toast.success(t(\"shifts.messages.update_roster_success\"));\n      queryClient.invalidateQueries({ queryKey: [\"schedules\"] });\n      queryClient.invalidateQueries({ queryKey: [\"assignment_history\"] });\n    },\n    onError: (error: Error) => toast.error(error.message, t(\"shifts.messages.update_roster_error\"))\n  });\n\n  const bulkRosterMutation = useMutation({\n    mutationFn: (items: Array<{ date: string; shift_id: string | null }>) => bulkUpsertRoster(wsId, selectedEmployee!.id, items),\n 