uthorizedAgents).mockReturnValue({\n      agents: [],\n      isLoading: false,\n      isFetching: false,\n      error: null,\n      refetch: vi.fn(),\n      updateAgent: vi.fn() as any,\n      isUpdating: false,\n      deleteAgent: vi.fn() as any,\n      isDeleting: false,\n      includeInactive: false,\n      setIncludeInactive: vi.fn(),\n      createAgent: vi.fn() as any,\n      isCreating: false,\n      updateTrust: vi.fn() as any,\n      isUpdatingTrust: false,\n      sendCommand: vi.fn() as any,\n      isSendingCommand: false,\n    });\n\n    renderWithClient(\n      <AgentEditModal\n        agent={mockAgent}\n        isOpen={true}\n        onClose={() => {}}\n        onSave={() => {}}\n      />,\n    );\n\n    expect(screen.getByText(\"Chỉnh sửa Agent\")).toBeInTheDocument();\n    expect(await screen.findByDisplayValue(\"Test Agent\")).toBeInTheDocument();\n    expect(screen.getByDisplayValue(\"secret123\")).toBeInTheDocument();\n    expect(screen.getByDisplayValue(\"3\")).toBeInTheDocument();\n    expect(screen.getByDisplayValue(\"300\")).toBeInTheDocument();\n    expect(screen.getByDisplayValue(\"365\")).toBeInTheDocument();\n    expect(screen.getByText(\"TEST_001\")).toBeInTheDocument();\n  });\n\n  it(\"calls updateAgent and onSave when form is submitted\", async () => {\n    const onSave = vi.fn();\n    const onClose = vi.fn();\n    const updateAgentMock = vi\n      .fn()\n      .mockResolvedValue({ ...mockAgent, name: \"New Name\" });\n\n    vi.mocked(agentsHook.useAuthorizedAgents).mockReturnValue({\n      agents: [],\n      isLoading: false,\n      isFetching: false,\n      error: null,\n      refetch: vi.fn(),\n      updateAgent: updateAgentMock as any,\n      isUpdating: false,\n      deleteAgent: vi.fn() as any,\n      isDeleting: false,\n      includeInactive: false,\n      setIncludeInactive: vi.fn(),\n      createAgent: vi.fn() as any,\n      isCreating: false,\n      updateTrust: vi.fn() as any,\n      isUpdatingTrust: false,\n      sendCommand: vi.fn() as any,\n      isSendingCommand: false,\n    });\n\n    renderWithClient(\n      <AgentEditModal\n        agent={mockAgent}\n        isOpen={true}\n        onClose={onClose}\n        onSave={onSave}\n      />,\n    );\n\n    const nameInput = await screen.findByDisplayValue(\"Test Agent\");\n    fireEvent.change(nameInput, { target: { value: \"New Name\" } });\n\n    const strategyInput = screen.getByDisplayValue(\"3\");\n    fireEvent.change(strategyInput, { target: { value: \"10\" } });\n\n    const saveButton = screen.getByText(/LƯU THAY ĐỔI/i);\n    fireEvent.click(saveButton);\n\n    await waitFor(() => {\n      expect(updateAgentMock).toHaveBeenCalledWith(\n        expect.objectContaining({\n          id: \"TEST_001\",\n          agent: expect.objectContaining({\n            name: \"New Name\",\n            max_concurrent_workers: 10,\n            success_cooldown_secs: 300,\n            retention_days: 365,\n          }),\n        }),\n      );\n      expect(onSave).toHaveBeenCalled();\n      expect(onClose).toHaveBeenCalled();\n    });\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/agents/AgentEditModal.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/attendance/AttendanceImportDialog.tsx","messages":[{"ruleId":"jsx-a11y/click-events-have-key-events","severity":2,"message":"Visible, non-interactive elements with click handlers must have at least one keyboard listener.","line":129,"column":11,"nodeType":"JSXOpeningElement","endLine":129,"endColumn":477},{"ruleId":"jsx-a11y/no-static-element-interactions","severity":2,"message":"Avoid non-native interactive elements. If using native HTML is not possible, add an appropriate role and support for tabbing, mouse, keyboard, and touch inputs to an interactive content element.","line":129,"column":11,"nodeType":"JSXOpeningElement","endLine":129,"endColumn":477}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState, useEffect } from \"react\";\n\nimport { useQuery, useQueryClient } from \"@tanstack/react-query\";\nimport { Upload, FileText, Loader2, CheckCircle2, AlertCircle } from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport Modal from \"@/components/ui/Modal\";\n\nimport { uploadAttendance, fetchLatestImportJob, fetchImportJobStatus, getCurrentWorkspaceId } from \"@/lib/api\";\nimport { cn } from \"@/lib/utils\";\n\ninterface AttendanceImportDialogProps {\n  isOpen: boolean;\n  onClose: () => void;\n  endpoint: string; // e.g., \"/attendance/upload\" or \"/attendance/logs/upload\"\n  title: string;\n  targetType: string; // \"adjustment\", \"log\", or \"employee\"\n  customRequirements?: string[];\n}\n\nexport default function AttendanceImportDialog({ \n  isOpen, \n  onClose, \n  endpoint, \n  title, \n  targetType,\n  customRequirements\n}: AttendanceImportDialogProps) {\n  const { t } = useTranslation();\n  const wsId = getCurrentWorkspaceId();\n  const queryClient = useQueryClient();\n  const [file, setFile] = useState<File | null>(null);\n  const [uploading, setUploading] = useState(false);\n  const [activeJobId, setActiveJobId] = useState<string | null>(null);\n\n  const { data: jobStatus } = useQuery({\n    queryKey: [\"import-job\", activeJobId],\n    queryFn: () => fetchImportJobStatus(wsId!, activeJobId!),\n    enabled: !!activeJobId && !!wsId,\n    refetchInterval: (query) => {\n        const status = query.state.data?.status;\n        return (status === \"processing\" || status === \"pending\") ? 1000 : false;\n    }\n  });\n\n  const { data: latestJob } = useQuery({\n    queryKey: [\"latest-import-job\", wsId, targetType],\n    queryFn: () => fetchLatestImportJob(wsId!, targetType),\n    enabled: isOpen && !!wsId,\n  });\n\n  useEffect(() => { if (latestJob) setActiveJobId(latestJob.id); }, [latestJob]);\n\n  const handleUpload = async () => {\n    if (!file || !wsId) return;\n    setUploading(true);\n    try {\n      const result = await uploadAttendance(wsId, file, endpoint);\n      setActiveJobId(result.job_id); setFile(null);\n      queryClient.invalidateQueries({ queryKey: [\"latest-import-job\"] });\n    } catch (error) { console.error(error); } finally { setUploading(false); }\n  };\n\n  const isFinished = jobStatus?.status === \"completed\" || jobStatus?.status === \"failed\";\n\n  return (\n    <Modal isOpen={isOpen} onClose={onClose} title={title} subtitle={t(\"attendance_import.subtitle\")} icon={<Upload size={24} />} maxWidth=\"lg\">\n      {activeJobId ? (\n        <div className=\"space-y-5 pt-2 animate-in fade-in duration-500\">\n          <div className=\"flex items-center justify-between px-2\">\n            <div className=\"flex items-center gap-4\">\n              <div className=\"w-11 h-11 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center shadow-inner border border-slate-200 dark:border-slate-700\">\n                {jobStatus?.status === \"processing\" ? <Loader2 size={20} className=\"text-primary-600 dark:text-primary-400 animate-spin\" /> : jobStatus?.status === \"completed\" ? <CheckCircle2 size={20} className=\"text-emerald-500\" /> : jobStatus?.status === \"failed\" ? <AlertCircle size={20} className=\"text-rose-500\" /> : <Loader2 size={20} className=\"text-slate-500 dark:text-slate-400 animate-spin\" />}\n              </div>\n              <div>\n                <h3 className=\"font-bold text-slate-800 dark:text-slate-200 uppercase tracking-tight text-base leading-none mb-1\">\n                  {jobStatus?.status === \"processing\" ? t(\"attendance_import.status.processing\") : jobStatus?.status === \"completed\" ? t(\"attendance_import.status.completed\") : jobStatus?.status === \"failed\" ? t(\"attendance_import.status.failed\") : t(\"attendance_import.status.pending\")}\n                </h3>\n                <p className=\"text-[10px] font-bold text-slate-600 dark:text-slate-400 uppercase tracking-[0.2em]\">{jobStatus?.processed_rows || 0} / {jobStatus?.total_rows || 0} {t(\"attendance_import.rows_processed\")}</p>\n              </div>\n            </div>\n            {jobStatus?.total_rows ? <span className=\"text-[10px] font-bold text-primary-700 dark:text-primary-400 bg-primary-50 dark:bg-primary-950 px-3 py-1 rounded-full border border-primary-200 dark:border-primary-800 shadow-sm\">{Math.round((jobStatus.processed_rows / jobStatus.total_rows) * 100)}%</span> : null}\n          </div>\n\n          <div className=\"h-2.5 w-full bg-slate-100 dark:bg-slate-700 rounded-full overflow-hidden shadow-inner border border-slate-200 dark:border-slate-700/50 relative\">\n            <div className={cn(\"h-full transition-all duration-1000 shadow-xl\", jobStatus?.status === \"failed\" ? \"bg-rose-400 dark:bg-rose-500\" : \"bg-primary-600\")} style={{ width: `${jobStatus?.total_rows ? (jobStatus.processed_rows / jobStatus.total_rows) * 100 : 0}%` }}>\n               <div className=\"absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent animate-shimmer\" style={{ backgroundSize: '200% 100%' }} />\n            </div>\n          </div>\n\n          {jobStatus?.error_log && (\n            <div className=\"bg-slate-50 dark:bg-slate-900 rounded-2xl p-6 border border-rose-200 dark:border-rose-900/50 shadow-sm relative overflow-hidden\">\n              <h4 className=\"text-[10px] font-bold text-rose-600 dark:text-rose-400 mb-4 flex items-center gap-2 uppercase tracking-[0.25em]\"><AlertCircle size={14} /> {t(\"attendance_import.error_list_title\")}</h4>\n              <div className=\"space-y-2 max-h-48 overflow-y-auto pr-2 custom-scrollbar relative z-10\">\n                {jobStatus.error_log.split(\"\\n\").map((err: string, i: number) => (<div key={i} className=\"text-[11px] bg-white dark:bg-slate-800 p-3 rounded-lg border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 font-mono leading-relaxed\"><span className=\"text-rose-500 mr-2 font-bold uppercase\">ERR:</span> {err}</div>))}\n              </div>\n            </div>\n          )}\n\n          {isFinished && (\n            <div className=\"pt-3 flex justify-end border-t border-slate-200 dark:border-slate-800\">\n              <button onClick={() => { setActiveJobId(null); queryClient.invalidateQueries(); }} className=\"px-10 py-3 bg-slate-800 dark:bg-slate-700 text-white rounded-xl font-bold text-xs uppercase tracking-widest hover:bg-primary-700 transition-all shadow-lg active:scale-95\">{t(\"common.close\").toUpperCase()}</button>\n            </div>\n          )}\n        </div>\n      ) : (\n        <div className=\"space-y-6 pt-2 animate-in fade-in duration-500\">\n          <div className=\"bg-primary-50 dark:bg-primary-950/50 rounded-2xl p-5 border border-primary-200 dark:border-primary-800/50 flex gap-4\">\n            <div className=\"w-9 h-9 rounded-xl bg-white dark:bg-slate-900 flex items-center justify-center text-primary-600 dark:text-primary-400 shadow-sm border border-primary-200 dark:border-primary-800 shrink-0\"><AlertCircle size={18} /></div>\n            <div className=\"text-xs text-primary-800 dark:text-primary-200 leading-relaxed font-medium pt-0.5\">\n              <p className=\"font-bold uppercase tracking-[0.2em] mb-2 text-slate-700 dark:text-slate-300\">{t(\"attendance_import.file_requirements.title\")}</p>\n              <ul className=\"grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-1.5 text-slate-600 dark:text-slate-400 font-bold uppercase tracking-tight\">\n                {customRequirements ? (\n                  customRequirements.map((req, i) => (\n                    <li key={i} className=\"flex items-center gap-2\"><div className=\"w-1.5 h-1.5 bg-primary-500 dark:bg-primary-400 rounded-full\" /> {req}</li>\n                  ))\n                ) : (\n                  <>\n                    <li className=\"flex items-center gap-2\"><div className=\"w-1.5 h-1.5 bg-primary-500 dark:bg-primary-400 rounded-full\" /> {t(\"attendance_import.file_requirements.col_a\")}</li>\n                    <li className=\"flex items-center gap-2\"><div className=\"w-1.5 h-1.5 bg-primary-500 dark:bg-primary-400 rounded-full\" /> {t(\"attendance_import.file_requirements.col_b\")}</li>\n                    <li className=\"flex items-center gap-2\"><div className=\"w-1.5 h-1.5 bg-primary-500 dark:bg-primary-400 rounded-full\" /> {t(\"attendance_import.file_requirements.col_c\")}</li>\n                    <li className=\"flex items-center gap-2\"><div className=\"w-1.5 h-1.5 bg-primary-500 dark:bg-primary-400 rounded-full\" /> {t(\"attendance_import.file_requirements.formats\")}</li>\n                  </>\n                )}\n              </ul>\n            </div>\n          </div>\n\n          <div className={cn(\"border-3 border-dashed rounded-2xl p-10 flex flex-col items-center justify-center transition-all cursor-pointer group active:scale-[0.98] relative overflow-hidden\", file ? \"border-emerald-400 bg-emerald-50 dark:bg-emerald-950/20\" : \"border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/30 hover:border-primary-400 hover:bg-primary-50 dark:hover:bg-primary-950/30\")} onClick={() => document.getElementById(\"file-upload\")?.click()}>\n            <input id=\"file-upload\" aria-label=\"File Upload\" type=\"file\" className=\"hidden\" accept=\".xlsx,.xls,.csv\" onChange={(e) => setFile(e.target.files?.[0] || null)} />\n            {file ? (\n              <div className=\"text-center animate-in zoom-in-95 duration-500\">\n                <div className=\"w-16 h-16 bg-emerald-100 dark:bg-emerald-900 rounded-2xl flex items-center justify-center mx-auto mb-5 shadow-lg shadow-emerald-200/50 dark:shadow-emerald-900/30 rotate-3 group-hover:rotate-0 transition-transform\"><FileText size={28} className=\"text-emerald-600 dark:text-emerald-300\" /></div>\n                <p className=\"font-bold text-slate-800 dark:text-slate-200 mb-1 text-lg tracking-tight uppercase\">{file.name}</p>\n                <p className=\"text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">{(file.size / 1024).toFixed(1)} KB — READY TO START</p>\n                <button onClick={(e) => { e.stopPropagation(); setFile(null); }} className=\"mt-5 text-[10px] font-bold text-rose-600 dark:text-rose-400 uppercase tracking-widest hover:text-rose-700 dark:hover:text-rose-300 transition-all bg-white dark:bg-slate-900 px-5 py-2 rounded-lg border border-rose-200 dark:border-rose-800 shadow-sm hover:shadow-md active:scale-90\">{t(\"attendance_import.select_another_file\")}</button>\n              </div>\n            ) : (\n              <div className=\"text-center group-hover:scale-105 transition-transform duration-500\">\n                <div className=\"w-16 h-16 bg-white dark:bg-slate-900 rounded-2xl flex items-center justify-center mx-auto mb-5 shadow-lg border border-slate-200 dark:border-slate-700 -rotate-3 group-hover:rotate-0 transition-all\"><Upload size={28} className=\"text-slate-400 dark:text-slate-500\" /></div>\n                <p className=\"font-bold text-slate-800 dark:text-slate-200 mb-1 text-lg tracking-tight uppercase\">{t(\"attendance_import.upload_prompt\")}</p>\n                <p className=\"text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">{t(\"attendance_import.upload_limit\")}</p>\n              </div>\n            )}\n          </div>\n\n          <div className=\"flex gap-4 pt-3 border-t border-slate-200 dark:border-slate-800\">\n            <button onClick={onClose} className=\"flex-1 px-6 py-3 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 rounded-xl font-bold text-[10px] uppercase tracking-widest hover:bg-slate-50 dark:hover:bg-slate-800 transition-all active:scale-95\">{t(\"common.cancel\")}</button>\n            <button disabled={!file || uploading} onClick={handleUpload} className=\"flex-[1.5] py-3 bg-primary-600 text-white rounded-xl font-bold text-[10px] uppercase tracking-widest hover:bg-primary-700 transition-all shadow-lg shadow-primary-200/50 dark:shadow-primary-900/30 active:scale-95 disabled:opacity-50 flex items-center justify-center gap-3\">\n              {uploading ? <><Loader2 size={18} className=\"animate-spin\" /> {t(\"attendance_import.status.uploading\").toUpperCase()}</> : t(\"attendance_import.start_import\").toUpperCase()}\n            </button>\n          </div>\n        </div>\n      )}\n    </Modal>\n  );\n}","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/attendance/PolicyAssignmentsSection.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'MoreVertical' is defined but never used. Allowed unused vars must match /^_/u.","line":13,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":13,"endColumn":15,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"MoreVertical"},"fix":{"range":[215,231],"text":""},"desc":"Remove unused variable \"MoreVertical\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'PolicyAssignmentResponse' is defined but never used. Allowed unused vars must match /^_/u.","line":33,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":33,"endColumn":27,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"PolicyAssignmentResponse"},"fix":{"range":[717,745],"text":""},"desc":"Remove unused variable \"PolicyAssignmentResponse\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Department' is defined but never used. Allowed unused vars must match /^_/u.","line":34,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":34,"endColumn":13,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Department"},"fix":{"range":[745,759],"text":""},"desc":"Remove unused variable \"Department\"."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":285,"column":65,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":285,"endColumn":68,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[17698,17701],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[17698,17701],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":4,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState } from \"react\";\n\nimport { useQuery, useMutation, useQueryClient } from \"@tanstack/react-query\";\nimport { \n  Building2, \n  User, \n  Plus, \n  Settings2, \n  Clock, \n  ShieldAlert, \n  Calculator,\n  Zap,\n  MoreVertical,\n  Trash2,\n  ChevronRight,\n  Filter\n} from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\n\nimport Button from \"@/components/ui/Button\";\nimport { Combobox } from \"@/components/ui/Combobox\";\nimport { LABEL_BASE } from \"@/components/ui/FormField\";\nimport Sheet from \"@/components/ui/Sheet\";\nimport { useToast } from \"@/components/ui/Toast\";\n\nimport { \n  fetchPolicyAssignments, \n  upsertPolicyAssignment, \n  deletePolicyAssignment, \n  fetchDepartments, \n  fetchEmployees,\n  PolicyAssignmentResponse,\n  Department,\n  Employee, UpsertPolicyAssignmentRequest \n} from \"@/lib/api\";\nimport { cn } from \"@/lib/utils\";\n\n// We'll build a slide-over later, but for now let's structure the table.\n\nexport function PolicyAssignmentsSection({ wsId }: { wsId: string }) {\n  const { t } = useTranslation();\n  const queryClient = useQueryClient();\n  const toast = useToast();\n\n  const { data: assignments = [], isLoading: isLoadingAssignments } = useQuery({\n    queryKey: [\"attendance-policy-assignments\", wsId],\n    queryFn: () => fetchPolicyAssignments(wsId),\n  });\n\n  const { data: departments = [] } = useQuery({\n    queryKey: [\"departments\", wsId],\n    queryFn: () => fetchDepartments(wsId),\n  });\n\n  const { data: employeesResponse } = useQuery({\n    queryKey: [\"employees\", wsId],\n    queryFn: () => fetchEmployees(wsId, 1, 1000),\n  });\n\n  const employees = employeesResponse?.data || [];\n\n  const [activeFilter, setActiveFilter] = useState<\"ALL\" | \"GROUP\" | \"USER\">(\"ALL\");\n\n  const filteredAssignments = assignments.filter(a => activeFilter === \"ALL\" || a.target_type === activeFilter);\n\n  // Helper to resolve name\n  const getTargetName = (type: string, id: string) => {\n    if (type === \"GROUP\") {\n      const dept = departments.find(d => d.id === id);\n      return dept ? dept.name : \"Unknown Department\";\n    } else {\n      const emp = employees.find((e: Employee) => e.id === id);\n      return emp ? emp.full_name : \"Unknown Employee\";\n    }\n  };\n\n  const workUnitLabel = (v: number) => {\n    if (v === 1) return t(\"common.workspace_settings.work_unit_options.1min\");\n    if (v === 15) return t(\"common.workspace_settings.work_unit_options.15min\");\n    if (v === 30) return t(\"common.workspace_settings.work_unit_options.30min\");\n    if (v === 60) return t(\"common.workspace_settings.work_unit_options.60min\");\n    return `${v} min`;\n  };\n\n  const roundingLabel = (v: string) => {\n    const map: Record<string, string> = { \n      none: t(\"common.workspace_settings.rounding_options.none\"), \n      floor: t(\"common.workspace_settings.rounding_options.floor\"), \n      ceil: t(\"common.workspace_settings.rounding_options.ceil\"), \n      round: t(\"common.workspace_settings.rounding_options.round\") \n    };\n    return map[v] || v;\n  };\n\n  const deleteMutation = useMutation({\n    mutationFn: (id: string) => deletePolicyAssignment(wsId, id),\n    onSuccess: () => {\n      toast.success(t(\"attendance_policy_overrides.messages.delete_success\"));\n      queryClient.invalidateQueries({ queryKey: [\"attendance-policy-assignments\", wsId] });\n    }\n  });\n\n  const [isDrawerOpen, setIsDrawerOpen] = useState(false);\n  const [targetType, setTargetType] = useState<\"USER\" | \"GROUP\">(\"GROUP\");\n  const [targetId, setTargetId] = useState(\"\");\n  const [workUnitMinutes, setWorkUnitMinutes] = useState(1);\n  const [roundingPolicy, setRoundingPolicy] = useState(\"none\");\n  const [earlyArrivalStrategy, setEarlyArrivalStrategy] = useState<\"allow\" | \"block\" | \"clamp\">(\"allow\");\n  const [validFrom, setValidFrom] = useState(() => new Date().toISOString().split(\"T\")[0]);\n\n  const upsertMutation = useMutation({\n    mutationFn: (data: UpsertPolicyAssignmentRequest) => upsertPolicyAssignment(wsId, data),\n    onSuccess: () => {\n      toast.success(t(\"attendance_policy_overrides.messages.save_success\"));\n      queryClient.invalidateQueries({ queryKey: [\"attendance-policy-assignments\", wsId] });\n      setIsDrawerOpen(false);\n      setTargetId(\"\");\n    }\n  });\n\n  const handleSave = () => {\n    if (!targetId) {\n      toast.error(t(\"attendance_policy_overrides.messages.validation_select_target\"));\n      return;\n    }\n    upsertMutation.mutate({\n      target_type: targetType,\n      target_id: targetId,\n      work_unit_minutes: workUnitMinutes,\n      rounding_policy: roundingPolicy,\n      early_arrival_strategy: earlyArrivalStrategy,\n      valid_from: validFrom,\n    });\n  };\n\n  const targetOptions = targetType === \"GROUP\"\n    ? departments.map(d => ({ value: d.id, label: d.name, icon: <Building2 className=\"w-4 h-4 text-indigo-500\" /> }))\n    : employees.map((e: Employee) => ({ value: e.id, label: e.full_name, description: e.employee_id_number, icon: <User className=\"w-4 h-4 text-teal-500\" /> }));\n\n\n  if (isLoadingAssignments) return <div className=\"h-40 animate-pulse bg-slate-100 dark:bg-slate-800 rounded-[2.5rem]\"></div>;\n\n  return (\n    <div className=\"bg-white dark:bg-slate-900 rounded-[2.5rem] border border-slate-100 dark:border-slate-800 shadow-sm overflow-hidden mt-8\">\n      <div className=\"p-10 border-b border-slate-50 dark:border-slate-800\">\n        <div className=\"flex items-center justify-between\">\n          <div>\n            <h2 className=\"text-xl font-bold text-slate-800 dark:text-slate-100 tracking-tight uppercase\">{t(\"attendance_policy_overrides.title\")}</h2>\n            <p className=\"text-sm text-slate-500 dark:text-slate-400 mt-1\">{t(\"attendance_policy_overrides.description\")}</p>\n          </div>\n          <div className=\"flex items-center gap-3\">\n            <div className=\"flex bg-slate-100 dark:bg-slate-800 p-1 rounded-xl\">\n              <button onClick={() => setActiveFilter(\"ALL\")} className={cn(\"px-4 py-2 rounded-lg text-xs font-bold tracking-widest uppercase transition-all\", activeFilter === \"ALL\" ? \"bg-white dark:bg-slate-900 shadow-sm text-slate-800 dark:text-slate-200\" : \"text-slate-500 hover:text-slate-700\")}>{t(\"attendance_policy_overrides.filters.all\")}</button>\n              <button onClick={() => setActiveFilter(\"GROUP\")} className={cn(\"px-4 py-2 rounded-lg text-xs font-bold tracking-widest uppercase transition-all\", activeFilter === \"GROUP\" ? \"bg-white dark:bg-slate-900 shadow-sm text-slate-800 dark:text-slate-200\" : \"text-slate-500 hover:text-slate-700\")}>{t(\"attendance_policy_overrides.filters.depts\")}</button>\n              <button onClick={() => setActiveFilter(\"USER\")} className={cn(\"px-4 py-2 rounded-lg text-xs font-bold tracking-widest uppercase transition-all\", activeFilter === \"USER\" ? \"bg-white dark:bg-slate-900 shadow-sm text-slate-800 dark:text-slate-200\" : \"text-slate-500 hover:text-slate-700\")}>{t(\"attendance_policy_overrides.filters.users\")}</button>\n            </div>\n            <Button icon={<Plus size={18} />} onClick={() => setIsDrawerOpen(true)}>{t(\"attendance_policy_overrides.add_button\")}</Button>\n          </div>\n        </div>\n      </div>\n\n      <div className=\"p-10\">\n        {filteredAssignments.length === 0 ? (\n          <div className=\"text-center py-12 border-2 border-dashed border-slate-100 dark:border-slate-800 rounded-3xl bg-slate-50/50 dark:bg-slate-800/30\">\n            <Filter className=\"w-12 h-12 text-slate-300 dark:text-slate-600 mx-auto mb-4\" />\n            <h3 className=\"text-lg font-bold text-slate-600 dark:text-slate-300\">{t(\"attendance_policy_overrides.empty_state.title\")}</h3>\n            <p className=\"text-sm text-slate-500 mt-1\">{t(\"attendance_policy_overrides.empty_state.description\")}</p>\n          </div>\n        ) : (\n          <div className=\"space-y-4\">\n            {filteredAssignments.map(assignment => (\n              <div key={assignment.id} className=\"group relative border border-slate-100 dark:border-slate-800 rounded-2xl p-6 bg-slate-50/50 dark:bg-slate-800/20 hover:bg-white dark:hover:bg-slate-800 transition-all flex items-center justify-between\">\n                <div className=\"flex items-center gap-5\">\n                  <div className={cn(\"w-12 h-12 rounded-xl flex items-center justify-center shadow-sm border\", assignment.target_type === \"GROUP\" ? \"bg-indigo-50 dark:bg-indigo-950/30 border-indigo-100 dark:border-indigo-800 text-indigo-600 dark:text-indigo-400\" : \"bg-teal-50 dark:bg-teal-950/30 border-teal-100 dark:border-teal-800 text-teal-600 dark:text-teal-400\")}>\n                    {assignment.target_type === \"GROUP\" ? <Building2 size={24} /> : <User size={24} />}\n                  </div>\n                  <div>\n                    <div className=\"flex items-center gap-2 mb-1\">\n                      <span className={cn(\"px-2 py-0.5 text-[9px] font-bold uppercase tracking-widest rounded-md\", assignment.target_type === \"GROUP\" ? \"bg-indigo-100 text-indigo-700 dark:bg-indigo-900/50 dark:text-indigo-300\" : \"bg-teal-100 text-teal-700 dark:bg-teal-900/50 dark:text-teal-300\")}>\n                        {assignment.target_type === \"GROUP\" ? t(\"attendance_policy_overrides.labels.department\") : t(\"attendance_policy_overrides.labels.employee\")}\n                      </span>\n                    </div>\n                    <h4 className=\"text-lg font-bold text-slate-800 dark:text-slate-200\">\n                      {getTargetName(assignment.target_type, assignment.target_id)}\n                    </h4>\n                  </div>\n                </div>\n\n                <div className=\"flex items-center gap-8 px-6\">\n                  <div>\n                    <p className=\"text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1\">{t(\"common.workspace_settings.work_unit\")}</p>\n                    <p className=\"text-sm font-bold text-slate-700 dark:text-slate-300\">{workUnitLabel(assignment.rules.work_unit_minutes)}</p>\n                  </div>\n                  <div>\n                    <p className=\"text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1\">{t(\"common.workspace_settings.rounding_policy\")}</p>\n                    <p className=\"text-sm font-bold text-slate-700 dark:text-slate-300\">{roundingLabel(assignment.rules.rounding_policy)}</p>\n                  </div>\n                  <div>\n                    <p className=\"text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1\">{t(\"common.workspace_settings.early_arrival_strategy\")}</p>\n                    <p className=\"text-sm font-bold text-slate-700 dark:text-slate-300\">{t(`common.workspace_settings.early_arrival_options.${assignment.rules.early_arrival_strategy || \"block\"}`)}</p>\n                  </div>\n                </div>\n\n                <div className=\"flex items-center gap-2\">\n                  <button onClick={() => deleteMutation.mutate(assignment.id)} className=\"w-10 h-10 rounded-xl flex items-center justify-center text-slate-400 hover:bg-red-50 hover:text-red-600 dark:hover:bg-red-950/30 transition-colors\">\n                    <Trash2 size={18} />\n                  </button>\n                  <button className=\"w-10 h-10 rounded-xl flex items-center justify-center text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors\">\n                    <ChevronRight size={20} />\n                  </button>\n                </div>\n              </div>\n            ))}\n          </div>\n        )}\n      </div>\n\n      <Sheet\n        isOpen={isDrawerOpen}\n        onClose={() => setIsDrawerOpen(false)}\n        title={t(\"attendance_policy_overrides.drawer.add_title\")}\n        subtitle={t(\"attendance_policy_overrides.drawer.add_subtitle\")}\n      >\n        <div className=\"space-y-8\">\n          <div className=\"space-y-4\">\n            <h3 className=\"text-xs font-bold text-slate-500 uppercase tracking-widest\">{t(\"attendance_policy_overrides.drawer.step_target\")}</h3>\n            \n            <div className=\"grid grid-cols-2 gap-3 mb-4\">\n              <button\n                className={cn(\"p-4 rounded-2xl border transition-all flex flex-col items-center gap-2\", targetType === \"GROUP\" ? \"bg-indigo-50 dark:bg-indigo-950/30 border-indigo-200 dark:border-indigo-800 text-indigo-700 dark:text-indigo-400 shadow-inner\" : \"bg-white dark:bg-slate-900 border-slate-100 dark:border-slate-800 text-slate-500 hover:border-slate-300 dark:hover:border-slate-700\")}\n                onClick={() => { setTargetType(\"GROUP\"); setTargetId(\"\"); }}\n              >\n                <Building2 size={24} />\n                <span className=\"text-xs font-bold uppercase tracking-widest\">{t(\"attendance_policy_overrides.labels.department\")}</span>\n              </button>\n              <button\n                className={cn(\"p-4 rounded-2xl border transition-all flex flex-col items-center gap-2\", targetType === \"USER\" ? \"bg-teal-50 dark:bg-teal-950/30 border-teal-200 dark:border-teal-800 text-teal-700 dark:text-teal-400 shadow-inner\" : \"bg-white dark:bg-slate-900 border-slate-100 dark:border-slate-800 text-slate-500 hover:border-slate-300 dark:hover:border-slate-700\")}\n                onClick={() => { setTargetType(\"USER\"); setTargetId(\"\"); }}\n              >\n                <User size={24} />\n                <span className=\"text-xs font-bold uppercase tracking-widest\">{t(\"attendance_policy_overrides.labels.employee\")}</span>\n              </button>\n            </div>\n\n            <div>\n              <label className={LABEL_BASE}>{t(\"attendance_policy_overrides.drawer.select_target_type\", { type: targetType === \"GROUP\" ? t(\"attendance_policy_overrides.labels.department\") : t(\"attendance_policy_overrides.labels.employee\") })}</label>\n              <Combobox\n                options={targetOptions}\n                value={targetId}\n                onChange={setTargetId}\n                placeholder={t(\"attendance_policy_overrides.drawer.search_placeholder\", { type: targetType === \"GROUP\" ? t(\"attendance_policy_overrides.labels.department\") : t(\"attendance_policy_overrides.labels.employee\") })}\n              />\n            </div>\n          </div>\n\n          <div className=\"space-y-4\">\n            <h3 className=\"text-xs font-bold text-slate-500 uppercase tracking-widest\">{t(\"attendance_policy_overrides.drawer.step_rules\")}</h3>\n            \n            <div className=\"space-y-5 bg-slate-50/50 dark:bg-slate-800/30 p-6 rounded-[2rem] border border-slate-100 dark:border-slate-800\">\n              <div className=\"space-y-3\">\n                <label className={LABEL_BASE}>{t(\"common.workspace_settings.valid_from\") || \"Effective From\"}</label>\n                <input type=\"date\" value={validFrom} onChange={e => setValidFrom(e.target.value)} className=\"w-full px-6 py-4 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-2xl focus:ring-4 focus:ring-primary-500/10 outline-none transition-all font-bold text-sm tracking-tight shadow-sm\" />\n              </div>\n\n              <div className=\"space-y-3\">\n                <label className={LABEL_BASE}>{t(\"common.workspace_settings.work_unit\")}</label>\n                <Combobox options={[{ value: \"1\", label: t(\"common.workspace_settings.work_unit_options.1min\"), description: t(\"common.workspace_settings.work_unit_options.1min_desc\"), icon: <Clock size={14} /> }, { value: \"15\", label: t(\"common.workspace_settings.work_unit_options.15min\"), description: t(\"common.workspace_settings.work_unit_options.15min_desc\"), icon: <Clock size={14} /> }, { value: \"30\", label: t(\"common.workspace_settings.work_unit_options.30min\"), description: t(\"common.workspace_settings.work_unit_options.30min_desc\"), icon: <Clock size={14} /> }, { value: \"60\", label: t(\"common.workspace_settings.work_unit_options.60min\"), description: t(\"common.workspace_settings.work_unit_options.60min_desc\"), icon: <Clock size={14} /> }]} value={workUnitMinutes.toString()} onChange={(v) => setWorkUnitMinutes(parseInt(v))} className=\"bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-700 h-14\" />\n              </div>\n\n              <div className=\"space-y-3\">\n                <label className={LABEL_BASE}>{t(\"common.workspace_settings.rounding_policy\")}</label>\n                <Combobox options={[{ value: \"none\", label: t(\"common.workspace_settings.rounding_options.none\"), icon: <ShieldAlert size={14} /> }, { value: \"floor\", label: t(\"common.workspace_settings.rounding_options.floor\"), icon: <Calculator size={14} /> }, { value: \"ceil\", label: t(\"common.workspace_settings.rounding_options.ceil\"), icon: <Calculator size={14} /> }, {