pt-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":153,"column":30,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":153,"endColumn":33,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[5069,5072],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[5069,5072],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":10,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from \"react\";\n\nimport { QueryClient, QueryClientProvider } from \"@tanstack/react-query\";\nimport { render, screen, fireEvent, waitFor } from \"@testing-library/react\";\nimport userEvent from \"@testing-library/user-event\";\nimport { describe, it, expect, vi, beforeEach } from \"vitest\";\n\nimport { ToastProvider } from \"../../components/ui/Toast\";\nimport * as api from \"../../lib/api\";\nimport DepartmentsPage from \"../DepartmentsPage\";\n\n\n// Mock TanStack Router\nvi.mock(\"@tanstack/react-router\", () => ({\n  useNavigate: () => vi.fn(),\n  useLocation: () => ({ pathname: \"/\", search: \"\", hash: \"\" }),\n  Link: ({ to, children, ...props }: any) => <a href={to} {...props}>{children}</a>,\n}));\n\n// Mock the API library\nvi.mock(\"../../lib/api\", () => ({\n  fetchDepartments: vi.fn(),\n  createDepartment: vi.fn(),\n  updateDepartment: vi.fn(),\n  deleteDepartment: vi.fn(),\n  getCurrentWorkspaceId: vi.fn(),\n  fetchUsers: vi.fn(),\n  fetchWorkingPatterns: vi.fn(),\n  fetchDepartmentPayrollConfigs: vi.fn(),\n  setDepartmentPayrollConfig: vi.fn(),\n}));\n\n// Override i18n for this test to return keys\nvi.mock('react-i18next', () => ({\n  useTranslation: () => ({\n    t: (key: string, options?: any) => {\n      if (typeof options === \"string\") return options;\n      if (options && options.defaultValue) return options.defaultValue;\n      return key;\n    },\n    i18n: {\n      changeLanguage: () => Promise.resolve(),\n      language: 'en',\n    },\n  }),\n}));\n\ndescribe(\"DepartmentsPage\", () => {\n  let queryClient: QueryClient;\n\n  beforeEach(() => {\n    vi.clearAllMocks();\n    queryClient = new QueryClient({\n      defaultOptions: {\n        queries: {\n          retry: false,\n          gcTime: 0,\n          staleTime: 0,\n        },\n      },\n    });\n    (api.getCurrentWorkspaceId as any).mockReturnValue(\"test-ws-id\");\n    (api.fetchDepartments as any).mockResolvedValue([\n      { id: \"dept-1\", name: \"Engineering\", description: \"Tech stuff\", manager_id: \"user-1\", active_employee_count: 5 }\n    ]);\n    (api.fetchUsers as any).mockResolvedValue([\n      { id: \"user-1\", full_name: \"Manager One\", email: \"manager1@example.com\" }\n    ]);\n    (api.fetchWorkingPatterns as any).mockResolvedValue([\n      { id: \"pat-1\", name: \"Standard Pattern\" }\n    ]);\n  });\n\n  const renderWithProviders = (ui: React.ReactElement) => {\n    return render(\n      <QueryClientProvider client={queryClient}>\n        <ToastProvider>\n          {ui}\n        </ToastProvider>\n      </QueryClientProvider>\n    );\n  };\n\n  it(\"renders without workspace selected\", () => {\n    (api.getCurrentWorkspaceId as any).mockReturnValue(null);\n    renderWithProviders(<DepartmentsPage />);\n    expect(screen.getByText(\"common.select_workspace\")).toBeDefined();\n  });\n\n  it(\"renders departments list\", async () => {\n    renderWithProviders(<DepartmentsPage />);\n    expect(await screen.findByText(\"Engineering\")).toBeDefined();\n    expect(screen.getByText(\"Tech stuff\")).toBeDefined();\n    expect(screen.getByText(\"Manager One\")).toBeDefined();\n  });\n\n  it(\"handles creating a new department with working pattern\", async () => {\n    const user = userEvent.setup();\n    (api.createDepartment as any).mockResolvedValue({ id: \"new-dept\", name: \"HR\" });\n\n    renderWithProviders(<DepartmentsPage />);\n\n    await user.click(screen.getByText(/departments.add_btn/i));\n\n    // Wait for modal to be visible\n    expect(await screen.findByText(/departments.modal.add_title/i)).toBeDefined();\n\n    const nameInput = await screen.findByLabelText(/departments.form.name_label/i);\n    await user.type(nameInput, \"Human Resources\");\n    \n    // Select pattern via mock select (which is what Combobox is in tests)\n    const mockSelect = await screen.findByTestId(\"dept-pattern\");\n    await user.selectOptions(mockSelect, \"pat-1\");\n\n    await user.click(screen.getByText(/departments.modal.submit_btn/i));\n\n    await waitFor(() => {\n      expect(api.createDepartment).toHaveBeenCalledWith(\"test-ws-id\", expect.objectContaining({\n        name: \"Human Resources\",\n        default_working_pattern_id: \"pat-1\"\n      }));\n    });\n  });\n\n  it(\"handles updating a department\", async () => {\n    const user = userEvent.setup();\n    (api.updateDepartment as any).mockResolvedValue({ id: \"dept-1\", name: \"Engineering Updated\" });\n\n    renderWithProviders(<DepartmentsPage />);\n    \n    // Wait for data to load\n    await screen.findByText(\"Engineering\");\n\n    // Use title which we added during modernization\n    const editBtn = await screen.findByTitle(/common.edit/i);\n    await user.click(editBtn);\n\n    const nameInput = await screen.findByLabelText(/departments.form.name_label/i);\n    await user.clear(nameInput);\n    await user.type(nameInput, \"Software Engineering\");\n\n    await user.click(screen.getByText(/common.update/i));\n\n    await waitFor(() => {\n      expect(api.updateDepartment).toHaveBeenCalledWith(\"test-ws-id\", \"dept-1\", expect.objectContaining({\n        name: \"Software Engineering\"\n      }));\n    });\n  });\n\n  it(\"handles deleting a department\", async () => {\n    const user = userEvent.setup();\n    (api.deleteDepartment as any).mockResolvedValue({});\n\n    renderWithProviders(<DepartmentsPage />);\n\n    await screen.findByText(\"Engineering\");\n    \n    const deleteBtn = await screen.findByTitle(/common.delete/i);\n    await user.click(deleteBtn);\n\n    // Confirm the useConfirm modal\n    const confirmModalBtn = await screen.findByRole(\"button\", { name: \"Confirm\" });\n    fireEvent.click(confirmModalBtn);\n\n    await waitFor(() => {\n      expect(api.deleteDepartment).toHaveBeenCalledWith(\"test-ws-id\", \"dept-1\");\n    });\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/__tests__/EmployeesPage.test.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":17,"column":38,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":17,"endColumn":41,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[686,689],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[686,689],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":26,"column":59,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":26,"endColumn":62,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[931,934],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[931,934],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"