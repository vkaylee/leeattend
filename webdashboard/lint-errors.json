rridden, setShowOverridden] = useState(false);\n\n  const appliedRule = traces.find(t => t.status === 'applied');\n  const overriddenRules = traces.filter(t => t.status === 'overridden');\n\n  if (traces.length === 0) return null;\n\n  return (\n    <Popover.Root>\n      <Popover.Trigger asChild>\n        <button \n          onClick={(e) => e.stopPropagation()}\n          className=\"p-1 rounded-full hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-500 dark:text-slate-400 transition-colors\"\n        >\n          <Info size={14} />\n        </button>\n      </Popover.Trigger>\n      <Popover.Portal>\n        <Popover.Content \n          className=\"z-50 w-80 bg-white dark:bg-slate-900 rounded-2xl shadow-xl border border-slate-100 dark:border-slate-800 p-4 animate-in fade-in zoom-in-95 duration-200\"\n          sideOffset={5}\n          onClick={(e) => e.stopPropagation()}\n        >\n          <div className=\"flex flex-col gap-4\">\n            <div className=\"flex items-center gap-2 border-b border-slate-50 dark:border-slate-800 pb-3\">\n              <div className=\"p-2 bg-blue-50 dark:bg-blue-950 text-blue-600 dark:text-blue-300 rounded-lg\">\n                <Shield size={16} />\n              </div>\n              <div>\n                <h3 className=\"text-sm font-bold text-slate-700 dark:text-slate-200 uppercase tracking-tight\">\n                  {t(\"shifts.traceability.title\")}\n                </h3>\n                <p className=\"text-[10px] text-slate-500 dark:text-slate-400 font-bold uppercase tracking-widest\">\n                  {t(\"shifts.traceability.source\")}: {source}\n                </p>\n              </div>\n            </div>\n\n            {/* Applied Rule */}\n            {appliedRule && (\n              <div className=\"space-y-2\">\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"text-[10px] font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400\">\n                    {t(\"shifts.traceability.winner\")}\n                  </span>\n                  <span className=\"text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-300 border border-emerald-100 dark:border-emerald-800 uppercase\">\n                    {t(\"shifts.traceability.applied\")}\n                  </span>\n                </div>\n                <div className=\"p-3 bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-100 dark:border-emerald-800 rounded-xl space-y-1\">\n                  <div className=\"flex items-center gap-2 text-emerald-700 dark:text-emerald-300\">\n                    <CheckCircle2 size={14} />\n                    <span className=\"text-xs font-bold\">{appliedRule.rule_name}</span>\n                  </div>\n                  {appliedRule.reason && (\n                    <p className=\"text-[10px] text-emerald-600 dark:text-emerald-300/80 leading-relaxed pl-5\">\n                      {appliedRule.reason}\n                    </p>\n                  )}\n                  <div className=\"pt-1 flex items-center gap-3 pl-5\">\n                    <span className=\"text-[9px] font-bold text-slate-500 dark:text-slate-400 uppercase\">\n                      {t(\"shifts.traceability.priority\")}: {appliedRule.priority}\n                    </span>\n                  </div>\n                  \n                  {/* Smart Hint */}\n                  <div className=\"mt-3 pt-3 border-t border-emerald-100 dark:border-emerald-800/50\">\n                    <p className=\"text-[9px] text-emerald-700 dark:text-emerald-300 font-medium leading-relaxed flex gap-2\">\n                      <span className=\"shrink-0 text-emerald-500\">💡</span>\n                      <span>\n                        {appliedRule.priority < 100 ? \n                          t(\"shifts.traceability.override_hint\") :\n                          t(\"shifts.traceability.highest_priority_hint\")\n                        }\n                      </span>\n                    </p>\n                  </div>\n                </div>\n              </div>\n            )}\n\n            {/* Overridden Rules Toggle */}\n            {overriddenRules.length > 0 && (\n              <div className=\"space-y-2 pt-2 border-t border-slate-50 dark:border-slate-800\">\n                <button \n                  onClick={() => setShowOverridden(!showOverridden)}\n                  className=\"flex items-center justify-between w-full group\"\n                >\n                  <span className=\"text-[10px] font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400 group-hover:text-slate-600 dark:hover:text-slate-300 dark:text-slate-600 transition-colors\">\n                    {t(\"shifts.traceability.show_overridden\")} ({overriddenRules.length})\n                  </span>\n                  {showOverridden ? <ChevronDown size={14} className=\"text-slate-500 dark:text-slate-400\" /> : <ChevronRight size={14} className=\"text-slate-500 dark:text-slate-400\" />}\n                </button>\n\n                {showOverridden && (\n                  <div className=\"space-y-2 animate-in slide-in-from-top-1 duration-200\">\n                    {overriddenRules.map((rule, idx) => (\n                      <div key={idx} className=\"p-3 bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-xl space-y-1 opacity-70\">\n                        <div className=\"flex items-center gap-2 text-slate-600 dark:text-slate-300\">\n                          <AlertCircle size={14} />\n                          <span className=\"text-xs font-bold\">{rule.rule_name}</span>\n                        </div>\n                        {rule.reason && (\n                          <p className=\"text-[10px] text-slate-500 dark:text-slate-400 leading-relaxed pl-5 italic\">\n                            {rule.reason}\n                          </p>\n                        )}\n                        <div className=\"pt-1 flex items-center gap-3 pl-5\">\n                          <span className=\"text-[9px] font-bold text-slate-500 dark:text-slate-400 uppercase\">\n                            {t(\"shifts.traceability.priority\")}: {rule.priority}\n                          </span>\n                        </div>\n                      </div>\n                    ))}\n                  </div>\n                )}\n              </div>\n            )}\n          </div>\n          <Popover.Arrow className=\"fill-white\" />\n        </Popover.Content>\n      </Popover.Portal>\n    </Popover.Root>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/shifts/ShiftList.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/shifts/ShiftPickerModal.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/shifts/WeeklyRosterGrid.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":28,"column":35,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":28,"endColumn":38,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[594,597],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[594,597],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":42,"column":22,"nod