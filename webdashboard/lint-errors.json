st\";\n\nimport { useReportStream } from \"../use-report-stream\";\n\n/**\n * Tests for the report stream double-buffering fix.\n * After DONE message, chunksRef should be cleared to avoid\n * keeping duplicate data in both ref and state.\n */\ndescribe(\"useReportStream Double-Buffering Fix\", () => {\n    let capturedSocket: any;\n\n    function createMockWebSocket(_url: string) {\n        const socket = {\n            readyState: 0,\n            onopen: null as ((ev: any) => void) | null,\n            onmessage: null as ((ev: any) => void) | null,\n            onerror: null as ((ev: any) => void) | null,\n            onclose: null as ((ev: any) => void) | null,\n            close: vi.fn(),\n        };\n        capturedSocket = socket;\n        setTimeout(() => {\n            socket.readyState = 1;\n            socket.onopen?.({ type: \"open\" });\n        }, 0);\n        return socket;\n    }\n\n    beforeEach(() => {\n        capturedSocket = null;\n        vi.stubGlobal(\"WebSocket\", createMockWebSocket);\n        vi.spyOn(console, \"debug\").mockImplementation(() => { });\n        vi.spyOn(console, \"error\").mockImplementation(() => { });\n    });\n\n    afterEach(() => {\n        vi.unstubAllGlobals();\n        vi.clearAllMocks();\n        localStorage.clear();\n    });\n\n    it(\"should clear chunks ref after DONE to avoid double-buffering\", async () => {\n        const onComplete = vi.fn();\n\n        const { result } = renderHook(() =>\n            useReportStream({\n                jobId: \"test-job\",\n                onComplete,\n            })\n        );\n\n        // Wait for connection\n        await act(async () => {\n            await new Promise((r) => setTimeout(r, 10));\n        });\n\n        // Simulate receiving DONE message\n        await act(async () => {\n            capturedSocket?.onmessage?.({\n                data: JSON.stringify({\n                    type: \"DONE\",\n                    total_batches: 2,\n                    total_records: 100,\n                }),\n            });\n        });\n\n        // onComplete should be called with the final chunks\n        expect(onComplete).toHaveBeenCalledTimes(1);\n\n        // After DONE, status should be completed\n        expect(result.current.status).toBe(\"completed\");\n\n        // The chunks passed to onComplete should be an array (possibly empty\n        // since we didn't send CHUNK messages, but it should not be undefined)\n        const completedChunks = onComplete.mock.calls[0][0];\n        expect(Array.isArray(completedChunks)).toBe(true);\n    });\n\n    it(\"should pass same data to onComplete and state chunks\", async () => {\n        const onComplete = vi.fn();\n\n        const { result } = renderHook(() =>\n            useReportStream({\n                jobId: \"test-job\",\n                onComplete,\n            })\n        );\n\n        // Wait for connection\n        await act(async () => {\n            await new Promise((r) => setTimeout(r, 10));\n        });\n\n        // Simulate DONE\n        await act(async () => {\n            capturedSocket?.onmessage?.({\n                data: JSON.stringify({\n                    type: \"DONE\",\n                    total_batches: 0,\n                    total_records: 0,\n                }),\n            });\n        });\n\n        // Both the state chunks and the onComplete arg should be the same content\n        const completedChunks = onComplete.mock.calls[0][0];\n        expect(result.current.chunks).toEqual(completedChunks);\n    });\n\n    it(\"should handle DONE message with progress set to 100\", async () => {\n        const { result } = renderHook(() =>\n            useReportStream({ jobId: \"test-job\" })\n        );\n\n        await act(async () => {\n            await new Promise((r) => setTimeout(r, 10));\n        });\n\n        await act(async () => {\n            capturedSocket?.onmessage?.({\n                data: JSON.stringify({\n                    type: \"DONE\",\n                    total_batches: 5,\n                    total_records: 500,\n                }),\n            });\n        });\n\n        expect(result.current.progress).toBe(100);\n        expect(result.current.status).toBe(\"completed\");\n    });\n\n    it(\"should not reconnect after DONE\", async () => {\n        const { result } = renderHook(() =>\n            useReportStream({ jobId: \"test-job\", maxRetries: 3 })\n        );\n\n        await act(async () => {\n            await new Promise((r) => setTimeout(r, 10));\n        });\n\n        // Send DONE\n        await act(async () => {\n            capturedSocket?.onmessage?.({\n                data: JSON.stringify({\n                    type: \"DONE\",\n                    total_batches: 1,\n                    total_records: 10,\n                }),\n            });\n        });\n\n        expect(result.current.status).toBe(\"completed\");\n\n        // Simulate connection close after DONE\n\n        await act(async () => {\n            capturedSocket?.onclose?.({ code: 1000, reason: \"Normal\" });\n        });\n\n        // Should NOT reconnect (status should remain completed)\n        expect(result.current.status).toBe(\"completed\");\n    });\n\n    it(\"should handle ERROR message and stop reconnection\", async () => {\n        const onError = vi.fn();\n\n        const { result } = renderHook(() =>\n            useReportStream({\n                jobId: \"test-job\",\n                onError,\n                maxRetries: 3,\n            })\n        );\n\n        await act(async () => {\n            await new Promise((r) => setTimeout(r, 10));\n        });\n\n        // Send ERROR\n        await act(async () => {\n            capturedSocket?.onmessage?.({\n                data: JSON.stringify({\n                    type: \"ERROR\",\n                    message: \"Report generation failed\",\n                    batch_index: null,\n                }),\n            });\n        });\n\n        expect(result.current.status).toBe(\"error\");\n        expect(result.current.error).toBe(\"Report generation failed\");\n        expect(onError).toHaveBeenCalledWith(\"Report generation failed\");\n    });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/hooks/__tests__/use-report-stream.test.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'rerender' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":269,"column":24,"nodeType":"Identifier","messageId":"unusedVar","endLine":269,"endColumn":32},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'rerender' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":388,"column":23,"nodeType":"Identifier","messageId":"unusedVar","endLine":388,"endColumn":31},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'mockOnError' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":470,"column":9,"nodeType":"Identifier","messageId":"unusedVar","endLine":470,"endColumn":20},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'mockOnMessage' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":471,"column":9,"nodeType":"Identifier","messageId":"unusedVar","endLine":471,"endColumn":22},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":678,"column":19,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":678,"endColumn":22,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[21577,21580],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[21577,21580],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":5,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { renderHook, waitFor, act } from \"@testing-library/react\";\nimport { describe, it, expect, beforeEach, afterEach, vi } from \"vitest\";\n\nimport { useReportStream } from \"../use-report-stream\";\n\n/**\n * Unit tests for useReportStream hook\n * Tests core functionality: initialization, state management, and message handling\n */\n\ndescribe(\"useReportStream Hook\", () => {\n  beforeEach(() => {\n    vi.spyOn(console, \"debug\").mockImplementation(() => { });\n    vi.spyOn(console, \"error\").mockImplementation(() => { });\n  });\n\n  afterEach(() => {\n    vi.clearAllMocks();\n  });\n\n  describe(\"Initialization & State\", () => {\n    it(\"should start in idle state with null jobId\", () => {\n      const { result } = renderHook(() => useReportStream({ jobId: null }));\n\n      expect(result.current.status).toBe(\"idle\");\n      expect(result.current.progress).toBe(0);\n      expect(result.current.chunks).toEqual([]);\n      expect(result.current.error).toBeNull();\n    });\n\n    it(\"should have reconnect function available\", () => {\n      const { result } = renderHook(() => useReportStream({ jobId: null }));\n      expect(typeof result.current.reconnect).toBe(\"function\");\n    });\n\n    it(\"should initialize with provided options\", () => {\n      const onComplete = vi.fn();\n      const onError = vi.fn();\n\n      const { result } = renderHook(() =>\n        useReportStream({\n          jobId: null,\n          onComplete,\n          onError,\n          maxRetries: 5,\n        })\n      );\n\n      // Options are stored internally, just verify no errors\n      expect(result.current.status).toBe(\"idle\");\n      expect(typeof result.current.reconnect).toBe(\"function\");\n    });\n  });\n\n  describe(\"State Transitions with jobId Changes\", () => {\n    it(\"should reset state when jobId becomes null\", async () => {\n      const { result, rerender } = renderHook(\n        ({ jobId }: { jobId: string | null }) => useReportStream({ jobId }),\n        { initialProps: { jobId: \"test-job\" as string | null } }\n      );\n\n      // When jobId is set, it will try to connect\n      expect(result.current.status).toMatch(/connecting|error/);\n\n      // Change to null\n      rerender({ jobId: null });\n\n      // Should return to idle\n      expect(result.current.status).toBe(\"idle\");\n      expect(result.current.progress).toBe(0);\n      expect(result.current.chunks).toEqual([]);\n      expect(result.current.error).toBeNull();\n    });\n\n    it(\"should reset chunks and progress on new jobId\", async () => {\n      // Manually set up the state transition without relying on actual WebSocket\n      const { result, rerender } = renderHook(\n        ({ jobId }: { jobId: string | null }) => useReportStream({ jobId }),\n        { initialProps: { jobId: \"job-1\" as string | null } }\n      );\n\n      const initialStatus = result.current.status;\n      expect(initialStatus).toMatch(/connecting|streaming|error/);\n\n      // Change to different job\n      rerender({ jobId: \"job-2\" });\n\n      // Progress and chunks should be reset\n      expect(result.current.progress).toBe(0);\n      expect(result.current.chunks).toEqual([]);\n    });\n  });\n\n  describe(\"Callback Functions\", () => {\n    it(\"should accept onComplete callback\", () => {\n      const onComplete = vi.fn();\n\n      const { result } = renderHook(() =>\n        useReportStream({\n          jobId: null,\n          onComplete,\n        })\n      );\n\n      expect(result.current.status).toBe(\"idle\");\n      // Callback is stored internally\n    });\n\n    it(\"should accept onError callback\", () => {\n      const onError = vi.fn();\n\n      const { result } = renderHook(() =>\n        useReportStream({\n          jobId: null,\n          onError,\n        })\n      );\n\n      expect(result.current.status).toBe(\"idle\");\n      // Callback is stored internally\n    });\n\n    it(\"should allow changing callbacks between renders\", () => {\n      const onComplete1 = vi.fn();\n      const onComplete2 = vi.fn();\n\n      const { rerender } = renderHook(\n        ({ onComplete }) => useReportStream({ jobId: null, onComplete }),\n        { initialProps: { onComplete: onComplete1 } }\n      );\n\n      // Change callback\n      rerender({ onComplete: onComplete2 });\n\n      // Should not error\n      expect(true).toBe(true);\n    });\n  });\n\n  describe(\"Manual Reconnect\", () => {\n    it(\"should provide reconnect function\", () => {\n      const { result } = renderHook(() =>\n        useReportStream({ jobId: \"test-job\" })\n      );\n\n      const reconnect = result.current.reconnect;\n      expect(typeof reconnect).toBe(\"function\");\n\n      // Should not throw when called\n      expect(() => {\n        act(() => {\n          reconnect();\n        });\n      }).not.toThrow();\n    });\n\n    it(\"should reset state when reconnect called\", () => {\n      const { result } = renderHook(() =>\n        useReportStream({ jobId: \"test-job\" })\n      );\n\n      // Call reconnect\n      act(() => {\n        result.current.reconnect();\n      });\n\n      // Should reset state\n      expect(result.current.error).toBeNull();\n      expect(result.current.chunks).toEqual([]);\n      expect(result.current.progress).toBe(0);\n    });\n  });\n\n  describe(\"Progress Calculations\", () => {\n    it(\"should calculate correct progress percentage\", () => {\n      // Test the progress calculation logic independently\n      const testCases = [\n        { batch_index: 0, total_batches: 4, expected: 25 },\n        { batch_index: 1, total_batches: 4, expected: 50 },\n        { batch_index: 2, total_batches: 4, expected: 75 },\n        { batch_index: 3, total_batches: 4, expected: 100 },\n      ];\n\n      for (const testCase of testCases) {\n        const progress = ((testCase.batch_index + 1) / testCase.total_batches) * 100;\n        expect(Math.min(progress, 100)).toBe(testCase.expected);\n      }\n    });\n\n    it(\"should cap progress at 100%\", () => {\n      // Test that capping works\n      const progress = ((150 / 100) * 100); // Would be 150% without capping\n      const cappedProgress = Math.min(progress, 100);\n      expect(cappedProgress).toBe(100);\n    });\n  });\n\n  describe(\"Data Accumulation\", () => {\n    it(\"should accumulate chunks in correct order\", () => {\n      // Test chunk accumulation logic\n      const chunks: unknown[] = [];\n\n      // Simulate receiving chunks\n      const chunkData1 = [{ id: 1 }, { id: 2 }];\n      const chunkData2 = [{ id: 3 }];\n      const chunkData3 = [{ id: 4 }, { id: 5 }, { id: 6 }];\n\n      chunks.push(...chunkData1);\n      chunks.push(...chunkData2);\n      chunks.push(...chunkData3);\n\n      expect(chunks).toHaveLength(6);\n      expect((chunks[0] as { id: number })?.id).toBe(1);\n      expect((chunks[5] as { id: number })?.id).toBe(6);\n    });\n\n    it(\"should handle array and object chunk data\", () => {\n      // Test both array and object data types\n      const chunks: unknown[] = [];\n\n      // Array data\n      chunks.push(...[{ id: 1 }]);\n\n      // Object data wrapped\n      chunks.push({ id: 2 });\n\n      expect(chunks).toHaveLength(2);\n      expect(Array.isArray(chunks)).toBe(true);\n    });\n  });\n\n  describe(\"Error Handling\", () => {\n    it(\"should handle invalid JSON gracefully\", () => {\n      // Test JSON parsing with try-catch\n      const testData = \"{ invalid json }\";\n\n      expect(() => {\n        JSON.parse(testData);\n      }).toThrow();\n\n      // In actual hook, this is caught and logged\n    });\n\n    it(\"should initialize maxRetries option\", () => {\n      const { result } = renderHook(() =>\n        useReportStream({\n          jobId: null,\n          maxRetries: 3,\n        })\n      );\n\n      expect(result.current.status).toBe(\"idle\");\n      // maxRetries is used internally for reconnection logic\n    });\n  });\n\n  describe(\"Cleanup on Unmount\", () => {\n    it(\"should handle unmount gracefully\", () => {\n      const { unmount } = renderHook(() =>\n        useReportStream({ jobId: \"test-job\" })\n      );\n\n      expect(() => {\n        unmount();\n      }).not.toThrow();\n    });\n\n    it(\"should allow remounting after unmount\", () => {\n      const { unmount, rerender } = renderHook(() =>\n        useReportStream({ jobId: \"test-job\" })\n      );\n\n      unmount();\n\n      // Remount should work\n      const { result } = renderHook(() =>\n        useReportStream({ jobId: \"new-job\" })\n      );\n\n      expect(result.current.status).toMatch(/connecting|error/);\n    });\n  });\n\n  describe(\"Config Variations\", () => {\n    it(\"should handle no callbacks provided\", () => {\n      const { result } = renderHook(() =>\n        useReportStream({ jobId: null })\n      );\n\n      expect(result.current.status).toBe(\"idle\");\n    });\n\n    it(\"should handle only onComplete callback\", () => {\n      const { result } = renderHook(() =>\n        useReportStream({\n          jobId: null,\n          onComplete: vi.fn(),\n        })\n      );\n\n      expect(result.current.status).toBe(\"idle\");\n    });\n\n    it(\"should handle only onError callback\", () => {\n      const { result } = renderHook(() =>\n        useReportStream({\n          jobId: null,\n          onError: vi.fn(),\n        })\n      );\n\n      expect(result.current.status).toBe(\"idle\");\n    });\n\n    it(\"should handle custom maxRetries\", () => {\n      const { result } = renderHook(() =>\n        useReportStream({\n          jobId: null,\n          maxRetries: 10,\n        })\n      );\n\n      expect(result.current.status).toBe(\"idle\");\n    });\n  });\n\n  describe(\"WebSocket Auth Token\", () => {\n    let capturedUrl: string | undefined;\n\n    class MockWebSocket {\n      readyState = 0;\n      constructor(url: string) {\n        capturedUrl = url;\n      }\n      close = vi.fn();\n      addEventListener = vi.fn();\n      removeEventListener = vi.fn();\n      set onopen(_: unknown) { }\n      set onmessage(_: unknown) { }\n      set onerror(_: unknown) { }\n      set onclose(_: unknown) { }\n    }\n\n    beforeEach(() => {\n      capturedUrl = undefined;\n      vi.stubGlobal(\"WebSocket\", MockWebSocket);\n    });\n\n    afterEach(() => {\n      vi.unstubAllGlobals();\n      localStorage.clear();\n    });\n\n    it(\"should include auth token in WebSocket URL when available\", () => {\n      localStorage.setItem(\"access_token\", \"test-jwt-token-123\");\n\n      renderHook(() => useReportStream({ jobId: \"job-abc\" }));\n\n      expect(capturedUrl).toContain(\"?token=test-jwt-token-123\");\n      expect(capturedUrl).toContain(\"/api/ws/reports/job-abc\");\n    });\n\n    it(\"should not include token param when no auth token exists\", () => {\n      localStorage.removeItem(\"access_token\");\n\n      renderHook(() => useReportStream({ jobId: \"job-xyz\" }));\n\n      expect(capturedUrl).toContain(\"/api/ws/reports/job-xyz\");\n      expect(capturedUrl).not.toContain(\"?token=\");\n    });\n\n    it(\"should URL-encode special characters in token\", () => {\n      localStorage.setItem(\"access_token\", \"token+with spaces&special=chars\");\n\n      renderHook(() => useReportStream({ jobId: \"job-enc\" }));\n\n      expect(capturedUrl).toContain(\"?token=\");\n      // encodeURIComponent encodes + as %2B and spaces as %20\n      expect(capturedUrl).not.toContain(\" \");\n      expect(capturedUrl).toContain(\"%2B\");\n    });\n  });\n\n  describe(\"StatusRef Stale Closure Fix\", () => {\n    it(\"should not attempt reconnect when status is completed\", () => {\n      // The fix uses statusRef.current instead of captured status.\n      // When status is \"completed\", onclose should NOT retry.\n      const { result, rerender } = renderHook(\n        ({ jobId }