ingCount":0,"source":"import { renderHook, act, waitFor } from \"@testing-library/react\";\nimport { describe, it, expect, vi, beforeEach, afterEach } from \"vitest\";\n\nimport { useVersionCheck } from \"../use-version-check\";\n\ndescribe(\"useVersionCheck\", () => {\n  beforeEach(() => {\n    (globalThis as any).__BUILD_HASH__ = \"abc123\";\n    globalThis.fetch = vi.fn();\n  });\n\n  afterEach(() => {\n    vi.restoreAllMocks();\n  });\n\n  it(\"returns hasNewVersion=false when versions match\", async () => {\n    (globalThis.fetch as any).mockResolvedValue({\n      text: () =>\n        Promise.resolve(\n          '<html><head><meta name=\"build-version\" content=\"abc123\" /></head></html>',\n        ),\n    });\n\n    const { result } = renderHook(() => useVersionCheck());\n\n    await waitFor(() => expect(result.current.hasNewVersion).toBe(false));\n  });\n\n  it(\"sets hasNewVersion=true when build version differs\", async () => {\n    (globalThis.fetch as any).mockResolvedValue({\n      text: () =>\n        Promise.resolve(\n          '<html><head><meta name=\"build-version\" content=\"def456\" /></head></html>',\n        ),\n    });\n\n    const { result } = renderHook(() => useVersionCheck());\n\n    await waitFor(() => expect(result.current.hasNewVersion).toBe(true));\n  });\n\n  it(\"calls dismiss to reset hasNewVersion to false\", async () => {\n    (globalThis.fetch as any).mockResolvedValue({\n      text: () =>\n        Promise.resolve(\n          '<html><head><meta name=\"build-version\" content=\"def456\" /></head></html>',\n        ),\n    });\n\n    const { result } = renderHook(() => useVersionCheck());\n\n    await waitFor(() => expect(result.current.hasNewVersion).toBe(true));\n\n    act(() => result.current.dismiss());\n    expect(result.current.hasNewVersion).toBe(false);\n  });\n\n  it(\"fetches with cache-busting query param\", async () => {\n    const fetchFn = globalThis.fetch as any;\n    fetchFn.mockResolvedValue({\n      text: () =>\n        Promise.resolve(\n          '<html><head><meta name=\"build-version\" content=\"abc123\" /></head></html>',\n        ),\n    });\n\n    renderHook(() => useVersionCheck());\n\n    await waitFor(() => {\n      expect(fetchFn.mock.calls.length).toBeGreaterThan(0);\n    });\n\n    const url = fetchFn.mock.calls[0][0];\n    expect(url).toMatch(/\\/\\?_v=\\d+/);\n  });\n\n  it(\"sends no-cache header\", async () => {\n    const fetchFn = globalThis.fetch as any;\n    fetchFn.mockResolvedValue({\n      text: () =>\n        Promise.resolve(\n          '<html><head><meta name=\"build-version\" content=\"abc123\" /></head></html>',\n        ),\n    });\n\n    renderHook(() => useVersionCheck());\n\n    await waitFor(() => {\n      expect(fetchFn.mock.calls.length).toBeGreaterThan(0);\n    });\n\n    const options = fetchFn.mock.calls[0][1];\n    expect(options.headers).toMatchObject({ \"Cache-Control\": \"no-cache\" });\n  });\n\n  it(\"does not throw on fetch failure\", async () => {\n    (globalThis.fetch as any).mockRejectedValue(new Error(\"network error\"));\n\n    const { result } = renderHook(() => useVersionCheck());\n\n    await waitFor(() => expect(result.current.hasNewVersion).toBe(false));\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/hooks/__tests__/use-websocket.test.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":8,"column":17,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":8,"endColumn":20,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[286,289],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[286,289],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":9,"column":18,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":9,"endColumn":21,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[308,311],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[308,311],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { renderHook, act } from \"@testing-library/react\";\nimport { describe, it, expect, beforeEach, afterEach, vi } from \"vitest\";\n\nimport { useWebSocket } from \"../use-websocket\";\n\ndescribe(\"useWebSocket Hook\", () => {\n  let mockOnOpen: ((ev?: Event) => void) | null;\n  let mockSend: any;\n  let mockClose: any;\n\n  class MockWebSocket {\n    static OPEN = 1;\n    readyState = 1; // WebSocket.OPEN\n    constructor() {}\n    send = vi.fn().mockImplementation((val) => {\n      if (mockSend) mockSend(val);\n    });\n    close = vi.fn().mockImplementation(() => {\n      if (mockClose) mockClose();\n    });\n    set onopen(fn: ((ev?: Event) => void) | null) { mockOnOpen = fn; }\n    set onmessage(_: unknown) { }\n    set onclose(_: unknown) { }\n  }\n\n  beforeEach(() => {\n    mockOnOpen = null;\n    mockSend = vi.fn();\n    mockClose = vi.fn();\n    vi.stubGlobal(\"WebSocket\", MockWebSocket);\n    vi.useFakeTimers();\n  });\n\n  afterEach(() => {\n    vi.useRealTimers();\n    vi.unstubAllGlobals();\n  });\n\n  it(\"should start a 30s ping interval on open\", () => {\n    renderHook(() => useWebSocket());\n\n    act(() => {\n      if (mockOnOpen) mockOnOpen();\n    });\n\n    // The handshake message is sent immediately on open\n    expect(mockSend).toHaveBeenCalledWith(\n      JSON.stringify({ type: \"handshake\", client_type: \"dashboard\" })\n    );\n\n    mockSend.mockClear();\n\n    // Advance time by 30 seconds\n    act(() => {\n      vi.advanceTimersByTime(30000);\n    });\n\n    expect(mockSend).toHaveBeenCalledWith(JSON.stringify({ type: \"ping\" }));\n\n    // Advance by another 30 seconds\n    act(() => {\n      vi.advanceTimersByTime(30000);\n    });\n\n    expect(mockSend).toHaveBeenCalledTimes(2);\n  });\n\n  it(\"should clear ping interval on unmount\", () => {\n    const { unmount } = renderHook(() => useWebSocket());\n\n    act(() => {\n      if (mockOnOpen) mockOnOpen();\n    });\n\n    mockSend.mockClear();\n    unmount();\n\n    // Advance time by 30 seconds after unmount\n    act(() => {\n      vi.advanceTimersByTime(30000);\n    });\n\n    // Should not have sent any pings because interval was cleared\n    expect(mockSend).not.toHaveBeenCalled();\n    expect(mockClose).toHaveBeenCalled();\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/hooks/__tests__/use-workspace.test.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":67,"column":76,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":67,"endColumn":79,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1829,1832],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1829,1832],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":89,"column":73,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":89,"endColumn":76,"suggestions":[{"messageId":"suggestUnknown","fix":{"range