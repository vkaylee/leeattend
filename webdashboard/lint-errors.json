t { workspace } = useWorkspace();\n  \n  const dateFormat = workspace?.date_format || \"DD/MM/YYYY\";\n  const timeFormat = workspace?.time_format || \"24h\";\n\n  // Map backend formats to date-fns tokens\n  // Backend: DD/MM/YYYY, MM/DD/YYYY, YYYY-MM-DD\n  // date-fns: dd/MM/yyyy, MM/dd/yyyy, yyyy-MM-dd\n  const datePattern = dateFormat\n    .replace(\"DD\", \"dd\")\n    .replace(\"YYYY\", \"yyyy\");\n  \n  const timePattern = timeFormat === \"12h\" ? \"hh:mm a\" : \"HH:mm\";\n\n  const formatDate = (date: string | Date | null | undefined) => {\n    if (!date) return \"---\";\n    try {\n      return format(new Date(date), datePattern);\n    } catch (e) {\n      return String(date);\n    }\n  };\n\n  const formatTime = (date: string | Date | null | undefined) => {\n    if (!date) return \"---\";\n    try {\n      // If it's just HH:mm:ss, date-fns format might fail if not a full date\n      // We wrap it in a full date if needed\n      let d = new Date(date);\n      if (isNaN(d.getTime()) && typeof date === 'string' && date.includes(':')) {\n        const [h, m, s] = date.split(':');\n        d = new Date();\n        d.setHours(parseInt(h), parseInt(m), s ? parseInt(s) : 0);\n      }\n      return format(d, timePattern);\n    } catch (e) {\n      return String(date);\n    }\n  };\n\n  const formatTime24h = (date: string | Date | null | undefined) => {\n    if (!date) return \"\";\n    try {\n      let d = new Date(date);\n      if (isNaN(d.getTime()) && typeof date === 'string' && date.includes(':')) {\n        const [h, m, s] = date.split(':');\n        d = new Date();\n        d.setHours(parseInt(h), parseInt(m), s ? parseInt(s) : 0);\n      }\n      return format(d, \"HH:mm\");\n    } catch (e) {\n      return \"\";\n    }\n  };\n\n  const formatDateTime = (date: string | Date | null | undefined) => {\n    if (!date) return \"---\";\n    try {\n      return format(new Date(date), `${datePattern} ${timePattern}`);\n    } catch (e) {\n      return String(date);\n    }\n  };\n\n  const formatMonthYear = (date: string | Date | null | undefined) => {\n    if (!date) return \"---\";\n    try {\n      // Use localized month and year based on datePattern\n      const pattern = datePattern.includes(\"dd/MM\") ? \"MM/yyyy\" : datePattern.includes(\"MM/dd\") ? \"MM/yyyy\" : \"yyyy-MM\";\n      return format(new Date(date), pattern);\n    } catch (e) {\n      return String(date);\n    }\n  };\n\n  return { formatDate, formatTime, formatTime24h, formatDateTime, formatMonthYear };\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/hooks/use-debounce.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/hooks/use-devices.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'DeviceInfo' is defined but never used. Allowed unused vars must match /^_/u.","line":9,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":9,"endColumn":13,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"DeviceInfo"},"fix":{"range":[161,175],"text":""},"desc":"Remove unused variable \"DeviceInfo\"."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useQuery, useMutation, useQueryClient } from \"@tanstack/react-query\";\n\nimport {\n  fetchDevices,\n  createDevice,\n  updateDevice,\n  deleteDevice,\n  Device,\n  DeviceInfo,\n  fetchDeviceInfo,\n} from \"@/lib/api\";\n\nexport const devicesKeys = {\n  all: [\"devices\"] as const,\n  info: (id: string) => [\"devices\", id, \"info\"] as const,\n};\n\nexport function useDevices() {\n  const queryClient = useQueryClient();\n\n  const devicesQuery = useQuery({\n    queryKey: devicesKeys.all,\n    queryFn: fetchDevices,\n  });\n\n  const createMutation = useMutation({\n    mutationFn: createDevice,\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: devicesKeys.all });\n      queryClient.invalidateQueries({ queryKey: [\"agents-status\"] });\n    },\n  });\n\n  const updateMutation = useMutation({\n    mutationFn: ({ id, data }: { id: string; data: Partial<Device> }) =>\n      updateDevice(id, data),\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: devicesKeys.all });\n      queryClient.invalidateQueries({ queryKey: [\"agents-status\"] });\n    },\n  });\n\n  const deleteMutation = useMutation({\n    mutationFn: deleteDevice,\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: devicesKeys.all });\n      queryClient.invalidateQueries({ queryKey: [\"agents-status\"] });\n    },\n  });\n\n  return {\n    devices: devicesQuery.data ?? [],\n    isLoading: devicesQuery.isLoading,\n    error: devicesQuery.error,\n    refetch: devicesQuery.refetch,\n\n    createDevice: createMutation.mutateAsync,\n    updateDevice: (id: string, data: Partial<Device>) =>\n      updateMutation.mutateAsync({ id, data }),\n    deleteDevice: deleteMutation.mutateAsync,\n\n    isCreating: createMutation.isPending,\n    isUpdating: updateMutation.isPending,\n    isDeleting: deleteMutation.isPending,\n  };\n}\n\nexport function useDeviceInfo(id: string, enabled: boolean = true) {\n  return useQuery({\n    queryKey: devicesKeys.info(id),\n    queryFn: () => fetchDeviceInfo(id),\n    enabled: !!id && enabled,\n    staleTime: 60000 * 30, // Cache for 30 minutes\n    refetchOnWindowFocus: false, // Don't refetch on window focus to avoid noise\n  });\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/hooks/use-ess.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'wsId' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":197,"column":9,"nodeType":"Identifier","messageId":"unusedVar","endLine":197,"endColumn":13}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * Employee Self-Service (ESS) React Hooks\n * Provides data fetching and mutations for ESS features\n */\n\nimport { useMemo } from \"react\";\n\nimport { useQuery, useMutation, useQueryClient } from \"@tanstack/react-query\";\n\nimport {\n  fetchMyProfile,\n  updateMyProfile,\n  fetchMyEmergencyContacts,\n  addEmergencyContact,\n  deleteEmergencyContact,\n  fetchMyDocuments,\n  fetchMyPayslips,\n  fetchMyAttendance,\n  fetchEssLeaveBalances,\n  fetchEssLeaveRequests,\n  fetchMyTimeEntries,\n  punchInMySelf,\n  punchOutMySelf,\n  getCurrentWorkspaceId,\n  UpdateProfileRequest,\n  CreateEmergencyContactRequest,\n  AttendanceParams, fetchMyAttendanceSummaries, submitMyOtClaim \n} from \"@/lib/api\";\n\n// Query Keys\nexport const essKeys = {\n  all: [\"ess\"] as const,\n  profile: () => [...essKeys.all, \"profile\"] as const,\n  emergencyContacts: () => [...essKeys.all, \"emergency-contacts\"] as const,\n  documents: () => [...essKeys.all, \"documents\"] as const,\n  payslips: () => [...essKeys.all, \"payslips\"] as const,\n  attendance: (params?: AttendanceParams) =>\n    [...essKeys.all, \"attendance\", params] as const,\n  clockEntries: () => [...essKeys.all, \"clock-entries\"] as const,\n  leaveBalances: () => [...essKeys.all, \"leave-balances\"] as const,\n  leaveRequests: () => [...essKeys.all, \"leave-requests\"] as const,\n};\n\n// --- Profile Hook ---\n\nexport function useMyProfile() {\n  const queryClient = useQueryClient();\n\n  const profileQuery = useQuery({\n    queryKey: essKeys.profile(),\n    queryFn: fetchMyProfile,\n  });\n\n  const updateMutation = useMutation({\n    mutationFn: (data: UpdateProfileRequest) => updateMyProfile(data),\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: essKeys.profile() });\n    },\n  });\n\n  return {\n    data: profileQuery.data,\n    employee: profileQuery.data?.employee,\n    profile: profileQuery.data?.profile,\n    emergencyContacts: profileQuery.data?.emergency_contacts || [],\n    isLoading: profileQuery.isLoading,\n    isError: profileQuery.isError,\n    error: profileQuery.error,\n    refetch: profileQuery.refetch,\n\n    updateProfile: updateMutation.mutateAsync,\n    isUpdating: updateMutation.isPending,\n  };\n}\n\n// --- Emergency Contacts Hook ---\n\nexport function useEmergencyContacts() {\n  const queryClient = useQueryClient();\n\n  const contactsQuery = useQuery({\n    queryKey: essKeys.emergencyContacts(),\n    queryFn: fetchMyEmergencyContacts,\n  });\n\n  const addMutation = useMutation({\n    mutationFn: (data: CreateEmergencyContactRequest) =>\n      addEmergencyContact(data),\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: essKeys.emergencyContacts() });\n      queryClient.invalidateQueries({ queryKey: essKeys.profile() });\n    },\n  });\n\n  const deleteMutation = useMutation({\n    mutationFn: (contactId: string) => deleteEmergencyContact(contactId),\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: essKeys.emergencyContacts() });\n      queryClient.invalidateQueries({ queryKey: essKeys.profile() });\n    },\n  });\n\n  return {\n    contacts: contactsQuery.data || [],\n    isLoading: contactsQuery.isLoading,\n    isError: contactsQuery.isError,\n    error: contactsQuery.error,\n    refetch: contactsQuery.refetch,\n\n    addContact: addMutation.mutateAsync,\n    isAdding: addMutation.isPending,\n\n    deleteContact: deleteMutation.mutateAsync,\n    isDeleting: deleteMutation.isPending,\n  };\n}\n\n// --- Documents Hook ---\n\nexport function useMyDocuments() {\n  const documentsQuery = useQuery({\n    queryKey: essKeys.documents(),\n    queryFn: fetchMyDocuments,\n  });\n\n  return {\n    documents: documentsQuery.data || [],\n    isLoading: documentsQuery.isLoading,\n    isError: documentsQuery.isError,\n    error: documentsQuery.error,\n    refetch: documentsQuery.refetch,\n  };\n}\n\n// --- Payslips Hook ---\n\nexport function useMyPayslips() {\n  const payslipsQuery = useQuery({\n    queryKey: essKeys.payslips(),\n    queryFn: fetchMyPayslips,\n  });\n\n  return {\n    payslips: payslipsQuery.data || [],\n    isLoading: payslipsQuery.isLoading,\n    isError: payslipsQuery.isError,\n    error: payslipsQuery.error,\n    refetch: payslipsQuery.refetch,\n  };\n}\n\n// --- Attendance Hook ---\n\nexport function useMyAttendance(params?: AttendanceParams) {\n  const attendanceQuery = useQuery({\n    queryKey: essKeys.attendance(params),\n    queryFn: () => fetchMyAttendance(params),\n  });\n\n  return {\n    entries: attendanceQuery.data || [],\n    isLoading: attendanceQuery.isLoading,\n    isError: attendanceQuery.isError,\n    error: attendanceQuery.error,\n    refetch: attendanceQuery.refetch,\n  };\n}\n\n// --- Leave Hook ---\n\nexport function useMyLeave() {\n  const balancesQuery = useQuery({\n    queryKey: essKeys.leaveBalances(),\n    queryFn: fetchEssLeaveBalances,\n  });\n\n  const requestsQuery = useQuery({\n    queryKey: essKeys.leaveRequests(),\n    queryFn: fetchEssLeaveRequests,\n  });\n\n  return {\n    balances: balancesQuery.data || [],\n    requests: requestsQuery.data || [],\n    isLoading: balancesQuery.isLoading || requestsQuery.isLoading,\n    isError: balancesQuery.isError || requestsQuery.isError,\n    error: balancesQuery.error || requestsQuery.error,\n    refetchBalances: balancesQuery.refetch,\n    refetchRequests: requestsQuery.refetch,\n  };\n}\n\n// --- Clock Hook ---\n\nexport function useMyClock() {\n  const queryClient = useQueryClient();\n  const wsId = getCurrentWorkspaceId();\n\n  // Fetch current user's time entries (today + 7 days)\n  const { startDate, endDate } = useMemo(() => {\n    const now = new Date();\n    const endDate = now.toISOString();\n    const startDate = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000).toISOString();\n    return { startDate, endDate };\n  }, []);\n\n  const entriesQuery = useQuery({\n    queryKey: essKeys.clockEntries(),\n    queryFn: () => fetchMyTimeEntries({ start_date: startDate, end_date: endDate }),\n    refetchInterval: 30000, // Refresh every 30s for real-time status\n  });\n\n  const activeEntry = entriesQuery.data?.find((e) => !e.punch_out_time);\n  const isOnBreak = activeEntry?.entry_type === \"break\";\n\n  const punchInMutation = useMutation({\n    mutationFn: (data: { entry_type: \"work\" | \"break\"; note?: string }) =>\n      punchInMySelf(data),\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: essKeys.clockEntries() });\n      queryClient.invalidateQueries({ queryKey: essKeys.attendance() });\n    },\n  });\n\n  const punchOutMutation = useMutation({\n    mutationFn: (data?: { note?: string }) => punchOutMySelf(data),\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: essKeys.clockEntries() });\n      queryClient.invalidateQueries({ queryKey: essKeys.attendance() });\n    },\n  });\n\n  return {\n    entries: entriesQuery.data || [],\n    activeEntry,\n    isOnBreak,\n    isLoading: entriesQuery.isLoading,\n    isError: entriesQuery.isError,\n    error: entriesQuery.error,\n    refetch: entriesQuery.refetch,\n\n    punchIn: punchInMutation.mutateAsync,\n    punchOut: punchOutMutation.mutateAsync,\n    isPunching: punchInMutation.isPending || punchOutMutation.isPending,\n  };\n}\n\n// --- OT Hooks ---\n\n\nexport function useMyAttendanceSummaries(start: string, end: string) {\n  const query = useQuery({\n    queryKey: [...essKeys.all, \"summaries\", start, end],\n    queryFn: () => fetchMyAttendanceSummaries(start, end),\n  });\n\n  return {\n    summaries: query.data || [],\n    isLoading: query.isLoading,\n    isError: query.isError,\n    error: query.error,\n    refetch: query.refetch,\n  };\n}\n\nexport function useSubmitOtClaim() {\n  const queryClient = useQueryClient();\n\n  const mutation = useMutation({\n    mutationFn: (data: { date: string; minutes: number; reason: string }) =>\n      submitMyOtClaim(data.date, data.minutes, data.reason),\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: [...essKeys.all, \"summaries\"] });\n    },\n  });\n\n  return {\n    submitClaim: mutation.mutateAsync,\n    isSubmitting: mutation.isPending,\n  };\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/hooks/use-i18n-sync.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/hooks/use-infinite-scroll.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/hooks/use-keyboard-list-nav.ts","messages":[],"suppressedMessages":[{"ruleId":"react-hooks/exhaustive-deps","severity":2,"message":"React Hook useEffect has a spread element in its dependency array. This means we can't statically verify whether you've passed the correct dependencies.","line":44,"column":16,"nodeType":"SpreadElement","endLine":44,"endColumn":28,"suppressions":[{"kind":"directive","justification":""}]}],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/hooks/use-language.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/hooks/use-monitor-charts.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/hooks/use-monitor-stream.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningC