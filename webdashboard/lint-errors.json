\"bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-300 border-emerald-100\",\n};\n\nexport default function MemberTable() {\n  const { t } = useTranslation();\n  const { confirm, ConfirmationDialog } = useConfirm();\n  const { members, isLoading: membersLoading, removeMember } = useWorkspaceMembers();\n  const { roles, isLoading: rolesLoading } = useWorkspaceRoles();\n  const isLoading = membersLoading || rolesLoading;\n  const [selectedUserId, setSelectedUserId] = useState<string | null>(null);\n  const [isRoleModalOpen, setIsRoleModalOpen] = useState(false);\n  const [isPermModalOpen, setIsPermModalOpen] = useState(false);\n\n  const handleManageRoles = (userId: string) => { setSelectedUserId(userId); setIsRoleModalOpen(true); };\n  const handleManagePermissions = (userId: string) => { setSelectedUserId(userId); setIsPermModalOpen(true); };\n  const handleRemoveMember = async (userId: string) => { \n    const isConfirmed = await confirm({ title: t('common.warning', { defaultValue: 'Warning' }), message: t(\"members.table.confirm_remove\"), variant: 'danger' });\n    if (!isConfirmed) return; \n    try { await removeMember(userId); } catch (e: any) { console.error(e); } \n  };\n\n  if (isLoading) return <div className=\"flex justify-center py-32\"><div className=\"animate-spin rounded-full h-12 w-12 border-4 border-primary-600 border-t-transparent shadow-xl\"></div></div>;\n\n  return (\n    <>\n      <div className=\"bg-white dark:bg-slate-900 rounded-[3rem] border border-slate-100 dark:border-slate-800 shadow-sm overflow-hidden animate-in fade-in duration-700\">\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left border-collapse\">\n            <thead>\n              <tr className=\"bg-slate-50 dark:bg-slate-800/50 border-b border-slate-100 dark:border-slate-800\">\n                <th className=\"px-10 py-6 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em]\">{t(\"common.user\")}</th>\n                <th className=\"px-8 py-6 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em]\">{t(\"common.role\")}</th>\n                <th className=\"px-10 py-6 border-b border-slate-100 dark:border-slate-800\"></th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-50 dark:divide-slate-800\">\n              {members.map((member) => (\n                <tr key={member.user_id} className=\"group hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-all\">\n                  <td className=\"px-10 py-6\">\n                    <div className=\"flex items-center gap-5\">\n                      <div className=\"w-14 h-14 rounded-2xl bg-primary-50 dark:bg-primary-950 flex items-center justify-center text-primary-600 dark:text-primary-400 font-bold shadow-inner border border-primary-100 dark:border-primary-800/50 overflow-hidden group-hover:scale-110 transition-transform\">\n                        {member.avatar_url ? (\n                          <img src={member.avatar_url} alt=\"Member avatar\" className=\"w-full h-full object-cover\" />\n                        ) : (\n                          <span className=\"text-lg uppercase\">{(member.full_name || member.email).substring(0, 2)}</span>\n                        )}\n                      </div>\n                      <div>\n                        <div className=\"font-bold text-slate-700 dark:text-slate-200 text-sm tracking-tight uppercase leading-none mb-1.5\">{member.full_name || t(\"common.no_name\")}</div>\n                        <div className=\"text-[10px] text-slate-500 dark:text-slate-400 font-mono font-bold flex items-center gap-2 opacity-70\">\n                          <Mail size={12} className=\"text-primary-400\" /> {member.email}\n                        </div>\n                      </div>\n                    </div>\n                  </td>\n                  <td className=\"px-8 py-6\">\n                    <div className=\"flex flex-wrap items-center gap-2\">\n                      {(() => {\n                        const primaryRole = roles.find(r => r.id === member.role_id);\n                        if (!primaryRole) return <span className=\"text-xs text-slate-400\">Loading...</span>;\n                        \n                        const extraRoles = (member.extra_role_ids || [])\n                          .map(id => roles.find(r => r.id === id))\n                          .filter(Boolean) as WorkspaceRole[];\n\n                        return (\n                          <>\n                            <span className={cn(\n                              \"inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest border shadow-sm\",\n                              roleColorMap[primaryRole.color] || roleColorMap.slate\n                            )}>\n                              {primaryRole.is_system && primaryRole.name.toLowerCase() === \"owner\" && <Shield size={10} />}\n                              {primaryRole.name}\n                            </span>\n                            \n                            {extraRoles.length > 0 && (\n                              <div className=\"relative group/badge\">\n                                <span className=\"inline-flex items-center justify-center min-w-[28px] h-[26px] px-1.5 rounded-full text-[10px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 cursor-help transition-colors group-hover/badge:bg-indigo-50 group-hover/badge:text-indigo-600 group-hover/badge:border-indigo-200 dark:group-hover/badge:bg-indigo-900/50 dark:group-hover/badge:border-indigo-800\">\n                                  +{extraRoles.length}\n                                </span>\n                                \n                                {/* Premium Popover for extra roles */}\n                                <div className=\"absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-max max-w-[200px] opacity-0 invisible group-hover/badge:opacity-100 group-hover/badge:visible transition-all duration-300 ease-out translate-y-2 group-hover/badge:translate-y-0 z-10\">\n                                  <div className=\"p-3 bg-white/90 dark:bg-slate-900/90 backdrop-blur-xl rounded-2xl shadow-xl shadow-slate-200/50 dark:shadow-black/40 border border-slate-100 dark:border-slate-800 flex flex-col gap-2\">\n                                    <span className=\"text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest pb-1 border-b border-slate-100 dark:border-slate-800\">Extra Roles</span>\n                                    {extraRoles.map(er => (\n                                      <span key={er.id} className={cn(\n                                        \"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[9px] font-bold uppercase tracking-widest border\",\n                                        roleColorMap[er.color] || roleColorMap.slate\n                                      )}>\n                                        {er.name}\n                                      </span>\n                                    ))}\n                                  </div>\n                                </div>\n                              </div>\n                            )}\n                          </>\n                        );\n                      })()}\n                    </div>\n                  </td>\n                  <td className=\"px-10 py-6 text-right\">\n                    <div className=\"flex items-center justify-end gap-3 opacity-0 group-hover:opacity-100 transition-all duration-300 translate-x-2 group-hover:translate-x-0\">\n                      <PermissionGate permission=\"members:roles:manage\">\n                        <button onClick={() => handleManageRoles(member.user_id)} className=\"p-3 bg-white dark:bg-slate-900 text-slate-500 dark:text-slate-400 hover:text-primary-600 dark:text-primary-400 rounded-xl shadow-md border border-slate-100 dark:border-slate-800 transition-all active:scale-90\" title={t(\"members.table.manage_roles\")}><UserCog size={20} /></button>\n                      </PermissionGate>\n                      <PermissionGate permission=\"members:roles:manage\">\n                        <button onClick={() => handleManagePermissions(member.user_id)} className=\"p-3 bg-white dark:bg-slate-900 text-slate-500 dark:text-slate-400 hover:text-amber-600 dark:text-amber-400 rounded-xl shadow-md border border-slate-100 dark:border-slate-800 transition-all active:scale-90\" title={t(\"members.table.manage_permissions\", { defaultValue: \"Manage Permissions\" })}><KeyRound size={20} /></button>\n                      </PermissionGate>\n                      {roles.find(r => r.id === member.role_id)?.name.toLowerCase() !== \"owner\" && (\n                        <PermissionGate permission=\"members:remove\">\n                          <button onClick={() => handleRemoveMember(member.user_id)} className=\"p-3 bg-white dark:bg-slate-900 text-slate-500 dark:text-slate-400 hover:text-rose-600 dark:text-rose-300 rounded-xl shadow-md border border-slate-100 dark:border-slate-800 transition-all active:scale-90\" title={t(\"members.table.remove_member\")}><Trash2 size={20} /></button>\n                        </PermissionGate>\n                      )}\n                    </div>\n                  </td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n\n          {members.length === 0 && (\n            <div className=\"py-32 text-center bg-slate-50 dark:bg-slate-800/30 flex flex-col items-center\">\n              <UserIcon className=\"w-20 h-20 mb-6 text-slate-200 dark:text-slate-700\" />\n              <p className=\"text-[10px] font-bold text-slate-300 dark:text-slate-600 uppercase tracking-[0.25em]\">{t(\"members.table.messages.no_members\")}</p>\n            </div>\n          )}\n        </div>\n      </div>\n\n      {selectedUserId && (\n        <>\n          <RoleManagementModal isOpen={isRoleModalOpen} onClose={() => setIsRoleModalOpen(false)} userId={selectedUserId} />\n          <PermissionManagementModal isOpen={isPermModalOpen} onClose={() => setIsPermModalOpen(false)} userId={selectedUserId} />\n        </>\n      )}\n      <ConfirmationDialog />\n    </>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/payroll/AdjustmentDrawer.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Clock' is defined but never used. Allowed unused vars must match /^_/u.","line":4,"column":37,"nodeType":"Identifier","messageId":"unusedVar","endLine":4,"endColumn":42,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Clock"},"fix":{"range":[141,148],"text":""},"desc":"Remove unused variable \"Clock\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'X' is defined but never used. Allowed unused vars must match /^_/u.","line":4,"column":44,"nodeType":"Identifier","messageId":"unusedVar","endLine":4,"endColumn":45,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"X"},"fix":{"range":[148,151],"text":""},"desc":"Remove unused variable \"X\"."}]}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from \"react\";\n\nimport { useQuery, useMutation, useQueryClient } from \"@tanstack/react-query\";\nimport { ArrowRight, MessageSquare, Clock, X, Calendar, CheckCircle2 } from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { useDateTimeFormatter } from \"@/hooks/use-datetime\";\nimport { fetchWorkspaceAttendanceAdjustments, approveAttendanceAdjustment, getCurrentWorkspaceId } from \"@/lib/api\";\n\nimport Sheet from \"../ui/Sheet\";\nimport { useToast } from \"../ui/Toast\";\n\n\ninterface AdjustmentDrawerProps {\n  isOpen: boolean;\n  onClose: () => void;\n  employeeId: string;\n  employeeName: string;\n  onAdjustmentResolved?: () => void;\n}\n\nexport default function AdjustmentDrawer({\n  isOpen,\n  onClose,\n  employeeId,\n  employeeName,\n  onAdjustmentResolved\n}: AdjustmentDrawerProps) {\n  const { t } = useTranslation();\n  const wsId = getCurrentWorkspaceId() || \"\";\n  const queryClient = useQueryClient();\n  const toast = useToast();\n  const { formatDate, formatTime } = useDateTimeFormatter();\n\n  const { data: adjustments = [], isLoading } = useQuery({\n    queryKey: [\"adjustments\", wsId, \"pending\"],\n    queryFn: () => fetchWorkspaceAttendanceAdjustments(wsId, \"pending\"),\n    enabled: isOpen && !!wsId,\n  });\n\n  const employeeAdjustments = adjustments.filter(adj => adj.employee_id === employeeId);\n\n  const resolveMutation = useMutation({\n    mutationFn: (data: { id: string; status: \"approved\" | \"rejected\" }) => \n      approveAttendanceAdjustment(wsId, data.id, { status: data.status }),\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: [\"adjustments\"] });\n      toast.success(t(\"common.success\"));\n      if (onAdjustmentResolved) onAdjustmentResolved();\n    },\n  });\n\n  return (\n    <Sheet\n      isOpen={isOpen}\n      onClose={onClose}\n      title={t(\"payroll.adjustments.title\")}\n      subtitle={`${employeeName} • ${employeeAdjustments.length} Pending`}\n    >\n      <div className=\"space-y-6 pt-4 animate-in fade-in duration-500\">\n        {isLoading ? (\n          <div className=\"p-12 text-center text-slate-500 dark:text-slate-400 font-bold italic uppercase tracking-widest text-[10px] opacity-50\">{t(\"common.loading\")}</div>\n        ) : employeeAdjustments.length === 0 ? (\n          <div className=\"p-16 text-center border-2 border-dashed border-slate-100 dark:border-slate-800 rounded-[2.5rem] bg-slate-50 dark:bg-slate-800/30 flex flex-col items-center\">\n            <div className=\"bg-white dark:bg-slate-900 w-16 h-16 rounded-3xl flex items-center justify-center shadow-sm mb-4 border border-slate-100 dark:border-slate-800\"><CheckCircle2 className=\"w-8 h-8 text-emerald-400\" /></div>\n            <h3 className=\"text-lg font-bold text-slate-700 dark:text-slate-200 uppercase tracking-tight\">{t(\"payroll.adjustments.all_clear\")}</h3>\n            <p className=\"text-slate-500 dark:text-slate-400 text-[10px] font-bold uppercase tracking-widest mt-1 opacity-50\">No pending adjustments.</p>\n          </div>\n        ) : (\n          employeeAdjustments.map((adj) => (\n            <div key={adj.id} data-testid=\"adjustment-item\" className=\"bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-[2rem] p-6 shadow-sm hover:shadow-xl hover:shadow-primary-100/10 transition-all group relative overflow-hidden\">\n              <div className=\"flex items-start justify-between mb-6\">\n                <div className=\"flex items-center gap-3\">\n                  <div className=\"w-8 h-8 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 flex items-center justify-center text-slate-500 dark:text-slate-400 shadow-inner group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors\"><Calendar size={14} /></div>\n                  <div>\n                    <p className=\"text-[9px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.2em] leading-none mb-1\">Requested Date</p>\n                    <p className=\"text-xs font-bold text-slate-700 dark:text-slate-200 uppercase tracking-tight\">{formatDate(adj.requested_punch_in_time)}</p>\n                  </div>\n                </div>\n                <span className=\"bg-amber-50 dark:bg-amber-950 text-amber-600 dark:text-amber-300 px-3 py-1 rounded-full text-[9px] font-bold uppercase tracking-widest border border-amber-100 dark:border-amber-800 shadow-sm animate-pulse\">Pending</span>\n              </div>\n\n              <div className=\"flex items-center gap-4 mb-6\">\n                <div className=\"flex-1 bg-slate-50 dark:bg-slate-800/50 p-4 rounded-2xl text-center border border-slate-100 dark:border-slate-800 shadow-inner group-hover:bg-white dark:hover:bg-slate-900 transition-colors\">\n                  <p className=\"text-[8px] text-slate-500 dark:text-slate-400 font-bold uppercase tracking-widest mb-1.5 opacity-70\">Punch In</p>\n                  <p className=\"text-sm font-bold text-slate-700 dark:text-slate-200 font-mono tracking-tighter\">{formatTime(adj.requested_punch_in_time)}</p>\n                </div>\n                <div className=\"w-8 h-8 rounded-full bg-slate-100 dark:bg-slate-700 flex items-center justify-center shadow-inner\"><ArrowRight size={14} className=\"text-slate-300 dark:text-slate-600\" /></div>\n                <div className=\"flex-1 bg-slate-50 dark:bg-slate-800/50 p-4 rounded-2xl text-center border border-slate-100 dark:border-slate-800 shadow-inner group-hover:bg-white dark:hover:bg-slate-900 transition-colors\">\n                  <p className=\"text-[8px] text-slate-500 dark:text-slate-400 font-bold uppercase tracking-widest mb-1.5 opacity-70\">Punch Out</p>\n                  <p className=\"text-sm font-bold text-slate-700 dark:text-slate-200 font-mono tracking-tighter\">\n                    {adj.requested_punch_out_time ? formatTime(adj.requested_punch_out_time) : \"--:--\"}\n                  </p>\n                </div>\n              </div>\n\n              {adj.reason && (\n                <div className=\"bg-slate-50 dark:bg-slate-800 p-4 rounded-xl mb-6 border border-slate-100 dark:border-slate-800 shadow-inner\" data-testid=\"adjustment-reason\">\n                  <div className=\"flex gap-2 items-start\"><MessageSquare size={12} className=\"text-slate-300 dark:text-slate-600 mt-0.5 shrink-0\" /><p className=\"text-[10px] text-slate-500 dark:text-slate-400 font-bold uppercase tracking-tight leading-relaxed italic\">\"{adj.reason}\"</p></div>\n                </div>\n              )}\n\n              <div className=\"grid grid-cols-2 gap-4\">\n                <button data-testid=\"reject-adjustment-btn\" onClick={() => resolveMutation.mutate({ id: adj.id, status: \"rejected\" })} disabled={resolveMutation.isPending} className=\"py-3 rounded-xl text-[10px] font-bold uppercase tracking-widest text-rose-600 dark:text-rose-300 bg-rose-50 dark:bg-rose-950 border border-rose-100 dark:border-rose-800 hover:bg-rose-100 dark:bg-rose-900 transition-all active:scale-95 shadow-sm\">Reject</button>\n                <button data-testid=\"approve-adjustment-btn\" onClick={() => resolveMutation.mutate({ id: adj.id, status: \"approved\" })} disabled={resolveMutation.isPending} className=\"py-3 rounded-xl text-[10px] font-bold uppercase tracking-widest text-emerald-600 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950 border border-emerald-100 dark:border-emerald-800 hover:bg-emerald-100 dark:bg-emerald-900 transition-all active:scale-95 shadow-sm\">Approve</button>\n              </div>\n            </div>\n          ))\n        )}\n      </div>\n    </Sheet>\n  );\n}","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/payroll/AssignOvertimePolicyModal.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":60,"column":24,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":60,"endColumn":27,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1827,1830],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1827,1830],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":66,"column":22,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":66,"endColumn":25,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[2062,2065],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[2062,2065],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":107,"column":47,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":107,"endColumn":50,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[3652,3655],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[3652,3655],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":159,"column":41,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":159,"endColumn":44,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[6041,6044],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[6041,6044],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":4,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from 'react';\n\nimport { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';\nimport { \n  Calendar, \n  ShieldCheck,\n  Building2,\n  User,\n  Save,\n  Clock\n} from 'lucide-react';\nimport { useTranslation } from 'react-i18next';\n\nimport { EmployeeSearch } from '@/components/common/EmployeeSearch';\nimport { Combobox } from '@/components/ui/Combobox';\nimport Modal from '@/components/ui/Modal';\nimport { useToast } from '@/components/ui/Toast';\n\nimport { fetchDepartments } from '@/lib/api/departments';\nimport { fetchOvertimePolicies, assignOvertimePolicy } from '@/lib/api/payroll';\nimport { cn } from '@/lib/utils';\n\ninterface AssignOvertimePolicyModalProps {\n  wsId: string;\n  isOpen: boolean;\n  onClose: () => void;\n  initialType?: 'employee' | 'department' | 'workspace';\n  initialId?: string;\n}\n\nexport default function AssignOvertimePolicyModal({ \n  wsId, \n  isOpen, \n  onClose,\n  initialType = 'employee',\n  initialId = ''\n}: AssignOvertimePolicyModalProps) {\n  const { t } = useTranslation();\n  const queryClient = useQueryClient();\n  const toast = useToast();\n\n  const [selectedType, setSelectedType] = useState<'employee' | 'department' | 'workspace'>(initialType);\n  const [targetId, setTargetId] = useState(initialId);\n  const [policyId, setPolicyId] = useState('');\n  const [effectiveFrom, setEffectiveFrom] = useState(new Date().toISOString().split('T')[0]);\n\n  const { data: policies = [] } = useQuery({\n    queryKey: ['overtime-policies', wsId],\n    queryFn: () => fetchOvertimePolicies(wsId),\n    enabled: isOpen\n  });\n\n  const { data: departments = [] } = useQuery({\n    queryKey: ['departments', wsId],\n    queryFn: () => fetchDepartments(wsId),\n    enabled: isOpen && selectedType === 'department'\n  });\n\n  const assignMutation = useMutation({\n    mutationFn: (data: any) => assignOvertimePolicy(wsId, data),\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: ['overtime-policy-assignment'] });\n      toast.success(t('common.success'));\n      onClose();\n    },\n    onError: (error: any) => {\n      toast.error(error.message || t('common.error'));\n    }\n  });\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (selectedType !== 'workspace' && !targetId) {\n      toast.error(t('common.error'));\n      return;\n    }\n    if (!policyId) {\n      toast.error(t('common.error'));\n      return;\n    }\n\n    assignMutation.mutate({\n      assignee_type: selectedType,\n      assignee_id: selectedType === 'workspace' ? null : targetId,\n      policy_id: policyId,\n      effective_from: effectiveFrom\n    });\n  };\n\n  return (\n    <Modal isOpen={isOpen} onClose={onClose} title={t('payroll.assign_overtime_policy')}>\n      <form onSubmit={handleSubmit} className='space-y-6'>\n        <div className='grid grid-cols-1 gap-6'>\n          <div className='space-y-2'>\n            <label className='text-[10px] font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400 ml-1'>{t('payroll.assignee_type')}</label>\n            <div className='flex bg-slate-100 dark:bg-slate-700 p-1 rounded-2xl'>\n              {[\n                { id: 'employee', label: t('common.employee'), icon: <User size={12}/> },\n                { id: 'department', label: t('common.department'), icon: <Building2 size={12}/> },\n                { id: 'workspace', label: t('common.global'), icon: <ShieldCheck size={12}/> }\n              ].map(opt => (\n                <button\n                  key={opt.id}\n                  type='button'\n                  data-testid={`assignee-type-${opt.id}`}\n                  onClick={() => {\n                    setSelectedType(opt.id as any);\n                    setTargetId('');\n                  }}\n                  className={cn(\n                    'flex-1 flex items-center justify-center gap-2 py-2 rounded-xl text-xs font-bold transition-all',\n                    selectedType === opt.id ? 'bg-white dark:bg-slate-900 text-primary-600 dark:text-primary-400 shadow-sm' : 'text-slate-500 dark:text-slate-400'\n                  )}\n                >\n                  {opt.icon} {opt.label}\n                </button>\n              ))}\n            </div>\n          </div>\n\n          {selectedType === 'employee' && (\n            <div className='space-y-2'>\n              <label className='text-[10px] font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400 ml-1'>{t('common.select_employee')}</label>\n              <EmployeeSearch \n                workspaceId={wsId}\n                value={targetId}\n                onChange={setTargetId}\n                placeholder={t('common.select_employee')}\n                className='bg-slate-50 dark:bg-slate-800 border-slate-100 dark:border-slate-800 h-14'\n                data-testid='assign-employee-search'\n              />\n            </div>\n          )}\n\n          {selectedType === 'department' && (\n            <div className='space-y-2'>\n              <label className='text-[10px] font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400 ml-1'>{t('common.select_department')}</label>\n              <Combobox \n                id='dept-select'\n                data-testid='assign-dept-select'\n                options={departments.map(d => ({\n                  value: d.id,\n                  label: d.name,\n                  icon: <Building2 size={14} className='text-slate-500 dark:text-slate-400' />\n                }))}\n                value={targetId}\n                onChange={setTargetId}\n                placeholder={t('common.select_department')}\n                className='bg-slate-50 dark:bg-slate-800 border-slate-100 dark:border-slate-800 h-14'\n              />\n            </div>\n          )}\n\n          <div className='space-y-2'>\n            <label className='text-[10px] font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400 ml-1'>{t('payroll.select_policy')}</label>\n            <Combobox \n              id='policy-select'\n              data-testid='assign-policy-select'\n              options={policies.map((p: any) => ({\n                value: p.id,\n                label: p.name,\n                icon: <Clock size={14} className='text-primary-500' />\n              }))}\n              value={policyId}\n              onChange={setPolicyId}\n              placeholder={t('payroll.select_policy_placeholder')}\n              className='bg-slate-50 dark:bg-slate-800 border-slate-100 dark:border-slate-800 h-14'\n            />\n          </div>\n\n          <div className='space-y-2'>\n            <label className='text-[10px] font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400 ml-1'>{t('payroll.effective_from')}</label>\n            <div className='relative'>\n              <Calendar className='absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 dark:text-slate-400' size={16} />\n              <input \n                type='date'\n                data-testid='assign-effective-from'\n                value={effectiveFrom} \n                onChange={e => setEffectiveFrom(e.target.value)}\n                className='w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-2xl pl-12 pr-4 py-3 text-sm outline-none focus:ring-2 focus:ring-primary-500 font-bold'\n                required\n              />\n            </div>\n          </div>\n        </div>\n\n        <div className='flex justify-end gap-3 pt-4'>\n          <button type='button' onClick={onClose} className='px-6 py-2 rounded-xl text-sm font-bold text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700 transition-all uppercase tracking-widest'>{t('common.cancel')}</button>\n          <button\n            type='submit'\n            data-testid='assign-policy-submit-btn'\n            disabled={assignMutation.isPending}\n            className='flex items-center gap-2 bg-primary-600 text-white px-8 py-2 rounded-xl text-sm font-bold hover:bg-primary-700 transition-all shadow-xl shadow-primary-100 dark:shadow-black/30 active:scale-95 disabled:opacity-50 uppercase tracking-widest'\n          >\n            <Save size={16} />\n            {t('payroll.assign_policy')}\n          </button>\n        </div>\n      </form>\n    </Modal>\n  );\n}","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/payroll/BatchCalculationModal.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/payroll/BonusPolicyManager.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Info' is defined but never used. Allowed unused vars must match /^_/u.","line":8,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":8,"endColumn":7,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Info"},"fix":{"range":[161,170],"text":""},"desc":"Remove unused variable \"Info\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'setPayoutType' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":36,"column":22,"nodeType":"Identifier","messageId":"unusedVar","endLine":36,"endColumn":35},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":37,"column":38,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":37,"endColumn":41,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1031,1034],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1031,1034],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":48,"column":24,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":48,"endColumn":27,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1561,1564],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1561,1564],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":81,"column":56,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":81,"endColumn":59,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[2532,2535],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[2532,2535],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"jsx-a11y/label-has-associated-control","severity":2,"message":"A form label must be associated with a control.","line":170,"column":23,"nodeType":"JSXOpeningElement","endLine":170,"endColumn":150},{"ruleId":"jsx-a11y/label-has-associated-control","severity":2,"message":"A form label must be associated with a control.","line":180,"column":23,"nodeType":"JSXOpeningElement","endLine":180,"endColumn":150},{"ruleId":"jsx-a11y/label-has-associated-control","severity":2,"message":"A form label must be associated with a control.","line":190,"column":23,"nodeType":"JSXOpeningElement","endLine":190,"endColumn":150},{"ruleId":"jsx-a11y/label-has-associated-control","severity":2,"message":"A form label must be associated with a control.","line":200,"column":23,"nodeType":"JSXOpeningElement","endLine":200,"endColumn":150},{"ruleId":"jsx-a11y/label-has-associated-control","severity":2,"message":"A form label must be associated with a control.","line":210,"column":23,"nodeType":"JSXOpeningElement","endLine":210,"endColumn":154},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'tidx' is defined but never used. Allowed unused args must match /^_/u.","line":257,"column":83,"nodeType":"Identifier","messageId":"unusedVar","endLine":257,"endColumn":87}],"suppressedMessages":[],"errorCount":11,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from \"react\";\n\nimport { useQuery, useMutation, useQueryClient } from \"@tanstack/react-query\";\nimport { \n  Sparkles, \n  Plus, \n  Trash2, \n  Info, \n  Save,\n  CheckCircle2,\n  AlertCircle,\n  TrendingUp,\n  Target,\n  Clock\n} from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { useToast } from \"@/components/ui/Toast\";\n\nimport { fetchIncentivePolicies, createIncentivePolicy, deleteIncentivePolicy } from \"@/lib/api/payroll\";\nimport { cn } from \"@/lib/utils\";\n\ninterface BonusPolicyManagerProps {\n  wsId: string;\n}\n\nexport default function BonusPolicyManager({ wsId }: BonusPolicyManagerProps) {\n  const { t } = useTranslation();\n  const queryClient = useQueryClient();\n  const toast = useToast();\n  const [isCreating, setIsCreating] = useState(false);\n\n  // Form State\n  const [name, setName] = useState(\"\");\n  const [baseAmount, setBaseAmount] = useState(300000);\n  const [payoutType, setPayoutType] = useState<\"fixed\" | \"percentage\">(\"fixed\");\n  const [tiers, setTiers] = useState<any[]>([\n    { priority: 1, max_total_leave_days: 1, max_late_early_count: 2, max_unpaid_leave_days: 0.5, max_sick_leave_days: 1, payout_amount: 150000 },\n    { priority: 2, max_total_leave_days: null, max_late_early_count: null, max_unpaid_leave_days: null, max_sick_leave_days: null, payout_amount: 0 }\n  ]);\n\n  const { data: policies = [], isLoading } = useQuery({\n    queryKey: [\"incentive-policies\", wsId],\n    queryFn: () => fetchIncentivePolicies(wsId),\n  });\n\n  const createMutation = useMutation({\n    mutationFn: (data: any) => createIncentivePolicy(wsId, data),\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: [\"incentive-policies\"] });\n      setIsCreating(false);\n      toast.success(t(\"common.success\"));\n      // Reset form\n      setName(\"\"); setBaseAmount(300000);\n    },\n  });\n\n  const deleteMutation = useMutation({\n    mutationFn: (id: string) => deleteIncentivePolicy(wsId, id),\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: [\"incentive-policies\"] });\n      toast.success(t(\"common.deleted\"));\n    },\n  });\n\n  const handleAddTier = () => {\n    setTiers([...tiers, { \n      priority: tiers.length + 1, \n      max_total_leave_days: null, \n      max_late_early_count: null,\n      max_unpaid_leave_days: null,\n      max_sick_leave_days: null,\n      payout_amount: 0 \n    }]);\n  };\n\n  const handleRemoveTier = (idx: number) => {\n    setTiers(tiers.filter((_, i) => i !== idx));\n  };\n\n  const updateTier = (idx: number, field: string, val: any) => {\n    const next = [...tiers];\n    next[idx][field] = val === \"\" ? null : val;\n    setTiers(next);\n  };\n\n  const handleSave = () => {\n    if (!name) return toast.error(t(\"payroll.incentives.name_required\"));\n    createMutation.mutate({\n      name,\n      base_amount: baseAmount,\n      payout_type: payoutType,\n      tiers: tiers.map(t => ({\n        ...t,\n        max_total_leave_days: t.max_total_leave_days !== null ? parseFloat(t.max_total_leave_days) : null,\n        max_late_early_count: t.max_late_early_count !== null ? parseInt(t.max_late_early_count) : null,\n        max_unpaid_leave_days: t.max_unpaid_leave_days !== null ? parseFloat(t.max_unpaid_leave_days) : null,\n        max_sick_leave_days: t.max_sick_leave_days !== null ? parseFloat(t.max_sick_leave_days) : null,\n        payout_amount: parseFloat(t.payout_amount)\n      }))\n    });\n  };\n\n  return (\n    <div className=\"space-y-10\">\n      <div className=\"flex items-center justify-between\">\n        <div>\n          <h2 className=\"text-xl font-bold text-slate-700 dark:text-slate-200 uppercase tracking-tight flex items-center gap-3\">\n            <Sparkles className=\"text-primary-600 dark:text-primary-400\" size={24} />\n            {t(\"payroll.incentives.title\", { defaultValue: \"INCENTIVE & BONUS POLICIES\" })}\n          </h2>\n          <p className=\"text-sm text-slate-500 dark:text-slate-400 font-medium mt-1 uppercase tracking-widest text-[10px] opacity-70\">Manage Diligence, Performance and Safety bonuses</p>\n        </div>\n        <button \n          onClick={() => setIsCreating(!isCreating)}\n          className={cn(\n            \"flex items-center gap-2 px-6 py-3 rounded-2xl font-bold text-[10px] uppercase tracking-widest transition-all shadow-lg active:scale-95\",\n            isCreating ? \"bg-slate-100 dark:bg-slate-700 text-slate-500 dark:text-slate-400\" : \"bg-primary-600 text-white hover:bg-primary-700\"\n          )}\n        >\n          {isCreating ? t(\"common.cancel\") : <><Plus size={16} /> {t(\"payroll.incentives.add_btn\", { defaultValue: \"NEW POLICY\" })}</>}\n        </button>\n      </div>\n\n      {isCreating && (\n        <div className=\"bg-slate-50 dark:bg-slate-800 rounded-[2.5rem] p-10 border border-slate-200 dark:border-slate-700 shadow-inner animate-in slide-in-from-top-4 duration-500 space-y-10\">\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n            <div className=\"space-y-3\">\n              <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">{t(\"payroll.incentives.policy_name\")}</label>\n              <input \n                type=\"text\" \n                value={name} \n                onChange={e => setName(e.target.value)}\n                placeholder=\"e.g. Diligence Bonus\"\n                className=\"w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-2xl px-6 py-4 outline-none focus:ring-4 focus:ring-primary-500/10 focus:border-primary-300 transition-all font-bold text-sm shadow-sm\"\n              />\n            </div>\n            <div className=\"space-y-3\">\n              <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">{t(\"payroll.incentives.base_amount\")}</label>\n              <input \n                type=\"number\" \n                value={baseAmount} \n                onChange={e => setBaseAmount(parseFloat(e.target.value))}\n                className=\"w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-2xl px-6 py-4 outline-none focus:ring-4 focus:ring-primary-500/10 focus:border-primary-300 transition-all font-bold text-sm shadow-sm font-mono\"\n              />\n            </div>\n          </div>\n\n          <div className=\"space-y-6\">\n            <div className=\"flex items-center justify-between px-1\">\n              <h3 className=\"text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.2em]\">{t(\"payroll.incentives.tiers_config\", { defaultValue: \"EVALUATION TIERS\" })}</h3>\n              <button onClick={handleAddTier} className=\"text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:text-primary-300 font-bold text-[10px] uppercase tracking-widest flex items-center gap-1.5\"><Plus size={14} /> {t(\"common.add\")}</button>\n            </div>\n\n            <div className=\"space-y-4\">\n              {tiers.map((tier, idx) => (\n                <div key={idx} className=\"bg-white dark:bg-slate-900 p-8 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-sm flex flex-col items-stretch gap-8 group relative\">\n                  <div className=\"flex items-center justify-between\">\n                    <div className=\"w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-700 flex items-center justify-center font-bold text-slate-500 dark:text-slate-400 text-xs shadow-inner\">#{idx + 1}</div>\n                    <button \n                      onClick={() => handleRemoveTier(idx)}\n                      className=\"w-10 h-10 rounded-xl text-slate-300 dark:text-slate-600 hover:text-rose-500 hover:bg-rose-50 dark:bg-rose-950 transition-all flex items-center justify-center\"\n                    >\n                      <Trash2 size={18} />\n                    </button>\n                  </div>\n                  \n                  <div className=\"grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-6\">\n                    <div className=\"space-y-2\">\n                      <label className=\"text-[9px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest flex items-center gap-1.5\"><Clock size={10} /> Max Late/Early</label>\n                      <input \n                        type=\"number\" \n                        value={tier.max_late_early_count || \"\"} \n                        onChange={e => updateTier(idx, \"max_late_early_count\", e.target.value)}\n                        placeholder=\"Any\"\n                        className=\"w-full bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-xl px-4 py-2.5 outline-none focus:bg-white dark:focus:bg-slate-900 transition-all font-bold text-xs\"\n                      />\n                    </div>\n                    <div className=\"space-y-2\">\n                      <label className=\"text-[9px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest flex items-center gap-1.5\"><AlertCircle size={10} /> Max Unpaid</label>\n                      <input \n                        type=\"number\" \n                        value={tier.max_unpaid_leave_days || \"\"} \n                        onChange={e => updateTier(idx, \"max_unpaid_leave_days\", e.target.value)}\n                        placeholder=\"Any\"\n                        className=\"w-full bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-xl px-4 py-2.5 outline-none focus:bg-white dark:focus:bg-slate-900 transition-all font-bold text-xs\"\n                      />\n                    </div>\n                    <div className=\"space-y-2\">\n                      <label className=\"text-[9px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest flex items-center gap-1.5\"><AlertCircle size={10} /> Max Sick</label>\n                      <input \n                        type=\"number\" \n                        value={tier.max_sick_leave_days || \"\"} \n                        onChange={e => updateTier(idx, \"max_sick_leave_days\", e.target.value)}\n                        placeholder=\"Any\"\n                        className=\"w-full bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-xl px-4 py-2.5 outline-none focus:bg-white dark:focus:bg-slate-900 transition-all font-bold text-xs\"\n                      />\n                    </div>\n                    <div className=\"space-y-2\">\n                      <label className=\"text-[9px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest flex items-center gap-1.5\"><AlertCircle size={10} /> Max Total Days</label>\n                      <input \n                        type=\"number\" \n                        value={tier.max_total_leave_days || \"\"} \n                        onChange={e => updateTier(idx, \"max_total_leave_days\", e.target.value)}\n                        placeholder=\"Any\"\n                        className=\"w-full bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-xl px-4 py-2.5 outline-none focus:bg-white dark:focus:bg-slate-900 transition-all font-bold text-xs\"\n                      />\n                    </div>\n                    <div className=\"space-y-2\">\n                      <label className=\"text-[9px] font-bold text-primary-600 dark:text-primary-400 uppercase tracking-widest flex items-center gap-1.5\"><TrendingUp size={10} /> Payout</label>\n                      <input \n                        type=\"number\" \n                        value={tier.payout_amount} \n                        onChange={e => updateTier(idx, \"payout_amount\", e.target.value)}\n                        className=\"w-full bg-primary-50 dark:bg-primary-950/50 border border-primary-100 dark:border-primary-800 rounded-xl px-4 py-2.5 outline-none focus:bg-white dark:focus:bg-slate-900 transition-all font-bold text-xs font-mono text-primary-700 dark:text-primary-300\"\n                      />\n                    </div>\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n\n          <div className=\"flex justify-end pt-4\">\n            <button \n              onClick={handleSave}\n              disabled={createMutation.isPending}\n              className=\"bg-slate-900 hover:bg-primary-700 text-white px-10 py-4 rounded-2xl font-bold text-xs uppercase tracking-[0.2em] shadow-2xl active:scale-95 transition-all flex items-center gap-3 disabled:opacity-50\"\n            >\n              {createMutation.isPending ? <Plus className=\"animate-spin\" size={18} /> : <Save size={18} />}\n              {t(\"common.save_settings\")}\n            </button>\n          </div>\n        </div>\n      )}\n\n      <div className=\"grid grid-cols-1 gap-6\">\n        {policies.map(policy => (\n          <div key={policy.id} className=\"bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-[2.5rem] p-8 shadow-sm hover:shadow-md transition-all group relative overflow-hidden\">\n            <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-6 relative z-10\">\n              <div className=\"flex items-center gap-6\">\n                <div className=\"w-16 h-16 rounded-[1.5rem] bg-primary-50 dark:bg-primary-950 flex items-center justify-center text-primary-600 dark:text-primary-400 shadow-inner border border-primary-100 dark:border-primary-800/50\">\n                  <Target size={32} />\n                </div>\n                <div>\n                  <h3 className=\"text-xl font-bold text-slate-700 dark:text-slate-200 uppercase tracking-tight\">{policy.name}</h3>\n                  <div className=\"flex items-center gap-4 mt-1.5\">\n                    <span className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest bg-slate-50 dark:bg-slate-800 px-3 py-1 rounded-lg border border-slate-100 dark:border-slate-800\">BASE: {new Intl.NumberFormat('vi-VN').format(policy.base_amount)} VND</span>\n                    <span className=\"flex items-center gap-1.5 text-[10px] font-bold text-emerald-600 dark:text-emerald-300 uppercase tracking-widest\">\n                      <CheckCircle2 size={12} /> {t(\"common.active\")}\n                    </span>\n                  </div>\n                </div>\n              </div>\n\n              <div className=\"flex flex-wrap gap-3\">\n                {policy.tiers?.sort((a, b) => a.priority - b.priority).map((tier, tidx) => (\n                  <div key={tier.id} className=\"bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl px-5 py-4 flex flex-col items-center min-w-[140px] shadow-inner\">\n                    <span className=\"text-[8px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest mb-2\">Tier {tier.priority}</span>\n                    <span className=\"text-sm font-bold text-primary-600 dark:text-primary-400 font-mono tracking-tighter\">\n                      +{new Intl.NumberFormat('vi-VN').format(tier.payout_amount)}\n                    </span>\n                    <div className=\"mt-2 flex flex-col items-center gap-1 opacity-60\">\n                      {tier.max_late_early_count !== null && <span className=\"text-[7px] font-bold text-slate-500 dark:text-slate-400 uppercase\">Late &lt; {tier.max_late_early_count}</span>}\n                      {tier.max_unpaid_leave_days !== null && <span className=\"text-[7px] font-bold text-slate-500 dark:text-slate-400 uppercase\">Unpaid &lt; {tier.max_unpaid_leave_days}d</span>}\n                      {tier.max_sick_leave_days !== null && <span className=\"text-[7px] font-bold text-slate-500 dark:text-slate-400 uppercase\">Sick &lt; {tier.max_sick_leave_days}d</span>}\n                      {tier.max_total_leave_days !== null && <span className=\"text-[7px] font-bold text-slate-500 dark:text-slate-400 uppercase\">Total &lt; {tier.max_total_leave_days}d</span>}\n                      {tier.max_late_early_count === null && tier.max_unpaid_leave_days === null && tier.max_sick_leave_days === null && tier.max_total_leave_days === null && (\n                        <span className=\"text-[7px] font-bold text-slate-500 dark:text-slate-400 uppercase italic\">Default</span>\n                      )}\n                    </div>\n                  </div>\n                ))}\n              </div>\n\n              <button \n                onClick={() => deleteMutation.mutate(policy.id)}\n                className=\"p-4 rounded-2xl text-slate-300 dark:text-slate-600 hover:text-rose-500 hover:bg-rose-50 dark:bg-rose-950 transition-all active:scale-90\"\n              >\n                <Trash2 size={20} />\n              </button>\n            </div>\n            <Sparkles className=\"absolute -right-8 -bottom-8 w-40 h-40 text-primary-500 opacity-[0.03] -rotate-12 group-hover:rotate-0 transition-transform duration-1000\" />\n          </div>\n        ))}\n\n        {!isLoading && policies.length === 0 && !isCreating && (\n          <div className=\"py-24 text-center border-2 border-dashed border-slate-100 dark:border-slate-800 rounded-[3rem] bg-slate-50 dark:bg-slate-800/30 flex flex-col items-center\">\n            <div className=\"w-20 h-20 bg-white dark:bg-slate-900 rounded-full flex items-center justify-center shadow-sm mb-4 border border-slate-100 dark:border-slate-800\"><Sparkles size={32} className=\"text-slate-200 dark:text-slate-700\" /></div>\n            <h3 className=\"text-lg font-bold text-slate-700 dark:text-slate-200\">{t(\"payroll.incentives.no_policies\", { defaultValue: \"NO INCENTIVE POLICIES\" })}</h3>\n            <p className=\"text-slate-500 dark:text-slate-400 text-sm mt-1 uppercase font-bold tracking-widest opacity-50\">Configure your first bonus rule to reward diligent staff</p>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/payroll/EmployeeSalaryConfig.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Coins' is defined but never used. Allowed unused vars must match /^_/u.","line":7,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":7,"endColumn":8,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Coins"},"fix":{"range":[172,182],"text":""},"desc":"Remove unused variable \"Coins\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Calendar' is defined but never used. Allowed unused vars must match /^_/u.","line":8,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":8,"endColumn":11,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Calendar"},"fix":{"range":[182,195],"text":""},"desc":"Remove unused variable \"Calendar\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'ChevronDown' is defined but never used. Allowed unused vars must match /^_/u.","line":13,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":13,"endColumn":14,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"ChevronDown"},"fix":{"range":[249,265],"text":""},"desc":"Remove unused variable \"ChevronDown\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'SalaryComponentDefinition' is defined but never used. Allowed unused vars must match /^_/u.","line":32,"column":35,"nodeType":"Identifier","messageId":"unusedVar","endLine":32,"endColumn":60,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"SalaryComponentDefinition"},"fix":{"range":[769,796],"text":""},"desc":"Remove unused variable \"SalaryComponentDefinition\"."}]}],"suppressedMessages":[],"errorCount":4,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from \"react\";\n\nimport { useQuery, useMutation, useQueryClient } from \"@tanstack/react-query\";\nimport { format } from \"date-fns\";\nimport { \n  Plus, \n  Coins, \n  Calendar, \n  Wallet, \n  Trash2, \n  ShieldCheck, \n  AlertCircle, \n  ChevronDown, \n  ChevronRight,\n  History,\n  ArrowUpRight\n} from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { Combobox } from \"@/components/ui/Combobox\";\nimport { useToast } from \"@/components/ui/Toast\";\n\n\nimport { useDateTimeFormatter } from \"@/hooks/use-datetime\";\nimport { \n  fetchSalaryComponents, \n  fetchEmployeeSalaryComponents, \n  assignEmployeeSalaryComponent,\n  fetchEmployeePayrollConfigs,\n  setEmployeePayrollConfig\n} from \"@/lib/api/payroll\";\nimport { EmployeeSalaryComponent, SalaryComponentDefinition } from \"@/lib/api/types\";\nimport { cn } from \"@/lib/utils\";\n\nimport TemporalConfigTable from \"../common/TemporalConfigTable\";\n\ninterface Props {\n  wsId: string;\n  employeeId: string;\n}\n\nexport default function EmployeeSalaryConfig({ wsId, employeeId }: Props) {\n  const { t } = useTranslation();\n  const queryClient = useQueryClient();\n  const toast = useToast();\n  const { formatDate } = useDateTimeFormatter();\n  \n  const [isAdding, setIsAdding] = useState(false);\n  const [selectedCompId, setSelectedCompId] = useState(\"\");\n  const [amount, setAmount] = useState(\"\");\n  const [effectiveDate, setEffectiveDate] = useState(format(new Date(), \"yyyy-MM-01\"));\n  const [expandedGroups, setExpandedGroups] = useState<Record<string, boolean>>({});\n\n  const { data: definitions = [] } = useQuery({ queryKey: [\"salary-components\", wsId], queryFn: () => fetchSalaryComponents(wsId) });\n  const { data: employeeComps = [], isLoading } = useQuery({ queryKey: [\"employee-salary-components\", employeeId], queryFn: () => fetchEmployeeSalaryComponents(wsId, employeeId) });\n  const { data: individualConfigs = [], isLoading: isConfigsLoading } = useQuery({ queryKey: [\"employee-payroll-configs\", employeeId], queryFn: () => fetchEmployeePayrollConfigs(wsId, employeeId) });\n\n  const groupedComps = employeeComps.reduce((acc, comp) => {\n    const key = comp.component_definition_id; if (!acc[key]) acc[key] = [];\n    acc[key].push(comp); return acc;\n  }, {} as Record<string, EmployeeSalaryComponent[]>);\n\n  Object.keys(groupedComps).forEach(key => { groupedComps[key].sort((a, b) => new Date(b.effective_date).getTime() - new Date(a.effective_date).getTime()); });\n\n  const toggleGroup = (id: string) => { setExpandedGroups(prev => ({ ...prev, [id]: !prev[id] })); };\n\n  const saveIndividualConfigMutation = useMutation({\n    mutationFn: (data: { std_working_days: number; hours_per_day: number; effective_date: string }) => setEmployeePayrollConfig(wsId, employeeId, data),\n    onSuccess: () => { queryClient.invalidateQueries({ queryKey: [\"employee-payroll-configs\", employeeId] }); toast.success(t(\"common.success\")); },\n  });\n\n  const assignMutation = useMutation({\n    mutationFn: (data: Partial<EmployeeSalaryComponent>) => assignEmployeeSalaryComponent(wsId, employeeId, data),\n    onSuccess: () => { toast.success(t(\"common.success\")); queryClient.invalidateQueries({ queryKey: [\"employee-salary-components\", employeeId] }); setIsAdding(false); setAmount(\"\"); setSelectedCompId(\"\"); },\n  });\n\n  const handleAssign = (e: React.FormEvent) => {\n    e.preventDefault(); if (!selectedCompId || !amount) return;\n    assignMutation.mutate({ component_definition_id: selectedCompId, amount: amount, effective_date: effectiveDate });\n  };\n\n  const currencyFormatter = new Intl.NumberFormat(t(\"common.languages.\" + (t(\"common.currency\") === \"VND\" ? \"vi\" : \"en\")) === \"Tiếng Việt\" ? \"vi-VN\" : \"en-US\");\n\n  return (\n    <div className=\"flex flex-col gap-8 animate-in fade-in duration-500\">\n      <div className=\"flex items-center justify-between px-2\">\n        <div className=\"flex items-center gap-4\">\n          <div className=\"w-10 h-10 rounded-2xl bg-primary-50 dark:bg-primary-950 flex items-center justify-center text-primary-600 dark:text-primary-400 shadow-sm border border-primary-100 dark:border-primary-800/50\"><Wallet size={20} /></div>\n          <div><h3 className=\"text-lg font-bold text-slate-800 dark:text-slate-100 tracking-tight\">{t(\"payroll.employee_config.title\")}</h3><p className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest mt-0.5\">{t(\"payroll.employee_config.salary_items_subtitle\")}</p></div>\n        </div>\n        <button onClick={() => setIsAdding(!isAdding)} className={cn(\"flex items-center gap-2 px-6 py-2.5 rounded-2xl font-bold text-[10px] uppercase tracking-widest transition-all\", isAdding ? 'bg-slate-100 dark:bg-slate-700 text-slate-500 dark:text-slate-400 border border-slate-200 dark:border-slate-700' : 'bg-primary-600 text-white shadow-lg shadow-primary-100 active:scale-95')}>\n          {isAdding ? t(\"common.cancel\") : <><Plus size={14} /> {t(\"payroll.employee_config.add_btn\")}</>}\n        </button>\n      </div>\n\n      {isAdding && (\n        <form onSubmit={handleAssign} className=\"bg-white dark:bg-slate-900 border-2 border-primary-100 dark:border-primary-800 p-10 rounded-[2.5rem] shadow-xl shadow-primary-50/50 animate-in slide-in-from-top-4 duration-500\">\n          <div className=\"flex items-center gap-3 mb-8 text-primary-700 dark:text-primary-300\">\n            <div className=\"w-8 h-8 rounded-xl bg-primary-50 dark:bg-primary-950 flex items-center justify-center shadow-inner\"><ArrowUpRight size={16} /></div>\n            <h4 className=\"text-[10px] font-bold uppercase tracking-[0.2em]\">{t(\"payroll.employee_config.add_new_title\")}</h4>\n          </div>\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-8\">\n            <div className=\"space-y-3\">\n              <label htmlFor=\"salary-comp-select\" className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">{t(\"payroll.employee_config.item_type\")}</label>\n              <Combobox id=\"salary-comp-select\" options={definitions.map(d => ({ value: d.id, label: d.name, description: d.code }))} value={selectedCompId} onChange={setSelectedCompId} className=\"bg-slate-50 dark:bg-slate-800 border-slate-100 dark:border-slate-800 h-14\" />\n            </div>\n            <div className=\"space-y-3\">\n              <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">{t(\"common.amount\")} ({t(\"common.currency\")})</label>\n              <input required type=\"number\" placeholder=\"1,000\" className=\"w-full bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl px-5 py-4 focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-bold text-sm tracking-tight\" value={amount} onChange={e => setAmount(e.target.value)} />\n            </div>\n            <div className=\"space-y-3\">\n              <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">{t(\"common.effective_date\")}</label>\n              <input required type=\"date\" className=\"w-full bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl px-5 py-4 focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-bold text-sm\" value={effectiveDate} onChange={e => setEffectiveDate(e.target.value)} />\n            </div>\n          </div>\n          <div className=\"mt-10 flex justify-end\">\n            <button type=\"submit\" disabled={assignMutation.isPending} className=\"bg-primary-600 text-white px-12 py-4 rounded-2xl font-bold text-xs uppercase tracking-widest hover:bg-primary-700 transition-all shadow-xl shadow-primary-100 dark:shadow-black/30 active:scale-95 disabled:opacity-50\">{assignMutation.isPending ? t(\"common.saving\").toUpperCase() : t(\"common.save\")}</button>\n          </div>\n        </form>\n      )}\n\n      <div className=\"bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-[2.5rem] overflow-hidden shadow-sm\">\n        <table className=\"w-full text-left border-collapse\">\n          <thead className=\"bg-slate-50 dark:bg-slate-800/50 border-b border-slate-100 dark:border-slate-800\">\n            <tr>\n              <th className=\"px-8 py-5 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">{t(\"payroll.employee_config.salary_item\")}</th>\n              <th className=\"px-8 py-5 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest text-right\">{t(\"common.amount\")}</th>\n              <th className=\"px-8 py-5 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest text-center\">{t(\"common.base_for_ot\")}</th>\n              <th className=\"px-8 py-5 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest text-right\">{t(\"common.effective_date\")}</th>\n              <th className=\"px-8 py-5 border-b border-slate-100 dark:border-slate-800\"></th>\n            </tr>\n          </thead>\n          <tbody className=\"divide-y divide-slate-50 dark:divide-slate-800\">\n            {isLoading ? (\n              <tr><td colSpan={5} className=\"px-8 py-12 text-center text-slate-500 dark:text-slate-400 font-bold italic uppercase tracking-widest text-xs opacity-50\">{t(\"common.loading\")}</td></tr>\n            ) : Object.keys(groupedComps).length === 0 ? (\n              <tr><td colSpan={5} className=\"px-8 py-20 text-center text-slate-500 dark:text-slate-400 font-bold italic uppercase tracking-widest text-xs opacity-50\">{t(\"payroll.employee_config.no_config\")}</td></tr>\n            ) : (\n              Object.entries(groupedComps).map(([defId, comps]) => {\n                const latest = comps[0]; const hasHistory = comps.length > 1; const isExpanded = expandedGroups[defId];\n                return (\n                  <React.Fragment key={defId}>\n                    <tr className={cn(\"group transition-all hover:bg-slate-50 dark:hover:bg-slate-800/50\", isExpanded && \"bg-slate-50 dark:bg-slate-800/30\")}>\n                      <td className=\"px-8 py-6\">\n                        <div className=\"flex items-center gap-4\">\n                          {hasHistory ? (\n                            <button onClick={() => toggleGroup(defId)} className={cn(\"p-1.5 rounded-lg transition-all border shadow-sm\", isExpanded ? \"bg-white dark:bg-slate-900 text-primary-600 dark:text-primary-400 border-primary-100 dark:border-primary-800 rotate-90\" : \"bg-slate-50 dark:bg-slate-800 text-slate-300 dark:text-slate-600 border-slate-100 dark:border-slate-800 hover:text-slate-500 dark:text-slate-400\")}><ChevronRight size={14} /></button>\n                          ) : <div className=\"w-8\" />}\n                          <div>\n                            <div className=\"font-bold text-slate-700 dark:text-slate-200 text-sm tracking-tight uppercase leading-none\">{latest.name}</div>\n                            <div className=\"text-[9px] font-mono font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest mt-1.5 opacity-70\">{latest.code}</div>\n                          </div>\n                        </div>\n                      </td>\n                      <td className=\"px-8 py-6 text-right font-mono font-bold text-slate-700 dark:text-slate-200 text-sm\">{currencyFormatter.format(parseFloat(latest.amount))}</td>\n                      <td className=\"px-8 py-6 text-center\">\n                        <span className={cn(\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[9px] font-bold uppercase tracking-widest border shadow-sm\", latest.is_base_for_ot ? 'bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-300 border-emerald-100 dark:border-emerald-800' : 'bg-slate-100 dark:bg-slate-700 text-slate-500 dark:text-slate-400 border-slate-200 dark:border-slate-700')}>\n                          {latest.is_base_for_ot ? <ShieldCheck size={10} /> : null} {latest.is_base_for_ot ? t(\"common.yes\") : t(\"common.no\")}\n                        </span>\n                      </td>\n                      <td className=\"px-8 py-6 text-right\">\n                        <div className=\"flex flex-col items-end\">\n                          <div className=\"text-xs font-bold text-slate-700 dark:text-slate-200 uppercase tracking-tighter\">{formatDate(latest.effective_date)}</div>\n                          <div className=\"text-[8px] font-bold uppercase text-emerald-600 dark:text-emerald-300 tracking-[0.2em] mt-1 opacity-80\">{t(\"common.active\")}</div>\n                        </div>\n                      </td>\n                      <td className=\"px-8 py-6 text-right\">\n                        <button className=\"p-2.5 bg-white dark:bg-slate-900 text-slate-300 dark:text-slate-600 hover:text-rose-600 dark:text-rose-300 rounded-xl shadow-md border border-slate-100 dark:border-slate-800 transition-all opacity-0 group-hover:opacity-100\"><Trash2 size={16} /></button>\n                      </td>\n                    </tr>\n                    {isExpanded && comps.slice(1).map((comp) => (\n                      <tr key={comp.id} className=\"bg-slate-50 dark:bg-slate-800/20 text-slate-500 dark:text-slate-400 animate-in slide-in-from-top-2 duration-300\">\n                        <td className=\"px-8 py-4 pl-20 relative\">\n                          <div className=\"absolute left-12 top-0 bottom-0 w-px bg-slate-200 dark:bg-slate-600\" />\n                          <div className=\"flex items-center gap-3\">\n                            <div className=\"w-6 h-6 rounded-lg bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 flex items-center justify-center text-slate-300 dark:text-slate-600 shadow-sm\"><History size={12} /></div>\n                            <span className=\"text-[9px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest opacity-60 italic\">{t(\"common.expired\", \"Archive\")}</span>\n                          </div>\n                        </td>\n                        <td className=\"px-8 py-4 text-right font-mono text-xs font-bold opacity-60\">{currencyFormatter.format(parseFloat(comp.amount))}</td>\n                        <td className=\"px-8 py-4 text-center opacity-40 text-[9px] font-bold uppercase tracking-widest\">{comp.is_base_for_ot ? t(\"common.yes\") : t(\"common.no\")}</td>\n                        <td className=\"px-8 py-4 text-right text-xs font-bold font-mono opacity-50 uppercase tracking-tighter\">{formatDate(comp.effective_date)}</td>\n                        <td className=\"px-8 py-4 text-right pr-10\">\n                          <button className=\"p-1.5 text-slate-300 dark:text-slate-600 hover:text-rose-600 dark:text-rose-300 transition-all opacity-0 group-hover:opacity-100\"><Trash2 size={14} /></button>\n                        </td>\n                      </tr>\n                    ))}\n                  </React.Fragment>\n                );\n              })\n            )}\n          </tbody>\n        </table>\n      </div>\n      \n      <div className=\"p-8 bg-amber-50 dark:bg-amber-950/50 border border-amber-100 dark:border-amber-800 rounded-[2.5rem] flex gap-5 shadow-inner\">\n        <div className=\"w-12 h-12 rounded-2xl bg-white dark:bg-slate-900 flex items-center justify-center text-amber-500 shadow-sm border border-amber-100 dark:border-amber-800 shrink-0\"><AlertCircle size={24} /></div>\n        <div className=\"text-xs text-amber-900 leading-relaxed font-medium pt-1\">\n          <p className=\"font-bold uppercase tracking-[0.2em] mb-2 text-amber-950 opacity-80\">{t(\"payroll.employee_config.effective_note_title\")}</p>\n          <p className=\"opacity-70 font-bold uppercase tracking-tight\">{t(\"payroll.employee_config.effective_note\")}</p>\n        </div>\n      </div>\n\n      <div className=\"pt-10 border-t border-slate-100 dark:border-slate-800\">\n        <TemporalConfigTable title={t(\"payroll.settings.std_days_override\")} records={individualConfigs} isLoading={isConfigsLoading} onSave={async (data) => { await saveIndividualConfigMutation.mutateAsync(data); }} />\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/payroll/OvertimePolicyManager.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":24,"column":57,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":24,"endColumn":60,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[659,662],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[659,662],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":70,"column":24,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":70,"endColumn":27,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[2616,2619],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[2616,2619],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":148,"column":32,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":148,"endColumn":35,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[6729,6732],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[6729,6732],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from 'react';\n\nimport { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';\nimport { \n  Calculator, \n  Plus, \n  Settings2,\n  Calendar,\n  AlertCircle\n} from 'lucide-react';\nimport { useTranslation } from 'react-i18next';\n\nimport { useToast } from '@/components/ui/Toast';\n\nimport { fetchOvertimePolicies, createOvertimePolicy, fetchOvertimePolicy } from '@/lib/api/payroll';\n\nimport AssignOvertimePolicyModal from './AssignOvertimePolicyModal';\nimport OvertimeRuleEditor from './OvertimeRuleEditor';\n\ninterface OvertimePolicyManagerProps {\n  wsId: string;\n}\n\nfunction OvertimePolicyCard({ policy, wsId }: { policy: any, wsId: string }) {\n  const { data: detail, isLoading } = useQuery({\n    queryKey: ['overtime-policy', policy.id],\n    queryFn: () => fetchOvertimePolicy(wsId, policy.id),\n  });\n\n  return (\n    <div className='bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-3xl p-6 shadow-sm hover:shadow-md transition-all group'>\n      <div className='flex items-center justify-between mb-4'>\n        <div className='flex items-center gap-4'>\n          <div className='w-12 h-12 rounded-2xl bg-slate-50 dark:bg-slate-800 flex items-center justify-center text-slate-500 dark:text-slate-400 group-hover:bg-primary-50 dark:group-hover:bg-primary-950 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors'>\n            <Settings2 size={24} />\n          </div>\n          <div>\n            <h3 className='font-bold text-slate-700 dark:text-slate-200 text-lg'>{policy.name}</h3>\n            <p className='text-sm text-slate-500 dark:text-slate-400'>{policy.description}</p>\n          </div>\n        </div>\n      </div>\n      \n      {isLoading ? (\n        <div className='h-20 animate-pulse bg-slate-50 dark:bg-slate-800 rounded-2xl'></div>\n      ) : (\n        <OvertimeRuleEditor wsId={wsId} policyId={policy.id} rules={detail ? detail[1] : []} />\n      )}\n    </div>\n  );\n}\n\nexport default function OvertimePolicyManager({ wsId }: OvertimePolicyManagerProps) {\n  const { t } = useTranslation();\n  const queryClient = useQueryClient();\n  const toast = useToast();\n  const [isCreating, setIsCreating] = useState(false);\n  const [isAssignModalOpen, setIsAssignModalOpen] = useState(false);\n\n  // Form State\n  const [name, setName] = useState('');\n  const [description, setDescription] = useState('');\n\n  const { data: policies = [], isLoading } = useQuery({\n    queryKey: ['overtime-policies', wsId],\n    queryFn: () => fetchOvertimePolicies(wsId),\n  });\n\n  const createMutation = useMutation({\n    mutationFn: (data: any) => createOvertimePolicy(wsId, data),\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: ['overtime-policies'] });\n      setIsCreating(false);\n      setName('');\n      setDescription('');\n      toast.success(t('common.success'));\n    },\n  });\n\n  if (isLoading) return <div className='p-8 text-center animate-pulse text-slate-500 dark:text-slate-400 font-bold'>Loading policies...</div>;\n\n  return (\n    <div className='space-y-6'>\n      <div className='flex items-center justify-between'>\n        <div>\n          <h2 className='text-xl font-bold text-slate-700 dark:text-slate-200 flex items-center gap-2'>\n            <Calculator className='text-primary-600 dark:text-primary-400' size={20} />\n            {t('payroll.overtime_policies')}\n          </h2>\n          <p className='text-sm text-slate-500 dark:text-slate-400 mt-1'>{t('payroll.overtime_policies_desc')}</p>\n        </div>\n        <div className='flex items-center gap-3'>\n          <button\n            onClick={() => setIsAssignModalOpen(true)}\n            className='flex items-center gap-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 px-4 py-2 rounded-xl text-sm font-bold hover:bg-slate-50 dark:hover:bg-slate-800 transition-all active:scale-95'\n          >\n            <Calendar size={16} />\n            {t('payroll.assign_policy')}\n          </button>\n          <button\n            onClick={() => setIsCreating(!isCreating)}\n            className='flex items-center gap-2 bg-primary-600 text-white px-4 py-2 rounded-xl text-sm font-bold hover:bg-primary-700 transition-all shadow-lg shadow-primary-100 active:scale-95'\n          >\n            <Plus size={16} />\n            {t('common.create')}\n          </button>\n        </div>\n      </div>\n\n      {isCreating && (\n        <div className='bg-slate-50 dark:bg-slate-800 rounded-3xl p-6 border border-slate-200 dark:border-slate-700 animate-in fade-in slide-in-from-top-4 duration-300'>\n          <div className='grid grid-cols-1 md:grid-cols-2 gap-6'>\n            <div className='space-y-2'>\n              <label className='text-xs font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400 ml-1'>{t('common.name')}</label>\n              <input\n                type='text'\n                value={name}\n                onChange={(e) => setName(e.target.value)}\n                className='w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-2xl px-4 py-3 text-sm focus:ring-2 focus:ring-primary-500 outline-none transition-all'\n                placeholder='e.g. Standard Overtime'\n              />\n            </div>\n            <div className='space-y-2'>\n              <label className='text-xs font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400 ml-1'>{t('common.description')}</label>\n              <input\n                type='text'\n                value={description}\n                onChange={(e) => setDescription(e.target.value)}\n                className='w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-2xl px-4 py-3 text-sm focus:ring-2 focus:ring-primary-500 outline-none transition-all'\n                placeholder='e.g. Night and Weekend rates'\n              />\n            </div>\n          </div>\n          <div className='flex justify-end gap-3 mt-6'>\n            <button onClick={() => setIsCreating(false)} className='px-6 py-2 rounded-xl text-sm font-bold text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700 transition-all'>Cancel</button>\n            <button\n              onClick={() => createMutation.mutate({ name, description })}\n              disabled={!name || createMutation.isPending}\n              className='flex items-center gap-2 bg-primary-600 text-white px-8 py-2 rounded-xl text-sm font-bold hover:bg-primary-700 transition-all disabled:opacity-50'\n            >\n              {t('common.save')}\n            </button>\n          </div>\n        </div>\n      )}\n\n      <div className='grid grid-cols-1 gap-4'>\n        {policies.map((policy: any) => (\n          <OvertimePolicyCard key={policy.id} policy={policy} wsId={wsId} />\n        ))}\n\n        {policies.length === 0 && !isCreating && (\n          <div className='flex flex-col items-center justify-center py-12 bg-slate-50 dark:bg-slate-800 rounded-[2.5rem] border-2 border-dashed border-slate-200 dark:border-slate-700'>\n             <AlertCircle size={48} className='text-slate-300 dark:text-slate-600 mb-4' />\n             <p className='text-slate-500 dark:text-slate-400 font-medium'>{t('payroll.no_overtime_policies')}</p>\n             <button onClick={() => setIsCreating(true)} className='mt-4 text-primary-600 dark:text-primary-400 font-bold hover:underline'>{t('payroll.create_first_policy')}</button>\n          </div>\n        )}\n      </div>\n\n      <AssignOvertimePolicyModal \n        wsId={wsId} \n        isOpen={isAssignModalOpen} \n        onClose={() => setIsAssignModalOpen(false)} \n      />\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/payroll/OvertimeRuleEditor.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Trash2' is defined but never used. Allowed unused vars must match /^_/u.","line":6,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":6,"endColumn":9,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Trash2"},"fix":{"range":[127,138],"text":""},"desc":"Remove unused variable \"Trash2\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Save' is defined but never used. Allowed unused vars must match /^_/u.","line":7,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":7,"endColumn":7,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Save"},"fix":{"range":[138,147],"text":""},"desc":"Remove unused variable \"Save\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Calendar' is defined but never used. Allowed unused vars must match /^_/u.","line":9,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":9,"endColumn":11,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Calendar"},"fix":{"range":[156,168],"text":""},"desc":"Remove unused variable \"Calendar\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'AlertCircle' is defined but never used. Allowed unused vars must match /^_/u.","line":10,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":10,"endColumn":14,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"AlertCircle"},"fix":{"range":[168,183],"text":""},"desc":"Remove unused variable \"AlertCircle\"."}]},{"ruleId":"jsx-a11y/label-has-associated-control","severity":2,"message":"A form label must be associated with a control.","line":93,"column":15,"nodeType":"JSXOpeningElement","endLine":93,"endColumn":141},{"ruleId":"jsx-a11y/label-has-associated-control","severity":2,"message":"A form label must be associated with a control.","line":104,"column":15,"nodeType":"JSXOpeningElement","endLine":104,"endColumn":141},{"ruleId":"jsx-a11y/label-has-associated-control","severity":2,"message":"A form label must be associated with a control.","line":116,"column":15,"nodeType":"JSXOpeningElement","endLine":116,"endColumn":141},{"ruleId":"jsx-a11y/label-has-associated-control","severity":2,"message":"A form label must be associated with a control.","line":127,"column":15,"nodeType":"JSXOpeningElement","endLine":127,"endColumn":141}],"suppressedMessages":[],"errorCount":8,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from 'react';\n\nimport { useMutation, useQueryClient } from '@tanstack/react-query';\nimport { \n  Plus, \n  Trash2, \n  Save,\n  Clock,\n  Calendar,\n  AlertCircle,\n  Hash,\n  Percent\n} from 'lucide-react';\nimport { useTranslation } from 'react-i18next';\n\nimport { useToast } from '@/components/ui/Toast';\n\nimport { addOvertimeRule } from '@/lib/api/payroll';\nimport { OvertimeRule } from \"@/lib/api/types\";\nimport { cn } from '@/lib/utils';\n\n\ninterface OvertimeRuleEditorProps {\n  wsId: string;\n  policyId: string;\n  rules: OvertimeRule[];\n}\n\nexport default function OvertimeRuleEditor({ wsId, policyId, rules }: OvertimeRuleEditorProps) {\n  const { t } = useTranslation();\n  const queryClient = useQueryClient();\n  const toast = useToast();\n  const [isAdding, setIsAdding] = useState(false);\n\n  // Rule Form State\n  const [priority, setPriority] = useState(0);\n  const [multiplier, setMultiplier] = useState(1.5);\n  const [startTime, setStartTime] = useState('');\n  const [endTime, setEndTime] = useState('');\n  const [days, setDays] = useState(127); // Default all days\n  const [isHoliday, setIsHoliday] = useState(false);\n\n  const addMutation = useMutation({\n    mutationFn: (data: Partial<OvertimeRule>) => addOvertimeRule(wsId, policyId, data),\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: ['overtime-policies'] });\n      setIsAdding(false);\n      resetForm();\n      toast.success(t('common.success'));\n    },\n  });\n\n  const resetForm = () => {\n    setPriority(0);\n    setMultiplier(1.5);\n    setStartTime('');\n    setEndTime('');\n    setDays(127);\n    setIsHoliday(false);\n  };\n\n  const weekdays = [\n    { bit: 1, label: 'M' },\n    { bit: 2, label: 'T' },\n    { bit: 4, label: 'W' },\n    { bit: 8, label: 'T' },\n    { bit: 16, label: 'F' },\n    { bit: 32, label: 'S' },\n    { bit: 64, label: 'S' },\n  ];\n\n  const toggleDay = (bit: number) => {\n    setDays(prev => prev ^ bit);\n  };\n\n  return (\n    <div className='mt-6 space-y-4 border-t border-slate-100 dark:border-slate-800 pt-6'>\n      <div className='flex items-center justify-between'>\n        <h4 className='text-sm font-bold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400'>{t('payroll.rules')}</h4>\n        <button\n          onClick={() => setIsAdding(!isAdding)}\n          className='flex items-center gap-1.5 text-xs font-bold text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:text-primary-300 transition-colors'\n        >\n          <Plus size={14} />\n          {t('payroll.add_rule')}\n        </button>\n      </div>\n\n      {isAdding && (\n        <div className='bg-slate-50 dark:bg-slate-800/50 rounded-2xl p-4 border border-slate-100 dark:border-slate-800 space-y-4 animate-in zoom-in-95 duration-200'>\n          <div className='grid grid-cols-2 md:grid-cols-4 gap-4'>\n            <div className='space-y-1.5'>\n              <label className='flex items-center gap-1 text-[10px] font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400'>\n                <Hash size={10}/> Priority\n              </label>\n              <input \n                type='number' \n                value={priority} \n                onChange={e => setPriority(parseInt(e.target.value))}\n                className='w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl px-3 py-2 text-xs outline-none focus:ring-2 focus:ring-primary-500'\n              />\n            </div>\n            <div className='space-y-1.5'>\n              <label className='flex items-center gap-1 text-[10px] font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400'>\n                <Percent size={10}/> Multiplier\n              </label>\n              <input \n                type='number' \n                step='0.1'\n                value={multiplier} \n                onChange={e => setMultiplier(parseFloat(e.target.value))}\n                className='w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl px-3 py-2 text-xs outline-none focus:ring-2 focus:ring-primary-500'\n              />\n            </div>\n            <div className='space-y-1.5'>\n              <label className='flex items-center gap-1 text-[10px] font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400'>\n                <Clock size={10}/> Start\n              </label>\n              <input \n                type='time' \n                value={startTime} \n                onChange={e => setStartTime(e.target.value)}\n                className='w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl px-3 py-2 text-xs outline-none focus:ring-2 focus:ring-primary-500'\n              />\n            </div>\n            <div className='space-y-1.5'>\n              <label className='flex items-center gap-1 text-[10px] font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400'>\n                <Clock size={10}/> End\n              </label>\n              <input \n                type='time' \n                value={endTime} \n                onChange={e => setEndTime(e.target.value)}\n                className='w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl px-3 py-2 text-xs outline-none focus:ring-2 focus:ring-primary-500'\n              />\n            </div>\n          </div>\n\n          <div className='flex flex-wrap items-center justify-between gap-4'>\n            <div className='flex items-center gap-1.5'>\n              {weekdays.map(d => (\n                <button\n                  key={d.bit}\n                  onClick={() => toggleDay(d.bit)}\n                  className={cn(\n                    'w-7 h-7 rounded-lg text-[10px] font-bold transition-all',\n                    (days & d.bit) ? 'bg-primary-600 text-white shadow-sm' : 'bg-white dark:bg-slate-900 text-slate-500 dark:text-slate-400 border border-slate-200 dark:border-slate-700 hover:border-slate-300 dark:hover:border-slate-600'\n                  )}\n                >\n                  {d.label}\n                </button>\n              ))}\n            </div>\n            \n            <div className='flex items-center gap-3'>\n              <label className='flex items-center gap-2 cursor-pointer group'>\n                <input \n                  type='checkbox' \n                  checked={isHoliday} \n                  onChange={e => setIsHoliday(e.target.checked)}\n                  className='w-4 h-4 rounded border-slate-300 dark:border-slate-600 text-primary-600 dark:text-primary-400 focus:ring-primary-500'\n                />\n                <span className='text-xs font-bold text-slate-500 dark:text-slate-400 group-hover:text-slate-700 dark:hover:text-slate-200 dark:text-slate-700 transition-colors'>Holiday Only</span>\n              </label>\n              \n              <button\n                onClick={() => addMutation.mutate({\n                  priority,\n                  multiplier,\n                  time_start: startTime || undefined,\n                  time_end: endTime || undefined,\n                  days_of_week: days,\n                  is_holiday: isHoliday\n                })}\n                disabled={addMutation.isPending}\n                className='bg-primary-600 text-white px-4 py-2 rounded-xl text-xs font-bold hover:bg-primary-700 transition-all shadow-sm'\n              >\n                {t('common.save')}\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n\n      <div className='space-y-2'>\n        {rules.sort((a, b) => b.priority - a.priority).map((rule: OvertimeRule) => (\n          <div key={rule.id} className='flex items-center justify-between p-3 bg-slate-50 dark:bg-slate-800/30 rounded-xl border border-slate-100 dark:border-slate-800/50 hover:bg-white dark:hover:bg-slate-900 transition-all'>\n            <div className='flex items-center gap-4'>\n              <div className='px-2 py-1 bg-primary-50 dark:bg-primary-950 text-primary-700 dark:text-primary-300 rounded-lg text-[10px] font-bold'>\n                {rule.multiplier}x\n              </div>\n              <div className='flex flex-col'>\n                <span className='text-xs font-bold text-slate-700 dark:text-slate-200'>\n                  {rule.time_start || '00:00'} - {rule.time_end || '23:59'}\n                </span>\n                <span className='text-[10px] text-slate-500 dark:text-slate-400 font-medium'>\n                  Priority: {rule.priority} | {rule.is_holiday ? 'Holidays Only' : 'Regular Days'}\n                </span>\n              </div>\n            </div>\n            {/* Delete button could go here */}\n          </div>\n        ))}\n        {rules.length === 0 && !isAdding && (\n          <p className='text-center py-4 text-xs text-slate-500 dark:text-slate-400 font-medium italic'>No rules defined yet.</p>\n        )}\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/payroll/PayrollDetailDrawer.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'UserCircle' is defined but never used. Allowed unused vars must match /^_/u.","line":8,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":8,"endColumn":13,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"UserCircle"},"fix":{"range":[131,146],"text":""},"desc":"Remove unused variable \"UserCircle\"."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from \"react\";\n\nimport * as Dialog from \"@radix-ui/react-dialog\";\nimport { \n  X, \n  History, \n  Settings2, \n  UserCircle,\n  Banknote,\n  CalendarDays\n} from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { useMyPermissions } from \"@/hooks/use-permissions\";\nimport { useWorkspace } from \"@/hooks/use-workspace\";\nimport { Employee, Payslip, AttendanceAdjustmentRequest } from \"@/lib/api/types\";\nimport { cn } from \"@/lib/utils\";\n\nimport EmployeeSalaryConfig from \"./EmployeeSalaryConfig\";\nimport PayrollTable from \"./PayrollTable\";\n\ninterface PayrollDetailDrawerProps {\n  isOpen: boolean;\n  onClose: () => void;\n  employee: Employee | null;\n  workspaceId: string;\n  payslips: Payslip[];\n  isLoadingPayslips: boolean;\n  adjustments: AttendanceAdjustmentRequest[];\n  onResolveAdjustments: () => void;\n}\n\nexport default function PayrollDetailDrawer({\n  isOpen,\n  onClose,\n  employee,\n  workspaceId,\n  payslips,\n  isLoadingPayslips,\n  adjustments,\n  onResolveAdjustments\n}: PayrollDetailDrawerProps) {\n  const { t } = useTranslation();\n  const { workspace } = useWorkspace(workspaceId);\n  const { hasPermission } = useMyPermissions();\n  const canReadSensitive = hasPermission(\"payroll:sensitive:read\");\n  const [activeTab, setActiveTab] = useState<\"history\" | \"config\">(\"history\");\n\n  if (!employee) return null;\n\n  return (\n    <Dialog.Root open={isOpen} onOpenChange={onClose}>\n      <Dialog.Portal>\n        <Dialog.Overlay className=\"fixed inset-0 bg-slate-900/20 backdrop-blur-lg z-50 animate-in fade-in duration-500\" />\n        <Dialog.Content className=\"fixed top-0 right-0 h-full w-full max-w-3xl bg-white dark:bg-slate-900 shadow-premium-2xl z-50 animate-in slide-in-from-right duration-500 flex flex-col outline-none\">\n          {/* Header */}\n          <header className=\"p-10 border-b border-slate-50 dark:border-slate-800 flex items-center justify-between bg-slate-50 dark:bg-slate-800/30\">\n            <div className=\"flex items-center gap-6\">\n              <div className=\"w-20 h-20 bg-primary-600 rounded-[2rem] flex items-center justify-center text-white text-3xl font-bold shadow-xl shadow-primary-100 dark:shadow-black/30 rotate-3 hover:rotate-0 transition-transform duration-500\">\n                {employee.full_name[0]}\n              </div>\n              <div className=\"space-y-1\">\n                <Dialog.Title className=\"text-3xl font-bold text-slate-700 dark:text-slate-200 tracking-tight uppercase\">\n                  {employee.full_name}\n                </Dialog.Title>\n                <div className=\"flex items-center gap-3\">\n                  <span className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest bg-white dark:bg-slate-900 px-3 py-1.5 rounded-xl border border-slate-100 dark:border-slate-800 shadow-sm\">\n                    {employee.employee_id_number}\n                  </span>\n                  <div className=\"w-1.5 h-1.5 bg-primary-200 rounded-full\" />\n                  <span className=\"text-[10px] font-bold text-primary-600 dark:text-primary-400 uppercase tracking-widest\">\n                    {employee.department_name || t(\"departments.not_assigned\")}\n                  </span>\n                </div>\n              </div>\n            </div>\n            <Dialog.Close asChild>\n              <button className=\"w-12 h-12 rounded-2xl bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 flex items-center justify-center text-slate-300 dark:text-slate-600 hover:text-rose-600 dark:text-rose-300 hover:border-rose-100 dark:border-rose-800 hover:shadow-md transition-all active:scale-90\">\n                <X size={24} />\n              </button>\n            </Dialog.Close>\n          </header>\n\n          {/* Premium Tab Switcher */}\n          <nav className=\"px-10 py-6 bg-white dark:bg-slate-900 border-b border-slate-50 dark:border-slate-800\">\n            <div className=\"flex bg-slate-100 dark:bg-slate-700/50 p-1.5 rounded-[22px] w-fit border border-slate-200 dark:border-slate-700/50 shadow-inner\">\n              <button\n                onClick={() => setActiveTab(\"history\")}\n                className={cn(\n                  \"flex items-center gap-2 px-8 py-2.5 rounded-[18px] text-xs font-bold uppercase tracking-widest transition-all\",\n                  activeTab === \"history\" ? \"bg-white dark:bg-slate-900 text-primary-600 dark:text-primary-400 shadow-sm border border-slate-100 dark:border-slate-800\" : \"text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 dark:text-slate-700\"\n                )}\n              >\n                <History size={14} /> {t(\"payroll.history_title\")}\n              </button>\n              <button\n                onClick={() => setActiveTab(\"config\")}\n                className={cn(\n                  \"flex items-center gap-2 px-8 py-2.5 rounded-[18px] text-xs font-bold uppercase tracking-widest transition-all\",\n                  activeTab === \"config\" ? \"bg-white dark:bg-slate-900 text-primary-600 dark:text-primary-400 shadow-sm border border-slate-100 dark:border-slate-800\" : \"text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 dark:text-slate-700\"\n                )}\n              >\n                <Settings2 size={14} /> {t(\"common.payroll.employee_config.tab_title\")}\n              </button>\n            </div>\n          </nav>\n\n          {/* Content */}\n          <main className=\"flex-1 overflow-y-auto p-10 bg-white dark:bg-slate-900 custom-scrollbar scroll-smooth\">\n            {activeTab === \"history\" ? (\n              <div className=\"space-y-10 animate-in fade-in slide-in-from-bottom-4 duration-700\">\n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n                   <div className=\"bg-slate-50 dark:bg-slate-800/50 p-8 rounded-[2.5rem] border border-slate-100 dark:border-slate-800 flex items-center gap-5 shadow-inner\">\n                      <div className=\"w-14 h-14 bg-white dark:bg-slate-900 rounded-2xl flex items-center justify-center text-primary-600 dark:text-primary-400 shadow-sm border border-primary-50\">\n                        <Banknote size={24} />\n                      </div>\n                      <div>\n                        <p className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.2em] mb-1 opacity-70\">{t(\"common.payroll.table.net_pay\")} (Latest)</p>\n                        <p className=\"text-2xl font-bold text-slate-700 dark:text-slate-200 font-mono tracking-tighter\">\n                          {!canReadSensitive ? \"***\" : (payslips.length > 0 \n                            ? new Intl.NumberFormat('vi-VN').format(parseFloat(payslips[0].net_pay_amount))\n                            : \"—\")}\n                        </p>\n                      </div>\n                   </div>\n                   <div className=\"bg-slate-50 dark:bg-slate-800/50 p-8 rounded-[2.5rem] border border-slate-100 dark:border-slate-800 flex items-center gap-5 shadow-inner\">\n                      <div className=\"w-14 h-14 bg-white dark:bg-slate-900 rounded-2xl flex items-center justify-center text-emerald-600 dark:text-emerald-300 shadow-sm border border-emerald-50\">\n                        <CalendarDays size={24} />\n                      </div>\n                      <div>\n                        <p className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.2em] mb-1 opacity-70\">{t(\"employees.hire_date\")}</p>\n                        <p className=\"text-2xl font-bold text-slate-700 dark:text-slate-200 font-mono tracking-tighter\">{employee.hire_date}</p>\n                      </div>\n                   </div>\n                </div>\n\n                <div className=\"space-y-6\">\n                  <div className=\"flex items-center gap-3 px-2\">\n                    <div className=\"w-1.5 h-6 bg-primary-600 rounded-full\" />\n                    <span className=\"text-xs font-bold text-slate-800 dark:text-slate-100 uppercase tracking-[0.25em]\">{t(\"payroll.history_title\")} Detail</span>\n                  </div>\n                  <PayrollTable \n                    employee={employee} \n                    workspace={workspace || null}\n                    payslips={payslips} \n                    isLoading={isLoadingPayslips} \n                    adjustments={adjustments}\n                    onResolveAdjustments={onResolveAdjustments}\n                  />\n                </div>\n              </div>\n            ) : (\n              <div className=\"animate-in fade-in slide-in-from-bottom-4 duration-700\">\n                <EmployeeSalaryConfig wsId={workspaceId} employeeId={employee.id} />\n              </div>\n            )}\n          </main>\n        </Dialog.Content>\n      </Dialog.Portal>\n    </Dialog.Root>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/payroll/PayrollPriorityLegend.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/payroll/PayrollRulesManager.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'CircleDashed' is defined but never used. Allowed unused vars must match /^_/u.","line":4,"column":30,"nodeType":"Identifier","messageId":"unusedVar","endLine":4,"endColumn":42,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"CircleDashed"},"fix":{"range":[148,162],"text":""},"desc":"Remove unused variable \"CircleDashed\"."}]},{"ruleId":"jsx-a11y/click-events-have-key-events","severity":2,"message":"Visible, non-interactive elements with click handlers must have at least one keyboard listener.","line":65,"column":15,"nodeType":"JSXOpeningElement","endLine":68,"endColumn":16},{"ruleId":"jsx-a11y/no-static-element-interactions","severity":2,"message":"Avoid non-native interactive elements. If using native HTML is not possible, add an appropriate role and support for tabbing, mouse, keyboard, and touch inputs to an interactive content ele