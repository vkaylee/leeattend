tNever","fix":{"range":[3784,3787],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":116,"column":18,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":116,"endColumn":21,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[4281,4284],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[4281,4284],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":151,"column":18,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":151,"endColumn":21,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[5274,5277],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[5274,5277],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":6,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { QueryClient, QueryClientProvider, useQuery  } from \"@tanstack/react-query\";\nimport { render, screen, fireEvent } from \"@testing-library/react\";\nimport { describe, it, expect, vi, beforeEach } from \"vitest\";\n\nimport { EmployeeSearch } from \"../EmployeeSearch\";\n\n// Create a simpler mock for the query hook\nvi.mock(\"@tanstack/react-query\", async () => {\n  const actual = await vi.importActual(\"@tanstack/react-query\");\n  return {\n    ...actual,\n    useQuery: vi.fn(),\n  };\n});\n\n\nconst queryClient = new QueryClient({\n  defaultOptions: { queries: { retry: false } },\n});\n\nconst wrapper = ({ children }: { children: React.ReactNode }) => (\n  <QueryClientProvider client={queryClient}>{children}</QueryClientProvider>\n);\n\ndescribe(\"EmployeeSearch Component\", () => {\n  beforeEach(() => {\n    vi.clearAllMocks();\n  });\n\n  const mockEmployees = [\n    { id: \"1\", full_name: \"John Doe\", employee_id_number: \"E001\" },\n    { id: \"2\", full_name: \"Jane Smith\", employee_id_number: \"E002\" },\n  ];\n\n  it(\"calls onChange when an employee is selected\", async () => {\n    (useQuery as any).mockReturnValue({\n      data: { data: mockEmployees },\n      isLoading: false,\n    });\n\n    const onChange = vi.fn();\n    // We test the internal handleSelect by bypassing the complex Radix UI\n    // and just checking if the component passes correct data to Combobox\n    render(<EmployeeSearch workspaceId=\"ws-1\" onChange={onChange} />, { wrapper });\n\n    // Fallback select is used when Radix trigger is not fully rendered in JSDOM\n    expect(screen.getByRole(\"combobox\")).toBeDefined();\n  });\n\n  it(\"renders chips in multiple mode\", () => {\n    (useQuery as any).mockReturnValue({\n      data: { data: mockEmployees },\n      isLoading: false,\n    });\n\n    const onChange = vi.fn();\n    const value = [\"1\"];\n    // In multi-mode, EmployeeSearch manages 'selectedMeta' internally when handleSelect is called.\n    // To test initial chips, we'd need to mock the internal state or pass it as prop.\n    // For now, we verify it renders without crashing.\n    render(<EmployeeSearch workspaceId=\"ws-1\" multiple value={value} onChange={onChange} />, { wrapper });\n\n    // With the new useEffect, it should find '1' in mockEmployees and show 'John Doe'\n    // It appears in both the chip and the hidden select option\n    expect(screen.getAllByText(\"John Doe\").length).toBeGreaterThanOrEqual(1);\n  });\n\n  it(\"preserves server-side relevance order (exact match > prefix > contains)\", () => {\n    // Simulate server returning results in relevance-ranked order:\n    // #16 (exact) > #161 (prefix) > #1649 (prefix) > #416 (contains)\n    const rankedEmployees = [\n      { id: \"a\", full_name: \"Nguyen Van A\", employee_id_number: \"16\" },\n      { id: \"b\", full_name: \"Tran Van B\", employee_id_number: \"161\" },\n      { id: \"c\", full_name: \"Le Van C\", employee_id_number: \"1649\" },\n      { id: \"d\", full_name: \"Pham Van D\", employee_id_number: \"416\" },\n    ];\n\n    (useQuery as any).mockReturnValue({\n      data: { data: rankedEmployees },\n      isLoading: false,\n    });\n\n    const onChange = vi.fn();\n    render(<EmployeeSearch workspaceId=\"ws-1\" onChange={onChange} />, { wrapper });\n\n    // The combobox should be rendered with options in the exact order from the API\n    const combobox = screen.getByRole(\"combobox\");\n    expect(combobox).toBeDefined();\n\n    // Verify the component did NOT re-sort the data alphabetically\n    // by checking the first option is still the exact match employee\n    const allOptions = screen.queryAllByText(/16|161|1649|416/);\n    if (allOptions.length > 0) {\n      // First visible option should be the exact match \"16\", not \"1649\" or \"416\"\n      expect(allOptions[0].textContent).toContain(\"16\");\n    }\n  });\n\n  it(\"passes keyboardShortcut prop to Combobox\", () => {\n    (useQuery as any).mockReturnValue({\n      data: { data: mockEmployees },\n      isLoading: false,\n    });\n\n    const onChange = vi.fn();\n    render(\n      <EmployeeSearch workspaceId=\"ws-1\" onChange={onChange} keyboardShortcut=\"/\" />,\n      { wrapper }\n    );\n\n    // Should render without crashing with the keyboardShortcut prop\n    expect(screen.getByRole(\"combobox\")).toBeDefined();\n  });\n\n  it(\"calls onSelectEmployee with the full Employee object when selected via hidden select\", () => {\n    (useQuery as any).mockReturnValue({\n      data: { data: mockEmployees },\n      isLoading: false,\n    });\n\n    const onChange = vi.fn();\n    const onSelectEmployee = vi.fn();\n\n    render(\n      <EmployeeSearch\n        workspaceId=\"ws-1\"\n        onChange={onChange}\n        onSelectEmployee={onSelectEmployee}\n      />,\n      { wrapper }\n    );\n\n    // Use the hidden select element (sr-only) to simulate selection\n    const hiddenSelect = screen.getByRole(\"combobox\");\n    fireEvent.change(hiddenSelect, { target: { value: \"1\" } });\n\n    // onChange should have been called with just the id\n    expect(onChange).toHaveBeenCalledWith(\"1\");\n\n    // onSelectEmployee should have been called with the full employee object\n    expect(onSelectEmployee).toHaveBeenCalledWith(\n      expect.objectContaining({\n        id: \"1\",\n        full_name: \"John Doe\",\n        employee_id_number: \"E001\",\n      })\n    );\n  });\n\n  it(\"does NOT call onSelectEmployee when employee is not found in data\", () => {\n    (useQuery as any).mockReturnValue({\n      data: { data: mockEmployees },\n      isLoading: false,\n    });\n\n    const onChange = vi.fn();\n    const onSelectEmployee = vi.fn();\n\n    render(\n      <EmployeeSearch\n        workspaceId=\"ws-1\"\n        onChange={onChange}\n        onSelectEmployee={onSelectEmployee}\n      />,\n      { wrapper }\n    );\n\n    // Try selecting an ID that does not exist in mockEmployees\n    const hiddenSelect = screen.getByRole(\"combobox\");\n    fireEvent.change(hiddenSelect, { target: { value: \"non-existent-id\" } });\n\n    // onChange is still called (to update the value), but with empty string since it's not found\n    expect(onChange).toHaveBeenCalledWith(\"\");\n\n    // But onSelectEmployee should NOT have been called since no Employee was found\n    expect(onSelectEmployee).not.toHaveBeenCalled();\n  });\n});","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/common/__tests__/ErrorBoundary.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/common/__tests__/FloatingRecordBadge.test.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'screen' is defined but never used. Allowed unused vars must match /^_/u.","line":3,"column":18,"nodeType":"Identifier","messageId":"unusedVar","endLine":3,"endColumn":24,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"screen"},"fix":{"range":[43,51],"text":""},"desc":"Remove unused variable \"screen\"."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from \"react\";\n\nimport { render, screen } from \"@testing-library/react\";\nimport { describe, it, expect } from \"vitest\";\n\nimport FloatingRecordBadge from \"../FloatingRecordBadge\";\n\ndescribe(\"FloatingRecordBadge\", () => {\n    it(\"renders loaded and total counts\", () => {\n        const { container } = render(<FloatingRecordBadge loaded={5} total={20} />);\n        expect(container.textContent).toContain(\"5\");\n        expect(container.textContent).toContain(\"20\");\n    });\n\n    it(\"renders custom label\", () => {\n        const { container } = render(\n            <FloatingRecordBadge loaded={3} total={10} label=\"items\" />\n        );\n        expect(container.textContent).toContain(\"items\");\n    });\n\n    it(\"renders default 'records' label\", () => {\n        const { container } = render(\n            <FloatingRecordBadge loaded={1} total={1} />\n        );\n        expect(container.textContent).toContain(\"records\");\n    });\n\n    it(\"uses fixed bottom-6 positioning\", () => {\n        const { container } = render(<FloatingRecordBadge loaded={1} total={1} />);\n        const wrapper = container.firstChild as HTMLElement;\n        expect(wrapper.className).toContain(\"fixed\");\n        expect(wrapper.className).toContain(\"bottom-6\");\n    });\n\n    it(\"renders default variant with slate/primary colors\", () => {\n        const { container } = render(<FloatingRecordBadge loaded={1} total={1} />);\n        const badge = container.querySelector(\".border-slate-200\");\n        expect(badge).toBeDefined();\n    });\n\n    it(\"renders amber variant with amber colors\", () => {\n        const { container } = render(\n            <FloatingRecordBadge loaded={1} total={1} variant=\"amber\" />\n        );\n        const badge = container.querySelector(\".border-amber-200\");\n        expect(badge).toBeDefined();\n    });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/common/__tests__/InfiniteScrollSentinel.test.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'screen' is defined but never used. Allowed unused vars must match /^_/u.","line":3,"column":18,"nodeType":"Identifier","messageId":"unusedVar","endLine":3,"endColumn":24,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"screen"},"fix":{"range":[58,66],"text":""},"desc":"Remove unused variable \"screen\"."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { createRef } from \"react\";\n\nimport { render, screen } from \"@testing-library/react\";\nimport { describe, it, expect, vi } from \"vitest\";\n\nimport InfiniteScrollSentinel from \"../InfiniteScrollSentinel\";\n\n// Mock i18n\nvi.mock(\"react-i18next\", () => ({\n    useTranslation: () => ({\n        t: (key: string, fallback?: string) => fallback || key,\n        i18n: { changeLanguage: () => Promise.resolve(), language: \"en\" },\n    }),\n}));\n\ndescribe(\"InfiniteScrollSentinel\", () => {\n    it(\"renders a table row with the sentinel ref\", () => {\n        const ref = createRef<HTMLTableRowElement>();\n        const { container } = render(\n            <table><tbody>\n                <InfiniteScrollSentinel sentinelRef={ref} isFetchingNextPage={false} colSpan={4} />\n            </tbody></table>\n        );\n        const row = container.querySelector(\"tr\");\n        expect(row).toBeDefined();\n    });\n\n    it(\"shows Loader2 spinner when isFetchingNextPage is true\", () => {\n        const ref = createRef<HTMLTableRowElement>();\n        const { container } = render(\n            <table><tbody>\n                <InfiniteScrollSentinel sentinelRef={ref} isFetchingNextPage={true} colSpan={4} />\n            </tbody></table>\n        );\n        // Loader2 renders as an SVG with animate-spin class\n        const spinner = container.querySelector(\".animate-spin\");\n        expect(spinner).toBeDefined();\n    });\n\n    it(\"does NOT show spinner when isFetchingNextPage is false\", () => {\n        const ref = createRef<HTMLTableRowElement>();\n        const { container } = render(\n            <table><tbody>\n                <InfiniteScrollSentinel sentinelRef={ref} isFetchingNextPage={false} colSpan={4} />\n            </tbody></table>\n        );\n        const spinner = container.querySelector(\".animate-spin\");\n        expect(spinner).toBeNull();\n    });\n\n    it(\"uses correct colSpan\", () => {\n        const ref = createRef<HTMLTableRowElement>();\n        const { container } = render(\n            <table><tbody>\n                <InfiniteScrollSentinel sentinelRef={ref} isFetchingNextPage={false} colSpan={7} />\n            </tbody></table>\n        );\n        const td = container.querySelector(\"td\");\n        expect(td?.getAttribute(\"colspan\")).toBe(\"7\");\n    });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/common/__tests__/MonthYearPicker.test.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":9,"column":32,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":9,"endColumn":35,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[283,286],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[283,286],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { render, screen, fireEvent } from \"@testing-library/react\";\nimport { describe, it, expect, vi } from \"vitest\";\n\nimport { MonthYearPicker } from \"../MonthYearPicker\";\n\n// Mock i18next\nvi.mock(\"react-i18next\", () => ({\n  useTranslation: () => ({\n    t: (key: string, options?: any) => {\n        if (key === \"common.month_short\") return `Tháng ${options.month}`;\n        if (key === \"common.filters.last_month\") return \"Tháng trước\";\n        if (key === \"common.filters.this_month\") return \"Tháng này\";\n        return key;\n    },\n  }),\n}));\n\ndescribe(\"MonthYearPicker\", () => {\n  const onChange = vi.fn();\n\n  it(\"renders correctly with provided month and year\", () => {\n    render(<MonthYearPicker month={5} year={2026} onChange={onChange} />);\n\n    expect(screen.getByText(\"2026\")).toBeDefined();\n    // Check if 12 months are rendered as numbers\n    for (let i = 1; i <= 12; i++) {\n      expect(screen.getByText(i.toString())).toBeDefined();\n    }\n  });\n\n  it(\"calls onChange when a month is clicked\", () => {\n    render(<MonthYearPicker month={5} year={2026} onChange={onChange} />);\n\n    // Select by aria-label since text is just \"10\"\n    fireEvent.click(screen.getByLabelText(\"Tháng 10\"));\n    expect(onChange).toHaveBeenCalledWith(10, 2026);\n  });\n\n  it(\"calls onChange with updated year when arrows are clicked\", () => {\n    render(<MonthYearPicker month={5} year={2026} onChange={onChange} />);\n\n    const buttons = screen.getAllByRole(\"button\");\n    const prevYearBtn = buttons[0]; // First button is ChevronLeft for year\n    const nextYearBtn = buttons[1]; // Second button is ChevronRight for year\n\n    fireEvent.click(prevYearBtn);\n    expect(onChange).toHaveBeenCalledWith(5, 2025);\n\n    fireEvent.click(nextYearBtn);\n    expect(onChange).toHaveBeenCalledWith(5, 2027);\n  });\n\n  it(\"sets last month when shortcut is clicked\", () => {\n    render(<MonthYearPicker month={5} year={2026} onChange={onChange} />);\n\n    fireEvent.click(screen.getByText(\"Tháng trước\"));\n    \n    const d = new Date();\n    d.setMonth(d.getMonth() - 1);\n    expect(onChange).toHaveBeenCalledWith(d.getMonth() + 1, d.getFullYear());\n  });\n\n  it(\"sets current month when shortcut is clicked\", () => {\n    render(<MonthYearPicker month={1} year={2020} onChange={onChange} />);\n\n    fireEvent.click(screen.getByText(\"Tháng này\"));\n    \n    const d = new Date();\n    expect(onChange).toHaveBeenCalledWith(d.getMonth() + 1, d.getFullYear());\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/common/__tests__/NavigableList.test.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'fireEvent' is defined but never used. Allowed unused vars must match /^_/u.","line":3,"column":26,"nodeType":"Identifier","messageId":"unusedVar","endLine":3,"endColumn":35,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"fireEvent"},"fix":{"range":[51,62],"text":""},"desc":"Remove unused variable \"fireEvent\"."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":17,"column":59,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":17,"endColumn":62,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[513,516],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[513,516],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":21,"column":41,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":21,"endColumn":44,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[649,652],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[649,652],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"import-x/no-named-as-default-member","severity":1,"message":"Caution: `React` also has a named export `createRef`. Check if you meant to write `import {createRef} from 'react'` instead.","line":330,"column":21,"nodeType":"MemberExpression","messageId":"member","endLine":330,"endColumn":36}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from \"react\";\n\nimport { render, screen, fireEvent } from \"@testing-library/react\";\nimport userEvent from \"@testing-library/user-event\";\nimport { describe, it, expect, vi, beforeEach } from \"vitest\";\n\nimport NavigableList from \"../NavigableList\";\n\nimport type { NavigableListColumn } from \"../NavigableList\";\n\n// Mock IntersectionObserver for jsdom\nclass MockIntersectionObserver {\n    observe() { }\n    unobserve() { }\n    disconnect() { }\n}\nwindow.IntersectionObserver = MockIntersectionObserver as any;\n\n// Mock scroll methods not available in jsdom\nElement.prototype.scrollIntoView = vi.fn();\nElement.prototype.scrollTo = vi.fn() as any;\n\nvi.mock(\"react-i18next\", () => ({\n    useTranslation: () => ({\n        t: (key: string, fallback?: string) => fallback || key,\n        i18n: { changeLanguage: () => Promise.resolve(), language: \"en\" },\n    }),\n}));\n\n// ---------------------------------------------------------------------------\n// Test data\n// ---------------------------------------------------------------------------\n\ninterface TestItem {\n    id: string;\n    name: string;\n    value: number;\n}\n\nconst items: TestItem[] = [\n    { id: \"1\", name: \"Alpha\", value: 10 },\n    { id: \"2\", name: \"Beta\", value: 20 },\n    { id: \"3\", name: \"Charlie\", value: 30 },\n];\n\nconst columns: NavigableListColumn<TestItem>[] = [\n    { key: \"name\", header: \"Name\", cell: (item) => item.name },\n    { key: \"value\", header: \"Value\", cell: (item) => `${item.value}`, cellClassName: \"text-right\" },\n];\n\nconst defaultProps = {\n    columns,\n    items,\n    itemKey: (item: TestItem) => item.id,\n    onSelect: vi.fn(),\n};\n\n// ---------------------------------------------------------------------------\n// Tests\n// ---------------------------------------------------------------------------\n\ndescribe(\"NavigableList\", () => {\n    beforeEach(() => { vi.clearAllMocks(); });\n\n    // ── Rendering ──────────────────────────────────────────────\n\n    it(\"renders all items\", () => {\n        render(<NavigableList {...defaultProps} />);\n        expect(screen.getByText(\"Alpha\")).toBeDefined();\n        expect(screen.getByText(\"Beta\")).toBeDefined();\n        expect(screen.getByText(\"Charlie\")).toBeDefined();\n    });\n\n    it(\"renders column headers\", () => {\n        render(<NavigableList {...defaultProps} />);\n        expect(screen.getByText(\"Name\")).toBeDefined();\n        expect(screen.getByText(\"Value\")).toBeDefined();\n    });\n\n    it(\"renders empty state when no items\", () => {\n        render(<NavigableList {...defaultProps} items={[]} emptyMessage=\"Nothing here\" />);\n        expect(screen.getByText(\"Nothing here\")).toBeDefined();\n    });\n\n    it(\"renders loading skeletons when isLoading\", () => {\n        const { container } = render(<NavigableList {...defaultProps} isLoading skeletonRows={3} />);\n        const skeletons = container.querySelectorAll(\".animate-pulse\");\n        // 3 skeleton rows × 2 columns = 6 pulse divs\n        expect(skeletons.length).toBe(6);\n    });\n\n    it(\"hides columns with hidden=true\", () => {\n        const cols: NavigableListColumn<TestItem>[] = [\n            ...columns,\n            { key: \"secret\", header: \"Secret\", cell: () => \"hidden\", hidden: true },\n        ];\n        render(<NavigableList {...defaultProps} columns={cols} />);\n        expect(screen.queryByText(\"Secret\")).toBeNull();\n        expect(screen.queryByText(\"hidden\")).toBeNull();\n    });\n\n    // ── Search ─────────────────────────────────────────────────\n\n    it(\"renders search box when onSearchChange is provided\", () => {\n        render(\n            <NavigableList\n                {...defaultProps}\n                searchValue=\"\"\n                onSearchChange={vi.fn()}\n                searchTestId=\"test-search\"\n            />\n        );\n        expect(screen.getByTestId(\"test-search\")).toBeDefined();\n    });\n\n    it(\"does not render search box when onSearchChange is omitted\", () => {\n        render(<NavigableList {...defaultProps} />);\n        expect(screen.queryByTestId(\"navigable-list-search\")).toBeNull();\n    });\n\n    // ── Row interaction ────────────────────────────────────────\n\n    it(\"calls onSelect when a row is clicked\", async () => {\n        const onSelect = vi.fn();\n        const user = userEvent.setup();\n        render(<NavigableList {...defaultProps} onSelect={onSelect} />);\n\n        await user.click(screen.getByText(\"Beta\"));\n        expect(onSelect).toHaveBeenCalledWith(items[1]);\n    });\n\n    it(\"highlights selected row\", () => {\n        const { container } = render(\n            <NavigableList {...defaultProps} selectedKey=\"2\" />\n        );\n        const row = container.querySelector(\"#nav-row-1\");\n        expect(row?.className).toContain(\"bg-primary-50\");\n    });\n\n    it(\"shows active bar on selected row when showActiveBar is true\", () => {\n        const { container } = render(\n            <NavigableList {...defaultProps} selectedKey=\"2\" showActiveBar />\n        );\n        const bar = container.querySelector(\".bg-primary-600.rounded-r-full\");\n        expect(bar).toBeDefined();\n    });\n\n    // ── Keyboard navigation ────────────────────────────────────\n\n    it(\"ArrowDown moves focus to the next row\", async () => {\n        const user = userEvent.setup();\n        const { container } = render(\n            <NavigableList\n                {...defaultProps}\n                searchValue=\"\"\n                onSearchChange={vi.fn()}\n                searchTestId=\"test-search\"\n            />\n        );\n\n        const searchInput = screen.getByTestId(\"test-search\");\n        await user.click(searchInput);\n        await user.keyboard(\"{ArrowDown}\");\n\n        // Focus should move from 0 to 1 — row 1 should have focused class\n        const row1 = container.querySelector(\"#nav-row-1\");\n        expect(row1?.className).toContain(\"ring-primary-500\");\n    });\n\n    it(\"ArrowUp moves focus to the previous row\", async () => {\n        const user = userEvent.setup();\n        const { container } = render(\n            <NavigableList\n                {...defaultProps}\n                searchValue=\"\"\n                onSearchChange={vi.fn()}\n                searchTestId=\"test-search\"\n            />\n        );\n\n        const searchInput = screen.getByTestId(\"test-search\");\n        await user.click(searchInput);\n        // Go down twice, then up once → should be at index 1\n        await user.keyboard(\"{ArrowDown}{ArrowDown}{ArrowUp}\");\n\n        const row1 = container.querySelector(\"#nav-row-1\");\n        expect(row1?.className).toContain(\"ring-primary-500\");\n    });\n\n    it(\"Enter calls onSelect with the focused item\", async () => {\n        const onSelect = vi.fn();\n        const user = userEvent.setup();\n        render(\n            <NavigableList\n                {...defaultProps}\n                onSelect={onSelect}\n                searchValue=\"\"\n                onSearchChange={vi.fn()}\n                searchTestId=\"test-search\"\n            />\n        );\n\n        const searchInput = screen.getByTestId(\"test-search\");\n        await user.click(searchInput);\n        await user.keyboard(\"{ArrowDown}{Enter}\");\n\n        expect(onSelect).toHaveBeenCalledWith(items[1]);\n    });\n\n    it(\"ArrowDown does not go past the last item\", async () => {\n        const user = userEvent.setup();\n        const { container } = render(\n            <NavigableList\n                {...defaultProps}\n                searchValue=\"\"\n                onSearchChange={vi.fn()}\n                searchTestId=\"test-search\"\n            />\n        );\n\n        const searchInput = screen.getByTestId(\"test-search\");\n        await user.click(searchInput);\n        // Press ArrowDown 10 times (more than items.length)\n        for (let i = 0; i < 10; i++) {\n            await user.keyboard(\"{ArrowDown}\");\n        }\n\n        // Should be clamped at last index (2)\n        const lastRow = container.querySelector(\"#nav-row-2\");\n        expect(lastRow?.className).toContain(\"ring-primary-500\");\n    });\n\n    it(\"ArrowUp does not go below 0\", async () => {\n        const user = userEvent.setup();\n        const { container } = render(\n            <NavigableList\n                {...defaultProps}\n                searchValue=\"\"\n                onSearchChange={vi.fn()}\n                searchTestId=\"test-search\"\n            />\n        );\n\n        const searchInput = screen.getByTestId(\"test-search\");\n        await user.click(searchInput);\n        // Press ArrowUp when already at 0 — should stay at 0\n        await user.keyboard(\"{ArrowUp}{ArrowUp}\");\n\n        // Row 0 should have focus ring (ArrowUp sets hasNavigated=true)\n        const firstRow = container.querySelector(\"#nav-row-0\");\n        expect(firstRow?.className).toContain(\"ring-primary-500\");\n        // Row 1 should NOT have focus ring\n        const secondRow = container.querySelector(\"#nav-row-1\");\n        expect(secondRow?.className).not.toContain(\"ring-primary-500\");\n    });\n\n    // ── Sortable headers ───────────────────────────────────────\n\n    it(\"calls onHeaderClick when a sortable header is clicked\", async () => {\n        const onSort = vi.fn();\n        const user = userEvent.setup();\n        const sortableCols: NavigableListColumn<TestItem>[] = [\n            { key: \"name\", header: \"Name\", cell: (item) => item.name, onHeaderClick: onSort },\n            { key: \"value\", header: \"Value\", cell: (item) => `${item.value}` },\n        ];\n\n        render(<NavigableList {...defaultProps} columns={sortableCols} />);\n        await user.click(screen.getByText(\"Name\"));\n        expect(onSort).toHaveBeenCalledTimes(1);\n    });\n\n    it(\"makes sortable headers have cursor-pointer class\", () => {\n        const sortableCols: NavigableListColumn<TestItem>[] = [\n            { key: \"name\", header: \"Name\", cell: (item) => item.name, onHeaderClick: vi.fn() },\n            { key: \"value\", header: \"Value\", cell: (item) => `${item.value}` },\n        ];\n        const { container } = render(<NavigableList {...defaultProps} columns={sortableCols} />);\n        const headers = container.querySelectorAll(\"th\");\n        expect(headers[0].className).toContain(\"cursor-pointer\");\n        expect(headers[1].className).not.toContain(\"cursor-pointer\");\n    });\n\n    // ── Chevrons ───────────────────────────────────────────────\n\n    it(\"renders chevrons when showChevron is true (default)\", () => {\n        const { container } = render(<NavigableList {...defaultProps} />);\n        const chevrons = container.querySelectorAll(\"svg.lucide-chevron-right\");\n        expect(chevrons.length).toBe(items.length);\n    });\n\n    it(\"hides chevrons when showChevron is false\", () => {\n        const { container } = render(<NavigableList {...defaultProps} showChevron={false} />);\n        const chevrons = container.querySelectorAll(\"svg.lucide-chevron-right\");\n        expect(chevrons.length).toBe(0);\n    });\n\n    // ── Custom row IDs and test IDs ────────────────────────────\n\n    it(\"sets row IDs with custom rowIdPrefix\", () => {\n        const { container } = render(\n            <NavigableList {...defaultProps} rowIdPrefix=\"custom-row\" />\n        );\n        expect(container.querySelector(\"#custom-row-0\")).toBeDefined();\n        expect(container.querySelector(\"#custom-row-1\")).toBeDefined();\n    });\n\n    it(\"sets data-testid with testIdPrefix\", () => {\n        render(<NavigableList {...defaultProps} testIdPrefix=\"item\" />);\n        expect(screen.getByTestId(\"item-1\")).toBeDefined();\n        expect(screen.getByTestId(\"item-2\")).toBeDefined();\n        expect(screen.getByTestId(\"item-3\")).toBeDefined();\n    });\n\n    // ── Header slot ────────────────────────────────────────────\n\n    it(\"renders headerSlot content above the table\", () => {\n        render(\n            <NavigableList\n                {...defaultProps}\n                headerSlot={<div data-testid=\"custom-header\">Filters</div>}\n            />\n        );\n        expect(screen.getByTestId(\"custom-header\")).toBeDefined();\n        expect(screen.getByText(\"Filters\")).toBeDefined();\n    });\n\n    // ── onKeyDownRef ───────────────────────────────────────────\n\n    it(\"exposes keyboard handler via onKeyDownRef\", () => {\n        const ref = React.createRef<((e: React.KeyboardEvent<HTMLInputElement>) => void) | null>() as React.MutableRefObject<((e: React.KeyboardEvent<HTMLInputElement>) => void) | null>;\n        ref.current = null;\n\n        render(<NavigableList {...defaultProps} onKeyDownRef={ref} />);\n        expect(ref.current).toBeDefined();\n        expect(typeof ref.current).toBe(\"function\");\n    });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/common/__tests__/NewVersionBanner.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/common/__tests__/SearchBox.test.tsx","messages":[{"ruleId":"jsx-a11y/no-autofocus","severity":2,"message":"The autoFocus prop should not be used, as it can reduce usability and accessibility for users.","line":57,"column":83,"nodeType":"JSXAttribute","endLine":57,"endColumn":100}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from \"react\";\n\nimport { render, screen } from \"@testing-library/react\";\nimport userEvent from \"@testing-library/user-event\";\nimport { describe, it, expect, vi } from \"vitest\";\n\nimport SearchBox from \"../SearchBox\";\n\ndescribe(\"SearchBox\", () => {\n    it(\"renders with placeholder text\", () => {\n        render(<SearchBox value=\"\" onChange={() => { }} placeholder=\"Search employees...\" />);\n        expect(screen.getByPlaceholderText(\"Search employees...\")).toBeDefined();\n    });\n\n    it(\"renders the search icon\", () => {\n        const { container } = render(<SearchBox value=\"\" onChange={() => { }} />);\n        const svg = container.querySelector(\"svg\");\n        expect(svg).toBeDefined();\n    });\n\n    it(\"calls onChange when typing\", async () => {\n        const onChange = vi.fn();\n        const user = userEvent.setup();\n        render(<SearchBox value=\"\" onChange={onChange} data-testid=\"search\" />);\n\n        const input = screen.getByTestId(\"search\");\n        await user.type(input, \"A\");\n        expect(onChange).toHaveBeenCalledWith(\"A\");\n    });\n\n    it(\"shows clear X button when value is non-empty\", () => {\n        const { container } = render(<SearchBox value=\"hello\" onChange={() => { }} />);\n        // X button should be present as a button inside the component\n        const buttons = container.querySelectorAll(\"button\");\n        expect(buttons.length).toBe(1);\n    });\n\n    it(\"does NOT show clear X button when value is empty\", () => {\n        const { container } = render(<SearchBox value=\"\" onChange={() => { }} />);\n        const buttons = container.querySelectorAll(\"button\");\n        expect(buttons.length).toBe(0);\n    });\n\n    it(\"calls onChange with empty string when X is clicked\", async () => {\n        const onChange = vi.fn();\n        const user = userEvent.setup();\n        const { container } = render(<SearchBox value=\"hello\" onChange={onChange} />);\n\n        const clearBtn = container.querySelector(\"button\")!;\n        await user.click(clearBtn);\n        expect(onChange).toHaveBeenCalledWith(\"\");\n    });\n\n    it(\"calls select() on focus to select all text\", async () => {\n        const selectSpy = vi.spyOn(HTMLInputElement.prototype, \"select\");\n        const user = userEvent.setup();\n        render(<SearchBox value=\"hello\" onChange={() => { }} data-testid=\"search\" autoFocus={false} />);\n\n        const input = screen.getByTestId(\"search\");\n        await user.click(input);\n\n        expect(selectSpy).toHaveBeenCalled();\n        selectSpy.mockRestore();\n    });\n\n    it(\"applies custom className\", () => {\n        const { container } = render(<SearchBox value=\"\" onChange={() => { }} 