nts/common/NavigableList\";\nimport PermissionGate from \"@/components/common/PermissionGate\";\nimport AttendanceImportDialog from \"@/components/features/attendance/AttendanceImportDialog\";\nimport EmployeeDetailDrawer from \"@/components/features/employees/EmployeeDetailDrawer\";\nimport EmployeeFormModal from \"@/components/features/employees/EmployeeFormModal\";\nimport TransferEmployeeModal from \"@/components/features/employees/TransferEmployeeModal\";\nimport EmploymentHistoryModal from \"@/components/features/employees/EmploymentHistoryModal\";\nimport RehireEmployeeModal from \"@/components/features/employees/RehireEmployeeModal\";\n\nimport Button from \"@/components/ui/Button\";\n\nimport { useDebounce } from \"@/hooks/use-debounce\";\nimport { Combobox } from \"@/components/ui/Combobox\";\nimport FormField from \"@/components/ui/FormField\";\nimport Modal from \"@/components/ui/Modal\";\nimport PageHeader from \"@/components/ui/PageHeader\";\nimport StatusBadge from \"@/components/ui/StatusBadge\";\nimport { useToast } from \"@/components/ui/Toast\";\n\n\n\nimport { useConfirm } from \"@/hooks/use-confirm\";\nimport { useDateTimeFormatter } from \"@/hooks/use-datetime\";\nimport { cn } from \"@/lib/utils\";\n\nimport {\n  searchEmployees,\n  \n  updateEmployee,\n  getCurrentWorkspaceId,\n  Employee,\n  fetchDepartments,\n  fetchEmployeeDepartmentHistory,\n  \n  fetchEmploymentHistory,\n  \n} from \"../lib/api\";\n\n\nexport default function EmployeesPage() {\n  const { t } = useTranslation();\n  const wsId = getCurrentWorkspaceId() || \"\";\n  const queryClient = useQueryClient();\n  const { formatDate } = useDateTimeFormatter();\n  const [searchParams] = useState(() => new URLSearchParams(window.location.search));\n  const [isModalOpen, setIsModalOpen] = useState(false);\n  const [isImportDialogOpen, setIsImportDialogOpen] = useState(false);\n  const [editingEmployee, setEditingEmployee] = useState<Employee | null>(null);\n  const [selectedEmployee, setSelectedEmployee] = useState<Employee | null>(null);\n  const [searchTerm, setSearchTerm] = useState(\"\");\n  const [filterDeptIds, setFilterDeptIds] = useState<string[]>([]);\n  const PAGE_SIZE = 20;\n  const [prefillEnrollmentId, setPrefillEnrollmentId] = useState<string>(\"\");\n  const { confirm, ConfirmationDialog } = useConfirm();\n\n  // Handle enrollment_id query param from staging logs (read once on mount)\n  useEffect(() => {\n    const enrollmentId = searchParams.get(\"enrollment_id\");\n    if (enrollmentId) {\n      setPrefillEnrollmentId(enrollmentId);\n      setIsModalOpen(true);\n      setEditingEmployee(null);\n      // Clear from URL without triggering re-render\n      const url = new URL(window.location.href);\n      url.searchParams.delete(\"enrollment_id\");\n      window.history.replaceState({}, \"\", url.toString());\n    }\n  // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, []);\n\n  const [isTransferModalOpen, setIsTransferModalOpen] = useState(false);\n  const [isHistoryModalOpen, setIsHistoryModalOpen] = useState(false);\n  const [isRehireModalOpen, setIsRehireModalOpen] = useState(false);\n  const [selectedDeptId, setSelectedDeptId] = useState<string>(\"\");\n\n  const debouncedSearch = useDebounce(searchTerm, 500);\n\n  // Sorting state\n  type SortKey = \"name\" | \"id\" | \"department\" | \"status\";\n  type SortDir = \"asc\" | \"desc\";\n  const [sortKey, setSortKey] = useState<SortKey | null>(null);\n  const [sortDir, setSortDir] = useState<SortDir>(\"asc\");\n\n  const toggleSort = (key: SortKey) => {\n    if (sortKey === key) {\n      setSortDir((d) => (d === \"asc\" ? \"desc\" : \"asc\"));\n    } else {\n      setSortKey(key);\n      setSortDir(\"asc\");\n    }\n  };\n\n  const renderSortIcon = (col: SortKey) => {\n    if (sortKey !== col) return <ArrowUpDown size={10} className=\"opacity-0 group-hover:opacity-50 transition-opacity ml-1\" />;\n    return sortDir === \"asc\" ? <ChevronUp size={10} className=\"text-primary-600 dark:text-primary-400 ml-1\" /> : <ChevronDown size={10} className=\"text-primary-600 dark:text-primary-400 ml-1\" />;\n  };\n\n  const {\n    data: employeesPages,\n    isLoading,\n    isFetching,\n    isPlaceholderData,\n    fetchNextPage,\n    hasNextPage,\n    isFetchingNextPage,\n  } = useInfiniteQuery({\n    queryKey: [\"employees\", wsId, debouncedSearch, sortKey, sortDir, filterDeptIds],\n    queryFn: ({ pageParam }) => {\n      const apiSortKey = sortKey ? ({ name: \"name\", id: \"employee_id_number\", department: \"department\", status: \"status\" } as const)[sortKey] : undefined;\n      return searchEmployees(wsId, debouncedSearch, pageParam as number, PAGE_SIZE, apiSortKey, sortDir, filterDeptIds.length > 0 ? filterDeptIds : undefined);\n    },\n    getNextPageParam: (lastPage, allPages) => {\n      const totalLoaded = allPages.reduce((sum, p) => sum + (p.data?.length || 0), 0);\n      if (totalLoaded >= (lastPage.total || 0)) return undefined;\n      return allPages.length + 1;\n    },\n    initialPageParam: 1,\n    enabled: !!wsId,\n    placeholderData: keepPreviousData,\n  });\n\n  const employees = useMemo(() => {\n    if (!employeesPages) return [];\n    return employeesPages.pages.flatMap((p) => p.data || []);\n  }, [employeesPages]);\n\n  const totalItems = employeesPages?.pages[0]?.total || 0;\n\n  const { data: departments } = useQuery({ queryKey: [\"departments\", wsId], queryFn: () => fetchDepartments(wsId), enabled: !!wsId });\n\n  const toggleDeptFilter = (deptId: string) => {\n    setFilterDeptIds(prev =>\n      prev.includes(deptId) ? prev.filter(id => id !== deptId) : [...prev, deptId]\n    );\n  };\n\n  // Column definitions for NavigableList\n  const employeeColumns: NavigableListColumn<Employee>[] = [\n    {\n      key: \"name\",\n      header: <span className=\"inline-flex items-center\">{t(\"employees.table.name\")}{renderSortIcon(\"name\")}</span>,\n      onHeaderClick: () => toggleSort(\"name\"),\n      cell: (emp) => (\n        <div className=\"flex items-center gap-5\">\n          <div className={cn(\"w-12 h-12 rounded-2xl flex items-center justify-center font-bold text-sm shadow-inner border transition-all uppercase\", selectedEmployee?.id === emp.id ? \"bg-primary-600 text-white border-primary-500\" : \"bg-slate-100 dark:bg-slate-700 text-slate-500 dark:text-slate-400 border-slate-100 dark:border-slate-800 group-hover:bg-white dark:hover:bg-slate-900 group-hover:text-primary-600 dark:group-hover:text-primary-400 group-hover:border-primary-100 dark:border-primary-800\")}>{emp.full_name[0]}</div>\n          <div>\n            <div className=\"font-bold text-slate-700 dark:text-slate-200 text-sm tracking-tight uppercase leading-none\">{emp.full_name}</div>\n            <div className=\"font-mono font-bold text-[10px] text-slate-400 dark:text-slate-500 uppercase tracking-tighter mt-1.5\">{emp.employee_id_number}</div>\n          </div>\n        </div>\n      ),\n      cellClassName: \"py-6\",\n    },\n    {\n      key: \"department\",\n      header: (\n        <span className=\"inline-flex items-center gap-2\">\n          <span className=\"inline-flex items-center\">\n            {t(\"common.department\")}{renderSortIcon(\"department\")}\n          </span>\n          <Popover.Root>\n            <Popover.Trigger asChild>\n              <button\n                type=\"button\"\n                data-testid=\"dept-filter-btn\"\n                onClick={(e) => e.stopPropagation()}\n                className={cn(\n                  \"relative inline-flex items-center justify-center w-5 h-5 rounded transition-colors\",\n                  filterDeptIds.length > 0\n                    ? \"text-primary-600 dark:text-primary-400\"\n                    : \"text-slate-400 dark:text-slate-500 opacity-60 hover:opacity-100 hover:text-primary-600 dark:hover:text-primary-400\"\n                )}\n                title={t(\"employees.filter_department\", \"Filter by department\")}\n              >\n                <ListFilter size={12} />\n                {filterDeptIds.length > 0 && (\n                  <span className=\"absolute -top-1 -right-1 min-w-[14px] h-[14px] px-0.5 flex items-center justify-center bg-primary-500 text-white text-[8px] font-bold rounded-full leading-none animate-in zoom-in\">\n                    {filterDeptIds.length}\n                  </span>\n                )}\n              </button>\n            </Popover.Trigger>\n            <Popover.Portal>\n              <Popover.Content\n                className=\"z-[10000] w-56 overflow-hidden rounded-2xl border border-slate-100 dark:border-slate-700 bg-white dark:bg-slate-900 p-2 shadow-2xl dark:shadow-black/30 animate-in fade-in zoom-in-95 duration-200\"\n                sideOffset={8}\n                align=\"start\"\n                onClick={(e) => e.stopPropagation()}\n              >\n                <div className=\"px-3 pt-2 pb-1.5\">\n                  <div className=\"text-[9px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-[0.2em]\">\n                    {t(\"employees.filter_department\", \"Filter by department\")}\n                  </div>\n                </div>\n                <div className=\"max-h-60 overflow-y-auto custom-scrollbar\">\n                  {/* Clear filter button — only shown when filter is active */}\n                  {filterDeptIds.length > 0 && (\n                    <button\n                      type=\"button\"\n                      onClick={() => setFilterDeptIds([])}\n                      className=\"flex w-full items-center gap-3 rounded-xl px-3 py-2 text-[11px] font-bold uppercase tracking-wide text-red-500 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/30 transition-colors mb-1\"\n                    >\n                      <X size={12} className=\"shrink-0\" />\n                      {t(\"employees.clear_filter\", \"Xóa bộ lọc\")}\n                    </button>\n                  )}\n\n                  {departments && departments.length > 0 ? (\n                    departments.map(d => {\n                      const isChecked = filterDeptIds.includes(d.id);\n                      return (\n                        <button\n                          key={d.id}\n                          type=\"button\"\n                          data-testid={`dept-filter-option-${d.id}`}\n                          onClick={() => toggleDeptFilter(d.id)}\n                          className={cn(\n                            \"flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-[11px] font-bold uppercase tracking-wide transition-colors\",\n                            isChecked\n                              ? \"bg-primary-50 dark:bg-primary-950 text-primary-600 dark:text-primary-400\"\n                              : \"text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800\"\n                          )}\n                        >\n                          <div className={cn(\"w-4 h-4 rounded border flex items-center justify-center shrink-0 transition-colors\",\n                            isChecked\n                              ? \"bg-primary-600 border-primary-600 text-white\"\n                              : \"border-slate-300 dark:border-slate-600\"\n                          )}>\n                            {isChecked && <Check size={10} strokeWidth={3} />}\n                          </div>\n                          <Building2 size={12} className=\"opacity-50 shrink-0\" />\n                          <span className=\"truncate\">{d.name}</span>\n                        </button>\n                      );\n                    })\n                  ) : (\n                    <div className=\"px-3 py-6 text-center text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest opacity-60\">\n                      {t(\"employees.no_departments\", \"Chưa có phòng ban\")}\n                    </div>\n                  )}\n                </div>\n              </Popover.Content>\n            </Popover.Portal>\n          </Popover.Root>\n        </span>\n      ),\n      onHeaderClick: () => toggleSort(\"department\"),\n      cell: (emp) => emp.department_name ? (\n        <span className=\"inline-flex items-center gap-1.5 px-3 py-1 bg-blue-50 dark:bg-blue-950 text-blue-600 dark:text-blue-300 rounded-xl text-[10px] font-bold uppercase tracking-widest border border-blue-100 dark:border-blue-800\">\n          <Building2 size={12} className=\"opacity-60\" />{emp.department_name}\n        </span>\n      ) : <span className=\"text-slate-300 dark:text-slate-600\">—</span>,\n      cellClassName: \"py-6\",\n    },\n    {\n      key: \"status\",\n      header: <span className=\"inline-flex items-center\">{t(\"employees.table.status\")}{renderSortIcon(\"status\")}</span>,\n      onHeaderClick: () => toggleSort(\"status\"),\n      headerClassName: \"text-center\",\n      cell: (emp) => (\n        <StatusBadge variant={emp.is_active ? \"success\" : \"neutral\"}>{emp.is_active ? t(\"employees.table.active\").toUpperCase() : t(\"employees.table.terminated\").toUpperCase()}</StatusBadge>\n      ),\n      cellClassName: \"py-6 text-center\",\n    },\n  ];\n\n  const { data: deptHistory } = useQuery({ queryKey: [\"deptHistory\", selectedEmployee?.id], queryFn: () => fetchEmployeeDepartmentHistory(wsId, selectedEmployee!.id), enabled: !!selectedEmployee });\n  const { data: employmentHistory } = useQuery({ queryKey: [\"employmentHistory\", selectedEmployee?.id], queryFn: () => fetchEmploymentHistory(wsId, selectedEmployee!.id), enabled: !!selectedEmployee });\n\n  const updateMutation = useMutation({\n    mutationFn: (data: { id: string; employee: Partial<Employee> }) => updateEmployee(wsId, data.id, data.employee),\n    onSuccess: () => { queryClient.invalidateQueries({ queryKey: [\"employees\", wsId] }); setIsModalOpen(false); setEditingEmployee(null); toast.success(t(\"common.success\")); },\n  });\n\n  const toast = useToast();\n\n\n\n  const searchInputRef = useRef<HTMLInputElement>(null);\n  const focusSearch = () => setTimeout(() => searchInputRef.current?.focus(), 100);\n\n  const handleDrawerClose = () => {\n    setSelectedEmployee(null);\n    focusSearch();\n  };\n\n  if (isLoading) return <div className=\"flex h-full items-center justify-center py-32\"><div className=\"animate-spin rounded-full h-12 w-12 border-4 border-primary-600 border-t-transparent shadow-xl\"></div></div>;\n\n  return (\n    <div className=\"space-y-10 pb-20 animate-in fade-in duration-700\">\n      <PageHeader\n        title={t(\"employees.title\")}\n        subtitle={t(\"employees.subtitle\")}\n        data-testid=\"employees-title\"\n        actions={\n          <>\n            <PermissionGate permission=\"employees:create\">\n              <Button variant=\"outline\" data-testid=\"import-employee-btn\" onClick={() => setIsImportDialogOpen(true)} icon={<Upload size={18} />}>{t(\"employees.bulk_import_btn\").toUpperCase()}</Button>\n            </PermissionGate>\n            <PermissionGate permission=\"employees:create\">\n              <Button data-testid=\"add-employee-btn\" onClick={() => { setEditingEmployee(null); setIsModalOpen(true); }} icon={<UserPlus size={18} />}>{t(\"employees.add_btn\").toUpperCase()}</Button>\n            </PermissionGate>\n          </>\n        }\n      />\n\n      {/* Active filter chips */}\n      {filterDeptIds.length > 0 && departments && (\n        <div className=\"flex items-center gap-2 flex-wrap animate-in slide-in-from-top-4 duration-300\" data-testid=\"active-filter-chips\">\n          <span className=\"text-[9px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-[0.2em] mr-1\">\n            {t(\"employees.filtering_by\", \"Đang lọc\")}\n          </span>\n          {filterDeptIds.map(id => {\n            const dept = departments.find(d => d.id === id);\n            if (!dept) return null;\n            return (\n              <button\n                key={id}\n                type=\"button\"\n                data-testid={`dept-chip-${id}`}\n                onClick={() => toggleDeptFilter(id)}\n                className=\"inline-flex items-center gap-1.5 px-3 py-1 bg-primary-50 dark:bg-primary-950 text-primary-600 dark:text-primary-400 rounded-full text-[10px] font-bold uppercase tracking-wide border border-primary-100 dark:border-primary-800 hover:bg-primary-100 dark:hover:bg-primary-900 transition-colors group\"\n              >\n                <Building2 size={10} className=\"opacity-60\" />\n                {dept.name}\n                <X size={10} className=\"opacity-40 group-hover:opacity-100 transition-opacity\" />\n              </button>\n            );\n          })}\n          <button\n            type=\"button\"\n            onClick={() => setFilterDeptIds([])}\n            className=\"text-[10px] font-bold text-slate-400 dark:text-slate-500 hover:text-red-500 dark:hover:text-red-400 uppercase tracking-wide transition-colors ml-1\"\n          >\n            {t(\"employees.clear_all\", \"Xóa tất cả\")}\n          </button>\n        </div>\n      )}\n\n      <div className={cn(\"transition-opacity duration-300\", isPlaceholderData && isFetching && \"opacity-50\")}>\n      <NavigableList<Employee>\n        columns={employeeColumns}\n        items={employees}\n        itemKey={(emp) => emp.id}\n        onSelect={(emp) => setSelectedEmployee(emp)}\n        selectedKey={selectedEmployee?.id}\n        isLoading={false}\n        emptyMessage={t(\"employees.table.no_data\")}\n        showChevron\n        rowIdPrefix=\"employee-row\"\n        testIdPrefix=\"employees-row\"\n        resetDeps={[searchTerm]}\n        searchValue={searchTerm}\n        onSearchChange={setSearchTerm}\n        searchPlaceholder={t(\"employees.search_placeholder\")}\n        searchInputRef={searchInputRef}\n        searchTestId=\"employee-search\"\n        hasNextPage={hasNextPage}\n        isFetchingNextPage={isFetchingNextPage}\n        fetchNextPage={fetchNextPage}\n        maxHeightClass=\"\"\n        className=\"animate-in slide-in-from-bottom-8 duration-700\"\n      />\n      </div>\n\n      {/* Employee Detail Drawer */}\n      <EmployeeDetailDrawer\n        key={selectedEmployee?.id || \"closed\"}\n        isOpen={!!selectedEmployee}\n        onClose={handleDrawerClose}\n        employee={selectedEmployee}\n        wsId={wsId}\n        departments={departments}\n        deptHistory={deptHistory}\n        employmentHistory={employmentHistory}\n        formatDate={formatDate}\n        onEdit={(emp) => { setEditingEmployee(emp); setIsModalOpen(true); }}\n        onTerminate={async (emp) => {\n          const ok = await confirm({\n            title: t(\"common.warning\", { defaultValue: \"Warning\" }),\n            message: t(\"employees.details.terminate_confirm\"),\n            variant: \"danger\"\n          });\n          if (!ok) return;\n          updateMutation.mutate({ id: emp.id, employee: { is_active: false, termination_date: format(new Date(), 'yyyy-MM-dd') } });\n        }}\n        onRehire={() => setIsRehireModalOpen(true)}\n        onTransfer={(deptId) => { setSelectedDeptId(deptId); setIsTransferModalOpen(true); }}\n      />\n\n      {/* Main Employee Form Modal */}\n      <EmployeeFormModal\n        isOpen={isModalOpen}\n        onClose={() => setIsModalOpen(false)}\n        editingEmployee={editingEmployee}\n        wsId={wsId}\n        prefillEnrollmentId={prefillEnrollmentId}\n        onSuccess={() => setPrefillEnrollmentId(\"\")}\n      />\n\n      {/* Transfer Modal */}\n      <TransferEmployeeModal\n        isOpen={isTransferModalOpen}\n        onClose={() => setIsTransferModalOpen(false)}\n        employeeId={selectedEmployee?.id || null}\n        wsId={wsId}\n        departments={departments}\n        selectedDeptId={selectedDeptId}\n        setSelectedDeptId={setSelectedDeptId}\n      />\n\n      {/* History Modal */}\n      <EmploymentHistoryModal\n        isOpen={isHistoryModalOpen}\n        onClose={() => setIsHistoryModalOpen(false)}\n        employmentHistory={employmentHistory}\n        formatDate={formatDate}\n      />\n\n      {/* Rehire Modal */}\n      <RehireEmployeeModal\n        isOpen={isRehireModalOpen}\n        onClose={() => setIsRehireModalOpen(false)}\n        employeeId={selectedEmployee?.id || null}\n        wsId={wsId}\n        onSuccess={(updatedEmp) => setSelectedEmployee(updatedEmp)}\n      />\n\n      <FloatingRecordBadge loaded={employees.length} total={totalItems} label={t(\"common.pagination.records\")} />\n\n      <AttendanceImportDialog\n        isOpen={isImportDialogOpen}\n        onClose={() => setIsImportDialogOpen(false)}\n        title={t(\"employees.bulk_import_title\")}\n        endpoint=\"/employees/upload\"\n        targetType=\"employee\"\n        customRequirements={[\n          t(\"employees.import_req.col_a\"),\n          t(\"employees.import_req.col_b\"),\n          t(\"employees.import_req.col_c\"),\n          t(\"employees.import_req.col_d\"),\n        ]}\n      />\n      <ConfirmationDialog />\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/LeaveBalancesPage.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'X' is defined but never used. Allowed unused vars must match /^_/u.","line":4,"column":94,"nodeType":"Identifier","messageId":"unusedVar","endLine":4,"endColumn":95,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"X"},"fix":{"range":[218,221],"text":""},"desc":"Remove unused variable \"X\"."}]},{"ruleId":"jsx-a11y/no-autofocus","severity":2,"message":"The autoFocus prop should not be used, as it can reduce usability and accessibility for users.","line":137,"column":32,"nodeType":"JSXAttribute","endLine":137,"endColumn":41},{"ruleId":"jsx-a11y/click-events-have-key-events","severity":2,"message":"Visible, non-interactive elements with click handlers must have at least one keyboard listener.","line":254,"column":9,"nodeType":"JSXOpeningElement","endLine":254,"endColumn":163},{"ruleId":"jsx-a11y/no-static-element-interactions","severity":2,"message":"Avoid non-native interactive elements. If using native HTML is not possible, add an appropriate role and support for tabbing, mouse, keyboard, and touch inputs to an interactive content element.","line":254,"column":9,"nodeType":"JSXOpeningElement","endLine":254,"endColumn":163},{"ruleId":"jsx-a11y/click-events-have-key-events","severity":2,"message":"Visible, non-interactive elements with click handlers must have at least one keyboard listener.","line":256,"column":11,"nodeType":"JSXOpeningElement","endLine":256,"endColumn":187},{"ruleId":"jsx-a11y/no-static-element-interactions","severity":2,"message":"Avoid non-native interactive elements. If using native HTML is not possible, add an appropriate role and support for tabbing, mouse, keyboard, and touch inputs to an interactive content element.","line":256,"column":11,"nodeType":"JSXOpeningElement","endLine":256,"endColumn":187}],"suppressedMessages":[],"errorCount":6,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState, useCallback } from \"react\";\n\nimport { useQuery, useMutation, useQueryClient } from \"@tanstack/react-query\";\nimport { Search, Filter, History, PlayCircle, Eye, ChevronLeft, ChevronRight, AlertTriangle, X, Calendar } from \"lucide-react\";\nimport { createPortal } from \"react-dom\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { LeaveBalanceDetailModal } from \"@/components/leave/LeaveBalanceDetailModal\";\nimport { LeaveHistoryModal } from \"@/components/leave/LeaveHistoryModal\";\nimport { useToast } from \"@/components/ui/Toast\";\n\nimport { useDebounce } from \"@/hooks/use-debounce\";\nimport { fetchWorkspaceLeaveBalances, getCurrentWorkspaceId, triggerAccrualRun, fetchJobStatus } from \"@/lib/api\";\nimport { WorkspaceLeaveBalance } from \"@/lib/api/types\";\nimport { cn } from \"@/lib/utils\";\n\n\nexport default function LeaveBalancesPage() {\n  const { t } = useTranslation();\n  const toast = useToast();\n  const queryClient = useQueryClient();\n  const wsId = getCurrentWorkspaceId();\n  const [searchTerm, setSearchTerm] = useState(\"\");\n  const [page, setPage] = useState(1);\n  const [selectedYear, setSelectedYear] = useState(new Date().getFullYear());\n  const [showAccrualConfirm, setShowAccrualConfirm] = useState(false);\n  const limit = 20;\n  const debouncedSearch = useDebounce(searchTerm, 500);\n\n  // Generate year options: current year ± 2\n  const currentYear = new Date().getFullYear();\n  const yearOptions = Array.from({ length: 5 }, (_, i) => currentYear - 2 + i);\n\n  const [selectedEmployee, setSelectedEmployee] = useState<{ id: string, name: string, leaveTypeId?: string, leaveTypeName?: string } | null>(null);\n  const [selectedBalance, setSelectedBalance] = useState<WorkspaceLeaveBalance | null>(null);\n\n  const { data: paginatedData, isLoading } = useQuery({\n    queryKey: [\"workspace-leave-balances\", wsId, page, debouncedSearch, selectedYear],\n    queryFn: () => fetchWorkspaceLeaveBalances(wsId!, { page, limit, q: debouncedSearch, year: selectedYear }),\n    enabled: !!wsId,\n    placeholderData: (previousData) => previousData\n  });\n\n  const pollJobStatus = useCallback(async (jobId: string) => {\n    const POLL_INTERVAL = 2000; // 2 seconds\n    const MAX_POLLS = 60; // 2 min max\n\n    for (let i = 0; i < MAX_POLLS; i++) {\n      await new Promise(resolve => setTimeout(resolve, POLL_INTERVAL));\n      try {\n        const status = await fetchJobStatus(wsId!, jobId);\n        if (status.status === 'completed') {\n          queryClient.invalidateQueries({ queryKey: [\"workspace-leave-balances\"] });\n          toast.success(t(\"leave_balances.accrual_completed\"));\n          return;\n        }\n        if (status.status === 'failed') {\n          toast.error(status.error_message || t(\"common.error\"));\n          return;\n        }\n        // Still processing — continue polling\n      } catch {\n        // Network error — stop polling\n        toast.error(t(\"common.error\"));\n        return;\n      }\n    }\n    // Timed out\n    toast.error(t(\"leave_balances.accrual_timeout\"));\n  }, [wsId, queryClient, toast, t]);\n\n  const accrualMutation = useMutation({\n    mutationFn: () => triggerAccrualRun(wsId!, { date: new Date().toISOString().split('T')[0] }),\n    onSuccess: (data) => {\n      if (data.status === 'queued' && data.job_id) {\n        toast.success(t(\"leave_balances.accrual_queued\"));\n        pollJobStatus(data.job_id);\n      } else {\n        queryClient.invalidateQueries({ queryKey: [\"workspace-leave-balances\"] });\n        toast.success(data.message || t(\"common.success\"));\n      }\n    },\n    onError: () => toast.error(t(\"common.error\"))\n  });\n\n  const balances = paginatedData?.data || [];\n  const totalItems = paginatedData?.total || 0;\n  const totalPages = Math.ceil(totalItems / limit);\n\n  return (\n    <div className=\"space-y-10 animate-in fade-in duration-700 pb-20\">\n      <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-6 px-2\">\n        <div className=\"space-y-1\">\n          <h1 className=\"text-3xl md:text-5xl font-bold tracking-tighter text-slate-800 dark:text-slate-100 uppercase leading-none\">{t(\"leave_balances.title\")}</h1>\n          <p className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em] opacity-60\">{t(\"leave_balances.subtitle\")}</p>\n        </div>\n        <button\n          onClick={() => setShowAccrualConfirm(true)}\n          disabled={accrualMutation.isPending || selectedYear !== currentYear}\n          title={selectedYear !== currentYear ? t(\"leave_balances.accrual_current_year_only\") : undefined}\n          className=\"bg-primary-600 hover:bg-primary-700 text-white font-bold px-6 md:px-8 py-3.5 md:py-3 rounded-2xl flex items-center justify-center gap-3 shadow-xl shadow-indigo-100 transition-all active:scale-95 text-xs uppercase tracking-widest disabled:opacity-50 min-h-[44px] w-full md:w-auto\"\n        >\n          <PlayCircle size={18} /> <span className=\"whitespace-nowrap\">{accrualMutation.isPending ? t(\"common.processing\").toUpperCase() : t(\"leave_balances.run_accrual\").toUpperCase()}</span>\n        </button>\n      </div>\n\n      <div className=\"bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-3xl md:rounded-[3rem] overflow-hidden shadow-sm animate-in slide-in-from-bottom-8 duration-700\">\n        <div className=\"p-5 md:p-8 border-b border-slate-50 dark:border-slate-800 flex flex-col md:flex-row md:items-center justify-between gap-5 md:gap-6 bg-slate-50 dark:bg-slate-800/30\">\n          <div className=\"flex items-center gap-3\">\n            <Filter className=\"w-5 h-5 text-primary-600 dark:text-primary-400\" />\n            <h2 className=\"text-lg md:text-xl font-bold text-slate-800 dark:text-slate-100 tracking-tight uppercase\">{t(\"leave_balances.summary_table\")}</h2>\n            {totalItems > 0 && (\n              <span className=\"px-2 py-0.5 bg-slate-200 dark:bg-slate-600 text-slate-600 dark:text-slate-300 rounded-full text-xs font-bold\">\n                {totalItems}\n              </span>\n            )}\n            {/* Year Selector */}\n            <div className=\"flex items-center gap-2 ml-2\">\n              <Calendar className=\"w-4 h-4 text-slate-400 dark:text-slate-500\" />\n              <select\n                value={selectedYear}\n                onChange={(e) => {\n                  setSelectedYear(Number(e.target.value));\n                  setPage(1);\n                }}\n                className=\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl px-3 py-2 text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider focus:ring-2 focus:ring-primary-500/20 outline-none transition-all cursor-pointer min-h-[36px]\"\n              >\n                {yearOptions.map(y => (\n                  <option key={y} value={y}>{y}</option>\n                ))}\n              </select>\n            </div>\n          </div>\n\n          <div className=\"relative group w-full md:w-80\">\n            <Search className=\"absolute left-4 md:left-5 top-1/2 -translate-y-1/2 text-slate-300 dark:text-slate-600 group-focus-within:text-primary-500 dark:group-focus-within:text-primary-400 transition-colors\" size={18} />\n            <input type=\"text\" autoFocus placeholder={t(\"common.search_placeholder\")} className=\"w-full pl-12 md:pl-14 pr-5 md:pr-6 py-3.5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-2xl focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-bold text-sm tracking-tight shadow-sm min-h-[44px]\" value={searchTerm} onChange={(e) => {\n                setSearchTerm(e.target.value);\n                setPage(1); // Reset to page 1 on search\n              }}\n            />\n          </div>\n        </div>\n\n        {/* Desktop Table View (≥1024px) - Simplified 5 Columns */}\n        <div className=\"hidden lg:block overflow-x-auto\">\n          <table className=\"w-full text-left border-collapse\">\n            <thead>\n              <tr className=\"bg-slate-50 dark:bg-slate-800/50 border-b border-slate-100 dark:border-slate-800\">\n                <th className=\"px-6 py-5 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.2em]\">{t(\"common.employee\")}</th>\n                <th className=\"px-5 py-5 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.2em]\">{t(\"common.type\")}</th>\n                <th className=\"px-5 py-5 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.2em] text-right\">{t(\"leave_balances.table.remaining\")}</th>\n                <th className=\"px-5 py-5 text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.2em]\">{t(\"leave_balances.table.usage\")}</th>\n                <th className=\"px-6 py-5 text-right text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.2em]\">{t(\"common.actions\")}</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-50 dark:divide-slate-800\">\n              {isLoading && !balances.length ? (\n                <tr><td colSpan={5} className=\"px-6 py-20 text-center text-slate-500 dark:text-slate-400 font-bold italic uppercase tracking-widest text-xs opacity-50 animate-pulse\">{t(\"common.loading\")}</td></tr>\n              ) : balances.length === 0 ? (\n                <tr><td colSpan={5} className=\"px-6 py-32 text-center text-slate-500 dark:text-slate-400 font-bold italic uppercase tracking-widest text-xs opacity-50\">{t(\"attendance_logs.messages.no_data\")}</td></tr>\n              ) : (balances as WorkspaceLeaveBalance[]).map((balance, idx) => (\n                <DesktopBalanceRow\n                  key={`${balance.employee_id}-${balance.leave_type_id}-${idx}`}\n                  balance={balance}\n                  onViewDetails={() => setSelectedBalance(balance)}\n                  onViewHistory={() => setSelectedEmployee({ id: balance.employee_id, name: balance.employee_name, leaveTypeId: balance.leave_type_id, leaveTypeName: balance.leave_type_name })}\n                />\n              ))}\n            </tbody>\n          </table>\n        </div>\n\n        {/* Tablet/Mobile Card View (<1024px) - Simplified */}\n        <div className=\"lg:hidden divide-y divide-slate-100 dark:divide-slate-800\">\n          {isLoading && !balances.length ? (\n            <div className=\"px-5 py-20 text-center text-slate-500 dark:text-slate-400 font-bold italic uppercase tracking-widest text-xs opacity-50 animate-pulse\">{t(\"common.loading\")}</div>\n          ) : balances.length === 0 ? (\n            <div className=\"px-5 py-32 text-center text-slate-500 dark:text-slate-400 font-bold italic uppercase tracking-widest text-xs opacity-50\">{t(\"attendance_logs.messages.no_data\")}</div>\n          ) : (balances as WorkspaceLeaveBalance[]).map((balance, idx) => (\n            <MobileBalanceCard\n              key={`${balance.employee_id}-${balance.leave_type_id}-${idx}`}\n              balance={balance}\n              onViewDetails={() => setSelectedBalance(balance)}\n              onViewHistory={() => setSelectedEmployee({ id: balance.employee_id, name: balance.employee_name, leaveTypeId: balance.leave_type_id, leaveTypeName: balance.leave_type_name })}\n            />\n          ))}\n        </div>\n\n        {/* Pagination Controls */}\n        {totalItems > 0 && (\n          <div className=\"p-5 md:p-8 border-t border-slate-50 dark:border-slate-800 bg-slate-50 dark:bg-slate-800/30 flex flex-col md:flex-row items-center justify-between gap-4\">\n            <div className=\"text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider\">\n              {t(\"common.showing\")} <span className=\"text-slate-600 dark:text-slate-300\">{(page - 1) * limit + 1}</span> - <span className=\"text-slate-600 dark:text-slate-300\">{Math.min(page * limit, totalItems)}</span> {t(\"common.of\")} <span className=\"text-slate-600 dark:text-slate-300\">{totalItems}</span>\n            </div>\n\n            <div className=\"flex items-center gap-2\">\n              <button\n                onClick={() => setPage(p => Math.max(1, p - 1))}\n                disabled={page === 1}\n                className=\"p-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 disabled:opacity-50 disabled:cursor-not-allowed transition-colors\"\n              >\n                <ChevronLeft className=\"w-4 h-4 text-slate-600 dark:text-slate-300\" />\n              </button>\n\n              <div className=\"flex items-center gap-1\">\n                {Array.from({ length: Math.min(5, totalPages) }, (_, i) => {\n                  // Simple logic to show window around current page\n                  let p = i + 1;\n                  if (totalPages > 5) {\n                    if (page > 3) p = page - 2 + i;\n                    if (p > totalPages) p = totalPages - (4 - i);\n                  }\n\n                  return (\n                    <button\n                      key={p}\n                      onClick={() => setPage(p)}\n                      className={cn(\n                        \"w-8 h-8 flex items-center justify-center rounded-xl text-xs font-bold transition-all\",\n                        page === p\n                          ? \"bg-primary-600 text-white shadow-md shadow-indigo-100\"\n                          : \"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800\"\n                      )}\n                    >\n                      {p}\n                    </button>\n                  );\n                })}\n              </div>\n\n              <button\n                onClick={() => setPage(p => Math.min(totalPages, p + 1))}\n                disabled={page === totalPages}\n                className=\"p-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 disabled:opacity-50 disabled:cursor-not-allowed transition-colors\"\n              >\n                <ChevronRight className=\"w-4 h-4 text-slate-600 dark:text-slate-300\" />\n              </button>\n            </div>\n          </div>\n        )}\n      </div>\n\n      {selectedEmployee && (\n        <LeaveHistoryModal wsId={wsId!} employeeId={selectedEmployee.id} employeeName={selectedEmployee.name} leaveTypeId={selectedEmployee.leaveTypeId} leaveTypeName={selectedEmployee.leaveTypeName} isOpen={!!selectedEmployee} onClose={() => setSelectedEmployee(null)} />\n      )}\n\n      {selectedBalance && (\n        <LeaveBalanceDetailModal balance={selectedBalance} isOpen={!!selectedBalance} onClose={() => setSelectedBalance(null)} />\n      )}\n\n      {/* Custom Accrual Confirm Dialog */}\n      {showAccrualConfirm && createPortal(\n        <div className=\"fixed inset-0 z-[9999] flex items-center justify-center p-4 animate-in fade-in duration-200\" onClick={() => setShowAccrualConfirm(false)}>\n          <div className=\"absolute inset-0 bg-slate-900/20 backdrop-blur-sm\" />\n          <div className=\"relative bg-white dark:bg-slate-900 rounded-3xl shadow-2xl max-w-md w-full p-8 animate-in zoom-in-95 duration-300 space-y-6\" onClick={e => e.stopPropagation()}>\n            <div className=\"flex items-start gap-4\">\n              <div className=\"w-12 h-12 bg-amber-50 dark:bg-amber-950 rounded-2xl flex items-center justify-center flex-shrink-0\">\n                <AlertTriangle className=\"w-6 h-6 text-amber-600 dark:text-amber-400\" />\n              </div>\n              <div className=\"space-y-2\">\n                <h3 className=\"text-lg font-bold text-slate-800 dark:text-slate-100 tracking-tight uppercase\">{t(\"leave_balances.run_accrual\")}</h3>\n                <p className=\"text-sm text-slate-500 dark:text-slate-400\">{t(\"leave_balances.confirm_accrual\")}</p>\n              </div>\n            </div>\n            <div className=\"flex items-center gap-3 pt-2\">\n              <button\n                onClick={() => setShowAccrualConfirm(false)}\n                className=\"flex-1 px-5 py-3 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 font-bold text-xs uppercase tracking-widest rounded-xl transition-all active:scale-95 min-h-[44px]\"\n              >\n                {t(\"common.cancel\")}\n              </button>\n              <button\n                onClick={() => {\n                  setShowAccrualConfirm(false);\n                  accrualMutation.mutate();\n                }}\n                className=\"flex-1 px-5 py-3 bg-primary-600 hover:bg-primary-700 text-white font-bold text-xs uppercase tracking-widest rounded-xl transition-all active:scale-95 shadow-lg shadow-primary-200 min-h-[44px]\"\n              >\n                {t(\"common.confirm\")}\n              </button>\n            </div>\n          </div>\n        </div>,\n        document.body\n      )}\n    </div>\n  );\n}\n\n// Desktop table row component (≥1024px) - Simplified to essential info only\nfunction DesktopBalanceRow({ balance, onViewDetails, onViewHistory }: {\n  balance: WorkspaceLeaveBalance;\n  onViewDetails: () => void;\n  onViewHistory: () => void;\n}) {\n  const { t } = useTranslation();\n  const totalEntitled = balance.entitlement + balance.accrued_amount + balance.carried_over;\n  const usagePercent = Math.round((balance.used / (totalEntitled || 1)) * 100);\n\n  return (\n    <tr className=\"hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-all group cursor-pointer\" onClick={onViewDetails}>\n      {/* Employee Name with Avatar */}\n      <td className=\"px-6 py-6\">\n        <div className=\"flex items-center gap-4\">\n          <div className=\"w-12 h-12 bg-primary-50 dark:bg-primary-950 rounded-xl flex items-center justify-center text-primary-600 dark:text-primary-400 font-bold text-sm shadow-inner border border-primary-100 dark:border-primary-800/50 uppercase group-hover:scale-110 transition-transform flex-shrink-0\">\n            {balance.employee_name.split(' ').map(n => n[0]).join('').slice(0, 2)}\n          </div>\n          <div className=\"font-bold text-slate-800 dark:text-slate-100 text-base tracking-tight uppercase leading-tight\">\n            {balance.employee_name}\n          </div>\n        </div>\n      </td>\n\n      {/* Leave Type Badge */}\n      <td className=\"px-5 py-6\">\n        <span className=\"px-3 py-1.5 bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300 rounded-xl text-xs font-bold uppercase tracking-wider border border-slate-200 dark:border-slate-700 shadow-sm inline-block\">\n          {balance.leave_type_name}\n        </span>\n      </td>\n\n      {/* Remaining Balance - Hero Metric */}\n      <td className=\"px-5 py-6 text-right\">\n        <div className=\"flex items-center justify-end gap-2\">\n          <span className={cn(\n            \"text-2xl font-bold px-4 py-2 rounded-xl font-mono shadow-inner border transition-all uppercase tracking-tighter\",\n            balance.remaining > 0\n              ? \"text-emerald-600 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950 border-emerald-100 dark:border-emerald-800\"\n              : \"text-slate-500 dark:text-slate-400 bg-slate-100 dark:bg-slate-700 border-slate-200 dark:border-slate-700 opacity-60\"\n          )}>\n            {balance.remaining}\n          </span>\n          <span className=\"text-xs font-bold text-slate-500 dark:text-slate-400 uppercase\">\n            {t(\"common.days_short\")}\n          </span>\n        </div>\n      </td>\n\n      {/* Usage Progress Bar */}\n      <td className=\"px-5 py-6\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"w-32 h-4 bg-slate-100 dark:bg-slate-700 rounded-full overflow-hidden shadow-inner border border-slate-200 dark:border-slate-700/50\">\n            <div\n              className={cn(\n                \"h-full rounded-full transition-all duration-1000 shadow-sm\",\n                usagePercent > 80 ? \"bg-rose-500 dark:bg-rose-400 shadow-rose-200\" :\n                  usagePercent > 50 ? \"bg-amber-500 dark:bg-amber-400 shadow-amber-200\" :\n                    \"bg-primary-600 shadow-primary-200\"\n              )}\n              style={{ width: `${Math.min(100, usagePercent)}%` }}\n            />\n          </div>\n          <span className=\"text-xs font-bold text-slate-500 dark:text-slate-400 font-mono tracking-tighter min-w-[3ch]\">\n            {usagePercent}%\n          </span>\n        </div>\n      </td>\n\n      {/* Action Buttons */}\n      <td className=\"px-6 py-6 text-right\" onClick={(e) => e.stopPropagation()}>\n        <div className=\"flex items-center justify-end gap-2 opacity-60 group-hover:opacity-100 transition-all\">\n          <button\n            onClick={onViewDetails}\n            className=\"p-2.5 bg-primary-50 dark:bg-primary-950 text-primary-600 dark:text-primary-400 hover:bg-primary-100 dark:bg-primary-900 rounded-xl border border-primary-200 dark:border-primary-800 transition-all active:scale-90 min-w-[44px] min-h-[44px]\"\n            title={t(\"leave_balances.view_details\")}\n          >\n            <Eye className=\"h-5 w-5\" />\n          </button>\n          <button\n            onClick={onViewHistory}\n            className=\"p-2.5 bg-slate-50 dark:bg-slate-800 text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-xl border border-slate-200 dark:border-slate-700 transition-all active:scale-90 min-w-[44px] min-h-[44px]\"\n            title={t(\"leave_balances.table.history_tooltip\")}\n          >\n            <History className=\"h-5 w-5\" />\n          </button>\n        </div>\n      </td>\n    </tr>\n  );\n}\n\n// Mobile card component (<1024px) - Simplified, essential info only\nfunction MobileBalanceCard({ balance, onViewDetails, onViewHistory }: {\n  balance: WorkspaceLeaveBalance;\n  onViewDetails: () => void;\n  onViewHistory: () => void;\n}) {\n  const { t } = useTranslation();\n  const totalEntitled = balance.entitlement + balance.accrued_amount + balance.carried_over;\n  const usagePercent = Math.round((balance.used / (totalEntitled || 1)) * 100);\n\n  return (\n    <div className=\"p-5 space-y-5 bg-white dark:bg-slate-900 hover:bg-slate-50 dark:hover:bg-slate-800/30 transition-all\">\n      {/* Header: Employee Avatar + Name + Leave Type */}\n      <div className=\"flex items-center gap-3\">\n        <div className=\"w-14 h-14 bg-primary-50 dark:bg-primary-950 rounded-2xl flex items-center justify-center text-primary-600 dark:text-primary-400 font-bold text-base shadow-inner border border-primary-100 dark:border-primary-800/50 uppercase flex-shrink-0\">\n          {balance.employee_name.split(' ').map(n => n[0]).join('').slice(0, 2)}\n        </div>\n        <div className=\"flex-1 min-w-0\">\n          <div className=\"font-bold text-slate-800 dark:text-slate-100 text-base tracking-tight uppercase leading-tight truncate\">\n            {balance.employee_name}\n          </div>\n          <span className=\"inline-block mt-1.5 px-3 py-1.5 bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300 rounded-xl text-xs font-bold uppercase tracking-wider border border-slate-200 dark:border-slate-700 shadow-sm\">\n            {balance.leave_type_name}\n          </span>\n        </div>\n      </div>\n\n      {/* Hero Metric: Remaining Balance */}\n      <div className=\"bg-gradient-to-br from-primary-50/50 to-transparent dark:from-primary-950/50 dark:to-transparent rounded-2xl p-5 border border-primary-100 dark:border-primary-800/30\">\n        <div className=\"text-[10px] font-bold text-primary-600 dark:text-primary-400 uppercase tracking-[0.2em] mb-2\">\n          {t(\"leave_balances.table.remaining\")}\n        </div>\n        <div className=\"flex items-baseline gap-2\">\n          <span className={cn(\n            \"text-5xl font-bold font-mono tracking-tighter\",\n            balance.remaining > 0 ? \"text-emerald-600 dark:text-emerald-300\" : \"text-slate-500 dark:text-slate-400\"\n          )}>\n            {balance.remaining}\n          </span>\n          <span className=\"text-sm font-bold text-slate-500 dark:text-slate-400 uppercase\">\n            {t(\"common.days_short\")}\n          </span>\n        </div>\n      </div>\n\n      {/* Usage Progress Bar */}\n      <div className=\"space-y-2\">\n        <div className=\"flex items-center justify-between text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider\">\n          <span>{t(\"leave_balances.table.usage\")}</span>\n          <span className=\"font-mono\">{usagePercent}%</span>\n        </div>\n        <div className=\"w-full h-4 bg-slate-100 dark:bg-slate-700 rounded-full overflow-hidden shadow-inner border border-slate-200 dark:border-slate-700/50\">\n          <div\n            className={cn(\n              \"h-full rounded-full transition-all duration-1000 shadow-sm\",\n              usagePercent > 80 ? \"bg-rose-500 dark:bg-rose-400 shadow-rose-200\" :\n                usagePercent > 50 ? \"bg-amber-500 dark:bg-amber-400 shadow-amber-200\" :\n                  \"bg-primary-600 shadow-primary-200\"\n            )}\n            style={{ width: `${Math.min(100, usagePercent)}%` }}\n          />\n        </div>\n      </div>\n\n      {/* Action Buttons */}\n      <div className=\"flex items-center gap-3 pt-3 border-t border-slate-100 dark:border-slate-800\">\n        <button\n          onClick={onViewDetails}\n          className=\"flex-1 flex items-center justify-center gap-2 px-4 py-3.5 bg-primary-600 hover:bg-primary-700 text-white font-bold uppercase tracking-wider text-xs rounded-xl transition-all active:scale-95 shadow-lg shadow-primary-200 min-h-[44px]\"\n        >\n          <Eye className=\"h-5 w-5\" />\n          <span>{t(\"leave_balances.view_details\")}</span>\n        </button>\n        <button\n          onClick={onViewHistory}\n          className=\"p-3.5 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:bg-slate-600 text-slate-600 dark:text-slate-300 rounded-xl transition-all active:scale-95 min-w-[44px] min-h-[44px] flex-shrink-0\"\n          title={t(\"leave_balances.table.history_tooltip\")}\n        >\n          <History className=\"h-5 w-5\" />\n        </button>\n      </div>\n    </div>\n  );\n}","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/LeaveRequestsPage.tsx","messages":[{"ruleId":"import-x/no-named-as-default-member","severity":1,"message":"Caution: `React` also has a named export `useEffect`. Check if you meant to write `import {useEffect} from 'react'` instead.","line":60,"column":3,"nodeType":"MemberExpression","messageId":"member","endLine":60,"endColumn":18},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":150,"column":20,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":150,"endColumn":23,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[6460,6463],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[6460,6463],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect, useCallback, useRef } from \"react\";\n\nimport { useQuery, useMutation, useQueryClient } from \"@tanstack/react-query\";\nimport {\n  CalendarDays, Calendar, CheckCircle2, XCircle, Clock, MessageSquare, Plus, Info, PlayCircle, FileText, ShieldCheck, Sun, Moon, Timer,\n  Upload, Download, Loader2, AlertTriangle, X\n} from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\n\nimport { EmployeeSearch } from \"@/components/common/EmployeeSearch\";\nimport LeaveImportDialog from \"@/components/features/leave/LeaveImportDialog\";\nimport Button from \"@/components/ui/Button\";\nimport { Combobox } from \"@/components/ui/Combobox\";\nimport FormField from \"@/components/ui/FormField\";\nimport Modal from \"@/components/ui/Modal\";\nimport { useToast } from \"@/components/ui/Toast\";\n\nimport { useDateTimeFormatter } from \"@/hooks/use-datetime\";\nimport {\n  fetchEmployees,\n  submitLeaveRequest,\n  fetchWorkspaceLeaveRequests,\n  approveLeaveRequest,\n  fetchEmployeeLeaveBalances,\n  fetchLeaveTypes,\n  getCurrentWorkspaceId,\n  fetchLatestLeaveImport,\n  downloadLeaveImportErrors,\n} from \"@/lib/api\";\nimport { cn } from \"@/lib/utils\";\n\nimport type { LeaveImportJob } from \"@/lib/api/leaves\";\nimport type { LeaveDurationType } from \"@/lib/api/types\";\n\ntype TabType = \"pending\" | \"approved\" | \"rejected\";\n\nexport default function LeaveRequestsPage() {\n  const { t } = useTranslation();\n  const toast = useToast();\n  const wsId = getCurrentWorkspaceId();\n  const queryClient = useQueryClient();\n  const { formatDate } = useDateTimeFormatter();\n  \n  const [isModalOpen, setIsModalOpen] = useState(false);\n  const [isImportModalOpen, setIsImportModalOpen] = useState(false);\n  const [activeTab, setActiveTab] = useState<TabType>(\"pending\");\n  const [selectedEmpId, setSelectedEmpId] = useState<string>(\"\");\n  const [leaveTypeId, setLeaveTypeId] = useState<string>(\"\");\n  const [durationType, setDurationType] = useState<LeaveDurationType>(\"full_day\");\n  const [startTime, setStartTime] = useState<string>(\"\");\n  const [endTime, setEndTime] = useState<string>(\"\");\n\n  const { data: employeesData } = useQuery({ queryKey: [\"employees\", wsId], queryFn: () => fetchEmployees(wsId!, 1, 3000), enabled: !!wsId });\n  const employees = employeesData?.data || [];\n  const { data: balances = [] } = useQuery({ queryKey: [\"leave-balances\", wsId, selectedEmpId], queryFn: () => fetchEmployeeLeaveBalances(wsId!, selectedEmpId), enabled: !!wsId && !!selectedEmpId });\n  const { data: requests = [], isLoading: requestsLoading } = useQuery({ queryKey: [\"leave-requests\", wsId, activeTab], queryFn: () => fetchWorkspaceLeaveRequests(wsId!, activeTab), enabled: !!wsId });\n  const { data: leaveTypes = [] } = useQuery({ queryKey: [\"leave-types\", wsId], queryFn: () => fetchLeaveTypes(wsId!), enabled: !!wsId });\n\n  React.useEffect(() => {\n    if (leaveTypes.length > 0 && !leaveTypeId) {\n      setLeaveTypeId(leaveTypes[0].id);\n    }\n  }, [leaveTypes, leaveTypeId]);\n\n  const submitMutation = useMutation({\n    mutationFn: (data: { employee_id: string; leave_type_id: string; start_date: string; end_date: string; reason?: string; duration_type?: LeaveDurationType; start_time?: string; end_time?: string }) => submitLeaveRequest(wsId!, data),\n    onSuccess: () => { queryClient.invalidateQueries({ queryKey: [\"leave-requests\"] }); setIsModalOpen(false); setDurationType(\"full_day\"); setStartTime(\"\"); setEndTime(\"\"); toast.success(t(\"common.success\")); },\n  });\n\n  const approveMutation = useMutation({\n    mutationFn: (data: { id: string; status: string }) => approveLeaveRequest(wsId!, data.id, { status: data.status }),\n    onSuccess: () => { queryClient.invalidateQueries({ queryKey: [\"leave-requests\"] }); toast.success(t(\"common.success\")); },\n  });\n\n  // ===== LEAVE IMPORT STATE =====\n  const [importJob, setImportJob] = useState<LeaveImportJob | null>(null);\n  const [importBannerDismissed, setImportBannerDismissed] = useState(false);\n  const pollingRef = useRef<ReturnType<typeof setInterval> | null>(null);\n\n  // On mount: check for latest import job\n  useEffect(() => {\n    if (!wsId) return;\n    fetchLatestLeaveImport(wsId).then((job) => {\n      if (job) {\n        // Only show if job is less than 24h old\n        const created = new Date(job.created_at);\n        const now = new Date();\n        if (now.getTime() - created.getTime() < 24 * 60 * 60 * 1000) {\n          setImportJob(job);\n          setImportBannerDismissed(false);\n        }\n      }\n    }).catch(() => {});\n  }, [wsId]);\n\n  // Poll when import is processing\n  const startPolling = useCallback((wsIdVal: string) => {\n    if (pollingRef.current) clearInterval(pollingRef.current);\n    pollingRef.current = setInterval(async () => {\n      try {\n        const job = await fetchLatestLeaveImport(wsIdVal);\n        if (job) {\n          setImportJob(job);\n          if (job.status !== 'processing' && job.status !== 'pending') {\n            if (pollingRef.current) clearInterval(pollingRef.current);\n            pollingRef.current = null;\n            queryClient.invalidateQueries({ queryKey: [\"leave-requests\"] });\n          }\n        }\n      } catch {\n        // Network error — keep polling, will resume when online\n      }\n    }, 3000);\n  }, [queryClient]);\n\n  // Start polling when job is processing\n  useEffect(() => {\n    if (importJob?.status === 'processing' || importJob?.status === 'pending') {\n      if (wsId) startPolling(wsId);\n    }\n    return () => {\n      if (pollingRef.current) clearInterval(pollingRef.current);\n    };\n  }, [importJob?.status, wsId, startPolling]);\n\n  const handleImportComplete = useCallback(() => {\n    // Refresh import job status from the dialog\n    if (wsId) {\n      fetchLatestLeaveImport(wsId).then((job) => {\n        if (job) {\n          setImportJob(job);\n          setImportBannerDismissed(false);\n        }\n      }).catch(() => {});\n      queryClient.invalidateQueries({ queryKey: [\"leave-requests\"] });\n    }\n  }, [wsId, queryClient]);\n\n  const getImportErrorInfo = (job: LeaveImportJob) => {\n    if (!job.error_log) return null;\n    try {\n      return JSON.parse(job.error_log) as { success_count?: number; error_count?: number; error_file_path?: string };\n    } catch { return null; }\n  };\n\n  const handleSubmit = (e: React.FormEvent<HTMLFormElement>) => {\n    e.preventDefault(); const formData = new FormData(e.currentTarget);\n    if (!leaveTypeId) { toast.error(t(\"leave_requests.invalid_leave_type\")); return; }\n    const payload: any = {\n      employee_id: selectedEmpId,\n      leave_type_id: leaveTypeId,\n      start_date: formData.get(\"start_date\") as string,\n      end_date: formData.get(\"end_date\") as string,\n      reason: formData.get(\"reason\") as string,\n      duration_type: durationType,\n    };\n    if (durationType === \"custom_hours\" && startTime && endTime) {\n      payload.start_time = startTime;\n      payload.end_time = endTime;\n    }\n    submitMutation.mutate(payload);\n  };\n\n  const getLeaveTypeIcon = (code: string) => {\n    const c = code.toLowerCase();\n    if (c.includes(\"vacation\") || c.includes(\"annual\")) return <Calendar size={14} />;\n    if (c.includes(\"sick\")) return <FileText size={14} />;\n    if (c.includes(\"personal\")) return <CalendarDays size={14} />;\n    return <PlayCircle size={14} />;\n  };\n\n  if (!wsId) return <div className=\"p-12 text-center text-primary-400 font-bold italic uppercase tracking-widest text-xs opacity-50\">{t(\"common.select_workspace\")}</div>;\n\n  return (\n    <div className=\"space-y-10 animate-in fade-in duration-700 pb-20\">\n      <div className=\"flex flex-col md:flex-row justify-between items-center gap-8 px-2\">\n        <div className=\"space-y-1\">\n          <h1 data-testid=\"leave-requests-title\" className=\"text-5xl font-bold tracking-tighter text-primary-700 dark:text-primary-300 uppercase leading-none\">{t(\"leave_requests.title\")}</h1>\n          <p className=\"text-[10px] font-bold text-primary-400 uppercase tracking-[0.25em] opacity-60\">{t(\"leave_requests.subtitle\")}</p>\n        </div>\n        <div className=\"flex items-center gap-3 flex-wrap\">\n          {/* Upload Excel — opens modal */}\n          <Button\n            onClick={() => setIsImportModalOpen(true)}\n            disabled={importJob?.status === 'processing'}\n            className=\"bg-emerald-600 hover:bg-emerald-700 shadow-emerald-100 dark:shadow-black/30 text-[10px] px-5 py-3\"\n          >\n            <Upload size={16} />\n            {t(\"leave_requests.upload_btn\", \"Upload Excel\")}\n          </Button>\n          {/* Create Leave Request */}\n          <Button onClick={() => { setIsModalOpen(true); setSelectedEmpId(\"\"); setDurationType(\"full_day\"); setStartTime(\"\"); setEndTime(\"\"); }}>\n            <Plus size={18} /> {t(\"leave_requests.create_btn\").toUpperCase()}\n          </Button>\n        </div>\n      </div>\n\n      {/* Import Status Banner */}\n      {importJob && !importBannerDismissed && (\n        <div className={cn(\n          \"rounded-2xl px-6 py-4 flex items-center justify-between gap-4 animate-in slide-in-from-top-4 duration-500 border\",\n          importJob.status === 'processing' || importJob.status === 'pending'\n            ? \"bg-blue-50 dark:bg-blue-950/30 border-blue-200 dark:border-blue-800/50\"\n            : importJob.status === 'completed' && !importJob.error_log\n              ? \"bg-emerald-50 dark:bg-emerald-950/30 border-emerald-200 dark:border-emerald-800/50\"\n              : importJob.status === 'completed' && importJob.error_log\n                ? \"bg-amber-50 dark:bg-amber-950/30 border-amber-200 dark:border-amber-800/50\"\n                : \"bg-red-50 dark:bg-red-950/30 border-red-200 dark:border-red-800/50\"\n        )}>\n          <div className=\"flex items-center gap-3 flex-1 min-w-0\">\n            {(importJob.status === 'processing' || importJob.status === 'pending') && (\n              <>\n                <Loader2 size={20} className=\"animate-spin text-blue-500 flex-shrink-0\" />\n                <div>\n                  <p className=\"text-sm font-semibold text-blue-700 dark:text-blue-300\">\n                    {t(\"leave_requests.upload_processing\", \"Đang xử lý {{processed}}/{{total}} dòng...\").replace('{{processed}}', String(importJob.processed_rows)).replace('{{total}}', String(importJob.total_rows || '?'))}\n                  </p>\n                  {importJob.total_rows > 0 && (\n                    <div className=\"mt-2 h-2 rounded-full bg-blue-100 dark:bg-blue-900 overflow-hidden w-48\">\n                      <div\n                        className=\"h-full rounded-full bg-blue-500 transition-all duration-500\"\n                        style={{ width: `${Math.min(100, (importJob.processed_rows / importJob.total_rows) * 100)}%` }}\n                      />\n                    </div>\n                  )}\n                </div>\n              </>\n            )}\n            {importJob.status === 'completed' && !importJob.error_log && (\n              <>\n                <CheckCircle2 size={20} className=\"text-emerald-500 flex-shrink-0\" />\n                <p className=\"text-sm font-semibold text-emerald-700 dark:text-emerald-300\">\n                  {t(\"leave_requests.upload_success\", \"Import thành công {{success}} đơn nghỉ\").replace('{{success}}', String(importJob.processed_rows))}\n                </p>\n              </>\n            )}\n            {importJob.status === 'completed' && importJob.error_log && (() => {\n              const info = getImportErrorInfo(importJob);\n              return (\n                <>\n                  <AlertTriangle size={20} className=\"text-amber-500 flex-shrink-0\" />\n                  <p className=\"text-sm font-semibold text-amber-700 dark:text-amber-300\">\n                    {t(\"leave_requests.upload_partial\", \"Thành công {{success}}/{{total}}. {{errors}} dòng lỗi.\")\n                      .replace('{{success}}', String(info?.success_count ?? importJob.processed_rows))\n                      .replace('{{total}}', String((info?.success_count ?? 0) + (info?.error_count ?? 0)))\n                      .replace('{{errors}}', String(info?.error_count ?? 0))}\n                  </p>\n                  {info?.error_file_path && wsId && (\n                    <button\n                      onClick={() => downloadLeaveImportErrors(wsId, importJob.id).catch(() => {})}\n                      className=\"ml-2 flex items-center gap-1.5 text-xs font-bold text-amber-600 hover:text-amber-800 dark:text-amber-400 dark:hover:text-amber-200 underline underline-offset-2\"\n                    >\n                      <Download size={14} /> {t(\"leave_requests.download_errors\", \"Tải file lỗi\")}\n                    </button>\n                  )}\n                </>\n              );\n            })()}\n            {importJob.status === 'failed' && (\n              <>\n                <XCircle size={20} className=\"text-red-500 flex-shrink-0\" />\n                <p className=\"text-sm font-semibold text-red-700 dark:text-red-300\">\n                  {t(\"leave_requests.upload_failed\", \"Import thất bại\")}\n                  {importJob.error_log && <span className=\"font-normal ml-2 text-xs opacity-75\">— {importJob.error_log.substring(0, 100)}</span>}\n                </p>\n              </>\n            )}\n          </div>\n          {importJob.status !== 'processing' && importJob.status !== 'pending' && (\n            <button onClick={() => setImportBannerDismissed(true)} className=\"text-primary-400 hover:text-primary-600 transition-colors flex-shrink-0\">\n              <X size={18} />\n            </button>\n          )}\n        </div>\n      )}\n\n      <div className=\"flex bg-slate-100 dark:bg-slate-700/50 p-1.5 rounded-[22px] w-fit border border-primary-200 dark:border-primary-800/50/50 shadow-inner\">\n        <button onClick={() => setActiveTab(\"pending\")} className={cn(\"flex items-center gap-2 px-8 py-2.5 rounded-[18px] text-xs font-bold uppercase tracking-widest transition-all\", activeTab === \"pending\" ? \"bg-white dark:bg-slate-900 text-amber-600 dark:text-amber-300 shadow-sm border border-primary-100 dark:border-primary-800/50\" : \"text-primary-400 hover:text-primary-700 dark:text-primary-300\")}><Clock size={14} /> {t(\"common.status_pending\")}</button>\n        <button onClick={() => setActiveTab(\"approved\")} className={cn(\"flex items-center gap-2 px-8 py-2.5 rounded-[18px] text-xs font-bold uppercase tracking-widest transition-all\", activeTab === \"approved\" ? \"bg-white dark:bg-slate-900 text-emerald-600 dark:text-emerald-300 shadow-sm border border-primary-100 dark:border-primary-800/50\" : \"text-primary-400 hover:text-primary-700 dark:text-primary-300\")}><CheckCircle2 size={14} /> {t(\"common.status_approved\")}</button>\n        <button onClick={() => setActiveTab(\"rejected\")} className={cn(\"flex items-center gap-2 px-8 py-2.5 rounded-[18px] text-xs font-bold uppercase tracking-widest transition-all\", activeTab === \"rejected\" ? \"bg-white dark:bg-slate-900 text-rose-600 dark:text-rose-300 shadow-sm border border-primary-100 dark:border-primary-800/50\" : \"text-primary-400 hover:text-primary-700 dark:text-primary-300\")}><XCircle size={14} /> {t(\"common.status_rejected\")}</button>\n      </div>\n\n      <div className=\"bg-white dark:bg-slate-900 border border-primary-100 dark:border-primary-800/50 rounded-[3rem] overflow-hidden shadow-sm animate-in slide-in-from-bottom-8 duration-700\">\n        <table className=\"w-full text-left border-collapse\">\n          <thead>\n            <tr className=\"bg-slate-50 dark:bg-slate-800/50 border-b border-primary-100 dark:border-primary-800/50\">\n              <th className=\"px-10 py-6 text-[10px] font-bold text-primary-400 uppercase tracking-[0.25em]\">{t(\"common.employee\")}</th>\n              <th className=\"px-8 py-6 text-[10px] font-bold text-primary-400 uppercase tracking-[0.25em]\">{t(\"common.type\")}</th>\n              <th className=\"px-8 py-6 text-[10px] font-bold text-primary-400 uppercase tracking-[0.25em]\">{t(\"common.time\")}</th>\n              <th className=\"px-8 py-6 text-[10px] font-bold text-primary-400 uppercase tracking-[0.25em] text-center\">{t(\"common.status\")}</th>\n              <th className=\"px-10 py-6 border-b border-primary-100 dark:border-primary-800/50\"></th>\n            </tr>\n          </thead>\n          <tbody className=\"divide-y divide-slate-50 dark:divide-slate-800\">\n            {requestsLoading ? (\n              <tr><td colSpan={5} className=\"px-10 py-20 text-center text-primary-400 font-bold italic uppercase tracking-widest text-xs opacity-50 animate-pulse\">{t(\"common.loading\")}</td></tr>\n            ) : requests.length === 0 ? (\n              <tr><td colSpan={5} className=\"px-10 py-32 text-center text-primary-400 font-bold italic uppercase tracking-widest text-xs opacity-50\">{t(\"leave_requests.messages.no_requests\")}</td></tr>\n            ) : requests.map((req) => {\n              const emp = employees.find(e => e.id === req.employee_id);\n              return (\n                <tr key={req.id} className=\"hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-all group\">\n                  <td className=\"px-10 py-6\">\n                    <div className=\"flex items-center gap-5\">\n                      <div className=\"w-14 h-14 bg-primary-50 dark:bg-primary-950 rounded-2xl flex items-center justify-center text-primary-600 dark:text-primary-400 font-bold text-xl shadow-inner border border-primary-100 dark:border-primary-800/50 uppercase group-hover:scale-110 transition-transform\">{emp?.full_name[0]}</div>\n                      <div>\n                        <div className=\"font-bold text-primary-700 dark:text-primary-300 text-sm tracking-tight uppercase leading-none mb-1.5\">{emp ? emp.full_name : \"N/A\"}</div>\n                        <div className=\"text-[10px] text-primary-400 font-mono font-bold uppercase tracking-widest opacity-70\">{emp?.employee_id_number}</div>\n                      </div>\n                    </div>\n                  </td>\n                  <td className=\"px-8 py-6\"><span className=\"px-3 py-1 bg-slate-100 dark:bg-slate-700 text-primary-700 dark:text-primary-300 rounded-lg text-[9px] font-bold uppercase tracking-widest border border-primary-200 dark:border-primary-800/50 shadow-sm\">{(leaveTypes.find(t => t.id === req.leave_type_id)?.name || \"Unknown\").toUpperCase()}</span></td>\n                  <td className=\"px-8 py-6\">\n                    <div className=\"text-xs font-bold text-primary-700 dark:text-primary-300 uppercase tracking-tight mb-1.5\">\n                      {formatDate(req.start_date)} — {formatDate(req.end_date)}\n                      {req.duration_type && req.duration_type !== \"full_day\" && (\n                        <span className={cn(\"ml-2 px-2 py-0.5 rounded-md text-[8px] font-bold uppercase tracking-wider inline-flex items-center gap-1 border\",\n                          req.duration_type === \"first_half\" ? \"bg-amber-50 dark:bg-amber-950 text-amber-600 dark:text-amber-300 border-amber-200 dark:border-amber-800\" :\n                          req.duration_type === \"second_half\" ? \"bg-indigo-50 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-300 border-indigo-200 dark:border-indigo-800\" :\n                          \"bg-cyan-50 dark:bg-cyan-950 text-cyan-600 dark:text-cyan-300 border-cyan-200 dark:border-cyan-800\"\n                        )}>\n                          {req.duration_type === \"first_half\" && <><Sun size={8} /> {t(\"leave_requests.duration.first_half\")}</>}\n                          {req.duration_type === \"second_half\" && <><Moon size={8} /> {t(\"leave_requests.duration.second_half\")}</>}\n                          {req.duration_type === \"custom_hours\" && <><Timer size={8} /> {req.start_time?.slice(0,5)}–{req.end_time?.slice(0,5)}</>}\n                        </span>\n                      )}\n                    </div>\n                    <div className=\"bg-slate-50 dark:bg-slate-800/50 p-3 rounded-xl border border-primary-100 dark:border-primary-800/50 shadow-inner group-hover:bg-white dark:hover:bg-slate-900 transition-colors\">\n                      <p className=\"text-[10px] text-primary-400 font-bold leading-relaxed line-clamp-1 italic opacity-80 flex gap-2\"><MessageSquare size={12} className=\"text-slate-300 dark:text-slate-600 mt-0.5 shrink-0\" /> \"{req.reason || t(\"common.no_description\")}\"</p>\n                    </div>\n                  </td>\n                  <td className=\"px-8 py-6 text-center\">\n                    <span className={cn(\"px-4 py-1.5 rounded-full text-[9px] font-bold uppercase tracking-widest border shadow-sm inline-block\", \n                      req.status === \"pending\" ? \"bg-amber-50 dark:bg-amber-950 text-amber-600 dark:text-amber-300 border-amber-100 dark:border-amber-800\" : \n                      req.status === \"approved\" ? \"bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-300 border-emerald-100 dark:border-emerald-800\" :\n                      req.status === \"pre_approved\" ? \"bg-teal-50 dark:bg-teal-950 text-teal-600 dark:text-teal-300 border-teal-100 dark:border-teal-800\" :\n                      \"bg-rose-50 dark:bg-rose-950 text-rose-600 dark:text-rose-300 border-rose-100 dark:border-rose-800\"\n                    )}>\n                      {req.status === \"pending\" ? t(\"common.status_pending\").toUpperCase() : req.status === \"approved\" ? t(\"common.status_approved\").toUpperCase() : req.status === \"pre_approved\" ? <span className=\"flex items-center gap-1\"><ShieldCheck size={10} />{t(\"common.status_pre_approved\").toUpperCase()}</span> : t(\"common.status_rejected\").toUpperCase()}\n                    </span>\n                  </td>\n                  <td className=\"px-10 py-6 text-right\">\n                    {req.status === \"pending\" && (\n                      <div className=\"flex justify-end gap-3 opacity-0 group-hover:opacity-100 transition-all duration-300 translate-x-2 group-hover:translate-x-0\">\n                        <button onClick={() => approveMutation.mutate({ id: req.id, status: \"approved\" })} className=\"p-3 bg-white dark:bg-slate-900 text-emerald-400 hover:text-emerald-600 dark:text-emerald-300 rounded-xl shadow-md border border-primary-100 dark:border-primary-800/50 transition-all active:scale-90\" title={t(\"common.approve\")}><CheckCircle2 size={20} /></button>\n                        <button onClick={() => approveMutation.mutate({ id: req.id, status: \"rejected\" })} className=\"p-3 bg-white dark:bg-slate-900 text-rose-400 hover:text-rose-600 dark:text-rose-300 rounded-xl shadow-md border border-primary-100 dark:border-primary-800/50 transition-all active:scale-90\" title={t(\"common.reject\")}><XCircle size={20} /></button>\n                      </div>\n                    )}\n                  </td>\n                </tr>\n              );\n            })}\n          </tbody>\n        </table>\n      </div>\n\n      <Modal isOpen={isModalOpen} onClose={() => setIsModalOpen(false)} title={t(\"leave_requests.modal.submit_title\")} subtitle={t(\"leave_requests.modal.submit_subtitle\")} icon={<CalendarDays size={24} />} maxWidth=\"md\">\n        <form onSubmit={handleSubmit} className=\"space-y-8 pt-4\">\n          <div className=\"space-y-3 px-1\">\n            <label htmlFor=\"leave-emp\" className=\"text-[10px] font-bold text-primary-600 dark:text-primary-400 uppercase tracking-widest ml-1\">{t(\"common.employee\")}</label>\n            <EmployeeSearch id=\"leave-emp\" workspaceId={wsId!} value={selectedEmpId} onChange={setSelectedEmpId} className=\"h-14 rounded-2xl bg-slate-50 dark:bg-slate-800 border-primary-100 dark:border-primary-800/50 shadow-sm\" />\n          </div>\n          {selectedEmpId && balances.length > 0 && (\n            <div className=\"bg-primary-50 dark:bg-primary-950/50 p-8 rounded-[2.5rem] border border-primary-100 dark:border-primary-800/50 grid grid-cols-2 gap-8 shadow-inner\">\n              {balances.map(b => (\n                <div key={b.leave_type_id || b.leave_type_code} className=\"space-y-2\">\n                  <p className=\"text-[9px] font-bold uppercase tracking-[0.25em] text-primary-600 dark:text-primary-400 opacity-70 leading-none\">{(b.leave_type_name || b.leave_type_code || \"Unknown\").toUpperCase()}</p>\n                  <p className=\"text-base font-bold text-primary-700 dark:text-primary-300 tracking-tighter uppercase\">{t(\"leave_requests.remaining\")}: <span className=\"text-primary-600 dark:text-primary-400 text-2xl font-mono ml-1\">{b.remaining}</span><span className=\"text-[10px] opacity-40 ml-1\">/ {b.entitlement + b.carried_over}</span></p>\n                </div>\n              ))}\n            </div>\n          )}\n          <div className=\"space-y-3 px-1\">\n            <label htmlFor=\"leave-type\" className=\"text-[10px] font-bold text-primary-600 dark:text-primary-400 uppercase tracking-widest ml-1\">{t(\"common.type\")}</label>\n            <Combobox \n              id=\"leave-type\" \n              options={leaveTypes.map(t => ({ value: t.id, label: t.name.toUpperCase(), icon: getLeaveTypeIcon(t.code) }))} \n              value={leaveTypeId} \n              onChange={setLeaveTypeId} \n              className=\"bg-slate-50 dark:bg-slate-800 border-primary-100 dark:border-primary-800/50 h-14\" \n            />\n          </div>\n          <div className=\"grid grid-cols-2 gap-8\">\n            <FormField id=\"start-date\" name=\"start_date\" type=\"date\" label={t(\"common.from_date\")} required inputClassName=\"text-primary-700 dark:text-primary-300 border-primary-100 dark:border-primary-800/50\" />\n            <FormField id=\"end-date\" name=\"end_date\" type=\"date\" label={t(\"common.to_date\")} required disabled={durationType !== \"full_day\"} inputClassName={cn(\"text-primary-700 dark:text-primary-300 border-primary-100 dark:border-primary-800/50\", durationType !== \"full_day\" && \"opacity-50 cursor-not-allowed\")} />\n          </div>\n\n          {/* Duration Type Segmented Buttons */}\n          <div className=\"space-y-3 px-1\">\n            <label className=\"text-[10px] font-bold text-primary-600 dark:text-primary-400 uppercase tracking-widest ml-1\">{t(\"leave_requests.duration.label\")}</label>\n            <div className=\"flex bg-slate-100 dark:bg-slate-700/50 p-1 rounded-2xl border border-primary-100 dark:border-primary-800/50 shadow-inner\">\n              {([\n                { value: \"full_day\" as LeaveDurationType, label: t(\"leave_requests.duration.full_day\"), icon: <Calendar size={12} /> },\n                { value: \"first_half\" as LeaveDurationType, label: t(\"leave_requests.duration.first_half\"), icon: <Sun size={12} /> },\n                { value: \"second_half\" as LeaveDurationType, label: t(\"leave_requests.duration.second_half\"), icon: <Moon size={12} /> },\n                { value: \"custom_hours\" as LeaveDurationType, label: t(\"leave_requests.duration.custom_hours\"), icon: <Timer size={12} /> },\n              ]).map(opt => (\n                <button\n                  key={opt.value}\n                  type=\"button\"\n                  onClick={() => {\n                    setDurationType(opt.value);\n                    // Auto-sync end_date when switching to partial day\n                    if (opt.value !== \"full_day\") {\n                      const startInput = document.getElementById(\"start-date\") as HTMLInputElement;\n                      const endInput = document.getElementById(\"end-date\") as HTMLInputElement;\n                      if (startInput?.value && endInput) {\n                        endInput.value = startInput.value;\n                      }\n                    }\n                  }}\n                  className={cn(\n                    \"flex-1 flex items-center justify-center gap-1.5 px-3 py-2.5 rounded-xl text-[9px] font-bold uppercase tracking-wider transition-all\",\n                    durationType === opt.value\n                      ? \"bg-white dark:bg-slate-900 text-primary-700 dark:text-primary-300 shadow-sm border border-primary-100 dark:border-primary-800/50\"\n                      : \"text-primary-400 hover:text-primary-600 dark:text-primary-500 dark:hover:text-primary-300\"\n                  )}\n                >\n                  {opt.icon} {opt.label}\n                </button>\n              ))}\n            </div>\n            {durationType !== \"full_day\" && durationType !== \"custom_hours\" && (\n              <p className=\"text-[10px] text-primary-400 italic ml-1 flex items-center gap-1\"><Info size={10} /> {t(\"leave_requests.duration.half_day_note\")}</p>\n            )}\n          </div>\n\n          {/* Time Pickers for Custom Hours */}\n          {durationType === \"custom_hours\" && (\n            <div className=\"grid grid-cols-2 gap-8 animate-in fade-in slide-in-from-top-2 duration-300\">\n              <FormField id=\"start-time\" type=\"time\" label={t(\"leave_requests.duration.time_from\")} value={startTime} onChange={e => setStartTime(e.target.value)} required inputClassName=\"text-primary-700 dark:text-primary-300 border-primary-100 dark:border-primary-800/50\" />\n              <FormField id=\"end-time\" type=\"time\" label={t(\"leave_requests.duration.time_to\")} value={endTime} onChange={e => setEndTime(e.target.value)} required inputClassName=\"text-primary-700 dark:text-primary-300 border-primary-100 dark:border-primary-800/50\" />\n            </div>\n          )}\n\n          <FormField id=\"leave-reason\" name=\"reason\" type=\"textarea\" rows={3} label={t(\"common.reason\")} placeholder={t(\"leave_requests.modal.reason_placeholder\")} inputClassName=\"text-primary-700 dark:text-primary-300 border-primary-100 dark:border-primary-800/50\" />\n          <div className=\"pt-6 grid grid-cols-2 gap-6 border-t border-slate-50 dark:border-slate-800\">\n            <Button type=\"button\" variant=\"outline\" size=\"lg\" onClick={() => setIsModalOpen(false)}>{t(\"common.cancel\").toUpperCase()}</Button>\n            <Button type=\"submit\" variant=\"primary\" size=\"lg\">{t(\"leave_requests.modal.submit_btn\").toUpperCase()}</Button>\n          </div>\n        </form>\n      </Modal>\n\n      {/* Leave Import Dialog */}\n      <LeaveImportDialog\n        isOpen={isImportModalOpen}\n        onClose={() => setIsImportModalOpen(false)}\n        onImportComplete={handleImportComplete}\n      />\n    </div>\n  );\n}\n","usedDeprec