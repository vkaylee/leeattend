ce === 'roster' && (\n                      <button\n                        onClick={(e) => {\n                          e.stopPropagation();\n                          onDeleteRoster(dateStr);\n                        }}\n                        className=\"absolute -top-2 -right-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-full p-1.5 shadow-md opacity-0 group-hover/item:opacity-100 transition-opacity hover:bg-rose-50 dark:bg-rose-950 hover:border-rose-200 group/btn\"\n                      >\n                        <X size={12} className=\"text-slate-500 dark:text-slate-400 group-hover/btn:text-rose-500\" />\n                      </button>\n                    )}\n                  </div>\n                ) : (\n                  <div className=\"bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800 border-dashed p-6 rounded-[24px] text-[10px] text-slate-500 dark:text-slate-400 font-bold text-center uppercase tracking-widest flex flex-col items-center justify-center gap-2\">\n                    {t(\"shifts.off_day\")}\n                  </div>\n                )}\n              </div>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/shifts/__tests__/PriorityLegend.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/shifts/__tests__/ScheduleTracePopover.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/time-tracking/AdjustmentRequestModal.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'timezone' is defined bu