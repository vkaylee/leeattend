oast\", () => ({ useToast: () => ({ success: vi.fn(), error: vi.fn() }) }));\n\n\nconst mockAssignments = [\n  {\n    id: \"assign-1\",\n    workspace_id: \"ws-1\",\n    assignee_type: \"workspace\",\n    assignee_id: null,\n    policy_id: \"pol-1\",\n    effective_from: \"2026-01-01\",\n    effective_to: null,\n    created_at: \"2026-01-01T00:00:00Z\",\n    policy_name: \"General Vacation\",\n    leave_type_name: \"Vacation\"\n  }\n];\n\nconst queryClient = new QueryClient({ defaultOptions: { queries: { retry: false } } });\n\ndescribe(\"LeaveSettings Page\", () => {\n  const wsId = \"test-ws-id\";\n\n  beforeEach(() => {\n    vi.clearAllMocks();\n    (helpers.getCurrentWorkspaceId as any).mockReturnValue(wsId);\n    (api.fetchLeaveTypes as any).mockResolvedValue([]);\n    (api.fetchLeavePolicies as any).mockResolvedValue([]);\n    (api.fetchLeavePolicyAssignments as any).mockResolvedValue(mockAssignments);\n  });\n\n  it(\"renders all three main tabs\", () => {\n    render(\n      <QueryClientProvider client={queryClient}>\n        <LeaveSettings />\n      </QueryClientProvider>\n    );\n\n    // Query buttons specifically to avoid duplicate text in headings/desc\n    expect(screen.getByRole(\"button\", { name: /Leave Types/i })).toBeDefined();\n    expect(screen.getByRole(\"button\", { name: /Accrual Policies/i })).toBeDefined();\n    expect(screen.getByRole(\"button\", { name: /Policy Assignments/i })).toBeDefined();\n  });\n\n  it(\"switches to assignments tab and shows content\", async () => {\n    render(\n      <QueryClientProvider client={queryClient}>\n        <LeaveSettings />\n      </QueryClientProvider>\n    );\n\n    const assignTab = screen.getByRole(\"button\", { name: /Policy Assignments/i });\n    fireEvent.click(assignTab);\n\n    // Check for the heading in the Assignments tab\n    expect(await screen.findByRole(\"heading\", { name: /Policy Assignments/i })).toBeDefined();\n    expect(screen.getByRole(\"button\", { name: /Assign Policy/i })).toBeDefined();\n  });\n\n  it(\"renders assignments table with data\", async () => {\n    render(\n      <QueryClientProvider client={queryClient}>\n        <LeaveSettings />\n      </QueryClientProvider>\n    );\n\n    const assignTab = screen.getByRole(\"button\", { name: /Policy Assignments/i });\n    fireEvent.click(assignTab);\n\n    // Wait for data to load\n    expect(await screen.findByText(\"General Vacation\")).toBeDefined();\n    expect(screen.getByText(\"Vacation\")).toBeDefined();\n    expect(screen.getByText(\"workspace\")).toBeDefined();\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/workspace/WorkspaceBillingPage.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/workspace/WorkspaceDangerPage.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":77,"column":17,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":77,"endColumn":20,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[3054,3057],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[3054,3057],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState } from \"react\";\n\nimport { AlertTriangle } from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport Button from \"@/components/ui/Button\";\nimport Modal from \"@/components/ui/Modal\";\nimport PageHeader from \"@/components/ui/PageHeader\";\nimport { useToast } from \"@/components/ui/Toast\";\n\nimport { useWorkspace } from \"@/hooks/use-workspace\";\nimport { getCurrentWorkspaceId } from \"@/lib/api\";\nimport { clearWorkspaceData } from \"@/lib/api/workspaces\";\n\n\nexport default function WorkspaceDangerPage() {\n  const { workspace } = useWorkspace();\n  const [isClearDataOpen, setIsClearDataOpen] = useState(false);\n  const { t } = useTranslation();\n\n  return (\n    <div className=\"space-y-10 animate-in fade-in duration-500\">\n      <PageHeader\n        title={t('danger.title', { defaultValue: 'Danger Zone' })}\n        subtitle={t('danger.subtitle', { defaultValue: 'Destructive operations for this workspace' })}\n      />\n      \n      <div className=\"bg-rose-50 dark:bg-rose-950/20 p-8 rounded-[2.5rem] border border-rose-200 dark:border-rose-900/50 space-y-6\">\n        <div className=\"flex items-center gap-4 border-b border-rose-100 dark:border-rose-900/50 pb-6\">\n          <div className=\"w-12 h-12 bg-white dark:bg-slate-900 rounded-2xl flex items-center justify-center text-rose-500 shadow-sm\">\n            <AlertTriangle size={24} />\n          </div>\n          <div>\n            <h3 className=\"text-xl font-bold text-rose-700 dark:text-rose-400\">{t('danger.clearDataTitle', { defaultValue: 'Clear Workspace Data' })}</h3>\n            <p className=\"text-sm font-medium text-rose-600/70 dark:text-rose-400/70 mt-1\">\n              {t('danger.clearDataDesc', { defaultValue: 'Delete all employees, time entries, leaves, and other data. This action cannot be undone.' })}\n            </p>\n          </div>\n        </div>\n\n        <div className=\"flex justify-end\">\n          <Button \n            variant=\"destructive\" \n            onClick={() => setIsClearDataOpen(true)}\n          >\n            {t('danger.clearAllData', { defaultValue: 'CLEAR ALL DATA' })}\n          </Button>\n        </div>\n      </div>\n\n      <ClearDataModal \n        isOpen={isClearDataOpen} \n        onClose={() => setIsClearDataOpen(false)} \n        workspaceName={workspace?.name || \"\"}\n      />\n    </div>\n  );\n}\n\nfunction ClearDataModal({ isOpen, onClose, workspaceName }: { isOpen: boolean, onClose: () => void, workspaceName: string }) {\n  const { t } = useTranslation();\n  const [confirmText, setConfirmText] = useState(\"\");\n  const [isLoading, setIsLoading] = useState(false);\n  const toast = useToast();\n  const wsId = getCurrentWorkspaceId() || \"\";\n\n  const handleClear = async () => {\n    if (confirmText !== workspaceName) return;\n    \n    setIsLoading(true);\n    try {\n      await clearWorkspaceData(wsId, \"all\");\n      toast.success(t('danger.successMessage', { defaultValue: 'Workspace data cleared successfully' }));\n      onClose();\n      // Reload to reset state\n      setTimeout(() => window.location.reload(), 1000);\n    } catch (e: any) {\n      toast.error(e.message || t('danger.errorMessage', { defaultValue: 'Failed to clear data' }));\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  return (\n    <Modal isOpen={isOpen} onClose={onClose} title={t('danger.modalTitle', { defaultValue: 'Clear Workspace Data' })} icon={<AlertTriangle size={24} />} maxWidth=\"md\">\n      <div className=\"space-y-6 pt-4 animate-in fade-in\">\n        <div className=\"p-4 bg-rose-50 dark:bg-rose-950 border border-rose-200 dark:border-rose-900 rounded-2xl text-rose-700 dark:text-rose-300 text-sm font-medium\">\n          <strong>{t('common.warning', { defaultValue: 'Warning:' })}</strong> {t('danger.warningDesc1', { defaultValue: 'This will permanently delete all data in the workspace, including employees, shifts, time entries, and leaves.' })} \n          <br/>{t('danger.warningDesc2', { defaultValue: 'Members and settings will be preserved.' })}\n        </div>\n\n        <div className=\"space-y-3\">\n          <label className=\"text-[10px] font-bold text-slate-500 uppercase tracking-widest ml-1\">\n            {t('danger.typeToConfirmPrefix', { defaultValue: 'Type' })} <strong>{workspaceName}</strong> {t('danger.typeToConfirmSuffix', { defaultValue: 'to confirm' })}\n          </label>\n          <input \n            type=\"text\" \n            value={confirmText}\n            onChange={(e) => setConfirmText(e.target.value)}\n            className=\"w-full px-6 py-4 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-2xl font-bold focus:ring-4 focus:ring-rose-500/20 focus:border-rose-500 outline-none transition-all\"\n            placeholder={workspaceName}\n          />\n        </div>\n\n        <Button \n          variant=\"destructive\" \n          className=\"w-full\"\n          disabled={confirmText !== workspaceName || isLoading}\n          loading={isLoading}\n          onClick={handleClear}\n        >\n          {t('danger.permanentlyDelete', { defaultValue: 'PERMANENTLY DELETE DATA' })}\n        </Button>\n      </div>\n    </Modal>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/workspace/WorkspaceOverviewPage.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/pages/workspace/WorkspacePermissionsPage.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":77,"column":35,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":77,"endColumn":38,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[2585,2588],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[2585,2588],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2