rom \"./helpers\";\nimport { Employee, EmploymentPeriod, EmployeeDepartmentHistory, WorkingCondition, PaginatedResponse } from \"./types\";\n\nexport async function fetchEmployees(\n  wsId: string,\n  page = 1,\n  limit = 50\n): Promise<PaginatedResponse<Employee>> {\n  const response = await apiFetch(\n    `${API_BASE_URL}/workspaces/${wsId}/employees?page=${page}&limit=${limit}`\n  );\n  if (!response.ok) throw new Error(\"Failed to fetch employees\");\n  return response.json();\n}\n\n// --- Employment Phases API ---\n\nexport async function fetchEmploymentPhases(wsId: string): Promise<any[]> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/employment-phases`);\n  if (!response.ok) throw new Error(\"Failed to fetch employment phases\");\n  return response.json();\n}\n\nexport async function createEmploymentPhase(wsId: string, data: any): Promise<any> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/employment-phases`, {\n    method: \"POST\",\n    body: JSON.stringify(data),\n  });\n  if (!response.ok) throw new Error(\"Failed to create employment phase\");\n  return response.json();\n}\n\nexport async function fetchWorkingConditions(wsId: string, employeeId: string): Promise<WorkingCondition[]> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/employees/${employeeId}/conditions`);\n  if (!response.ok) throw new Error(\"Failed to fetch working conditions\");\n  return response.json();\n}\n\nexport async function createWorkingCondition(\n  wsId: string,\n  employeeId: string,\n  condition: Partial<WorkingCondition>\n): Promise<WorkingCondition> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/employees/${employeeId}/conditions`, {\n    method: \"POST\",\n    body: JSON.stringify(condition),\n  });\n  if (!response.ok) throw new Error(\"Failed to create working condition\");\n  return response.json();\n}\n\nexport async function deleteWorkingCondition(wsId: string, employeeId: string, conditionId: string): Promise<void> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/employees/${employeeId}/conditions/${conditionId}`, {\n    method: \"DELETE\",\n  });\n  if (!response.ok) throw new Error(\"Failed to delete working condition\");\n}\n\nexport async function searchEmployees(\n  wsId: string, \n  query: string,\n  page = 1,\n  limit = 50,\n  sortBy?: string,\n  sortDir?: string,\n  departmentIds?: string[],\n): Promise<PaginatedResponse<Employee>> {\n  const queryParams = new URLSearchParams();\n  if (query) {\n    queryParams.append(\"q\", query);\n  }\n  queryParams.append(\"page\", page.toString());\n  queryParams.append(\"limit\", limit.toString());\n  if (sortBy) {\n    queryParams.append(\"sort_by\", sortBy);\n  }\n  if (sortDir) {\n    queryParams.append(\"sort_dir\", sortDir);\n  }\n  if (departmentIds && departmentIds.length > 0) {\n    queryParams.append(\"department_id\", departmentIds.join(\",\"));\n  }\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/employees?${queryParams.toString()}`);\n  if (!response.ok) throw new Error(\"Failed to search employees\");\n  return response.json();\n}\n\nexport async function fetchEmployee(wsId: string, id: string): Promise<Employee> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/employees/${id}`);\n  if (!response.ok) throw new Error(\"Failed to fetch employee\");\n  return response.json();\n}\n\nexport async function fetchEmploymentHistory(\n  wsId: string,\n  id: string\n): Promise<EmploymentPeriod[]> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/employees/${id}/history`);\n  if (!response.ok) throw new Error(\"Failed to fetch employment history\");\n  return response.json();\n}\n\nexport async function rehireEmployee(\n  wsId: string,\n  id: string,\n  data: { hire_date: string }\n): Promise<Employee> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/employees/${id}/rehire`, {\n    method: \"POST\",\n    body: JSON.stringify(data),\n  });\n  if (!response.ok) {\n    const error = await response.text();\n    throw new Error(error || \"Failed to re-hire employee\");\n  }\n  return response.json();\n}\n\nexport async function createEmployee(\n  wsId: string,\n  employee: Partial<Employee>,\n): Promise<Employee> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/employees`, {\n    method: \"POST\",\n    body: JSON.stringify(employee),\n  });\n  if (!response.ok) throw new Error(\"Failed to create employee\");\n  return response.json();\n}\n\nexport async function updateEmployee(\n  wsId: string,\n  id: string,\n  employee: Partial<Employee>,\n): Promise<Employee> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/employees/${id}`, {\n    method: \"PUT\",\n    body: JSON.stringify(employee),\n  });\n  if (!response.ok) throw new Error(\"Failed to update employee\");\n  return response.json();\n}\n\nexport async function deleteEmployee(wsId: string, id: string): Promise<void> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/employees/${id}`, {\n    method: \"DELETE\",\n  });\n  if (!response.ok) throw new Error(\"Failed to delete employee\");\n}\n\nexport async function transferEmployee(\n  wsId: string,\n  employeeId: string,\n  data: { department_id: string; effective_date: string; notes?: string }\n): Promise<EmployeeDepartmentHistory> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/employees/${employeeId}/departments`, {\n    method: \"POST\",\n    body: JSON.stringify(data),\n  });\n  if (!response.ok) throw new Error(\"Failed to transfer employee\");\n  return response.json();\n}\n\nexport async function fetchEmployeeDepartmentHistory(wsId: string, employeeId: string): Promise<EmployeeDepartmentHistory[]> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/employees/${employeeId}/departments`);\n  if (!response.ok) throw new Error(\"Failed to fetch dept history\");\n  return response.json();\n}","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/lib/api/ess.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'getCurrentUserId' is defined but never used. Allowed unused vars must match /^_/u.","line":7,"column":43,"nodeType":"Identifier","messageId":"unusedVar","endLine":7,"endColumn":59,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"getCurrentUserId"},"fix":{"range":[184,202],"text":""},"desc":"Remove unused variable \"getCurrentUserId\"."}]},{"ruleId":"import-x/order","severity":2,"message":"There should be no empty line within import group","line":8,"column":1,"nodeType":"ImportDeclaration","messageId":"noLineWithinGroup","endLine":19,"endColumn":18},{"ruleId":"import-x/order","severity":2,"message":"`./attendance` import should occur before import of `./config`","line":181,"column":1,"nodeType":"ImportDeclaration","messageId":"order","endLine":181,"endColumn":66}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * Employee Self-Service (ESS) API Client\n * Endpoints for employees to manage their own data\n */\n\nimport { API_BASE_URL } from \"./config\";\nimport { apiFetch, getCurrentWorkspaceId, getCurrentUserId  } from \"./helpers\";\nimport {\n  MyProfileResponse,\n  EmployeeProfile,\n  EmployeeEmergencyContact,\n  EmployeeDocument,\n  EmployeeLeaveBalance,\n  LeaveRequest,\n  TimeEntry,\n  Payslip,\n  UpdateProfileRequest,\n  CreateEmergencyContactRequest, AttendanceDailySummary \n} from \"./types\";\n\n// --- Profile ---\n\nexport async function fetchMyProfile(): Promise<MyProfileResponse> {\n  const response = await apiFetch(`${API_BASE_URL}/ess/profile`);\n  if (!response.ok) {\n    const error = await response.text();\n    throw new Error(error || \"Failed to fetch profile\");\n  }\n  return response.json();\n}\n\nexport async function updateMyProfile(\n  data: UpdateProfileRequest\n): Promise<EmployeeProfile> {\n  const response = await apiFetch(`${API_BASE_URL}/ess/profile`, {\n    method: \"PUT\",\n    body: JSON.stringify(data),\n  });\n  if (!response.ok) {\n    const error = await response.text();\n    throw new Error(error || \"Failed to update profile\");\n  }\n  return response.json();\n}\n\n// --- Emergency Contacts ---\n\nexport async function fetchMyEmergencyContacts(): Promise<\n  EmployeeEmergencyContact[]\n> {\n  const response = await apiFetch(`${API_BASE_URL}/ess/emergency-contacts`);\n  if (!response.ok) throw new Error(\"Failed to fetch emergency contacts\");\n  return response.json();\n}\n\nexport async function addEmergencyContact(\n  data: CreateEmergencyContactRequest\n): Promise<EmployeeEmergencyContact> {\n  const response = await apiFetch(`${API_BASE_URL}/ess/emergency-contacts`, {\n    method: \"POST\",\n    body: JSON.stringify(data),\n  });\n  if (!response.ok) {\n    const error = await response.text();\n    throw new Error(error || \"Failed to add emergency contact\");\n  }\n  return response.json();\n}\n\nexport async function deleteEmergencyContact(contactId: string): Promise<void> {\n  const response = await apiFetch(\n    `${API_BASE_URL}/ess/emergency-contacts/${contactId}`,\n    {\n      method: \"DELETE\",\n    }\n  );\n  if (!response.ok) throw new Error(\"Failed to delete emergency contact\");\n}\n\n// --- Documents ---\n\nexport async function fetchMyDocuments(): Promise<EmployeeDocument[]> {\n  const response = await apiFetch(`${API_BASE_URL}/ess/documents`);\n  if (!response.ok) throw new Error(\"Failed to fetch documents\");\n  return response.json();\n}\n\n// Document upload will be implemented in Phase 4\n\n// --- Payslips ---\n\nexport async function fetchMyPayslips(): Promise<Payslip[]> {\n  const response = await apiFetch(`${API_BASE_URL}/ess/payslips`);\n  if (!response.ok) throw new Error(\"Failed to fetch payslips\");\n  return response.json();\n}\n\n// --- Attendance ---\n\nexport interface AttendanceParams {\n  start_date?: string;\n  end_date?: string;\n}\n\nexport async function fetchMyAttendance(\n  params?: AttendanceParams\n): Promise<TimeEntry[]> {\n  const searchParams = new URLSearchParams();\n  if (params?.start_date) searchParams.set(\"start_date\", params.start_date);\n  if (params?.end_date) searchParams.set(\"end_date\", params.end_date);\n\n  const query = searchParams.toString();\n  const url = `${API_BASE_URL}/ess/attendance${query ? `?${query}` : \"\"}`;\n\n  const response = await apiFetch(url);\n  if (!response.ok) throw new Error(\"Failed to fetch attendance\");\n  return response.json();\n}\n\n// --- Time Clock ---\n\nexport async function fetchMyTimeEntries(\n  params?: { start_date?: string; end_date?: string }\n): Promise<TimeEntry[]> {\n  const searchParams = new URLSearchParams();\n  if (params?.start_date) searchParams.set(\"start_date\", params.start_date);\n  if (params?.end_date) searchParams.set(\"end_date\", params.end_date);\n\n  const query = searchParams.toString();\n  const url = `${API_BASE_URL}/ess/time-entries${query ? `?${query}` : \"\"}`;\n\n  const response = await apiFetch(url);\n  if (!response.ok) throw new Error(\"Failed to fetch time entries\");\n  return response.json();\n}\n\nexport async function punchInMySelf(\n  data: { entry_type: \"work\" | \"break\"; note?: string }\n): Promise<TimeEntry> {\n  const response = await apiFetch(`${API_BASE_URL}/ess/punch-in`, {\n    method: \"POST\",\n    body: JSON.stringify(data),\n  });\n  if (!response.ok) {\n    const error = await response.text();\n    throw new Error(error || \"Failed to punch in\");\n  }\n  return response.json();\n}\n\nexport async function punchOutMySelf(\n  data?: { note?: string }\n): Promise<TimeEntry> {\n  const response = await apiFetch(`${API_BASE_URL}/ess/punch-out`, {\n    method: \"POST\",\n    body: JSON.stringify(data || {}),\n  });\n  if (!response.ok) {\n    const error = await response.text();\n    throw new Error(error || \"Failed to punch out\");\n  }\n  return response.json();\n}\n\n// --- Leave ---\n\nexport async function fetchEssLeaveBalances(): Promise<EmployeeLeaveBalance[]> {\n  const response = await apiFetch(`${API_BASE_URL}/ess/leave/balances`);\n  if (!response.ok) throw new Error(\"Failed to fetch leave balances\");\n  return response.json();\n}\n\nexport async function fetchEssLeaveRequests(): Promise<LeaveRequest[]> {\n  const response = await apiFetch(`${API_BASE_URL}/ess/leave/requests`);\n  if (!response.ok) throw new Error(\"Failed to fetch leave requests\");\n  return response.json();\n}\n\n// --- OT Claim (ESS Wrapper) ---\n\nimport { claimOt, fetchAttendanceSummaries } from \"./attendance\";\n\n// This requires fetching the employee ID first or having the backend resolve it from token.\n// The backend handler for claimOt expects `employeeId` in path.\n// For ESS, we need to know our own employee ID.\n// Ideally, `fetchMyProfile` returns employee ID.\n\nexport async function fetchMyAttendanceSummaries(\n  start: string,\n  end: string\n): Promise<AttendanceDailySummary[]> {\n  // We need to get the employee ID.\n  // This is a bit tricky if we don\"t have it stored.\n  // Option 1: Call fetchMyProfile first.\n  // Option 2: Backend supports \"me\" as employee ID? No, current implementation expects UUID.\n  \n  // Strategy: We will rely on the caller to provide employeeId or fetch it here.\n  // But wait, the backend `get_attendance_summaries` logic I just wrote supports `employee_id` query param.\n  // If I am not admin, I can only see my own.\n  // But I need to pass the workspace ID.\n  \n  const wsId = getCurrentWorkspaceId();\n  if (!wsId) throw new Error(\"Workspace not found\");\n  \n  // We don\"t necessarily need to pass employeeId if the backend resolves it from user_id for non-admins?\n  // Checking backend code:\n  // \"let target_employee_id = if is_admin { query.employee_id } else { ... find my id ... }\"\n  // So if I don\"t pass employee_id, and I am not admin, it defaults to MY id.\n  // PERFECT!\n  \n  return fetchAttendanceSummaries(wsId, start, end);\n}\n\nexport async function submitMyOtClaim(\n  date: string,\n  minutes: number,\n  reason: string\n): Promise<void> {\n  const wsId = getCurrentWorkspaceId();\n  if (!wsId) throw new Error(\"Workspace not found\");\n  \n  // We need employee ID for the PATH param.\n  // fetchMyProfile cached or stored?\n  // Let\"s fetch profile quickly.\n  const profile = await fetchMyProfile();\n  const employeeId = profile.employee.id;\n  \n  return claimOt(wsId, employeeId, { date, claimed_minutes: minutes, reason });\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/lib/api/helpers.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'timeout' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":128,"column":11,"nodeType":"Identifier","messageId":"unusedVar","endLine":128,"endColumn":18},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":131,"column":24,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":131,"endColumn":27,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[3566,3569],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[3566,3569],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { ROUTES } from \"@/lib/routes\";\n\nimport { API_BASE_URL } from \"./config\";\n\nexport function getAccessToken(): string | null {\n  return localStorage.getItem(\"access_token\");\n}\n\nexport function setAccessToken(token: string) {\n  localStorage.setItem(\"access_token\", token);\n}\n\nexport function getRefreshToken(): string | null {\n  return localStorage.getItem(\"refresh_token\");\n}\n\nexport function setRefreshToken(token: string) {\n  localStorage.setItem(\"refresh_token\", token);\n}\n\nexport function getCurrentWorkspaceId(): string | null {\n  return localStorage.getItem(\"active_workspace_id\");\n}\n\nexport function setCurrentWorkspaceId(id: string) {\n  localStorage.setItem(\"active_workspace_id\", id);\n}\n\nexport function getCurrentUserId(): string | null {\n  return localStorage.getItem(\"active_user_id\");\n}\n\nexport const setCurrentUserId = (id: string) => {\n  localStorage.setItem(\"active_user_id\", id);\n};\n\nexport const clearAuthSession = () => {\n  localStorage.removeItem(\"active_user_id\");\n  localStorage.removeItem(\"active_workspace_id\");\n  localStorage.removeItem(\"access_token\");\n  localStorage.removeItem(\"refresh_token\");\n\n  // Call backend to clear HttpOnly cookies\n  fetch(`${API_BASE_URL}/auth/logout`, { \n    method: \"POST\", \n    credentials: \"include\",\n    headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify({})\n  }).catch(console.error);\n};\n\nfunction getHeaders() {\n  const headers: Record<string, string> = {\n    \"Content-Type\": \"application/json\",\n  };\n  const wsId = getCurrentWorkspaceId();\n  if (wsId) {\n    headers[\"X-Workspace-Id\"] = wsId;\n  }\n  const token = getAccessToken();\n  if (token) {\n    headers[\"Authorization\"] = `Bearer ${token}`;\n  } else {\n    // Fallback for dev mode\n    const userId = getCurrentUserId();\n    if (userId) headers[\"X-User-Id\"] = userId;\n  }\n\n  // Debug Headers (only in development)\n  if (import.meta.env.DEV) {\n    const isEnabled = localStorage.getItem(\"debug_enabled\") === \"true\";\n    if (isEnabled) {\n      const impId = localStorage.getItem(\"debug_impersonate_id\");\n      if (impId) {\n        headers[\"X-Debug-Impersonate-Id\"] = impId;\n      }\n      const mockDate = localStorage.getItem(\"debug_mock_date\");\n      if (mockDate) {\n        headers[\"X-Debug-Mock-Date\"] = mockDate;\n      }\n    }\n  }\n\n  return headers;\n}\n\n/**\n * Extended RequestInit with custom timeout\n */\nexport interface ApiFetchOptions extends RequestInit {\n  /**\n   * Request timeout in milliseconds\n   * @default 10000 (10 seconds)\n   */\n  timeout?: number;\n}\n\n/**\n * Timeout constants for different operation types\n */\nexport const TIMEOUT = {\n  /** Standard API calls (10 seconds) */\n  DEFAULT: 10000,\n  /** Report generation and large file operations (3 minutes) */\n  REPORT_OPERATION: 180000,\n  /** Health checks and quick operations (5 seconds) */\n  QUICK: 5000,\n} as const;\n\n/**\n * Wrapper for fetch to handle 401 and refresh token\n *\n * @param url - API endpoint URL\n * @param options - Fetch options with optional timeout (default: 10 seconds)\n */\nexport async function apiFetch(\n  url: string,\n  options: ApiFetchOptions = {},\n): Promise<Response> {\n  const controller = new AbortController();\n  // Default timeout: 10 seconds for normal API calls\n  const timeoutMs = options.timeout ?? TIMEOUT.DEFAULT;\n  const id = setTimeout(() => controller.abort(), timeoutMs);\n\n  const headers = { ...getHeaders(), ...options.headers };\n\n  // Remove timeout from options to avoid passing it to fetch\n  const { timeout, ...fetchOptions } = options;\n\n  if (fetchOptions.body instanceof FormData) {\n    delete (headers as any)[\"Content-Type\"];\n  }\n\n  // If url already starts with http/https or the API_BASE_URL, don't prepend API_BASE_URL\n  let fullUrl = url;\n  if (!url.startsWith(\"http\") && !url.startsWith(API_BASE_URL)) {\n    const path = url.startsWith(\"/\") ? url : `/${url}`;\n    fullUrl = `${API_BASE_URL}${path}`;\n  }\n\n  try {\n    const response = await fetch(fullUrl, {\n      ...fetchOptions,\n      headers,\n      credentials: \"include\", // Send HttpOnly cookies\n      signal: controller.signal\n    });\n    clearTimeout(id);\n    \n    if (response.status === 401 && !fullUrl.includes(\"/auth/login\")) {\n      // Attempt to refresh token\n      const refreshToken = getRefreshToken();\n      if (refreshToken) {\n        try {\n          const refreshResponse = await fetch(`${API_BASE_URL}/auth/refresh`, {\n            method: \"POST\",\n            headers: { \"Content-Type\": \"application/json\" },\n            credentials: \"include\", // Send HttpOnly cookies\n            body: JSON.stringify({ refresh_token: refreshToken }),\n          });\n\n          if (refreshResponse.ok) {\n            const data = await refreshResponse.json();\n            setAccessToken(data.access_token);\n            setRefreshToken(data.refresh_token);\n\n            // Retry original request with new token\n            const retryHeaders = { ...headers, Authorization: `Bearer ${data.access_token}` };\n            const retryResponse = await fetch(fullUrl, {\n              ...fetchOptions,\n              headers: retryHeaders,\n              credentials: \"include\", // Send HttpOnly cookies\n              signal: controller.signal\n            });\n            clearTimeout(id);\n            return retryResponse;\n          }\n        } catch (e) {\n          console.error(\"Token refresh failed\", e);\n        }\n      }\n      \n      console.warn(\"Session expired (401). Redirecting to login...\");\n      clearAuthSession();\n      if (window.location.pathname !== ROUTES.LOGIN) {\n        window.location.href = ROUTES.LOGIN;\n      }\n      throw new Error(\"Session expired\");\n    }\n\n    return response;\n  } catch (error) {\n    clearTimeout(id);\n    throw error;\n  }\n}\n\nexport async function fetchHealth(): Promise<{ status: string }> {\n  const response = await apiFetch(`${API_BASE_URL}/health`);\n  return response.json();\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/lib/api/holidays.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/lib/api/index.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/lib/api/leaves.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'jobId' is defined but never used. Allowed unused args must match /^_/u.","line":295,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":295,"endColumn":8}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { API_BASE_URL } from './config';\nimport { apiFetch } from \"./helpers\";\nimport { LeavePolicyAssignmentDetail, LeaveRequest, EmployeeLeaveBalance, WorkspaceLeaveBalance, LeaveHistoryItem, LeavePolicy, LeaveType, LeaveTypeConfig, LeaveDurationType, PaginatedResponse } from './types';\n\nexport async function submitLeaveRequest(\n  wsId: string,\n  data: {\n    employee_id: string;\n    leave_type_id: string;\n    start_date: string;\n    end_date: string;\n    reason?: string;\n    duration_type?: LeaveDurationType;\n    start_time?: string;\n    end_time?: string;\n  },\n): Promise<LeaveRequest> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/leave/submit`, {\n    method: 'POST',\n    body: JSON.stringify(data),\n  });\n  if (!response.ok) throw new Error('Failed to submit leave request');\n  return response.json();\n}\n\nexport async function fetchWorkspaceLeaveRequests(\n  wsId: string,\n  status?: string,\n): Promise<LeaveRequest[]> {\n  const url = status\n    ? `${API_BASE_URL}/workspaces/${wsId}/leave/requests?status=${status}`\n    : `${API_BASE_URL}/workspaces/${wsId}/leave/requests`;\n  const response = await apiFetch(url);\n  if (!response.ok) throw new Error('Failed to fetch leave requests');\n  return response.json();\n}\n\nexport async function fetchMyLeaveRequests(\n  employeeId: string\n): Promise<LeaveRequest[]> {\n  const response = await apiFetch(`${API_BASE_URL}/employees/${employeeId}/leave/requests`);\n  if (!response.ok) throw new Error('Failed to fetch my leave requests');\n  return response.json();\n}\n\nexport async function approveLeaveRequest(\n  wsId: string,\n  requestId: string,\n  data: { status: string },\n): Promise<void> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/leave/requests/${requestId}/approve`, {\n    method: 'POST',\n    body: JSON.stringify(data),\n  });\n  if (!response.ok) throw new Error('Failed to approve leave request');\n}\n\nexport async function fetchEmployeeLeaveBalances(\n  wsId: string,\n  employeeId: string,\n): Promise<EmployeeLeaveBalance[]> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/employees/${employeeId}/leave/balances`);\n  if (!response.ok) throw new Error('Failed to fetch leave balances');\n  return response.json();\n}\n\nexport async function fetchWorkspaceLeaveBalances(\n  wsId: string,\n  params?: { page?: number; limit?: number; q?: string; year?: number }\n): Promise<PaginatedResponse<WorkspaceLeaveBalance>> {\n  const query = new URLSearchParams();\n  if (params?.page) query.append('page', params.page.toString());\n  if (params?.limit) query.append('limit', params.limit.toString());\n  if (params?.q) query.append('q', params.q);\n  if (params?.year) query.append('year', params.year.toString());\n\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/leave/balances?${query.toString()}`);\n  if (!response.ok) throw new Error('Failed to fetch workspace leave balances');\n  return response.json();\n}\n\nexport async function fetchLeaveHistory(\n  wsId: string,\n  employeeId: string,\n  leaveTypeId?: string,\n): Promise<LeaveHistoryItem[]> {\n  const url = leaveTypeId\n    ? `${API_BASE_URL}/workspaces/${wsId}/employees/${employeeId}/leave/history?leave_type_id=${leaveTypeId}`\n    : `${API_BASE_URL}/workspaces/${wsId}/employees/${employeeId}/leave/history`;\n  const response = await apiFetch(url);\n  if (!response.ok) throw new Error('Failed to fetch leave history');\n  return response.json();\n}\n\nexport async function adjustLeaveBalance(\n  wsId: string,\n  employeeId: string,\n  data: { leave_type_id: string; amount: number; reason: string; transaction_date: string }\n): Promise<void> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/employees/${employeeId}/leave/adjust`, {\n    method: 'POST',\n    body: JSON.stringify(data),\n  });\n  if (!response.ok) throw new Error('Failed to adjust leave balance');\n}\n\nexport async function fetchLeavePolicies(wsId: string): Promise<LeavePolicy[]> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/leave/policies`);\n  if (!response.ok) throw new Error('Failed to fetch leave policies');\n  return response.json();\n}\n\nexport async function createLeavePolicy(\n  wsId: string,\n  data: Partial<LeavePolicy>\n): Promise<LeavePolicy> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/leave/policies`, {\n    method: 'POST',\n    body: JSON.stringify(data),\n  });\n  if (!response.ok) throw new Error('Failed to create leave policy');\n  return response.json();\n}\n\nexport async function updateLeavePolicy(\n  wsId: string,\n  policyId: string,\n  data: Partial<LeavePolicy>\n): Promise<LeavePolicy> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/leave/policies/${policyId}`, {\n    method: \"PATCH\",\n    body: JSON.stringify(data),\n  });\n  if (!response.ok) throw new Error('Failed to update leave policy');\n  return response.json();\n}\n\nexport async function deleteLeavePolicy(\n  wsId: string,\n  policyId: string\n): Promise<void> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/leave/policies/${policyId}`, {\n    method: 'DELETE',\n  });\n  if (!response.ok) throw new Error('Failed to delete leave policy');\n}\n\nexport async function fetchLeaveTypes(wsId: string): Promise<LeaveType[]> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/leave/types`);\n  if (!response.ok) throw new Error('Failed to fetch leave types');\n  return response.json();\n}\n\nexport async function createLeaveType(\n  wsId: string,\n  data: Partial<LeaveType>\n): Promise<LeaveType> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/leave/types`, {\n    method: 'POST',\n    body: JSON.stringify(data),\n  });\n  if (!response.ok) throw new Error('Failed to create leave type');\n  return response.json();\n}\n\nexport async function updateLeaveType(\n  wsId: string,\n  id: string,\n  data: Partial<LeaveType>\n): Promise<LeaveType> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/leave/types/${id}`, {\n    method: \"PATCH\",\n    body: JSON.stringify(data),\n  });\n  if (!response.ok) throw new Error('Failed to update leave type');\n  return response.json();\n}\n\nexport async function deleteLeaveType(\n  wsId: string,\n  id: string\n): Promise<void> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/leave/types/${id}`, {\n    method: 'DELETE',\n  });\n  if (!response.ok) throw new Error('Failed to delete leave type');\n}\n\nexport async function fetchLeavePolicyAssignments(wsId: string): Promise<LeavePolicyAssignmentDetail[]> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/leave/policies/assignments`);\n  if (!response.ok) throw new Error('Failed to fetch policy assignments');\n  return response.json();\n}\n\nexport async function assignLeavePolicy(\n  wsId: string,\n  data: { assignee_type: string; assignee_id: string | null; policy_id: string; effective_from: string }\n): Promise<void> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/leave/policies/assign`, {\n    method: 'POST',\n    body: JSON.stringify(data),\n  });\n  if (!response.ok) throw new Error('Failed to assign leave policy');\n}\n\nexport interface AccrualJobResponse {\n  job_id: string;\n  status: string;\n  message: string;\n}\n\nexport async function triggerAccrualRun(\n  wsId: string,\n  data: { date: string }\n): Promise<AccrualJobResponse> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/leave/accrual/run`, {\n    method: 'POST',\n    body: JSON.stringify(data),\n  });\n  if (!response.ok) throw new Error('Failed to trigger accrual run');\n  return response.json();\n}\n\nexport interface JobStatusResponse {\n  job_id: string;\n  status: string;\n  completed_at: string | null;\n  error_message: string | null;\n}\n\nexport async function fetchJobStatus(\n  wsId: string,\n  jobId: string\n): Promise<JobStatusResponse> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/jobs/${jobId}/status`);\n  if (!response.ok) throw new Error('Failed to fetch job status');\n  return response.json();\n}\n\nexport async function updateLeaveTypeConfig(\n  wsId: string,\n  id: string,\n  config: LeaveTypeConfig\n): Promise<LeaveType> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/leave/types/${id}/config`, {\n    method: \"PATCH\",\n    body: JSON.stringify(config),\n  });\n  if (!response.ok) throw new Error('Failed to update leave type config');\n  return response.json();\n}\n\n// ========================\n// Leave Import API\n// ========================\n\nexport interface LeaveImportJob {\n  id: string;\n  status: 'pending' | 'processing' | 'completed' | 'failed';\n  total_rows: number;\n  processed_rows: number;\n  error_log: string | null;\n  created_at: string;\n  updated_at: string;\n}\n\n/** Upload an Excel file for bulk leave request import. */\nexport async function uploadLeaveExcel(\n  wsId: string,\n  file: File,\n): Promise<{ job_id: string; status: string }> {\n  const formData = new FormData();\n  formData.append('file', file);\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/leave/upload-excel`, {\n    method: 'POST',\n    body: formData,\n    headers: {}, // Let browser set Content-Type for multipart\n  });\n  if (!response.ok) throw new Error('Failed to upload leave excel');\n  return response.json();\n}\n\n/** Fetch the latest leave import job for the workspace (page resume). */\nexport async function fetchLatestLeaveImport(\n  wsId: string,\n): Promise<LeaveImportJob | null> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/leave/import/latest`);\n  if (!response.ok) return null;\n  return response.json();\n}\n\n/** Fetch a specific import job by its ID (for polling). */\nexport async function fetchLeaveImportStatus(\n  wsId: string,\n  jobId: string,\n): Promise<LeaveImportJob | null> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/leave/import/latest`);\n  if (!response.ok) return null;\n  return response.json();\n}\n\n/** Get the URL for downloading the error Excel file (URL-only, for non-fetch usage). */\nexport function getLeaveImportErrorsUrl(wsId: string, jobId: string): string {\n  return `${API_BASE_URL}/workspaces/${wsId}/leave/import/${jobId}/errors`;\n}\n\n/** Get the URL for downloading the import template Excel (URL-only, for non-fetch usage). */\nexport function getLeaveImportTemplateUrl(wsId: string, lang = \"en\"): string {\n  return `${API_BASE_URL}/workspaces/${wsId}/leave/upload-template?lang=${lang}`;\n}\n\n/** Download the leave import template Excel via authenticated fetch. */\nexport async function downloadLeaveImportTemplate(wsId: string, lang = \"en\"): Promise<void> {\n  const response = await apiFetch(\n    `${API_BASE_URL}/workspaces/${wsId}/leave/upload-template?lang=${lang}`,\n    { timeout: 30000 }\n  );\n  if (!response.ok) throw new Error(\"Failed to download template\");\n  const blob = await response.blob();\n  const url = window.URL.createObjectURL(blob);\n  const a = document.createElement(\"a\");\n  a.href = url;\n  a.download = \"leave_import_template.xlsx\";\n  document.body.appendChild(a);\n  a.click();\n  document.body.removeChild(a);\n  window.URL.revokeObjectURL(url);\n}\n\n/** Download the error Excel file via authenticated fetch. */\nexport async function downloadLeaveImportErrors(wsId: string, jobId: string): Promise<void> {\n  const response = await apiFetch(\n    `${API_BASE_URL}/workspaces/${wsId}/leave/import/${jobId}/errors`,\n    { timeout: 30000 }\n  );\n  if (!response.ok) throw new Error(\"Failed to download error file\");\n  const blob = await response.blob();\n  const url = window.URL.createObjectURL(blob);\n  const a = document.createElement(\"a\");\n  a.href = url;\n  a.download = `leave_import_errors_${jobId}.xlsx`;\n  document.body.appendChild(a);\n  a.click();\n  document.body.removeChild(a);\n  window.URL.revokeObjectURL(url);\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/lib/api/payroll.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":20,"column":65,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":20,"endColumn":68,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[656,659],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[656,659],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":160,"column":64,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":160,"endColumn":67,"suggestions":[{"messageId":"suggestUnknown"