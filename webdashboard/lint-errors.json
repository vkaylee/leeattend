import AgentAccordionCard from \"../AgentAccordionCard\";\n\n// Mock translation\nvi.mock(\"react-i18next\", () => ({\n  useTranslation: () => ({\n    t: (key: string, options?: any) => {\n      if (key === \"agents.messages.confirm_delete\") return `Delete ${options?.name}?`;\n      if (key === \"agents.messages.confirm_revoke\") return `Revoke ${options?.name}?`;\n      if (key === \"agents.messages.confirm_approve\") return `Approve ${options?.name}?`;\n      if (key === \"common.confirm\") return \"Confirm\";\n      if (key === \"common.warning\") return \"Warning\";\n      return key;\n    }\n  })\n}));\n\nconst mockAgent: AuthorizedAgent = {\n  id: \"agent-1\",\n  name: \"Test Agent\",\n  is_active: true,\n  is_trusted: true,\n  last_seen_at: \"2026-01-01T00:00:00Z\"\n} as any;\n\nconst renderComponent = (props: any) => {\n  return render(\n    <ToastProvider>\n      <AgentAccordionCard {...props} />\n    </ToastProvider>\n  );\n};\n\ndescribe(\"AgentAccordionCard\", () => {\n  const onDelete = vi.fn().mockResolvedValue(undefined);\n  const onToggleTrust = vi.fn().mockResolvedValue(undefined);\n\n  beforeEach(() => {\n    vi.clearAllMocks();\n  });\n\n  it(\"should handle delete flow using useConfirm modal\", async () => {\n    const user = userEvent.setup();\n    renderComponent({\n      agent: mockAgent,\n      devices: [],\n      isExpanded: false,\n      onToggleExpand: vi.fn(),\n      onEdit: vi.fn(),\n      onToggleTrust,\n      onDelete,\n      onUpdateDevice: vi.fn(),\n      onDeleteDevice: vi.fn(),\n      isOnline: true\n    });\n\n    // Click delete button\n    const deleteBtn = screen.getByTestId(`agent-delete-${mockAgent.id}`);\n    await user.click(deleteBtn);\n\n    // Verify modal appears\n    expect(await screen.findByText(\"Warning\")).toBeDefined();\n    expect(await screen.findByText(\"Delete Test Agent?\")).toBeDefined();\n\n    // Click confirm in the modal\n    const confirmBtn = screen.getByRole(\"button\", { name: \"Confirm\" });\n    await user.click(confirmBtn);\n\n    // Verify onDelete was called\n    await waitFor(() => {\n      expect(onDelete).toHaveBeenCalledWith(mockAgent);\n    });\n  });\n\n  it(\"should handle toggle trust flow using useConfirm modal\", async () => {\n    const user = userEvent.setup();\n    renderComponent({\n      agent: mockAgent,\n      devices: [],\n      isExpanded: false,\n      onToggleExpand: vi.fn(),\n      onEdit: vi.fn(),\n      onToggleTrust,\n      onDelete,\n      onUpdateDevice: vi.fn(),\n      onDeleteDevice: vi.fn(),\n      isOnline: true\n    });\n\n    // Click toggle trust button\n    const trustBtn = screen.getByTestId(`agent-trust-toggle-${mockAgent.id}`);\n    await user.click(trustBtn);\n\n    // Verify modal appears\n    expect(await screen.findByText(\"Warning\")).toBeDefined();\n    expect(await screen.findByText(\"Revoke Test Agent?\")).toBeDefined();\n\n    // Click confirm in the modal\n    const confirmBtn = screen.getByRole(\"button\", { name: \"Confirm\" });\n    await user.click(confirmBtn);\n\n    // Verify onToggleTrust was called\n    await waitFor(() => {\n      expect(onToggleTrust).toHaveBeenCalledWith(mockAgent);\n    });\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/connectivity/__tests__/DeviceListItem.test.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":106,"column":27,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":106,"endColumn":30,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[2900,2903],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[2900,2903],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":125,"column":27,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":125,"endColumn":30,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[3450,3453],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[3450,3453],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":231,"column":60,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":231,"endColumn":63,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[6762,6765],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[6762,6765],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { screen } from \"@testing-library/react\";\nimport { describe, it, expect, vi, beforeEach } from \"vitest\";\n\nimport { ToastProvider } from \"@/components/ui/Toast\";\n\nimport { Device, DeviceStatus } from \"@/lib/api\";\nimport { renderWithClient } from \"@/test/utils\";\n\nimport DeviceListItem from \"../DeviceListItem\";\n\n\n// Mock i18next\nvi.mock(\"react-i18next\", () => ({\n  useTranslation: () => ({\n    t: (key: string) => key,\n  }),\n}));\n\n// Mock useTickingDeviceTime — returns the deviceTime as-is for simplicity in tests\nconst mockUseTickingDeviceTime = vi.fn();\nvi.mock(\"@/hooks/useTickingDeviceTime\", () => ({\n  useTickingDeviceTime: (...args: unknown[]) => mockUseTickingDeviceTime(...args),\n}));\n\nconst mockDevice: Device = {\n  id: \"dev-1\",\n  agent_id: \"agent-1\",\n  name: \"Office Device\",\n  ip: \"192.168.1.100\",\n  port: 4370,\n  brand: \"zkteco\",\n  is_enabled: true,\n  timezone: \"UTC\",\n  last_status: \"online\",\n  created_at: new Date().toISOString(),\n  workspace_id: \"ws-1\",\n};\n\nconst mockStatus: DeviceStatus = {\n  device_id: \"dev-1\",\n  status: \"online\",\n  info: {\n    users_count: 42,\n    logs_count: 1337,\n    logs_capacity: 50000,\n    device_time: \"2023-01-01 10:00:00\",\n    firmware: \"FW 1.2\",\n    last_sync: \"2023-01-01 10:00:01\",\n  },\n};\n\nconst LOGS_LABEL = \"devices.info.logs_capacity\";\n\ndescribe(\"DeviceListItem\", () => {\n  beforeEach(() => {\n    // Default: return the deviceTime argument as-is (passthrough)\n    mockUseTickingDeviceTime.mockImplementation((dt: string | undefined) => dt ?? null);\n  });\n\n  it(\"renders basic device info\", () => {\n    renderWithClient(\n      <ToastProvider>\n        <DeviceListItem\n          device={mockDevice}\n          onUpdate={async () => { }}\n          onDelete={async () => { }}\n        />\n      </ToastProvider>\n    );\n    expect(screen.getByText(\"Office Device\")).toBeDefined();\n    expect(screen.getByText(\"192.168.1.100\")).toBeDefined();\n  });\n\n  it(\"renders metadata when status info is provided\", () => {\n    renderWithClient(\n      <ToastProvider>\n        <DeviceListItem\n          device={mockDevice}\n          status={mockStatus}\n          onUpdate={async () => { }}\n          onDelete={async () => { }}\n        />\n      </ToastProvider>\n    );\n    expect(screen.getByText(\"2023-01-01 10:00:00\")).toBeDefined();\n    expect(screen.getByText(\"42\")).toBeDefined();\n    expect(screen.getByText(\"vFW 1.2\")).toBeDefined();\n  });\n\n  it(\"renders '--' when status is missing\", () => {\n    renderWithClient(\n      <ToastProvider>\n        <DeviceListItem\n          device={mockDevice}\n          status={undefined}\n          onUpdate={async () => { }}\n          onDelete={async () => { }}\n        />\n      </ToastProvider>\n    );\n    const logsValue = screen.getByText(LOGS_LABEL).nextElementSibling?.textContent;\n    expect(logsValue).toContain(\"--\");\n  });\n\n  it(\"renders 'N/A' when logs_count is null or invalid\", () => {\n    const statusWithNull: any = {\n      ...mockStatus,\n      info: { ...mockStatus.info, logs_count: null }\n    };\n    renderWithClient(\n      <ToastProvider>\n        <DeviceListItem\n          device={mockDevice}\n          status={statusWithNull}\n          onUpdate={async () => { }}\n          onDelete={async () => { }}\n        />\n      </ToastProvider>\n    );\n    const logsValue = screen.getByText(LOGS_LABEL).nextElementSibling?.textContent;\n    expect(logsValue).toContain(\"N/A\");\n  });\n\n  it(\"renders '0' when logs_count is exactly 0\", () => {\n    const statusWithZero: any = {\n      ...mockStatus,\n      info: { ...mockStatus.info, logs_count: 0 }\n    };\n    renderWithClient(\n      <ToastProvider>\n        <DeviceListItem\n          device={mockDevice}\n          status={statusWithZero}\n          onUpdate={async () => { }}\n          onDelete={async () => { }}\n        />\n      </ToastProvider>\n    );\n    const logsValue = screen.getByText(LOGS_LABEL).nextElementSibling?.textContent;\n    expect(logsValue).toContain(\"0\");\n  });\n\n  // ===== LOGS/CAPACITY TESTS =====\n\n  it(\"renders logs count with capacity when both are available\", () => {\n    renderWithClient(\n      <ToastProvider>\n        <DeviceListItem\n          device={mockDevice}\n          status={mockStatus}\n          onUpdate={async () => { }}\n          onDelete={async () => { }}\n        />\n      </ToastProvider>\n    );\n    const logsSection = screen.getByText(LOGS_LABEL).nextElementSibling;\n    const text = logsSection?.textContent || \"\";\n    // Should show logs_count and capacity with separator\n    expect(text).toContain(\"1,337\");\n    expect(text).toContain(\"50,000\");\n    expect(text).toContain(\"/\");\n  });\n\n  it(\"renders only logs count when logs_capacity is missing\", () => {\n    const statusNoCapacity: DeviceStatus = {\n      ...mockStatus,\n      info: { ...mockStatus.info!, logs_capacity: undefined },\n    };\n    renderWithClient(\n      <ToastProvider>\n        <DeviceListItem\n          device={mockDevice}\n          status={statusNoCapacity}\n          onUpdate={async () => { }}\n          onDelete={async () => { }}\n        />\n      </ToastProvider>\n    );\n    const logsSection = screen.getByText(LOGS_LABEL).nextElementSibling;\n    const text = logsSection?.textContent || \"\";\n    expect(text).toContain(\"1,337\");\n    expect(text).not.toContain(\"/\");\n  });\n\n  it(\"renders only logs count when logs_capacity is 0\", () => {\n    const statusZeroCapacity: DeviceStatus = {\n      ...mockStatus,\n      info: { ...mockStatus.info!, logs_capacity: 0 },\n    };\n    renderWithClient(\n      <ToastProvider>\n        <DeviceListItem\n          device={mockDevice}\n          status={statusZeroCapacity}\n          onUpdate={async () => { }}\n          onDelete={async () => { }}\n        />\n      </ToastProvider>\n    );\n    const logsSection = screen.getByText(LOGS_LABEL).nextElementSibling;\n    const text = logsSection?.textContent || \"\";\n    expect(text).toContain(\"1,337\");\n    expect(text).not.toContain(\"/\");\n  });\n\n  // ===== LAST SYNC TESTS =====\n\n  it(\"renders last_sync converted to locale string when UTC timestamp provided\", () => {\n    const statusWithSync: DeviceStatus = {\n      ...mockStatus,\n      info: { ...mockStatus.info!, last_sync: \"2026-02-25T15:43:52\" },\n    };\n    renderWithClient(\n      <ToastProvider>\n        <DeviceListItem\n          device={mockDevice}\n          status={statusWithSync}\n          onUpdate={async () => { }}\n          onDelete={async () => { }}\n        />\n      </ToastProvider>\n    );\n    // The raw UTC string should NOT appear — it should be converted via toLocaleString()\n    const allText = document.body.textContent || \"\";\n    expect(allText).not.toContain(\"2026-02-25T15:43:52\");\n  });\n\n  it(\"renders '—' when last_sync is missing\", () => {\n    const statusNoSync: DeviceStatus = {\n      ...mockStatus,\n      info: { ...mockStatus.info!, last_sync: undefined as any },\n    };\n    renderWithClient(\n      <ToastProvider>\n        <DeviceListItem\n          device={mockDevice}\n          status={statusNoSync}\n          onUpdate={async () => { }}\n          onDelete={async () => { }}\n        />\n      </ToastProvider>\n    );\n    // With the mock t() which only returns keys, assert the key is rendered\n    // (the \"—\" fallback is inside the i18n interpolation params, not in the key)\n    const allText = document.body.textContent || \"\";\n    expect(allText).toContain(\"devices.info.last_synced\");\n  });\n\n  it(\"handles last_sync with Z suffix correctly\", () => {\n    const statusWithZ: DeviceStatus = {\n      ...mockStatus,\n      info: { ...mockStatus.info!, last_sync: \"2026-02-25T15:43:52Z\" },\n    };\n    renderWithClient(\n      <ToastProvider>\n        <DeviceListItem\n          device={mockDevice}\n          status={statusWithZ}\n          onUpdate={async () => { }}\n          onDelete={async () => { }}\n        />\n      </ToastProvider>\n    );\n    // Raw UTC string should NOT appear\n    const allText = document.body.textContent || \"\";\n    expect(allText).not.toContain(\"2026-02-25T15:43:52Z\");\n  });\n\n  it(\"handles last_sync with timezone offset correctly\", () => {\n    const statusWithOffset: DeviceStatus = {\n      ...mockStatus,\n      info: { ...mockStatus.info!, last_sync: \"2026-02-25T22:43:52+07:00\" },\n    };\n    renderWithClient(\n      <ToastProvider>\n        <DeviceListItem\n          device={mockDevice}\n          status={statusWithOffset}\n          onUpdate={async () => { }}\n          onDelete={async () => { }}\n        />\n      </ToastProvider>\n    );\n    // Raw ISO string with offset should NOT appear — should be converted via toLocaleString()\n    const allText = document.body.textContent || \"\";\n    expect(allText).not.toContain(\"2026-02-25T22:43:52+07:00\");\n  });\n\n  // ===== DEVICE INFO FIELDS TESTS =====\n\n  it(\"renders serial number from status info\", () => {\n    const statusWithSerial: DeviceStatus = {\n      ...mockStatus,\n      info: { ...mockStatus.info!, serial: \"BSXQ203760345\" },\n    };\n    renderWithClient(\n      <ToastProvider>\n        <DeviceListItem\n          device={mockDevice}\n          status={statusWithSerial}\n          onUpdate={async () => { }}\n          onDelete={async () => { }}\n        />\n      </ToastProvider>\n    );\n    expect(screen.getByText(\"BSXQ203760345\")).toBeDefined();\n  });\n\n  it(\"renders MAC address from status info\", () => {\n    const statusWithMac: DeviceStatus = {\n      ...mockStatus,\n      info: { ...mockStatus.info!, mac: \"AA:BB:CC:DD:EE:FF\" },\n    };\n    renderWithClient(\n      <ToastProvider>\n        <DeviceListItem\n          device={mockDevice}\n          status={statusWithMac}\n          onUpdate={async () => { }}\n          onDelete={async () => { }}\n        />\n      </ToastProvider>\n    );\n    expect(screen.getByText(\"AA:BB:CC:DD:EE:FF\")).toBeDefined();\n  });\n\n  it(\"renders hw_name from status info\", () => {\n    const statusWithHw: DeviceStatus = {\n      ...mockStatus,\n      info: { ...mockStatus.info!, hw_name: \"ZK-F22\" },\n    };\n    renderWithClient(\n      <ToastProvider>\n        <DeviceListItem\n          device={mockDevice}\n          status={statusWithHw}\n          onUpdate={async () => { }}\n          onDelete={async () => { }}\n        />\n      </ToastProvider>\n    );\n    expect(screen.getByText(\"ZK-F22\")).toBeDefined();\n  });\n\n  it(\"renders 'N/A' for serial when not provided\", () => {\n    const statusNoSerial: DeviceStatus = {\n      ...mockStatus,\n      info: { ...mockStatus.info!, serial: undefined },\n    };\n    renderWithClient(\n      <ToastProvider>\n        <DeviceListItem\n          device={mockDevice}\n          status={statusNoSerial}\n          onUpdate={async () => { }}\n          onDelete={async () => { }}\n        />\n      </ToastProvider>\n    );\n    const serialLabel = screen.getByText(\"devices.info.serial\");\n    const serialValue = serialLabel.nextElementSibling?.textContent;\n    expect(serialValue).toContain(\"N/A\");\n  });\n\n  // ===== USERS/CAPACITY TESTS =====\n\n  it(\"renders users count with capacity when both available\", () => {\n    const statusWithCap: DeviceStatus = {\n      ...mockStatus,\n      info: { ...mockStatus.info!, users_count: 120, users_capacity: 500 },\n    };\n    renderWithClient(\n      <ToastProvider>\n        <DeviceListItem\n          device={mockDevice}\n          status={statusWithCap}\n          onUpdate={async () => { }}\n          onDelete={async () => { }}\n        />\n      </ToastProvider>\n    );\n    const usersSection = screen.getByText(\"devices.info.users_capacity\").nextElementSibling;\n    const text = usersSection?.textContent || \"\";\n    expect(text).toContain(\"120\");\n    expect(text).toContain(\"500\");\n    expect(text).toContain(\"/\");\n  });\n\n  it(\"renders only users count when users_capacity is missing\", () => {\n    const statusNoCap: DeviceStatus = {\n      ...mockStatus,\n      info: { ...mockStatus.info!, users_count: 42, users_capacity: undefined },\n    };\n    renderWithClient(\n      <ToastProvider>\n        <DeviceListItem\n          device={mockDevice}\n          status={statusNoCap}\n          onUpdate={async () => { }}\n          onDelete={async () => { }}\n        />\n      </ToastProvider>\n    );\n    const usersSection = screen.getByText(\"devices.info.users_capacity\").nextElementSibling;\n    const text = usersSection?.textContent || \"\";\n    expect(text).toContain(\"42\");\n    expect(text).not.toContain(\"/\");\n  });\n\n  // ===== DEVICE TIME TESTS =====\n\n  it(\"renders ticking device_time when provided\", () => {\n    mockUseTickingDeviceTime.mockReturnValue(\"2026-02-27 14:30:05\");\n    const statusWithTime: DeviceStatus = {\n      ...mockStatus,\n      info: { ...mockStatus.info!, device_time: \"2026-02-27 14:30:00\" },\n    };\n    renderWithClient(\n      <ToastProvider>\n        <DeviceListItem\n          device={mockDevice}\n          status={statusWithTime}\n          onUpdate={async () => { }}\n          onDelete={async () => { }}\n        />\n      </ToastProvider>\n    );\n    expect(screen.getByText(\"2026-02-27 14:30:05\")).toBeDefined();\n  });\n\n  it(\"renders '--:--:--' when device_time is missing\", () => {\n    mockUseTickingDeviceTime.mockReturnValue(null);\n    renderWithClient(\n      <ToastProvider>\n        <DeviceListItem\n          device={mockDevice}\n          status={undefined}\n          onUpdate={async () => { }}\n          onDelete={async () => { }}\n        />\n      </ToastProvider>\n    );\n    expect(screen.getByText(\"--:--:--\")).toBeDefined();\n  });\n\n  // ===== FIRMWARE FALLBACK TESTS =====\n\n  it(\"renders 'v?.?' when firmware is missing\", () => {\n    const statusNoFw: DeviceStatus = {\n      ...mockStatus,\n      info: { ...mockStatus.info!, firmware: undefined },\n    };\n    renderWithClient(\n      <ToastProvider>\n        <DeviceListItem\n          device={mockDevice}\n          status={statusNoFw}\n          onUpdate={async () => { }}\n          onDelete={async () => { }}\n        />\n      </ToastProvider>\n    );\n    expect(screen.getByText(\"v?.?\")).toBeDefined();\n  });\n\n  // ===== DIMMING BEHAVIOR TESTS =====\n\n  it(\"applies dimmed styling when device is disabled\", () => {\n    const disabledDevice = { ...mockDevice, is_enabled: false };\n    renderWithClient(\n      <ToastProvider>\n        <DeviceListItem\n          device={disabledDevice}\n          status={mockStatus}\n          onUpdate={async () => { }}\n          onDelete={async () => { }}\n        />\n      </ToastProvider>\n    );\n    const deviceItem = screen.getByTestId(\"device-item-dev-1\");\n    expect(deviceItem.className).toContain(\"opacity-60\");\n  });\n\n  it(\"applies dimmed styling when parent agent is not active\", () => {\n    renderWithClient(\n      <ToastProvider>\n        <DeviceListItem\n          device={mockDevice}\n          status={mockStatus}\n          parentAgentActive={false}\n          onUpdate={async () => { }}\n          onDelete={async () => { }}\n        />\n      </ToastProvider>\n    );\n    const deviceItem = screen.getByTestId(\"device-item-dev-1\");\n    expect(deviceItem.className).toContain(\"opacity-60\");\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/dashboard/AttendanceTrendChart.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/dashboard/CollapsibleSection.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/dashboard/CustomizePanel.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'useState' is defined but never used. Allowed unused vars must match /^_/u.","line":1,"column":10,"nodeType":"Identifier","messageId":"unusedVar","endLine":1,"endColumn":18,"suggestions":[{"messageId":"removeUnusedImportDeclaration","data":{"varName":"useState"},"fix":{"range":[0,34],"text":""},"desc":"Remove unused import declaration."}]},{"ruleId":"jsx-a11y/click-events-have-key-events","severity":2,"message":"Visible, non-interactive elements with click handlers must have at least one keyboard listener.","line":169,"column":13,"nodeType":"JSXOpeningElement","endLine":172,"endColumn":15},{"ruleId":"jsx-a11y/no-static-element-interactions","severity":2,"message":"Avoid non-native interactive elements. If using native HTML is not possible, add an appropriate role and support for tabbing, mouse, keyboard, and touch inputs to an interactive content element.","line":169,"column":13,"nodeType":"JSXOpeningElement","endLine":172,"endColumn":15}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState } from \"react\";\n\nimport {\n    DndContext,\n    closestCenter,\n    KeyboardSensor,\n    PointerSensor,\n    useSensor,\n    useSensors,\n    type DragEndEvent,\n} from \"@dnd-kit/core\";\nimport {\n    arrayMove,\n    SortableContext,\n    sortableKeyboardCoordinates,\n    useSortable,\n    verticalListSortingStrategy,\n} from \"@dnd-kit/sortable\";\nimport { CSS } from \"@dnd-kit/utilities\";\nimport { GripVertical, X, RotateCcw, Loader2 } from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { cn } from \"@/lib/utils\";\n\nimport type { WidgetId } from \"@/hooks/use-dashboard-layout\";\n\n// ── Types ──────────────────────────────────────────────────────────\n\ninterface CustomizePanelProps {\n    isOpen: boolean;\n    onClose: () => void;\n    visibleWidgets: Record<WidgetId, boolean>;\n    widgetOrder: WidgetId[];\n    allWidgets: { id: WidgetId; labelKey: string }[];\n    onToggleWidget: (id: WidgetId) => void;\n    onReorder: (order: WidgetId[]) => void;\n    onReset: () => void;\n    isSaving?: boolean;\n}\n\n// ── Sortable Widget Row ────────────────────────────────────────────\n\nfunction SortableWidgetRow({\n    widget,\n    isVisible,\n    onToggle,\n}: {\n    widget: { id: WidgetId; labelKey: string };\n    isVisible: boolean;\n    onToggle: (id: WidgetId) => void;\n}) {\n    const { t } = useTranslation();\n    const {\n        attributes,\n        listeners,\n        setNodeRef,\n        transform,\n        transition,\n        isDragging,\n    } = useSortable({ id: widget.id });\n\n    const style = {\n        transform: CSS.Transform.toString(transform),\n        transition,\n        zIndex: isDragging ? 50 : undefined,\n    };\n\n    return (\n        <div\n            ref={setNodeRef}\n            style={style}\n            className={cn(\n                \"flex items-center gap-3 px-4 py-3 rounded-2xl border transition-all\",\n                isDragging\n                    ? \"bg-primary-50 dark:bg-primary-950 border-primary-200 dark:border-primary-800 shadow-xl\"\n                    : \"bg-white dark:bg-slate-800 border-slate-100 dark:border-slate-700 hover:border-slate-200 dark:hover:border-slate-600\"\n            )}\n        >\n            {/* Drag handle */}\n            <button\n                {...attributes}\n                {...listeners}\n                className=\"cursor-grab active:cursor-grabbing text-slate-300 dark:text-slate-600 hover:text-slate-500 dark:hover:text-slate-400 touch-none\"\n                aria-label=\"Drag to reorder\"\n            >\n                <GripVertical size={16} />\n            </button>\n\n            {/* Label */}\n            <span className=\"flex-1 text-sm font-medium text-slate-700 dark:text-slate-200 truncate\">\n                {t(widget.labelKey)}\n            </span>\n\n            {/* Toggle */}\n            <button\n                onClick={() => onToggle(widget.id)}\n                role=\"switch\"\n                aria-checked={isVisible}\n                className={cn(\n                    \"relative w-10 h-6 rounded-full transition-colors shrink-0\",\n                    isVisible\n                        ? \"bg-primary-600 dark:bg-primary-500\"\n                        : \"bg-slate-200 dark:bg-slate-600\"\n                )}\n            >\n                <span\n                    className={cn(\n                        \"absolute top-0.5 left-0.5 w-5 h-5 rounded-full bg-white shadow-sm transition-transform\",\n                        isVisible && \"translate-x-4\"\n                    )}\n                />\n            </button>\n        </div>\n    );\n}\n\n// ── Main Panel ─────────────────────────────────────────────────────\n\nexport default function CustomizePanel({\n    isOpen,\n    onClose,\n    visibleWidgets,\n    widgetOrder,\n    allWidgets,\n    onToggleWidget,\n    onReorder,\n    onReset,\n    isSaving,\n}: CustomizePanelProps) {\n    const { t } = useTranslation();\n    const sensors = useSensors(\n        useSensor(PointerSensor, { activationConstraint: { distance: 5 } }),\n        useSensor(KeyboardSensor, { coordinateGetter: sortableKeyboardCoordinates })\n    );\n\n    // Get ordered items — include all widgets even if not in current order\n    const orderedWidgets = (() => {\n        const ordered = widgetOrder\n            .map((id) => allWidgets.find((w) => w.id === id))\n            .filter(Boolean) as typeof allWidgets;\n\n        // Add any missing widgets at the end\n        const missing = allWidgets.filter(\n            (w) => !widgetOrder.includes(w.id)\n        );\n        return [...ordered, ...missing];\n    })();\n\n    const handleDragEnd = (event: DragEndEvent) => {\n        const { active, over } = event;\n        if (!over || active.id === over.id) return;\n\n        const oldIndex = orderedWidgets.findIndex((w) => w.id === active.id);\n        const newIndex = orderedWidgets.findIndex((w) => w.id === over.id);\n\n        const newOrder = arrayMove(\n            orderedWidgets.map((w) => w.id),\n            oldIndex,\n            newIndex\n        );\n        onReorder(newOrder);\n    };\n\n    if (!isOpen) return null;\n\n    return (\n        <>\n            {/* Backdrop */}\n            <div\n                className=\"fixed inset-0 bg-black/30 dark:bg-black/50 backdrop-blur-sm z-40 transition-opacity\"\n                onClick={onClose}\n            />\n\n            {/* Panel */}\n            <aside\n                className={cn(\n                    \"fixed right-0 top-0 h-full w-full sm:w-96 bg-white dark:bg-slate-900 border-l border-slate-200 dark:border-slate-800 shadow-2xl z-50\",\n                    \"flex flex-col\",\n                    \"animate-in slide-in-from-right duration-300\"\n                )}\n            >\n                {/* Header */}\n                <div className=\"flex items-center justify-between px-6 py-5 border-b border-slate-100 dark:border-slate-800\">\n                    <div className=\"flex items-center gap-3\">\n                        <h2 className=\"text-lg font-bold text-slate-700 dark:text-slate-200\">\n                            {t(\"dashboard.customize.title\")}\n                        </h2>\n                        {isSaving && <Loader2 size={16} className=\"animate-spin text-primary-500\" />}\n                    </div>\n                    <button\n                        onClick={onClose}\n                        className=\"p-2 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors\"\n                    >\n                        <X size={18} className=\"text-slate-500\" />\n                    </button>\n                </div>\n\n                {/* Widget list */}\n                <div className=\"flex-1 overflow-y-auto px-6 py-5 space-y-3\">\n                    <p className=\"text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest mb-4\">\n                        {t(\"dashboard.customize.widgets\")}\n                    </p>\n\n                    <DndContext\n                        sensors={sensors}\n                        collisionDetection={closestCenter}\n                        onDragEnd={handleDragEnd}\n                    >\n                        <SortableContext\n                            items={orderedWidgets.map((w) => w.id)}\n                            strategy={verticalListSortingStrategy}\n                        >\n                            {orderedWidgets.map((widget) => (\n                                <SortableWidgetRow\n                                    key={widget.id}\n                                    widget={widget}\n                                    isVisible={visibleWidgets[widget.id] ?? false}\n                                    onToggle={onToggleWidget}\n                                />\n                            ))}\n                        </SortableContext>\n                    </DndContext>\n                </div>\n\n                {/* Footer */}\n                <div className=\"px-6 py-5 border-t border-slate-100 dark:border-slate-800 space-y-3\">\n                    <button\n                        onClick={onReset}\n                        className=\"w-full flex items-center justify-center gap-2 px-4 py-2.5 text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest hover:text-slate-700 dark:hover:text-slate-200 transition-colors\"\n                    >\n                        <RotateCcw size={14} />\n                        {t(\"dashboard.customize.reset\")}\n                    </button>\n                </div>\n            </aside>\n        </>\n    );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/dashboard/DashboardViewTabs.tsx","messages":[{"ruleId":"jsx-a11y/no-noninteractive-element-to-interactive-role","severity":2,"message":"Non-interactive elements should not be assigned interactive roles.","line":38,"column":13,"nodeType":"JSXAttribute","endLine":38,"endColumn":27}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import {\n    BarChart3,\n    LineChart,\n    LayoutGrid,\n    Plus,\n} from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { cn } from \"@/lib/utils\";\n\nimport type { DashboardView } from \"@/hooks/use-dashboard-layout\";\n\ninterface DashboardViewTabsProps {\n    activeView: DashboardView;\n    onViewChange: (view: DashboardView) => void;\n}\n\nconst TABS: {\n    id: DashboardView;\n    icon: React.ElementType;\n    labelKey: string;\n}[] = [\n        { id: \"overview\", icon: LayoutGrid, labelKey: \"dashboard.views.overview\" },\n        { id: \"attendance\", icon: BarChart3, labelKey: \"dashboard.views.attendance\" },\n        { id: \"trends\", icon: LineChart, labelKey: \"dashboard.views.trends\" },\n        { id: \"custom\", icon: Plus, labelKey: \"dashboard.views.custom\" },\n    ];\n\nexport default function DashboardViewTabs({\n    activeView,\n    onViewChange,\n}: DashboardViewTabsProps) {\n    const { t } = useTranslation();\n\n    return (\n        <nav\n            className=\"flex bg-slate-100 dark:bg-slate-700/50 p-1.5 rounded-[22px] w-fit border border-slate-200 dark:border-slate-700/50 shadow-inner overflow-x-auto\"\n            role=\"tablist\"\n            aria-label={t(\"dashboard.views.label\")}\n        >\n            {TABS.map((tab) => {\n                const isActive = activeView === tab.id;\n                const Icon = tab.icon;\n                return (\n                    <button\n                        key={tab.id}\n                        role=\"tab\"\n                        aria-selected={isActive}\n                        onClick={() => onViewChange(tab.id)}\n                        className={cn(\n                            \"flex items-center gap-2 px-5 sm:px-8 py-2.5 rounded-[18px] text-xs font-bold uppercase tracking-widest transition-all whitespace-nowrap\",\n                            isActive\n                                ? \"bg-white dark:bg-slate-900 text-primary-600 dark:text-primary-400 shadow-sm border border-slate-100 dark:border-slate-800\"\n                                : \"text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200\"\n                        )}\n                    >\n                        <Icon size={14} />\n                        <span className=\"hidden sm:inline\">{t(tab.labelKey)}</span>\n                    </button>\n                );\n            })}\n        </nav>\n    );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/dashboard/DepartmentAttendanceChart.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/dashboard/LatenessByDayChart.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'BarChart' is defined but never used. Allowed unused vars must match /^_/u.","line":4,"column":5,"nodeType":"Identifier","messageId":"unusedVar","endLine":4,"endColumn":13,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"BarChart"},"fix":{"range":[107,116],"text":""},"desc":"Remove unused variable \"BarChart\"."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { CalendarClock } from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\nimport {\n    BarChart,\n    Bar,\n    XAxis,\n    YAxis,\n    CartesianGrid,\n    Tooltip,\n    ResponsiveContainer,\n    Legend,\n    Line,\n    ComposedChart,\n} from \"recharts\";\n\nimport { useLatenessByDay } from \"@/hooks/use-dashboard\";\n\nconst COLORS = {\n    late_count: \"#f59e0b\",       // amber-500\n    avg_minutes: \"#ef4444\",      // rose-500\n};\n\nexport default function LatenessByDayChart() {\n    const { t } = useTranslation();\n    const { data: days, isLoading } = useLatenessByDay();\n\n    const chartData = days ?? [];\n\n    const hasData =\n        chartData.length > 0 &&\n        chartData.some((d) => d.late_count > 0);\n\n    return (\n        <div className=\"bg-white dark:bg-slate-900 rounded-[3rem] p-10 border border-slate-100 dark:border-slate-800 shadow-sm\">\n            <div className=\"flex items-center gap-4 mb-8\">\n                <div className=\"bg-amber-50 dark:bg-amber-950 w-12 h-12 rounded-[1rem] flex items-center justify-center text-amber-600 dark:text-amber-400 shadow-inner border border-amber-100 dark:border-amber-800\">\n                    <CalendarClock size={22} />\n                </div>\n                <div>\n                    <h2 className=\"text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.25em]\">\n                        {t(\"dashboard.hr.lateness_by_day\")}\n                    </h2>\n                    <p className=\"text-[9px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest mt-0.5\">\n                        {t(\"dashboard.hr.lateness_by_day_subtitle\")}\n                    </p>\n                </div>\n            </div>\n\n            {isLoading ? (\n                <div className=\"h-[280px] flex items-center justify-center\">\n                    <div className=\"w-8 h-8 border-2 border-primary-200 dark:border-primary-800 border-t-primary-600 dark:border-t-primary-400 rounded-full animate-spin\" />\n                </div>\n            ) : !hasData ? (\n                <div className=\"h-[280px] flex flex-col items-center justify-center\">\n                    <CalendarClock size={48} className=\"text-slate-200 dark:text-slate-700 mb-4\" />\n                    <p className=\"text-[10px] font-bold text-slate-300 dark:text-slate-600 uppercase tracking-widest\">\n                        {t(\"common.no_data\")}\n                    </p>\n                </div>\n            ) : (\n                <ResponsiveContainer width=\"100%\" height={280}>\n                    <ComposedChart data={chartData} margin={{ top: 5, right: 10, left: -20, bottom: 5 }}>\n                        <defs>\n                            <linearGradient id=\"gradLateCount\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                                <stop offset=\"5%\" stopColor={COLORS.late_count} stopOpacity={0.8} />\n                                <stop offset=\"95%\" stopColor={COLORS.late_count} stopOpacity={0.4} />\n                            </linearGradient>\n                        </defs>\n                        <CartesianGrid\n                            strokeDasharray=\"3 3\"\n                            stroke=\"currentColor\"\n                            className=\"text-slate-100 dark:text-slate-800\"\n                        />\n                        <XAxis\n                            dataKey=\"day\"\n                            tick={{ fontSize: 10, fontWeight: 700, fill: \"currentColor\" }}\n                            className=\"text-slate-400 dark:text-slate-500\"\n                            tickLine={false}\n                            axisLine={false}\n                        />\n                        <YAxis\n                            yAxisId=\"left\"\n                            tick={{ fontSize: 9, fontWeight: 700, fill: \"currentColor\" }}\n                            className=\"text-slate-400 dark:text-slate-500\"\n                            tickLine={false}\n                            axisLine={false}\n                            allowDecimals={false}\n                        />\n                        <YAxis\n                            yAxisId=\"right\"\n                            orientation=\"right\"\n                            tick={{ fontSize: 9, fontWeight: 700, fill: \"currentColor\" }}\n                            className=\"text-slate-400 dark:text-slate-500\"\n                            tickLine={false}\n                            axisLine={false}\n                            unit=\"m\"\n                        />\n                        <Tooltip\n                            contentStyle={{\n                                borderRadius: \"1rem\",\n                                border: \"none\",\n                                boxShadow: \"0 8px 30px rgba(0,0,0,.1)\",\n                                fontSize: \"11px\",\n                                fontWeight: 600,\n                            }}\n                        />\n                        <Legend\n                            wrapperStyle={{\n                                fontSize: \"9px\",\n                                fontWeight: 700,\n                                textTransform: \"uppercase\",\n                                letterSpacing: \"0.15em\",\n                            }}\n                        />\n                        <Bar\n                            yAxisId=\"left\"\n                            dataKey=\"late_count\"\n                            name={t(\"dashboard.hr.late_count\")}\n                            fill=\"url(#gradLateCount)\"\n                            radius={[6, 6, 0, 0]}\n                        />\n                        <Line\n                            yAxisId=\"right\"\n                            type=\"monotone\"\n                            dataKey=\"avg_late_minutes\"\n                            name={t(\"dashboard.hr.avg_late_minutes\")}\n                            stroke={COLORS.avg_minutes}\n                            strokeWidth={2.5}\n                            dot={{ r: 4, fill: COLORS.avg_minutes }}\n                            activeDot={{ r: 6 }}\n                        />\n                    </ComposedChart>\n                </ResponsiveContainer>\n            )}\n        </div>\n    );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/dashboard/LeaveTypesChart.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/dashboard/OvertimeTrendChart.tsx","messages":[],"suppressedMessages":[],"err