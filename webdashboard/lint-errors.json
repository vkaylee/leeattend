pover-trigger\">{children}</div>,\n  Portal: ({ children }: any) => <div>{children}</div>,\n  Content: ({ children }: any) => <div data-testid=\"popover-content\">{children}</div>,\n}));\n\nvi.mock(\"cmdk\", () => ({\n  Command: Object.assign(\n    ({ children, value, onValueChange }: any) => (\n      <div data-testid=\"cmdk-root\" data-value={value}>{children}</div>\n    ),\n    {\n      Input: vi.fn(({ autoFocus, placeholder }: any) => (\n        <input data-testid=\"cmdk-input\" data-autofocus={autoFocus} placeholder={placeholder} />\n      )),\n      List: ({ children }: any) => <div>{children}</div>,\n      Empty: ({ children }: any) => <div>{children}</div>,\n      Group: ({ children }: any) => <div>{children}</div>,\n      Item: ({ children, value }: any) => <div data-testid={`cmdk-item-${value}`}>{children}</div>,\n    }\n  ),\n}));\n\ndescribe(\"Combobox AutoFocus\", () => {\n  const options = [{ value: \"1\", label: \"Option 1\" }];\n\n  beforeEach(() => {\n    vi.clearAllMocks();\n  });\n\n  it(\"starts with popover open when autoFocus is true\", () => {\n    render(<Combobox options={options} onChange={() => { }} autoFocus={true} />);\n    const root = screen.getByTestId(\"popover-root\");\n    expect(root.getAttribute(\"data-open\")).toBe(\"true\");\n  });\n\n  it(\"always passes autoFocus=true to Command.Input\", () => {\n    render(<Combobox options={options} onChange={() => { }} />);\n    expect(Command.Input).toHaveBeenCalledWith(\n      expect.objectContaining({ autoFocus: true }),\n      undefined\n    );\n  });\n});\n\ndescribe(\"Combobox Keyboard Shortcut\", () => {\n  const options = [\n    { value: \"1\", label: \"Alpha\", description: \"D001\" },\n    { value: \"2\", label: \"Beta\", description: \"D002\" },\n  ];\n\n  beforeEach(() => {\n    vi.clearAllMocks();\n  });\n\n  it(\"opens the popover when keyboard shortcut is pressed\", () => {\n    render(\n      <Combobox\n        options={options}\n        onChange={() => { }}\n        keyboardShortcut=\"/\"\n        onSearchChange={() => { }}\n      />\n    );\n\n    // Initially closed (no autoFocus)\n    const root = screen.getByTestId(\"popover-root\");\n    expect(root.getAttribute(\"data-open\")).toBe(\"false\");\n\n    // Simulate pressing '/' on the document body\n    fireEvent.keyDown(window, { key: \"/\" });\n\n    // Should now be open\n    expect(root.getAttribute(\"data-open\")).toBe(\"true\");\n  });\n\n  it(\"calls onSearchChange with empty string when shortcut is pressed\", () => {\n    const onSearchChange = vi.fn();\n    render(\n      <Combobox\n        options={options}\n        onChange={() => { }}\n        keyboardShortcut=\"/\"\n        onSearchChange={onSearchChange}\n      />\n    );\n\n    fireEvent.keyDown(window, { key: \"/\" });\n    expect(onSearchChange).toHaveBeenCalledWith(\"\");\n  });\n\n  it(\"does NOT trigger shortcut when typing in an input element\", () => {\n    const onSearchChange = vi.fn();\n    render(\n      <div>\n        <input data-testid=\"other-input\" />\n        <Combobox\n          options={options}\n          onChange={() => { }}\n          keyboardShortcut=\"/\"\n          onSearchChange={onSearchChange}\n        />\n      </div>\n    );\n\n    const otherInput = screen.getByTestId(\"other-input\");\n    fireEvent.keyDown(otherInput, { key: \"/\" });\n\n    // Should NOT have been called because the event target is an input\n    expect(onSearchChange).not.toHaveBeenCalled();\n  });\n\n  it(\"handles multiple shortcut keys when passed as an array\", () => {\n    const onSearchChange1 = vi.fn();\n    const { unmount: unmount1 } = render(\n      <Combobox\n        options={options}\n        onChange={() => { }}\n        keyboardShortcut={[\"/\", \"Enter\"]}\n        onSearchChange={onSearchChange1}\n      />\n    );\n\n    // Press Enter\n    fireEvent.keyDown(window, { key: \"Enter\" });\n    expect(onSearchChange1).toHaveBeenCalledTimes(1);\n    unmount1();\n\n    const onSearchChange2 = vi.fn();\n    render(\n      <Combobox\n        options={options}\n        onChange={() => { }}\n        keyboardShortcut={[\"/\", \"Enter\"]}\n        onSearchChange={onSearchChange2}\n      />\n    );\n\n    // Press /\n    fireEvent.keyDown(window, { key: \"/\" });\n    expect(onSearchChange2).toHaveBeenCalledTimes(1);\n  });\n\n  it(\"ignores shortcut keys when the combobox is already open\", () => {\n    const onSearchChange = vi.fn();\n    render(\n      <Combobox\n        options={options}\n        onChange={() => { }}\n        keyboardShortcut=\"Enter\"\n        onSearchChange={onSearchChange}\n        autoFocus={true} // Starts open\n      />\n    );\n\n    const root = screen.getByTestId(\"popover-root\");\n    expect(root.getAttribute(\"data-open\")).toBe(\"true\");\n\n    // Pressing Enter when already open should NOT trigger the shortcut logic\n    // (because cmdk needs to handle the Enter key to select an item)\n    fireEvent.keyDown(window, { key: \"Enter\" });\n\n    // onSearchChange shouldn't be called by the shortcut handler\n    expect(onSearchChange).not.toHaveBeenCalled();\n  });\n\n  it(\"clears the value when clearOnEscape is true and Escape is pressed while closed\", () => {\n    const onChange = vi.fn();\n    const onSearchChange = vi.fn();\n\n    render(\n      <Combobox\n        options={options}\n        value=\"1\"\n        onChange={onChange}\n        onSearchChange={onSearchChange}\n        clearOnEscape={true}\n      />\n    );\n\n    // Initial state is closed\n    const root = screen.getByTestId(\"popover-root\");\n    expect(root.getAttribute(\"data-open\")).toBe(\"false\");\n\n    // Press Escape\n    fireEvent.keyDown(window, { key: \"Escape\" });\n\n    // Both onChange and onSearchChange should be called to reset the value\n    expect(onChange).toHaveBeenCalledWith(\"\");\n    expect(onSearchChange).toHaveBeenCalledWith(\"\");\n  });\n});\n\ndescribe(\"Combobox First Item Highlight\", () => {\n  it(\"sets Command value to first item's cmdk value\", () => {\n    const options = [\n      { value: \"emp-1\", label: \"Alice\", description: \"1541\" },\n      { value: \"emp-2\", label: \"Bob\", description: \"1656\" },\n    ];\n\n    render(<Combobox options={options} onChange={() => { }} />);\n\n    const cmdkRoot = screen.getByTestId(\"cmdk-root\");\n    // The cmdk value should be constructed from the first option\n    expect(cmdkRoot.getAttribute(\"data-value\")).toBe(\"Alice 1541 emp-1\");\n  });\n\n  it(\"updates highlighted value when options change\", () => {\n    const options1 = [\n      { value: \"emp-1\", label: \"Alice\", description: \"1541\" },\n    ];\n    const options2 = [\n      { value: \"emp-3\", label: \"Charlie\", description: \"9999\" },\n    ];\n\n    const { rerender } = render(<Combobox options={options1} onChange={() => { }} />);\n\n    let cmdkRoot = screen.getByTestId(\"cmdk-root\");\n    expect(cmdkRoot.getAttribute(\"data-value\")).toBe(\"Alice 1541 emp-1\");\n\n    // Re-render with new options (simulating server-side search returning different results)\n    rerender(<Combobox options={options2} onChange={() => { }} />);\n\n    cmdkRoot = screen.getByTestId(\"cmdk-root\");\n    expect(cmdkRoot.getAttribute(\"data-value\")).toBe(\"Charlie 9999 emp-3\");\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/ui/ConfirmDialog.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/ui/FormField.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/ui/FormField.tsx","messages":[{"ruleId":"import-x/no-named-as-default-member","severity":1,"message":"Caution: `React` also has a named export `memo`. Check if you meant to write `import {memo} from 'react'` instead.","line":40,"column":19,"nodeType":"MemberExpression","messageId":"member","endLine":40,"endColumn":29}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from \"react\";\n\nimport { cn } from \"@/lib/utils\";\n\n// ── Shared input class ─────────────────────────────────────────────\n\nconst INPUT_BASE =\n  \"w-full px-6 py-4 bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-2xl focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all shadow-sm\";\n\nconst LABEL_BASE =\n  \"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\";\n\n// ── Component ──────────────────────────────────────────────────────\n\nexport interface FormFieldProps {\n  label: string;\n  /** HTML name attribute */\n  name?: string;\n  /** Input type — \"textarea\" renders a <textarea> */\n  type?: \"text\" | \"date\" | \"time\" | \"tel\" | \"email\" | \"number\" | \"textarea\";\n  required?: boolean;\n  defaultValue?: string;\n  value?: string;\n  onChange?: (\n    e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement>,\n  ) => void;\n  placeholder?: string;\n  /** Extra className for the input element (e.g. \"font-mono\") */\n  inputClassName?: string;\n  /** HTML id */\n  id?: string;\n  \"data-testid\"?: string;\n  /** Textarea rows (default: 5) */\n  rows?: number;\n  /** Wrapper className */\n  className?: string;\n  disabled?: boolean;\n}\n\nconst FormField = React.memo(function FormField({\n  label,\n  name,\n  type = \"text\",\n  required,\n  defaultValue,\n  value,\n  onChange,\n  placeholder,\n  inputClassName,\n  id,\n  \"data-testid\": testId,\n  rows = 5,\n  className,\n  disabled,\n}: FormFieldProps) {\n  const inputId = id || name;\n\n  const sharedProps = {\n    id: inputId,\n    name,\n    required,\n    defaultValue,\n    value,\n    onChange,\n    placeholder,\n    \"data-testid\": testId,\n    disabled,\n  };\n\n  return (\n    <div className={cn(\"space-y-3 px-1\", className)}>\n      <label htmlFor={inputId} className={LABEL_BASE}>\n        {label}\n      </label>\n      {type === \"textarea\" ? (\n        <textarea\n          {...sharedProps}\n          onChange={onChange as React.ChangeEventHandler<HTMLTextAreaElement>}\n          rows={rows}\n          className={cn(\n            INPUT_BASE,\n            \"font-medium text-sm resize-none\",\n            inputClassName,\n          )}\n        />\n      ) : (\n        <input\n          {...sharedProps}\n          type={type}\n          onChange={onChange as React.ChangeEventHandler<HTMLInputElement>}\n          className={cn(\n            INPUT_BASE,\n            \"font-medium text-sm\",\n            inputClassName,\n          )}\n        />\n      )}\n    </div>\n  );\n});\n\nexport { INPUT_BASE, LABEL_BASE };\nexport default FormField;\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/ui/LanguageSwitcher.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/ui/Modal.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/ui/Modal.tsx","messages":[{"ruleId":"jsx-a11y/click-events-have-key-events","severity":2,"message":"Visible, non-interactive elements with click handlers must have at least one keyboard listener.","line":56,"column":5,"nodeType":"JSXOpeningElement","endLine":56,"endColumn":76},{"ruleId":"jsx-a11y/no-static-element-interactions","severity":2,"message":"Avoid non-native interactive elements. If using native HTML is not possible, add an appropriate role and support for tabbing, mouse, keyboard, and touch inputs to an interactive content element.","line":56,"column":5,"nodeType":"JSXOpeningElement","endLine":56,"endColumn":76},{"ruleId":"jsx-a11y/click-events-have-key-events","severity":2,"message":"Visible, non-interactive elements with click handlers must have at least one keyboard listener.","line":57,"column":7,"nodeType":"JSXOpeningElement","endLine":67,"endColumn":8},{"ruleId":"jsx-a11y/no-noninteractive-element-interactions","severity":2,"message":"Non-interactive elements should not be assigned mouse or keyboard event listeners.","line":57,"column":7,"nodeType":"JSXOpeningElement","endLine":67,"endColumn":8}],"suppressedMessages":[],"errorCount":4,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useEffect } from \"react\";\n\nimport { X } from \"lucide-react\";\nimport { createPortal } from \"react-dom\";\n\nimport { cn } from \"@/lib/utils\";\n\ninterface ModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  title?: string;\n  subtitle?: string;\n  icon?: React.ReactNode;\n  children: React.ReactNode;\n  maxWidth?: \"sm\" | \"md\" | \"lg\" | \"xl\" | \"2xl\" | \"3xl\" | \"4xl\";\n  className?: string;\n  testId?: string;\n}\n\nconst maxWidthMap = {\n  sm: \"max-w-sm\",\n  md: \"max-w-md\",\n  lg: \"max-w-lg\",\n  xl: \"max-w-xl\",\n  \"2xl\": \"max-w-2xl\",\n  \"3xl\": \"max-w-3xl\",\n  \"4xl\": \"max-w-4xl\",\n};\n\nexport default function Modal({\n  isOpen,\n  onClose,\n  title,\n  subtitle,\n  icon,\n  children,\n  maxWidth = \"md\",\n  className,\n  testId,\n}: ModalProps) {\n  // Prevent scrolling when modal is open\n  useEffect(() => {\n    if (isOpen) {\n      document.body.style.overflow = \"hidden\";\n    } else {\n      document.body.style.overflow = \"unset\";\n    }\n    return () => {\n      document.body.style.overflow = \"unset\";\n    };\n  }, [isOpen]);\n\n  if (!isOpen) return null;\n\n  return createPortal(\n    <div className=\"modal-backdrop\" onClick={onClose} data-testid={testId}>\n      <div \n        role=\"dialog\"\n        aria-modal=\"true\"\n        className={cn(\n          \"modal-content\", \n          maxWidthMap[maxWidth],\n          className\n        )} \n        style={{ maxHeight: '90vh', display: 'flex', flexDirection: 'column' }}\n        onClick={(e) => e.stopPropagation()}\n      >\n        {/* Header — fixed at top, never shrinks */}\n        {(title || icon) && (\n          <div className=\"flex items-center justify-between p-8 border-b border-slate-50 dark:border-slate-800\" style={{ flexShrink: 0 }}>\n            <div className=\"flex items-center gap-4\">\n              {icon && (\n                <div className=\"bg-primary-50 dark:bg-primary-900/30 p-3 rounded-2xl text-primary-600 dark:text-primary-400\">\n                  {icon}\n                </div>\n              )}\n              <div>\n                {title && (\n                  <h2 className=\"text-xl font-bold text-primary-600 tracking-tight\">\n                    {title}\n                  </h2>\n                )}\n                {subtitle && (\n                  <p className=\"text-[10px] text-primary-400 font-bold uppercase tracking-widest mt-0.5\">\n                    {subtitle}\n                  </p>\n                )}\n              </div>\n            </div>\n            <button\n              onClick={onClose}\n              className=\"p-2 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-full transition-colors group\"\n            >\n              <X className=\"w-5 h-5 text-slate-300 dark:text-slate-500 group-hover:text-primary-700 dark:group-hover:text-primary-400\" />\n            </button>\n          </div>\n        )}\n\n        {/* Body — scrollable area */}\n        <div className=\"p-8\" style={{ overflowY: 'auto', flex: 1, minHeight: 0 }}>\n          {children}\n        </div>\n      </div>\n    </div>,\n    document.body\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/ui/PageHeader.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/ui/PageHeader.tsx","messages":[{"ruleId":"import-x/no-named-as-default-member","severity":1,"message":"Caution: `React` also has a named export `memo`. Check if you meant to write `import {memo} from 'react'` instead.","line":17,"column":20,"nodeType":"MemberExpression","messageId":"member","endLine":17,"endColumn":30}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from \"react\";\n\nimport { cn } from \"@/lib/utils\";\n\n// ── Component ──────────────────────────────────────────────────────\n\nexport interface PageHeaderProps {\n  title: string;\n  subtitle?: string;\n  /** Action buttons rendered on the right side */\n  actions?: React.ReactNode;\n  /** data-testid for the h1 element */\n  \"data-testid\"?: string;\n  className?: string;\n}\n\nconst PageHeader = React.memo(function PageHeader({\n  title,\n  subtitle,\n  actions,\n  \"data-testid\": testId,\n  className,\n}: PageHeaderProps) {\n  return (\n    <div\n      className={cn(\n        \"flex flex-col md:flex-row md:items-center justify-between gap-6 px-2\",\n        className,\n      )}\n    >\n      <div className=\"space-y-1\">\n        <h1\n          data-testid={testId}\n          className=\"text-3xl font-bold tracking-tight text-slate-700 dark:text-slate-200 uppercase leading-none\"\n        >\n          {title}\n        </h1>\n        {subtitle && (\n          <p className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest mt-1.5 opacity-70\">\n            {subtitle}\n          </p>\n        )}\n      </div>\n      {actions && (\n        <div className=\"flex items-center gap-3\">{actions}</div>\n      )}\n    </div>\n  );\n});\n\nexport default PageHeader;\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/ui/Sheet.tsx","messages":[{"ruleId":"jsx-a11y/click-events-have-key-events","severity":2,"message":"Visible, non-interactive elements with click handlers must have at least one keyboard listener.","line":62,"column":7,"nodeType":"JSXOpeningElement","endLine":68,"endColumn":9},{"ruleId":"jsx-a11y/no-static-element-interactions","severity":2,"message":"Avoid non-native interactive elements. If using native HTML is not possible, add an appropriate role and support for tabbing, mouse, keyboard, and touch inputs to an interactive content element.","line":62,"column":7,"nodeType":"JSXOpeningElement","endLine":68,"endColumn":9},{"ruleId":"jsx-a11y/click-events-have-key-events","severity":2,"message":"Visible, non-interactive elements with click handlers must have at least one keyboard listener.","line":75,"column":9,"nodeType":"JSXOpeningElement","endLine":85,"endColumn":10},{"ruleId":"jsx-a11y/no-static-element-interactions","severity":2,"message":"Avoid non-native interactive elements. If using native HTML is not possible, add an appropriate role and support for tabbing, mouse, keyboard, and touch inputs to an interactive content element.","line":75,"column":9,"nodeType":"JSXOpeningElement","endLine":85,"endColumn":10}],"suppressedMessages":[{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/workspace/webdashboard/src/components/ui/Sheet.tsx:39:7\n  37 |     if (isOpen) {\n  38 |       // eslint-disable-next-line react-hooks/set-state-in-effect\n> 39 |       setIsVisible(true);\n     |       ^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  40 |       document.body.style.overflow = \"hidden\";\n  41 |\n  42 |       const handleKeyDown = (e: KeyboardEvent) => {","line":39,"column":7,"nodeType":null,"endLine":39,"endColumn":19,"suppressions":[{"kind":"directive","justification":""}]}],"errorCount":4,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useEffect, useState } from \"react\";\n\nimport { X, Menu } from \"lucide-react\";\nimport { createPortal } from \"react-dom\";\n\nimport { cn } from \"@/lib/utils\";\n\ninterface SheetProps {\n  isOpen: boolean;\n  onClose: () => void;\n  title?: string;\n  subtitle?: string;\n  children: React.ReactNode;\n  side?: \"left\" | \"right\";\n  className?: string;\n  contentClassName?: string;\n  headerExtra?: React.ReactNode;\n  /** If true, the built-in header (icon + title + X button) is hidden — use when providing a fully custom header in children */\n  hideHeader?: boolean;\n}\n\nexport default function Sheet({\n  isOpen,\n  onClose,\n  title,\n  subtitle,\n  children,\n  side = \"right\",\n  className,\n  contentClassName,\n  headerExtra,\n  hideHeader = false,\n}: SheetProps) {\n  const [isVisible, setIsVisible] = useState(false);\n\n  useEffect(() => {\n    if (isOpen) {\n      // eslint-disable-next-line react-hooks/set-state-in-effect\n      setIsVisible(true);\n      document.body.style.overflow = \"hidden\";\n\n      const handleKeyDown = (e: KeyboardEvent) => {\n        if (e.key === \"Escape\") {\n          onClose();\n        }\n      };\n\n      window.addEventListener(\"keydown\", handleKeyDown);\n      return () => window.removeEventListener(\"keydown\", handleKeyDown);\n    } else {\n      const timer = setTimeout(() => setIsVisible(false), 500); // Sync with duration-500\n      document.body.style.overflow = \"unset\";\n      return () => clearTimeout(timer);\n    }\n  }, [isOpen, onClose]);\n\n  if (!isVisible && !isOpen) return null;\n\n  return createPortal(\n    <div className=\"fixed inset-0 z-[1000] flex overflow-hidden\">\n      {/* Backdrop */}\n      <div\n        className={cn(\n          \"fixed inset-0 bg-slate-900/20 backdrop-blur-lg transition-opacity duration-500\",\n          isOpen ? \"opacity-100\" : \"opacity-0\"\n        )}\n        onClick={onClose}\n      />\n\n      {/* Panel */}\n      <div className={cn(\n        \"absolute inset-y-0 flex max-w-full pointer-events-none\",\n        side === \"right\" ? \"right-0\" : \"left-0\"\n      )}>\n        <div\n          data-testid=\"sheet-panel\"\n          className={cn(\n            \"pointer-events-auto w-screen max-w-md transform transition duration-500 ease-in-out bg-white dark:bg-slate-900 shadow-premium-2xl flex flex-col h-full\",\n            side === \"right\"\n              ? (isOpen ? \"translate-x-0 rounded-l-[3rem]\" : \"translate-x-full rounded-l-[3rem]\")\n              : (isOpen ? \"translate-x-0 rounded-r-[3rem]\" : \"-translate-x-full rounded-r-[3rem]\"),\n            className\n          )}\n          onClick={(e) => e.stopPropagation()}\n        >\n          {/* Header */}\n          {!hideHeader && (\n            <div className=\"flex items-center justify-between p-10 border-b border-slate-50 dark:border-slate-800 bg-slate-50/30 dark:bg-slate-800/30\">\n              <div className=\"flex items-center gap-4\">\n                <div className=\"w-12 h-12 rounded-2xl bg-primary-50 dark:bg-primary-950 flex items-center justify-center text-primary-600 dark:text-primary-400 shadow-inner border border-primary-100/50 dark:border-primary-800/50\">\n                  <Menu size={24} />\n                </div>\n                <div>\n                  {title && (\n                    <h2 className=\"text-xl font-bold text-slate-700 dark:text-slate-200 tracking-tight uppercase\">\n                      {title}\n                    </h2>\n                  )}\n                  {subtitle && (\n                    <p className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest mt-1 opacity-70\">\n                      {subtitle}\n                    </p>\n                  )}\n                </div>\n              </div>\n              {headerExtra && (\n                <div className=\"flex items-center gap-2\">\n                  {headerExtra}\n                </div>\n              )}\n              <button\n                onClick={onClose}\n                className=\"p-3 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 rounded-xl transition-all shadow-md border border-slate-100 dark:border-slate-700 text-slate-500 dark:text-slate-400 hover:text-rose-600 dark:hover:text-rose-400 active:scale-90\"\n              >\n                <X className=\"w-5 h-5\" />\n              </button>\n            </div>\n          )}\n\n          {/* Content */}\n          <div className={cn(\"flex-1 overflow-y-auto p-10 relative scroll-smooth\", contentClassName)}>\n            <div className=\"animate-in fade-in slide-in-from-bottom-4 duration-700 h-full\">\n              {children}\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>,\n    document.body\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/ui/StatusBadge.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/ui/StatusBadge.tsx","messages":[{"ruleId":"import-x/no-named-as-default-member","severity":1,"message":"Caution: `React` also has a named export `memo`. Check if you meant to write `import {memo} from 'react'` instead.","line":41,"column":21,"nodeType":"MemberExpression","messageId":"member","endLine":41,"endColumn":31}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from \"react\";\n\nimport { cn } from \"@/lib/utils\";\n\n// ── Variant styles ─────────────────────────────────────────────────\n\nconst VARIANT_STYLES = {\n  success:\n    \"bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-300 border-emerald-100 dark:border-emerald-800\",\n  warning:\n    \"bg-amber-50 dark:bg-amber-950 text-amber-600 dark:text-amber-300 border-amber-100 dark:border-amber-800\",\n  danger:\n    \"bg-rose-50 dark:bg-rose-950 text-rose-600 dark:text-rose-300 border-rose-100 dark:border-rose-800\",\n  info:\n    \"bg-blue-50 dark:bg-blue-950 text-blue-600 dark:text-blue-300 border-blue-100 dark:border-blue-800\",\n  primary:\n    \"bg-primary-50 dark:bg-primary-950 text-primary-600 dark:text-primary-400 border-primary-100 dark:border-primary-800\",\n  neutral:\n    \"bg-slate-50 dark:bg-slate-800 text-slate-500 dark:text-slate-400 border-slate-100 dark:border-slate-800 opacity-60\",\n  indigo:\n    \"bg-indigo-50 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-300 border-indigo-100 dark:border-indigo-800\",\n  emerald:\n    \"bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-400 border-emerald-100 dark:border-emerald-800\",\n  orange:\n    \"bg-orange-50 dark:bg-orange-950 text-orange-600 dark:text-orange-300 border-orange-100 dark:border-orange-800\",\n} as const;\n\n// ── Component ──────────────────────────────────────────────────────\n\nexport type StatusBadgeVariant = keyof typeof VARIANT_STYLES;\n\nexport interface StatusBadgeProps {\n  variant?: StatusBadgeVariant;\n  children: React.ReactNode;\n  icon?: React.ReactNode;\n  /** Pulse animation for \"pending\" states */\n  pulse?: boolean;\n  className?: string;\n}\n\nconst StatusBadge = React.memo(function StatusBadge({\n  variant = \"neutral\",\n  children,\n  icon,\n  pulse = false,\n  className,\n}: StatusBadgeProps) {\n  return (\n    <span\n      className={cn(\n        \"inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[9px] font-bold uppercase tracking-widest border shadow-sm\",\n        VARIANT_STYLES[variant],\n        pulse && \"animate-pulse\",\n        className,\n      )}\n    >\n      {icon}\n      {children}\n    </span>\n  );\n});\n\nexport default StatusBadge;\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/ui/Tabs.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/ui/Toast.tsx","messages":[{"ruleId":"import-x/order","severity":2,"message":"There should be no empty line within import group","line":3,"column":1,"nodeType":"ImportDeclaration","messageId":"noLineWithinGroup","endLine":3,"endColumn":78}],"suppressedMessages":[{"ruleId":"react-refresh/only-export-components","severity":1,"message":"Fast refresh only works when a file only exports components. Use a new file to share constants or functions between components.","line":108,"column":17,"nodeType":"Identifier","messageId":"namedExport","endLine":108,"endColumn":25,"suppressions":[{"kind":"directive","justification":""}]}],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { createContext, useContext, useState, useCallback, ReactNode, useRef, useEffect } from 'react';\n\nimport { CheckCircle2, XCircle, Info, AlertTriangle, X } from 'lucide-react';\n\ntype ToastType = 'success' | 'error' | 'info' | 'warning';\n\ninterface Toast {\n  id: string;\n  type: ToastType;\n  message: string;\n  title?: string;\n}\n\ninterface ToastContextType {\n  show: (message: string, type?: ToastType, title?: string) => void;\n  success: (message: string, title?: string) => void;\n  error: (message: string, title?: string) => void;\n  info: (message: string, title?: string) => void;\n  warning: (message: string, title?: string) => void;\n}\n\nconst ToastContext = createContext<ToastContextType | undefined>(undefined);\n\nimport { useTranslation } from 'react-i18next';\n\nexport function ToastProvider({ children }: { children: ReactNode }) {\n  const { t } = useTranslation();\n  const [toasts, setToasts] = useState<Toast[]>([]);\n  const timeouts = useRef<Map<string, NodeJS.Timeout>>(new Map());\n\n  const remove = useCallback((id: string) => {\n    setToasts((prev) => prev.filter((t) => t.id !== id));\n    const timeout = timeouts.current.get(id);\n    if (timeout) {\n      clearTimeout(timeout);\n      timeouts.current.delete(id);\n    }\n  }, []);\n\n  const show = useCallback((message: string, type: ToastType = 'info', title?: string) => {\n    const id = Math.random().toString(36).substring(2, 9);\n    setToasts((prev) => [...prev, { id, type, message, title }]);\n    \n    // Tự động đóng sau 5 giây\n    const timeoutId = setTimeout(() => remove(id), 5000);\n    timeouts.current.set(id, timeoutId);\n  }, [remove]);\n\n  // Cleanup on unmount\n  useEffect(() => {\n    const currentTimeouts = timeouts.current;\n    return () => {\n      currentTimeouts.forEach((timeout) => clearTimeout(timeout));\n      currentTimeouts.clear();\n    };\n  }, []);\n\n  const success = (msg: string, title?: string) => show(msg, 'success', title || t('common.success'));\n  const error = (msg: string, title?: string) => show(msg, 'error', title || t('common.error'));\n  const info = (msg: string, title?: string) => show(msg, 'info', title || t('common.info'));\n  const warning = (msg: string, title?: string) => show(msg, 'warning', title || t('common.warning'));\n\n  return (\n    <ToastContext.Provider value={{ show, success, error, info, warning }}>\n      {children}\n      <div className=\"fixed bottom-8 right-8 z-[9999] flex flex-col gap-3 pointer-events-none max-w-sm w-full\">\n        {toasts.map((toast) => (\n          <ToastItem key={toast.id} toast={toast} onClose={() => remove(toast.id)} />\n        ))}\n      </div>\n    </ToastContext.Provider>\n  );\n}\n\nfunction ToastItem({ toast, onClose }: { toast: Toast; onClose: () => void }) {\n  const icons = {\n    success: <CheckCircle2 className=\"w-5 h-5 text-emerald-500\" />,\n    error: <XCircle className=\"w-5 h-5 text-rose-500\" />,\n    info: <Info className=\"w-5 h-5 text-blue-500\" />,\n    warning: <AlertTriangle className=\"w-5 h-5 text-amber-500\" />,\n  };\n\n  const bgColors = {\n    success: 'bg-emerald-50 border-emerald-100 dark:bg-emerald-950 dark:border-emerald-900',\n    error: 'bg-rose-50 border-rose-100 dark:bg-rose-950 dark:border-rose-900',\n    info: 'bg-primary-50 border-blue-100 dark:bg-blue-950 dark:border-blue-900',\n    warning: 'bg-amber-50 border-amber-100 dark:bg-amber-950 dark:border-amber-900',\n  };\n\n  return (\n    <div \n      role=\"status\"\n      className={`pointer-events-auto flex items-start gap-4 p-4 rounded-[24px] border shadow-xl shadow-slate-200/50 dark:shadow-black/30 animate-in slide-in-from-right-8 duration-300 ${bgColors[toast.type]}`}\n    >\n      <div className=\"shrink-0 mt-0.5\">{icons[toast.type]}</div>\n      <div className=\"flex-1\">\n        {toast.title && <div className=\"text-sm font-bold text-slate-700 dark:text-slate-200 mb-0.5 uppercase tracking-tight\">{toast.title}</div>}\n        <div className=\"text-sm text-slate-600 dark:text-slate-300 font-medium leading-relaxed\">{toast.message}</div>\n      </div>\n      <button onClick={onClose} className=\"shrink-0 p-1 hover:bg-white/50 dark:hover:bg-slate-700/50 rounded-lg transition-colors\">\n        <X className=\"w-4 h-4 text-slate-500 dark:text-slate-400\" />\n      </button>\n    </div>\n  );\n}\n\n// eslint-disable-next-line react-refresh/only-export-components\nexport function useToast() {\n  const context = useContext(ToastContext);\n  if (!context) throw new Error('useToast must be used within ToastProvider');\n  return context;\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/ui/__tests__/ConfirmDialog.test.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":11,"column":32,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":11,"endColumn":35,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[309,312],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[309,312],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from \"react\";\n\nimport { render, screen, fireEvent } from \"@testing-library/react\";\nimport { describe, it, expect, vi } from \"vitest\";\n\nimport ConfirmDialog from \"../ConfirmDialog\";\n\n// Mock react-i18next\nvi.mock(\"react-i18next\", () => ({\n  useTranslation: () => ({\n    t: (key: string, options?: any) => {\n      if (options && options.defaultValue) {\n        return options.defaultValue;\n      }\n      return key;\n    },\n  }),\n}));\n\ndescribe(\"ConfirmDialog Component\", () => {\n  it(\"renders correctly with given props\", () => {\n    render(\n      <ConfirmDialog\n        isOpen={true}\n        onClose={() => {}}\n        onConfirm={() => {}}\n        title=\"Test Confirm\"\n        message=\"Are you sure you want to proceed?\"\n        confirmLabel=\"Yes, Do It\"\