rdDrive,\n  Scale,\n  BarChart3,\n  Folder,\n  Timer,\n  Wallet,\n  Wrench,\n  User,\n  FileText,\n  Plane,\n  CalendarCheck,\n  ClipboardCheck,\n  ArrowLeftRight,\n  TimerIcon,\n  DollarSign,\n  UserCog,\n  Activity,\n  Palmtree\n} from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { useMyPermissions } from \"@/hooks/use-permissions\";\nimport { useProfile } from \"@/hooks/use-profile\";\nimport { ROUTES } from \"@/lib/routes\";\nimport { cn } from \"@/lib/utils\";\n\n\ninterface SidebarProps {\n  isOpen: boolean;\n  onClose: () => void;\n  openSections: Record<string, boolean>;\n  toggleSection: (section: string) => void;\n  onShowSwitcher: () => void;\n  isCollapsed: boolean;\n}\n\nexport default function Sidebar({ isOpen, onClose, openSections, toggleSection, onShowSwitcher, isCollapsed }: SidebarProps) {\n  const { t } = useTranslation();\n  const location = useLocation();\n  const { hasAnyPermission } = useMyPermissions();\n  const { user } = useProfile();\n\n  const handleLogout = () => { localStorage.clear(); window.location.href = ROUTES.LOGIN; };\n\n  const menuItems = [\n    { to: ROUTES.HOME, icon: LayoutDashboard, label: t(\"common.dashboard\"), exact: true, testId: \"sidebar-link-dashboard\" },\n    {\n      section: \"org\", sectionIcon: Folder, label: t(\"common.sections.organization\"), testId: \"sidebar-section-org\", items: [\n        { to: ROUTES.EMPLOYEES, icon: UserRound, label: t(\"common.employees\"), testId: \"sidebar-link-employees\", permissions: [\"employees:read\"] },\n        { to: ROUTES.PEOPLE, icon: Users, label: t(\"members.title\", { defaultValue: \"Directory\" }), testId: \"sidebar-link-people\", permissions: [\"members:read\"] },\n        { to: ROUTES.DEPARTMENTS, icon: Building2, label: t(\"common.departments\"), testId: \"sidebar-link-departments\", permissions: [\"departments:read\"] }\n      ]\n    },\n    {\n      section: \"time\", sectionIcon: Timer, label: t(\"common.sections.time_leave\"), testId: \"sidebar-section-time\", items: [\n        { to: ROUTES.ATTENDANCE_LOGS, icon: CalendarCheck, label: t(\"attendance_logs.title\"), testId: \"sidebar-link-attendance-logs\", permissions: [\"attendance:logs:read\"] },\n        { to: ROUTES.LEAVE_REQUESTS, icon: Plane, label: t(\"leave_requests.title\"), testId: \"sidebar-link-leave-requests\", permissions: [\"leave:requests:read\"] },\n        { to: ROUTES.LEAVE_BALANCES, icon: Scale, label: t(\"common.leave_balances\"), testId: \"sidebar-link-leave-balances\", permissions: [\"leave:balances:read\"] },\n        { to: ROUTES.ATTENDANCE_ADJUSTMENTS, icon: ClipboardCheck, label: t(\"common.attendance_confirm\"), testId: \"sidebar-link-attendance-adjustments\", permissions: [\"attendance:adjustments:approve\"] },\n        { to: ROUTES.SHIFT_SWAPS, icon: ArrowLeftRight, label: t(\"shift_swaps.title\"), testId: \"sidebar-link-shift-swaps\", permissions: [\"shift_swaps:manage\"] },\n        { to: ROUTES.REPORTS, icon: BarChart3, label: t(\"common.reports\"), testId: \"sidebar-link-reports\", permissions: [\"reports:read\"] },\n        { to: ROUTES.APPROVALS_OT, icon: CheckCircle, label: \"OT Approvals\", testId: \"sidebar-link-approvals-ot\", permissions: [\"overtime:approve\"] }\n      ]\n    },\n    {\n      section: \"payroll\", sectionIcon: Wallet, label: t(\"common.sections.payroll_shifts\"), testId: \"sidebar-section-payroll\", items: [\n        { to: ROUTES.SHIFTS, icon: CalendarRange, label: t(\"common.shifts\"), testId: \"sidebar-link-shifts\", permissions: [\"shifts:read\"] },\n        { to: ROUTES.PAYROLL, icon: DollarSign, label: t(\"payroll.title\"), testId: \"sidebar-link-payroll\", permissions: [\"payroll:read\"] }\n      ]\n    },\n    {\n      section: \"system\", sectionIcon: Wrench, label: t(\"settings.title\"), testId: \"sidebar-section-system\", items: [\n        { to: ROUTES.INFRA_MONITOR, icon: Activity, label: t(\"monitor.title\"), testId: \"sidebar-link-monitor\", systemRoles: [\"platform_admin\", \"support\"] },\n        { to: ROUTES.SYSTEM_ROLES, icon: ShieldCheck, label: \"Platform Admins\", testId: \"sidebar-link-system-roles\", systemRoles: [\"platform_admin\"] },\n        { to: ROUTES.SETTINGS.ROOT, icon: Settings, label: t(\"settings.title\"), testId: \"sidebar-link-settings-root\", permissions: [\"workspace:settings:read\", \"members:roles:manage\"] }\n      ]\n    },\n    {\n      section: \"ess\", sectionIcon: User, label: t(\"common.sections.self_service\"), testId: \"sidebar-section-ess\", items: [\n        { to: ROUTES.ESS_PROFILE, icon: UserCircle, label: t(\"ess.profile.title\"), testId: \"sidebar-link-ess-profile\", permissions: [\"ess:profile\"] },\n        { to: ROUTES.ESS_ATTENDANCE, icon: History, label: t(\"ess.attendance.title\"), testId: \"sidebar-link-ess-attendance\", permissions: [\"ess:attendance\"] },\n        { to: ROUTES.ESS_CLOCK, icon: Clock, label: t(\"ess.clock.title\"), testId: \"sidebar-link-ess-clock\", permissions: [\"ess:clock\"] }\n      ]\n    }\n  ];\n\n  const filteredMenuItems = menuItems\n    .map((item) => {\n      if (item.section && item.items) {\n        const filteredItems = item.items.filter(\n          (subItem: any) => {\n            if (subItem.systemRoles && subItem.systemRoles.length > 0) {\n              return subItem.systemRoles.some((role: string) => user?.system_roles?.includes(role));\n            }\n            return !subItem.permissions || subItem.permissions.length === 0 || hasAnyPermission(...subItem.permissions);\n          }\n        );\n        return { ...item, items: filteredItems };\n      }\n      return item;\n    })\n    .filter((item) => {\n      if (item.section) {\n        return item.items && item.items.length > 0;\n      }\n      return true;\n    });\n\n  return (\n    <div className={cn(\"fixed inset-y-0 left-0 z-50 flex flex-col bg-white dark:bg-slate-950 border-r border-slate-100 dark:border-slate-800 transition-all duration-300 shadow-xl shadow-slate-200/50 dark:shadow-black/30\", isCollapsed ? \"w-20\" : \"w-72\", !isOpen && \"-translate-x-full lg:translate-x-0\")}>\n      <div className=\"flex h-24 items-center justify-between px-6 border-b border-slate-50 dark:border-slate-800\">\n        {!isCollapsed && <div className=\"flex items-center gap-3\"><div className=\"h-10 w-10 rounded-2xl bg-gradient-to-tr from-primary-600 to-indigo-500 shadow-lg shadow-primary-200 flex items-center justify-center text-white font-black text-xl tracking-tighter italic\">L</div><span className=\"text-xl font-black tracking-tighter text-slate-800 dark:text-slate-200 uppercase italic\">Lee<span className=\"text-primary-600 dark:text-primary-400\">Attend</span></span></div>}\n        <button onClick={onClose} className=\"lg:hidden p-3 min-w-[44px] min-h-[44px] flex items-center justify-center text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 bg-slate-50 dark:bg-slate-800 rounded-xl transition-colors\"><X className=\"h-5 w-5\" /></button>\n      </div>\n      <div className=\"flex-1 overflow-y-auto custom-scrollbar px-4 py-6 space-y-8\">\n        {filteredMenuItems.map((item) => (\n          <div key={item.label}>\n            {item.section ? (\n              <div className=\"space-y-2\">\n                {!isCollapsed && <button onClick={() => toggleSection(item.section!)} data-testid={item.testId} className=\"flex w-full items-center justify-between px-4 py-3 min-h-[44px] text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-[0.25em] hover:text-primary-600 dark:hover:text-primary-400 transition-colors group\"><div className=\"flex items-center gap-2\">{item.sectionIcon && <item.sectionIcon className=\"h-3 w-3 opacity-50 group-hover:opacity-100\" />}<span>{item.label}</span></div>{openSections[item.section] ? <ChevronDown className=\"h-3 w-3\" /> : <ChevronRight className=\"h-3 w-3\" />}</button>}\n                {(openSections[item.section] || isCollapsed) && (\n                  <div className=\"space-y-1\">\n                    {item.items?.map((subItem) => (\n                      <Link key={subItem.to} to={subItem.to} data-testid={subItem.testId} className={cn(\"flex items-center gap-3 px-4 py-3 rounded-2xl transition-all duration-300 group\", location.pathname === subItem.to ? \"bg-primary-50 dark:bg-primary-950 text-primary-600 dark:text-primary-300 shadow-sm shadow-primary-100/50\" : \"text-slate-500 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 hover:text-slate-700 dark:hover:text-slate-200\")}>\n                        <div className={cn(\"p-2 rounded-xl transition-colors\", location.pathname === subItem.to ? \"bg-white dark:bg-primary-900/30 shadow-sm\" : \"bg-slate-50 dark:bg-slate-800 group-hover:bg-white dark:group-hover:bg-slate-700\")}>{subItem.icon && <subItem.icon className=\"h-4 w-4\" />}</div>\n                        {!isCollapsed && <span className=\"font-bold text-sm truncate\">{subItem.label}</span>}\n                      </Link>\n                    ))}\n                  </div>\n                )}\n              </div>\n            ) : (\n              <Link to={item.to!} data-testid={item.testId} className={cn(\"flex items-center gap-3 px-4 py-3 rounded-2xl transition-all duration-300 group\", (item.exact ? location.pathname === item.to : location.pathname.startsWith(item.to!)) ? \"bg-primary-50 dark:bg-primary-950 text-primary-600 dark:text-primary-300 shadow-sm shadow-primary-100/50\" : \"text-slate-500 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 hover:text-slate-700 dark:hover:text-slate-200\")}>\n                <div className={cn(\"p-2 rounded-xl transition-colors\", (item.exact ? location.pathname === item.to : location.pathname.startsWith(item.to!)) ? \"bg-white dark:bg-primary-900/30 shadow-sm\" : \"bg-slate-50 dark:bg-slate-800 group-hover:bg-white dark:group-hover:bg-slate-700\")}>{item.icon && <item.icon className=\"h-4 w-4\" />}</div>\n                {!isCollapsed && <span className=\"font-bold text-sm truncate\">{item.label}</span>}\n              </Link>\n            )}\n          </div>\n        ))}\n      </div>\n      <div className=\"p-4 border-t border-slate-50 dark:border-slate-800\">\n        <button onClick={handleLogout} className=\"flex w-full items-center gap-3 px-4 py-4 text-slate-400 dark:text-slate-500 hover:text-rose-600 dark:hover:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/30 rounded-2xl transition-all duration-300 group\"><div className=\"p-2 rounded-xl bg-slate-50 dark:bg-slate-800 group-hover:bg-white dark:group-hover:bg-slate-700 transition-colors\"><LogOut className=\"h-4 w-4\" /></div>{!isCollapsed && <span className=\"font-bold text-sm uppercase tracking-widest\">{t(\"common.logout\")}</span>}</button>\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/layout/WorkspaceSwitcher.tsx","messages":[],"suppressedMessages":[{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/workspace/webdashboard/src/components/layout/WorkspaceSwitcher.tsx:32:9\n  30 |       if (current) {\n  31 |         // eslint-disable-next-line react-hooks/set-state-in-effect\n> 32 |         setActiveWorkspace(current);\n     |         ^^^^^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  33 |         if (!currentId) setCurrentWorkspaceId(current.id);\n  34 |       }\n  35 |     }","line":32,"column":9,"nodeType":null,"endLine":32,"endColumn":27,"suppressions":[{"kind":"directive","justification":""}]}],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/layout/WorkspaceTransitionOverlay.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/layout/__tests__/theme-toggle.test.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":9,"column":38,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":9,"endColumn":41,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[404,407],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[404,407],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { QueryClient, QueryClientProvider } from '@tanstack/react-query';\nimport { render, screen, fireEvent } from '@testing-library/react';\nimport { describe, it, expect, vi, beforeEach } from 'vitest';\n\n// Mock TanStack Router\nvi.mock(\"@tanstack/react-router\", () => ({\n  useNavigate: () => vi.fn(),\n  useLocation: () => ({ pathname: \"/\", search: \"\", hash: \"\" }),\n  Link: ({ to, children, ...props }: any) => <a href={to} {...props}>{children}</a>,\n}));\nimport { DarkModeContext } from '@/context/dark-mode-context-definition';\n\nimport Navbar from '../Navbar';\n\nimport type { ThemeMode } from '@/hooks/use-dark-mode';\n\n// Mock dependencies that Navbar's children need\nvi.mock('@/components/ui/LanguageSwitcher', () => ({\n  LanguageSwitcher: () => <div data-testid=\"language-switcher-mock\" />,\n}));\n\nconst mockSetMode = vi.fn();\n\nconst createTestQueryClient = () =>\n  new QueryClient({ defaultOptions: { queries: { retry: false }, mutations: { retry: false } } });\n\nfunction renderWithContext(mode: ThemeMode = 'system') {\n  const contextValue = {\n    mode,\n    resolved: mode === 'dark' ? 'dark' as const : 'light' as const,\n    isDark: mode === 'dark',\n    setMode: mockSetMode,\n  };\n\n  return render(\n    <QueryClientProvider client={createTestQueryClient()}>\n      <DarkModeContext.Provider value={contextValue}>\n        <Navbar\n          currentWorkspaceName=\"Test Workspace\"\n          onOpenSidebar={vi.fn()}\n          isCollapsed={false}\n          onToggleCollapsed={vi.fn()}\n        />\n      </DarkModeContext.Provider>\n    </QueryClientProvider>\n  );\n}\n\ndescribe('ThemeToggle (in Navbar)', () => {\n  beforeEach(() => {\n    mockSetMode.mockClear();\n  });\n\n  it('renders the theme toggle with 3 buttons', () => {\n    renderWithContext();\n    expect(screen.getByTestId('theme-toggle')).toBeInTheDocument();\n    expect(screen.getByTestId('theme-toggle-light')).toBeInTheDocument();\n    expect(screen.getByTestId('theme-toggle-system')).toBeInTheDocument();\n    expect(screen.getByTestId('theme-toggle-dark')).toBeInTheDocument();\n  });\n\n  it('clicking dark button calls setMode(\"dark\")', () => {\n    renderWithContext('light');\n    fireEvent.click(screen.getByTestId('theme-toggle-dark'));\n    expect(mockSetMode).toHaveBeenCalledWith('dark');\n  });\n\n  it('clicking light button calls setMode(\"light\")', () => {\n    renderWithContext('dark');\n    fireEvent.click(screen.getByTestId('theme-toggle-light'));\n    expect(mockSetMode).toHaveBeenCalledWith('light');\n  });\n\n  it('clicking system button calls setMode(\"system\")', () => {\n    renderWithContext('dark');\n    fireEvent.click(screen.getByTestId('theme-toggle-system'));\n    expect(mockSetMode).toHaveBeenCalledWith('system');\n  });\n\n  it('active button has highlighted style', () => {\n    renderWithContext('dark');\n    const darkBtn = screen.getByTestId('theme-toggle-dark');\n    expect(darkBtn.className).toContain('bg-white');\n  });\n\n  it('inactive buttons do not have highlighted style', () => {\n    renderWithContext('dark');\n    const lightBtn = screen.getByTestId('theme-toggle-light');\n    expect(lightBtn.className).not.toContain('bg-white');\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/leave/AssignPolicyModal.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'FileText' is defined but never used. Allowed unused vars must match /^_/u.","line":5,"column":22,"nodeType":"Identifier","messageId":"unusedVar","endLine":5,"endColumn":30,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"FileText"},"fix":{"range":[175,185],"text":""},"desc":"Remove unused variable \"FileText\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'CalendarDays' is defined but never used. Allowed unused vars must match /^_/u.","line":5,"column":45,"nodeType":"Identifier","messageId":"unusedVar","endLine":5,"endColumn":57,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"CalendarDays"},"fix":{"range":[198,212],"text":""},"desc":"Remove unused variable \"CalendarDays\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'getCurrentWorkspaceId' is defined but never used. Allowed unused vars must match /^_/u.","line":18,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":18,"endColumn":24,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"getCurrentWorkspaceId"},"fix":{"range":[550,575],"text":""},"desc":"Remove unused variable \"getCurrentWorkspaceId\"."}]}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from \"react\";\n\nimport { useQuery, useMutation, useQueryClient } from \"@tanstack/react-query\";\nimport { format } from \"date-fns\";\nimport { UserCircle, FileText, ShieldCheck, CalendarDays, Building2 } from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { Combobox } from \"@/components/ui/Combobox\";\nimport Modal from \"@/components/ui/Modal\";\nimport { useToast } from \"@/components/ui/Toast\";\n\nimport {\n  fetchEmployees,\n  fetchDepartments,\n  fetchLeavePolicies,\n  fetchLeaveTypes,\n  assignLeavePolicy,\n  getCurrentWorkspaceId,\n} from \"@/lib/api\";\n\n\ninterface AssignPolicyModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  wsId: string | null;\n}\n\nexport function AssignPolicyModal({ isOpen, onClose, wsId }: AssignPolicyModalProps) {\n  const { t } = useTranslation();\n  const toast = useToast();\n  const queryClient = useQueryClient();\n\n  const [assigneeType, setAssigneeType] = useState<string>(\"employee\");\n  const [assignEmpId, setAssignEmpId] = useState<string>(\"\");\n  const [assignDeptId, setAssignDeptId] = useState<string>(\"\");\n  const [assignPolicyId, setAssignPolicyId] = useState<string>(\"\");\n\n  const { data: employeesData, isLoading: employeesLoading } = useQuery({ queryKey: [\"employees\", wsId], queryFn: () => fetchEmployees(wsId!, 1, 3000), enabled: isOpen && !!wsId });\n  const employees = employeesData?.data || [];\n  const { data: departments = [], isLoading: departmentsLoading } = useQuery({ queryKey: [\"departments\", wsId], queryFn: () => fetchDepartments(wsId!), enabled: isOpen && !!wsId });\n    const { data: policies = [], isLoading: policiesLoading } = useQuery({ queryKey: [\"leave-policies\", wsId], queryFn: () => fetchLeavePolicies(wsId!), enabled: isOpen && !!wsId });\n  const { data: leaveTypes = [] } = useQuery({ queryKey: [\"leave-types\", wsId], queryFn: () => fetchLeaveTypes(wsId!), enabled: isOpen && !!wsId });\n\n\n  const assignMutation = useMutation({\n    mutationFn: (data: { assignee_type: string; assignee_id: string | null; policy_id: string; effective_from: string }) => assignLeavePolicy(wsId!, data),\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: [\"leave-balances\"] });\n      queryClient.invalidateQueries({ queryKey: [\"leave-policies\"] });\n      queryClient.invalidateQueries({ queryKey: [\"leave-assignments\"] });\n      toast.success(t(\"leave_requests.policy.messages.assign_success\"));\n      onClose();\n    },\n  });\n\n  const handleAssignPolicy = (e: React.FormEvent<HTMLFormElement>) => {\n    e.preventDefault();\n    if (!assignPolicyId) return;\n    if (assigneeType === 'employee' && !assignEmpId) return;\n    if (assigneeType === 'department' && !assignDeptId) return;\n\n    const formData = new FormData(e.currentTarget);\n    const assignee_id_raw = assigneeType === 'workspace' ? null : (assigneeType === 'department' ? assignDeptId : assignEmpId);\n    const effective_from = formData.get(\"effective_from\") as string;\n    \n    assignMutation.mutate({ assignee_type: assigneeType, assignee_id: (assignee_id_raw === \"\" || assignee_id_raw === null) ? null : assignee_id_raw, policy_id: assignPolicyId, effective_from });\n  };\n\n  return (\n    <Modal isOpen={isOpen} onClose={onClose} title={t(\"leave_requests.policy.assign_title\")} subtitle={t(\"leave_requests.policy.assign_subtitle\")} icon={<ShieldCheck size={24} />} maxWidth=\"md\">\n      <form onSubmit={handleAssignPolicy} className=\"space-y-8 pt-4 animate-in fade-in duration-500\">\n        <div className=\"space-y-2\">\n          <label htmlFor=\"assignee-type\" className=\"text-[10px] font-bold text-primary-400 uppercase tracking-widest ml-1\">{t(\"leave_requests.policy.table.type\")}</label>\n          <Combobox id=\"assignee-type\" data-testid=\"assign-type-select\" options={[{ value: \"workspace\", label: t(\"leave_requests.policy.assignee_types.workspace\"), description: t(\"leave_requests.policy.assignee_types.workspace_desc\") }, { value: \"department\", label: t(\"leave_requests.policy.assignee_types.department\"), description: t(\"leave_requests.policy.assignee_types.department_desc\") }, { value: \"employee\", label: t(\"leave_requests.policy.assignee_types.employee\"), description: t(\"leave_requests.policy.assignee_types.employee_desc\") }]} value={assigneeType} onChange={setAssigneeType} className=\"bg-slate-50 dark:bg-slate-800 border-primary-100 dark:border-primary-800/50 h-14\" />\n        </div>\n\n        {assigneeType === 'employee' && (\n          <div className=\"space-y-2 animate-in slide-in-from-top-2\">\n            <label htmlFor=\"assign-emp\" className=\"text-[10px] font-bold text-primary-400 uppercase tracking-widest ml-1\">{t(\"common.employee\")}</label>\n            <Combobox id=\"assign-emp\" data-testid=\"assign-emp-select\" options={employees.map(e => ({ value: e.id, label: e.full_name, description: e.employee_id_number, icon: <UserCircle size={14} /> }))} value={assignEmpId} onChange={setAssignEmpId} placeholder={employeesLoading ? t(\"common.loading\") : t(\"common.select_employee\")} className=\"bg-slate-50 dark:bg-slate-800 border-primary-100 dark:border-primary-800/50 h-14\" />\n          </div>\n        )}\n\n        {assigneeType === 'department' && (\n          <div className=\"space-y-2 animate-in slide-in-from-top-2\">\n            <label htmlFor=\"assign-dept\" className=\"text-[10px] font-bold text-primary-400 uppercase tracking-widest ml-1\">{t(\"common.department\")}</label>\n            <Combobox id=\"assign-dept\" options={departments.map(d => ({ value: d.id, label: d.name, icon: <Building2 size={14} /> }))} value={assignDeptId} onChange={setAssignDeptId} placeholder={departmentsLoading ? t(\"common.loading\") : t(\"common.select_department\")} className=\"bg-slate-50 dark:bg-slate-800 border-primary-100 dark:border-primary-800/50 h-14\" />\n          </div>\n        )}\n\n        <div className=\"space-y-2\">\n          <label htmlFor=\"assign-policy\" className=\"text-[10px] font-bold text-primary-400 uppercase tracking-widest ml-1\">{t(\"leave_requests.policy.title_single\")}</label>\n          <Combobox id=\"assign-policy\" data-testid=\"assign-policy-select\" options={policies.map(p => ({ value: p.id, label: p.name, description: leaveTypes.find(t => t.id === p.leave_type_id)?.name || p.leave_type_id, icon: <ShieldCheck size={14} /> }))} value={assignPolicyId} onChange={setAssignPolicyId} placeholder={policiesLoading ? t(\"common.loading\") : t(\"leave_requests.policy.select_placeholder\")} className=\"bg-slate-50 dark:bg-slate-800 border-primary-100 dark:border-primary-800/50 h-14\" />\n        </div>\n\n        <div className=\"space-y-2\">\n          <label htmlFor=\"assign-date\" className=\"text-[10px] font-bold text-primary-400 uppercase tracking-widest ml-1\">{t(\"common.effective_from\")}</label>\n          <input id=\"assign-date\" type=\"date\" name=\"effective_from\" required defaultValue={format(new Date(), 'yyyy-MM-dd')} className=\"w-full px-5 py-4 text-primary-600 dark:text-primary-400 bg-slate-50 dark:bg-slate-800 border border-primary-100 dark:border-primary-800/50 rounded-2xl focus:ring-4 focus:ring-primary-500/10 focus:bg-white dark:focus:bg-slate-900 outline-none transition-all font-bold text-sm tracking-tight\" />\n        </div>\n\n        <div className=\"pt-4 flex gap-4\">\n          <button type=\"button\" onClick={onClose} className=\"flex-1 px-8 py-4 bg-white dark:bg-slate-900 border border-primary-200 dark:border-primary-800/50 rounded-2xl font-bold text-xs uppercase tracking-widest text-primary-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-all\">{t(\"common.cancel\")}</button>\n          <button data-testid=\"submit-assign-policy-btn\" type=\"submit\" disabled={assignMutation.isPending} className=\"flex-1 bg-primary-600 text-white rounded-2xl font-bold text-xs uppercase tracking-widest hover:bg-primary-700 transition-all shadow-xl shadow-indigo-200 active:scale-95 disabled:opacity-50\">{assignMutation.isPending ? t(\"common.processing\").toUpperCase() : t(\"leave_requests.policy.assign_now_btn\").toUpperCase()}</button>\n        </div>\n      </form>\n    </Modal>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/leave/LeaveBalanceDetailModal.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'Info' is defined but never used. Allowed unused vars must match /^_/u.","line":4,"column":13,"nodeType":"Identifier","messageId":"unusedVar","endLine":4,"endColumn":17,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Info"},"fix":{"range":[95,101],"text":""},"desc":"Remove unused variable \"Info\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'FileText' is defined but never used. Allowed unused vars must match /^_/u.","line":4,"column":48,"nodeType":"Identifier","messageId":"unusedVar","endLine":4,"endColumn":56,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"FileText"},"fix":{"range":[130,140],"text":""},"desc":"Remove unused variable \"FileText\"."}]},{"ruleId":"jsx-a11y/click-events-have-key-events","severity":2,"message":"Visible, non-interactive elements with click handlers must have at least one keyboard listener.","line":39,"column":5,"nodeType":"JSXOpeningElement","endLine":42,"endColumn":6},{"ruleId":"jsx-a11y/no-static-element-interactions","severity":2,"message":"Avoid non-native interactive elements. If using native HTML is not possible, add an appropriate role and support for tabbing, mouse, keyboard, and touch inputs to an interactive content element.","line":39,"column":5,"nodeType":"JSXOpeningElement","endLine":42,"endColumn":6},{"ruleId":"jsx-a11y/click-events-have-key-events","severity":2,"message":"Visible, non-interactive elements with click handlers must have at least one keyboard listener.","line":47,"column":7,"nodeType":"JSXOpeningElement","endLine":50,"endColumn":8},{"ruleId":"jsx-a11y/no-static-element-interactions","severity":2,"message":"Avoid non-native interactive elements. If using native HTML is not possible, add an appropriate role and support for tabbing, mouse, keyboard, and touch inputs to an interactive content element.","line":47,"column":7,"nodeType":"JSXOpeningElement","endLine":50,"endColumn":8}],"suppressedMessages":[],"errorCount":6,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState } from \"react\";\n\nimport { useQuery } from \"@tanstack/react-query\";\nimport { X, Info, TrendingUp, Calendar, Award, FileText, ArrowUpRight, ArrowDownRight, History as HistoryIcon, Clock } from \"lucide-react\";\nimport { createPortal } from \"react-dom\";\nimport { useTranslation } from \"react-i18next\";\n\nimport { Tabs, TabsList, TabsTrigger, TabsContent } from \"@/components/ui/Tabs\";\n\nimport { WorkspaceLeaveBalance, fetchLeaveHistory, getCurrentWorkspaceId, LeaveHistoryItem } from \"@/lib/api\";\nimport { cn } from \"@/lib/utils\";\n\ninterface LeaveBalanceDetailModalProps {\n  balance: WorkspaceLeaveBalance;\n  isOpen: boolean;\n  onClose: () => void;\n}\n\nexport function LeaveBalanceDetailModal({ balance, isOpen, onClose }: LeaveBalanceDetailModalProps) {\n  const { t } = useTranslation();\n  const wsId = getCurrentWorkspaceId();\n  const [activeTab, setActiveTab] = useState(\"all\");\n\n  const { data: history = [], isLoading } = useQuery({\n    queryKey: [\"leave-history\", wsId, balance.employee_id, balance.leave_type_id],\n    queryFn: () => fetchLeaveHistory(wsId!, balance.employee_id, balance.leave_type_id),\n    enabled: isOpen && !!wsId,\n  });\n\n  if (!isOpen) return null;\n\n  const totalEntitled = balance.entitlement + balance.accrued_amount + balance.carried_over;\n  const usagePercent = Math.round((balance.used / (totalEntitled || 1)) * 100);\n\n  const accruals = history.filter(h => h.transaction_type === \"accrual\" || h.transaction_type === \"adjustment\" || h.transaction_type === \"carry_over\");\n  const usage = history.filter(h => h.transaction_type === \"usage\");\n\n  return createPortal(\n    <div\n      className=\"fixed inset-0 z-[9999] flex items-center justify-center p-4 animate-in fade-in duration-300\"\n      onClick={onClose}\n    >\n      {/* Backdrop */}\n      <div className=\"absolute inset-0 bg-slate-900/20 backdrop-blur-md\" />\n\n      {/* Modal Content */}\n      <div\n        className=\"relative bg-white dark:bg-slate-900 rounded-3xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto animate-in zoom-in-95 slide-in-from-bottom-8 duration-500 flex flex-col\"\n        onClick={(e) => e.stopPropagation()}\n      >\n        {/* Header */}\n        <div className=\"sticky top-0 bg-white dark:bg-slate-900 border-b border-slate-100 dark:border-slate-800 px-6 md:px-8 py-5 md:py-6 rounded-t-3xl z-10 flex-shrink-0\">\n          <div className=\"flex items-start justify-between gap-4\">\n            <div className=\"flex items-center gap-4 flex-1 min-w-0\">\n              <div className=\"w-14 h-14 bg-primary-50 dark:bg-primary-950 rounded-2xl flex items-center justify-center text-primary-600 dark:text-primary-400 font-bold text-base shadow-inner border border-primary-100 dark:border-primary-800/50 uppercase flex-shrink-0\">\n                {balance.employee_name.split(' ').map(n => n[0]).join('').slice(0, 2)}\n              </div>\n              <div className=\"flex-1 min-w-0\">\n                <h2 className=\"text-xl md:text-2xl font-bold text-slate-800 dark:text-slate-100 tracking-tight uppercase leading-tight truncate\">\n                  {balance.employee_name}\n                </h2>\n                <div className=\"flex items-center gap-2 mt-2\">\n                  <span className=\"inline-block px-3 py-1.5 bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300 rounded-xl text-xs font-bold uppercase tracking-wider border border-slate-200 dark:border-slate-700 shadow-sm\">\n                    {balance.leave_type_name}\n                  </span>\n                </div>\n              </div>\n            </div>\n            <button\n              onClick={onClose}\n              className=\"p-2.5 text-slate-500 dark:text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 dark:text-slate-600 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-xl transition-all active:scale-90 flex-shrink-0 min-w-[44px] min-h-[44px]\"\n              aria-label={t(\"common.close\")}\n            >\n              <X size={24} />\n            </button>\n          </div>\n        </div>\n\n        {/* Body */}\n        <div className=\"p-6 md:p-8 space-y-8 overflow-y-auto\">\n          {/* Hero Metric: Remaining Balance */}\n          <div className=\"bg-gradient-to-br from-primary-50 via-primary-50/50 to-transparent dark:from-primary-950 dark:via-primary-950/50 dark:to-transparent rounded-3xl p-8 border border-primary-100 dark:border-primary-800/50 shadow-inner\">\n            <div className=\"flex items-center gap-3 mb-3\">\n              <Award className=\"w-6 h-6 text-primary-600 dark:text-primary-400\" />\n              <div className=\"text-xs font-bold text-primary-600 dark:text-primary-400 uppercase tracking-[0.2em]\">\n                {t(\"leave_balances.table.remaining\")}\n              </div>\n            </div>\n            <div className={cn(\n              \"text-6xl md:text-7xl font-bold font-mono tracking-tighter\",\n              balance.remaining > 0 ? \"text-emerald-600 dark:text-emerald-300\" : \"text-slate-500 dark:text-slate-400\"\n            )}>\n              {balance.remaining}\n              <span className=\"text-2xl md:text-3xl ml-2 text-slate-500 dark:text-slate-400 font-bold uppercase tracking-tight\">\n                {t(\"common.days_short\", \"days\")}\n              </span>\n            </div>\n\n            {/* Usage Bar */}\n            <div className=\"mt-6 space-y-3\">\n              <div className=\"flex items-center justify-between text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider\">\n                <span>{t(\"leave_balances.table.usage\")}</span>\n                <span className=\"font-mono\">{usagePercent}%</span>\n              </div>\n              <div className=\"w-full h-3 bg-white dark:bg-slate-900/50 rounded-full overflow-hidden shadow-inner border border-primary-100 dark:border-primary-800/30\">\n                <div\n                  className={cn(\n                    \"h-full rounded-full transition-all duration-1000 shadow-sm\",\n                    usagePercent > 80 ? \"bg-rose-500 dark:bg-rose-400 shadow-rose-200\" :\n                      usagePercent > 50 ? \"bg-amber-500 dark:bg-amber-400 shadow-amber-200\" :\n                        \"bg-primary-600 shadow-primary-200\"\n                  )}\n                  style={{ width: `${Math.min(100, usagePercent)}%` }}\n                />\n              </div>\n            </div>\n          </div>\n\n          {/* Breakdown Section */}\n          <div className=\"space-y-4\">\n            <div className=\"flex items-center gap-3 pb-3 border-b border-slate-100 dark:border-slate-800\">\n              <TrendingUp className=\"w-5 h-5 text-slate-600 dark:text-slate-300\" />\n              <h3 className=\"text-sm font-bold text-slate-600 dark:text-slate-300 uppercase tracking-[0.15em]\">\n                {t(\"leave_balances.detail.breakdown\", \"Balance Breakdown\")}\n              </h3>\n            </div>\n\n            <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4\">\n              {/* Base Entitlement */}\n              <div className=\"bg-slate-50 dark:bg-slate-800 rounded-2xl p-4 border border-slate-100 dark:border-slate-800\">\n                <div className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1\">\n                  {t(\"leave_balances.table.base\")}\n                </div>\n                <div className=\"text-2xl font-bold font-mono text-slate-600 dark:text-slate-300\">\n                  {balance.entitlement}\n                </div>\n              </div>\n\n              {/* Accrued Amount */}\n              <div className=\"bg-primary-50 dark:bg-primary-950 rounded-2xl p-4 border border-primary-100 dark:border-primary-800\">\n                <div className=\"text-[10px] font-bold text-primary-600 dark:text-primary-400 uppercase tracking-wider mb-1\">\n                  {t(\"leave_balances.table.accrued\")}\n                </div>\n                <div className=\"text-2xl font-bold font-mono text-primary-600 dark:text-primary-400\">\n                  +{balance.accrued_amount}\n                </div>\n              </div>\n\n              {/* Carried Over */}\n              <div className=\"bg-amber-50 dark:bg-amber-950 rounded-2xl p-4 border border-amber-100 dark:border-amber-800\">\n                <div className=\"text-[10px] font-bold text-amber-600 dark:text-amber-300 uppercase tracking-wider mb-1\">\n                  {t(\"leave_balances.table.carried_over\")}\n                </div>\n                <div className=\"text-2xl font-bold font-mono text-amber-600 dark:text-amber-300\">\n                  +{balance.carried_over}\n                </div>\n              </div>\n\n              {/* Used */}\n              <div className=\"bg-rose-50 dark:bg-rose-950 rounded-2xl p-4 border border-rose-100 dark:border-rose-800\">\n                <div className=\"text-[10px] font-bold text-rose-600 dark:text-rose-300 uppercase tracking-wider mb-1\">\n                  {t(\"leave_balances.table.used\")}\n                </div>\n                <div className=\"text-2xl font-bold font-mono text-rose-600 dark:text-rose-300\">\n                  -{balance.used}\n                </div>\n              </div>\n            </div>\n          </div>\n\n          {/* History Section */}\n          <div className=\"space-y-4\">\n            <div className=\"flex items-center gap-3 pb-3 border-b border-slate-100 dark:border-slate-800\">\n              <HistoryIcon className=\"w-5 h-5 text-slate-600 dark:text-slate-300\" />\n              <h3 className=\"text-sm font-bold text-slate-600 dark:text-slate-300 uppercase tracking-[0.15em]\">\n                {t(\"leave_balances.detail.history\", \"Transaction History\")}\n              </h3>\n            </div>\n\n            <Tabs value={activeTab} onValueChange={setActiveTab}>\n              <TabsList className=\"bg-slate-50 dark:bg-slate-800 p-1 rounded-xl\">\n                <TabsTrigger value=\"all\">{t(\"leave_balances.detail.tabs.all\", \"Tất cả\")}</TabsTrigger>\n                <TabsTrigger value=\"accrual\">{t(\"leave_balances.detail.tabs.accruals\", \"Tích lũy\")}</TabsTrigger>\n                <TabsTrigger value=\"usage\">{t(\"leave_balances.detail.tabs.usage\", \"Sử dụng\")}</TabsTrigger>\n              </TabsList>\n\n              <TabsContent value=\"all\">\n                <HistoryList items={history} isLoading={isLoading} />\n              </TabsContent>\n              <TabsContent value=\"accrual\">\n                <HistoryList items={accruals} isLoading={isLoading} />\n              </TabsContent>\n              <TabsContent value=\"usage\">\n                <HistoryList items={usage} isLoading={isLoading} />\n              </TabsContent>\n            </Tabs>\n          </div>\n        </div>\n      </div>\n    </div>,\n    document.body\n  );\n}\n\nfunction HistoryList({ items, isLoading }: { items: LeaveHistoryItem[], isLoading: boolean }) {\n  const { t } = useTranslation();\n\n  if (isLoading) {\n    return (\n      <div className=\"space-y-4\">\n        {[1, 2, 3].map(i => (\n          <div key={i} className=\"h-20 bg-slate-50 dark:bg-slate-800 animate-pulse rounded-2xl\" />\n        ))}\n      </div>\n    );\n  }\n\n  if (items.length === 0) {\n    return (\n      <div className=\"py-12 text-center\">\n        <Clock className=\"w-12 h-12 text-slate-200 dark:text-slate-700 mx-auto mb-3\" />\n        <p className=\"text-sm font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest italic\">\n          {t(\"common.no_data\", \"No history found\")}\n        </p>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"space-y-3\">\n      {items.map((item) => (\n        <HistoryItemRow key={item.id} item={item} />\n      ))}\n    </div>\n  );\n}\n\nfunction HistoryItemRow({ item }: { item: LeaveHistoryItem }) {\n  const { t } = useTranslation();\n  const isPositive = item.amount > 0;\n\n  return (\n    <div className=\"flex items-center gap-4 p-4 bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-2xl hover:border-primary-100 dark:border-primary-800 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-all group\">\n      <div className={cn(\n        \"w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 shadow-sm transition-transform group-hover:scale-110\",\n        isPositive ? \"bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-300\" : \"bg-rose-50 dark:bg-rose-950 text-rose-600 dark:text-rose-300\"\n      )}>\n        {isPositive ? <ArrowUpRight size={18} /> : <ArrowDownRight size={18} />}\n      </div>\n\n      <div className=\"flex-1 min-w-0\">\n        <div className=\"flex items-center justify-between mb-0.5\">\n          <span className=\"font-bold text-slate-800 dark:text-slate-100 text-sm uppercase tracking-tight truncate\">\n            {item.reason || t(`leave_balances.transaction_type.${item.transaction_type}`)}\n          </span>\n          <span className={cn(\n            \"font-mono font-bold text-sm\",\n            isPositive ? \"text-emerald-600 dark:text-emerald-300\" : \"text-rose-600 dark:text-rose-300\"\n          )}>\n            {isPositive ? \"+\" : \"\"}{item.amount}\n          </span>\n        </div>\n        <div className=\"flex items-center gap-2 text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider\">\n          <Calendar size={10} />\n          {new Date(item.date).toLocaleDateString()}\n          <span className=\"w-1 h-1 bg-slate-200 dark:bg-slate-600 rounded-full\" />\n          {t(`leave_balances.transaction_type.${item.transaction_type}`)}\n        </div>\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/leave/LeaveHistoryModal.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/leave/LeavePolicyManager.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'LeaveType' is defined but never used. Allowed unused vars must match /^_/u.","line":13,"column":23,"nodeType":"Identifier","messageId":"unusedVar","endLine":13,"endColumn":32,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"LeaveType"},"fix":{"range":[612,623],"text":""},"desc":"Remove unused variable \"LeaveType\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'cn' is defined but never used. Allowed unused vars must match /^_/u.","line":14,"column":10,"nodeType":"Identifier","messageId":"unusedVar","endLine":14,"endColumn":12,"suggestions":[{"messageId":"removeUnusedImportDeclaration","data":{"varName":"cn"},"fix":{"range":[650,684],"text":""},"desc":"Remove unused import declaration."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'calculateAnnualEntitlement' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":83,"column":9,"nodeType":"Identifier","messageId":"unusedVar","endLine":83,"endColum