":{"range":[8499,8502],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":311,"column":12,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":311,"endColumn":15,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[9504,9507],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[9504,9507],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":357,"column":41,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":357,"endColumn":44,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[10781,10784],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[10781,10784],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":391,"column":41,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":391,"endColumn":44,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[11660,11663],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[11660,11663],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":9,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { describe, it, expect, beforeEach, vi } from \"vitest\";\n\nimport { fetchEmployees, searchEmployees } from \"../employees\";\nimport { fetchWorkspacePayslips } from \"../payroll\";\nimport { PaginatedResponse } from \"../types\";\n\n/**\n * Comprehensive test suite for pagination response handling.\n * Ensures that paginated API responses are properly typed and handled\n * to prevent runtime errors like \"TypeError: employees.forEach is not a function\".\n *\n * This test suite covers:\n * - Correct response structure validation\n * - Edge cases (undefined, null, empty responses)\n * - TypeScript type safety\n * - Proper data extraction from paginated responses\n */\n\ndescribe(\"Pagination Response Handling\", () => {\n  describe(\"PaginatedResponse Type Safety\", () => {\n    it(\"should define PaginatedResponse with correct structure\", () => {\n      const mockResponse: PaginatedResponse<{ id: string }> = {\n        data: [{ id: \"1\" }],\n        total: 100,\n        page: 1,\n        limit: 50,\n      };\n\n      expect(mockResponse).toEqual({\n        data: [{ id: \"1\" }],\n        total: 100,\n        page: 1,\n        limit: 50,\n      });\n      expect(Array.isArray(mockResponse.data)).toBe(true);\n      expect(typeof mockResponse.total).toBe(\"number\");\n      expect(typeof mockResponse.page).toBe(\"number\");\n      expect(typeof mockResponse.limit).toBe(\"number\");\n    });\n\n    it(\"should handle empty paginated response\", () => {\n      const emptyResponse: PaginatedResponse<{ id: string }> = {\n        data: [],\n        total: 0,\n        page: 1,\n        limit: 50,\n      };\n\n      expect(emptyResponse.data).toHaveLength(0);\n      expect(emptyResponse.total).toBe(0);\n      expect(Array.isArray(emptyResponse.data)).toBe(true);\n    });\n\n    it(\"should enforce proper data type for paginated response\", () => {\n      interface Employee {\n        id: string;\n        full_name: string;\n      }\n\n      const response: PaginatedResponse<Employee> = {\n        data: [\n          { id: \"emp-1\", full_name: \"John Doe\" },\n          { id: \"emp-2\", full_name: \"Jane Smith\" },\n        ],\n        total: 2,\n        page: 1,\n        limit: 50,\n      };\n\n      expect(response.data).toHaveLength(2);\n      expect(response.data[0].full_name).toBe(\"John Doe\");\n      expect(response.data[1].full_name).toBe(\"Jane Smith\");\n    });\n  });\n\n  describe(\"Data Extraction from Paginated Response\", () => {\n    it(\"should safely extract data array from paginated response\", () => {\n      const response: PaginatedResponse<{ id: string }> = {\n        data: [{ id: \"1\" }, { id: \"2\" }],\n        total: 2,\n        page: 1,\n        limit: 50,\n      };\n\n      // Safe extraction pattern used in components\n      const data = response?.data ?? [];\n      expect(Array.isArray(data)).toBe(true);\n      expect(data).toHaveLength(2);\n    });\n\n    it(\"should handle undefined paginated response gracefully\", () => {\n      const response: PaginatedResponse<{ id: string }> | undefined = undefined as PaginatedResponse<{ id: string }> | undefined;\n\n      // Safe extraction pattern\n      const data = response?.data ?? [];\n      expect(Array.isArray(data)).toBe(true);\n      expect(data).toHaveLength(0);\n    });\n\n    it(\"should handle null paginated response gracefully\", () => {\n      const response: PaginatedResponse<{ id: string }> | null = null as PaginatedResponse<{ id: string }> | null;\n\n      // Safe extraction pattern\n      const data = response?.data ?? [];\n      expect(Array.isArray(data)).toBe(true);\n      expect(data).toHaveLength(0);\n    });\n\n    it(\"should prevent forEach errors on extracted data\", () => {\n      const response: PaginatedResponse<{ id: string; name: string }> = {\n        data: [{ id: \"1\", name: \"Item 1\" }],\n        total: 1,\n        page: 1,\n        limit: 50,\n      };\n\n      const data = response?.data ?? [];\n      let forEachCount = 0;\n\n      // Should not throw \"TypeError: employees.forEach is not a function\"\n      expect(() => {\n        data.forEach(() => {\n          forEachCount++;\n        });\n      }).not.toThrow();\n\n      expect(forEachCount).toBe(1);\n    });\n\n    it(\"should support array methods on extracted data\", () => {\n      const response: PaginatedResponse<{ id: string; value: number }> = {\n        data: [\n          { id: \"1\", value: 10 },\n          { id: \"2\", value: 20 },\n          { id: \"3\", value: 30 },\n        ],\n        total: 3,\n        page: 1,\n        limit: 50,\n      };\n\n      const data = response?.data ?? [];\n\n      // map\n      const mapped = data.map((item) => item.value);\n      expect(mapped).toEqual([10, 20, 30]);\n\n      // filter\n      const filtered = data.filter((item) => item.value > 15);\n      expect(filtered).toHaveLength(2);\n\n      // find\n      const found = data.find((item) => item.id === \"2\");\n      expect(found?.value).toBe(20);\n\n      // reduce\n      const sum = data.reduce((acc, item) => acc + item.value, 0);\n      expect(sum).toBe(60);\n    });\n  });\n\n  describe(\"Component Integration Patterns\", () => {\n    it(\"should demonstrate correct pattern for React Query usage\", () => {\n      // Pattern used in fixed PayrollPage.tsx\n      const employeesData: PaginatedResponse<{ id: string; full_name: string }> = {\n        data: [{ id: \"emp-1\", full_name: \"John Doe\" }],\n        total: 1,\n        page: 1,\n        limit: 50,\n      };\n\n      // Correct: Access .data property\n      const employees = employeesData?.data ?? [];\n      expect(Array.isArray(employees)).toBe(true);\n      expect(employees).toHaveLength(1);\n\n      // Should work with array methods\n      const names = employees.map((emp) => emp.full_name);\n      expect(names).toEqual([\"John Doe\"]);\n    });\n\n    it(\"should demonstrate incorrect pattern that caused the bug\", () => {\n      // This is what was happening before the fix\n      const employeesData: PaginatedResponse<{ id: string; full_name: string }> =\n        {\n          data: [{ id: \"emp-1\", full_name: \"John Doe\" }],\n          total: 1,\n          page: 1,\n          limit: 50,\n        };\n\n      // INCORRECT: Treating paginated response as array directly\n      // This would cause: TypeError: employees.forEach is not a function\n      // because employeesData is an object with a .data property, not an array\n\n      // The fix ensures we use .data before array operations\n      expect(() => {\n        const employees = employeesData?.data ?? [];\n        employees.forEach(() => {\n          /* iteration */\n        });\n      }).not.toThrow();\n    });\n\n    it(\"should handle missing data property in response\", () => {\n      const malformedResponse = {\n        total: 1,\n        page: 1,\n        limit: 50,\n        // missing 'data' property\n      } as any;\n\n      const data = malformedResponse?.data ?? [];\n      expect(Array.isArray(data)).toBe(true);\n      expect(data).toHaveLength(0);\n    });\n\n    it(\"should handle pagination metadata correctly\", () => {\n      const response: PaginatedResponse<{ id: string }> = {\n        data: [{ id: \"1\" }, { id: \"2\" }],\n        total: 100,\n        page: 1,\n        limit: 50,\n      };\n\n      // Extract data for iteration\n      const data = response?.data ?? [];\n\n      // Use pagination metadata for UI\n      const totalPages = Math.ceil(response.total / response.limit);\n      const canGoNext = response.page < totalPages;\n      const canGoPrev = response.page > 1;\n\n      expect(data).toHaveLength(2);\n      expect(totalPages).toBe(2);\n      expect(canGoNext).toBe(true);\n      expect(canGoPrev).toBe(false);\n    });\n  });\n\n  describe(\"Edge Cases and Error Scenarios\", () => {\n    it(\"should handle large dataset pagination\", () => {\n      const largeData = Array.from({ length: 1000 }, (_, i) => ({\n        id: `item-${i}`,\n      }));\n\n      const response: PaginatedResponse<{ id: string }> = {\n        data: largeData.slice(0, 50),\n        total: 1000,\n        page: 1,\n        limit: 50,\n      };\n\n      const data = response?.data ?? [];\n      expect(data).toHaveLength(50);\n      expect(response.total).toBe(1000);\n    });\n\n    it(\"should handle single item pagination\", () => {\n      const response: PaginatedResponse<{ id: string; name: string }> = {\n        data: [{ id: \"1\", name: \"Single Item\" }],\n        total: 1,\n        page: 1,\n        limit: 50,\n      };\n\n      const data = response?.data ?? [];\n      expect(data).toHaveLength(1);\n      expect(data[0].name).toBe(\"Single Item\");\n    });\n\n    it(\"should handle null data array gracefully\", () => {\n      const response = {\n        data: null,\n        total: 0,\n        page: 1,\n        limit: 50,\n      } as any;\n\n      const data = response?.data ?? [];\n      expect(Array.isArray(data)).toBe(true);\n      expect(data).toHaveLength(0);\n    });\n\n    it(\"should prevent common array method errors\", () => {\n      const scenarios = [\n        { response: undefined, name: \"undefined response\" },\n        { response: null, name: \"null response\" },\n        { response: { data: [] }, name: \"empty data array\" },\n      ];\n\n      scenarios.forEach(({ response, name }) => {\n        const data = response?.data ?? [];\n\n        expect(() => {\n          data.forEach(() => {\n            /* noop */\n          });\n          data.map((x) => x);\n          data.filter((x) => x);\n          data.find((x) => x);\n          expect(data.length).toBeGreaterThanOrEqual(0);\n        }).not.toThrow(`Should not throw for ${name}`);\n      });\n    });\n\n    it(\"should handle response with unexpected structure\", () => {\n      const unexpectedResponse = {\n        results: [{ id: \"1\" }], // Wrong property name\n        count: 1,\n      } as any;\n\n      const data = unexpectedResponse?.data ?? [];\n      expect(Array.isArray(data)).toBe(true);\n      expect(data).toHaveLength(0);\n    });\n\n    it(\"should validate pagination numbers\", () => {\n      const responses: PaginatedResponse<{ id: string }>[] = [\n        {\n          data: [],\n          total: 0,\n          page: 1,\n          limit: 50,\n        },\n        {\n          data: [{ id: \"1\" }],\n          total: 1,\n          page: 1,\n          limit: 1,\n        },\n        {\n          data: [{ id: \"1\" }, { id: \"2\" }],\n          total: 100,\n          page: 3,\n          limit: 50,\n        },\n      ];\n\n      responses.forEach((response) => {\n        expect(response.total).toBeGreaterThanOrEqual(0);\n        expect(response.page).toBeGreaterThanOrEqual(1);\n        expect(response.limit).toBeGreaterThan(0);\n        expect(response.data).toBeInstanceOf(Array);\n      });\n    });\n  });\n\n  describe(\"API Function Typing\", () => {\n    it(\"should validate fetchEmployees returns PaginatedResponse type\", async () => {\n      // This test validates the function signature\n      // The actual API mock would be handled by integration tests\n\n      const mockFetch = vi.fn();\n\n      // Mock the apiFetch to validate response structure\n      const createMockResponse = (data: any) => ({\n        ok: true,\n        json: async () => data,\n      });\n\n      const paginatedEmployees: PaginatedResponse<{\n        id: string;\n        full_name: string;\n      }> = {\n        data: [\n          { id: \"emp-1\", full_name: \"John Doe\" },\n          { id: \"emp-2\", full_name: \"Jane Smith\" },\n        ],\n        total: 2,\n        page: 1,\n        limit: 50,\n      };\n\n      mockFetch.mockResolvedValue(\n        createMockResponse(paginatedEmployees)\n      );\n\n      const result = await mockFetch();\n      const parsed = await result.json();\n\n      expect(parsed.data).toBeInstanceOf(Array);\n      expect(parsed.total).toBe(2);\n      expect(parsed.page).toBe(1);\n      expect(parsed.limit).toBe(50);\n    });\n\n    it(\"should validate searchEmployees returns PaginatedResponse type\", async () => {\n      const mockFetch = vi.fn();\n\n      const createMockResponse = (data: any) => ({\n        ok: true,\n        json: async () => data,\n      });\n\n      const searchResults: PaginatedResponse<{\n        id: string;\n        full_name: string;\n      }> = {\n        data: [{ id: \"emp-1\", full_name: \"John\" }],\n        total: 1,\n        page: 1,\n        limit: 50,\n      };\n\n      mockFetch.mockResolvedValue(\n        createMockResponse(searchResults)\n      );\n\n      const result = await mockFetch();\n      const parsed = await result.json();\n\n      expect(parsed.data).toHaveLength(1);\n      expect(parsed.data[0].full_name).toContain(\"John\");\n    });\n  });\n\n  describe(\"TypeScript Type Enforcement\", () => {\n    it(\"should enforce PaginatedResponse structure at compile time\", () => {\n      // This test documents the type structure for developers\n      interface TestItem {\n        id: string;\n        value: string;\n      }\n\n      const validResponse: PaginatedResponse<TestItem> = {\n        data: [\n          { id: \"1\", value: \"test\" },\n          { id: \"2\", value: \"demo\" },\n        ],\n        total: 2,\n        page: 1,\n        limit: 50,\n      };\n\n      const extractedData = validResponse.data;\n      expect(extractedData[0].id).toBe(\"1\");\n      expect(extractedData[0].value).toBe(\"test\");\n    });\n\n    it(\"should allow optional fields in PaginatedResponse items\", () => {\n      interface EmployeeOptional {\n        id: string;\n        full_name: string;\n        department?: string;\n      }\n\n      const response: PaginatedResponse<EmployeeOptional> = {\n        data: [\n          { id: \"1\", full_name: \"John\", department: \"Sales\" },\n          { id: \"2\", full_name: \"Jane\" }, // Optional department omitted\n        ],\n        total: 2,\n        page: 1,\n        limit: 50,\n      };\n\n      expect(response.data).toHaveLength(2);\n      expect(response.data[0].department).toBe(\"Sales\");\n      expect(response.data[1].department).toBeUndefined();\n    });\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/lib/api/agents.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":11,"column":66,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":11,"endColumn":69,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[436,439],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[436,439],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":11,"column":80,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":11,"endColumn":83,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[450,453],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[450,453],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { API_BASE_URL } from \"./config\";\nimport { apiFetch } from \"./helpers\";\nimport { AgentStatus, Device, AuthorizedAgent, DeviceInfo } from \"./types\";\n\nexport async function fetchAgents(): Promise<AgentStatus[]> {\n  const response = await apiFetch(`${API_BASE_URL}/agents`);\n  if (!response.ok) throw new Error(\"Failed to fetch agents\");\n  return response.json();\n}\n\nexport async function sendAgentCommand(agentId: string, command: any): Promise<any> {\n  const response = await apiFetch(`${API_BASE_URL}/agent/${agentId}/command`, {\n    method: \"POST\",\n    body: JSON.stringify(command),\n  });\n  return response.json();\n}\n\nexport async function fetchDevices(): Promise<Device[]> {\n  const response = await apiFetch(`${API_BASE_URL}/devices`);\n  if (!response.ok) throw new Error(\"Failed to fetch devices\");\n  return response.json();\n}\n\nexport async function createDevice(\n  device: Partial<Device>,\n): Promise<{ id: string }> {\n  const response = await apiFetch(`${API_BASE_URL}/devices`, {\n    method: \"POST\",\n    body: JSON.stringify(device),\n  });\n  if (!response.ok) throw new Error(\"Failed to create device\");\n  return response.json();\n}\n\nexport async function updateDevice(\n  id: string,\n  device: Partial<Device>,\n): Promise<void> {\n  const response = await apiFetch(`${API_BASE_URL}/devices/${id}`, {\n    method: \"PUT\",\n    body: JSON.stringify(device),\n  });\n  if (!response.ok) throw new Error(\"Failed to update device\");\n}\n\nexport async function deleteDevice(id: string): Promise<void> {\n  const response = await apiFetch(`${API_BASE_URL}/devices/${id}`, {\n    method: \"DELETE\",\n  });\n  if (!response.ok) throw new Error(\"Failed to delete device\");\n}\n\nexport async function fetchAuthorizedAgents(\n  includeInactive: boolean = false,\n): Promise<AuthorizedAgent[]> {\n  const url = includeInactive\n    ? `${API_BASE_URL}/authorized-agents?include_inactive=true`\n    : `${API_BASE_URL}/authorized-agents`;\n  const response = await apiFetch(url);\n  if (!response.ok) throw new Error(\"Failed to fetch authorized agents\");\n  return response.json();\n}\n\nexport async function fetchAuthorizedAgentById(id: string): Promise<AuthorizedAgent> {\n  const response = await apiFetch(`${API_BASE_URL}/authorized-agents/${id}`);\n  if (!response.ok) throw new Error(\"Failed to fetch authorized agent\");\n  return response.json();\n}\n\nexport async function createAuthorizedAgent(\n  agent: Partial<AuthorizedAgent>,\n): Promise<{ id: string }> {\n  const response = await apiFetch(`${API_BASE_URL}/authorized-agents`, {\n    method: \"POST\",\n    body: JSON.stringify(agent),\n  });\n  if (!response.ok) throw new Error(\"Failed to create authorized agent\");\n  return response.json();\n}\n\nexport async function updateAgentTrust(\n  id: string,\n  is_trusted: boolean,\n): Promise<void> {\n  const response = await apiFetch(\n    `${API_BASE_URL}/authorized-agents/${id}/trust`,\n    {\n      method: \"PUT\",\n      body: JSON.stringify({ is_trusted }),\n    },\n  );\n  if (!response.ok) throw new Error(\"Failed to update agent trust\");\n}\n\nexport async function updateAuthorizedAgent(\n  id: string,\n  agent: Partial<AuthorizedAgent>,\n): Promise<AuthorizedAgent> {\n  const response = await apiFetch(`${API_BASE_URL}/authorized-agents/${id}`, {\n    method: \"PATCH\",\n    body: JSON.stringify(agent),\n  });\n  if (!response.ok) throw new Error(\"Failed to update authorized agent\");\n  return response.json();\n}\n\nexport async function deleteAuthorizedAgent(id: string): Promise<void> {\n  const response = await apiFetch(`${API_BASE_URL}/authorized-agents/${id}`, {\n    method: \"DELETE\",\n  });\n  if (!response.ok) throw new Error(\"Failed to delete authorized agent\");\n}\n\nexport async function fetchDeviceInfo(id: string): Promise<DeviceInfo> {\n  const response = await apiFetch(`${API_BASE_URL}/devices/${id}/info`);\n  if (!response.ok) throw new Error(\"Failed to fetch device info\");\n  return response.json();\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/lib/api/attendance.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'AttendanceSummary' is defined but never used. Allowed unused vars must match /^_/u.","line":8,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":8,"endColumn":20,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"AttendanceSummary"},"fix":{"range":[205,226],"text":""},"desc":"Remove unused variable \"AttendanceSummary\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'PaginatedResponse' is defined but never used. Allowed unused vars must match /^_/u.","line":10,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":10,"endColumn":20,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"PaginatedResponse"},"fix":{"range":[251,272],"text":""},"desc":"Remove unused variable \"PaginatedResponse\"."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":185,"column":12,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":185,"endColumn":15,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[6182,6185],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[6182,6185],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { API_BASE_URL } from \"./config\";\nimport { apiFetch, getCurrentWorkspaceId, TIMEOUT } from \"./helpers\";\nimport {\n  TimeEntry,\n  AttendanceAdjustmentRequest,\n  RawAttendanceLog,\n  AttendanceImportJob,\n  AttendanceSummary,\n  DailyAttendanceReport,\n  PaginatedResponse,\n  AttendanceReportSort,\n  ReportExportJob,\n  CreateReportExportRequest,\n  CreateReportExportResponse,\n  WorkerMonitorStats, AttendanceDailySummary \n} from \"./types\";\n\nexport async function punchIn(\n  wsId: string,\n  data: { employee_id: string; entry_type?: string; note?: string },\n): Promise<TimeEntry> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/time/punch-in`, {\n    method: \"POST\",\n    body: JSON.stringify(data),\n  });\n  if (!response.ok) throw new Error(\"Failed to punch in\");\n  return response.json();\n}\n\nexport async function punchOut(\n  wsId: string,\n  employeeId: string,\n  data: { note?: string },\n): Promise<TimeEntry> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/time/punch-out/${employeeId}`, {\n    method: \"POST\",\n    body: JSON.stringify(data),\n  });\n  if (!response.ok) throw new Error(\"Failed to punch out\");\n  return response.json();\n}\n\nexport async function fetchTimeHistory(\n  wsId: string,\n  employeeId: string,\n  start: string,\n  end: string,\n): Promise<TimeEntry[]> {\n  const response = await apiFetch(\n    `${API_BASE_URL}/workspaces/${wsId}/time/history/${employeeId}?start=${start}&end=${end}`,\n  );\n  if (!response.ok) throw new Error(\"Failed to fetch time history\");\n  return response.json();\n}\n\nexport async function updateTimeEntry(\n  wsId: string,\n  id: string,\n  data: Partial<TimeEntry>,\n): Promise<TimeEntry> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/time/entries/${id}`, {\n    method: \"PUT\",\n    body: JSON.stringify(data),\n  });\n  if (!response.ok) throw new Error(\"Failed to update time entry\");\n  return response.json();\n}\n\nexport async function deleteTimeEntry(wsId: string, id: string): Promise<void> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/time/entries/${id}`, {\n    method: \"DELETE\",\n  });\n  if (!response.ok) throw new Error(\"Failed to delete time entry\");\n}\n\nexport async function submitAttendanceAdjustment(\n  wsId: string,\n  data: {\n    employee_id: string;\n    time_entry_id?: string;\n    requested_punch_in_time: string;\n    requested_punch_out_time?: string;\n    is_break_overtime?: boolean;\n    reason?: string;\n  }\n): Promise<AttendanceAdjustmentRequest> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/attendance/adjustments`, {\n    method: \"POST\",\n    body: JSON.stringify({ is_break_overtime: false, ...data }),\n  });\n  if (!response.ok) throw new Error(\"Failed to submit attendance adjustment\");\n  return response.json();\n}\n\nexport async function fetchWorkspaceAttendanceAdjustments(\n  wsId: string,\n  status?: string\n): Promise<AttendanceAdjustmentRequest[]> {\n  const url = status\n    ? `${API_BASE_URL}/workspaces/${wsId}/attendance/adjustments?status=${status}`\n    : `${API_BASE_URL}/workspaces/${wsId}/attendance/adjustments`;\n  const response = await apiFetch(url);\n  if (!response.ok) throw new Error(\"Failed to fetch attendance adjustments\");\n  return response.json();\n}\n\nexport async function fetchMyAttendanceAdjustments(\n  employeeId: string\n): Promise<AttendanceAdjustmentRequest[]> {\n  const response = await apiFetch(`${API_BASE_URL}/employees/${employeeId}/attendance/adjustments`);\n  if (!response.ok) throw new Error(\"Failed to fetch my attendance adjustments\");\n  return response.json();\n}\n\nexport async function approveAttendanceAdjustment(\n  wsId: string,\n  requestId: string,\n  data: { status: string }\n): Promise<void> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/attendance/adjustments/${requestId}/approve`, {\n    method: \"POST\",\n    body: JSON.stringify(data),\n  });\n  if (!response.ok) throw new Error(\"Failed to approve attendance adjustment\");\n}\n\nexport async function fetchAttendanceLogs(params: {\n  employee_id?: string;\n  from?: string;\n  to?: string;\n  page?: number;\n  limit?: number;\n}): Promise<{ data: TimeEntry[]; total: number; page: number; limit: number }> {\n  const searchParams = new URLSearchParams();\n  if (params.employee_id) searchParams.append(\"employee_id\", params.employee_id);\n  if (params.from) searchParams.append(\"from\", params.from);\n  if (params.to) searchParams.append(\"to\", params.to);\n  if (params.page) searchParams.append(\"page\", params.page.toString());\n  if (params.limit) searchParams.append(\"limit\", params.limit.toString());\n\n  const wsId = getCurrentWorkspaceId();\n  const url = wsId\n    ? `${API_BASE_URL}/workspaces/${wsId}/attendance/logs?${searchParams.toString()}`\n    : `${API_BASE_URL}/attendance/logs?${searchParams.toString()}`;\n\n  const response = await apiFetch(url);\n  if (!response.ok) throw new Error(\"Failed to fetch attendance logs\");\n  return response.json();\n}\n\nexport async function fetchRawAttendanceLogs(params: {\n  employee_id?: string;\n  from?: string;\n  to?: string;\n  page?: number;\n  limit?: number;\n}): Promise<{ data: RawAttendanceLog[]; total: number; page: number; limit: number }> {\n  const searchParams = new URLSearchParams();\n  if (params.employee_id) searchParams.append(\"employee_id\", params.employee_id);\n  if (params.from) searchParams.append(\"from\", params.from);\n  if (params.to) searchParams.append(\"to\", params.to);\n  if (params.page) searchParams.append(\"page\", params.page.toString());\n  if (params.limit) searchParams.append(\"limit\", params.limit.toString());\n\n  const wsId = getCurrentWorkspaceId();\n  if (!wsId) throw new Error(\"Workspace not selected\");\n\n  const url = `${API_BASE_URL}/workspaces/${wsId}/attendance/raw-logs?${searchParams.toString()}`;\n\n  const response = await apiFetch(url);\n  if (!response.ok) throw new Error(\"Failed to fetch raw attendance logs\");\n  return response.json();\n}\n\nexport async function fetchAttendanceReport(\n  wsId: string,\n  start: string,\n  end: string,\n  type: \"summary\" | \"daily\" = \"summary\",\n  page?: number,\n  limit?: number,\n  sort?: AttendanceReportSort,\n  employeeIds?: string[],\n  departmentId?: string | null\n): Promise<any> {\n  const params = new URLSearchParams({\n    start_date: start,\n    end_date: end,\n    type,\n  });\n  if (page) params.append(\"page\", page.toString());\n  if (limit) params.append(\"limit\", limit.toString());\n  if (sort) params.append(\"sort\", sort);\n  if (employeeIds && employeeIds.length > 0) {\n    params.append(\"employee_ids\", employeeIds.join(\",\"));\n  }\n  if (departmentId) {\n    params.append(\"department_id\", departmentId);\n  }\n\n  const response = await apiFetch(\n    `${API_BASE_URL}/workspaces/${wsId}/reports/attendance?${params.toString()}`,\n  );\n  if (!response.ok) throw new Error(\"Failed to fetch attendance report\");\n  return response.json();\n}\n\nexport async function uploadAttendanceExcel(\n  wsId: string,\n  file: File\n): Promise<{ job_id: string }> {\n  return uploadAttendance(wsId, file, \"/attendance/upload\");\n}\n\nexport async function uploadEmployees(\n  wsId: string,\n  file: File\n): Promise<{ job_id: string }> {\n  return uploadAttendance(wsId, file, \"/employees/upload\");\n}\n\nexport async function uploadAttendance(\n  wsId: string,\n  file: File,\n  endpoint: string\n): Promise<{ job_id: string }> {\n  const formData = new FormData();\n  formData.append(\"file\", file);\n\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}${endpoint}`, {\n    method: \"POST\",\n    body: formData,\n  });\n  if (!response.ok) throw new Error(\"Failed to upload attendance\");\n  return response.json();\n}\n\nexport async function fetchLatestImportJob(\n  wsId: string,\n  targetType?: string\n): Promise<AttendanceImportJob | null> {\n  const url = targetType\n    ? `${API_BASE_URL}/workspaces/${wsId}/attendance/import-jobs/latest?target_type=${targetType}`\n    : `${API_BASE_URL}/workspaces/${wsId}/attendance/import-jobs/latest`;\n  const response = await apiFetch(url);\n  if (!response.ok) throw new Error(\"Failed to fetch latest import job\");\n  return response.json();\n}\n\nexport async function fetchImportJobStatus(\n  wsId: string,\n  jobId: string\n): Promise<AttendanceImportJob> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/attendance/import-jobs/${jobId}`);\n  if (!response.ok) throw new Error(\"Failed to fetch import job status\");\n  return response.json();\n}\n\nexport async function reprocessAttendance(\n  wsId: string,\n  employeeId: string,\n  startDate: string,\n  endDate: string\n): Promise<void> {\n  const response = await apiFetch(\n    `${API_BASE_URL}/workspaces/${wsId}/attendance/reprocess/${employeeId}?start_date=${startDate}&end_date=${endDate}`,\n    {\n      method: \"POST\",\n      timeout: TIMEOUT.REPORT_OPERATION,\n    }\n  );\n  if (!response.ok) throw new Error(\"Failed to reprocess attendance\");\n}\n\nexport async function reprocessAllAttendance(\n  wsId: string,\n  startDate: string,\n  endDate: string\n): Promise<{ message: string; job_id: string }> {\n  const response = await apiFetch(\n    `${API_BASE_URL}/workspaces/${wsId}/attendance/reprocess-all?start_date=${startDate}&end_date=${endDate}`,\n    {\n      method: \"POST\",\n    }\n  );\n  if (!response.ok) throw new Error(\"Failed to queue reprocess all attendance job\");\n  return response.json();\n}\n\nexport interface GenericJobProgress {\n  total_batches: number;\n  completed_batches: number;\n  failed_batches: number;\n  percentage: number;\n}\n\nexport interface GenericJobStatus {\n  job_id: string;\n  status: \"pending\" | \"processing\" | \"completed\" | \"failed\";\n  progress: GenericJobProgress;\n  error?: string;\n  created_at: string;\n  completed_at?: string;\n}\n\nexport async function fetchGenericJobStatus(\n  wsId: string,\n  jobId: string\n): Promise<GenericJobStatus> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/jobs/${jobId}`);\n  if (!response.ok) throw new Error(\"Failed to fetch job status\");\n  return response.json();\n}\n\n// --- Admin Confirm Attendance ---\n\n/**\n * Admin shortcut: confirm attendance for a row in one action via the Confirm Modal.\n * \n * - If an `existingRequestId` is provided (meaning the employee already submitted an adjustment),\n *   this function will bypass the creation step and directly approve that pending request.\n * - Otherwise, it submits a new adjustment using the times provided by the admin in the modal,\n *   and then immediately approves it in a subsequent API call.\n * \n * @param wsId - The ID of the current workspace\n * @param row - The DailyAttendanceReport record being confirmed\n * @param existingRequestId - Optional ID of a pending adjustment request to approve\n * @param reason - The reason text entered by the admin in the confirmation modal\n */\nexport async function adminConfirmAttendance(\n  wsId: string,\n  row: DailyAttendanceReport,\n  existingRequestId?: string,\n  reason?: string,\n): Promise<void> {\n  let requestId = existingRequestId;\n\n  if (!requestId) {\n    // Helper: Safely convert any time string (either full ISO or raw HH:mm:ss) into a UTC ISO string.\n    // This is crucial because `actual_punch_in` from the modal might be a full ISO string (Z-suffixed),\n    // but fallbacks like `scheduled_start` are just raw time strings.\n    const toDatetime = (date: string, time: string) => {\n      // If it's already a complete UTC ISO string (has 'T' and 'Z'), use it directly\n      if (time.includes('T') && time.includes('Z')) {\n        return time;\n      }\n\n      // Otherwise, it's a raw local time like \"08:00:00\" from scheduled_start or fallback.\n      // We parse it as a local time on the given date, then convert to UTC automatically \n      // via `toISOString()` to avoid AM/PM timezone wrap-around bugs.\n      const [h, m, s] = time.substring(0, 8).split(':').map(Number);\n      const [Y, M, D] = date.split('-').map(Number);\n      return new Date(Y, M - 1, D, h, m, s || 0).toISOString();\n    };\n\n    // Use actual punch times if available; otherwise use scheduled times or midnight fallback\n    const punchIn = row.actual_punch_in || row.scheduled_start || \"00:00:00\";\n    const punchOut = row.actual_punch_out || row.scheduled_end || undefined;\n\n    const adjustment = await submitAttendanceAdjustment(wsId, {\n      employee_id: row.employee_id,\n      requested_punch_in_time: toDatetime(row.date, punchIn),\n      requested_punch_out_time: punchOut\n        ? toDatetime(row.date, punchOut)\n        : undefined,\n      reason: reason || \"Admin confirmation\",\n    });\n    requestId = adjustment.id;\n  }\n\n  await approveAttendanceAdjustment(wsId, requestId, { status: \"approved\" });\n}\n\n// --- OT Claim & Approval ---\n\n\nexport async function claimOt(\n  wsId: string,\n  employeeId: string,\n  data: { date: string; claimed_minutes: number; reason?: string }\n): Promise<void> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/attendance/claim-ot/${employeeId}`, {\n    method: \"POST\",\n    body: JSON.stringify(data),\n  });\n  if (!response.ok) throw new Error(\"Failed to claim OT\");\n}\n\nexport async function approveOt(\n  wsId: string,\n  employeeId: string,\n  data: { date: string; approved_minutes: number; manager_note?: string; status: \"approved\" | \"rejected\" }\n): Promise<void> {\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/attendance/approve-ot/${employeeId}`, {\n    method: \"POST\",\n    body: JSON.stringify(data),\n  });\n  if (!response.ok) throw new Error(\"Failed to approve OT\");\n}\n\nexport async function fetchAttendanceSummaries(\n  wsId: string,\n  start: string,\n  end: string,\n  employeeId?: string\n): Promise<AttendanceDailySummary[]> {\n  const params = new URLSearchParams({\n    start_date: start,\n    end_date: end,\n  });\n  if (employeeId) params.append(\"employee_id\", employeeId);\n\n  const response = await apiFetch(`${API_BASE_URL}/workspaces/${wsId}/attendance/summaries?${params.toString()}`);\n  if (!response.ok) throw new Error(\"Failed to fetch attendance summaries\");\n  return response.json();\n}\n\nexport async function enterPaperOt(\n  wsId: string,\n  employeeId: string,\n  data: {\n    date: string;\n    claimed_minutes: number;\n    reason: string;\n    paper_form_photo_url?: string;\n  }\n): Promise<AttendanceDailySummary> {\n  const response = await apiFetch(\n    `${API_BASE_URL}/workspaces/${wsId}/attendance/enter-paper-ot/${employeeId}`,\n    {\n      method: \"POST\",\n      body: JSON.stringify(data),\n    }\n  );\n  if (!response.ok) {\n    const err = await response.text();\n    throw new Error(err || \"Failed to enter paper OT\");\n  }\n  return response.json();\n}\n\nexport async function bulkUploadPaperOt(\n  wsId: string,\n  file: File\n): Promise<{\n  total_rows: number;\n  success_count: number;\n  failed_count: number;\n  errors: Array<{\n    line_number: number;\n    employee_id: string;\n    error_message: string;\n  }>;\n}> {\n  const formData = new FormData();\n  formData.append(\"file\", file);\n\n  const response = await apiFetch(\n    `${API_BASE_URL}/workspaces/${wsId}/attendance/bulk-upload-paper-ot`,\n    {\n      method: \"POST\",\n      body: formData,\n    }\n  );\n\n  if (!response.ok) {\n    const err = await response.text();\n    throw new Error(err || \"Failed to upload CSV file\");\n  }\n\n  return response.json();\n}\n\n// --- Staging Logs (Unknown Users) ---\n\nexport interface StagingLog {\n  id: string;\n  workspace_id: string;\n  device_id: string | null;\n  raw_user_id: string;\n  punch_time: string;\n  raw_data: Record<string, unknown> | null;\n  status: string;\n  created_at: string;\n}\n\nexport interface StagingLogsResponse {\n  data: StagingLog[];\n  total: number;\n  page: number;\n  limit: number;\n}\n\nexport async function fetchStagingLogs(\n  wsId: string,\n  page: number = 1,\n  limit: number = 50\n): Promise<StagingLogsResponse> {\n  const params = new URLSearchParams({\n    page: page.toString(),\n    limit: limit.toString(),\n  });\n\n  const response = await apiFetch(\n    `${API_BASE_URL}/workspaces/${wsId}/attendance/staging-logs?${params.toString()}`\n  );\n  if (!response.ok) throw new Error(\"Failed to fetch staging logs\");\n  return response.json();\n}\n\nexport async function resolveStagingLog(\n  wsId: string,\n  logId: string,\n  employeeId: string\n): Promise<void> {\n  const response = await apiFetch(\n    `${API_BASE_URL}/workspaces/${wsId}/attendance/staging-logs/${logId}/resolve`,\n    {\n      method: \"POST\",\n      body: JSON.stringify({ employee_id: employeeId }),\n    }\n  );\n  if (!response.ok) throw new Error(\"Failed to resolve staging log\");\n}\n\nexport async function dismissStagingLog(\n  wsId: string,\n  logId: string\n): Promise<void> {\n  const response = await apiFetch(\n    `${API_BASE_URL}/workspaces/${wsId}/attendance/staging-logs/${logId}`,\n    {\n      method: \"DELETE\",\n    }\n  );\n  if (!response.ok) throw new Error(\"Failed to dismiss staging log\");\n}\n\n// --- Report Export ---\n\nexport async function createReportExportJob(\n  wsId: string,\n  request: CreateReportExportRequest\n): Promise<CreateReportExportResponse> {\n  const response = await apiFetch(\n    `${API_BASE_URL}/workspaces/${wsId}/reports/export`,\n    {\n      method: \"POST\",\n      body: JSON.stringify(request),\n      timeout: TIMEOUT.REPORT_OPERATION, // 3 minutes for report generation\n    }\n  );\n  if (!response.ok) {\n    const err = await response.text();\n    throw new Error(err || \"Failed to start report export\");\n  }\n  return response.json();\n}\n\nexport async function fetchExportJobStatus(\n  wsId: string,\n  jobId: string\n): Promise<ReportExportJob> {\n  const response = await apiFetch(\n    `${API_BASE_URL}/workspaces/${wsId}/reports/jobs/${jobId}`\n  );\n  if (!response.ok) throw new Error(\"Failed to fetch export job status\");\n  return response.json();\n}\n\nexport async function cancelExportJob(\n  wsId: string,\n  jobId: string\n): Promise<void> {\n  con