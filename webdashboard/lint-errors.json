yees/WorkingConditionConfig\";\nimport EmployeeSalaryConfig from \"@/components/payroll/EmployeeSalaryConfig\";\nimport Sheet from \"@/components/ui/Sheet\";\n\nimport { cn } from \"@/lib/utils\";\n\n\nimport type { Employee, Department } from \"@/lib/api\";\n\n\ntype DetailTabType = \"profile\" | \"salary\" | \"history\" | \"policies\";\nconst TAB_ORDER: DetailTabType[] = [\"profile\", \"salary\", \"policies\", \"history\"];\nconst SCROLL_STEP = 80;\n\ninterface EmployeeDetailDrawerProps {\n    isOpen: boolean;\n    onClose: () => void;\n    employee: Employee | null;\n    wsId: string;\n    departments?: Department[];\n    deptHistory?: any[];\n    employmentHistory?: any[];\n    formatDate: (date: string) => string;\n    onEdit: (employee: Employee) => void;\n    onTerminate: (employee: Employee) => void;\n    onRehire: (employee: Employee) => void;\n    onTransfer: (departmentId: string) => void;\n}\n\nexport default function EmployeeDetailDrawer({\n    isOpen,\n    onClose,\n    employee,\n    wsId,\n    departments,\n    deptHistory,\n    employmentHistory,\n    formatDate,\n    onEdit,\n    onTerminate,\n    onRehire,\n    onTransfer,\n}: EmployeeDetailDrawerProps) {\n    const { t } = useTranslation();\n    const [activeDetailTab, setActiveDetailTab] = useState<DetailTabType>(\"profile\");\n    const scrollRef = useRef<HTMLDivElement>(null);\n\n    // Arrow keys: left/right = switch tabs, up/down = scroll content\n    useEffect(() => {\n        if (!isOpen) return;\n        const handleKeyDown = (e: KeyboardEvent) => {\n            if (e.key === \"ArrowLeft\" || e.key === \"ArrowRight\") {\n                e.preventDefault();\n                setActiveDetailTab((prev) => {\n                    const idx = TAB_ORDER.indexOf(prev);\n                    if (e.key === \"ArrowRight\") return TAB_ORDER[(idx + 1) % TAB_ORDER.length];\n                    return TAB_ORDER[(idx - 1 + TAB_ORDER.length) % TAB_ORDER.length];\n                });\n            } else if (e.key === \"ArrowUp\" || e.key === \"ArrowDown\") {\n                e.preventDefault();\n                e.stopPropagation();\n                const sheetScrollContainer = scrollRef.current?.closest('.overflow-y-auto');\n                sheetScrollContainer?.scrollBy({\n                    top: e.key === \"ArrowDown\" ? SCROLL_STEP : -SCROLL_STEP,\n                    behavior: \"smooth\",\n                });\n            }\n        };\n        window.addEventListener(\"keydown\", handleKeyDown, true);\n        return () => window.removeEventListener(\"keydown\", handleKeyDown, true);\n    }, [isOpen]);\n\n    if (!employee) return null;\n\n    return (\n        <Sheet\n            isOpen={isOpen}\n            onClose={onClose}\n            className=\"!max-w-2xl\"\n            hideHeader\n            contentClassName=\"!p-0\"\n        >\n            {/* Custom header */}\n            <div className=\"sticky top-0 z-20 p-10 border-b border-slate-50 dark:border-slate-800 bg-slate-50/95 dark:bg-slate-800/95 backdrop-blur-sm shadow-sm\">\n                <div className=\"flex justify-between items-start mb-8\">\n                    <div className=\"flex items-center gap-6\">\n                        <div className=\"w-20 h-20 bg-primary-600 text-white rounded-[2rem] flex items-center justify-center font-bold text-3xl shadow-xl shadow-primary-100 dark:shadow-black/30 border-4 border-white rotate-3 group hover:rotate-0 transition-transform duration-500 uppercase\">{employee.full_name[0]}</div>\n                        <div>\n                            <h2 className=\"text-3xl font-bold text-slate-700 dark:text-slate-200 tracking-tighter uppercase leading-none mb-2\">{employee.full_name}</h2>\n                            <div className=\"flex items-center gap-3\">\n                                <span className=\"text-primary-600 dark:text-primary-400 font-mono text-xs font-bold tracking-widest uppercase bg-white dark:bg-slate-900 px-3 py-1 rounded-full border border-primary-100 dark:border-primary-800 shadow-sm\">{employee.employee_id_number}</span>\n                                <div className=\"w-1.5 h-1.5 bg-slate-200 dark:bg-slate-600 rounded-full\" />\n                                <span className={cn(\"text-[9px] font-bold uppercase tracking-widest px-2 py-0.5 rounded-full border shadow-sm\", employee.is_active ? 'bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-300 border-emerald-100 dark:border-emerald-800' : 'bg-slate-50 dark:bg-slate-800 text-slate-500 dark:text-slate-400 border-slate-100 dark:border-slate-800 opacity-60')}>{employee.is_active ? t(\"employees.table.active\").toUpperCase() : t(\"employees.table.terminated\").toUpperCase()}</span>\n                            </div>\n                        </div>\n                    </div>\n                    <button onClick={onClose} className=\"p-3 bg-white dark:bg-slate-900 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-[1.25rem] transition-all shadow-md active:scale-90 border border-slate-100 dark:border-slate-800 text-slate-300 dark:text-slate-600 hover:text-rose-600 dark:text-rose-300\"><X size={24} /></button>\n                </div>\n\n                <div className=\"flex bg-white dark:bg-slate-900/50 p-1.5 rounded-[22px] w-fit border border-slate-200 dark:border-slate-700/50 shadow-inner\">\n                    {[\n                        { id: \"profile\", label: t(\"common.profile\") },\n                        { id: \"salary\", label: t(\"employees.details.salary_benefits\") },\n                        { id: \"policies\", label: t(\"employees.details.special_policies\") },\n                        { id: \"history\", label: t(\"employees.details.work_history\") }\n                    ].map(tab => (\n                        <button key={tab.id} data-testid={`employees-tab-${tab.id}`} onClick={() => setActiveDetailTab(tab.id as DetailTabType)} className={cn(\"px-8 py-2.5 rounded-[18px] text-[10px] font-bold uppercase tracking-widest transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500\", activeDetailTab === tab.id ? \"bg-white dark:bg-slate-900 text-primary-600 dark:text-primary-400 shadow-sm border border-slate-100 dark:border-slate-800\" : \"text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 border border-transparent\")}>{tab.label.toUpperCase()}</button>\n                    ))}\n                </div>\n            </div>\n\n            <div ref={scrollRef} className=\"p-10 pb-20 space-y-10\">\n                {activeDetailTab === \"profile\" && (\n                    <div className=\"space-y-10\">\n                        <div className=\"grid grid-cols-2 gap-6\">\n                            <PermissionGate permission=\"employees:update\">\n                                <button data-testid=\"employees-btn-edit\" onClick={() => onEdit(employee)} className=\"flex items-center justify-center gap-3 py-4 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 font-bold rounded-2xl hover:bg-slate-50 dark:hover:bg-slate-800 hover:border-slate-300 dark:hover:border-slate-600 transition-all text-xs uppercase tracking-widest shadow-sm active:scale-95\"><Pencil size={18} /> {t(\"employees.details.edit_profile\").toUpperCase()}</button>\n                            </PermissionGate>\n                            <PermissionGate permission=\"employees:update\">\n                                {employee.is_active ? (\n                                    <button data-testid=\"employees-btn-terminate\" onClick={() => onTerminate(employee)} className=\"flex items-center justify-center gap-3 py-4 bg-rose-50 dark:bg-rose-950 text-rose-600 dark:text-rose-300 font-bold rounded-2xl hover:bg-rose-100 dark:bg-rose-900 transition-all text-xs uppercase tracking-widest active:scale-95 shadow-sm shadow-rose-900/5\"><Trash2 size={18} /> {t(\"employees.details.terminate\").toUpperCase()}</button>\n                                ) : (\n                                    <button data-testid=\"employees-btn-rehire\" onClick={() => onRehire(employee)} className=\"flex items-center justify-center gap-3 py-4 bg-primary-600 text-white font-bold rounded-2xl hover:bg-primary-700 transition-all text-xs uppercase tracking-widest shadow-xl shadow-primary-100 dark:shadow-black/30 active:scale-95\"><UserPlus size={18} /> {t(\"employees.details.rehire\").toUpperCase()}</button>\n                                )}\n                            </PermissionGate>\n                        </div>\n\n                        <section className=\"space-y-5\">\n                            <div className=\"flex justify-between items-center px-2\">\n                                <span className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.3em] flex items-center gap-2 opacity-70\"><Building2 size={14} className=\"text-primary-500\" /> {t(\"employees.details.current_dept\").toUpperCase()}</span>\n                                <PermissionGate permission=\"employees:update\">\n                                    <button onClick={() => onTransfer(deptHistory?.[0]?.department_id || \"\")} className=\"text-[10px] font-bold text-primary-600 dark:text-primary-400 uppercase tracking-widest hover:underline active:scale-90\">{t(\"employees.details.transfer\").toUpperCase()}</button>\n                                </PermissionGate>\n                            </div>\n                            <div className=\"bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800 p-8 rounded-[2.5rem] group hover:bg-white dark:hover:bg-slate-900 hover:shadow-xl hover:shadow-primary-100/10 transition-all shadow-inner relative overflow-hidden\">\n                                {deptHistory && deptHistory.length > 0 ? (\n                                    <div>\n                                        <div className=\"font-bold text-slate-700 dark:text-slate-200 text-2xl tracking-tighter uppercase leading-none mb-3\">{departments?.find(d => d.id === deptHistory[0].department_id)?.name}</div>\n                                        <div className=\"flex items-center gap-2 text-[10px] text-slate-500 dark:text-slate-400 font-bold uppercase tracking-widest opacity-70\"><Calendar size={12} className=\"text-primary-400\" /> {t(\"employees.transfer.effective_date\")}: {formatDate(deptHistory[0].effective_date)}</div>\n                                    </div>\n                                ) : (<div className=\"text-xs text-slate-500 dark:text-slate-400 font-bold uppercase tracking-widest italic opacity-60\">{t(\"employees.details.not_assigned_dept\")}</div>)}\n                                <Building2 className=\"absolute -right-8 -bottom-8 w-32 h-32 text-slate-700 dark:text-slate-200 opacity-5 -rotate-12 group-hover:rotate-0 transition-transform duration-700\" />\n                            </div>\n                        </section>\n\n                        <section className=\"space-y-5\">\n                            <span className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-[0.3em] flex items-center gap-2 px-2 opacity-70\"><Calendar size={14} className=\"text-emerald-500\" /> {t(\"employees.table.hire_date\").toUpperCase()}</span>\n                            <div className=\"bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800 p-8 rounded-[2.5rem] font-bold text-slate-800 dark:text-slate-100 text-2xl tracking-tighter shadow-inner uppercase font-mono\">{formatDate(employee.hire_date)}</div>\n                        </section>\n                    </div>\n                )}\n\n                {activeDetailTab === \"salary\" && (\n                    <div>\n                        <EmployeeSalaryConfig wsId={wsId} employeeId={employee.id} />\n                    </div>\n                )}\n\n                {activeDetailTab === \"policies\" && (\n                    <div>\n                        <WorkingConditionConfig wsId={wsId} employeeId={employee.id} />\n                    </div>\n                )}\n\n                {activeDetailTab === \"history\" && (\n                    <div className=\"space-y-12 px-2 pt-4\">\n                        <div className=\"relative pl-12 space-y-12 before:absolute before:left-[11px] before:top-4 before:bottom-4 before:w-px before:bg-slate-100 dark:bg-slate-700\">\n                            {employmentHistory?.map((period, idx) => (\n                                <React.Fragment key={period.id}>\n                                    {period.termination_date && (\n                                        <div className=\"relative animate-in slide-in-from-left duration-500\">\n                                            <div className=\"absolute -left-[3.15rem] top-1 w-6 h-6 rounded-full bg-rose-50 dark:bg-rose-950 border-4 border-white shadow-xl ring-4 ring-rose-50 z-10\"></div>\n                                            <div className=\"bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800 p-6 rounded-[2rem] shadow-inner group hover:bg-white dark:hover:bg-slate-900 transition-all\">\n                                                <div className=\"text-sm font-bold text-slate-800 dark:text-slate-100 uppercase tracking-widest mb-1.5\">{t(\"employees.table.terminated\")}</div>\n                                                <div className=\"text-[10px] text-rose-500 font-bold uppercase tracking-[0.2em] font-mono\">{formatDate(period.termination_date)}</div>\n                                            </div>\n                                        </div>\n                                    )}\n                                    <div className=\"relative animate-in slide-in-from-left duration-500\">\n                                        <div className={cn(\"absolute -left-[3.15rem] top-1 w-6 h-6 rounded-full border-4 border-white shadow-xl ring-4 z-10\", idx === 0 && !period.termination_date ? 'bg-emerald-50 dark:bg-emerald-950 ring-emerald-50 animate-pulse' : 'bg-primary-600 ring-primary-50')}></div>\n                                        <div className=\"bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 p-6 rounded-[2rem] shadow-sm hover:shadow-xl hover:shadow-primary-100/10 transition-all group overflow-hidden\">\n                                            <div className=\"text-sm font-bold text-slate-700 dark:text-slate-200 uppercase tracking-widest mb-1.5\">{period.is_rehire ? t(\"employees.details.returned\") : t(\"employees.details.joined\")}</div>\n                                            <div className={cn(\"text-[10px] font-bold uppercase tracking-[0.2em] font-mono\", idx === 0 && !period.termination_date ? \"text-emerald-600 dark:text-emerald-300\" : \"text-slate-500 dark:text-slate-400\")}>{formatDate(period.hire_date)}</div>\n                                            <CalendarIcon className=\"absolute -right-4 -bottom-4 w-16 h-16 text-slate-100 opacity-20 -rotate-12 group-hover:rotate-0 transition-transform duration-700\" />\n                                        </div>\n                                    </div>\n                                </React.Fragment>\n                            ))}\n                        </div>\n                    </div>\n                )}\n            </div>\n        </Sheet>\n    );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/employees/EmployeeFormModal.tsx","messages":[{"ruleId":"import-x/order","severity":2,"message":"There should be at least one empty line between import groups","line":1,"column":1,"nodeType":"ImportDeclaration","messageId":"oneLineBetweenGroups","endLine":1,"endColumn":27,"fix":{"range":[26,26],"text":"\n"}},{"ruleId":"import-x/order","severity":2,"message":"`@tanstack/react-query` import should occur before import of `lucide-react`","line":4,"column":1,"nodeType":"ImportDeclaration","messageId":"order","endLine":4,"endColumn":69,"fix":{"range":[27,187],"text":"import { useMutation, useQueryClient } from \"@tanstack/react-query\";\nimport { UserCircle } from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n"}},{"ruleId":"import-x/order","severity":2,"message":"`@/components/ui/FormField` import should occur before import of `@/components/ui/Modal`","line":7,"column":1,"nodeType":"ImportDeclaration","messageId":"order","endLine":7,"endColumn":51,"fix":{"range":[188,282],"text":"import FormField from \"@/components/ui/FormField\";\nimport Modal from \"@/components/ui/Modal\";\n"}},{"ruleId":"import-x/order","severity":2,"message":"`@/components/ui/Button` import should occur before import of `@/components/ui/Modal`","line":8,"column":1,"nodeType":"ImportDeclaration","messageId":"order","endLine":8,"endColumn":45,"fix":{"range":[188,327],"text":"import Button from \"@/components/ui/Button\";\nimport Modal from \"@/components/ui/Modal\";\nimport FormField from \"@/components/ui/FormField\";\n"}}],"suppressedMessages":[],"errorCount":4,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":4,"fixableWarningCount":0,"source":"import React from \"react\";\nimport { UserCircle } from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\nimport { useMutation, useQueryClient } from \"@tanstack/react-query\";\n\nimport Modal from \"@/components/ui/Modal\";\nimport FormField from \"@/components/ui/FormField\";\nimport Button from \"@/components/ui/Button\";\nimport { useToast } from \"@/components/ui/Toast\";\n\nimport { createEmployee, updateEmployee, Employee } from \"@/lib/api\";\n\ninterface EmployeeFormModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  editingEmployee: Employee | null;\n  wsId: string;\n  prefillEnrollmentId?: string;\n  onSuccess?: () => void;\n}\n\nexport default function EmployeeFormModal({\n  isOpen,\n  onClose,\n  editingEmployee,\n  wsId,\n  prefillEnrollmentId = \"\",\n  onSuccess,\n}: EmployeeFormModalProps) {\n  const { t } = useTranslation();\n  const queryClient = useQueryClient();\n  const toast = useToast();\n\n  const createMutation = useMutation({\n    mutationFn: (data: Partial<Employee>) => createEmployee(wsId, data),\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: [\"employees\", wsId] });\n      onClose();\n      toast.success(t(\"common.success\"));\n      onSuccess?.();\n    },\n  });\n\n  const updateMutation = useMutation({\n    mutationFn: (data: { id: string; employee: Partial<Employee> }) =>\n      updateEmployee(wsId, data.id, data.employee),\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: [\"employees\", wsId] });\n      onClose();\n      toast.success(t(\"common.success\"));\n      onSuccess?.();\n    },\n  });\n\n  const handleSubmit = (e: React.FormEvent<HTMLFormElement>) => {\n    e.preventDefault();\n    const formData = new FormData(e.currentTarget);\n    const data = {\n      full_name: formData.get(\"full_name\") as string,\n      employee_id_number: formData.get(\"employee_id_number\") as string,\n      hire_date: formData.get(\"hire_date\") as string,\n      is_active: formData.get(\"is_active\") === \"on\",\n    };\n    if (editingEmployee) {\n      updateMutation.mutate({ id: editingEmployee.id, employee: data });\n    } else {\n      createMutation.mutate(data);\n    }\n  };\n\n  return (\n    <Modal\n      isOpen={isOpen}\n      onClose={onClose}\n      title={editingEmployee ? t(\"employees.form.edit_title\") : t(\"employees.form.add_title\")}\n      subtitle={t(\"employees.form.subtitle\")}\n      icon={<UserCircle size={24} />}\n      maxWidth=\"lg\"\n    >\n      <form onSubmit={handleSubmit} className=\"space-y-8 pt-4 animate-in fade-in duration-500\">\n        <FormField\n          label={t(\"employees.form.full_name\")}\n          name=\"full_name\"\n          data-testid=\"employees-form-name-input\"\n          required\n          defaultValue={editingEmployee?.full_name}\n        />\n        <FormField\n          label={t(\"employees.form.employee_id\")}\n          name=\"employee_id_number\"\n          data-testid=\"employees-form-id-input\"\n          required\n          defaultValue={editingEmployee?.employee_id_number || prefillEnrollmentId}\n          inputClassName=\"font-mono tracking-widest\"\n        />\n        <FormField\n          label={t(\"employees.form.hire_date\")}\n          name=\"hire_date\"\n          type=\"date\"\n          data-testid=\"employees-form-hire-date-input\"\n          required\n          defaultValue={editingEmployee?.hire_date}\n        />\n        <div className=\"flex items-center gap-4 py-2 px-2 group cursor-pointer\">\n          <input\n            type=\"checkbox\"\n            name=\"is_active\"\n            id=\"is_active\"\n            data-testid=\"employees-form-active-checkbox\"\n            defaultChecked={editingEmployee ? editingEmployee.is_active : true}\n            className=\"w-7 h-7 text-primary-600 dark:text-primary-400 rounded-xl border-slate-200 dark:border-slate-700 focus:ring-primary-500 transition-all cursor-pointer shadow-inner\"\n          />\n          <label\n            htmlFor=\"is_active\"\n            className=\"text-sm font-bold text-slate-700 dark:text-slate-200 uppercase tracking-widest cursor-pointer group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors\"\n          >\n            {t(\"employees.form.is_active\")}\n          </label>\n        </div>\n        <div className=\"pt-6 grid grid-cols-2 gap-6 border-t border-slate-50 dark:border-slate-800\">\n          <Button variant=\"outline\" size=\"lg\" onClick={onClose} type=\"button\">\n            {t(\"employees.form.cancel\").toUpperCase()}\n          </Button>\n          <Button\n            variant=\"secondary\"\n            size=\"lg\"\n            type=\"submit\"\n            data-testid=\"save-employee-btn\"\n            loading={createMutation.isPending || updateMutation.isPending}\n          >\n            {editingEmployee ? t(\"employees.form.update\").toUpperCase() : t(\"employees.form.save\").toUpperCase()}\n          </Button>\n        </div>\n      </form>\n    </Modal>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/employees/EmploymentHistoryModal.tsx","messages":[{"ruleId":"import-x/order","severity":2,"message":"There should be at least one empty line between import groups","line":1,"column":1,"nodeType":"ImportDeclaration","messageId":"oneLineBetweenGroups","endLine":1,"endColumn":27,"fix":{"range":[26,26],"text":"\n"}},{"ruleId":"import-x/order","severity":2,"message":"There should be at least one empty line between import groups","line":7,"column":1,"nodeType":"ImportDeclaration","messageId":"oneLineBetweenGroups","endLine":7,"endColumn":45,"fix":{"range":[299,299],"text":"\n"}},{"ruleId":"import-x/order","severity":2,"message":"`@/components/ui/Button` import should occur before import of `@/components/ui/Modal`","line":7,"column":1,"nodeType":"ImportDeclaration","messageId":"order","endLine":7,"endColumn":45,"fix":{"range":[157,300],"text":"import Button from \"@/components/ui/Button\";\nimport Modal from \"@/components/ui/Modal\";\nimport StatusBadge from \"@/components/ui/StatusBadge\";\n"}}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":3,"fixableWarningCount":0,"source":"import React from \"react\";\nimport { History as HistoryIcon, Calendar as CalendarIcon } from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport Modal from \"@/components/ui/Modal\";\nimport StatusBadge from \"@/components/ui/StatusBadge\";\nimport Button from \"@/components/ui/Button\";\nimport { EmploymentPeriod } from \"@/lib/api\";\n\ninterface EmploymentHistoryModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  employmentHistory: EmploymentPeriod[] | undefined;\n  formatDate: (dateString: string) => string;\n}\n\nexport default function EmploymentHistoryModal({\n  isOpen,\n  onClose,\n  employmentHistory,\n  formatDate,\n}: EmploymentHistoryModalProps) {\n  const { t } = useTranslation();\n\n  return (\n    <Modal\n      isOpen={isOpen}\n      onClose={onClose}\n      title={t(\"employees.history.title\")}\n      subtitle={t(\"employees.history.subtitle\")}\n      icon={<HistoryIcon size={24} />}\n      maxWidth=\"lg\"\n    >\n      <div className=\"space-y-4 pt-4 animate-in fade-in duration-500\">\n        {employmentHistory?.map((period) => (\n          <div\n            key={period.id}\n            className=\"p-8 bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 rounded-[2.5rem] shadow-inner group hover:bg-white dark:hover:bg-slate-900 transition-all relative overflow-hidden\"\n          >\n            <div className=\"flex justify-between items-center relative z-10\">\n              <div>\n                <div className=\"font-bold text-slate-700 dark:text-slate-200 text-lg uppercase tracking-tight flex items-center gap-4\">\n                  {period.is_rehire\n                    ? t(\"employees.history.rehire_period\")\n                    : t(\"employees.history.first_period\")}\n                  {!period.termination_date && (\n                    <StatusBadge variant=\"success\">\n                      {t(\"employees.history.currently_working\")}\n                    </StatusBadge>\n                  )}\n                </div>\n                <div className=\"text-[10px] text-slate-500 dark:text-slate-400 font-bold uppercase tracking-[0.25em] mt-3 flex items-center gap-3 opacity-70\">\n                  <CalendarIcon size={14} className=\"text-primary-400\" />{\" \"}\n                  {t(\"employees.history.period_range\", {\n                    start: formatDate(period.hire_date),\n                    end: period.termination_date\n                      ? formatDate(period.termination_date)\n                      : t(\"employees.history.present\").toUpperCase(),\n                  })}\n                </div>\n              </div>\n            </div>\n            <CalendarIcon className=\"absolute -right-8 -bottom-8 w-32 h-32 text-slate-700 dark:text-slate-200 opacity-5 -rotate-12 group-hover:rotate-0 transition-transform duration-700\" />\n          </div>\n        ))}\n      </div>\n      <div className=\"mt-10 pt-8 border-t border-slate-50 dark:border-slate-800 flex justify-end\">\n        <Button variant=\"secondary\" size=\"lg\" onClick={onClose} type=\"button\">\n          {t(\"common.close\").toUpperCase()}\n        </Button>\n      </div>\n    </Modal>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/employees/RehireEmployeeModal.tsx","messages":[{"ruleId":"import-x/order","severity":2,"message":"There should be at least one empty line between import groups","line":1,"column":1,"nodeType":"ImportDeclaration","messageId":"oneLineBetweenGroups","endLine":1,"endColumn":27,"fix":{"range":[26,26],"text":"\n"}},{"ruleId":"import-x/order","severity":2,"message":"`@tanstack/react-query` import should occur before import of `lucide-react`","line":4,"column":1,"nodeType":"ImportDeclaration","messageId":"order","endLine":4,"endColumn":69,"fix":{"range":[27,185],"text":"import { useMutation, useQueryClient } from \"@tanstack/react-query\";\nimport { UserPlus } from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n"}},{"ruleId":"import-x/order","severity":2,"message":"`date-fns` import should occur before import of `lucide-react`","line":5,"column":1,"nodeType":"ImportDeclaration","messageId":"order","endLine":5,"endColumn":35,"fix":{"range":[27,220],"text":"import { format } from \"date-fns\";\nimport { UserPlus } from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\nimport { useMutation, useQueryClient } from \"@tanstack/react-query\";\n"}},{"ruleId":"import-x/order","severity":2,"message":"`@/components/ui/FormField` import should occur before import of `@/components/ui/Modal`","line":8,"column":1,"nodeType":"ImportDeclaration","messageId":"order","endLine":8,"endColumn":51,"fix":{"range":[221,315],"text":"import FormField from \"@/components/ui/FormField\";\nimport Modal from \"@/components/ui/Modal\";\n"}},{"ruleId":"import-x/order","severity":2,"message":"`@/components/ui/Button` import should occur before import of `@/components/ui/Modal`","line":9,"column":1,"nodeType":"ImportDeclaration","messageId":"order","endLine":9,"endColumn":45,"fix":{"range":[221,360],"text":"import Button from \"@/components/ui/Button\";\nimport Modal from \"@/components/ui/Modal\";\nimport FormField from \"@/components/ui/FormField\";\n"}}],"suppressedMessages":[],"errorCount":5,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":5,"fixableWarningCount":0,"source":"import React from \"react\";\nimport { UserPlus } from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\nimport { useMutation, useQueryClient } from \"@tanstack/react-query\";\nimport { format } from \"date-fns\";\n\nimport Modal from \"@/components/ui/Modal\";\nimport FormField from \"@/components/ui/FormField\";\nimport Button from \"@/components/ui/Button\";\nimport { useToast } from \"@/components/ui/Toast\";\n\nimport { rehireEmployee, Employee } from \"@/lib/api\";\n\ninterface RehireEmployeeModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  employeeId: string | null;\n  wsId: string;\n  onSuccess?: (employee: Employee) => void;\n}\n\nexport default function RehireEmployeeModal({\n  isOpen,\n  onClose,\n  employeeId,\n  wsId,\n  onSuccess,\n}: RehireEmployeeModalProps) {\n  const { t } = useTranslation();\n  const queryClient = useQueryClient();\n  const toast = useToast();\n\n  const rehireMutation = useMutation({\n    mutationFn: (data: { hire_date: string }) => {\n      if (!employeeId) throw new Error(\"No employee selected\");\n      return rehireEmployee(wsId, employeeId, data);\n    },\n    onSuccess: (updatedEmp) => {\n      queryClient.invalidateQueries({ queryKey: [\"employees\", wsId] });\n      queryClient.invalidateQueries({ queryKey: [\"employmentHistory\", employeeId] });\n      onClose();\n      toast.success(t(\"common.success\"));\n      onSuccess?.(updatedEmp);\n    },\n  });\n\n  const handleRehireSubmit = (e: React.FormEvent<HTMLFormElement>) => {\n    e.preventDefault();\n    const formData = new FormData(e.currentTarget);\n    rehireMutation.mutate({ hire_date: formData.get(\"hire_date\") as string });\n  };\n\n  return (\n    <Modal\n      isOpen={isOpen}\n      onClose={onClose}\n      title={t(\"employees.rehire.title\")}\n      subtitle={t(\"employees.rehire.subtitle\")}\n      icon={<UserPlus size={24} />}\n      maxWidth=\"md\"\n    >\n      <div className=\"space-y-10 pt-4 animate-in fade-in duration-500\">\n        <div className=\"p-8 bg-slate-50 dark:bg-slate-800 rounded-[2.5rem] border border-slate-100 dark:border-slate-800 shadow-inner text-center italic\">\n          <p className=\"text-sm font-bold text-slate-600 dark:text-slate-300 uppercase tracking-tight leading-relaxed\">\n            \"{t(\"employees.rehire.confirm_msg\")}\"\n          </p>\n        </div>\n        <form onSubmit={handleRehireSubmit} className=\"space-y-8\">\n          <FormField\n            label={t(\"employees.rehire.rehire_date\")}\n            name=\"hire_date\"\n            type=\"date\"\n            required\n            defaultValue={format(new Date(), \"yyyy-MM-dd\")}\n          />\n          <div className=\"pt-6 grid grid-cols-2 gap-6 border-t border-slate-50 dark:border-slate-800\">\n            <Button variant=\"outline\" size=\"lg\" onClick={onClose} type=\"button\">\n              {t(\"common.cancel\").toUpperCase()}\n            </Button>\n            <Button\n              size=\"lg\"\n              type=\"submit\"\n              data-testid=\"confirm-rehire-btn\"\n              loading={rehireMutation.isPending}\n            >\n              {rehireMutation.isPending\n                ? t(\"employees.rehire.processing\").toUpperCase()\n                : t(\"employees.rehire.confirm\").toUpperCase()}\n            </Button>\n          </div>\n        </form>\n      </div>\n    </Modal>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/employees/TransferEmployeeModal.tsx","messages":[{"ruleId":"import-x/order","severity":2,"message":"There should be at least one empty line between import groups","line":1,"column":1,"nodeType":"ImportDeclaration","messageId":"oneLineBetweenGroups","endLine":1,"endColumn":27,"fix":{"range":[26,26],"text":"\n"}},{"ruleId":"import-x/order","severity":2,"message":"`@tanstack/react-query` import should occur before import of `lucide-react`","line":4,"column":1,"nodeType":"ImportDeclaration","messageId":"order","endLine":4,"endColumn":69,"fix":{"range":[27,186],"text":"import { useMutation, useQueryClient } from \"@tanstack/react-query\";\nimport { Building2 } from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n"}},{"ruleId":"import-x/order","severity":2,"message":"`date-fns` import should occur before import of `lucide-react`","line":5,"column":1,"nodeType":"ImportDeclaration","messageId":"order","endLine":5,"endColumn":35,"fix":{"range":[27,221],"text":"import { format } from \"date-fns\";\nimport { Building2 } from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\nimport { useMutation, useQueryClient } from \"@tanstack/react-query\";\n"}},{"ruleId":"import-x/order","severity":2,"message":"`@/components/ui/FormField` import should occur before import of `@/components/ui/Modal`","line":8,"column":1,"nodeType":"ImportDeclaration","messageId":"order","endLine":8,"endColumn":51,"fix":{"range":[222,316],"text":"import FormField from \"@/components/ui/FormField\";\nimport Modal from \"@/components/ui/Modal\";\n"}},{"ruleId":"import-x/order","severity":2,"message":"`@/components/ui/Combobox` import should occur before import of `@/components/ui/Modal`","line":9,"column":1,"nodeType":"ImportDeclaration","messageId":"order","endLine":9,"endColumn":53,"fix":{"range":[222,369],"text":"import { Combobox } from \"@/components/ui/Combobox\";\nimport Modal from \"@/components/ui/Modal\";\nimport FormField from \"@/components/ui/FormField\";\n"}},{"ruleId":"import-x/order","severity":2,"message":"`@/components/ui/Button` import should occur before import of `@/components/ui/Modal`","line":10,"column":1,"nodeType":"ImportDeclaration","messageId":"order","endLine":10,"endColumn":45,"fix":{"range":[222,414],"text":"import Button from \"@/components/ui/Button\";\nimport Modal from \"@/components/ui/Modal\";\nimport FormField from \"@/components/ui/FormField\";\nimport { Combobox } from \"@/components/ui/Combobox\";\n"}}],"suppressedMessages":[],"errorCount":6,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":6,"fixableWarningCount":0,"source":"import React from \"react\";\nimport { Building2 } from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\nimport { useMutation, useQueryClient } from \"@tanstack/react-query\";\nimport { format } from \"date-fns\";\n\nimport Modal from \"@/components/ui/Modal\";\nimport FormField from \"@/components/ui/FormField\";\nimport { Combobox } from \"@/components/ui/Combobox\";\nimport Button from \"@/components/ui/Button\";\nimport { useToast } from \"@/components/ui/Toast\";\n\nimport { transferEmployee, Department } from \"@/lib/api\";\n\ninterface TransferEmployeeModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  employeeId: string | null;\n  wsId: string;\n  departments: Department[] | undefined;\n  selectedDeptId: string;\n  setSelectedDeptId: (id: string) => void;\n}\n\nexport default function TransferEmployeeModal({\n  isOpen,\n  onClose,\n  employeeId,\n  wsId,\n  departments,\n  selectedDeptId,\n  setSelectedDeptId,\n}: TransferEmployeeModalProps) {\n  const { t } = useTranslation();\n  const queryClient = useQueryClient();\n  const toast = useToast();\n\n  const transferMutation = useMutation({\n    mutationFn: (data: { department_id: string; effective_date: string; notes?: string }) => {\n      if (!employeeId) throw new Error(\"No employee selected\");\n      return transferEmployee(wsId, employeeId, data);\n    },\n    onSuccess: () => {\n      queryClient.invalidateQueries({ queryKey: [\"deptHistory\", employeeId] });\n      onClose();\n      setSelectedDeptId(\"\");\n      toast.success(t(\"common.success\"));\n    },\n  });\n\n  const handleTransferSubmit = (e: React.FormEvent<HTMLFormElement>) => {\n    e.preventDefault();\n    const formData = new FormData(e.currentTarget);\n    transferMutation.mutate({\n      department_id: selectedDeptId,\n      effective_date: formData.get(\"effective_date\") as string,\n      notes: (formData.get(\"notes\") as string) || undefined,\n    });\n  };\n\n  return (\n    <Modal\n      isOpen={isOpen}\n      onClose={() => {\n        onClose();\n        setSelectedDeptId(\"\");\n      }}\n      title={t(\"employees.transfer.title\")}\n      subtitle={t(\"employees.transfer.subtitle\")}\n      icon={<Building2 size={24} />}\n      maxWidth=\"md\"\n    >\n      <form onSubmit={handleTransferSubmit} className=\"space-y-8 pt-4 animate-in fade-in duration-500\">\n        <div className=\"space-y-3 px-1\">\n          <label className=\"text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest ml-1\">\n            {t(\"employees.transfer.new_dept\")}\n          </label>\n          <Combobox\n            options={\n              departments?.map((d) => ({\n                value: d.id,\n                label: d.name.toUpperCase(),\n                icon: <Building2 size={14} />,\n              })) || []\n            }\n            value={selectedDeptId}\n            onChange={setSelectedDeptId}\n            placeholder={t(\"employees.transfer.select_dept\")}\n            className=\"bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 h-14\"\n          />\n        </div>\n        <FormField\n          label={t(\"employees.transfer.effective_date\")}\n          name=\"effective_date\"\n          type=\"date\"\n          required\n          defaultValue={format(new Date(), \"yyyy-MM-dd\")}\n        />\n        <FormField\n          label={t(\"employees.transfer.notes\")}\n          name=\"notes\"\n          type=\"textarea\"\n          placeholder={t(\"employees.transfer.notes_placeholder\")}\n          rows={4}\n        />\n        <div className=\"pt-6 grid grid-cols-2 gap-6 border-t border-slate-50 dark:border-slate-800\">\n          <Button variant=\"outline\" size=\"lg\" onClick={onClose} type=\"button\">\n            {t(\"common.cancel\").toUpperCase()}\n          </Button>\n          <Button\n            variant=\"secondary\"\n            size=\"lg\"\n            type=\"submit\"\n            data-testid=\"submit-transfer-btn\"\n            loading={transferMutation.isPending}\n          >\n            {t(\"employees.transfer.submit\").toUpperCase()}\n          </Button>\n        </div>\n      </form>\n    </Modal>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/employees/__tests__/EmployeeDetailDrawer.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/leave/LeaveImportDialog.tsx","messages":[{"ruleId":"jsx-a11y/click-events-have-key-events","severity":2,"message":"Visible, non-interactive elements with click handlers must have at least one keyboard listener.","line":281,"column":11,"nodeType":"JSXOpeningElement","endLine":289,"endColumn":12},{"ruleId":"jsx-a11y/no-static-element-interactions","severity":2,"message":"Avoid non-native interactive elements. If using native HTML is not possible, add an appropriate role and support for tabbing, mouse, keyboard, and touch inputs to an interactive content element.","line":281,"column":11,"nodeType":"JSXOpeningElement","endLine":289,"endColumn":12}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState, useEffect, useCallback, useRef } from \"react\";\n\nimport { Upload, FileText, Loader2, CheckCircle2, AlertCircle, Download, AlertTriangle, XCircle } from \"lucide-react\";\nimport { useTranslation } from \"react-i18next\";\n\nimport Modal from \"@/components/ui/Modal\";\n\nimport {\n  uploadLeaveExcel,\n  fetchLatestLeaveImport,\n  downloadLeaveImportTemplate,\n  downloadLeaveImportErrors,\n  getCurrentWorkspaceId,\n} from \"@/lib/api\";\nimport { cn } from \"@/lib/utils\";\n\nimport type { LeaveImportJob } from \"@/lib/api/leaves\";\n\ninterface LeaveImportDialogProps {\n  isOpen: boolean;\n  onClose: () => void;\n  onImportComplete?: () => void;\n}\n\nexport default function LeaveImportDialog({\n  isOpen,\n  onClose,\n  onImportComplete,\n}: LeaveImportDialogProps) {\n  const { t, i18n } = useTranslation();\n  const wsId = getCurrentWorkspaceId();\n  const [file, setFile] = useState<File | null>(null);\n  const [uploading, setUploading] = useState(false);\n  const [downloadingTemplate, setDownloadingTemplate] = useState(false);\n  const [importJob, setImportJob] = useState<LeaveImportJob | null>(null);\n  const pollingRef = useRef<ReturnType<typeof setInterval> | null>(null);\n\n  // Check for latest import when dialog opens\n  useEffect(() => {\n    if (!isOpen || !wsId) return;\n    fetchLatestLeaveImport(wsId).then((job) => {\n      if (job) {\n        const created = new Date(job.created_at);\n        const now = new Date();\n        if (now.getTime() - created.getTime() < 24 * 60 * 60 * 1000) {\n          setImportJob(job);\n        }\n      }\n    }).catch(() => {});\n  }, [isOpen, wsId]);\n\n  // Polling for job status\n  const startPolling = useCallback((wsIdVal: string) => {\n    if (pollingRef.current) clearInterval(pollingRef.current);\n    pollingRef.current = setInterval(async () => {\n      try {\n        const job = await fetchLatestLeaveImport(wsIdVal);\n        if (job) {\n          setImportJob(job);\n          if (job.status !== \"processing\" && job.status !== \"pending\") {\n            if (pollingRef.current) clearInterval(pollingRef.current);\n            pollingRef.current = null;\n            onImportComplete?.();\n          }\n        }\n      } catch {\n        // Network error — keep polling\n      }\n    }, 2000);\n  }, [onImportComplete]);\n\n  useEffect(() => {\n    if (importJob?.status === \"processing\" || importJob?.status === \"pending\") {\n      if (wsId) startPolling(wsId);\n    }\n    return () => {\n      if (pollingRef.current) clearInterval(pollingRef.current);\n    };\n  }, [importJob?.status, wsId, startPolling]);\n\n  // Reset state when dialog closes\n  useEffect(() => {\n    if (!isOpen) {\n      setFile(null);\n    }\n  }, [isOpen]);\n\n  const handleUpload = async () => {\n    if (!file || !wsId) return;\n    setUploading(true);\n    try {\n      const result = await uploadLeaveExcel(wsId, file);\n      setImportJob({\n        id: result.job_id,\n        status: \"pending\",\n        total_rows: 0,\n        processed_rows: 0,\n        error_log: null,\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString(),\n      });\n      setFile(null);\n      startPolling(wsId);\n    } catch {\n      // Error handled by toast in parent or here\n    } finally {\n      setUploading(false);\n    }\n  };\n\n  const getErrorInfo = (job: LeaveImportJob) => {\n    if (!job.error_log) return null;\n    try {\n      return JSON.parse(job.error_log) as { success_count?: number; error_count?: number; error_file_path?: string };\n    } catch { return null; }\n  };\n\n  const isProcessing = importJob?.status === \"processing\" || importJob?.status === \"pending\";\n  const isFinished = importJob?.status === \"completed\" || importJob?.status === \"failed\";\n\n  return (\n    <Modal\n      isOpen={isOpen}\n      onClose={onClose}\n      title={t(\"leave_import.title\", \"Import đơn nghỉ phép\")}\n      subtitle={t(\"leave_import.subtitle\", \"Upload file Excel để tạo đơn nghỉ phép hàng loạt\")}\n      icon={<Upload size={24} />}\n      maxWidth=\"lg\"\n      testId=\"leave-import-dialog\"\n    >\n      {importJob && (isProcessing || isFinished) ? (\n        /* ===== PROGRESS / RESULT VIEW ===== */\n        <div className=\"space-y-5 pt-2 animate-in fade-in duration-500\">\n          <div className=\"flex items-center justify-between px-2\">\n            <div className=\"flex items-center gap-4\">\n              <div className=\"w-11 h-11 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center shadow-inner border border-slate-200 dark:border-slate-700\">\n                {isProcessing ? (\n                  <Loader2 size={20} className=\"text-primary-600 dark:text-primary-400 animate-spin\" />\n                ) : importJob.status === \"completed\" && !importJob.error_log ? (\n                  <CheckCircle2 size={20} className=\"text-emerald-500\" />\n                ) : importJob.status === \"completed\" && importJob.error_log ? (\n                  <AlertTriangle size={20} className=\"text-amber-500\" />\n                ) : (\n                  <XCircle size={20} className=\"text-rose-500\" />\n                )}\n              </div>\n              <div>\n                <h3 className=\"font-bold text-slate-800 dark:text-slate-200 uppercase tracking-tight text-base leading-none mb-1\">\n                  {isProcessing\n                    ? t(\"leave_import.status.processing\", \"Đang xử lý...\")\n                    : importJob.status === \"completed\" && !importJob.error_log\n                      ? t(\"leave_import.status.completed\", \"Import thành công\")\n                      : importJob.status === \"completed\" && importJob.error_log\n                        ? t(\"leave_import.status.partial\", \"Import có lỗi\")\n                        : t(\"leave_import.status.failed\", \"Import thất bại\")}\n                </h3>\n                <p className=\"text-[10px] font-bold text-slate-600 dark:text-slate-400 uppercase tracking-[0.2em]\">\n                  {importJob.processed_rows || 0} / {importJob.total_rows || \"?\"} {t(\"leave_import.rows_label\", \"dòng đã xử lý\")}\n                </p>\n              </div>\n            </div>\n            {importJob.total_rows ? (\n              <span className=\"text-[10px] font-bold text-primary-700 dark:text-primary-400 bg-primary-50 dark:bg-primary-950 px-3 py-1 rounded-full border border-primary-200 dark:border-primary-800 shadow-sm\">\n                {Math.round((importJob.processed_rows / importJob.total_rows) * 100)}%\n              </span>\n            ) : null}\n          </div>\n\n          {/* Progress bar */}\n          <div className=\"h-2.5 w-full bg-slate-100 dark:bg-slate-700 rounded-full overflow-hidden shadow-inner border border-slate-200 dark:border-slate-700/50 relative\">\n            <div\n              className={cn(\n                \"h-full transition-all duration-1000 shadow-xl\",\n                importJob.status === \"failed\"\n                  ? \"bg-rose-400 dark:bg-rose-500\"\n                  : importJob.status === \"completed\" && importJob.error_log\n                    ? \"bg-amber-400 dark:bg-amber-500\"\n                    : \"bg-primary-600\"\n              )}\n              style={{ width: `${importJob.total_rows ? (importJob.processed_rows / importJob.total_rows) * 100 : (isProcessing ? 15 : 0)}%` }}\n            >\n              {isProcessing && (\n                <div className=\"absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent animate-shimmer\" style={{ backgroundSize: '200% 100%' }} />\n              )}\n            </div>\n          </div>\n\n          {/* Error details */}\n          {importJob.status === \"completed\" && importJob.error_log && (() => {\n            const info = getErrorInfo(importJob);\n            return (\n              <div className=\"bg-slate-50 dark:bg-slate-900 rounded-2xl p-6 border border-amber-200 dark:border-amber-900/50 shadow-sm\">\n                <p className=\"text-sm font-semibold text-amber-700 dark:text-amber-300 mb-3\">\n                  {t(\"leave_import.partial_detail\", \"Thành công {{success}} dòng, {{errors}} dòng bị lỗi\")\n                    .replace(\"{{success}}\", String(info?.success_count ?? importJob.processed_rows))\n                    .replace(\"{{errors}}\", String(info?.error_count ?? 0))}\n                </p>\n                {info?.error_file_path && wsId && (\n                  <button\n                    onClick={() => downloadLeaveImportErrors(wsId, importJob.id).catch(() => {})}\n                    className=\"inline-flex items-center gap-2 px-5 py-2.5 bg-amber-100 dark:bg-amber-900/50 text-amber-700 dark:text-amber-300 rounded-xl text-[10px] font-bold uppercase tracking-widest hover:bg-amber-200 dark:hover:bg-amber-800/50 transition-all border border-amber-200 dark:border-amber-800 active:scale-95\"\n                  >\n                    <Download size={14} /> {t(\"leave_import.download_errors\", \"Tải file lỗi\")}\n                  </button>\n                )}\n              </div>\n            );\n          })()}\n\n          {importJob.status === \"failed\" && importJob.error_log && (\n            <div className=\"bg-slate-50 dark:bg-slate-900 rounded-2xl p-6 border border-rose-200 dark:border-rose-900/50 shadow-sm\">\n              <h4 className=\"text-[10px] font-bold text-rose-600 dark:text-rose-400 mb-2 flex items-center gap-2 uppercase tracking-[0.25em]\">\n                <AlertCircle size={14} /> {t(\"leave_import.error_detail\", \"Chi tiết lỗi\")}\n              </h4>\n              <p className=\"text-xs text-slate-600 dark:text-slate-400 font-mono\">{importJob.error_log.substring(0, 200)}</p>\n            </div>\n          )}\n\n          {/* Footer buttons */}\n          <div className=\"pt-3 flex gap-4 border-t border-slate-200 dark:border-slate-800\">\n            {isFinished && (\n              <>\n                <button\n                  onClick={() => { setImportJob(null); }}\n                  className=\"flex-1 px-6 py-3 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 rounded-xl font-bold text-[10px] uppercase tracking-widest hover:bg-slate-50 dark:hover:bg-slate-800 transition-all active:scale-95\"\n                >\n                  {t(\"leave_import.upload_another\", \"Upload file khác\")}\n                </button>\n                <button\n                  onClick={onClose}\n                  className=\"flex-1 px-10 py-3 bg-slate-800 dark:bg-slate-700 text-white rounded-xl font-bold text-[10px] uppercase tracking-widest hover:bg-primary-700 transition-all shadow-lg active:scale-95\"\n                >\n                  {t(\"common.close\", \"Đóng\").toUpperCase()}\n                </button>\n              </>\n            )}\n          </div>\n        </div>\n      ) : (\n        /* ===== UPLOAD VIEW ===== */\n        <div className=\"space-y-6 pt-2 animate-in fade-in duration-500\">\n          {/* Instructions Panel */}\n          <div className=\"bg-primary-50 dark:bg-primary-950/50 rounded-2xl p-5 border border-primary-200 dark:border-primary-800/50 flex gap-4\">\n            <div className=\"w-9 h-9 rounded-xl bg-white dark:bg-slate-900 flex items-center justify-center text-primary-600 dark:text-primary-400 shadow-sm border border-primary-200 dark:border-primary-800 shrink-0\">\n              <AlertCircle size={18} />\n            </div>\n            <div className=\"text-xs text-primary-800 dark:text-primary-200 leading-relaxed font-medium pt-0.5\">\n              <p className=\"font-bold uppercase tracking-[0.2em] mb-2 text-slate-700 dark:text-slate-300\">\n                {t(\"leave_import.requirements_title\", \"Yêu cầu file\")}\n              </p>\n              <ul className=\"grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-1.5 text-slate-600 dark:text-slate-400 font-bold uppercase tracking-tight\">\n                <li className=\"flex items-center gap-2\"><div className=\"w-1.5 h-1.5 bg-primary-500 dark:bg-primary-400 rounded-full\" /> {t(\"leave_import.req_col_a\", \"Cột A: Mã nhân viên\")}</li>\n                <li className=\"flex items-center gap-2\"><div className=\"w-1.5 h-1.5 bg-primary-500 dark:bg-primary-400 rounded-full\" /> {t(\"leave_import.req_col_b\", \"Cột B: Mã loại nghỉ\")}</li>\n                <li className=\"flex items-center gap-2\"><div className=\"w-1.5 h-1.5 bg-primary-500 dark:bg-primary-400 rounded-full\" /> {t(\"leave_import.req_col_c\", \"Cột C-D: Ngày bắt đầu / kết thúc\")}</li>\n                <li className=\"flex items-center gap-2\"><div className=\"w-1.5 h-1.5 bg-primary-500 dark:bg-primary-400 rounded-full\" /> {t(\"leave_import.req_col_e\", \"Cột E: Lý do (tùy chọn)\")}</li>\n                <li className=\"flex items-center gap-2\"><div className=\"w-1.5 h-1.5 bg-primary-500 dark:bg-primary-400 rounded-full\" /> {t(\"leave_import.req_col_f\", \"Cột F: Loại thời gian\")}</li>\n                <li className=\"flex items-center gap-2\"><div className=\"w-1.5 h-1.5 bg-primary-500 dark:bg-primary-400 rounded-full\" /> {t(\"leave_import.req_format\", \"Định dạng: .xlsx, .xls, .csv\")}</li>\n              </ul>\n            </div>\n          </div>\n\n          {/* Download Template Button */}\n          <button\n            disabled={downloadingTemplate || !wsId}\n            onClick={async () => {\n              if (!wsId) return;\n              setDownloadingTemplate(true);\n              try {\n                await downloadLeaveImportTemplate(wsId, i18n.language);\n              } catch { /* handled */ } finally {\n                setDownloadingTemplate(false);\n              }\n            }}\n            className=\"w-full flex items-center justify-center gap-3 px-6 py-3.5 bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800/50 rounded-2xl text-emerald-700 dark:text-emerald-300 font-bold text-[10px] uppercase tracking-widest hover:bg-emerald-100 dark:hover:bg-emerald-900/30 transition-all active:scale-[0.98] group disabled:opacity-50\"\n          >\n            {downloadingTemplate ? <Loader2 size={16} className=\"animate-spin\" /> : <Download size={16} className=\"group-hover:animate-bounce\" />}\n            {t(\"leave_import.download_template\", \"Tải file mẫu Excel\")}\n          </button>\n\n          {/* File Drop Zone */}\n          <div\n            className={cn(\n              \"border-3 border-dashed rounded-2xl p-10 flex flex-col items-center justify-center transition-all cursor-pointer group active:scale-[0.98] relative overflow-hidden\",\n              file\n                ? \"border-emerald-400 bg-emerald-50 dark:bg-emerald-950/20\"\n                : \"border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/30 hover:border-primary-400 hover:bg-primary-50 dark:hover:bg-primary-950/30\"\n            )}\n            onClick={() => document.getElementById(\"leave-import-file-input\")?.click()}\n          >\n            <input\n              id=\"leave-import-file-input\"\n              aria-label=\"File Upload\"\n              type=\"file\"\n              className=\"hidden\"\n              accept=\".xlsx,.xls,.csv\"\n              onChange={(e) => setFile(e.target.files?.[0] || null)}\n            />\n            {file ? (\n              <div className=\"text-center animate-in zoom-in-95 duration-500\">\n                <div className=\"w-16 h-16 bg-emerald-100 dark:bg-emerald-900 rounded-2xl flex items-center justify-center mx-auto mb-5 shadow-lg shadow-emerald-200/50 dark:shadow-emerald-900/30 rotate-3 group-hover:rotate-0 transition-transform\">\n                  <FileText size={28} className=\"text-emerald-600 dark:text-emerald-300\" />\n                </div>\n                <p className=\"font-bold text-slate-800 dark:text-slate-200 mb-1 text-lg tracking-tight uppercase\">{file.name}</p>\n                <p className=\"text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">\n                  {(file.size / 1024).toFixed(1)} KB — {t(\"leave_import.ready\", \"SẴN SÀNG UPLOAD\")}\n                </p>\n                <button\n                  onClick={(e) => { e.stopPropagation(); setFile(null); }}\n                  className=\"mt-5 text-[10px] font-bold text-rose-600 dark:text-rose-400 uppercase tracking-widest hover:text-rose-700 dark:hover:text-rose-300 transition-all bg-white dark:bg-slate-900 px-5 py-2 rounded-lg border border-rose-200 dark:border-rose-800 shadow-sm hover:shadow-md active:scale-90\"\n                >\n                  {t(\"leave_import.select_another\", \"Chọn file khác\")}\n                </button>\n              </div>\n            ) : (\n              <div className=\"text-center group-hover:scale-105 transition-transform duration-500\">\n                <div className=\"w-16 h-16 bg-white dark:bg-slate-900 rounded-2xl flex items-center justify-center mx-auto mb-5 shadow-lg border border-slate-200 dark:border-slate-700 -rotate-3 group-hover:rotate-0 transition-all\">\n                  <Upload size={28} className=\"text-slate-400 dark:text-slate-500\" />\n                </div>\n                <p className=\"font-bold text-slate-800 dark:text-slate-200 mb-1 text-lg tracking-tight uppercase\">\n                  {t(\"leave_import.drop_prompt\", \"Nhấn để chọn file Excel\")}\n                </p>\n                <p className=\"text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest\">\n                  {t(\"leave_import.drop_hint\", \"Hỗ trợ .xlsx, .xls, .csv\")}\n                </p>\n              </div>\n            )}\n          </div>\n\n          {/* Footer buttons */}\n          <div className=\"flex gap-4 pt-3 border-t border-slate-200 dark:border-slate-800\">\n            <button\n              onClick={onClose}\n              className=\"flex-1 px-6 py-3 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 rounded-xl font-bold text-[10px] uppercase tracking-widest hover:bg-slate-50 dark:hover:bg-slate-800 transition-all active:scale-95\"\n            >\n              {t(\"common.cancel\", \"Hủy\")}\n            </button>\n            <button\n              disabled={!file || uploading}\n              onClick={handleUpload}\n              className=\"flex-[1.5] py-3 bg-primary-600 text-white rounded-xl font-bold text-[10px] uppercase tracking-widest hover:bg-primary-700 transition-all shadow-lg shadow-primary-200/50 dark:shadow-primary-900/30 active:scale-95 disabled:opacity-50 flex items-center justify-center gap-3\"\n            >\n              {uploading ? (\n                <><Loader2 size={18} className=\"animate-spin\" /> {t(\"leave_import.uploading\", \"ĐANG UPLOAD...\")}</>\n              ) : (\n                t(\"leave_import.start_import\", \"BẮT ĐẦU IMPORT\").toUpperCase()\n              )}\n            </button>\n          </div>\n        </div>\n      )}\n    </Modal>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/workspace/webdashboard/src/components/features/leave/__tests__/LeaveImportDialog.test.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'act' is defined but never used. Allowed unused vars must match /^_/u.","line":1,"column":46,"nodeType":"Identifier","messageId":"unusedVar","endLine":1,"endColumn":49,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"act"},"fix"