{
  "name": "webdashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "analyze": "ANALYZE=true vite build",
    "preview": "vite preview",
    "lint": "bun scripts/lint.mjs src",
    "lint:fix": "bun scripts/lint.mjs --fix src",
    "lint:only": "bun scripts/lint.mjs",
    "check-budget": "node scripts/check-budget.mjs",
    "check-i18n": "node ../scripts/locales/reconcile_locales.js",
    "type-check": "tsc --noEmit",
    "test": "NODE_OPTIONS='--experimental-require-module' vitest run --bail 1",
    "test:coverage": "NODE_OPTIONS='--experimental-require-module' vitest run --coverage",
    "test:e2e": "PLAYWRIGHT_TEST=true npx playwright test",
    "tauri": "tauri",
    "gen-template": "node generate_template.cjs",
    "gen-api": "bunx openapi-typescript openapi.json -o src/types/api-generated.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
