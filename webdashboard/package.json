    "globals": "^17.0.0",
    "happy-dom": "^20.8.4",
    "jsdom": "^27.4.0",
    "openapi-typescript": "^7.13.0",
    "rollup-plugin-visualizer": "^6.0.11",
    "tailwindcss": "^4",
    "ts-morph": "^28.0.0",
    "typescript": "^5",
    "typescript-eslint": "^8.53.0",
    "vite": "^7.3.1",
