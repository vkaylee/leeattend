# LeeAttend Web Dashboard Configuration

# The Full URL of the API Server (Rust), including /api prefix.
# This variable must be prefixed with VITE_ to be accessible in the browser.
#
# Examples:
#   Local development:  http://localhost:3000/api
#   Custom port:        http://192.168.1.10:3003/api
#   Docker container:   http://apiserver:3000/api

VITE_API_URL=http://localhost:3000/api

# The host the Vite development server should listen on.
# Default: 127.0.0.1

VITE_DEV_SERVER_HOST=127.0.0.1

# ESLint Concurrency configuration (auto or integer number of CPU cores/threads)
# ESLINT_CONCURRENCY=auto

