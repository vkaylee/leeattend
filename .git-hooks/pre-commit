#!/bin/bash

# ==============================================================================
# Pre-commit hook: Run smoke tests before commit.
# ==============================================================================
# Uses run-tests.sh (Podman-compatible, PTY-safe).
# With Podman (daemonless), containers are direct children of this process.
# No setsid needed — just redirect output to file so test logs don't pollute
# git commit output, then print failure details.
# ==============================================================================

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
LOG="/tmp/pre-commit-$$.log"

# ── Agent-safe mode ──────────────────────────────────────────────────
# Agentic terminals (Claude, Gemini, etc.) hang on ANY subprocess that
# inherits PTY file descriptors — even the static scanner uses process
# substitution that holds fds open.
#
# When AGENT_MODE=1:
#   - Skip all hook checks (they must be run standalone BEFORE commit)
#   - Exit immediately so git commit completes without PTY hang
#
# Safe workflow for agents:
#   1. Run checks:  bash scripts/test-pty-safety.sh --static 2>&1 | cat
#   2. Commit:      AGENT_MODE=1 git commit --no-gpg-sign -m "msg" </dev/null
# ─────────────────────────────────────────────────────────────────────
if [[ "${AGENT_MODE:-}" == "1" ]]; then
    echo "🤖 Pre-commit: agent mode — hook skipped (run checks standalone before commit)"
    exit 0
fi

echo "🔍 Pre-commit: running smoke tests..."
echo "🤖 [AI AGENT NOTICE]: A git pre-commit hook is now running an integration test suite."
echo "🤖 [AI AGENT NOTICE]: This process can take UP TO 5 MINUTES to complete depending on cache."
echo "🤖 [AI AGENT NOTICE]: DO NOT interrupt, terminate, or assume this is a PTY hang. Wait patiently for the exit code."

# Run tests and stream output safely (avoiding pipe FD leaks)
# We redirect directly to file, and `tail -f` the file in the background so the user can see progress
# without the PTY holding the pipe open and hanging git.
touch "$LOG"
tail -f "$LOG" </dev/null &
TAIL_PID=$!

set +e
"$REPO_ROOT/run-tests.sh" --api --smoke > "$LOG" 2>&1
EXIT_CODE=$?
set -e

# Kill the background tail process immediately when tests finish
kill $TAIL_PID 2>/dev/null || true
wait $TAIL_PID 2>/dev/null || true

if [ "$EXIT_CODE" -eq 0 ]; then
    echo "✅ Smoke tests passed."
else
    echo "❌ Smoke tests FAILED (exit code: $EXIT_CODE)"
    echo "================================================================"

    FAILURE_LOG="$REPO_ROOT/.test_logs/latest-failure.log"
    PREBUILD_LOG="$REPO_ROOT/.test_logs/prebuild.log"
    if [ -f "$FAILURE_LOG" ]; then
        echo "──── Failure Details ────"
        head -20 <<< "$(grep -E '(FAIL|panicked|assertion|left:|right:|error:|stderr)' "$FAILURE_LOG" 2>/dev/null || true)"
        echo ""
        echo "──── Full Failure Context ────"
        grep -m1 -n 'FAIL' "$FAILURE_LOG" 2>/dev/null | while IFS=: read -r line_num _rest; do
            head -40 <<< "$(sed -n "${line_num},\$p" "$FAILURE_LOG")"
        done
    elif [ -f "$PREBUILD_LOG" ]; then
        echo "──── Build Error Details ────"
        tail -20 <<< "$(grep -E '(^error|^\s+-->|could not compile)' "$PREBUILD_LOG" 2>/dev/null || true)"
    else
        echo "──── Last 30 lines of test output ────"
        tail -30 "$LOG" 2>/dev/null || true
    fi
    echo "================================================================"
fi

# Re-stage any tracked files modified by tests (e.g. Cargo.lock)
MODIFIED=$(git diff --name-only)
if [ -n "$MODIFIED" ]; then
    echo "📎 Re-staging tracked files modified during tests:"
    echo "$MODIFIED" | sed 's/^/   /'
    git add -u
fi

rm -f "$LOG"
exit "$EXIT_CODE"
