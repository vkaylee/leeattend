#!/bin/bash

# ==============================================================================
# Pre-commit hook: Run smoke tests before commit.
# ==============================================================================
# Uses run-tests.sh (Podman-compatible, PTY-safe).
# With Podman (daemonless), containers are direct children of this process.
# No setsid needed — just redirect output to file so test logs don't pollute
# git commit output, then print failure details.
# ==============================================================================

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
LOG="/tmp/pre-commit-$$.log"

echo "🔍 Pre-commit: running smoke tests..."

# Run tests with output to file (keeps git commit output clean)
"$REPO_ROOT/run-tests.sh" --api --smoke >"$LOG" 2>&1
EXIT_CODE=$?

if [ "$EXIT_CODE" -eq 0 ]; then
    echo "✅ Smoke tests passed."
else
    echo "❌ Smoke tests FAILED (exit code: $EXIT_CODE)"
    echo "================================================================"

    FAILURE_LOG="$REPO_ROOT/.test_logs/latest-failure.log"
    PREBUILD_LOG="$REPO_ROOT/.test_logs/prebuild.log"
    if [ -f "$FAILURE_LOG" ]; then
        echo "──── Failure Details ────"
        grep -E '(FAIL|panicked|assertion|left:|right:|error:|stderr)' "$FAILURE_LOG" 2>/dev/null | head -20
        echo ""
        echo "──── Full Failure Context ────"
        grep -n 'FAIL' "$FAILURE_LOG" 2>/dev/null | head -1 | while IFS=: read -r line_num _rest; do
            sed -n "${line_num},\$p" "$FAILURE_LOG" | head -40
        done
    elif [ -f "$PREBUILD_LOG" ]; then
        echo "──── Build Error Details ────"
        grep -E '(^error|^\s+-->|could not compile)' "$PREBUILD_LOG" 2>/dev/null | tail -20
    else
        echo "──── Last 30 lines of test output ────"
        tail -30 "$LOG" 2>/dev/null || true
    fi
    echo "================================================================"
fi

# Re-stage any tracked files modified by tests (e.g. Cargo.lock)
MODIFIED=$(git diff --name-only)
if [ -n "$MODIFIED" ]; then
    echo "📎 Re-staging tracked files modified during tests:"
    echo "$MODIFIED" | sed 's/^/   /'
    git add -u
fi

rm -f "$LOG"
exit "$EXIT_CODE"
